<Project Sdk="Microsoft.NET.Sdk">
  <!-- The .NET ports of the benchmarks; not part of Sable.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Optimize>true</Optimize>
    <!-- With ICU, for normalisation. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../library/**/*.cs;../../programs/**/*.cs" />
    <!-- TensorPrimitives, for tensor-primitives: a NuGet package, not in the box. -->
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.0" />
  </ItemGroup>
</Project>
