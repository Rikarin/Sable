module InlineArrayTests

// InlineArray (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn anInlineArrayIsTheFixedSizeArray() {
    var corners: InlineArray<Int, 4> = [0, 1, 2, 3]
    corners[2] = 7
    assertEqual(corners.count, 4)
    expect(corners.toArray() == [0, 1, 7, 3])
    let same: Int[4] = corners
    assertEqual(same[2], 7)
}

@test
fn anInlineArrayHasEveryArrayMember() {
    var names: InlineArray<String, 3> = ["c", "a", "b"]
    names.sort()
    expect(names.toArray() == ["a", "b", "c"])
    expect(names.contains(element: "b"))
}

@test
fn anInlineArrayHasTheWholeArrayAPI() {
    var xs: InlineArray<Int, 6> = [5, 3, 9, 1, 7, 3]
    assertEqual(xs.firstIndex(of: 9) ?? -1, 2)
    assertEqual(xs.count(where: { $0 == 3 }), 2)
    xs.swapAt(0, 5)
    xs.reverse()
    expect(xs.toArray() == [5, 7, 1, 9, 3, 3])
    xs.rotate(left: 2)
    expect(xs.toArray() == [1, 9, 3, 3, 5, 7])
    xs.sortUnstable()
    expect(xs.isSorted(by: { $0 < $1 }))
    expect(xs.starts(with: [1, 3]))
    assertEqual(xs.chunks(of: 4).count, 2)
    assertEqual(xs.windows(of: 5).count, 2)
    xs.fill(0)
    expect(xs.toArray() == [0, 0, 0, 0, 0, 0])
}

@test
fn anInlineArrayAllocatesNothing() {
    // Its elements are where it is (#304): made from a literal, read,
    // written, gone through, and lent whole to the members of T[:] that
    // read it, nothing is allocated. (Those that change it in place are
    // lent it too, where the library's code is compiled with the program's;
    // Sable.CodeGen.Tests' InlineArrayTests count them.)
    var same = false
    assertNoAllocations(() => {
        var xs: InlineArray<Int, 4> = [4, 2, 3, 1]
        xs[0] = 8
        xs.swapAt(1, 2)
        var total = 0
        for x in xs {
            total += x
        }
        _ = xs.contains(element: total)
        _ = xs.firstIndex(of: 3)
        _ = xs.count
        let copy = xs
        same = copy[0] == xs[0]
    })
    expect(same)
}

@test
fn anInlineArrayIsAValue() {
    var xs: InlineArray<String, 2> = ["a", "b"]
    let before = xs
    xs[0] = "z"
    xs.reverse()
    expect(before.toArray() == ["a", "b"])
    expect(xs.toArray() == ["b", "z"])
}
