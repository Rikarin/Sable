module ConcurrentQueueTests

// ConcurrentQueue (Sable.Concurrency): against a model one operation at a
// time, and under producers and consumers running at once, where a
// linearizable FIFO queue gives every value exactly once and each
// consumer sees each producer's values in the order they were enqueued.

import ConcurrencySupport
import Sable.Concurrency
import Sable.Testing

@test
fn aQueueGivesBackInTheOrderItWasGiven() {
    let queue = ConcurrentQueue<String>()
    expect(queue.isEmpty)
    expect(queue.dequeue() == none)
    expect(queue.peek() == none)
    queue.enqueue("a")
    queue.enqueue("b")
    assertEqual(queue.count, 2)
    expect(!queue.isEmpty)
    assertEqual(queue.peek() ?? "-", "a")
    assertEqual(queue.dequeue() ?? "-", "a")
    assertEqual(queue.dequeue() ?? "-", "b")
    expect(queue.dequeue() == none)
    assertEqual(queue.count, 0)
}

@test
fn randomOperationsAgreeWithAnArray() {
    let enqueues = Gen.weighted([(1, Gen.always(false)), (2, Gen.always(true))])
    forAll(many(enqueues, upTo: 4000), cases: 14) { (steps: Bool[>..]) in
        let queue = ConcurrentQueue<Int>()
        var enqueued = 0
        var dequeued = 0
        for enqueues in steps {
            if enqueues {
                queue.enqueue(enqueued)
                enqueued += 1
            } else {
                let expected: Int? = dequeued < enqueued ? dequeued : none
                dequeued += expected == none ? 0 : 1
                let value = queue.dequeue()
                if value != expected {
                    recordFailure("dequeued \(value:?) rather than \(expected:?)")
                    return
                }
            }
            if queue.count != enqueued - dequeued {
                recordFailure("\(queue.count) in it rather than \(enqueued - dequeued)")
                return
            }
        }
    }
}

@test
fn valuesLeftInAQueueAreFreedWithIt() {
    var made = 0
    while made < 3 {
        let queue = ConcurrentQueue<String[>..]>()
        queue.enqueue(["x", "y"])
        queue.enqueue(["z"])
        made = made + 1
    }
    assertEqual(made, 3)
}

@test
fn producersAndConsumersAtOnceLoseAndReorderNothing() async {
    let queue = ConcurrentQueue<Int>()
    let producers = 2
    let perProducer = 20000
    let taken = Atomic<Int>(0)
    let seen = await withTaskGroup(of: Int[>..].self) { group -> Int[>..][>..] in
        var p = 0
        while p < producers {
            let producer = p
            group.spawn {
                var i = 0
                while i < perProducer {
                    queue.enqueue(producer * 1000000 + i)
                    i += 1
                    if i % 1000 == 0 {
                        await yieldNow()
                    }
                }
                return []
            }
            p += 1
        }
        var c = 0
        while c < 2 {
            group.spawn {
                var got: Int[>..] = []
                while taken.load() < producers * perProducer {
                    if let value = queue.dequeue() {
                        got.append(value)
                        taken.add(1)
                    } else {
                        await yieldNow()
                    }
                }
                return got
            }
            c += 1
        }
        var all: Int[>..][>..] = []
        for await got in group {
            all.append(got)
        }
        return all
    }

    var counts = [0, 0]
    var total = 0
    for got in seen {
        // Each producer's values, as one consumer took them, rise.
        var last = [-1, -1]
        for value in got {
            let producer = value / 1000000
            let index = value % 1000000
            assert(index > last[producer], "producer \(producer)'s values out of order")
            last[producer] = index
            counts[producer] += 1
            total += 1
        }
    }
    assertEqual(total, producers * perProducer)
    assertEqual(counts[0], perProducer)
    assertEqual(counts[1], perProducer)
    expect(queue.isEmpty)
}

@test
fn aQueueOfManySegmentsKeepsItsOrderAndLetsGoOfWhatIsLeft() {
    let live = Atomic<Int>(0)
    if true {
        let queue = ConcurrentQueue<Kept>()
        var next = 0
        for round in 0..<3 {
            for i in 0..<4000 {
                queue.enqueue(Kept(round * 4000 + i, live))
            }
            for _ in 0..<3000 {
                assertEqual(queue.peek()!.number, next)
                assertEqual(queue.dequeue()!.number, next)
                next += 1
            }
        }
        assertEqual(queue.count, 3000)
        assertEqual(live.load(), 3000)
    }
    assertEqual(live.load(), 0)
}

@immutable
final class Kept {
    let number: Int
    let live: Atomic<Int>

    init(_ number: Int, _ live: Atomic<Int>) {
        self.number = number
        self.live = live
        live.add(1)
    }

    deinit {
        live.subtract(1)
    }
}
