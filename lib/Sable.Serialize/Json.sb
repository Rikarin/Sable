module Sable.Serialize

/// Serializable values to JSON and back: .NET's JsonSerializer, Swift's
/// JSONEncoder and JSONDecoder, serde_json.
///
/// ```sable
/// let numbers: Int[>..] = [1, 2, 3]
/// assert(try! Json.encode(numbers) == "[1,2,3]")
/// assert(try! Json.encode(numbers, indent: 2) == "[\n  1,\n  2,\n  3\n]")
/// assert(try! Json.decode(Int[>..].self, from: " [4, 5] ").count == 2)
/// ```
public struct Json {
    /// The value as JSON: compact, or indented by that many spaces.
    public static fn encode<T: Serializable>(_ value: T, indent: Int = 0) throws(SerializeError) -> String {
        let encoder = JsonEncoder(indent: indent)
        try value.encode(to: encoder)
        return encoder.text()
    }

    /// The value as JSON, UTF-8.
    public static fn encodeBytes<T: Serializable>(_ value: T) throws(SerializeError) -> U8[>..] {
        let encoder = JsonEncoder()
        try value.encode(to: encoder)
        return encoder.writer.takeBytes()
    }

    /// The value of the type the JSON text holds, RFC 8259's or what else
    /// the options allow.
    ///
    /// ```sable
    /// let numbers = try! Json.decode(Int[>..].self, from: "[1, /* two */ 2,]", options: relaxed())
    /// assert(numbers == [1, 2])
    /// ```
    public static fn decode<T: Serializable>(_ type: T.Type, from text: String, options: ParseOptions = strict()) throws(SerializeError) -> T {
        return try T.decode(from: try JsonDecoder.parse(text, options: options))
    }

    /// The value of the type the JSON's UTF-8 bytes hold.
    public static fn decode<T: Serializable>(_ type: T.Type, fromBytes bytes: U8[:], options: ParseOptions = strict()) throws(SerializeError) -> T {
        return try T.decode(from: try JsonDecoder.parse(bytes: bytes, options: options))
    }
}
