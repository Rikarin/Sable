module Utf8Validate

// Validating UTF-8 against .NET's Utf8.IsValid: a megabyte of ASCII, and a
// megabyte of text mixing ASCII with two-, three- and four-byte scalars.

import Sable.Testing
import Sable.Text

fn run(_ asciiBytes: U8[>..], _ mixedBytes: U8[>..]) -> String {
    var valid = 0
    var round = 0
    while round < 400 {
        // Each round reads the input anew: nothing is kept from the last.
        _ = blackBox(round)
        if Utf8.isValid(asciiBytes) {
            valid = valid + 1
        }
        if Utf8.isValid(mixedBytes) {
            valid = valid + 1
        }
        round = round + 1
    }

    return "\(valid) \(asciiBytes.count) \(mixedBytes.count)"
}

@bench
fn measure(_ b: Bencher) {
    var ascii: String[>..] = []
    var mixed: String[>..] = []
    var i = 0
    while i < 16384 {
        ascii.append("The quick brown fox jumps over the lazy dog, again. ")
        mixed.append("Grüße, мир, 世界 😀 and plain words too. ")
        i = i + 1
    }
    let asciiBytes = ascii.joined().utf8Bytes()
    let mixedBytes = mixed.joined().utf8Bytes()
    b.check(b.iterate { run(asciiBytes, mixedBytes) })
}
