module CollectionsTests

// Sable.Collections, tested with '@test': run with
//     sable test tests/lib/CollectionsTests.sab
// TextLibraryTests and CollectionLibraryTests check the same library from
// C#; these are the same kind of checks, written the way a Sable package
// tests itself.

import Sable.Collections
import Sable.Testing

@test
fn stackIsLastInFirstOut() {
    let stack = Stack<Int>()
    stack.push(1)
    stack.push(2)
    stack.push(3)
    assertEqual(stack.pop() ?? -1, 3)
    assertEqual(stack.peek() ?? -1, 2)
    assertEqual(stack.pop() ?? -1, 2)
    assertEqual(stack.pop() ?? -1, 1)
    assert(stack.pop() == none, "an empty stack pops none")
}

@test
fn queueIsFirstInFirstOut() {
    let queue = Queue<String>()
    queue.enqueue("a")
    queue.enqueue("b")
    assertEqual(queue.dequeue() ?? "", "a")
    queue.enqueue("c")
    assertEqual(queue.dequeue() ?? "", "b")
    assertEqual(queue.dequeue() ?? "", "c")
    assert(queue.dequeue() == none)
}

@test
fn hashMapSetsGetsAndRemoves() {
    let map = HashMap<String, Int>()
    var i = 0
    while i < 100 {
        map.set("key\(i)", i * i)
        i = i + 1
    }
    assertEqual(map.get("key7") ?? -1, 49)
    assertEqual(map.get("key99") ?? -1, 9801)
    assert(map.contains("key0"))
    assert(map.remove("key0"))
    assert(!map.contains("key0"), "a removed key is gone")
    assert(!map.remove("key0"), "a key is removed once")
    assertEqual(map.allKeys().count, 99)
}

@test
fn hashSetKeepsOneOfEach() {
    let seen = HashSet<Int>()
    assert(seen.insert(5))
    assert(!seen.insert(5), "a second insert of the same value adds nothing")
    assert(seen.insert(6))
    assertEqual(seen.elements().count, 2)
}

@test
fn sortOrdersInPlace() {
    var values: Int[>..] = [5, 3, 9, 1, 4, 1]
    sort(&values)
    var text = ""
    for v in values {
        text = text + "\(v) "
    }
    assertEqual(text, "1 1 3 4 5 9 ")
}

@test
fn sortedTakesAnOrder() {
    let words = sorted(["pear", "fig", "banana"], by: (a: String, b: String) => a.count < b.count)
    assertEqual(words[0], "fig")
    assertEqual(words[2], "banana")
}

@test
fn dequeGrowsAtBothEnds() {
    let deque = Deque<Int>()
    var i = 0
    while i < 20 {
        deque.append(i)
        deque.prepend(0 - i)
        i = i + 1
    }
    assertEqual(deque.count, 40)
    assertEqual(deque.first ?? 0, -19)
    assertEqual(deque.last ?? 0, 19)
    assertEqual(deque.removeFirst() ?? 0, -19)
    assertEqual(deque.at(0), -18)
}

@test
fn priorityQueuePopsSmallestFirst() {
    let queue = PriorityQueue<Int>()
    for v in [7, 2, 9, 4, 1] {
        queue.push(v)
    }
    var order = ""
    while let v = queue.pop() {
        order = order + "\(v)"
    }
    assertEqual(order, "12479")
}

@test
fn bitSetAlgebra() {
    let a = BitSet([1, 2, 3, 64, 200])
    let b = BitSet([2, 3, 4])
    assertEqual(a.count, 5)
    assertEqual(a.union(b).count, 6)
    assertEqual(a.intersection(b).count, 2)
    assertEqual(a.subtracting(b).count, 3)
    assert(BitSet([2, 3]).isSubset(of: a))
    assert(!b.isSubset(of: a), "4 is not in a")
}

@bench
fn hashMapInserts(_ b: Bencher) {
    b.iterate(() => {
        let map = HashMap<Int, Int>()
        var i = 0
        while i < 64 {
            map.set(i, i)
            i = i + 1
        }
    })
}

@bench
fn sortSixtyFour() {
    var values: Int[>..] = []
    var i = 0
    while i < 64 {
        values.append((i * 7919) % 64)
        i = i + 1
    }
    sort(&values)
}
