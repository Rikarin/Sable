module RwLockTests

// RwLock (Sable.Concurrency).

import Sable.Concurrency
import Sable.Testing
import Sable.Time

@test
fn readersShareAndAWriterIsAlone() async {
    let table = RwLock<Int>(0)
    let inside = Atomic<Int>(0)
    let mostReaders = Atomic<Int>(0)
    let writersAlone = Atomic<Bool>(true)
    await withTaskGroup(of: Int.self) { group in
        var task = 0
        while task < 6 {
            let writer = task % 3 == 0
            group.spawn {
                var i = 0
                while i < 300 {
                    if writer {
                        table.write { value in
                            if inside.add(1) != 0 {
                                writersAlone.store(false)
                            }
                            value += 1
                            inside.subtract(1)
                        }
                    } else {
                        let _ = table.read { value in
                            let now = inside.add(1) + 1
                            mostReaders.max(now)
                            inside.subtract(1)
                            return value
                        }
                    }
                    i += 1
                }
                return 0
            }
            task += 1
        }
        await group.waitForAll()
    }
    assert(writersAlone.load())
    assertEqual(table.read { $0 }, 600)
    assert(mostReaders.load() >= 1)
}

struct Failure: Error {
    fn debugDescription() -> String { return "Failure" }
}

@test
fn readersAreInsideTogether() {
    let table = RwLock<String>("a")
    // Two readers, the first in until the second has gone.
    assertEqual(table.read { outer in
        outer + table.read { inner in inner + "!" }
    }, "aa!")
    table.write { $0 = "b" }
    assertEqual(table.read { $0 }, "b")
}

@test
fn aThrowingReaderOrWriterLetsTheLockGo() {
    let n = RwLock<Int>(1)
    do {
        try n.read { value in
            throw Failure()
        }
        fail("it did not throw")
    } catch { }
    do {
        try n.write { value in
            value = 7
            throw Failure()
        }
        fail("it did not throw")
    } catch { }
    n.write { $0 += 1 }
    assertEqual(n.read { $0 }, 8)
}

@test
fn aReaderWaitsForTheWriter() async {
    let table = RwLock<Int>(0)
    let writing = Atomic<Bool>(false)
    let started = Atomic<Bool>(false)
    let writer = Task.spawn {
        await Task.blocking {
            table.write { value in
            writing.store(true)
            while !started.load() { }
            // Time for the reader to come to the lock, and wait.
            pause()
            value = 5
        }
        }
    }
    while !writing.load() {
        await Task.yield()
    }
    let reader = Task.spawn {
        await Task.blocking {
        started.store(true)
        return table.read { $0 }
    }
    }
    assertEqual(await reader.value, 5)
    await writer.value
}

@test
fn aWriterWaitsForTheReadersAndGoesBeforeLaterOnes() async {
    let table = RwLock<Int>(0)
    let reading = Atomic<Bool>(false)
    let writing = Atomic<Bool>(false)
    let readingLater = Atomic<Bool>(false)
    let first = Task.spawn {
        await Task.blocking {
            table.read { value in
            reading.store(true)
            while !writing.load() { }
            // Time for the writer to come to the lock, and wait; then
            // for the later reader.
            pause()
            assertEqual(value, 0)
            while !readingLater.load() { }
            pause()
        }
        }
    }
    while !reading.load() {
        await Task.yield()
    }
    let writer = Task.spawn {
        await Task.blocking {
        writing.store(true)
        return table.write { value -> Int in
            value += 1
            return value
        }
    }
    }
    let later = Task.spawn {
        await Task.blocking {
        while !writing.load() { }
        pause()
        readingLater.store(true)
        return table.read { $0 }
    }
    }
    assertEqual(await writer.value, 1)
    assertEqual(await later.value, 1)
    await first.value
}

struct Tally {
    var count: Int
    var text: String
}

@test
fn crowdsOfReadersAndWritersSeeWholeValues() async {
    // Readers enough to be counted each in a place of its own, some of them,
    // and some writers, inside for long enough that the others sleep.
    let table = RwLock<Tally>(Tally { count: 0, text: "0" })
    let whole = await withTaskGroup(of: Bool.self) { group -> Bool in
        for task in 0..<6 {
            group.spawn {
                var whole = true
                for i in 0..<400 {
                    if i % 20 == task {
                        table.write { (tally: inout Tally) in
                            tally.count += 1
                            if i % 60 == 0 {
                                Runtime.sleep(nanoseconds: 20000)
                            }
                            tally.text = "\(tally.count)"
                        }
                    } else {
                        whole = table.read { tally -> Bool in
                            if i % 130 == 7 {
                                Runtime.sleep(nanoseconds: 15000)
                            }
                            return tally.text == "\(tally.count)"
                        } && whole
                    }
                }
                return whole
            }
        }
        var all = true
        for await whole in group {
            all = all && whole
        }
        return all
    }
    assert(whole, "a reader saw a value part-way through a write")
    assertEqual(table.read { $0.count }, 120)
}

// Waits, holding what it holds, for other threads to come to a lock.
fn pause() {
    let start = Instant.now()
    while start.elapsed < Duration.milliseconds(50) { }
}
