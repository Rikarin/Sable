    days.narrow=M|T|W|T|F|S|S
    ampm=AM|PM
    dates=EEEE, MMMM d, y|MMMM d, y|MMM d, y|M/d/yy
    times=h:mm:ss\u{202F}a zzzz|h:mm:ss\u{202F}a z|h:mm:ss\u{202F}a|h:mm\u{202F}a
    joins={1} 'at' {0}|{1} 'at' {0}|{1}, {0}|{1}, {0}
    week=7|1
    gmt=GMT{0}|GMT|+HH:mm;-HH:mm
    list.and.wide={0} and {1}|{0}, {1}|{0}, {1}|{0}, and {1}
    list.and.short={0} & {1}|{0}, {1}|{0}, {1}|{0}, & {1}
    list.and.narrow={0}, {1}|{0}, {1}|{0}, {1}|{0}, {1}
    list.or.wide={0} or {1}|{0}, {1}|{0}, {1}|{0}, or {1}
    list.or.short={0} or {1}|{0}, {1}|{0}, {1}|{0}, or {1}
    list.or.narrow={0} or {1}|{0}, {1}|{0}, {1}|{0}, or {1}
    list.unit.wide={0}, {1}|{0}, {1}|{0}, {1}|{0}, {1}
