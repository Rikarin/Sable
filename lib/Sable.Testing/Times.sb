module Sable.Testing

/// How many times a mock's member was to be called: what `verify` checks.
///
/// ```sable
/// assert(Times.once.allows(1) && !Times.once.allows(2))
/// assert(Times.atLeast(2).allows(9) && Times.between(1, 3).allows(3))
/// assert("\(Times.never)" == "never")
/// ```
public struct Times: Formattable {
    /// The fewest, and the most; the most is none for no limit.
    public let least: Int
    public let most: Int?

    public init(least: Int, most: Int?) {
        self.least = least
        self.most = most
    }

    public static var once: Times => Times(least: 1, most: 1)
    public static var never: Times => Times(least: 0, most: 0)
    public static var atLeastOnce: Times => Times(least: 1, most: none)

    public static fn exactly(_ count: Int) -> Times {
        return Times(least: count, most: count)
    }

    public static fn atLeast(_ count: Int) -> Times {
        return Times(least: count, most: none)
    }

    public static fn atMost(_ count: Int) -> Times {
        return Times(least: 0, most: count)
    }

    public static fn between(_ least: Int, _ most: Int) -> Times {
        return Times(least: least, most: most)
    }

    /// Whether it was called the right number of times, if so many.
    public fn allows(_ count: Int) -> Bool {
        if count < least {
            return false
        }
        if let most = most {
            return count <= most
        }
        return true
    }

    public fn format(_ spec: FormatSpec) -> String {
        return spec.padded(text)
    }

    var text: String {
        get {
            guard let most = most else {
                return least == 1 ? "at least once" : "at least \(least) times"
            }
            if least == most {
                return least == 0 ? "never" : least == 1 ? "once" : "\(least) times"
            }
            return least == 0 ? "at most \(Times.count(most))" : "\(least) to \(most) times"
        }
    }

    static fn count(_ n: Int) -> String {
        return n == 1 ? "once" : "\(n) times"
    }
}
