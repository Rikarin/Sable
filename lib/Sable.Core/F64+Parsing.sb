module Sable.Core

extension F64: Parsable {
    /// The number the text writes — digits with a point and an exponent if it
    /// likes, `1.5`, `.5`, `2e-3` — rounded to the nearest F64, ties to even;
    /// or `inf`, `infinity` or `nan` in any case. A sign is allowed. A number
    /// too large for an F64 is an infinity, as it rounds to.
    ///
    /// ```sable
    /// assert(try! F64.parse("0.1") == 0.1)
    /// assert(try! F64.parse("1e400") > 1.7976931348623157e308)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S) throws(ParseError) -> F64 {
        return try F64.parse(text, styles: .Sign)
    }

    /// The number the text writes, with what else the styles allow: white
    /// space, a sign, separators; or, with `.HexFloat`, a hexadecimal float.
    /// A prefix means nothing to a decimal float.
    ///
    /// ```sable
    /// assert(try! F64.parse(" 1_000.5 ", styles: .Any) == 1000.5)
    /// assert(try! F64.parse("0x1.8p1", styles: .HexFloat) == 3.0)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S, styles: NumberStyles) throws(ParseError) -> F64 {
        if styles.contains(.HexFloat) {
            return try hexFloat(text.asSubstring, styles)
        }
        let text = text.asSubstring
        // A finite number and nothing else, as most texts are, the runtime
        // reads at once; what it does not is checked, and then read without
        // what the styles allow around it.
        if styles.contains(.Sign) {
            let (parsed, value) = text.base.parseF64(text.start, text.end)
            if parsed {
                return value
            }
        }
        let plain = try plainFloat(text, styles)
        if let special = specialFloat(plain) {
            return special
        }
        let (parsed, value) = plain.base.parseF64(plain.start, plain.end)
        return parsed ? value : overflowedFloat(plain)
    }
}
