module Sable.Core

// Concurrency's core types (docs/02 §2.7, SYNTAX.md §19): tasks, groups of
// them, and cancellation. The members marked '@intrinsic' have bodies the
// compiler writes: a task is a class holding the runtime's handle, the body
// to run and, once run, its result, laid out per result type, and the
// runtime schedules it (SilGen.Tasks.cs, runtime/tasks.c).
//
// Tasks are structured: a task spawned from another is its child. It starts
// with its parent's priority, it is cancelled when its parent is, and its
// parent does not finish until it has. 'Task.detached' is the one way out.

/// A task running concurrently, and, once it finishes, its result. A
/// handle any task may hold: it is '@immutable', so Sendable.
///
/// ```sable
/// fn answer() async -> Int {
///     let task = Task.spawn { 6 * 7 }
///     return await task.value
/// }
/// ```
@immutable
public class Task<Success> {
    /// Made by 'spawn' and 'detached' alone: a task is its body, queued.
    private init() { }

    /// The body, queued to run as a child of the running task: it has the
    /// running task's priority, is cancelled with it, and the running task
    /// does not finish until it has.
    @intrinsic
    public static fn spawn<T>(_ body: @Sendable async () -> T) -> Task<T>

    /// The body, queued as a child of the running task, at this priority.
    @intrinsic
    public static fn spawn<T>(priority: TaskPriority, _ body: @Sendable async () -> T) -> Task<T>

    /// The body, queued to run as a task of its own, no child of the
    /// running task: it is not cancelled with it, nor waited for by it. Its
    /// priority is medium.
    @intrinsic
    public static fn detached<T>(_ body: @Sendable async () -> T) -> Task<T>

    /// The body, queued as a task of its own, at this priority.
    @intrinsic
    public static fn detached<T>(priority: TaskPriority, _ body: @Sendable async () -> T) -> Task<T>

    /// The task's result, waiting for it to finish. Waiting does not end
    /// early when the waiting task is cancelled: a child is cancelled with
    /// it, and finishes as soon as it notices.
    @intrinsic
    public var value: Success { async get }

    /// The runtime's handle on the task, which a group is given.
    @intrinsic
    var handle: Int { get }

    /// Waits until a child of the group has finished, unless one has or
    /// none is running: TaskGroup's.
    @intrinsic
    static async fn waitForGroup(_ group: Int)

    /// Parks the running task in a wait list until it is woken: WaitList's.
    @intrinsic
    static async fn park(_ waitList: Int)

    /// Parks the running task in a wait list until it is woken or
    /// cancelled, unless it was woken since the ticket (-1: none) or the
    /// task is cancelled already: WaitList's 'parkCancellably'.
    @intrinsic
    static async fn parkCancellably(_ waitList: Int, _ ticket: Int)

    /// Lets every task queued run before this one goes on.
    @intrinsic
    public static async fn `yield`()

    /// Waits until no other task can go on: each has finished, or waits —
    /// for another task, a channel, a sleep, a socket, or work on the
    /// blocking pool. It is how a test knows that what it set off has run
    /// as far as it can, on however many threads, where a number of
    /// `Task.yield()`s only hopes so. Tasks that settle at once go on one
    /// at a time, in the order they began.
    ///
    /// A sleep that ends, or a socket that becomes ready, is not waited
    /// for; a task that never waits — one that loops on `Task.yield()` —
    /// keeps this waiting for as long as it runs.
    ///
    /// ```sable
    /// let steps = Atomic(0)
    /// _ = Task.detached {
    ///     await Task.yield()
    ///     steps.store(1)
    /// }
    /// await Task.settle()
    /// assert(steps.load() == 1)
    /// ```
    public static async fn settle() {
        await Task.park(0)
    }

    /// Waits at least this many nanoseconds, off the run queue: every other
    /// task runs meanwhile, and the program waits only when none can. A
    /// task cancelled before or while it sleeps wakes at once, and the
    /// sleep throws CancellationError.
    public static async fn sleep(nanoseconds: Int) throws(CancellationError) {
        await Task.sleepUncancelled(nanoseconds: nanoseconds < 0 ? 0 : nanoseconds)
        try Task.checkCancellation()
    }

    /// The body run as a child that is given so long: what it gave, or
    /// none if it had not ended by then, and was cancelled and waited for;
    /// but as long as it likes once this task is cancelled, and it with it.
    /// One timer and one child: withTimeout's.
    public static fn limited<T>(nanoseconds: Int, _ body: @Sendable async () -> T) async -> T? {
        Task.beginTimed()
        let child = Task.spawn {
            let value = await body()
            Task.endTimed()
            return value
        }
        // At least one: under 0 is a sleep that the child's end ends.
        await Task.sleepUncancelled(nanoseconds: nanoseconds < 1 ? -1 : -nanoseconds)
        if Task.wokenTimed() || Task.isCancelled {
            return await child.value
        }
        child.cancel()
        let _ = await child.value
        return none
    }

    @builtin("task_timed_begin")
    static fn beginTimed()

    @builtin("task_timed_woken")
    static fn wokenTimed() -> Bool

    @builtin("task_timed_end")
    static fn endTimed()

    /// The sleep itself, which a cancellation ends without saying so.
    @intrinsic
    static async fn sleepUncancelled(nanoseconds: Int)

    /// Asks the task to stop, and every child it has. Cancelling is
    /// cooperative: the task goes on until it asks 'Task.isCancelled' or
    /// 'Task.checkCancellation()', but its cancellation handlers run at
    /// once, and a sleep it is in, or starts, ends at once. Cancelling a
    /// task that has finished, or cancelling twice, does nothing.
    @intrinsic
    public fn cancel()

    /// Whether the running task has been cancelled.
    public static var isCancelled: Bool => Task.runningIsCancelled()

    @builtin("task_is_cancelled")
    static fn runningIsCancelled() -> Bool

    /// Throws CancellationError if the running task has been cancelled.
    public static fn checkCancellation() throws(CancellationError) {
        if Task.runningIsCancelled() {
            throw CancellationError()
        }
    }

    /// The running task's priority: the one it was given, its parent's
    /// otherwise; the program's own task's is medium.
    public static var currentPriority: TaskPriority => TaskPriority(rawValue: Task.runningPriority())

    @builtin("task_priority")
    static fn runningPriority() -> Int

    /// Runs 'onCancel' if the running task is cancelled — at once, if it
    /// already is — until it is removed.
    @intrinsic
    static fn installCancellationHandler(_ onCancel: () -> ())

    @builtin("task_handler_pop")
    static fn removeCancellationHandler()

    /// Runs the body on a thread kept for work that blocks — a call into C
    /// that waits, a whole file read at once — and gives what it gives, or
    /// throws what it throws. The running task waits meanwhile, but no
    /// worker does: the others' tasks run on. The body runs as the running
    /// task, which it may ask 'Task.isCancelled', on another thread, so
    /// what it captures must be Sendable. Tokio's spawn_blocking.
    ///
    /// ```sable
    /// fn total(_ count: Int) async -> Int {
    ///     return await Task.blocking { count * (count + 1) / 2 }
    /// }
    /// ```
    public static async fn blocking<T, E>(_ body: @Sendable () throws(E) -> T) throws(E) -> T {
        let result = BlockingResult<T, E>()
        await Task.runBlocking { result.outcome = Outcome.catching(body) }
        return try result.outcome!.get()
    }

    /// Runs the work on the blocking pool while the running task waits.
    @intrinsic
    static async fn runBlocking(_ work: () -> ())
}

/// Where Task.blocking's body leaves what it gives, for the task to take.
class BlockingResult<T, E> {
    var outcome: Outcome<T, E>?

    init() {
        outcome = none
    }
}
