module BitSetTests

// BitSet (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn aBitSetIsGoneThroughAscending() {
    let members = BitSet()
    let _ = members.insert(130)
    let _ = members.insert(3)
    let _ = members.insert(64)
    let _ = members.insert(0)
    let _ = members.insert(63)
    var seen: String[>..] = []
    for member in members {
        seen.append("\(member)")
    }
    assertEqualText(seen.joined(separator: ","), "0,3,63,64,130")
    assertEqual(BitSet().toArray().count, 0)
}

@test
fn bitSetAlgebra() {
    let a = BitSet([1, 2, 3, 64, 200])
    let b = BitSet([2, 3, 4])
    assertEqual(a.count, 5)
    assertEqual(a.union(b).count, 6)
    assertEqual(a.intersection(b).count, 2)
    assertEqual(a.subtracting(b).count, 3)
    assert(BitSet([2, 3]).isSubset(of: a))
    assert(!b.isSubset(of: a), "4 is not in a")
}
