module SpecialFunctionsTests

// SpecialFunctions (Sable.Math), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Math
// Reference values are correctly rounded (mpmath, 60 digits). libm's gamma
// and error functions are held to a little more than its others: two
// units in the last place.

import Sable.Math
import Sable.Testing
import FloatAssertions

@test(arguments: [
    // gamma is C's tgamma: exact at 10! in glibc and Apple's libm, an ulp
    // under it in Windows' C runtime.
    (11.0, 3628800.0, 1),
    (0.5, 1.772453850905516, 2),
    (4.5, 11.631728396567448, 2),
    (-1.5, 2.363271801207355, 2),
    (30.0, 8.841761993739702e30, 2),
])
fn gammaExtendsTheFactorial(_ x: F64, _ value: F64, _ ulps: Int) {
    assertWithin(gamma(x), value, ulps: ulps)
}

@test(arguments: [(1.0, 1.0), (5.0, 24.0)])
fn gammaIsExactAtSmallIntegers(_ x: F64, _ value: F64) {
    assertSame(gamma(x), value)
}

@test(arguments: [
    (0.0, inf),
    (-0.0, -inf),
    (-1.0, nan),
    (-inf, nan),
    (inf, inf),
    (172.0, inf),
    (nan, nan),
])
fn gammaHasPolesAtZeroAndNaNAtNegativeIntegers(_ x: F64, _ value: F64) {
    assertSame(gamma(x), value)
}

@test(arguments: [(0.5, 0.5723649429247001), (10.0, 12.801827480081469), (100.0, 359.1342053695754), (-0.5, 1.2655121234846454)])
fn logGammaStaysFinitePastWhereGammaOverflows(_ x: F64, _ value: F64) {
    assertWithin(logGamma(x), value, ulps: 2)
}

@test(arguments: [(1.0, 0.0), (2.0, 0.0), (0.0, inf), (-1.0, inf), (-inf, inf)])
fn logGammaIsZeroAtOneAndTwoAndInfiniteAtThePoles(_ x: F64, _ value: F64) {
    assertSame(logGamma(x), value)
}

@test(arguments: [(-0.0, -0.0), (inf, 1.0), (-inf, -1.0), (nan, nan)])
fn erfIsOddAndBounded(_ x: F64, _ value: F64) {
    assertSame(erf(x), value)
}

@test(arguments: [(1.0, 0.8427007929497149), (-0.5, -0.5204998778130465), (1e-8, 1.1283791670955126e-8), (3.0, 0.9999779095030014)])
fn erfIsWithinTwoUlpsOfTheTrueValue(_ x: F64, _ value: F64) {
    assertWithin(erf(x), value, ulps: 2)
}

@test(arguments: [(1.0, 0.15729920705028513), (-0.5, 1.5204998778130465), (5.0, 1.537459794428035e-12), (20.0, 5.395865611607901e-176)])
fn erfcKeepsTheDigitsOfItsTail(_ x: F64, _ value: F64) {
    assertWithin(erfc(x), value, ulps: 2)
}

@test(arguments: [(-inf, 2.0), (inf, 0.0)])
fn erfcGoesFromTwoToZero(_ x: F64, _ value: F64) {
    assertSame(erfc(x), value)
}

@test
fn theF32FunctionsAreWithinTwoUlpsOfTheTrueValues() {
    let half: F32 = 0.5
    let one: F32 = 1.0
    let five: F32 = 5.0
    let ten: F32 = 10.0
    assertWithin(gamma(half), 1.7724539, ulps: 2)
    assertSame(gamma(five), 24.0)
    assertWithin(logGamma(ten), 12.801827, ulps: 2)
    assertWithin(erf(one), 0.8427008, ulps: 2)
    assertWithin(erfc(one), 0.1572992, ulps: 2)
    assertSame(erf(inf32), 1.0)
}
