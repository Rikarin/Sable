module Sable.Core

/// A dictionary's entry: a key, its value, and the key's hash, kept so that
/// growing, or merging into another dictionary, never hashes a key again.
struct DictionaryEntry<Key, Value> {
    var key: Key
    var value: Value
    var hash: Int
}

/// Keys to values, by hash: what `[Key: Value]` names, and what
/// `["a": 1, "b": 2]` makes.
///
/// Iteration goes through the keys in the order they were first added, and
/// that order is kept as keys are removed; setting a key that is already
/// there changes its value, not its place. A key is added, found and
/// removed in constant time on average, whatever the keys: each hash is
/// seeded per run (Hasher), so keys cannot be chosen to collide.
///
/// It is a value, as an array is: a copy is a dictionary of its own, and
/// the two share their storage until one of them changes.
///
/// ```sable
/// var ages: [String: Int] = ["ann": 31]
/// ages["bob"] = 27
/// ages["ann", default: 0] += 1
/// assert(ages["ann"] == 32)
/// assert(ages.keys() == ["ann", "bob"])
/// ages["bob"] = none
/// assert(ages.count == 1)
/// ```
///
/// The entries are kept in an array in the order they were added, a removed
/// one leaving none in its place until the table is next rebuilt. Beside it
/// is the index: a power of two of slots, at most half of them used, each
/// empty (-1), left by a removed entry (-2), or holding an entry's position
/// with the top 31 bits of its key's hash above it. A lookup starts at the
/// slot the hash's bottom bits pick and goes forward one slot at a time
/// (linear probing), comparing the hash bits a slot holds before it
/// compares keys — SwissTable's idea, without its SIMD groups — so that a
/// miss rarely looks at the entries at all.
public struct Dictionary<Key: Hashable, Value>: Sequence {
    var entries: DictionaryEntry<Key, Value>?[>..] = []
    var slots: Int[>..] = []
    var live: Int = 0

    /// An empty dictionary.
    public init() { }

    /// An empty dictionary with room for this many keys before it grows.
    public init(minimumCapacity: Int) {
        reserveCapacity(minimumCapacity)
    }

    /// What `["a": 1, "b": 2]` makes: the entries added in order, a later
    /// key that is already there replacing the earlier one's value.
    public init(dictionaryLiteral entries: (Key, Value)[>..]) {
        reserveCapacity(entries.count)
        for (key, value) in entries {
            self[key] = value
        }
    }

    /// The values grouped by the key each one gives: each key with the
    /// values that gave it, in the order they came; the keys in the order
    /// they were first given.
    ///
    /// ```sable
    /// let words: String[>..] = ["fig", "pear", "kiwi", "plum", "apple"]
    /// let byLength = Dictionary(grouping: words, by: { $0.count })
    /// assert(byLength[4]! == ["pear", "kiwi", "plum"])
    /// assert(byLength.keys() == [3, 4, 5])
    /// ```
    public init<S: Sequence>(grouping values: S, by keyFor: (S.Element) -> Key) where Value == S.Element[>..] {
        for value in values {
            self[keyFor(value), default: []].append(value)
        }
    }

    // ---- Size ---------------------------------------------------------------

    /// How many keys it holds.
    public var count: Int => live

    /// Whether it holds no keys.
    public var isEmpty: Bool => live == 0

    /// How many keys it can hold before it has to grow.
    public var capacity: Int => slots.count / 2

    /// Makes room for at least this many keys, so that adding them does not
    /// grow the table on the way.
    public mutating fn reserveCapacity(_ minimumCapacity: Int) {
        if minimumCapacity * 2 > slots.count {
            rebuild(Dictionary.sizeFor(minimumCapacity))
        }
    }

    /// Gives back the room that the keys it holds do not need, and drops
    /// what removed keys left behind.
    public mutating fn shrinkToFit() {
        if live == 0 {
            entries = []
            slots = []
            return
        }
        rebuild(Dictionary.sizeFor(live))
    }

    // ---- Looking up and changing --------------------------------------------

    /// The key's value, or none. Setting a value adds the key or changes its
    /// value; setting none removes it.
    public subscript(key: Key) -> Value? {
        get {
            let at = find(key, Dictionary.hashOf(key))
            if at < 0 {
                return none
            }
            return entries[slots[at] & 4294967295]!.value
        }
        set {
            if let value = newValue {
                updateValue(value, forKey: key)
            } else {
                remove(key)
            }
        }
    }

    /// The key's value, or the fallback when it has none; setting it sets
    /// the key's value: `counts[word, default: 0] += 1`.
    public subscript(key: Key, default fallback: Value) -> Value {
        get {
            return self[key] ?? fallback
        }
        set {
            updateValue(newValue, forKey: key)
        }
    }

    /// Whether the key has a value.
    public fn contains(_ key: Key) -> Bool {
        return find(key, Dictionary.hashOf(key)) >= 0
    }

    /// Sets the key's value, adding the key if it is new; gives the value it
    /// replaced, or none when the key is new.
    @discardable
    public mutating fn updateValue(_ value: Value, forKey key: Key) -> Value? {
        let hash = Dictionary.hashOf(key)
        let at = place(key, hash)
        let slot = slots[at]
        if slot >= 0 {
            let index = slot & 4294967295
            var entry = entries[index]!
            let old = entry.value
            entry.value = value
            entries[index] = entry
            return old
        }
        add(at, key, value, hash)
        return none
    }

    /// Adds the key with the value, unless the key is there already, whose
    /// value is then left as it is; true if it was added.
    @discardable
    public mutating fn insert(_ value: Value, forKey key: Key) -> Bool {
        let hash = Dictionary.hashOf(key)
        let at = place(key, hash)
        if slots[at] >= 0 {
            return false
        }
        add(at, key, value, hash)
        return true
    }

    /// The key's value, taken out: none when it had none.
    @discardable
    public mutating fn remove(_ key: Key) -> Value? {
        let at = find(key, Dictionary.hashOf(key))
        if at < 0 {
            return none
        }
        let index = slots[at] & 4294967295
        let removed = entries[index]!.value
        entries[index] = none
        slots[at] = -2
        live = live - 1
        return removed
    }

    /// Every key and its value, taken out, and the room they took given back.
    public mutating fn removeAll() {
        entries = []
        slots = []
        live = 0
    }

    /// Every key and its value, taken out; with `keepingCapacity: true` the
    /// table keeps its size, for as many keys again.
    public mutating fn removeAll(keepingCapacity: Bool) {
        if !keepingCapacity {
            removeAll()
            return
        }
        let size = slots.count
        entries = []
        live = 0
        slots = []
        var i = 0
        while i < size {
            slots.append(-1)
            i = i + 1
        }
    }

    // ---- Entries --------------------------------------------------------------
    //
    // Rust's 'entry(key)' API, as methods: a handle on a dictionary's slot
    // would have to refer into the dictionary, which a value cannot.

    /// The key's value, first set to this one if the key had none: Rust's
    /// `entry(key).or_insert(value)`.
    public mutating fn orInsert(_ key: Key, _ value: Value) -> Value {
        let hash = Dictionary.hashOf(key)
        let at = place(key, hash)
        let slot = slots[at]
        if slot >= 0 {
            return entries[slot & 4294967295]!.value
        }
        add(at, key, value, hash)
        return value
    }

    /// The key's value, first set to what `make` gives if the key had none:
    /// `make` is called only then. Rust's `entry(key).or_insert_with(make)`.
    public mutating fn orInsertWith(_ key: Key, _ make: () -> Value) -> Value {
        let hash = Dictionary.hashOf(key)
        let at = place(key, hash)
        let slot = slots[at]
        if slot >= 0 {
            return entries[slot & 4294967295]!.value
        }
        let value = make()
        add(at, key, value, hash)
        return value
    }

    /// Replaces the key's value with what `change` makes of it, when the key
    /// has one; true if it had. Rust's `entry(key).and_modify(change)`.
    ///
    /// The closure is given the value and gives back the one to keep. (An
    /// `inout` closure, which would change the value where it is, waits on
    /// the language: issue #255.)
    @discardable
    public mutating fn modify(_ key: Key, _ change: (Value) -> Value) -> Bool {
        let at = find(key, Dictionary.hashOf(key))
        if at < 0 {
            return false
        }
        replaceValue(at, change)
        return true
    }

    /// Replaces the key's value with what `change` makes of it, the key
    /// first set to the fallback if it had no value:
    /// `counts.modify(word, default: 0) { (n: Int) -> Int in n + 1 }`.
    public mutating fn modify(_ key: Key, default fallback: Value, _ change: (Value) -> Value) {
        let hash = Dictionary.hashOf(key)
        let at = place(key, hash)
        if slots[at] < 0 {
            add(at, key, fallback, hash)
        }
        replaceValue(at, change)
    }

    // ---- Merging and transforming ---------------------------------------------

    /// Adds the other's keys: a key both have gets what `combine` makes of
    /// this one's value and the other's, in that order.
    public mutating fn merge(_ other: [Key: Value], uniquingKeysWith combine: (Value, Value) -> Value) {
        reserveCapacity(live + other.count)
        for entry in other.entries {
            if let entry = entry {
                mergeOne(place(entry.key, entry.hash), entry, combine)
            }
        }
    }

    /// This dictionary with the other's keys added, as `merge` adds them.
    public fn merging(_ other: [Key: Value], uniquingKeysWith combine: (Value, Value) -> Value) -> [Key: Value] {
        var merged = self
        merged.merge(other, uniquingKeysWith: combine)
        return merged
    }

    /// The same keys, in the same order, each with its value transformed.
    /// No key is hashed again: the index is shared as it is.
    public fn mapValues<T>(_ transform: (Value) -> T) -> [Key: T] {
        var mapped: DictionaryEntry<Key, T>?[>..] = []
        for entry in entries {
            if let entry = entry {
                mapped.append(DictionaryEntry { key: entry.key, value: transform(entry.value), hash: entry.hash })
            } else {
                mapped.append(none)
            }
        }
        return Dictionary<Key, T> { entries: mapped, slots: slots, live: live }
    }

    /// The keys whose values `transform` makes something of, in the same
    /// order, each with what it made; the rest are left out.
    public fn compactMapValues<T>(_ transform: (Value) -> T?) -> [Key: T] {
        var kept: DictionaryEntry<Key, T>?[>..] = []
        for entry in entries {
            if let entry = entry {
                if let value = transform(entry.value) {
                    kept.append(DictionaryEntry { key: entry.key, value: value, hash: entry.hash })
                }
            }
        }
        var result = Dictionary<Key, T> { entries: kept, slots: [], live: kept.count }
        result.rebuild(Dictionary<Key, T>.sizeFor(kept.count))
        return result
    }

    /// The keys and values `isIncluded` says to keep, in the same order.
    public fn filter(_ isIncluded: (Key, Value) -> Bool) -> [Key: Value] {
        var kept: DictionaryEntry<Key, Value>?[>..] = []
        for entry in entries {
            if let entry = entry {
                if isIncluded(entry.key, entry.value) {
                    kept.append(entry)
                }
            }
        }
        var result = Dictionary<Key, Value> { entries: kept, slots: [], live: kept.count }
        result.rebuild(Dictionary.sizeFor(kept.count))
        return result
    }

    /// Keeps the keys and values `keep` says to keep, in the order they were;
    /// the rest are removed.
    public mutating fn retain(where keep: (Key, Value) -> Bool) {
        var kept: DictionaryEntry<Key, Value>?[>..] = []
        for entry in entries {
            if let entry = entry {
                if keep(entry.key, entry.value) {
                    kept.append(entry)
                }
            }
        }
        if kept.count == live {
            return
        }
        entries = kept
        live = kept.count
        rebuild(slots.count)
    }

    // ---- Iteration ------------------------------------------------------------

    /// The keys, in the order they were first added.
    public fn keys() -> Key[>..] {
        var keys: Key[>..] = []
        for entry in entries {
            if let entry = entry {
                keys.append(entry.key)
            }
        }
        return keys
    }

    /// The values, in the order `keys()` gives their keys.
    public fn values() -> Value[>..] {
        var values: Value[>..] = []
        for entry in entries {
            if let entry = entry {
                values.append(entry.value)
            }
        }
        return values
    }

    /// An iterator over each key with its value, in the order the keys were
    /// first added: what `for (key, value) in dictionary` goes through.
    public fn makeIterator() -> DictionaryIterator<Key, Value> {
        return DictionaryIterator { entries: entries, position: 0 }
    }

    // ---- The table ------------------------------------------------------------

    /// The key's hash, under this run's seed.
    static fn hashOf(_ key: Key) -> Int {
        var hasher = Hasher()
        key.hash(into: &hasher)
        return hasher.finalize()
    }

    /// The bits of a hash a slot keeps: its top 31, where the slot a probe
    /// starts at is picked by its bottom ones.
    static fn tagOf(_ hash: Int) -> Int {
        return (hash >> 33) & 2147483647
    }

    /// The fewest slots, a power of two and at least 8, that hold this many
    /// keys at most half full.
    static fn sizeFor(_ keys: Int) -> Int {
        var size = 8
        while keys * 2 > size {
            size = size * 2
        }
        return size
    }

    /// The slot holding the key, or -1 when no slot does.
    fn find(_ key: Key, _ hash: Int) -> Int {
        if live == 0 {
            return -1
        }
        let mask = slots.count - 1
        let tag = Dictionary.tagOf(hash)
        var at = hash & mask
        while true {
            let slot = slots[at]
            if slot == -1 {
                return -1
            }
            if slot >= 0 && slot >> 32 == tag && entries[slot & 4294967295]!.key == key {
                return at
            }
            at = (at + 1) & mask
        }
    }

    /// The slot holding the key, or, when no slot does, the one it would be
    /// added in — the first a removed entry left that the probe passed, else
    /// the empty one that ended it. The table is first made big enough for
    /// one more entry, so the slot given is still the one to fill.
    mutating fn place(_ key: Key, _ hash: Int) -> Int {
        if (entries.count + 1) * 2 > slots.count {
            grow()
        }
        let mask = slots.count - 1
        let tag = Dictionary.tagOf(hash)
        var at = hash & mask
        var reuse = -1
        while true {
            let slot = slots[at]
            if slot == -1 {
                return reuse >= 0 ? reuse : at
            }
            if slot >= 0 {
                if slot >> 32 == tag && entries[slot & 4294967295]!.key == key {
                    return at
                }
            } else if reuse < 0 {
                reuse = at
            }
            at = (at + 1) & mask
        }
    }

    /// Adds a new entry in the slot `place` gave for it.
    mutating fn add(_ at: Int, _ key: Key, _ value: Value, _ hash: Int) {
        slots[at] = (Dictionary.tagOf(hash) << 32) | entries.count
        entries.append(DictionaryEntry { key: key, value: value, hash: hash })
        live = live + 1
    }

    /// The value in the slot replaced by what `change` makes of it. The
    /// entry is taken out of the array while `change` runs, so the value it
    /// is given is referred to from nowhere else.
    mutating fn replaceValue(_ at: Int, _ change: (Value) -> Value) {
        let index = slots[at] & 4294967295
        var entry = entries[index]!
        entries[index] = none
        entry.value = change(entry.value)
        entries[index] = entry
    }

    /// One of another dictionary's entries merged in, at the slot `place`
    /// gave for its key.
    mutating fn mergeOne(_ at: Int, _ entry: DictionaryEntry<Key, Value>, _ combine: (Value, Value) -> Value) {
        let slot = slots[at]
        if slot < 0 {
            slots[at] = (Dictionary.tagOf(entry.hash) << 32) | entries.count
            entries.append(entry)
            live = live + 1
            return
        }
        let index = slot & 4294967295
        var mine = entries[index]!
        entries[index] = none
        mine.value = combine(mine.value, entry.value)
        entries[index] = mine
    }

    /// Room for the next entry. Removed entries are dropped first; the table
    /// then doubles if the keys it holds would fill more than a quarter of
    /// it, so that what was dropped, or the doubling, leaves room for as
    /// many keys again before the next rebuild.
    mutating fn grow() {
        var size = slots.count < 8 ? 8 : slots.count
        while live * 4 > size {
            size = size * 2
        }
        rebuild(size)
    }

    /// The index built again with this many slots, from the hashes the
    /// entries keep, and what removed entries left dropped from the array.
    mutating fn rebuild(_ size: Int) {
        if live < entries.count {
            var kept: DictionaryEntry<Key, Value>?[>..] = []
            for entry in entries {
                if let entry = entry {
                    kept.append(entry)
                }
            }
            entries = kept
        }

        var fresh: Int[>..] = []
        var i = 0
        while i < size {
            fresh.append(-1)
            i = i + 1
        }
        let mask = size - 1
        var index = 0
        for entry in entries {
            let hash = entry!.hash
            var at = hash & mask
            while fresh[at] != -1 {
                at = (at + 1) & mask
            }
            fresh[at] = (Dictionary.tagOf(hash) << 32) | index
            index = index + 1
        }
        slots = fresh
    }
}

/// Goes through a dictionary's keys with their values, in the order the
/// keys were first added.
public struct DictionaryIterator<Key, Value>: Iterator {
    let entries: DictionaryEntry<Key, Value>?[>..]
    var position: Int

    /// The next key with its value, or none after the last.
    public mutating fn next() -> (Key, Value)? {
        while position < entries.count {
            let entry = entries[position]
            position = position + 1
            if let entry = entry {
                return (entry.key, entry.value)
            }
        }
        return none
    }
}
