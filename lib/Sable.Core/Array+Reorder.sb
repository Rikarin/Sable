module Sable.Core

// Moving an array's elements about in place, and the copies that leave the
// array as it was ('reversed'). Every kind of array has these: a mutating
// member of 'Element[:]' changes the array it is called on where it is,
// with nothing copied (docs/02 §2.5). None changes how many elements there
// are; an index outside 0..<count traps, as indexing does.

extension<Element> Element[:] {
    /// Swaps the elements at 'i' and 'j'; the same index twice leaves the
    /// array as it is.
    ///
    /// ```sable
    /// var xs: Int[>..] = [1, 2, 3]
    /// xs.swapAt(0, 2)
    /// assert(xs == [3, 2, 1])
    /// ```
    public mutating fn swapAt(_ i: Int, _ j: Int) {
        let held = self[i]
        self[i] = self[j]
        self[j] = held
    }

    /// Puts the elements in the opposite order.
    public mutating fn reverse() {
        self.reverse(from: 0, to: self.count)
    }

    /// The elements from 'from' up to, not including, 'to', put in the
    /// opposite order.
    mutating fn reverse(from: Int, to: Int) {
        var low = from
        var high = to - 1
        while low < high {
            self.swapAt(low, high)
            low = low + 1
            high = high - 1
        }
    }

    /// The elements in the opposite order, in an array of their own.
    public fn reversed() -> Element[>..] {
        var result: Element[>..] = []
        var i = self.count - 1
        while i >= 0 {
            result.append(self[i])
            i = i - 1
        }
        return result
    }

    /// Moves every element 'count' places towards the start, those that go
    /// past it coming round to the end: the element at 'count' is then the
    /// first (Rust's rotate_left). 'count' is taken round the array's
    /// count, so it may be any size, or negative to rotate the other way.
    /// Linear: the elements are moved as they are, with nothing copied.
    ///
    /// ```sable
    /// var xs: Int[>..] = [1, 2, 3, 4, 5]
    /// xs.rotate(left: 2)
    /// assert(xs == [3, 4, 5, 1, 2])
    /// ```
    public mutating fn rotate(left count: Int) {
        self.rotate(from: 0, to: self.count, left: count)
    }

    /// Rotates the elements from 'from' up to, not including, 'to', as
    /// 'rotate(left:)' rotates them all, leaving the rest where they are; a
    /// range not within the array traps. What moves the elements after a
    /// place up or down one, for inserting and removing there.
    ///
    /// ```sable
    /// var xs: Int[>..] = [1, 2, 3, 4, 5]
    /// xs.rotate(from: 1, to: 4, left: 1)
    /// assert(xs == [1, 3, 4, 2, 5])
    /// ```
    @builtin("array_rotate")
    public mutating fn rotate(from: Int, to: Int, left count: Int)

    /// Moves every element 'count' places towards the end, those that go
    /// past it coming round to the start: the last 'count' elements are
    /// then the first (Rust's rotate_right).
    public mutating fn rotate(right count: Int) {
        self.rotate(left: 0 - count)
    }

    /// Sets every element to the value.
    public mutating fn fill(_ value: Element) {
        var i = 0
        while i < self.count {
            self[i] = value
            i = i + 1
        }
    }

    /// Sets each element to the one at its index in 'source', which must
    /// have as many: one that does not traps, at the first index past the
    /// shorter of the two (Rust's copy_from_slice, .NET's CopyTo).
    ///
    /// ```sable
    /// var xs: Int[>..] = [0, 0, 0]
    /// xs.copy(from: [7, 8, 9])
    /// assert(xs == [7, 8, 9])
    /// ```
    public mutating fn copy(from source: Element[:]) {
        let longer = source.count > self.count ? source.count : self.count
        var i = 0
        while i < longer {
            self[i] = source[i]
            i = i + 1
        }
    }

    /// Moves the elements that pass the test after those that fail it, and
    /// gives where the first that passes now is — the count when none does.
    /// Neither part keeps its order (Swift's partition(by:)). Linear: each
    /// element is tested once, and moved at most once.
    ///
    /// ```sable
    /// var xs: Int[>..] = [1, 8, 3, 6, 5]
    /// let p = xs.partition(by: (x: Int) => x > 4)
    /// assert(p == 2)
    /// ```
    public mutating fn partition(by belongsInSecondPart: (Element) -> Bool) -> Int {
        var low = 0
        var high = self.count
        while low < high {
            while low < high && !belongsInSecondPart(self[low]) {
                low = low + 1
            }
            while low < high && belongsInSecondPart(self[high - 1]) {
                high = high - 1
            }
            if low >= high {
                return low
            }
            self.swapAt(low, high - 1)
            low = low + 1
            high = high - 1
        }
        return low
    }

    /// Reorders the elements so that the one at 'index' is the one sorting
    /// by 'before' would put there, those ahead of it none after it and
    /// those behind it none before it, each side in no particular order
    /// (Rust's select_nth_unstable_by, C++'s nth_element). Quickselect on
    /// the median of three: linear on average.
    public mutating fn selectNth(_ index: Int, by before: (Element, Element) -> Bool) {
        // Traps for an index outside the array, as indexing does.
        let _ = self[index]
        var low = 0
        var high = self.count - 1
        while low < high {
            // The median of the first, middle and last goes to 'high', as
            // the pivot; a sorted or reversed run then splits in half.
            let middle = low + (high - low) / 2
            if before(self[middle], self[low]) {
                self.swapAt(middle, low)
            }
            if before(self[high], self[low]) {
                self.swapAt(high, low)
            }
            if before(self[middle], self[high]) {
                self.swapAt(middle, high)
            }

            // Lomuto: what goes before the pivot moves to the front.
            var store = low
            var i = low
            while i < high {
                if before(self[i], self[high]) {
                    self.swapAt(i, store)
                    store = store + 1
                }
                i = i + 1
            }
            self.swapAt(store, high)

            if store == index {
                return
            }
            if index < store {
                high = store - 1
            } else {
                low = store + 1
            }
        }
    }
}

extension<Element: Comparable> Element[:] {
    /// Reorders the elements so that the one at 'index' is the one sorting
    /// would put there, none ahead of it greater and none behind it less.
    ///
    /// ```sable
    /// var xs: Int[>..] = [9, 1, 8, 2, 7]
    /// xs.selectNth(2)
    /// assert(xs[2] == 7)
    /// ```
    public mutating fn selectNth(_ index: Int) {
        self.selectNth(index, by: (a: Element, b: Element) => a < b)
    }
}
