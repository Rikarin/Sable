module BitSetTests

// BitSet (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn aBitSetIsGoneThroughAscending() {
    let members = BitSet()
    _ = members.insert(130)
    _ = members.insert(3)
    _ = members.insert(64)
    _ = members.insert(0)
    _ = members.insert(63)
    var seen: String[>..] = []
    for member in members {
        seen.append("\(member)")
    }
    assertEqualText(seen.joined(separator: ","), "0,3,63,64,130")
    assertEqual(BitSet().toArray().count, 0)
}

@test
fn bitSetAlgebra() {
    let a = BitSet([1, 2, 3, 64, 200])
    let b = BitSet([2, 3, 4])
    assertEqual(a.count, 5)
    assertEqual(a.union(b).count, 6)
    assertEqual(a.intersection(b).count, 2)
    assertEqual(a.subtracting(b).count, 3)
    expect(BitSet([2, 3]).isSubset(of: a))
    expect(!b.isSubset(of: a), "4 is not in a")
}

@test
fn insertAddsEachValueOnce() {
    let members = BitSet()
    expect(members.isEmpty)
    expect(members.insert(70))
    expect(!members.insert(70))
    expect(members.insert(0))
    assertEqual(members.count, 2)
    expect(!members.isEmpty)
    expect(members.contains(70))
    expect(!members.contains(71))
    expect(!members.contains(1000))
    expect(!members.contains(-1))
}

@test(traps: "array index out of range")
fn insertingANegativeValueTraps() {
    let members = BitSet()
    _ = members.insert(-1)
}

@test
fn removeTakesOutAValue() {
    let members = BitSet([3, 130])
    expect(members.remove(130))
    expect(!members.remove(130))
    expect(!members.remove(5))
    assertEqual(members.count, 1)
    expect(members.toArray() == [3])
}

@test
fn elementsAreAscending() {
    let members = BitSet([200, 1, 64, 63, 0])
    expect(members.toArray() == [0, 1, 63, 64, 200])
    members.removeAll()
    assertEqual(members.count, 0)
    assertEqual(members.toArray().count, 0)
}

@test
fn algebraWithSetsOfDifferentLengths() {
    let short = BitSet([1, 2])
    let long = BitSet([2, 300])
    expect(short.union(long).toArray() == [1, 2, 300])
    expect(long.union(short).toArray() == [1, 2, 300])
    expect(short.intersection(long).toArray() == [2])
    expect(long.subtracting(short).toArray() == [300])
    expect(short.subtracting(long).toArray() == [1])
    expect(!long.isSubset(of: short))
    expect(BitSet([2]).isSubset(of: long))
    expect(BitSet().isSubset(of: short))
}

@test
fn aBitSetIsMadeFromAnySequenceOfInts() {
    let small = BitSet(1...3)
    assertEqual(small.count, 3)
    expect(small.contains(2))
    let collected: BitSet = [5, 5, 64].collect()
    assertEqual(collected.count, 2)
    expect(collected.contains(64))
}

@test
fn bitSetsCombineAndCompare() {
    let a = BitSet([1, 2, 3, 100])
    let b = BitSet([3, 4, 100])
    expect(a.symmetricDifference(b).toArray() == [1, 2, 4])
    expect(BitSet([1, 2]).isDisjoint(with: BitSet([3, 64])))
    expect(!a.isDisjoint(with: b))
    expect(a.isSuperset(of: BitSet([1, 100])))
    expect(BitSet([1]).isStrictSubset(of: a))
    expect(!a.isStrictSubset(of: a))
    expect(a.isStrictSuperset(of: BitSet([2])))
    let c = BitSet([1, 2])
    c.formUnion(BitSet([200]))
    expect(c.toArray() == [1, 2, 200])
    c.formIntersection(BitSet([2, 200, 300]))
    expect(c.toArray() == [2, 200])
    c.subtract(BitSet([2]))
    expect(c.toArray() == [200])
    c.formSymmetricDifference(BitSet([200, 7]))
    expect(c.toArray() == [7])
    assertEqual(c.count, 1)
}

@test
fn aBitSetKnowsItsLeastGreatestAndARange() {
    let bits = BitSet([70, 3, 9, 128])
    assertEqual(bits.min, 3)
    assertEqual(bits.max, 128)
    expect(BitSet().min == none && BitSet().max == none)
    expect(bits.members(in: 4..<129) == [9, 70, 128])
    expect(bits.members(in: 0..<3) == [] as Int[>..])
    expect(bits.members(in: -5..<1000) == [3, 9, 70, 128])
    expect(bits.members(in: 64..<128) == [70])
}

@test(arguments: [(0, 100), (64, 65), (5, 1000), (200, 200)])
fn setsOfDifferentLengthsCombine(_ short: Int, _ long: Int) {
    let a = BitSet((0..<short).filter { $0 % 3 == 0 })
    let b = BitSet((0..<long).filter { $0 % 5 == 0 })
    for (x, y) in [(a, b), (b, a)] {
        let both = (0..<1000).filter({ x.contains($0) || y.contains($0) }).toArray()
        expect(x.union(y).toArray() == both && x.union(y).count == both.count)
        let common = (0..<1000).filter({ x.contains($0) && y.contains($0) }).toArray()
        expect(x.intersection(y).toArray() == common && x.intersection(y).count == common.count)
        let left = (0..<1000).filter({ x.contains($0) && !y.contains($0) }).toArray()
        expect(x.subtracting(y).toArray() == left && x.subtracting(y).count == left.count)
        let either = (0..<1000).filter({ x.contains($0) != y.contains($0) }).toArray()
        expect(x.symmetricDifference(y).toArray() == either && x.symmetricDifference(y).count == either.count)
    }
}

@test
fn aBitSetGrowsToWhatIsInserted() {
    let bits = BitSet()
    expect(bits.insert(640) && !bits.insert(640) && bits.insert(0))
    expect(bits.toArray() == [0, 640])
}

@test(traps: "array index out of range")
fn aNegativeValueIsNotInserted() {
    _ = BitSet().insert(-1)
}
