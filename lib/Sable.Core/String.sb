module Sable.Core

// String's own members (docs/06 §6.4). A string is UTF-8, and these count
// by Unicode scalar: 'count' scalars, 'at' one of them, 'slice' a run of
// them. Finding scalar n of text that is not ASCII means counting to it, so
// 'at' and 'slice' are O(n) there (the runtime remembers where it last was,
// which keeps a loop over n linear); a String.Index (String+Index.sb) is a
// byte offset, and constant time everywhere. What only the runtime can do
// is a '@builtin', applied where it is called; the rest is Sable over
// those. Searching, case, trimming and the like are in String+Case and
// StringProtocol+Search and +Transform, shared with Substring.

extension String {
    /// How many Unicode scalars the string has.
    @builtin("string_count")
    public var count: Int { get }

    /// Whether the string has no scalars.
    public var isEmpty: Bool => self.count == 0

    /// Whether every scalar is ASCII: then each is one byte, and the
    /// scalar-numbered members below are constant time.
    public var isAscii: Bool => self.utf8Count == self.count

    /// The scalar at the index, counting from 0; out of range traps. O(n)
    /// unless the string is ASCII, where reading at a String.Index is not.
    @builtin("string_at")
    public fn at(index: Int) -> Char

    /// The scalars from 'from' up to, not including, 'to'. O(n) to find
    /// unless the string is ASCII, where slicing by String.Index is not.
    @builtin("string_slice")
    public fn slice(from: Int, to: Int) -> String

    /// This string, then the other.
    @builtin("string_concat")
    public fn appending(other: String) -> String

    /// Whether the character occurs in the string.
    @builtin("string_contains")
    public fn contains(character: Char) -> Bool

    /// Where the character first occurs, counted in scalars, or none.
    /// `firstIndex(of:)` gives a String.Index instead.
    public fn indexOf(character: Char) -> Int? {
        let index = self.firstScalarIndex(character)
        if index < 0 {
            return none
        }
        return index
    }

    /// Where the character first occurs, or -1.
    @builtin("string_index_of")
    fn firstScalarIndex(_ character: Char) -> Int

    /// The string without the white space — Unicode's White_Space, as
    /// `Char.isWhitespace` has it — that begins and ends it.
    @builtin("string_trimmed")
    public fn trimmed() -> String

    /// The runs between each occurrence of the separator, empty ones kept.
    @builtin("string_split")
    public fn split(separator: Char) -> String[>..]

    /// A string of the one character.
    @builtin("string_from_Char")
    public static fn fromChar(character: Char) -> String

    /// Whether the bytes from one offset up to another are an F64, and the
    /// F64 when they are.
    @builtin("string_to_F64")
    fn parseF64(_ from: Int, _ to: Int) -> (Bool, F64)

    /// The byte at the offset of the UTF-8 encoding; out of range traps.
    @builtin("string_utf8_at")
    fn utf8Byte(_ offset: Int) -> U8

    /// The eight bytes of the UTF-8 encoding from the offset, the first the
    /// lowest; traps unless all are in it.
    @builtin("string_utf8_load_U64")
    fn utf8Word(_ offset: Int) -> U64

    /// The eight bytes from the offset, which must be in the encoding, the
    /// first the lowest, and zeros past the encoding's end.
    @inline(always)
    package fn utf8Window(_ offset: Int) -> U64 {
        let count = self.utf8Count
        if count - offset >= 8 {
            return self.utf8Word(offset)
        }
        return self.utf8Tail(offset)
    }

    /// The same of the last fewer than eight bytes.
    @inline(always)
    package fn utf8Tail(_ offset: Int) -> U64 {
        let count = self.utf8Count
        if count >= 8 {
            return self.utf8Word(count &- 8) >> U64.truncating(64 &- 8 &* (count &- offset))
        }
        return self.utf8Last >> U64.truncating(8 &* offset)
    }

    /// Whether the bytes of the UTF-8 encoding from one offset up to another
    /// are the other string's.
    @inline(always)
    package fn hasUtf8(from: Int, to: Int, equalTo other: String) -> Bool {
        return to &- from == other.utf8Count && Runtime.compareStrings(self, from, to, other, 0, other.utf8Count) == 0
    }

    /// The same bytes' hash under a key, which is one string's in every run.
    package fn hash(utf8From from: Int, to: Int, key: U64) -> U64 {
        return Runtime.hashString(self, from, to, key: key unchecked as Int) unchecked as U64
    }

    /// The last eight bytes of the UTF-8 encoding, the first of them the
    /// lowest; or all of them, and zeros, where there are fewer.
    @builtin("string_utf8_last_U64")
    package var utf8Last: U64 { get }
}
