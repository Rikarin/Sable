module Sable.Core

extension I64: Parsable {
    /// The number the text writes in decimal, with a sign if it likes: what
    /// `format` writes with nothing said. `.Overflow` past the greatest I64,
    /// `.Underflow` past the least.
    ///
    /// ```sable
    /// assert(try! I64.parse("-9223372036854775808") == -9223372036854775808)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S) throws(ParseError) -> I64 {
        return try I64.parse(text, radix: 10, styles: .Sign)
    }

    /// The number the text writes in the radix — 2 to 36, with letters of
    /// either case past 9; another traps — with what else the styles allow:
    /// white space, a sign, the radix's prefix, separators.
    ///
    /// ```sable
    /// assert(try! I64.parse("0x7f", radix: 16, styles: .Prefix) == 127)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S, radix: Int, styles: NumberStyles = .Sign) throws(ParseError) -> I64 {
        let (negative, magnitude) = try parseInteger(text.asSubstring, radix, styles)
        let value = try signedValue(negative, magnitude, 9223372036854775807)
        return I64(value)
    }
}
