module ThreadLocalTests

// ThreadLocal (Sable.Concurrency).

import Sable.Concurrency
import Sable.Interop
import Sable.Testing

struct Failed: Error { }

// Says it is gone, in order.
final class Marked {
    let name: String
    let log: Mutex<String[>..]>

    init(_ name: String, _ log: Mutex<String[>..]>) {
        self.name = name
        self.log = log
    }

    deinit {
        let name = self.name
        log.withLock { $0.append(name) }
    }
}

@test
fn eachThreadHasAValueOfItsOwn() {
    let local: ThreadLocal<Int[>..]> = ThreadLocal { [0] }
    local.withValue { $0.append(1) }
    let others = (0..<4).map { n in
        Thread.spawn {
            local.withValue { $0.append(n) }
            return local.value
        }
    }
    for n in 0..<4 {
        assertEqual(others[n].join(), [0, n])
    }
    assertEqual(local.value, [0, 1])
}

@test
fn aValueIsMadeWhenItIsFirstAskedFor() {
    let made = Atomic(0)
    let local = ThreadLocal { made.add(1) }
    expect(!local.isMade && made.load() == 0)
    assertEqual(local.value, 0)
    assertEqual(local.value, 0)
    expect(local.isMade)
    Thread.spawn {
        expect(!local.isMade)
        assertEqual(local.value, 1)
    }.join()
    assertEqual(made.load(), 2)
}

@test
fn aValueIsSetOnItsThreadAlone() {
    let local = ThreadLocal { "none" }
    local.value = "main"
    local.value += "!"
    assertEqual(Thread.spawn { local.value }.join(), "none")
    assertEqual(local.value, "main!")
}

@test
fn theValuesOfAThreadAreDestroyedAsItEndsTheLastMadeFirst() {
    let log: Mutex<String[>..]> = Mutex([])
    let first = ThreadLocal { Marked("first", log) }
    let second = ThreadLocal { Marked("second", log) }
    let third = ThreadLocal { Marked("third", log) }
    Thread.spawn {
        _ = second.value
        _ = third.value
        _ = first.value
    }.join()
    assertEqual(log.withLock { $0 }, ["first", "third", "second"])
}

@test
fn aValueGoesWithItsThreadLocal() {
    let log: Mutex<String[>..]> = Mutex([])
    if true {
        let local = ThreadLocal { Marked("only", log) }
        _ = local.value
    }
    assertEqual(log.withLock { $0 }, ["only"])
}

@test
fn aPlaceIsAnothersOnceItsThreadLocalIsGone() {
    let log: Mutex<String[>..]> = Mutex([])
    let ready = CountdownLatch(count: 1)
    let go = CountdownLatch(count: 1)
    var old: ThreadLocal<Marked>? = ThreadLocal { Marked("old", log) }
    let held = old!
    let box = Mutex<ThreadLocal<Marked>?>(held)
    let next = Mutex<ThreadLocal<Int>?>(none)
    let thread = Thread.spawn {
        _ = box.withLock { $0!.value }
        box.withLock { $0 = none }
        ready.countDown()
        go.wait()
        // Where the old one's value yet is, on this thread.
        let local = next.withLock { $0! }
        local.value += 1
        return local.value
    }
    ready.wait()
    old = none
    next.withLock { $0 = ThreadLocal { 40 } }
    go.countDown()
    assertEqual(thread.join(), 41)
    assertEqual(log.withLock { $0 }, ["old"])
}

@test
fn whatTheClosureLeavesIsKeptWhenItThrows() {
    let local = ThreadLocal { 1 }
    assert(thrown {
        try local.withValue { (n: inout Int) throws -> Void in
        n = 7
        throw Failed()
    }
    } is Failed)
    assertEqual(local.value, 7)
}

@test
fn aDeinitMayUseAnother() {
    let log: Mutex<String[>..]> = Mutex([])
    let counter = ThreadLocal { 0 }
    let noted = ThreadLocal { Noting(counter, log) }
    Thread.spawn {
        _ = noted.value
        counter.value = 5
    }.join()
    // The counter, made last, was destroyed first: it is made again, and
    // destroyed after.
    assertEqual(log.withLock { $0 }, ["1"])
    Thread.spawn {
        counter.value = 5
        _ = noted.value
    }.join()
    assertEqual(log.withLock { $0 }, ["1", "6"])
}

final class Noting {
    let counter: ThreadLocal<Int>
    let log: Mutex<String[>..]>

    init(_ counter: ThreadLocal<Int>, _ log: Mutex<String[>..]>) {
        self.counter = counter
        self.log = log
    }

    deinit {
        counter.value += 1
        let count = counter.value
        log.withLock { $0.append("\(count)") }
    }
}

@test
fn aMakerMayAskForItsOwn() {
    let cell = OnceCell<ThreadLocal<Int>>()
    let asked = Atomic(0)
    let local = ThreadLocal { () -> Int in
        if asked.add(1) == 0 {
            return cell.get()!.value + 100
        }
        return 1
    }
    _ = cell.getOrInit { local }
    // The inner one was made first, and is the thread's.
    assertEqual(local.value, 1)
}

@test
async fn aWorkersValuesAreThere() {
    let local = ThreadLocal { 0 }
    let total = await withTaskGroup(of: Int.self) { group in
        for _ in 0..<200 {
            group.spawn { local.withValue {
                $0 += 1;
                return $0
            } }
        }
        var greatest = 0
        for await count in group {
            greatest = greatest > count ? greatest : count
        }
        return greatest
    }
    // However many workers ran them.
    expect(total >= 1 && total <= 200)
}

// What the body throws; an error of no other, if it throws nothing.
struct Nothing: Error { }

fn thrown(_ body: () throws -> Void) -> any Error {
    do {
        try body()
        return Nothing()
    } catch {
        return error
    }
}

// A thread C made destroys its values as it ends, too.
#if !os(windows)
@extern("c", "pthread_create")
unsafe fn threadCreate(_ thread: RawPtr<UInt>, _ attributes: RawPtr<Opaque>, _ start: CFunction<(RawPtr<Opaque>) -> RawPtr<Opaque>>, _ context: RawPtr<Opaque>) -> CInt

@extern("c", "pthread_join")
unsafe fn threadJoin(_ thread: UInt, _ result: RawPtr<RawPtr<Opaque>>) -> CInt

@test
fn aThreadOfCsDestroysItsValues() {
    let log: Mutex<String[>..]> = Mutex([])
    let local = ThreadLocal { Marked("c", log) }
    let ids: Mutex<Int[>..]> = Mutex([])
    let callback = CCallback { (context: RawPtr<Opaque>) -> RawPtr<Opaque> in
        _ = local.value
        let id = Thread.current.id
        ids.withLock { $0.append(id) }
        return context
    }
    for _ in 0..<3 {
        var thread: UInt = 0
        let made = Memory.withPointer(to: &thread) { (place: RawPtr<UInt>) -> CInt in
            unsafe {
                return threadCreate(place, RawPtr<Opaque>.null, callback.function, callback.context)
            }
        }
        assertEqual(made, 0)
        unsafe {
            _ = threadJoin(thread, RawPtr<RawPtr<Opaque>>.null)
        }
    }
    assertEqual(log.withLock { $0 }, ["c", "c", "c"])
    let seen = ids.withLock { $0 }
    expect(seen[0] != seen[1] && seen[1] != seen[2] && seen[0] != seen[2])
}
#endif
