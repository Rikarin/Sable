module SocketAddressTests

// SocketAddress, and Host as an address (Sable.Net): run with
//     tools/stdlib-coverage.sh Sable.Net

import NetSupport
import Sable.Net
import Sable.Testing

@test(arguments: ["127.0.0.1:0", "192.0.2.1:65535", "[::1]:80", "[2001:db8::1]:443", "[::ffff:192.0.2.1]:8080", "[fe80::1%4]:1"])
fn anAddressAndPortAreReadAndWritten(_ text: String) throws {
    expect(try SocketAddress.parse(text).toString() == text)
}

@test(arguments: ["", "127.0.0.1", "127.0.0.1:", "127.0.0.1:65536", "127.0.0.1:-1", "127.0.0.1:+1", "127.0.0.1:80 ", "127.1:80", "::1:80", "[::1]", "[::1]80", "[::1]:",
    "[::1", "[127.0.0.1]:80", "localhost:80", ":80", "[]:80", "127.0.0.1:99999999999999999999"])
fn textThatIsNoAddressAndPortIsRefused(_ text: String) {
    expectThrows { _ = try SocketAddress.parse(text) }
}

@test
fn socketAddressesAreOrderedAndHashed() {
    let a = SocketAddress(.v4Loopback, port: 80)
    let b = SocketAddress(.v4Loopback, port: 81)
    let c = SocketAddress(.v6Loopback, port: 1)
    expect(a < b && b < c && !(c < a) && a != b)
    var seen: [SocketAddress: Int] = [:]
    seen[a] = 1
    seen[try! SocketAddress.parse("127.0.0.1:80")] = 2
    assertEqual(seen.count, 1)
    assertEqual(c.debugDescription(), "[::1]:1")
    assertEqual("\(a:>14)", "  127.0.0.1:80")
}

@test(arguments: [("http://127.1:80/", "127.0.0.1"), ("http://[2001:db8::1]/", "2001:db8::1"), ("http://[::ffff:7f00:1]/", "::ffff:127.0.0.1")])
fn aUrlsHostIsAnAddress(_ url: String, _ address: String) throws {
    expect(try Url.parse(url).host?.ipAddress == ip(address))
}

@test
fn aUrlsMappedLoopbackHostIsLoopback() throws {
    let host = require(try Url.parse("http://[::ffff:7f00:1]/").host)
    expect(require(host.ipAddress).isLoopback)
}

@test
fn aUrlsHostThatIsANameIsNoAddress() throws {
    let host = require(try Url.parse("http://example.com/").host)
    expect(host.ipAddress == none)
}

@test(arguments: ["192.0.2.1", "2001:db8::1", "::", "::ffff:1.2.3.4"])
fn anAddressIsAHostAndBack(_ text: String) {
    expect(Host.address(ip(text)).ipAddress == ip(text))
}

@test
fn aHostHasNoScope() {
    expect(Host.address(ip("fe80::1%2")).description() == "[fe80::1]")
}
