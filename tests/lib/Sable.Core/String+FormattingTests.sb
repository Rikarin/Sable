module StringFormattingTests

// String's, Char's and Bool's Formattable conformances: text padded to a
// width, a string cut to a precision, and '?' for the literal form. Run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing
import CoreTestSupport

@test
fn aStringWithNoSpecIsItself() {
    assertEqual("sable".format(FormatSpec()), "sable")
    assertEqual("".format(FormatSpec()), "")
}

@test
fn aStringIsPaddedOnTheRight() {
    assertEqual("[\("ab":5)]", "[ab   ]")
    assertEqual("[\("ab":>5)]", "[   ab]")
    assertEqual("[\("ab":*^6)]", "[**ab**]")
    assertEqual("[\("abcdef":3)]", "[abcdef]")
}

@test
fn aPrecisionKeepsThatManyScalars() {
    assertEqual("\("sable":.3)", "sab")
    assertEqual("\("sable":.0)", "")
    assertEqual("\("ab":.5)", "ab")
    assertEqual("\("é😀x":.2)", "é😀")
    assertEqual("[\("sable":*<6.3)]", "[sab***]")
}

@test
fn aStringsDebugIsItsLiteral() {
    assertEqual("\("q\"d":?)", "\"q\\\"d\"")
    assertEqual("[\("a":>5?)]", "[  \"a\"]")
    assertEqual("\("tab\there":?)", "\"tab\\there\"")
}

@test
fn aCharIsItselfOrItsLiteral() {
    assertEqual("\('c')", "c")
    assertEqual("[\('c':>3)]", "[  c]")
    assertEqual("[\('c':-<3)]", "[c--]")
    assertEqual("\('c':?)", "'c'")
    assertEqual('😀'.format(FormatSpec()), "😀")
}

@test
fn aBoolIsAWord() {
    assertEqual("\(true)", "true")
    assertEqual("[\(false:>7)]", "[  false]")
    assertEqual("[\(true:<6)]", "[true  ]")
    assertEqual(true.format(spec("?")), "true")
}

struct Plain {
    var name: String
}

@test
fn describingWritesAValueAsInterpolationDoes() {
    assertEqual(String.describing(42), "42")
    assertEqual(String.describing("text"), "text")
    assertEqual(String.describing([1, 2]), "[1, 2]")
    assertEqual(String.describing(Plain(name: "a")), "Plain(name: \"a\")")
}

@test
fn reflectingWritesAValueAsSourceWould() {
    assertEqual(String.reflecting("te\"xt"), "\"te\\\"xt\"")
    assertEqual(String.reflecting('c'), "'c'")
    assertEqual(String.reflecting(2.0), "2.0")
    assertEqual(String.reflecting(["a"]), "[\"a\"]")
}

@test
fn aFormattableValueWritesItselfIntoAWriter() {
    var text = "pi is "
    (3.14159).write(to: &text, spec: try! FormatSpec.parse(".2"))
    text.write(" and ")
    7.write(to: &text)
    assertEqual(text, "pi is 3.14 and 7")
}
