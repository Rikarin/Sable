module Corpus.Serialise

// Encoding and decoding, which is where protocols with associated types,
// typed errors and generic containers all meet.

public union CodecError {
    Truncated(at: Int)
    BadTag(found: U8)
    BadLength(found: Int)
    Unsupported(what: String)
}

public struct Writer {
    public var bytes: U8[>..]

    public mutating fn byte(_ value: U8) {
        bytes.append(value)
    }

    public mutating fn int(_ value: Int) {
        var remaining = value
        var count = 0
        while count < 8 {
            byte(0)
            remaining = remaining / 256
            count = count + 1
        }
    }

    public mutating fn text(_ value: String) {
        int(value.count)
        var i = 0
        while i < value.count {
            byte(0)
            i = i + 1
        }
    }

    public mutating fn tag(_ value: U8) {
        byte(value)
    }
}

public struct Reader {
    public var bytes: U8[>..]
    public var position: Int

    public fn remaining() -> Int {
        return bytes.count - position
    }

    public mutating fn byte() throws(CodecError) -> U8 {
        if remaining() <= 0 {
            throw CodecError.Truncated(at: position)
        }
        position = position + 1
        return bytes.removeLast()
    }

    public mutating fn int() throws(CodecError) -> Int {
        var total = 0
        var count = 0
        while count < 8 {
            let next = try byte()
            total = total * 256
            count = count + 1
        }
        return total
    }

    public mutating fn text() throws(CodecError) -> String {
        let length = try int()
        if length < 0 {
            throw CodecError.BadLength(found: length)
        }

        var result = ""
        var i = 0
        while i < length {
            let next = try byte()
            result = result.appending("x")
            i = i + 1
        }
        return result
    }
}

// ---- The protocol --------------------------------------------------------

public protocol Codable {
    fn encode(into writer: Writer) -> Writer
    static fn decode(from reader: Reader) throws(CodecError) -> Self
}

public struct Point: Codable {
    public var x: Int
    public var y: Int

    public fn encode(into writer: Writer) -> Writer {
        var buffer = writer
        buffer.int(x)
        buffer.int(y)
        return buffer
    }

    public static fn decode(from reader: Reader) throws(CodecError) -> Point {
        var input = reader
        let x = try input.int()
        let y = try input.int()
        return Point { x: x, y: y }
    }
}

public struct Label: Codable {
    public var text: String

    public fn encode(into writer: Writer) -> Writer {
        var buffer = writer
        buffer.text(text)
        return buffer
    }

    public static fn decode(from reader: Reader) throws(CodecError) -> Label {
        var input = reader
        return Label { text: try input.text() }
    }
}

public struct Tagged<Value: Codable>: Codable {
    public var tag: U8
    public var value: Value

    public fn encode(into writer: Writer) -> Writer {
        var buffer = writer
        buffer.tag(tag)
        return value.encode(into: buffer)
    }

    public static fn decode(from reader: Reader) throws(CodecError) -> Tagged<Value> {
        var input = reader
        let tag = try input.byte()
        let value = try Value.decode(from: input)
        return Tagged { tag: tag, value: value }
    }
}

// ---- Using it ------------------------------------------------------------

public fn encodeAll<T: Codable>(_ values: T[>..]) -> U8[>..] {
    var writer = Writer { bytes: [] }
    writer.int(values.count)

    for value in values {
        writer = value.encode(into: writer)
    }

    return writer.bytes
}

public fn decodeOne<T: Codable>(_ bytes: U8[>..]) -> T? {
    let reader = Reader { bytes: bytes, position: 0 }
    return try? T.decode(from: reader)
}

public fn roundTrip(_ p: Point) -> Point? {
    let bytes = encodeAll([p])
    return decodeOne(bytes)
}

public fn describeError(_ e: CodecError) -> String {
    return match e {
        case .Truncated(let at)     => "truncated at " + at.toString()
        case .BadTag(let found)     => "bad tag"
        case .BadLength(let found)  => "bad length " + found.toString()
        case .Unsupported(let what) => "unsupported " + what
    }
}

public fn decodeOrDefault(_ bytes: U8[>..], _ fallback: Point) -> Point {
    let reader = Reader { bytes: bytes, position: 0 }
    return try Point.decode(from: reader) catch { fallback }
}

public fn encodeTagged(_ p: Point) -> U8[>..] {
    let tagged = Tagged { tag: 1, value: p }
    var writer = Writer { bytes: [] }
    return tagged.encode(into: writer).bytes
}
