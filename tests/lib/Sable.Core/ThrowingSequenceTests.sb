module ThrowingSequenceTests

// Sequence's algorithms and lazy views over a sequence that throws as it is
// gone through (SYNTAX.md §18, "Throwing iteration"): each rethrows its
// Failure, so what it gives over a generator that does not fail is what it
// gives over an array, and an error part-way is the call's. Run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

@derive(Equatable)
union Broken: Error { At(Int) }

/// 1, 2, ... up to n, failing in place of 'failAt' when it is reached.
fn numbers(upTo n: Int, failAt: Int = 0) throws(Broken) -> some Sequence<Int> {
    var i = 1
    while i <= n {
        if i == failAt {
            throw .At(i)
        }
        yield i
        i += 1
    }
}

@test
fn mapAndFilterGiveWhatTheyGiveOverAnArray() throws {
    expect(try numbers(upTo: 4).map { $0 * 10 } == [10, 20, 30, 40])
    expect(try numbers(upTo: 4).filter { $0 % 2 == 0 } == [2, 4])
    expect(try numbers(upTo: 4).compactMap { $0 > 2 ? $0 : none } == [3, 4])
    expect(try numbers(upTo: 2).flatMap { [$0, $0] } == [1, 1, 2, 2])
}

@test
fn anErrorPartWayIsTheCalls() {
    expectThrows(Broken.At(3)) { _ = try numbers(upTo: 5, failAt: 3).map { $0 } }
    expectThrows(Broken.At(2)) { _ = try numbers(upTo: 5, failAt: 2).filter { $0 > 0 } }
    expectThrows(Broken.At(4)) { _ = try numbers(upTo: 5, failAt: 4).reduce(0) { $0 + $1 } }
    expectThrows(Broken.At(1)) { _ = try numbers(upTo: 5, failAt: 1).count(where: { $0 > 0 }) }
    expectThrows(Broken.At(5)) { _ = try numbers(upTo: 5, failAt: 5).sorted() }
    expectThrows(Broken.At(2)) { _ = try numbers(upTo: 5, failAt: 2).toArray() }
}

@test
fn anAlgorithmThatStopsEarlyNeverReachesTheError() throws {
    assertEqual(try numbers(upTo: 9, failAt: 5).first(where: { $0 == 2 }), 2)
    expect(try numbers(upTo: 9, failAt: 5).contains(where: { $0 == 3 }))
    expect(!(try numbers(upTo: 9, failAt: 5).allSatisfy { $0 > 1 }))
    expect(try numbers(upTo: 9, failAt: 5).prefix(3) == [1, 2, 3])
    expect(try numbers(upTo: 9, failAt: 5).prefix(while: { $0 < 3 }) == [1, 2])
}

@test
fn reductionsAndOrderingRethrow() throws {
    assertEqual(try numbers(upTo: 4).reduce(0) { $0 + $1 }, 10)
    assertEqual(try numbers(upTo: 4).sum(), 10)
    assertEqual(try numbers(upTo: 4).product(), 24)
    assertEqual(try numbers(upTo: 4).max(), 4)
    assertEqual(try numbers(upTo: 4).min(by: { $0 > $1 }), 4)
    expect(try numbers(upTo: 3).sorted(by: { $0 > $1 }) == [3, 2, 1])
    expect(try numbers(upTo: 5).dropFirst(3) == [4, 5])
    expect(try numbers(upTo: 5).suffix(2) == [4, 5])
    assertEqual(try numbers(upTo: 5).chunks(of: 2).count, 3)
    expect(try numbers(upTo: 3).elementsEqual([1, 2, 3]))
    expect(try numbers(upTo: 3).starts(with: [1, 2]))
    expect(try numbers(upTo: 3).contains(2))
}

@test
fn collectingThrowsWhatGoingThroughThrows() throws {
    let all: Int[>..] = try numbers(upTo: 3).collect()
    expect(all == [1, 2, 3])
    let made: Int[>..] = try numbers(upTo: 2).collect()
    expect(made == [1, 2])
    expectThrows(Broken.At(3)) {
        let _: Int[>..] = try numbers(upTo: 3, failAt: 3).collect()
    }
    var grown: Int[>..] = [0]
    try grown.append(contentsOf: numbers(upTo: 2))
    expect(grown == [0, 1, 2])
}

@test
fn aConformersInitialiserThrowsWhatGoingThroughThrows() throws {
    expect(try Int[>..](numbers(upTo: 3)) == [1, 2, 3])
    expect(try Int[>..<](numbers(upTo: 2)) == [1, 2])
    expectThrows(Broken.At(2)) { _ = try Int[>..](numbers(upTo: 3, failAt: 2)).count }
    expectThrows(Broken.At(1)) { _ = try Int[>..<](numbers(upTo: 3, failAt: 1)).count }
    let digits = try String(numbers(upTo: 3).map { Char.fromDigit($0)! })
    assertEqual(digits, "123")
    expectThrows(Broken.At(3)) { _ = try String(numbers(upTo: 3, failAt: 3).map { Char.fromDigit($0)! }).count }
    let squares = try [Int: Int](numbers(upTo: 3).map { ($0, $0 * $0) })
    assertEqual(squares[3], 9)
    expectThrows(Broken.At(2)) { _ = try [Int: Int](numbers(upTo: 3, failAt: 2).map { ($0, $0) }).count }
}

@test
fn lazyViewsThrowTheirBasesFailure() throws {
    var seen: Int[>..] = []
    for try n in numbers(upTo: 5).lazy.map({ $0 * 2 }).filter({ $0 > 2 }) {
        seen.append(n)
    }
    expect(seen == [4, 6, 8, 10])
    expectThrows(Broken.At(3)) {
        for try _ in numbers(upTo: 5, failAt: 3).lazy.map({ $0 * 2 }) { }
    }
    var pairs = 0
    for try (offset, n) in numbers(upTo: 3).enumerated() {
        pairs += offset * n
    }
    assertEqual(pairs, 8)
    expectThrows(Broken.At(2)) {
        for try _ in zip(numbers(upTo: 5, failAt: 2), [1, 2, 3]) { }
    }
}

@test
fn whatCannotFailNeedsNoTry() {
    expect([1, 2, 3].map { $0 + 1 } == [2, 3, 4])
    assertEqual((1...4).reduce(0) { $0 + $1 }, 10)
    expect(stride(from: 0, to: 6, by: 2).lazy.map { $0 + 1 }.toArray() == [1, 3, 5])
}
