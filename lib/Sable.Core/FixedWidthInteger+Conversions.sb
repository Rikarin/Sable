module Sable.Core

// Conversions from any integer or float to any fixed-width integer, in the
// ways a value that does not fit can go (Swift's 'init(truncatingIfNeeded:)',
// 'init(exactly:)' and 'init(clamping:)'). An integer goes through its 128
// bits, 'wideBitPattern', which holds every built-in integer's value; a
// float through its F64, 'wideValue'. Monomorphised, each is the one
// instruction 'as' or 'unchecked as' is, with the checks it needs.

extension FixedWidthInteger {
    /// The value's low bits, as 'unchecked as' gives them: a value that does
    /// not fit wraps.
    ///
    /// ```sable
    /// assert(U8.truncating(300) == 44)
    /// assert(I8.truncating(255 as U8) == -1)
    /// ```
    public static fn truncating<Source: BinaryInteger>(_ source: Source) -> Self {
        return Self.fromWideBitPattern(source.wideBitPattern)
    }

    /// The value, or none where it does not fit the type.
    ///
    /// ```sable
    /// assert(U8.exactly(255) == 255)
    /// assert(U8.exactly(256) == none)
    /// assert(U8.exactly(-1) == none)
    /// ```
    public static fn exactly<Source: BinaryInteger>(_ source: Source) -> Self? {
        if !source.fitsWideBitPattern {
            return none
        }
        let bits = source.wideBitPattern
        let result = Self.fromWideBitPattern(bits)
        // It fits when nothing was cut off going down and coming back up,
        // and the sign is the same: U128's greatest value and I128's -1
        // have the same bits.
        if result.wideBitPattern != bits || (result < Self.zero) != (source < Source.zero) {
            return none
        }
        return result
    }

    /// The value, or the bound it is past where it does not fit.
    ///
    /// ```sable
    /// assert(U8.clamping(300) == 255)
    /// assert(U8.clamping(-5) == 0)
    /// assert(I8.clamping(100) == 100)
    /// ```
    public static fn clamping<Source: BinaryInteger>(_ source: Source) -> Self {
        if let exact = Self.exactly(source) {
            return exact
        }
        return source < Source.zero ? Self.min : Self.max
    }

    // ---- from floats -----------------------------------------------------
    // Through the float's F64, which holds every F16, F32 and F64 exactly.

    /// The integer the float is, or none where it has a fraction, is not
    /// finite, or does not fit the type.
    ///
    /// ```sable
    /// assert(I32.exactly(42.0) == 42)
    /// assert(I32.exactly(2.5) == none)
    /// assert(U8.exactly(256.0) == none)
    /// assert(Int.exactly(F64.nan) == none)
    /// ```
    public static fn exactly<Source: FloatingPoint>(_ value: Source) -> Self? {
        let wide = value.wideValue
        if !wide.isInteger {
            return none
        }
        // The bounds are powers of two, which an F64 holds exactly: the
        // least value, and one past the greatest.
        let width = Self.isSigned ? Self.bitWidth - 1 : Self.bitWidth
        let least = Self.isSigned ? -(1.0).scaled(byPowerOfTwo: width) : 0.0
        if wide < least || wide >= (1.0).scaled(byPowerOfTwo: width) {
            return none
        }
        return Self.fromWideValue(wide)
    }

    /// The float's integer part, toward zero, or the bound it is past;
    /// NaN gives 0. As 'unchecked as' converts, and Rust's 'as'.
    ///
    /// ```sable
    /// assert(I8.clamping(-2.9) == -2)
    /// assert(U8.clamping(300.0) == 255)
    /// assert(Int.clamping(F64.nan) == 0)
    /// ```
    public static fn clamping<Source: FloatingPoint>(_ value: Source) -> Self {
        return Self.fromWideValue(value.wideValue)
    }
}
