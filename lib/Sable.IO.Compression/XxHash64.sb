module Sable.IO.Compression

/// XXH64 of bytes as they come, with a seed of zero: zstd's checksum is its low
/// half.
struct XxHash64 {
    /// Four lanes, and thirty-two bytes that do not fill a stripe.
    var a: U64 = 0x60EA_27EE_ADC0_B5D6
    var b: U64 = 0xC2B2_AE3D_27D4_EB4F
    var c: U64 = 0
    var d: U64 = 0x61C8_864E_7A14_3579
    let held: Block = Block(count: 40)
    var heldCount: Int = 0
    var length: U64 = 0

    static var prime1: U64 => 0x9E37_79B1_85EB_CA87

    static var prime2: U64 => 0xC2B2_AE3D_27D4_EB4F

    static var prime3: U64 => 0x1656_67B1_9E37_79F9

    static var prime4: U64 => 0x85EB_CA77_C2B2_AE63

    static var prime5: U64 => 0x27D4_EB2F_1656_67C5

    @inline(always)
    static fn round(_ lane: U64, _ word: U64) -> U64 {
        return (lane &+ word &* prime2).rotatedLeft(by: 31) &* prime1
    }

    unsafe mutating fn update(at address: Int, count: Int) {
        length = length &+ (count unchecked as U64)
        var at = address
        let end = address &+ count
        if heldCount > 0 {
            let taken = 32 &- heldCount < count ? 32 &- heldCount : count
            copyBytes(from: at, to: held.address &+ heldCount, taken)
            heldCount = heldCount &+ taken
            at = at &+ taken
            if heldCount < 32 {
                return
            }
            self.stripes(held.address, held.address &+ 32)
            heldCount = 0
        }
        let whole = at &+ ((end &- at) & ~31)
        self.stripes(at, whole)
        if whole < end {
            copyBytes(from: whole, to: held.address, end &- whole)
            heldCount = end &- whole
        }
    }

    unsafe mutating fn stripes(_ address: Int, _ end: Int) {
        var a = self.a
        var b = self.b
        var c = self.c
        var d = self.d
        var at = address
        while at < end {
            a = XxHash64.round(a, load64(at))
            b = XxHash64.round(b, load64(at &+ 8))
            c = XxHash64.round(c, load64(at &+ 16))
            d = XxHash64.round(d, load64(at &+ 24))
            at = at &+ 32
        }
        self.a = a
        self.b = b
        self.c = c
        self.d = d
    }

    var value: U64 {
        get {
            var hash = XxHash64.prime5
            if length >= 32 {
                hash = a.rotatedLeft(by: 1) &+ b.rotatedLeft(by: 7) &+ c.rotatedLeft(by: 12) &+ d.rotatedLeft(by: 18)
                for lane in [a, b, c, d] {
                    hash = (hash ^ XxHash64.round(0, lane)) &* XxHash64.prime1 &+ XxHash64.prime4
                }
            }
            hash = hash &+ length
            unsafe {
                var at = held.address
                let end = at &+ heldCount
                while at &+ 8 <= end {
                    hash = (hash ^ XxHash64.round(0, load64(at))).rotatedLeft(by: 27) &* XxHash64.prime1 &+ XxHash64.prime4
                    at = at &+ 8
                }
                if at &+ 4 <= end {
                    hash = (hash ^ (load32(at) unchecked as U64) &* XxHash64.prime1).rotatedLeft(by: 23) &* XxHash64.prime2 &+ XxHash64.prime3
                    at = at &+ 4
                }
                while at < end {
                    hash = (hash ^ (load8(at) unchecked as U64) &* XxHash64.prime5).rotatedLeft(by: 11) &* XxHash64.prime1
                    at = at &+ 1
                }
            }
            hash = (hash ^ (hash >> 33)) &* XxHash64.prime2
            hash = (hash ^ (hash >> 29)) &* XxHash64.prime3
            return hash ^ (hash >> 32)
        }
    }
}
