module Sable.Crypto

/// SHA-256's compression function, portably.
struct Sha256Blocks: BlockHash {
    static var blockBytes: Int => 64

    static var stateBytes: Int => 32

    static var lengthBytes: Int => 8

    static var bigEndianLength: Bool => true

    static var kernel: Int => Native.sha256

    unsafe static fn compress(state: Int, block: Int) {
        // The message's schedule, in a window of sixteen words.
        let w = block + blockBytes
        let k = sha256Constants
        var i = 0
        while i < 16 {
            store32(load32(block + 4 * i).byteSwapped, w + 4 * i)
            i += 1
        }
        var a = load32(state)
        var b = load32(state + 4)
        var c = load32(state + 8)
        var d = load32(state + 12)
        var e = load32(state + 16)
        var f = load32(state + 20)
        var g = load32(state + 24)
        var h = load32(state + 28)
        var t = 0
        while t < 64 {
            if t >= 16 {
                // Sixteen words on, all at once.
                i = 0
                while i < 16 {
                    let w1 = load32(w + 4 * ((i + 1) & 15))
                    let w14 = load32(w + 4 * ((i + 14) & 15))
                    let s0 = w1.rotatedRight(by: 7) ^ w1.rotatedRight(by: 18) ^ (w1 >> 3)
                    let s1 = w14.rotatedRight(by: 17) ^ w14.rotatedRight(by: 19) ^ (w14 >> 10)
                    store32(load32(w + 4 * i) &+ s0 &+ load32(w + 4 * ((i + 9) & 15)) &+ s1, w + 4 * i)
                    i += 1
                }
            }
            // Sixteen rounds, eight written out so that no word moves.
            i = 0
            while i < 16 {
                h = h &+ (e.rotatedRight(by: 6) ^ e.rotatedRight(by: 11) ^ e.rotatedRight(by: 25)) &+ (g ^ (e & (f ^ g))) &+ load32(k + 4 * (t + i)) &+ load32(w + 4 * (i))
                d = d &+ h
                h = h &+ (a.rotatedRight(by: 2) ^ a.rotatedRight(by: 13) ^ a.rotatedRight(by: 22)) &+ ((a & b) | (c & (a | b)))
                g = g &+ (d.rotatedRight(by: 6) ^ d.rotatedRight(by: 11) ^ d.rotatedRight(by: 25)) &+ (f ^ (d & (e ^ f))) &+ load32(k + 4 * (t + i + 1)) &+ load32(w + 4 * (i + 1))
                c = c &+ g
                g = g &+ (h.rotatedRight(by: 2) ^ h.rotatedRight(by: 13) ^ h.rotatedRight(by: 22)) &+ ((h & a) | (b & (h | a)))
                f = f &+ (c.rotatedRight(by: 6) ^ c.rotatedRight(by: 11) ^ c.rotatedRight(by: 25)) &+ (e ^ (c & (d ^ e))) &+ load32(k + 4 * (t + i + 2)) &+ load32(w + 4 * (i + 2))
                b = b &+ f
                f = f &+ (g.rotatedRight(by: 2) ^ g.rotatedRight(by: 13) ^ g.rotatedRight(by: 22)) &+ ((g & h) | (a & (g | h)))
                e = e &+ (b.rotatedRight(by: 6) ^ b.rotatedRight(by: 11) ^ b.rotatedRight(by: 25)) &+ (d ^ (b & (c ^ d))) &+ load32(k + 4 * (t + i + 3)) &+ load32(w + 4 * (i + 3))
                a = a &+ e
                e = e &+ (f.rotatedRight(by: 2) ^ f.rotatedRight(by: 13) ^ f.rotatedRight(by: 22)) &+ ((f & g) | (h & (f | g)))
                d = d &+ (a.rotatedRight(by: 6) ^ a.rotatedRight(by: 11) ^ a.rotatedRight(by: 25)) &+ (c ^ (a & (b ^ c))) &+ load32(k + 4 * (t + i + 4)) &+ load32(w + 4 * (i + 4))
                h = h &+ d
                d = d &+ (e.rotatedRight(by: 2) ^ e.rotatedRight(by: 13) ^ e.rotatedRight(by: 22)) &+ ((e & f) | (g & (e | f)))
                c = c &+ (h.rotatedRight(by: 6) ^ h.rotatedRight(by: 11) ^ h.rotatedRight(by: 25)) &+ (b ^ (h & (a ^ b))) &+ load32(k + 4 * (t + i + 5)) &+ load32(w + 4 * (i + 5))
                g = g &+ c
                c = c &+ (d.rotatedRight(by: 2) ^ d.rotatedRight(by: 13) ^ d.rotatedRight(by: 22)) &+ ((d & e) | (f & (d | e)))
                b = b &+ (g.rotatedRight(by: 6) ^ g.rotatedRight(by: 11) ^ g.rotatedRight(by: 25)) &+ (a ^ (g & (h ^ a))) &+ load32(k + 4 * (t + i + 6)) &+ load32(w + 4 * (i + 6))
                f = f &+ b
                b = b &+ (c.rotatedRight(by: 2) ^ c.rotatedRight(by: 13) ^ c.rotatedRight(by: 22)) &+ ((c & d) | (e & (c | d)))
                a = a &+ (f.rotatedRight(by: 6) ^ f.rotatedRight(by: 11) ^ f.rotatedRight(by: 25)) &+ (h ^ (f & (g ^ h))) &+ load32(k + 4 * (t + i + 7)) &+ load32(w + 4 * (i + 7))
                e = e &+ a
                a = a &+ (b.rotatedRight(by: 2) ^ b.rotatedRight(by: 13) ^ b.rotatedRight(by: 22)) &+ ((b & c) | (d & (b | c)))
                i += 8
            }
            t += 16
        }
        store32(load32(state) &+ a, state)
        store32(load32(state + 4) &+ b, state + 4)
        store32(load32(state + 8) &+ c, state + 8)
        store32(load32(state + 12) &+ d, state + 12)
        store32(load32(state + 16) &+ e, state + 16)
        store32(load32(state + 20) &+ f, state + 20)
        store32(load32(state + 24) &+ g, state + 24)
        store32(load32(state + 28) &+ h, state + 28)
    }
}

/// The first bits of the fractional parts of the cube roots of the first primes.
let sha256Constants: Int = constantTable([
    0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5, 0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
    0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3, 0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
    0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC, 0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
    0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7, 0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
    0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13, 0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
    0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3, 0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
    0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5, 0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
    0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208, 0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2,
] as U32[>..])
