module Sable.Generators

// The compiler writes each request as lines of fields on standard input
// and reads the output as records on standard output. These are what the
// main it writes for a generator program calls; a generator never does.

/// One run: a declaration for a declaration generator, or a package for a
/// package generator.
public struct GeneratorRequest {
    public var generator: String
    public var index: String
    /// "d" for a declaration generator's run, "p" for a package generator's.
    public var kind: String
    public var pkg: Package
    /// The declaration, for a declaration generator's run.
    public var declaration: Declaration
}

/// The next request, or none at the end of the input.
public fn readGeneratorRequest() -> GeneratorRequest? {
    var reader = RequestReader()
    while let line = Runtime.readLine() {
        if reader.read(line.split(separator: '\u{1f}')) {
            return reader.request()
        }
    }
    return none
}

// A request as it is read: a type, a field, a case, a parameter or an
// attribute is kept here until it is whole, then added where it belongs.
struct RequestReader {
    var generator: String = ""
    var index: String = ""
    var kind: String = "d"
    var pkg: Package = Package { name: "" }
    var declaration: Declaration = RequestReader.empty()
    var types: TypeRef[>..] = []
    var type: TypeRef = TypeRef { kind: "", name: "", moduleName: "", text: "" }
    var hasType: Bool = false
    var field: Field = Field { name: "", type: "", isMutable: false, hasDefault: false, isPublic: false }
    var hasField: Bool = false
    var kase: Case = Case { name: "" }
    var hasCase: Bool = false
    var parameter: Parameter = Parameter { label: "", name: "", type: "", hasDefault: false }
    var hasParameter: Bool = false
    var member: Member = Member { keyword: "", name: "" }
    var hasMember: Bool = false
    var attribute: Attribute = Attribute { name: "", arguments: [] }
    var hasAttribute: Bool = false
    // Where the attribute goes: "d" the declaration, "f" the field, "c" the
    // case, "q" the parameter, "m" the member.
    var target: String = "d"

    init() { }

    static fn empty() -> Declaration {
        return Declaration { keyword: "", name: "", moduleName: "", isPublic: false }
    }

    // Whether the line ends the request.
    mutating fn read(_ fields: String[>..]) -> Bool {
        let tag = fields[0]
        if tag != "YC" && tag != "YA" && tag != "YG" {
            finishType()
        }
        if tag == "R" {
            generator = fields[1]
            index = fields[2]
            kind = fields[3]
            pkg.name = fields[4]
        } else if tag == "N" {
            pkg.inputs.append(InputFile { path: restored(fields[1]), text: restored(fields[2]) })
        } else if tag == "Y" {
            type = TypeRef { kind: fields[2], name: fields[3], moduleName: fields[4], text: restored(fields[5]) }
            type.qualifiedName = fields[6]
            type.suffix = fields[7]
            type.isPublic = fields[8] == "1"
            type.isFinal = fields[9] == "1"
            hasType = true
        } else if tag == "YC" {
            type.conformances.append(fields[1])
        } else if tag == "YA" {
            type.attributes.append(fields[1])
        } else if tag == "YG" {
            type.arguments.append(types[fields[1].toInt() ?? 0])
        } else if tag == "D" {
            declaration.keyword = fields[1]
            declaration.name = fields[2]
            declaration.container = fields[3]
            declaration.moduleName = fields[4]
            declaration.isPublic = fields[5] == "1"
            declaration.isStatic = fields[6] == "1"
            declaration.file = restored(fields[7])
            declaration.location = Location { id: fields[8] }
            declaration.packageName = fields[9]
        } else if tag == "DT" {
            declaration.type = resolvedType(fields[1])
        } else if tag == "DS" {
            declaration.supertypes.append(resolvedType(fields[1]))
        } else if tag == "DF" {
            declaration.isFinal = fields[1] == "1"
        } else if tag == "TC" {
            declaration.constraints.append(Constraint { parameter: fields[1], type: resolvedType(fields[2]) })
        } else if tag == "M" {
            finishMember()
            member = Member { keyword: fields[1], name: fields[2], location: Location { id: fields[8] } }
            member.isPublic = fields[3] == "1"
            member.isStatic = fields[4] == "1"
            member.isAsync = fields[5] == "1"
            member.isThrowing = fields[6] == "1"
            if fields[7] != "-1" {
                member.returned = resolvedType(fields[7])
            }
            // A protocol's requirement says more.
            if fields.count > 12 {
                member.isMutating = fields[9] == "1"
                if fields[10] != "-1" {
                    member.thrown = resolvedType(fields[10])
                }
                member.isSettable = fields[11] == "1"
                member.declaredIn = fields[12]
            }
            hasMember = true
        } else if tag == "MT" {
            member.typeParameters.append(fields[1])
        } else if tag == "ME" {
            finishMember()
            if member.keyword == "init" && declaration.keyword != "protocol" {
                declaration.initializers.append(member)
            } else if member.keyword == "var" || member.keyword == "associatedtype" {
                declaration.properties.append(member)
            } else {
                declaration.methods.append(member)
            }
            hasMember = false
        } else if tag == "V" {
            declaration.isAsync = fields[1] == "1"
            declaration.isThrowing = fields[2] == "1"
            declaration.returnType = restored(fields[3])
            if fields[4] != "-1" {
                declaration.returned = resolvedType(fields[4])
            }
        } else if tag == "S" {
            declaration.superclass = fields[1]
        } else if tag == "I" {
            declaration.imports.append(restored(fields[1]))
        } else if tag == "T" {
            declaration.typeParameters.append(fields[1])
        } else if tag == "C" {
            declaration.conformances.append(restored(fields[1]))
        } else if tag == "X" {
            declaration.allConformances.append(fields[1])
        } else if tag == "A" {
            finishAttribute()
            target = fields[1]
            attribute = Attribute { name: fields[2], arguments: [] }
            hasAttribute = true
        } else if tag == "G" {
            var string: String? = none
            if fields[3] == "1" {
                string = restored(fields[4])
            }
            attribute.arguments.append(Argument { label: fields[1], text: restored(fields[2]), string: string })
        } else if tag == "F" {
            finishMember()
            field = Field {
                name: fields[1],
                type: restored(fields[2]),
                resolved: resolvedType(fields[7]),
                isMutable: fields[3] == "1",
                hasDefault: fields[4] == "1",
                isPublic: fields[5] == "1",
                location: Location { id: fields[6] }
            }
            hasField = true
        } else if tag == "K" {
            finishMember()
            var rawValue: String? = none
            if fields[2] == "1" {
                rawValue = restored(fields[3])
            }
            kase = Case { name: fields[1], rawValue: rawValue, location: Location { id: fields[4] } }
            hasCase = true
        } else if tag == "P" {
            kase.payload.append(Field {
                name: fields[1],
                type: restored(fields[2]),
                resolved: resolvedType(fields[3]),
                isMutable: false,
                hasDefault: false,
                isPublic: false
            })
        } else if tag == "Q" {
            finishMember()
            parameter = Parameter {
                label: fields[1],
                name: fields[2],
                type: restored(fields[3]),
                resolved: resolvedType(fields[6]),
                hasDefault: fields[4] == "1",
                defaultText: restored(fields[7]),
                location: Location { id: fields[5] }
            }
            if fields.count > 11 {
                parameter.modifier = fields[8]
                parameter.isVariadic = fields[9] == "1"
                parameter.isAutoclosure = fields[10] == "1"
                parameter.isEscaping = fields[11] == "1"
            }
            hasParameter = true
        } else if tag == "E" {
            finishMember()
            pkg.declarations.append(declaration)
            declaration = RequestReader.empty()
            types = []
        } else if tag == "Z" {
            return true
        }
        return false
    }

    fn resolvedType(_ id: String) -> TypeRef {
        if let i = id.toInt() {
            if i >= 0 && i < types.count {
                return types[i]
            }
        }
        return TypeRef { kind: "unresolved", name: "", moduleName: "", text: "" }
    }

    mutating fn finishType() {
        if hasType {
            types.append(type)
            hasType = false
        }
    }

    mutating fn finishAttribute() {
        if !hasAttribute {
            return
        }
        if target == "f" {
            field.attributes.append(attribute)
        } else if target == "c" {
            kase.attributes.append(attribute)
        } else if target == "q" {
            parameter.attributes.append(attribute)
        } else if target == "m" {
            member.attributes.append(attribute)
        } else {
            declaration.attributes.append(attribute)
            if attribute.name == generator {
                declaration.trigger = attribute
            }
        }
        hasAttribute = false
    }

    mutating fn finishMember() {
        finishAttribute()
        if hasField {
            declaration.fields.append(field)
            hasField = false
        }
        if hasCase {
            declaration.cases.append(kase)
            hasCase = false
        }
        if hasParameter {
            if hasMember {
                member.parameters.append(parameter)
            } else {
                declaration.parameters.append(parameter)
            }
            hasParameter = false
        }
    }

    fn request() -> GeneratorRequest {
        var first = RequestReader.empty()
        if !pkg.declarations.isEmpty {
            first = pkg.declarations[0]
        }
        return GeneratorRequest { generator: generator, index: index, kind: kind, pkg: pkg, declaration: first }
    }
}

/// Writes what a run produced, for the request with the index.
public fn writeGeneratorOutput(_ output: Output, for index: String) {
    print("\u{1e}run\u{1f}\(index)")
    for message in output.messages {
        print("\u{1e}\(flattened(message))")
    }
    var i = 0
    while i < output.names.count {
        print("\u{1e}file\u{1f}\(flattened(output.names[i]))\u{1f}\(flattened(output.modules[i]))")
        print(output.texts[i])
        i = i + 1
    }
}

// A value with a line break in it comes with each break as U+001D.
fn restored(_ text: String) -> String {
    if !text.contains('\u{1d}') {
        return text
    }
    return Runtime.joinStrings(text.split(separator: '\u{1d}'), "\n")
}

// A message or a file name is one line of the output.
fn flattened(_ text: String) -> String {
    if !text.contains('\n') {
        return text
    }
    return Runtime.joinStrings(text.split(separator: '\n'), " ")
}
