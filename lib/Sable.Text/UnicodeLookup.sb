module Sable.Text

// Reading the tables of UnicodeTextTables.sb, which tools/unicode-tables.py
// generates and describes: values for every code point in two stages, their
// digits of base 64, '0' for 0 to 'o' for 63, the lowest first.

/// The value of a staged table whose blocks are of 2^shift records, of at
/// most five digits: 0 past its 'limit' blocks. A record's digits are in the
/// eight bytes from where it starts, so it is read at once.
@inline(always)
fn textStaged(_ index: String, _ blocks: String, shift: Int, limit: Int, width: Int, _ code: Int) -> U64 {
    let block = code >> shift
    if block >= limit {
        return 0
    }
    let names = index.utf8
    let at = block * 2 + (block >> 6)
    let line = Int(names[at]) + Int(names[at + 1]) * 64 - 48 * 65
    let start = line * ((width << shift) + 1) + (code & ((1 << shift) - 1)) * width
    if width == 1 {
        return U64(blocks.utf8[start]) &- 48
    }
    return textNumber(blocks, start, width)
}

/// The number the two to five digits from byte 'at' of the table write.
@inline(always)
fn textNumber(_ table: String, _ at: Int, _ width: Int) -> U64 {
    // A digit's byte less '0' is its six bits: those bits of each byte, put
    // side by side. (Past the digits a subtraction borrows upwards only.)
    let digits = table.utf8.readU64(at: at, endian: .Little) &- 0x3030_3030_3030_3030
    var value = digits & 0x3F | digits >> 2 & 0xFC0
    if width > 2 {
        value |= digits >> 4 & 0x3_F000
    }
    if width > 3 {
        value |= digits >> 6 & 0xFC_0000
    }
    if width > 4 {
        value |= digits >> 8 & 0x3F00_0000
    }
    return value
}

/// Grapheme_Cluster_Break, Extended_Pictographic and Indic_Conjunct_Break,
/// as graphemeBreakIndex's values put them together.
fn graphemeBreakOf(_ code: Int) -> Int {
    return Int(textStaged(graphemeBreakIndex, graphemeBreakBlocks, shift: graphemeBreakShift, limit: graphemeBreakLimit, width: 2, code))
}

/// Word_Break, and 32 more for Extended_Pictographic.
fn wordBreakOf(_ code: Int) -> Int {
    return Int(textStaged(wordBreakIndex, wordBreakBlocks, shift: wordBreakShift, limit: wordBreakLimit, width: 1, code))
}

fn sentenceBreakOf(_ code: Int) -> Int {
    return Int(textStaged(sentenceBreakIndex, sentenceBreakBlocks, shift: sentenceBreakShift, limit: sentenceBreakLimit, width: 1, code))
}

/// Line_Break as LB1 resolves it, and 64 more for East_Asian_Width F, W or
/// H, and 128 more for an unassigned Extended_Pictographic code point.
fn lineBreakOf(_ code: Int) -> Int {
    return Int(textStaged(lineBreakIndex, lineBreakBlocks, shift: lineBreakShift, limit: lineBreakLimit, width: 2, code))
}

// What normalization knows of a code point, as the tables have it.

/// Its combining class, its canonical decomposition, and two bits.
@inline(always)
fn normalizationOf(_ code: Int) -> U64 {
    return textStaged(normalizationIndex, normalizationBlocks, shift: normalizationShift, limit: normalizationLimit, width: 5, code)
}

/// Its compatibility decomposition, where that is not its canonical one.
@inline(always)
fn compatibilityOf(_ code: Int) -> U64 {
    return textStaged(compatibilityIndex, compatibilityBlocks, shift: compatibilityShift, limit: compatibilityLimit, width: 4, code)
}

/// In normalizationOf's value: the code point is not itself in NFC.
const normalizationChanges: U64 = 0x100_0000

/// In normalizationOf's value: the code point may compose with what comes
/// before it, or be reordered with it.
const normalizationJoins: U64 = 0x200_0000

/// In normalizationOf's value: how many scalars its decomposition has, if any.
const normalizationLength: U64 = 0xE0_0000

/// In compatibilityOf's value, as normalizationJoins.
const compatibilityJoins: U64 = 0x8_0000

/// Canonical_Combining_Class: 0 for a starter.
fn combiningClassOf(_ code: Int) -> Int {
    if code < 0x300 {
        return 0
    }
    return Int(normalizationOf(code) & 0xFF)
}

/// Scalar i of the pool of decompositions.
@inline(always)
fn decomposed(_ i: Int) -> Int {
    return Int(textNumber(decompositionPool, i * 3 + (i >> 4), 3))
}

// Hangul syllables decompose and compose by arithmetic (Unicode §3.12).
const hangulBase = 0xAC00
const leadingBase = 0x1100
const vowelBase = 0x1161
const trailingBase = 0x11A7
const vowelCount = 21
const trailingCount = 28
const syllableCount = 11172

/// The code point's full decomposition, canonical or with compatibility
/// mappings too, added to the scalars; the code point itself when it has
/// none.
fn decompose(_ code: Int, compatibility: Bool, into scalars: inout Int[>..]) {
    if code < 0xC0 && !(compatibility && code >= 0xA0) {
        scalars.append(code)
        return
    }
    let syllable = code - hangulBase
    if syllable >= 0 && syllable < syllableCount {
        scalars.append(leadingBase + syllable / (vowelCount * trailingCount))
        scalars.append(vowelBase + syllable % (vowelCount * trailingCount) / trailingCount)
        if syllable % trailingCount != 0 {
            scalars.append(trailingBase + syllable % trailingCount)
        }
        return
    }
    var start = 0
    var length = 0
    if compatibility {
        let value = compatibilityOf(code)
        start = Int(value & 0x3FFF)
        length = Int(value >> 14 & 0x1F)
    }
    if length == 0 {
        let value = normalizationOf(code)
        start = Int(value >> 8 & 0x1FFF)
        length = Int(value >> 21 & 7)
    }
    if length == 0 {
        scalars.append(code)
        return
    }
    var i = 0
    while i < length {
        scalars.append(decomposed(start + i))
        i = i + 1
    }
}

/// The primary composite of the two, or -1 when they do not compose.
fn compose(_ first: Int, _ second: Int) -> Int {
    if second < 0x300 {
        return -1 // the second of every pair, Hangul's among them, is above U+02FF
    }
    let leading = first - leadingBase
    if leading >= 0 && leading < 19 {
        let vowel = second - vowelBase
        if vowel >= 0 && vowel < vowelCount {
            return hangulBase + (leading * vowelCount + vowel) * trailingCount
        }
        return -1
    }
    let syllable = first - hangulBase
    if syllable >= 0 && syllable < syllableCount && syllable % trailingCount == 0 {
        let trailing = second - trailingBase
        if trailing > 0 && trailing < trailingCount {
            return first + trailing
        }
        return -1
    }
    // The pairs the first scalar begins, in the order of their second.
    let pairs = textStaged(compositionFirstIndex, compositionFirstBlocks, shift: compositionFirstShift, limit: compositionFirstLimit, width: 3, first)
    var low = Int(pairs & 0x3FF)
    var high = low + Int(pairs >> 10)
    while low < high {
        let middle = (low + high) / 2
        let at = middle * 6 + (middle >> 4)
        let found = Int(textNumber(compositionPairs, at, 3))
        if found == second {
            return Int(textNumber(compositionPairs, at + 3, 3))
        }
        if found < second {
            low = middle + 1
        } else {
            high = middle
        }
    }
    return -1
}

/// The scalars, as a string.
fn stringOfScalars(_ scalars: Int[:]) -> String {
    var bytes: U8[>..] = []
    bytes.reserveCapacity(scalars.count)
    for code in scalars {
        Char.fromCodePoint(code)!.encodeUtf8(into: &bytes)
    }
    unsafe {
        return String.fromUtf8Unchecked(bytes)
    }
}

/// The string's scalars, as code points.
fn scalarsOf(_ text: String) -> Int[>..] {
    var codes: Int[>..] = []
    codes.reserveCapacity(text.utf8Count)
    for scalar in text {
        codes.append(scalar.codePoint)
    }
    return codes
}
