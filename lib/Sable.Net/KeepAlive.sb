module Sable.Net

import Sable.Time

/// How a connection that says nothing is asked whether its other end is
/// still there: what a system has it as, in whole seconds, rounded up.
public struct KeepAlive {
    /// How long it says nothing before it is first asked.
    public var idle: Duration

    /// How long until it is asked again.
    public var interval: Duration

    /// How many times, unanswered, until it is taken to be gone.
    public var count: Int

    public init(idle: Duration, interval: Duration, count: Int) {
        precondition(wholeSeconds(idle) > 0 && wholeSeconds(interval) > 0 && count > 0, "a keep-alive's times and count are more than none")
        self.idle = idle
        self.interval = interval
        self.count = count
    }
}
