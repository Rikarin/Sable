module Sable.Core

extension I8: Parsable {
    /// The number the text writes in decimal, with a sign if it likes: what
    /// `format` writes with nothing said. `.Overflow` past the greatest I8,
    /// `.Underflow` past the least.
    ///
    /// ```sable
    /// assert(try! I8.parse("-128") == -128)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S) throws(ParseError) -> I8 {
        return try I8.parse(text, radix: 10, styles: .Sign)
    }

    /// The number the text writes in the radix — 2 to 36, with letters of
    /// either case past 9; another traps — with what else the styles allow:
    /// white space, a sign, the radix's prefix, separators.
    ///
    /// ```sable
    /// assert(try! I8.parse("0x7f", radix: 16, styles: .Prefix) == 127)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S, radix: Int, styles: NumberStyles = .Sign) throws(ParseError) -> I8 {
        let text = text.asSubstring
        if let value = shortInteger(text, radix, styles), value >= -128 && value <= 127 {
            return I8(value)
        }
        let (negative, magnitude) = try parseInteger(text, radix, styles)
        let value = try signedValue(negative, magnitude, 127)
        return I8(value)
    }
}
