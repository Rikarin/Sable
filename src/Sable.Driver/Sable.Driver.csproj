<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Sable.Driver</RootNamespace>
    <AssemblyName>sable</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sable.CodeGen/Sable.CodeGen.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sable.CodeGen.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The standard library: Sable source, compiled with every program that imports it.
         Sable.Core is not here: every compilation has it, so Sable.Symbols carries it. -->
    <EmbeddedResource Include="../../lib/**/*.sab" Exclude="../../lib/Sable.Core/*.sab" LogicalName="lib/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- 'sable explain': the diagnostics' long-form documentation. -->
    <EmbeddedResource Include="../../docs/diagnostics/*.md" LogicalName="diagnostics/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
