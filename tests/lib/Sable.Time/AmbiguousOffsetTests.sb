module TimeAmbiguousOffsetTests

import Sable.Testing
import Sable.Time

@test
fn ambiguousOffsetsCompareByCaseAndOffsets() {
    let one = UtcOffset.hours(1)
    let two = UtcOffset.hours(2)
    assert(AmbiguousOffset.Unambiguous(offset: one) == .Unambiguous(offset: one))
    assert(AmbiguousOffset.Unambiguous(offset: one) != .Unambiguous(offset: two))
    assert(AmbiguousOffset.Gap(before: one, after: two) == .Gap(before: one, after: two))
    assert(AmbiguousOffset.Gap(before: one, after: two) != .Gap(before: one, after: one))
    assert(AmbiguousOffset.Fold(before: two, after: one) == .Fold(before: two, after: one))
    assert(AmbiguousOffset.Fold(before: two, after: one) != .Gap(before: two, after: one))
    assert(AmbiguousOffset.Gap(before: one, after: two).unambiguous == none)
}

@test
fn ambiguousOffsetsWriteTheirCase() {
    let one = UtcOffset.hours(1)
    let two = UtcOffset.hours(2)
    assertEqual(AmbiguousOffset.Unambiguous(offset: one).debugDescription(), "AmbiguousOffset.Unambiguous(offset: +01:00)")
    assertEqual(AmbiguousOffset.Gap(before: one, after: two).debugDescription(), "AmbiguousOffset.Gap(before: +01:00, after: +02:00)")
    assertEqual(AmbiguousOffset.Fold(before: two, after: one).debugDescription(), "AmbiguousOffset.Fold(before: +02:00, after: +01:00)")
}
