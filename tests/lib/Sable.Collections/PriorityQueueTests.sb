module PriorityQueueTests

// PriorityQueue (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn aPriorityQueueIsGoneThroughEveryElementOnce() {
    let queue = PriorityQueue<Int>()
    queue.push(5)
    queue.push(1)
    queue.push(3)
    assertEqualText(queue.sorted().map { "\($0)" }.joined(separator: ","), "1,3,5")
    assertEqual(queue.count, 3)
}

@test
fn priorityQueuePopsSmallestFirst() {
    let queue = PriorityQueue<Int>()
    for v in [7, 2, 9, 4, 1] {
        queue.push(v)
    }
    var order = ""
    while let v = queue.pop() {
        order = order + "\(v)"
    }
    assertEqual(order, "12479")
}

@test
fn anEmptyQueueGivesNone() {
    let queue = PriorityQueue<String>()
    assert(queue.isEmpty)
    assertEqual(queue.count, 0)
    assert(queue.peek() == none)
    assert(queue.pop() == none)
}

@test
fn anOrderGivenGoesFirst() {
    let queue = PriorityQueue<Int>(by: (a: Int, b: Int) => a > b)
    var i = 0
    while i < 50 {
        queue.push((i * 37) % 50)
        i = i + 1
    }
    assertEqual(queue.count, 50)
    assert(!queue.isEmpty)
    assertEqual(queue.peek() ?? -1, 49)
    var previous = 50
    while let v = queue.pop() {
        assert(v < previous)
        previous = v
    }
    assertEqual(previous, 0)
}

@test
fn sortedElementsLeavesTheQueueAsItIs() {
    let queue = PriorityQueue<Int>()
    queue.push(3)
    queue.push(1)
    queue.push(2)
    assert(queue.sortedElements() == [1, 2, 3])
    assertEqual(queue.count, 3)
    queue.removeAll()
    assert(queue.isEmpty)
}

@test
fn aPriorityQueueIsMadeFromAnySequenceSmallestFirst() {
    let queue = PriorityQueue([3, 1, 2])
    assertEqual(queue.pop(), 1)
    assertEqual(queue.pop(), 2)
    let collected: PriorityQueue<Int> = (1...3).map { 4 - $0 }.collect()
    assertEqual(collected.peek(), 1)
}

@test
fn aComparatorSaysWhatGoesFirst() {
    let words = PriorityQueue<String>(using: Comparator<String>.by { $0.count }.reversed().then(by: { $0 }))
    words.push("fig")
    words.push("banana")
    words.push("kiwi")
    words.push("pear")
    assertEqual(words.pop(), "banana")
    assertEqual(words.pop(), "kiwi")
    assertEqual(words.pop(), "pear")
    assertEqual(words.pop(), "fig")
    assert(words.pop() == none)
}

@test
fn aPriorityQueueIsMadeAtOnceAndChangedInPlace() {
    let queue = PriorityQueue<Int>([9, 4, 7, 1, 8, 2])
    assertEqual(queue.peek(), 1)
    assertEqual(queue.pushPop(0), 0)
    assertEqual(queue.pushPop(5), 1)
    assertEqual(queue.replaceTop(10), 2)
    assert(queue.remove(where: { $0 == 8 }) == 8)
    assert(queue.remove(where: { $0 == 99 }) == none)
    assert(queue.update(where: { $0 == 10 }, to: 3))
    assert(!queue.update(where: { $0 == 99 }, to: 3))
    assert(queue.drainSorted() == [3, 4, 5, 7, 9])
    assert(queue.isEmpty)
    let largest = PriorityQueue<Int>([1, 5, 3], using: Comparator<Int>.natural().reversed())
    assertEqual(largest.pop(), 5)
}

@test
fn aPriorityQueueAgreesWithSortingUnderRandomChanges() {
    let queue = PriorityQueue<Int>()
    var model = List<Int>()
    var seed = 99
    var step = 0
    while step < 1500 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let value = seed / 16 % 1000
        let choice = seed % 5
        if choice <= 1 {
            queue.push(value)
            model.append(value)
        } else if choice == 2 && !model.isEmpty {
            model.sort()
            assertEqual(queue.pop(), model.remove(at: 0))
        } else if choice == 3 {
            let top = queue.pushPop(value)
            model.append(value)
            model.sort()
            assertEqual(top, model.remove(at: 0))
        } else if !model.isEmpty {
            let target = model[seed / 3 % model.count]
            assert(queue.update(where: { $0 == target }, to: value))
            model[model.firstIndex(of: target)!] = value
        }
        step += 1
    }
    model.sort()
    assert(queue.drainSorted() == model.toArray())
}

@test
fn anElementGoesByItsPriority() {
    let jobs = PriorityQueue<Prioritized<String, Int>>()
    jobs.push(Prioritized("write", priority: 2))
    jobs.push(Prioritized("ship", priority: 1))
    jobs.push(Prioritized("plan", priority: 3))
    assertEqual(jobs.pop()!.element, "ship")
    assertEqual(jobs.pop()!.priority, 2)
}

@test
fn theNaturalOrderIsTheClosuresOrder() {
    // '<' compiled in, and called through a closure: what either gives out,
    // in order, is the same.
    var seed = 11
    for size in 0..<70 {
        let natural = PriorityQueue<Int>()
        let called = PriorityQueue<Int>(by: (a: Int, b: Int) => a < b)
        var values: Int[>..] = []
        for _ in 0..<size {
            seed = (seed * 1103515245 + 12345) % 2147483648
            let value = seed / 7 % 20
            values.append(value)
            natural.push(value)
            called.push(value)
        }
        let heapified = PriorityQueue<Int>(values)
        values.sort()
        for value in values {
            assertEqual(natural.peek(), value)
            assertEqual(natural.pop(), value)
            assertEqual(called.pop(), value)
            assertEqual(heapified.pop(), value)
        }
        assert(natural.isEmpty && called.pop() == none)
    }
}

@test
fn aQueueOfStringsSinksAndRises() {
    let words = PriorityQueue<String>()
    for i in 0..<200 {
        words.push("w\(i * 37 % 101)")
    }
    var last = ""
    while let word = words.pop() {
        assert(!(word < last))
        last = word
    }
}
