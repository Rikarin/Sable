module Sha3_384Tests

// Sha3_384 (Sable.Crypto): the standard's messages, every length around
// the blocks' ends, and every way of cutting a message in two. Run with
//     tools/stdlib-coverage.sh Sable.Crypto

import CryptoSupport
import Sable.Crypto
import Sable.Testing

let published: Published[>..] = [
    Published("", "0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004"),
    Published("abc", "ec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b298d88cea927ac7f539f1edf228376d25"),
    Published("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", "991c665755eb3a4b6bbdfb75c78a492e8c56a22c5c4d7e429bfdbc32b9d4ad5aa04a1f076e62fea19eef51acd0657c22"),
    Published("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu", "79407d3b5916b59c3e30b09822974791c313fb9ecc849e406f23592d04f625dc8c709b98b43b3852b337216179aa7fc7"),
]

@test(arguments: published)
fn thePublishedMessagesHaveTheirDigests(_ one: Published) {
    expect("\(Sha3_384.hash(one.message))" == one.digest)
    if let text = one.text {
        expect("\(Sha3_384.hash(utf8: text))" == one.digest)
    }
}

// Every length to past three blocks, its digest among those hashed here;
// the digest of them all from Python's hashlib.
@test
fn everyLengthHasItsDigest() {
    var all = Sha3_384()
    var count = 0
    while count < 314 {
        all.update(Sha3_384.hash(message(count)).bytes)
        count += 1
    }
    assertEqual("\(all.finalize())", "9f3b188a624900ea5e0e1cf58e04d7d0765ddf7eb70fed4e0f06276042cbd7ccbb8672db4d543224b3de98bf7d2dc2e6")
}

@test
fn aMessageInTwoPartsIsTheWholeWhereverItIsCut() {
    let whole = message(213)
    let expected = Sha3_384.hash(whole)
    var cut = 0
    while cut <= whole.count {
        var hash = Sha3_384()
        hash.update(whole[..<cut])
        hash.update(whole[cut...])
        assertEqual(hash.finalize(), expected)
        cut += 1
    }
}

@test
fn aMessageAByteAtATimeIsTheWhole() {
    let whole = message(213)
    var hash = Sha3_384()
    for byte in whole {
        hash.update([byte])
        hash.update([])
    }
    expect(hash.finalize() == Sha3_384.hash(whole))
}

@test
fn finalizingLeavesTheFunctionToGoOn() {
    let whole = message(113)
    var hash = Sha3_384()
    hash.update(whole[..<104])
    expect(hash.finalize() == Sha3_384.hash(whole[..<104]))
    expect(hash.finalize() == Sha3_384.hash(whole[..<104]))
    hash.update(whole[104...])
    expect(hash.finalize() == Sha3_384.hash(whole))
}

@test
fn aCopyHashesOnByItself() {
    let whole = message(113)
    var first = Sha3_384()
    first.update(whole[..<7])
    var second = first
    first.update(whole[7...])
    second.update(whole[..<3])
    expect(first.finalize() == Sha3_384.hash(whole))
    expect(second.finalize() == Sha3_384.hash(joined(message(7), message(3))))
}

@test
fn itsSizesAreTheStandards() {
    assertEqual(Sha3_384.digestByteCount, 48)
    assertEqual(Sha3_384.blockByteCount, 104)
    assertEqual(Sha3_384.hash(message(3)).count, 48)
}
