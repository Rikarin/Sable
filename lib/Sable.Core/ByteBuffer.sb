module Sable.Core

/// A growable run of bytes that binary data is written to, value by value
/// at its end (.NET's ArrayBufferWriter with BinaryPrimitives, Rust's
/// Vec<u8> with to_le_bytes, Java's ByteBuffer): integers and floats in
/// the buffer's byte order, bytes, UTF-8 text, and LEB128 variable-length
/// integers. A value already written can be overwritten in place, as a
/// length prefix is once the length is known. ByteReader reads it back.
///
/// ```sable
/// var buffer = ByteBuffer(endian: .Big)
/// buffer.writeU16(0xCAFE)
/// buffer.writeVarUInt(300)
/// assert(buffer.count == 4)
/// assert(buffer.bytes[0] == 0xCA && buffer.bytes[2] == 0xAC && buffer.bytes[3] == 0x02)
/// ```
public struct ByteBuffer {
    var storage: U8[>..]

    /// The order multi-byte values are written in.
    public var endian: Endian

    /// An empty buffer that writes in the byte order given: little-endian
    /// unless told otherwise.
    public init(endian: Endian = .Little) {
        storage = []
        self.endian = endian
    }

    /// An empty buffer that writes into the bytes' buffer, its room kept —
    /// one a BufferPool rented, say: what they held is dropped.
    ///
    /// ```sable
    /// let pool = BufferPool()
    /// var buffer = ByteBuffer(reusing: pool.rent(minimumCapacity: 256))
    /// buffer.writeU32(7)
    /// pool.giveBack(buffer.takeBytes())
    /// ```
    public init(reusing bytes: consuming U8[>..], endian: Endian = .Little) {
        storage = move bytes
        storage.removeAll(keepingCapacity: true)
        self.endian = endian
    }

    /// The bytes written so far: the buffer's own, shared until either
    /// changes.
    public var bytes: U8[>..] => storage

    /// The bytes written, taken out: the buffer is left empty, without a
    /// buffer of its own, so they can be handed on — to a BufferPool —
    /// without a copy.
    public mutating fn takeBytes() -> U8[>..] {
        let taken = storage
        storage = []
        return taken
    }

    /// How many bytes the buffer has room for before it must grow.
    public var capacity: Int => storage.capacity

    /// Room for at least 'count' more bytes, so that writing that many
    /// grows nothing.
    public mutating fn reserveCapacity(_ count: Int) {
        storage.reserveCapacity(storage.count + count)
    }

    /// Bytes written in place, by whoever has them: .NET's IBufferWriter
    /// (GetSpan, then Advance), Rust's BufMut. 'count' bytes are reserved
    /// at the end, zeroed, and 'fill' is given the buffer's bytes and where
    /// the reserved ones start; it writes into them and says how many it
    /// used. Those are kept and the rest given back. The bytes are the
    /// buffer's own, so nothing is copied.
    ///
    /// ```sable
    /// var buffer = ByteBuffer()
    /// buffer.writeU8(0xFF)
    /// buffer.write(reserving: 8) { bytes, start in
    ///     bytes[start] = 1
    ///     bytes[start + 1] = 2
    ///     return 2
    /// }
    /// assert(buffer.count == 3 && buffer.bytes[2] == 2)
    /// ```
    public mutating fn write(reserving count: Int, _ fill: (inout U8[>..], Int) -> Int) {
        precondition(count >= 0, "cannot reserve \(count) bytes")
        let start = storage.count
        storage.append(repeating: 0, count: count)
        let used = fill(&storage, start)
        precondition(used >= 0 && used <= count && storage.count == start + count,
            "a fill of \(count) reserved bytes used \(used), and must leave the buffer's length alone")
        storage.removeLast(count - used)
    }

    /// How many bytes have been written.
    public var count: Int => storage.count

    /// Whether nothing has been written.
    public var isEmpty: Bool => storage.count == 0

    /// Adds one byte.
    public mutating fn writeU8(_ value: U8) {
        storage.append(value)
    }

    /// Adds one byte, the I8's two's complement.
    public mutating fn writeI8(_ value: I8) {
        storage.append(value unchecked as U8)
    }

    /// Adds the two bytes of a U16, in the buffer's order.
    public mutating fn writeU16(_ value: U16) {
        self.append(U64(value), width: 2)
    }

    /// Adds the two bytes of an I16, two's complement.
    public mutating fn writeI16(_ value: I16) {
        self.append(U64(value unchecked as U16), width: 2)
    }

    /// Adds the four bytes of a U32, in the buffer's order.
    public mutating fn writeU32(_ value: U32) {
        self.append(U64(value), width: 4)
    }

    /// Adds the four bytes of an I32, two's complement.
    public mutating fn writeI32(_ value: I32) {
        self.append(U64(value unchecked as U32), width: 4)
    }

    /// Adds the eight bytes of a U64, in the buffer's order.
    public mutating fn writeU64(_ value: U64) {
        self.append(value, width: 8)
    }

    /// Adds the eight bytes of an I64, two's complement.
    public mutating fn writeI64(_ value: I64) {
        self.append(value unchecked as U64, width: 8)
    }

    /// Adds the four bytes of an F32's IEEE 754 bits.
    public mutating fn writeF32(_ value: F32) {
        self.append(U64(value.bits), width: 4)
    }

    /// Adds the eight bytes of an F64's IEEE 754 bits.
    public mutating fn writeF64(_ value: F64) {
        self.append(value.bits, width: 8)
    }

    /// Adds the bytes, as they are.
    public mutating fn write(bytes: U8[:]) {
        storage.append(contentsOf: bytes)
    }

    /// Adds the text's UTF-8 encoding: one to four bytes a scalar, and no
    /// length or terminator.
    public mutating fn writeUtf8(_ text: String) {
        for scalar in text {
            let code = scalar.codePoint
            if code < 0x80 {
                storage.append(U8(code))
            } else if code < 0x800 {
                storage.append(U8(0xC0 | code >> 6))
                storage.append(U8(0x80 | code & 0x3F))
            } else if code < 0x10000 {
                storage.append(U8(0xE0 | code >> 12))
                storage.append(U8(0x80 | code >> 6 & 0x3F))
                storage.append(U8(0x80 | code & 0x3F))
            } else {
                storage.append(U8(0xF0 | code >> 18))
                storage.append(U8(0x80 | code >> 12 & 0x3F))
                storage.append(U8(0x80 | code >> 6 & 0x3F))
                storage.append(U8(0x80 | code & 0x3F))
            }
        }
    }

    /// Adds a U64 as an unsigned LEB128 variable-length integer (Protocol
    /// Buffers' varint, WebAssembly's): seven bits a byte, low bits first,
    /// the top bit of each byte but the last set. One byte below 128, at
    /// most ten.
    public mutating fn writeVarUInt(_ value: U64) {
        var rest = value
        while rest >= 0x80 {
            storage.append(U8(rest & 0x7F) | 0x80)
            rest = rest >> 7
        }
        storage.append(U8(rest))
    }

    /// Adds an I64 as a ZigZag-encoded variable-length integer (Protocol
    /// Buffers' sint64): 0, -1, 1, -2 are 0, 1, 2, 3, so a number near zero
    /// takes a byte whatever its sign.
    public mutating fn writeVarInt(_ value: I64) {
        self.writeVarUInt((value << 1 ^ value >> 63) unchecked as U64)
    }

    /// Overwrites the two bytes from the offset with a U16, in the buffer's
    /// order; traps unless both have been written.
    public mutating fn writeU16(_ value: U16, at offset: Int) {
        storage.writeU16(value, at: offset, endian: endian)
    }

    /// Overwrites the four bytes from the offset with a U32, in the
    /// buffer's order; traps unless all have been written.
    ///
    /// ```sable
    /// var buffer = ByteBuffer()
    /// buffer.writeU32(0)
    /// buffer.writeUtf8("héllo")
    /// buffer.writeU32(U32(buffer.count - 4), at: 0)
    /// assert(buffer.bytes.readU32(at: 0, endian: .Little) == 6)
    /// ```
    public mutating fn writeU32(_ value: U32, at offset: Int) {
        storage.writeU32(value, at: offset, endian: endian)
    }

    /// Overwrites the eight bytes from the offset with a U64, in the
    /// buffer's order; traps unless all have been written.
    public mutating fn writeU64(_ value: U64, at offset: Int) {
        storage.writeU64(value, at: offset, endian: endian)
    }

    /// Empties the buffer, keeping its room.
    public mutating fn clear() {
        storage.removeAll(keepingCapacity: true)
    }

    // The low 'width' bytes of the value, in the buffer's order.
    mutating fn append(_ value: U64, width: Int) {
        var i = 0
        while i < width {
            let shift = endian == .Little ? i * 8 : (width - 1 - i) * 8
            storage.append((value >> U64(shift)) unchecked as U8)
            i = i + 1
        }
    }
}
