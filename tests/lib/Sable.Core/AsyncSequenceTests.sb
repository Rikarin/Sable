module AsyncSequenceTests

// The AsyncSequence operators (AsyncSequence+Algorithms.sb and the Async*
// files of Sable.Core): run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

enum Broken: Error {
    Down
}

// Gives 1, 2, 3, ... up to a limit, counting how many it was asked for,
// then throws if told to.
final class Counter {
    var asked: Int = 0

    init() { }
}

struct Counting: AsyncSequence {
    let counter: Counter
    let limit: Int
    let fails: Bool

    fn makeAsyncIterator() -> CountingIterator {
        return CountingIterator { counter: counter, limit: limit, fails: fails, next: 1 }
    }
}

struct CountingIterator: AsyncIterator {
    let counter: Counter
    let limit: Int
    let fails: Bool
    var next: Int

    mutating fn next() async throws(Broken) -> Int? {
        counter.asked += 1
        if next > limit {
            if fails {
                throw .Down
            }
            return none
        }
        next += 1
        return next - 1
    }
}

fn counting(_ limit: Int, fails: Bool = false) -> Counting {
    return Counting { counter: Counter(), limit: limit, fails: fails }
}

@test
fn anArrayAsAnAsyncSequenceGivesItsElements() async {
    var got: Int[>..] = []
    for await value in [4, 5, 6].async {
        got.append(value)
    }
    assert(got == [4, 5, 6])
}

@test
fn mapTransformsEachElement() async {
    let doubled = await [1, 2, 3].async.map { $0 * 2 }.collect()
    assert(doubled == [2, 4, 6])
}

@test
fn mapMayAwait() async {
    let labels = await [1, 2].async.map { value in
        await Task.yield()
        return "n\(value)"
    }.collect()
    assert(labels == ["n1", "n2"])
}

@test
fn filterKeepsWhatPasses() async {
    assert(await (1...10).async.filter { $0 % 3 == 0 }.collect() == [3, 6, 9])
}

@test
fn compactMapLeavesOutNone() async {
    let parsed = await ["1", "x", "3"].async.compactMap { try? Int.parse($0) }.collect()
    assert(parsed == [1, 3])
}

@test
fn prefixStopsAskingOnceItHasEnough() async {
    let source = counting(100)
    assert(try! await source.prefix(3).collect() == [1, 2, 3])
    assertEqual(source.counter.asked, 3)
}

@test
fn prefixOfMoreThanThereAreGivesAll() async {
    let source = counting(2)
    var iterator = source.prefix(5).makeAsyncIterator()
    assert(try! await iterator.next() == 1)
    assert(try! await iterator.next() == 2)
    assert(try! await iterator.next() == none)
    assert(try! await iterator.next() == none)
    assertEqual(source.counter.asked, 3)
}

@test
fn prefixOfNothingAsksForNothing() async {
    let source = counting(5)
    assert(try! await source.prefix(0).collect() == [])
    assertEqual(source.counter.asked, 0)
}

@test
fn prefixWhileStopsAtTheFirstFailure() async {
    let taken = await [1, 2, 7, 3].async.prefix(while: { $0 < 5 }).collect()
    assert(taken == [1, 2])
    var iterator = [9].async.prefix(while: { $0 < 5 }).makeAsyncIterator()
    assert(await iterator.next() == none)
    assert(await iterator.next() == none)
}

@test
fn chunkedGroupsTheElements() async {
    let chunks = await (1...7).async.chunked(3).collect()
    assertEqual(chunks.count, 3)
    assert(chunks[0] == [1, 2, 3])
    assert(chunks[1] == [4, 5, 6])
    assert(chunks[2] == [7])
}

@test
fn chunkedOfAnExactMultipleHasNoShortChunk() async {
    var iterator = (1...4).async.chunked(2).makeAsyncIterator()
    assert(await iterator.next()! == [1, 2])
    assert(await iterator.next()! == [3, 4])
    assert(await iterator.next() == none)
    assert(await iterator.next() == none)
}

@test
fn chunkedOfNothingIsNothing() async {
    let empty: Int[>..] = []
    assertEqual(await empty.async.chunked(2).collect().count, 0)
}

@test
fn reduceFoldsTheElements() async {
    assertEqual(await [1, 2, 3, 4].async.reduce(0) { $0 + $1 }, 10)
}

@test
fn reduceIntoChangesTheResultInPlace() async {
    let text = await ["a", "b", "c"].async.reduce(into: "") { result, piece in
        await Task.yield()
        result += piece
    }
    assertEqual(text, "abc")
}

@test
fn firstWhereStopsAtTheFirstMatch() async {
    let source = counting(100)
    assert(try! await source.first(where: { $0 > 4 }) == 5)
    assertEqual(source.counter.asked, 5)
    assert(try! await counting(3).first(where: { $0 > 4 }) == none)
}

@test
fn containsWhereSaysWhetherAnyMatches() async {
    assert(await [1, 2, 3].async.contains(where: { $0 == 2 }))
    assert(!(await [1, 2, 3].async.contains(where: { $0 == 9 })))
}

@test
fn collectGathersEveryElement() async {
    assert(try! await counting(4).collect() == [1, 2, 3, 4])
}

@test
fn anOperatorPassesTheFailureOn() async {
    do {
        let _ = try await counting(2, fails: true).map { $0 * 10 }.collect()
        assert(false)
    } catch {
        assert(error == .Down)
    }
    do {
        let _ = try await counting(2, fails: true).reduce(0) { $0 + $1 }
        assert(false)
    } catch {
        assert(error == .Down)
    }
}

@test
fn operatorsChain() async {
    let result = await (1...20).async
        .filter { $0 % 2 == 0 }
        .map { $0 * $0 }
        .prefix(3)
        .collect()
    assert(result == [4, 16, 36])
}

@test
fn zipPairsUntilEitherEnds() async {
    var pairs: String[>..] = []
    for await (number, name) in zip([1, 2, 3].async, ["one", "two"].async) {
        pairs.append("\(number)=\(name)")
    }
    assert(pairs == ["1=one", "2=two"])
}

@test
fn zipStopsOnceTheFirstEnds() async {
    let second = counting(10)
    var iterator = zip([1].async, second).makeAsyncIterator()
    let first = try! await iterator.next()
    assert(first != none)
    assert(try! await iterator.next() == none)
    assert(try! await iterator.next() == none)
    // The second was asked once for the pair, not again once the first ended.
    assertEqual(second.counter.asked, 1)
}

@test
fn zipThrowsWhatEitherThrows() async {
    var iterator = zip(counting(1, fails: true), [1, 2].async).makeAsyncIterator()
    do {
        let _ = try await iterator.next()
        let _ = try await iterator.next()
        assert(false)
    } catch {
        assert(error == .Down)
    }
}
