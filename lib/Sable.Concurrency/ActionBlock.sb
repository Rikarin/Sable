module Sable.Concurrency

/// A dataflow block that does something with each item it takes in, and
/// makes nothing: .NET's `ActionBlock<TInput>`, the end of a pipeline. It
/// works on up to `parallelism` items at once and holds at most `capacity`
/// waiting, so a send to it waits while it is full. What the action throws
/// faults it, and what links to it with propagated completion.
///
/// ```sable
/// let seen = Mutex<Int[>..]>([])
/// let log = ActionBlock<Int>(capacity: 8) { value in
///     seen.withLock { $0.append(value) }
/// }
/// for i in 1...3 {
///     await log.send(i)
/// }
/// log.complete()
/// try! await log.completion()
/// assert(seen.withLock { $0 } == [1, 2, 3])
/// ```
@immutable
public final class ActionBlock<Input: Sendable>: DataflowTarget {
    let engine: BlockEngine<Input, Bool>

    /// A block that does the action with each item it takes in, holding at
    /// most so many (none: as many as come) and working on so many at once.
    public init(capacity: Int? = none, parallelism: Int = 1, _ action: @escaping @Sendable async (Input) throws -> Void) {
        engine = BlockEngine<Input, Bool>(capacity: capacity, parallelism: parallelism, ordered: false, outlet: none, atEnd: { .Nothing }, work: { item in
            try await action(item)
            return .Nothing
        })
    }

    public fn send(_ item: Input) async -> SendResult {
        return await engine.send(item)
    }

    public fn trySend(_ item: Input) -> SendResult {
        return engine.trySend(item)
    }

    public fn complete() {
        engine.complete()
    }

    public fn fault(_ error: any Error) {
        engine.fault(error)
    }

    public var failure: (any Error)? => engine.status.failure

    /// Waits until the block has done the action with every item it took
    /// in; throws what it faulted with.
    public fn completion() async throws {
        try await engine.status.completion(none)
    }

    /// How many items wait for the action.
    public var inputCount: Int => engine.input.count
}
