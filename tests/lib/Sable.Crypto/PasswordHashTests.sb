module PasswordHashTests

// PasswordHash (Sable.Crypto), and the hash(password:) of Argon2id, Scrypt and
// Pbkdf2: hashes made elsewhere, and text that is not one. Run with
//     tools/stdlib-coverage.sh Sable.Crypto

import Sable.Crypto
import Sable.Testing

let argon2 = "$argon2id$v=19$m=128,t=2,p=2$MDEyMzQ1Njc4OWFiY2RlZg$BbBHUSlDWVd9h+UTYwOokLoVfsJBOmISJQP+UYTSazA"
let scrypt = "$scrypt$ln=7,r=8,p=1$MDEyMzQ1Njc4OWFiY2RlZg$CjXXYU6IrwFtFRpbNK1kJ/O5pEcGUS0npoyJddY1RWs"
let pbkdf2OfSha256 = "$pbkdf2-sha256$i=100,l=32$MDEyMzQ1Njc4OWFiY2RlZg$jFv3hht7uRixqMdKdjkASH0qpaB7Y6oFZhc+KxyeitI"
let pbkdf2OfSha512 = "$pbkdf2-sha512$i=100,l=64$MDEyMzQ1Njc4OWFiY2RlZg$/yFakMlDl2xIXcbIvCmwQ3f5b+vB2Ui5t7qa6qg93Z6NvAdTkzlGNgvVQDGF+H9HWKVKWQEKRd6jq7U5b+vBag"

fn verifies(_ password: String, _ encoded: String) -> Bool {
    return try! PasswordHash.verify(password: password, against: encoded)
}

// Written by OpenSSL (through Python's cryptography) and Python's hashlib.
@test(arguments: [argon2, scrypt, pbkdf2OfSha256, pbkdf2OfSha512])
fn hashesMadeElsewhereAreVerified(_ encoded: String) {
    expect(verifies("correct horse", encoded))
    expect(!verifies("correct hors", encoded))
    expect(!verifies("", encoded))
}

@test(tags: ["slow"], timeout: .minutes(3))
fn hashesMadeHereAreVerified() {
    let made: String[>..] = [
        (try! Argon2id(memoryKiB: 64, iterations: 2, parallelism: 3)).hash(password: "pässword"),
        (try! Scrypt(cost: 64, blockSize: 2, parallelism: 2)).hash(password: "pässword"),
        try! Pbkdf2<Sha256>.hash(password: "pässword", iterations: 10),
        try! Pbkdf2<Sha512>.hash(password: "pässword", iterations: 10),
        PasswordHash.hash(password: "pässword"),
    ]
    for encoded in made {
        expect(verifies("pässword", encoded), encoded)
        expect(!verifies("password", encoded), encoded)
    }
    expect(made[0].hasPrefix("$argon2id$v=19$m=64,t=2,p=3$"))
    expect(made[1].hasPrefix("$scrypt$ln=6,r=2,p=2$"))
    expect(made[4].hasPrefix("$argon2id$v=19$m=65536,t=3,p=4$"))
}

@test
fn twoHashesOfAPasswordHaveSaltsOfTheirOwn() {
    let argon2 = try! Argon2id(memoryKiB: 8, iterations: 1, parallelism: 1)
    expect(argon2.hash(password: "x") != argon2.hash(password: "x"))
}

@test
fn aFunctionTheFormatHasNoNameForIsRefused() {
    expectThrows { _ = try Pbkdf2<Sha3_256>.hash(password: "x", iterations: 1) }
    expectThrows { _ = try Pbkdf2<Sha256>.hash(password: "x", iterations: 0) }
}

