module ConcurrentDictionaryTests

// ConcurrentDictionary (Sable.Concurrency): against a Dictionary one
// operation at a time, and under many tasks at once: each operation on a
// key atomic, getOrInsert's closure run once per key, and iteration during
// writes giving each entry that is there throughout exactly once.

import ConcurrencySupport
import Sable.Concurrency
import Sable.Testing

@test
fn eachOperationByExample() {
    let dictionary = ConcurrentDictionary<String, Int>(shards: 5)
    expect(dictionary.isEmpty)
    expect(dictionary["a"] == none)
    expect(dictionary.updateValue(1, forKey: "a") == none)
    expect(dictionary.updateValue(2, forKey: "a") == 1)
    expect(!dictionary.insert(3, forKey: "a"))
    expect(dictionary.insert(4, forKey: "b"))
    expect(dictionary.contains("b"))
    assertEqual(dictionary.count, 2)
    expect(dictionary.update("a") { $0 *= 10 })
    expect(!dictionary.update("zz") { $0 *= 10 })
    dictionary.update("c", default: 7) { $0 += 1 }
    assertEqual(dictionary["a"] ?? 0, 20)
    assertEqual(dictionary["c"] ?? 0, 8)
    assertEqual(dictionary.getOrInsert("d", with: { 9 }), 9)
    assertEqual(dictionary.getOrInsert("d", with: { 10 }), 9)
    expect(dictionary.remove("d") == 9)
    expect(dictionary.remove("d") == none)
    let copy = dictionary.snapshot()
    assertEqual(copy.count, 3)
    assertEqual(copy["b"] ?? 0, 4)
    var keys = 0
    for entry in dictionary {
        keys += entry.value > 0 ? 1 : 0
    }
    assertEqual(keys, 3)
    dictionary.removeAll()
    expect(dictionary.isEmpty)
    assertEqual(dictionary.count, 0)
}

@derive(Debug)
union Step {
    UpdateValue(Int)
    Remove(Int)
    GetOrInsert(Int)
    Increment(Int)
    Get(Int)
}

@test
fn randomOperationsAgreeWithADictionary() {
    let keys = Gen.number(in: 0...199)
    let step = Gen.oneOf([
        keys.map { Step.UpdateValue($0) },
        keys.map { Step.Remove($0) },
        keys.map { Step.GetOrInsert($0) },
        keys.map { Step.Increment($0) },
        keys.map { Step.Get($0) },
    ])
    forAll(many(step, upTo: 4000), cases: 14) { (steps: Step[>..]) in
        let dictionary = ConcurrentDictionary<Int, Int>()
        var model: [Int: Int] = [:]
        var number = 0
        for step in steps {
            number += 1
            let now = number
            var same = true
            match step {
                case .UpdateValue(let key) => {
                    same = dictionary.updateValue(now, forKey: key) == model.updateValue(now, forKey: key)
                }
                case .Remove(let key) => {
                    same = dictionary.remove(key) == model.remove(key)
                }
                case .GetOrInsert(let key) => {
                    same = dictionary.getOrInsert(key, with: { now }) == model.orInsertWith(key, { now })
                }
                case .Increment(let key) => {
                    dictionary.update(key, default: 0) { $0 += 1 }
                    model.modify(key, default: 0) { $0 += 1 }
                }
                case .Get(let key) => {
                    same = dictionary[key] == model[key]
                }
            }
            if !same {
                recordFailure("step \(now), \(step:?), does not agree")
                return
            }
        }
        expect(dictionary.count == model.count)
        for entry in dictionary {
            expect(model[entry.key] == entry.value)
        }
    }
}

@test
fn manyTasksUpdatingAtOnceLoseNoUpdate() async {
    let counts = ConcurrentDictionary<Int, Int>()
    let made = Atomic<Int>(0)
    await withTaskGroup(of: Int.self) { group in
        var task = 0
        while task < 4 {
            group.spawn {
                var i = 0
                while i < 20000 {
                    counts.update(i % 64, default: 0) { $0 += 1 }
                    let value = counts.getOrInsert(1000 + i % 32, with: {
                        made.add(1)
                        return i % 32
                    })
                    assertEqual(value, i % 32)
                    i += 1
                }
                return 0
            }
            task += 1
        }
        await group.waitForAll()
    }
    var total = 0
    var key = 0
    while key < 64 {
        total += counts[key] ?? 0
        key += 1
    }
    assertEqual(total, 4 * 20000)
    assertEqual(made.load(), 32)
    assertEqual(counts.count, 64 + 32)
}

@test
fn iteratingWhileOthersWriteGivesEachLastingEntryOnce() async {
    let dictionary = ConcurrentDictionary<Int, Int>()
    var key = 0
    while key < 500 {
        dictionary.insert(key, forKey: key)
        key += 1
    }
    let done = Atomic<Bool>(false)
    let seenRight = await withTaskGroup(of: Bool.self) { group -> Bool in
        group.spawn {
            var i = 0
            while !done.load() {
                // Keys of 10000 and above come and go; 0 to 499 stay.
                dictionary.updateValue(i, forKey: 10000 + i % 300)
                dictionary.remove(10000 + (i + 150) % 300)
                i += 1
                if i % 100 == 0 {
                    await yieldNow()
                }
            }
            return true
        }
        group.spawn {
            var right = true
            var round = 0
            while round < 20 {
                var times: Int[>..] = []
                var k = 0
                while k < 500 {
                    times.append(0)
                    k += 1
                }
                for entry in dictionary {
                    if entry.key < 500 {
                        times[entry.key] += 1
                    }
                }
                for count in times {
                    right = right && count == 1
                }
                round += 1
                await yieldNow()
            }
            done.store(true)
            return right
        }
        var all = true
        for await right in group {
            all = all && right
        }
        return all
    }
    expect(seenRight, "a lasting entry was missed or given twice")
}

@test
fn arraysAsValuesGrowOnEveryThread() async {
    let lists = ConcurrentDictionary<String, Int[>..]>()
    await withTaskGroup(of: Int.self) { group in
        for task in 0..<4 {
            group.spawn {
                var seen = 0
                for i in 0..<2000 {
                    lists.update("k\(i % 100)", default: []) { $0.append(i) }
                    seen += lists.getOrInsert("z\(i % 10)", with: { [task] }).count
                    seen += lists["k\(i % 90)"]?.count ?? 0
                }
                return seen
            }
        }
        await group.waitForAll()
    }
    var total = 0
    for i in 0..<100 {
        total += lists["k\(i)"]!.count
    }
    assertEqual(total, 8000)
    assertEqual(lists.count, 110)
}
