module AsnStructureTests

// Whole structures out of the specifications: X.690 Annex A's personnel
// record, RFC 5280 Appendix C's certificate and CRL, and RFC 8017's
// DigestInfo and public key.

import Sable.Crypto
import Sable.Math
import Sable.Serialize.Asn1
import Sable.Testing
import Sable.Text
import Sable.Time

fn hex(_ text: String) -> U8[>..] {
    return try! Hex.decode(text.split(" ").map({ $0.toString() }).joined(separator: ""))
}

// ---- X.690 Annex A ---------------------------------------------------------

fn writeName(_ writer: AsnWriter, _ given: String, _ initial: String, _ family: String) throws(AsnError) {
    try writer.writeSequence(tag: .application(1)) {
        try writer.writeString(given, .Visible)
        try writer.writeString(initial, .Visible)
        try writer.writeString(family, .Visible)
    }
}

fn writeDate(_ writer: AsnWriter, _ date: String) throws(AsnError) {
    try writer.writeString(date, .Visible, tag: .application(3))
}

fn writeChild(_ writer: AsnWriter, _ given: String, _ initial: String, _ family: String, _ birth: String) throws(AsnError) {
    try writer.writeSet {
        try writeName(writer, given, initial, family)
        try writer.writeExplicit(.context(0)) {
            try writeDate(writer, birth)
        }
    }
}

fn writeRecord(_ writer: AsnWriter) throws(AsnError) {
    try writer.writeSet(tag: .application(0)) {
        try writeName(writer, "John", "P", "Smith")
        try writer.writeExplicit(.context(0)) {
            try writer.writeString("Director", .Visible)
        }
        try writer.writeInt(51, tag: .application(2))
        try writer.writeExplicit(.context(1)) {
            try writeDate(writer, "19710917")
        }
        try writer.writeExplicit(.context(2)) {
            try writeName(writer, "Mary", "T", "Smith")
        }
        try writer.writeSequence(tag: .context(3)) {
            try writeChild(writer, "Ralph", "T", "Smith", "19571111")
            try writeChild(writer, "Susan", "B", "Jones", "19590717")
        }
    }
}

@test
fn thePersonnelRecord() {
    let writer = AsnWriter(rules: .Ber)
    try! writeRecord(writer)
    let expected = [
        "60 8185",
        "61 10 1a04 4a6f686e 1a01 50 1a05 536d697468",
        "a0 0a 1a08 4469726563746f72",
        "42 01 33",
        "a1 0a 43 08 3139373130393137",
        "a2 12 61 10 1a04 4d617279 1a01 54 1a05 536d697468",
        "a3 42",
        "31 1f 61 11 1a05 52616c7068 1a01 54 1a05 536d697468 a0 0a 43 08 3139353731313131",
        "31 1f 61 11 1a05 537573616e 1a01 42 1a05 4a6f6e6573 a0 0a 43 08 3139353930373137",
    ].joined(separator: " ")
    expect(try! writer.bytes() == hex(expected))

    var reader = AsnReader(hex(expected), rules: .Ber)
    var record = try! reader.readSet(tag: .application(0))
    var name = try! record.readSequence(tag: .application(1))
    assertEqualText(try! name.readString(.Visible), "John")
    var title = try! record.readExplicit(.context(0))
    assertEqualText(try! title.readString(.Visible), "Director")
    assertEqual(try! record.readInt(tag: .application(2)), 51)
    // DER has the employee's number, [APPLICATION 2], before the title, [0].
    let canonical = AsnWriter(rules: .Der)
    try! writeRecord(canonical)
    var canonicalReader = AsnReader(try! canonical.bytes(), rules: .Der)
    var members = try! canonicalReader.readSet(tag: .application(0))
    var orders: String[>..] = []
    while !members.isAtEnd {
        orders.append("\(try! members.peekTag())")
        _ = try! members.readEncoded()
    }
    assertEqualText(orders.joined(separator: " "), "[APPLICATION 1] [APPLICATION 2] [0] [1] [2] [3]")
    let refused = AsnReader(hex(expected), rules: .Der)
    var copy = refused
    expect((try? copy.readSet(tag: .application(0))) == none)
}

// ---- RFC 5280 Appendix C ---------------------------------------------------

fn writeAlgorithm(_ writer: AsnWriter, _ id: String) throws(AsnError) {
    try writer.writeSequence {
        try writer.writeObjectIdentifier(id)
        try writer.writeNull()
    }
}

fn writeAttribute(_ writer: AsnWriter, _ id: String, _ value: String, _ kind: AsnStringKind) throws(AsnError) {
    try writer.writeSetOf {
        try writer.writeSequence {
            try writer.writeObjectIdentifier(id)
            try writer.writeString(value, kind)
        }
    }
}

fn writeExampleCa(_ writer: AsnWriter) throws(AsnError) {
    try writer.writeSequence {
        try writeAttribute(writer, "0.9.2342.19200300.100.1.25", "com", .Ia5)
        try writeAttribute(writer, "0.9.2342.19200300.100.1.25", "example", .Ia5)
        try writeAttribute(writer, "2.5.4.3", "Example CA", .Printable)
    }
}

fn utc(_ text: String) -> OffsetDateTime {
    return try! OffsetDateTime.parseRfc3339(text)
}

fn modulus() -> U8[>..] {
    return hex(
        [
            "C2 D7 97 6D 28 70 AA 5B CF 23 2E 80 70 39 EE DB 6F D5 2D D5 6A 4F 7A 34 2D F9 22 72 47 70 1D",
            "EF 80 E9 CA 30 8C 00 C4 9A 6E 5B 45 B4 6E A5 E6 6C 94 0D FA 91 E9 40 FC 25 9D C7 B7 68 19 56 8F",
            "11 70 6A D7 F1 C9 11 4F 3A 7E 3F 99 8D 6E 76 A5 74 5F 5E A4 55 53 E5 C7 68 36 53 C7 1D 3B 12 A6",
            "85 FE BD 6E A1 CA DF 35 50 AC 08 D7 B9 B4 7E 5C FE E2 A3 2C D1 23 84 AA 98 C0 9B 66 18 9A 68 47 E9",
        ].joined(separator: " ")
    )
}

fn certificateSignature() -> U8[>..] {
    return hex(
        [
            "6C F8 02 74 A6 61 E2 64 04 A6 54 0C 6C 72 13 AD 3C 47 FB F6 65 13 A9 85 90 33 EA 76 A3 26 D9 FC",
            "D1 0E 15 5F 28 B7 EF 93 BF 3C F3 E2 3E 7C B9 52 FC 16 6E 29 AA E1 F4 7A 6F D5 7F EF B3 95 CA F3",
            "66 88 83 4E A1 35 45 84 CB BC 9B B8 C8 AD C5 5E 46 D9 0B 0E 8D 80 E1 33 2B DC BE 2B 92 7E 4A 43",
            "A9 6A EF 8A 63 61 B3 6E 47 38 BE E8 0D A3 67 5D F3 FA 91 81 3C 92 BB C5 5F 25 25 EB 7C E7 D8 A1",
        ].joined(separator: " ")
    )
}

fn listSignature() -> U8[>..] {
    return hex(
        [
            "22 DC 18 7D F7 08 CE CC 75 D0 D0 6A 9B AD 10 F4 76 23 B4 81 6E B5 6D BE 0E FB 15 14 6C C8 17 6D",
            "1F EE 90 17 A2 6F 60 E4 BD AA 8C 55 DE 8E 84 6F 92 F8 9F 10 12 27 AF 4A D4 2F 85 E2 36 44 7D AA",
            "A3 4C 25 38 15 FF 00 FD 3E 7E EE 3D 26 12 EB D8 E7 2B 62 E2 2B C3 46 80 EF 78 82 D1 15 C6 D0 9C",
            "72 6A CB CE 7A ED 67 99 8B 6E 70 81 7D 43 42 74 C1 A6 AF C1 55 17 A2 33 4C D6 06 98 2B A4 FC 2E",
        ].joined(separator: " ")
    )
}

// C.1's certificate without its signature.
fn writeToBeSigned(_ writer: AsnWriter) throws(AsnError) {
    let keyId = hex("0868AF8533C8394A7AF882938E706A4A20842C32")
    try writer.writeSequence {
        try writer.writeExplicit(.context(0)) {
            try writer.writeInt(2)
        }
        try writer.writeInt(17)
        try writeAlgorithm(writer, "1.2.840.113549.1.1.5")
        try writeExampleCa(writer)
        try writer.writeSequence {
            try writer.writeUtcTime(utc("2004-04-30T14:25:34Z"))
            try writer.writeUtcTime(utc("2005-04-30T14:25:34Z"))
        }
        try writeExampleCa(writer)
        try writer.writeSequence {
            try writeAlgorithm(writer, "1.2.840.113549.1.1.1")
            try writer.writeBitString {
                try writer.writeSequence {
                    try writer.writeUnsignedInteger(modulus())
                    try writer.writeInt(65537)
                }
            }
        }
        try writer.writeExplicit(.context(3)) {
            try writer.writeSequence {
                try writer.writeSequence {
                    try writer.writeObjectIdentifier("2.5.29.14")
                    try writer.writeOctetString {
                        try writer.writeOctetString(keyId)
                    }
                }
                try writer.writeSequence {
                    try writer.writeObjectIdentifier("2.5.29.15")
                    try writer.writeBool(true)
                    try writer.writeOctetString {
                        try writer.writeNamedBits(flags: 1 << 5 | 1 << 6)
                    }
                }
                try writer.writeSequence {
                    try writer.writeObjectIdentifier("2.5.29.19")
                    try writer.writeBool(true)
                    try writer.writeOctetString {
                        try writer.writeSequence {
                            try writer.writeBool(true)
                        }
                    }
                }
            }
        }
    }
}

// The signed structure, around the bytes that are signed.
fn signed(_ toBeSigned: U8[>..], _ signature: U8[>..]) -> U8[>..] {
    let writer = AsnWriter(rules: .Der)
    try! writer.writeSequence {
        try writer.writeEncoded(toBeSigned)
        try writeAlgorithm(writer, "1.2.840.113549.1.1.5")
        try writer.writeBitString(AsnBitString(bytes: signature))
    }
    return try! writer.bytes()
}

// What RFC 8017's RSASP1 signs, taken back out of the signature: the
// DigestInfo, after its padding.
fn digestInfo(_ signature: U8[>..]) -> U8[>..] {
    let message = BigInt(bytes: signature, endian: .Big, signed: false).powMod(
        BigInt(65537),
        BigInt(bytes: modulus(), endian: .Big, signed: false)
    ).toBytes(.Big)
    var i = 1
    while message[i] == 0xFF {
        i += 1
    }
    expect(message[0] == 1 && message[i] == 0)
    return message[i + 1..<message.count].toArray()
}

@test
fn theExampleCertificate() {
    let writer = AsnWriter(rules: .Der)
    try! writeToBeSigned(writer)
    let toBeSigned = try! writer.bytes()
    let certificate = signed(toBeSigned, certificateSignature())
    // The annotated dump's lengths, and the signature, which is of every
    // byte of it.
    assertEqual(toBeSigned.count, 427)
    assertEqual(certificate.count, 578)
    var info = AsnReader(digestInfo(certificateSignature()), rules: .Der)
    var fields = try! info.readSequence()
    var algorithm = try! fields.readSequence()
    assertEqualText("\(try! algorithm.readObjectIdentifier())", "1.3.14.3.2.26")
    try! algorithm.readNull()
    assertEqualText(Hex.encode(try! fields.readOctetString()), "\(Insecure.Sha1.hash(toBeSigned))")

    var reader = AsnReader(certificate, rules: .Der)
    var outer = try! reader.readSequence()
    var inner = try! outer.readSequence()
    var version = try! inner.readExplicit(.context(0))
    assertEqual(try! version.readInt(), 2)
    assertEqual(try! inner.readInt(), 17)
    assertEqual(inner.position, 16)
    _ = try! inner.readEncoded()
    var issuer = try! inner.readSequence()
    var values: String[>..] = []
    while !issuer.isAtEnd {
        var attributes = try! issuer.readSetOf()
        var attribute = try! attributes.readSequence()
        let id = try! attribute.readObjectIdentifier()
        let kind: AsnStringKind = id == ObjectIdentifier([2, 5, 4, 3]) ? .Printable : .Ia5
        values.append("\(id)=\(try! attribute.readString(kind))")
        try! attribute.finish()
        try! attributes.finish()
    }
    assertEqualText(
        values.joined(separator: ","),
        "0.9.2342.19200300.100.1.25=com,0.9.2342.19200300.100.1.25=example,2.5.4.3=Example CA"
    )
    var validity = try! inner.readSequence()
    assertEqualText(try! validity.readUtcTime().instant.rfc3339(), "2004-04-30T14:25:34Z")
    assertEqualText(try! validity.readUtcTime().instant.rfc3339(), "2005-04-30T14:25:34Z")
    _ = try! inner.readEncoded()
    assertEqual(inner.position, 201)
    var key = try! inner.readSequence()
    _ = try! key.readEncoded()
    var keyBits = try! key.readBitStringContents()
    assertEqual(keyBits.position, 223)
    var rsa = try! keyBits.readSequence()
    expect(try! rsa.readBigInt() == BigInt(bytes: modulus(), endian: .Big, signed: false))
    assertEqual(rsa.position, 358)
    assertEqual(try! rsa.readInt(), 65537)
    var tagged = try! inner.readExplicit(.context(3))
    var extensions = try! tagged.readSequence()
    var found: String[>..] = []
    while !extensions.isAtEnd {
        var one = try! extensions.readSequence()
        let id = try! one.readObjectIdentifier()
        let isCritical = one.isNext(.bool) ? try! one.readBool() : false
        var contents = try! one.readOctetStringContents()
        if id == ObjectIdentifier([2, 5, 29, 15]) {
            let usage = try! contents.readNamedBits()
            expect(usage.has(5) && usage.has(6) && usage.count == 7)
        }
        found.append("\(id) \(isCritical)")
    }
    assertEqualText(found.joined(separator: ","), "2.5.29.14 false,2.5.29.15 true,2.5.29.19 true")
    try! inner.finish()
    // Every byte of it changed is another certificate or none; none traps.
    for i in 0..<certificate.count {
        var changed = certificate
        changed[i] = changed[i] ^ 0x20
        var other = AsnReader(changed, rules: .Der)
        _ = try? walk(&other)
    }
}

// Reads all the values there are, whatever they are.
fn walk(_ reader: inout AsnReader) throws(AsnError) {
    while !reader.isAtEnd {
        let tag = try reader.peekTag()
        if tag.tagClass == .ContextSpecific && tag.isConstructed {
            var inner = try reader.readExplicit(tag)
            try walk(&inner)
        } else if tag.matches(.sequence) {
            var inner = try reader.readSequence()
            try walk(&inner)
        } else if tag.matches(.set) {
            var inner = try reader.readSetOf()
            try walk(&inner)
        } else if tag.matches(.octetString) {
            var inner = try reader.readOctetStringContents()
            try walk(&inner)
        } else if tag.matches(.integer) {
            _ = try reader.readBigInt()
        } else if tag.matches(.utcTime) {
            _ = try reader.readUtcTime()
        } else if tag.matches(.objectIdentifier) {
            _ = try reader.readObjectIdentifier()
        } else if tag.matches(.bitString) {
            _ = try reader.readBitString()
        } else if tag.matches(.enumerated) {
            _ = try reader.readEnumerated()
        } else {
            _ = try reader.readEncoded()
        }
    }
}

@test
fn theExampleRevocationList() {
    let writer = AsnWriter(rules: .Der)
    try! writer.writeSequence {
        try writer.writeInt(1)
        try writeAlgorithm(writer, "1.2.840.113549.1.1.5")
        try writeExampleCa(writer)
        try writer.writeUtcTime(utc("2005-02-05T12:00:00Z"))
        try writer.writeUtcTime(utc("2005-02-06T12:00:00Z"))
        try writer.writeSequence {
            try writer.writeSequence {
                try writer.writeInt(18)
                try writer.writeUtcTime(utc("2004-11-19T15:57:03Z"))
                try writer.writeSequence {
                    try writer.writeSequence {
                        try writer.writeObjectIdentifier("2.5.29.21")
                        try writer.writeOctetString {
                            try writer.writeEnumerated(1)
                        }
                    }
                }
            }
        }
        try writer.writeExplicit(.context(0)) {
            try writer.writeSequence {
                try writer.writeSequence {
                    try writer.writeObjectIdentifier("2.5.29.35")
                    try writer.writeOctetString {
                        try writer.writeSequence {
                            try writer.writeOctetString(hex("0868AF8533C8394A7AF882938E706A4A20842C32"), tag: .context(0))
                        }
                    }
                }
                try writer.writeSequence {
                    try writer.writeObjectIdentifier("2.5.29.20")
                    try writer.writeOctetString {
                        try writer.writeInt(12)
                    }
                }
            }
        }
    }
    let toBeSigned = try! writer.bytes()
    assertEqual(signed(toBeSigned, listSignature()).count, 356)
    var info = AsnReader(digestInfo(listSignature()), rules: .Der)
    var fields = try! info.readSequence()
    _ = try! fields.readEncoded()
    assertEqualText(Hex.encode(try! fields.readOctetString()), "\(Insecure.Sha1.hash(toBeSigned))")
    var reader = AsnReader(toBeSigned, rules: .Der)
    try! walk(&reader)
}

// ---- RFC 8017 ----------------------------------------------------------------

// §9.2's note 1.
@test(arguments: [
    ("2.16.840.1.101.3.4.2.1", "30 31 30 0d 06 09 60 86 48 01 65 03 04 02 01 05 00 04 20", 32),
    ("2.16.840.1.101.3.4.2.2", "30 41 30 0d 06 09 60 86 48 01 65 03 04 02 02 05 00 04 30", 48),
    ("2.16.840.1.101.3.4.2.3", "30 51 30 0d 06 09 60 86 48 01 65 03 04 02 03 05 00 04 40", 64),
    ("1.3.14.3.2.26", "30 21 30 09 06 05 2b 0e 03 02 1a 05 00 04 14", 20),
    ("1.2.840.113549.2.5", "30 20 30 0c 06 08 2a 86 48 86 f7 0d 02 05 05 00 04 10", 16),
])
fn aDigestInfo(_ id: String, _ head: String, _ size: Int) {
    var digest: U8[>..] = []
    digest.append(repeating: 0xAB, count: size)
    let writer = AsnWriter(rules: .Der)
    try! writer.writeSequence {
        try writeAlgorithm(writer, id)
        try writer.writeOctetString(digest)
    }
    var expected = hex(head)
    expected.append(contentsOf: digest)
    expect(try! writer.bytes() == expected)
}
