// Each is an error, whatever the password: none is merely not verified.
@test(arguments: notHashes)
fn whatIsNotAHashIsRefused(_ encoded: String) {
    expectThrows { _ = try PasswordHash.verify(password: "correct horse", against: encoded) }
}

@test
fn aHashOrASaltTooLongIsRefused() {
    expectThrows { _ = try PasswordHash.verify(password: "correct horse", against: "$argon2id$v=19$m=128,t=2,p=2$MDEyMzQ1Njc4OWFiY2RlZg$\("A".repeated(200))") }
    expectThrows { _ = try PasswordHash.verify(password: "correct horse", against: "$argon2id$v=19$m=128,t=2,p=2$\("A".repeated(600))$BbBHUSlDWVd9h+UTYwOokLoVfsJBOmISJQP+UYTSazA") }
}

@test
fn theLimitsAreTheCallers() {
    let small = (try! Argon2id(memoryKiB: 1024, iterations: 1, parallelism: 1)).hash(password: "x")
    expect((try? PasswordHash.verify(password: "x", against: small, maximumMemory: 1024 * 1024)) == true)
    expectThrows { _ = try PasswordHash.verify(password: "x", against: small, maximumMemory: 1023 * 1024) }
    expectThrows { _ = try PasswordHash.verify(password: "correct horse", against: pbkdf2OfSha256, maximumIterations: 99) }
    expectThrows { _ = try PasswordHash.verify(password: "correct horse", against: scrypt, maximumMemory: 65536) }
}
