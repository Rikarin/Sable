module TimePeriodTests

import Sable.Testing
import Sable.Time

@test
fn periodsKeepTheirPartsApart() {
    let period = Period.of(years: 1, months: 14, days: 40)
    assertEqual(period.years, 1)
    assertEqual(period.months, 14)
    assertEqual(period.days, 40)
    assertEqual(period.totalMonths, 26)
    assertEqual(period.normalized(), Period.of(years: 2, months: 2, days: 40))
    assertEqual(Period.weeks(2), Period.days(14))
    assertEqual(Period.years(1) + Period.months(2) + Period.days(3), Period.of(years: 1, months: 2, days: 3))
    assertEqual(Period.of(years: 1, months: 2, days: 3) - Period.days(3), Period.of(years: 1, months: 2))
    assertEqual(Period.of(months: 1, days: -2).negated(), Period.of(months: -1, days: 2))
    expect(Period.zero.isZero)
    expect(!Period.days(1).isZero)
    assertEqual(Period.days(1).hashValue, Period.days(1).hashValue)
}

@test(arguments: [(Period.zero, "P0D"), (Period.of(years: 1, months: 2, days: 3), "P1Y2M3D"), (Period.months(-1), "P-1M")])
fn periodsWriteAsISO8601(_ period: Period, _ text: String) {
    assertEqual(period.toString(), text)
}

@test
fn periodsDebugAsISO8601() {
    assertEqual(Period.days(10).debugDescription(), "P10D")
}

@test(arguments: [
    ("P1Y2M3D", Period.of(years: 1, months: 2, days: 3)),
    ("p2w1d", Period.days(15)),
    ("-P1M", Period.months(-1)),
    ("+P1Y", Period.years(1)),
    ("P-1M+2D", Period.of(months: -1, days: 2)),
    (Period.of(years: 7, days: -3).toString(), Period.of(years: 7, days: -3)),
])
fn periodsReadISO8601(_ text: String, _ expected: Period) throws {
    expect(try Period.parse(text) == expected)
}

@test(arguments: [
    ("", ParseError.Empty),
    ("1Y", ParseError.Invalid(at: 0)),
    ("P", ParseError.Invalid(at: 1)),
    ("PY", ParseError.InvalidDigit(at: 1)),
    ("P1", ParseError.Invalid(at: 2)),
    ("P1D1Y", ParseError.Invalid(at: 3)),
    ("PT1H", ParseError.InvalidDigit(at: 1)),
    ("P1X", ParseError.Invalid(at: 2)),
    ("P99999999999999999999Y", ParseError.Overflow),
])
fn aPeriodThatIsNotOneSaysWhere(_ text: String, _ error: ParseError) {
    expectThrows(error) { _ = try Period.parse(text) }
}
