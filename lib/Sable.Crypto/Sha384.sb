module Sable.Crypto

/// SHA-384, FIPS 180-4: a 48-byte digest, SHA-512 from another initial state,
/// cut short.
///
/// ```sable
/// assert("\(Sha384.hash(utf8: "abc"))" == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
/// var hash = Sha384()
/// hash.update(utf8: "a")
/// hash.update(utf8: "bc")
/// assert(hash.finalize() == Sha384.hash(utf8: "abc"))
/// ```
public struct Sha384: HashFunction {
    var state: BlockState<Sha512Blocks>

    public init() {
        state = BlockState<Sha512Blocks>(initial: Sha384.initialState)
    }

    static let initialState: U64[>..] = [
        0xCBBB9D5DC1059ED8, 0x629A292A367CD507, 0x9159015A3070DD17, 0x152FECD8F70E5939,
        0x67332667FFC00B31, 0x8EB44A8768581511, 0xDB0C2E0D64F98FA7, 0x47B5481DBEFA4FA4,
    ]

    public static var digestByteCount: Int => 48

    public static var blockByteCount: Int => 128

    public mutating fn update(_ bytes: U8[:]) {
        state.update(bytes)
    }

    public fn finalize() -> Digest {
        return bigEndianDigest64(state.finish(), count: 48)
    }

    public mutating fn finalizeAndReset() -> Digest {
        let digest = bigEndianDigest64(state.finishInPlace(), count: 48)
        state.restart(Sha384.initialState)
        return digest
    }

    public mutating fn finalizeAndReset(into digest: inout U8[:]) {
        storeBigEndian64(state.finishInPlace(), count: 48, into: &digest)
        state.restart(Sha384.initialState)
    }

    public static fn iterateHmac(inner: Sha384, outer: Sha384, first: U8[:], iterations: Int) -> U8[>..] {
        return BlockState<Sha512Blocks>.iterateHmac(inner: inner.state, outer: outer.state, first: first, iterations: iterations)
    }
}
