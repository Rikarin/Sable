module UIntTests

// UInt (Sable.Core): its limits, and the numeric protocols' operations at
// its width, at the limits. Run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

@test
fn theLimitsAreTheWidthsBounds() {
    assertEqual(UInt.min, 0)
    assertEqual(UInt.max, (UInt.max - 0))
    assertEqual(UInt.zero, 0)
    assertEqual(UInt.one, 1)
    assertEqual(UInt.bitWidth, 64)
    assert(!UInt.isSigned, "UInt is unsigned")
}

@test
fn theLimitsPrintInDecimal() {
    assertEqual(UInt.min.toString(), "0")
    assertEqual(UInt.max.toString(), "18446744073709551615")
}

@test
fn addingPastTheGreatestValueWrapsSaturatesOrReportsIt() {
    assertEqual(UInt.max.wrappingAdd(1), UInt.min)
    assertEqual(UInt.max.saturatingAdd(1), UInt.max)
    assert(UInt.max.checkedAdd(1) == none, "the sum does not fit")
    let (sum, overflowed) = UInt.max.overflowingAdd(1)
    assertEqual(sum, UInt.min)
    assert(overflowed, "the sum overflowed")
}

@test
fn subtractingPastTheLeastValueWrapsSaturatesOrReportsIt() {
    assertEqual(UInt.min.wrappingSub(1), UInt.max)
    assertEqual(UInt.min.saturatingSub(1), UInt.min)
    assert(UInt.min.checkedSub(1) == none, "the difference does not fit")
    let (difference, overflowed) = UInt.min.overflowingSub(1)
    assertEqual(difference, UInt.max)
    assert(overflowed, "the difference overflowed")
}

@test
fn multiplyingPastTheLimitsWrapsSaturatesOrReportsIt() {
    assertEqual(UInt.max.wrappingMul(2), UInt.max - 1)
    assertEqual(UInt.max.saturatingMul(2), UInt.max)
    assert(UInt.max.checkedMul(2) == none, "the product does not fit")
    let (product, overflowed) = UInt.max.overflowingMul(2)
    assertEqual(product, UInt.max - 1)
    assert(overflowed, "the product overflowed")
    let (high, low) = UInt.max.multipliedFullWidth(by: UInt.max)
    assertEqual(high, (UInt.max - 1))
    assertEqual(low, 1)
}

@test
fn theBitCountsSeeEveryBit() {
    assertEqual(UInt.zero.leadingZeroCount, 64)
    assertEqual(UInt.zero.trailingZeroCount, 64)
    assertEqual(UInt.one.leadingZeroCount, 63)
    assertEqual(UInt.max.popCount, 64)
    assertEqual(UInt((UInt.max - 9223372036854775807)).trailingZeroCount, 63)
    assertEqual(UInt.max.leadingOneCount, 64)
    assertEqual(UInt.max.trailingOneCount, 64)
}

@test
fn rotationsAndSwapsWorkAtTheWidth() {
    assertEqual(UInt.one.rotatedLeft(by: 64), 1)
    assertEqual(UInt.one.rotatedRight(by: 1), (UInt.max - 9223372036854775807))
    assertEqual(UInt.one.rotatedLeft(by: -1), (UInt.max - 9223372036854775807))
    assertEqual(UInt.one.bitReversed, (UInt.max - 9223372036854775807))
    assertEqual(UInt(72623859790382856).byteSwapped, 578437695752307201)
    assertEqual(UInt(72623859790382856).bigEndianBytes().count, 8)
    assertEqual(UInt.fromBigEndianBytes(UInt.max.bigEndianBytes()) ?? 0, UInt.max)
    assertEqual(UInt.fromLittleEndianBytes(UInt.min.littleEndianBytes()) ?? 1, UInt.min)
}

@test
fn conversionsStopAtTheLimits() {
    assert(UInt.exactly(U128.max) == none, "only a U128 holds U128's greatest value")
    assert(UInt.exactly(I128.min) == none, "only an I128 holds I128's least value")
    assertEqual(UInt.clamping(U128.max), UInt.max)
    assertEqual(UInt.clamping(I128.min), UInt.min)
    assertEqual(UInt.truncating(U128.max), UInt.max)
    assertEqual(UInt.exactly(UInt.max) ?? 0, UInt.max)
}

@test
fn theRemainderOfTheLeastValueByMinusOneIsZero() {
    assertEqual(UInt.max.wrappingDiv(UInt.max), 1)
    assertEqual(UInt.max.wrappingRem(2), 1)
    assert(UInt.max.checkedDiv(0) == none, "there is no quotient by zero")
}

@test(traps: "integer overflow")
fn addingPastTheGreatestValueTraps() {
    var x = UInt.max
    x = x + 1
    assertEqual(x, 0)
}

@test(traps: "integer overflow")
fn subtractingPastTheLeastValueTraps() {
    var x = UInt.min
    x = x - 1
    assertEqual(x, 0)
}

@test
fn negatingAnUnsignedValueWrapsOrSaturates() {
    assertEqual(UInt.one.wrappingNeg(), UInt.max)
    assertEqual(UInt.one.saturatingNeg(), 0)
    assert(UInt.one.checkedNeg() == none, "an unsigned type has no -1")
    assertEqual(UInt.zero.checkedNeg() ?? 1, 0)
    assertEqual(UInt.max.abs(), UInt.max)
}
