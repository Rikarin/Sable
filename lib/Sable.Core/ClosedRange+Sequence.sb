module Sable.Core

// A closed range of integers is a sequence of them. A 'for' over one counts
// and makes no iterator; this is what generic code sees of it.

/// Gives a closed range's integers, from its lower bound up to and
/// including its upper. It stops before stepping past the upper bound, so a
/// range up to 'Int.max' does not overflow.
public struct ClosedRangeIterator: Iterator {
    var upcoming: Int
    let last: Int
    var done: Bool

    /// The next integer, or none once the upper bound has been given.
    public mutating fn next() -> Int? {
        if done || last < upcoming {
            return none
        }
        let value = upcoming
        if value == last {
            done = true
        } else {
            upcoming += 1
        }
        return value
    }
}

extension ClosedRange: Sequence where Bound == Int {
    /// An iterator from the lower bound.
    public fn makeIterator() -> ClosedRangeIterator {
        return ClosedRangeIterator { upcoming: lowerBound, last: upperBound, done: false }
    }
}
