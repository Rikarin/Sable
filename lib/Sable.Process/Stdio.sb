module Sable.Process

import Sable.IO

/// What one of a child's standard streams is: Rust's `Stdio`.
public union Stdio {
    /// This program's own.
    Inherit
    /// Nothing: at its end to read, and taking all that is written.
    Null
    /// A pipe to this program: the Child's `stdin`, `stdout` or `stderr`.
    Piped
    /// The file: read from its start, or made and emptied to be written.
    /// Output and errors to one file are written to it in order.
    File(path: String)
    /// An end of an operating system pipe (`OsPipe.toChild`, `fromChild`,
    /// `betweenChildren`): the child has a copy of it, and this program
    /// closes its own once the child is started, or the pipe's other end
    /// never reads to its end.
    Pipe(end: PipeEnd)

    // platform.h's STDIO_ kinds; a pipe's end is one, its handle the path.
    var isPipe: Bool {
        get {
            return match self {
                case .Pipe(_) => true
                case _        => false
            }
        }
    }

    // platform.h's STDIO_ kinds.
    var kind: Int {
        get {
            return match self {
                case .Inherit => 0
                case .Null    => 1
                case .Piped   => 2
                case .File(_) => 3
                case .Pipe(_) => 3
            }
        }
    }

    var path: String {
        get {
            return match self {
                case .File(let path) => path
                case .Pipe(let end)  => "\(end.handle)"
                case _               => ""
            }
        }
    }
}
