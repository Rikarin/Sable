module Sable.Net.Tls

import Sable.Crypto
import Sable.Crypto.X509
import Sable.Time

/// How a client connects: whom it trusts, which application protocols it
/// offers (ALPN, RFC 7301) and which suites, and the certificate it sends a
/// server that asks for one. The defaults need no changing: the system's
/// trusted certificates, every suite the library has, and no certificate.
///
/// ```sable
/// var options = TlsClientOptions()
/// options.applicationProtocols = ["h2", "http/1.1"]
/// assert(options.cipherSuites.count == 3)
/// ```
public struct TlsClientOptions: Sendable {
    /// Whose certificates are believed.
    public var trust: TlsServerTrust

    /// The application protocols offered, the one preferred first.
    public var applicationProtocols: String[>..] = []

    /// The suites offered, the one preferred first.
    public var cipherSuites: TlsCipherSuite[>..] = TlsCipherSuite.all

    /// The time certificates are checked at, and sessions' tickets had and
    /// aged at; none is the system's now.
    public var time: UtcDateTime? = none

    /// Where sessions of each host are kept, to resume a connection with
    /// the next time; none for a client that resumes none.
    public var sessionCache: TlsSessionCache? = none

    /// The certificates sent a server that asks for one, the client's own
    /// first; none sends an empty Certificate.
    public var certificateChain: Certificate[>..] = []

    /// The key of the first certificate, which signs the CertificateVerify.
    public var privateKey: PrivateKey? = none

    public init(trust: TlsServerTrust = TlsServerTrust.system()) {
        self.trust = trust
    }
}
