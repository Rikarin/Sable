module IoErrorTests

// IoError (Sable.IO), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.IO

import Sable.IO
import Sable.Testing

fn isAnError<T>(_ value: T) -> Bool where T: Error {
    return true
}

fn failToRead(_ path: String) throws {
    throw IoError.NotFound(path: path)
}

@test
fn anIoErrorIsAnError() {
    expect(isAnError(IoError.NotFound(path: "a.txt")))
}

@test
fn aBareThrowsCarriesAnIoError() {
    let error = expectThrows(IoError.self) { try failToRead("missing.txt") }
    if case .Some(.NotFound(let path)) = error {
        expect(path == "missing.txt")
    } else {
        fail("\(error:?) was thrown")
    }
}

let descriptions: (IoError, String)[>..] = [
    (.NotFound(path: "a"), "nothing is at 'a'"),
    (.Failed(path: "a"), "'a' could not be read, written or changed"),
    (.Unreachable(address: "h:1"), "'h:1' could not be reached"),
    (.ConnectionRefused(address: "h:1"), "'h:1' refused the connection"),
    (.AddressInUse(address: "h:1"), "'h:1' is in use"),
    (.HostNotFound(host: "h"), "'h' has no address"),
    (.TimedOut, "it took too long"),
    (.MessageTooLong, "the message is too long"),
    (.Unsupported(what: "it"), "'it' is not supported here"),
    (.Disconnected, "the connection failed or was closed"),
    (.Cancelled, "the task was cancelled while it waited"),
    (.PermissionDenied(path: "a"), "'a' may not be used so"),
    (.AlreadyExists(path: "a"), "something is at 'a' already"),
    (.IsDirectory(path: "a"), "'a' is a directory"),
    (.Interrupted, "the call was interrupted"),
    (.UnexpectedEof, "the stream ended before what was needed"),
    (.InvalidInput(path: "a"), "'a' was given something the system does not take"),
    (.DirectoryNotEmpty(path: "a"), "'a' is not empty"),
    (.NotADirectory(path: "a"), "'a' is not a directory"),
    (.CrossesFileSystems(path: "a"), "'a' is on another file system"),
    (.Os(path: "a", code: 5), "'a' failed with the system's error 5"),
]

@test(arguments: descriptions)
fn eachIoErrorSaysWhatWentWrong(_ error: IoError, _ text: String) {
    expect(error.description() == text)
}
