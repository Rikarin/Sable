}

@test
fn broadcast4Minus() {
    expectTensor(arange([2, 1, 3]) - arange([4, 1], from: 10), [2, 4, 3], [-10, -9, -8, -11, -10, -9, -12, -11, -10, -13, -12, -11, -7, -6, -5, -8, -7, -6, -9, -8, -7, -10, -9, -8])
