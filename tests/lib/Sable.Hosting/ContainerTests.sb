module HostContainerTests

import Sable.Concurrency
import Sable.DependencyInjection
import Sable.Diagnostics
import Sable.Hosting
import Sable.Testing

// A service that says what loggers it was given, as it is made.
@immutable
@injectable(.Transient)
final class Orders: HostedService {
    init(log: Logger.Of<Orders>, root: Logger, ledger: Ledger) {
        ledger.add("\(log.logger.name == "\(Orders.self)") \(root.name) \(log.isEnabled(Level.Info)) \(log.isEnabled(Level.Trace))")
    }
    async fn run(cancellation: CancellationToken) throws { }
}

@test
fn aHostsContainerGivesLoggersOfItsLogging() throws {
    let ledger = Ledger()
    let builder = ApplicationBuilder()
    builder.logging = HostLogging(minimumLevel: Level.Warning)
    builder.container.addSingleton(Ledger.self) { _services in ledger }
    builder.services.add("orders", Orders.self)
    _ = try builder.build()
    expect(ledger.all == "true app false false disposed")
}

@test
fn aHostsLoggersAreThoseOfTheContainersLoggerWhereItHasOne() throws {
    let ledger = Ledger()
    let builder = ApplicationBuilder()
    builder.container.addSingleton(Ledger.self) { _services in ledger }
    builder.container.addTransient(Logger.self) { _services in
        let mine = Logger("mine")
        mine.threshold = Level.Trace
        return mine
    }
    builder.services.add("orders", Orders.self)
    _ = try builder.build()
    expect(ledger.all == "true mine true true disposed")
}

@immutable
@injectable(.Singleton)
final class Ledger: Disposable {
    let lines: Mutex<String[>..]> = Mutex([])
    init() { }
    fn add(_ line: String) {
        lines.withLock { $0.append(line) }
    }
    fn dispose() { add("disposed") }
    var all: String => lines.withLock { $0.joined(separator: " ") }
}

@immutable
@injectable(.Singleton)
final class Worker: HostedService {
    let ledger: Ledger
    let lifetime: ApplicationLifetime
    let name: String
    init(ledger: Ledger, lifetime: ApplicationLifetime, environment: HostEnvironment, @keyed("name") name: String) {
        self.ledger = ledger
        self.lifetime = lifetime
        self.name = environment.name.isEmpty ? "nowhere" : name
    }
    async fn run(cancellation: CancellationToken) throws {
        ledger.add("\(name) ran")
        lifetime.requestStop()
    }
}

fn builder(_ ledger: Ledger) -> ApplicationBuilder {
    let builder = ApplicationBuilder()
    builder.container.addSingleton(Ledger.self) { _services in ledger }
    builder.services.add("worker", Worker.self)
    return builder
}

@test
async fn aServiceIsMadeByTheContainer() {
    let ledger = Ledger()
    let builder = builder(ledger)
    builder.container.addSingleton(String.self, key: "name", value: "worker")
    let host = try! builder.build()
    try! await host.run()
    assertEqual(ledger.all, "worker ran disposed")
}

@test
async fn whatMustBeWaitedForIs() {
    let ledger = Ledger()
    let builder = builder(ledger)
    builder.container.addSingleton(String.self, key: "name") { _services in
        await Task.yield()
        return "late"
    }
    expectThrows(saying: "String (\"name\") must be waited for: 'buildAsync' builds them") { _ = try builder.build() }
    let host = try! await builder.buildAsync()
    try! await host.run()
    assertEqual(ledger.all, "late ran disposed")
}
