module Sable.Math

// Integer functions beyond the operators, of Int: square root, factorial,
// binomial coefficients and modular arithmetic. Each is exact, and each
// traps where its result does not fit in an Int, as '*' does. A function
// defined for non-negative numbers alone takes its argument as a UInt,
// whose conversion traps for a negative one.

/// The integer square root: the largest r with r * r <= n. A negative n traps.
///
/// ```sable
/// assert(isqrt(99) == 9)
/// assert(isqrt(100) == 10)
/// ```
public fn isqrt(_ n: Int) -> Int {
    let unsigned = UInt(n)
    if unsigned < 2 {
        return n
    }

    // F64's square root is within one of the answer for every Int (an F64
    // holds 53 bits of n, and the root of the error is below one), so at
    // most a step each way puts it right. r <= n / r is r * r <= n
    // without the overflow r * r can have.
    var r = Int(F64(n).squareRoot())
    while r > n / r {
        r = r - 1
    }
    while r + 1 <= n / (r + 1) {
        r = r + 1
    }
    return r
}

/// n!, the product of 1 through n: 1 for 0, and a trap past 20!, the
/// largest an Int holds. A negative n traps.
public fn factorial(_ n: Int) -> Int {
    let count = UInt(n)
    var product = 1
    var i: UInt = 2
    while i <= count {
        product = product * Int(i)
        i = i + 1
    }
    return product
}

/// The binomial coefficient "n choose k": how many k-element subsets an
/// n-element set has, 0 when k is not in 0...n. Traps when the result does
/// not fit in an Int; one that fits is computed without overflowing on
/// the way, by keeping each partial product C(n - k + i, i) exact.
///
/// ```sable
/// assert(binomial(5, 2) == 10)
/// assert(binomial(62, 31) == 465428353255261088)
/// ```
public fn binomial(_ n: Int, _ k: Int) -> Int {
    if k < 0 || k > n {
        return 0
    }

    // C(n, k) = C(n, n - k): the smaller makes fewer steps.
    let smaller = k < n - k ? k : n - k
    var result = 1
    var i = 1
    while i <= smaller {
        // result * (n - smaller + i) / i, exactly: dividing what i has in
        // common with result out first leaves a divisor of the other factor.
        let common = gcd(result, i)
        result = result / common * ((n - smaller + i) / (i / common))
        i = i + 1
    }
    return result
}

/// base to the power exponent, modulo modulus: in [0, modulus), however
/// large the power, with each product taken in 128 bits so that none
/// overflows. A negative exponent or modulus traps, and so does a modulus
/// of 0, as '%' by zero does.
///
/// ```sable
/// assert(powMod(4, 13, 497) == 445)
/// ```
public fn powMod(_ base: Int, _ exponent: Int, _ modulus: Int) -> Int {
    let m = I128(UInt(modulus))
    var e = UInt(exponent)
    var b = (I128(base) % m + m) % m
    var result = I128(1) % m
    while e > 0 {
        if e % 2 == 1 {
            result = result * b % m
        }
        e = e / 2
        b = b * b % m
    }
    return Int(result)
}

/// The inverse of a modulo modulus: the x in [0, modulus) with a * x % modulus
/// equal to 1 % modulus, or none when a and modulus have a common factor and
/// there is no such x. A negative modulus traps, and so does a modulus of 0.
///
/// ```sable
/// assert(modInverse(3, 11) == 4)
/// assert(modInverse(2, 4) == none)
/// ```
public fn modInverse(_ a: Int, _ modulus: Int) -> Int? {
    let m = I128(UInt(modulus))

    // The extended Euclidean algorithm, keeping only a's coefficient: each
    // step keeps r = a * t (mod m). Every |t| stays at most m, so in 128
    // bits no step overflows, whatever the modulus.
    var r0 = (I128(a) % m + m) % m
    var r1 = m
    var t0 = I128(1)
    var t1 = I128(0)
    while r1 != 0 {
        let q = r0 / r1
        let r = r0 - q * r1
        r0 = r1
        r1 = r
        let t = t0 - q * t1
        t0 = t1
        t1 = t
    }
    if r0 != 1 && m != 1 {
        return none
    }
    return Int((t0 % m + m) % m)
}
