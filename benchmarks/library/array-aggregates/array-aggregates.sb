module ArrayAggregatesBench

// The sum, the least and the greatest of arrays of 8-, 32- and 64-bit
// integers: over 64 Ki elements, and over 24.

fn work(_ words: I32[:], _ longs: Int[:], _ bytes: U8[:], _ rounds: Int) -> Int {
    var total = 0
    for round in 0..<rounds {
        total += Int(words.sum()) + longs.sum()
        total += Int(words.min()!) + Int(words.max()!)
        total += longs.min()! + longs.max()!
        total += Int(bytes.min()!) + Int(bytes.max()!) + round
    }
    return total
}

@main
fn main() {
    var words: I32[>..] = []
    var longs: Int[>..] = []
    var bytes: U8[>..] = []
    for i in 0..<65536 {
        words.append(I32(i * 7919 % 4001) - 2000)
        longs.append(i * 104729 % 400001 - 200000)
        bytes.append(U8(i * 31 % 241 + 5))
    }
    print(work(words, longs, bytes, 1000) + work(words[..<24], longs[..<24], bytes[..<24], 200000))
}
