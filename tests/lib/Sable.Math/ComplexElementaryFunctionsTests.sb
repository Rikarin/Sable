        (1.0, 9.999999747378752e-06, 4.9999997198124646e-11, 9.999999747378752e-06),
        (0.2800000011920929, 0.9599999785423279, -2.0265579436795633e-08, 1.2870022058486938),
        (9.99994610111476e-41, 9.99994610111476e-41, -91.7568359375, 0.7853981852531433),
        (9.999999680285692e+37, 9.999999680285692e+37, 87.84481048583984, 0.7853981852531433),
        (-3.0, 9.999999350456404e-39, 1.0986123085021973, 3.1415927410125732),
    ]
    for (x, y, re, im) in cases {
