module CapturedExpressionTests

// What a failed expectation says of its expression (Sable.Testing), tested
// with '@test': run with
//     tools/stdlib-coverage.sh Sable.Testing

import Sable.Testing

fn captured(_ value: Bool, _ expression: CapturedExpression = #expression) -> CapturedExpression {
    return expression
}

fn told(_ expression: CapturedExpression) -> String {
    return expression.parts.map({ "\($0.0) = \($0.1)" }).joined(separator: "; ")
}

struct Point {
    var x: Int
    var y: Int
}

@test
fn theTextIsTheExpressionsOnOneLine() {
    let a = 1
    assertEqualText(captured(a == 1).text, "a == 1")
    assertEqualText(captured(a == 1
        && a > 0).text, "a == 1 && a > 0")
    assertEqualText(CapturedExpression.begin().text, "")
    assertEqual(CapturedExpression.begin().parts.count, 0)
}

@test
fn thePartsAreTheValuesInIt() {
    let point = Point(x: 3, y: 4)
    let names = ["a", "b"]
    assertEqualText(told(captured(point.x + 1 == point.y)), "point = Point(x: 3, y: 4); point.x = 3; point.x + 1 = 4; point.y = 4")
    assertEqualText(told(captured(names[0] == "a" && !names.isEmpty)),
        "names = [\"a\", \"b\"]; names[0] = \"a\"; names[0] == \"a\" = true; names.isEmpty = false; !names.isEmpty = true")
}

@test
fn whatIsNotWorkedOutIsNotTold() {
    let n = 0
    assertEqualText(told(captured(n != 0 && 10 / n > 1)), "n = 0; n != 0 = false")
}

// How a failure shows them is in HarnessTests.sb.
@test
fn aValueThatReadsTheSameIsToldOnce() {
    let nan = F64.nan
    assertEqualText(told(captured(nan == nan)), "")
}

struct Pinned {
    var point: Point&
    var count: Int
}

// A value holding a reference into a region is not kept beside the
// expression, whose capture may outlive the region: what it reaches is.
@test
fn aValueHoldingAReferenceIsNotNoted() {
    region a {
        let p = a.alloc(Point(x: 3, y: 4))
        let pinned = Pinned(point: p, count: 2)
        assertEqualText(told(captured(pinned.count == 2 && pinned.point.x == 3)),
            "pinned.count = 2; pinned.count == 2 = true; pinned.point.x = 3; pinned.point.x == 3 = true")
    }
}
