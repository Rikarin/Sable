module DeterminismTests

// What is made of +, -, *, / and the square root alone is the same bits on
// every processor, at every level of optimisation and in the interpreter,
// which docs/06 promises ("Geometry"): here are the bits. What calls the
// platform's sine or tangent is not among it, so the rotations here are
// given by their components.

import Sable.Math.Geometry
import Sable.Testing

/// The values' bits, folded into one number.
fn fold<T: FloatComponents>(_ value: T, _ into: U32) -> U32 {
    var all = into
    for component in value.toArray() {
        all = (all ^ component.bits) &* 16777619
    }
    return all
}

@test
fn arithmeticIsTheSameBitsEverywhere() {
    var hash: U32 = 2166136261
    var q = Quaternion(0.1, -0.2, 0.3, 0.9).normalized()
    let r = Quaternion(-0.4, 0.1, 0.05, 0.8).normalized()
    var v = Vector3(0.3, 1.7, -2.9)
    var m = Matrix4x4(scale: Vector3(1.1, 0.9, 1.3), rotation: q, translation: v)
    let view = Matrix4x4.lookAt(eye: Vector3(3, 4, 5), target: Vector3(0.1, 0.2, 0.3), up: Vector3.up)
    let projection = Matrix4x4.perspective(width: 1.6, height: 0.9, near: 0.3, far: 77)
    for step in 0..<64 {
        let t = F32(step) / 63
        q = (q * r).normalized()
        v = q.transform(v).normalized() * (1 + t) + r.transform(Vector3.one)
        let blended = q.slerp(to: r, t)
        m = Matrix4x4(scale: Vector3(1 + t, 1.3, 0.7), rotation: blended, translation: v) * view * projection
        hash = fold(q, hash)
        hash = fold(v, hash)
        hash = fold(blended, hash)
        hash = fold(q.nlerp(to: r, t), hash)
        hash = fold(m, hash)
        hash = fold(m.inverted() ?? Matrix4x4.zero, hash)
        hash = fold(Plane(v, t).transformed(by: view), hash)
        hash = fold(view.transformPosition(v), hash)
        hash = fold(m.normalMatrix, hash)
        if let parts = (Matrix4x4(rotation: q) * Matrix4x4(scale: Vector3(1, 2, 3))).decomposed() {
            hash = fold(parts.rotation, hash)
        }
        var points = [v, v * 0.3, v * 0.7, v * 1.9, v * 2.3]
        view.transformPositions(&points)
        for point in points {
            hash = fold(point, hash)
        }
        let frustum = BoundingFrustum(m)
        hash = fold(frustum.near, hash)
        hash = fold(frustum.left, hash)
        if let distance = Ray(v * 9, -v).intersection(with: BoundingSphere(Vector3.zero, 1.5)) {
            hash = fold(Vector2(distance, t), hash)
        }
    }
    assertEqual(hash, 1271229224)
}
