module SpawnAwait

import Sable.Testing

// Spawn/await throughput: a million tasks that each give a number, spawned
// in batches of ten thousand and awaited in order — once from the program's
// own task, on the main thread, and once from a task on the pool.

fn run() async -> String {
    var total = 0
    for batch in 0..<100 {
        var tasks: Task<Int>[>..] = []
        for i in 0..<10_000 {
            tasks.append(Task.spawn { i + batch })
        }
        for task in tasks {
            total += await task.value
        }
    }
    return "\(total)"
}

// A task's time.
@bench
fn fromMain(_ b: Bencher) async {
    b.operationsPerIteration = 1_000_000
    b.check(await b.iterateAsync { await run() })
}

@bench
fn inATask(_ b: Bencher) async {
    b.operationsPerIteration = 1_000_000
    b.check(await b.iterateAsync { await Task.spawn { await run() }.value })
}
