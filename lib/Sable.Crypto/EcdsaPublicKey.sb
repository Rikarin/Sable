module Sable.Crypto

import Sable.Text

/// An ECDSA key of a NIST curve to check signatures with: a point of the
/// curve, checked to be one when the key is made.
///
/// ```sable
/// let key = EcdsaPrivateKey<P384>.generate()
/// let received = try! EcdsaPublicKey<P384>(key.publicKey.bytes)
/// assert(received.isValid(key.sign([1, 2, 3]), for: [1, 2, 3]))
/// ```
@derive(Equatable, Hashable)
public struct EcdsaPublicKey<Curve: EllipticCurve>: Hashable, Debug, Sendable {
    /// The point, uncompressed: a byte 4, x and y.
    public let bytes: U8[>..]

    /// The key those bytes are, uncompressed or compressed (SEC 1 §2.3.4),
    /// if they are a point of the curve and not infinity.
    ///
    /// ```sable
    /// let key = EcdsaPrivateKey<P256>.generate().publicKey
    /// assert(try! EcdsaPublicKey<P256>(key.compressed) == key)
    /// ```
    public init(_ bytes: U8[:]) throws(CryptoError) {
        guard let point = Curve.curve.decode(bytes) else {
            throw CryptoError.InvalidKey(reason: "a public key that is no point of \(Curve.curve)")
        }
        self.bytes = point
    }

    init(checked bytes: consuming U8[>..]) {
        self.bytes = bytes
    }

    /// The point, compressed: a byte 2, or 3 where y is odd, and x.
    public var compressed: U8[>..] {
        get {
            var made: U8[>..] = [2 | (bytes[bytes.count - 1] & 1)]
            made.append(contentsOf: bytes[1..<Curve.curve.byteCount + 1])
            return made
        }
    }

    /// Whether it is this key's signature of the message: of its digest, by
    /// the function the curve is usually used with unless another is given.
    public fn isValid(_ signature: EcdsaSignature<Curve>, for message: U8[:], hash: HashAlgorithm = Curve.curve.hash) -> Bool {
        return self.isValid(signature, digest: hash.hash(message).bytes)
    }

    /// Whether it is this key's signature of a message's digest.
    ///
    /// ```sable
    /// let key = EcdsaPrivateKey<P256>.generate()
    /// let digest = Sha256.hash(utf8: "abc").bytes
    /// assert(key.publicKey.isValid(key.sign(digest: digest), digest: digest))
    /// ```
    public fn isValid(_ signature: EcdsaSignature<Curve>, digest value: U8[:]) -> Bool {
        return Curve.curve.isValid(signature.bytes, digest: value, point: bytes)
    }

    /// The type and the key in hexadecimal.
    public fn debugDescription() -> String {
        return "EcdsaPublicKey<\(Curve.curve)>(" + Hex.encode(bytes) + ")"
    }
}
