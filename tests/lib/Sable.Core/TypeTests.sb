module TypeTests

// Type (Sable.Core), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

struct Point {
    var x: Int
    var name: String
}

class Box {
    var value: Int = 0
}

union Tag {
    Label(String)
    Empty
}

@noncopy
struct Unique {
    var id: Int
}

@test
fn anIntsMetadataSaysItsLayout() {
    let m: Type = Int.self
    assertEqual(m.name, "Int")
    assertEqual(m.size, 8)
    assertEqual(m.alignment, 8)
    assertEqual(m.stride, 8)
    expect(m.isTrivial)
    expect(!m.isNoncopyable)
}

@test(arguments: [
    (Box.self, .Class), (Point.self, .Struct), (Tag.self, .Union), (Int?.self, .Optional),
    ((Int, Bool).self, .Tuple), (((Int) -> Int).self, .Function), (Int[>..].self, .Array), (String.self, .String),
    (Type.self, .Metatype), (Bool.self, .Scalar)
])
fn eachKindIsReported(_ type: Type, _ kind: TypeKind) {
    expect(type.kind == kind)
}

@test
fn aStructsFieldsAreItsStoredFieldsInOrder() {
    let m: Type = Point.self
    assertEqual(m.fieldCount, 2)
    assertEqual(m.fieldName(at: 0), "x")
    assertEqual(m.fieldOffset(at: 0), 0)
    expect(m.fieldType(at: 0) == Int.self)
    assertEqual(m.fieldName(at: 1), "name")
    assertEqual(m.fieldOffset(at: 1), 8)
    expect(m.fieldType(at: 1) == String.self)
}

@test
fn anOptionalsArgumentIsTheWrappedType() {
    let m: Type = String?.self
    assertEqual(m.argumentCount, 1)
    expect(m.argument(at: 0) == String.self)
    expect(!m.isTrivial)
}

@test
fn aTypeIsEqualOnlyToItself() {
    let p: Type = Point.self
    expect(p == Point.self)
    expect(p != Box.self)
    expect(p != Point?.self)
}

@test
fn aTypeIsWrittenAsItsName() {
    let t: Type = Int?.self
    assertEqual("\(t)", "Int?")
    assertEqual("\(String.self)", "String")
    assertEqual("[\(Int.self:>5)]", "[  Int]")
    assertEqual("\(t:?)", "Int?")
}

@test
fn equalTypesHashAlike() {
    let a: Type = Point.self
    let b: Type = Point.self
    assertEqual(a.hashValue, b.hashValue)
}

@test
fn aDictionaryIsKeyedByType() {
    var names: [Type: String] = [:]
    names[Int.self] = "int"
    names[Point.self] = "point"
    names[type(of: "text")] = "string"
    assertEqual(names[Int.self] ?? "", "int")
    assertEqual(names[String.self] ?? "", "string")
    assertEqual(names[Point.self] ?? "", "point")
    expect(names[Box.self] == none)
    assertEqual(names.count, 3)
}

class Animal { }

class Dog: Animal { }

protocol Pet { }

extension Dog: Pet { }

@test
fn typeOfAnObjectIsItsOwnClass() {
    let animal: Animal = Dog()
    expect(type(of: animal) == Dog.self)
    expect(type(of: animal) != Animal.self)
}

@test
fn typeOfAnExistentialIsWhatItHolds() {
    let value: any Equatable = 3
    expect(type(of: value) == Int.self)
    let pet: any Pet = Dog()
    expect(type(of: pet) == Dog.self)
}

@test
fn typeOfAnyOtherValueIsItsStaticType() {
    expect(type(of: 3) == Int.self)
    expect(type(of: Point { x: 1, name: "" }) == Point.self)
    let nothing: Int? = none
    expect(type(of: nothing) == Int?.self)
}

@test
fn aSubclassIsASubtypeOfItsSuperclass() {
    expect(Dog.self.isSubtype(of: Animal.self))
    expect(!Animal.self.isSubtype(of: Dog.self))
    expect(Dog.self.isSubtype(of: Dog.self))
}

@test
fn aConformingTypeIsASubtypeOfTheExistential() {
    expect(Dog.self.isSubtype(of: (any Pet).self))
    expect(!Animal.self.isSubtype(of: (any Pet).self))
    expect(Int.self.isSubtype(of: (any Hashable).self))
    expect(!Point.self.isSubtype(of: (any Hashable).self))
}

@test
fn isInstanceChecksAValueAgainstATypeKnownAtRunTime() {
    let animal: Animal = Dog()
    let wanted: Type[] = [Animal.self, Dog.self, (any Pet).self, Int.self]
    var found = ""
    for t in wanted {
        found += t.isInstance(animal) ? "y" : "n"
    }
    assertEqual(found, "yyyn")
    expect(Int.self.isInstance(3))
    expect(!Int.self.isInstance("3"))
}

@test
fn aMoveOnlyTypeIsNoncopyable() {
    expect(Unique.self.isNoncopyable)
    expect(!Unique.self.isTrivial)
}

@test
fn theValueWitnessesCopyMoveAssignAndDestroy() {
    let m: Type = Point.self
    let p = Point { x: 1, name: "a" + "b" }
    assertEqual(m.copy(p).name, "ab")
    assertEqual(m.move(p).x, 1)
    var target = Point { x: 2, name: "c" }
    m.assign(p, to: &target)
    assertEqual(target.name, "ab")
    m.destroyCopy(of: p)
    assertEqual(p.name, "ab")
}

// Opening a Type (spec/SYNTAX.md "Opening a type"): a Type given for a
// generic function's 'T.Type' binds T to the type it holds at run time.

protocol Unit {
    static fn unit() -> Self
    fn label() -> String
}

struct Metre: Unit {
    var count: Int
    static fn unit() -> Metre { return Metre { count: 1 } }
    fn label() -> String { return "\(count) m" }
}

struct Second: Unit {
    var count: Int
    static fn unit() -> Second { return Second { count: 1 } }
    fn label() -> String { return "\(count) s" }
}

struct Holder<T> {
    var item: T
}

fn unitOf<T: Unit>(_ type: T.Type) -> T {
    return T.unit()
}

fn nameOf<T>(_ type: T.Type) -> String {
    return "\(T.self)"
}

fn arrayTypeOf<T>(_ type: T.Type) -> Type {
    return T[].self
}

fn holderTypeOf<T>(_ type: T.Type) -> Type {
    return Holder<T>.self
}

@test
fn aTypeFromADictionaryOpensAGenericFunction() {
    let units: [String: Type] = ["length": Metre.self, "time": Second.self]
    assertEqual(unitOf(units["length"]!).label(), "1 m")
    assertEqual(unitOf(units["time"]!).label(), "1 s")
}

@test
fn anExistentialsDynamicTypeOpensAsItsOwnType() {
    let held: any Unit = Second { count: 5 }
    let made = unitOf(type(of: held))
    expect(type(of: made) == Second.self)
    assertEqual(nameOf(type(of: held)), "TypeTests.Second")
}

@test
fn aGenericTypeIsMadeForATypeKnownAtRunTime() {
    let t: Type = Metre.self
    expect(arrayTypeOf(t) == Metre[].self)
    expect(holderTypeOf(t) == Holder<Metre>.self)
    assertEqual(holderTypeOf(t).name, "TypeTests.Holder<TypeTests.Metre>")
}
