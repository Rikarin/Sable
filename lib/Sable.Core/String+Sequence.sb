module Sable.Core

/// A string's characters, one Unicode scalar at a time.
public struct StringIterator: Iterator {
    public alias Element = Char

    let text: String

    // Where the next character starts: a position only the runtime reads.
    var cursor: Int

    public mutating fn next() -> Char? {
        if cursor >= StringIterator.end(text) {
            return none
        }
        let character = StringIterator.scalar(text, cursor)
        cursor = StringIterator.after(text, cursor)
        return character
    }

    @builtin("string_cursor_end")
    static fn end(_ text: String) -> Int

    @builtin("string_cursor_scalar")
    static fn scalar(_ text: String, _ cursor: Int) -> Char

    @builtin("string_cursor_next")
    static fn after(_ text: String, _ cursor: Int) -> Int
}

extension String: Sequence {
    public alias Iter = StringIterator

    /// An iterator over the characters, from the first.
    public fn makeIterator() -> StringIterator {
        return StringIterator { text: self, cursor: 0 }
    }
}

/// A string is a bidirectional collection of its characters, by its
/// String.Index, a byte offset (String+Index.sb): generic code over a
/// Collection walks it without counting from the start each time. It is
/// not random-access, as Swift's is not: reaching the nth character
/// means passing the n before it.
///
/// ```sable
/// fn lastOf<C: BidirectionalCollection>(_ c: C) -> C.Element? {
///     return c.isEmpty ? none : c[c.index(before: c.endIndex)]
/// }
/// assert(lastOf("añb") == 'b')
/// ```
extension String: BidirectionalCollection { }

extension String: FromSequence<Char> {
    /// The characters, one after another, as a string.
    public static fn from<S: Sequence>(_ characters: S) throws(S.Failure) -> String where S.Element == Char {
        var parts: String[>..] = []
        for try character in characters {
            parts.append(String.fromChar(character))
        }
        return Runtime.joinStrings(parts, "")
    }
}
