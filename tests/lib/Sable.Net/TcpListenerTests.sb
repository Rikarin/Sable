module TcpListenerTests

// TcpListener (Sable.Net), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Net

import Sable.IO
import Sable.Net
import Sable.Testing
import Sable.Time

/// Bytes as text, to compare.
fn text(_ bytes: U8[>..]) -> String {
    var said = ""
    for b in bytes {
        said += "\(b) "
    }
    return said
}

@test
fn aListenerOnPortZeroIsGivenAFreePort() throws {
    let listener = try TcpListener.bind(SocketAddress(.v4Loopback, port: 0))
    expect(listener.port > 0)
}

@test
fn listeningOnAnAddressThatIsNotOursThrows() {
    var thrown = ""
    do {
        _ = try TcpListener.bind(SocketAddress(IpAddress(192, 0, 2, 1), port: 0))
    } catch {
        thrown = error.description()
    }
    assertEqual(thrown, "'192.0.2.1:0' could not be reached")
}

@test
fn aListenerAcceptsAConnection() async throws {
    let listener = try TcpListener.bind(SocketAddress(.v4Loopback, port: 0))
    let port = listener.port
    let client = Task.spawn { try? await TcpStream.connect(host: "127.0.0.1", port: port) }
    let accepted = try await listener.accept()
    try await accepted.write([7])
    accepted.close()
    if let stream = await client.value {
        assertEqual(text(try await stream.readAll()), text([7]))
    } else {
        fail("the client did not connect")
    }
}

@test
fn closingAListenerWakesItsAccept() async throws {
    let listener = try TcpListener.bind(SocketAddress(.v4Loopback, port: 0))
    let waiting = Task.spawn { () -> String in
        do {
            _ = try await listener.accept()
            return "accepted"
        } catch {
            return error.description()
        }
    }
    await Task.yield()
    listener.close()
    assertEqual(await waiting.value, "the connection failed or was closed")
}

@test
fn cancellingATaskWakesItsAccept() async throws {
    let listener = try TcpListener.bind(SocketAddress(.v4Loopback, port: 0))
    let waiting = Task.spawn { () -> String in
        do {
            _ = try await listener.accept()
            return "accepted"
        } catch {
            return error.description()
        }
    }
    await Task.yield()
    waiting.cancel()
    assertEqual(await waiting.value, "the task was cancelled while it waited")
}

/// What the body throws; "" for nothing.
fn thrown(_ body: async () throws(IoError) -> ()) async -> String {
    do {
        try await body()
        return ""
    } catch {
        return error.description()
    }
}

@test
fn aPortInUseIsSaidToBe() async throws {
    let first = try TcpListener.bind(SocketAddress(.v4Loopback, port: 0))
    let address = first.localAddress
    assertEqual(await thrown {
        _ = try TcpListener.bind(address)
    }, "'\(address)' is in use")
    first.close()
    _ = try TcpListener.bind(address)
}

@test
fn aPortIsFreeAgainThoughItsConnectionsStillClose() async throws {
    let first = try TcpListener.bind(SocketAddress(.v4Loopback, port: 0))
    let address = first.localAddress
    let client = try await TcpStream.connect(address)
    let server = try await first.accept()
    // The end that closes first is the one that waits (TIME_WAIT).
    server.close()
    assertEqual((try await client.readAll()).count, 0)
    client.close()
    first.close()
    let again = try TcpListener.bind(address)
    assertEqual(again.port, address.port)
}

// Windows has no such sharing.
#if os(windows)
@test
fn noListenersShareAPort() async {
    assertEqual(await thrown {
        _ = try TcpListener.bind(SocketAddress(.v4Loopback, port: 0), sharePort: true)
    }, "'127.0.0.1:0' is not supported here")
}

#else
@test
fn severalListenersShareAPortThatAllSayTheyShare() throws {
    let first = try TcpListener.bind(SocketAddress(.v4Loopback, port: 0), sharePort: true)
    let second = try TcpListener.bind(first.localAddress, sharePort: true)
    assertEqual(first.port, second.port)
}

#endif

@test
fn anIpv6ListenerTakesIpv6AloneUnlessTold() async throws {
    let six = try TcpListener.bind(SocketAddress(.v6Any, port: 0))
    // The port is free for IPv4: another may listen on it there.
    let four = try TcpListener.bind(SocketAddress(.v4Loopback, port: six.port))
    four.close()
    let port = six.port
    assert((await thrown {
        _ = try await TcpStream.connect(SocketAddress(.v4Loopback, port: port))
    }) != "")
    _ = try await TcpStream.connect(SocketAddress(.v6Loopback, port: port))

    let both = try TcpListener.bind(SocketAddress(.v6Any, port: 0), dualStack: true)
    let client = try await TcpStream.connect(SocketAddress(.v4Loopback, port: both.port))
    let accepted = try await both.accept()
    expect(accepted.peerAddress!.ip.isV4Mapped)
    expect(accepted.peerAddress!.ip.isLoopback)
    assertEqual(accepted.peerAddress!.ip.canonical, client.localAddress!.ip)
}

@test
fn severalTasksAcceptAtOnce() async throws {
    let listener = try TcpListener.bind(SocketAddress(.v4Loopback, port: 0))
    let address = listener.localAddress
    var accepting: Task<Int>[>..] = []
    for _ in 0..<4 {
        accepting.append(Task.spawn { () -> Int in
            var taken = 0
            while let connection = try? await listener.accept() {
                connection.close()
                taken += 1
            }
            return taken
        })
    }
    for _ in 0..<40 {
        let stream = try await TcpStream.connect(address)
        assertEqual((try await stream.readAll()).count, 0)
    }
    listener.close()
    var total = 0
    for task in accepting {
        total += await task.value
    }
    assertEqual(total, 40)
}

@test
fn aCancelledAcceptLeavesTheListenerListening() async throws {
    let listener = try TcpListener.bind(SocketAddress(.v4Loopback, port: 0))
    for _ in 0..<50 {
        let waiting = Task.spawn { (try? await listener.accept()) == none }
        if Int.random(in: 0..<2) == 0 {
            await Task.yield()
        }
        waiting.cancel()
        assert(await waiting.value)
    }
    let client = try await TcpStream.connect(listener.localAddress)
    let accepted = try await listener.accept()
    assertEqual(accepted.peerAddress, client.localAddress)
}

@test
fn theReceiveBufferIsWhatItsConnectionsHave() async throws {
    let listener = try TcpListener.bind(SocketAddress(.v4Loopback, port: 0))
    try listener.setReceiveBufferSize(262_144)
    _ = try await TcpStream.connect(listener.localAddress)
    let accepted = try await listener.accept()
    expect((try accepted.receiveBufferSize()) >= 262_144)
    listener.close()
    assertEqual(await thrown { try listener.setReceiveBufferSize(1000) }, "the connection failed or was closed")
}
