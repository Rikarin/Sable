module FrozenStringBench

// FrozenDictionary<String, Int>: short names, identifiers alike but for
// their ends, paths, and the names of headers whatever their case, looked up
// by strings of their own, a third of them not there.

import Sable.Collections
import Sable.Testing

@inline(never)
fn look(_ frozen: FrozenDictionary<String, Int>, _ keys: String[>..], _ rounds: Int) -> Int {
    var total = 0
    for _ in 0..<rounds {
        for key in keys {
            total += frozen[key] ?? 1
        }
    }
    return total
}

fn entries(_ count: Int, _ text: (Int) -> String) -> (String, Int)[>..] {
    var pairs: (String, Int)[>..] = []
    for i in 0..<count {
        pairs.append((text(i), i))
    }
    return pairs
}

fn run(_ short: FrozenDictionary<String, Int>, _ shortKeys: String[>..], _ names: FrozenDictionary<String, Int>, _ nameKeys: String[>..], _ paths: FrozenDictionary<String, Int>, _ pathKeys: String[>..], _ headers: FrozenDictionary<String, Int>, _ headerKeys: String[>..]) -> String {
    var total = look(short, shortKeys, 40000)
    total += look(names, nameKeys, 6000)
    total += look(paths, pathKeys, 150)
    total += look(headers, headerKeys, 20000)
    return "\(total)"
}

@bench
fn measure(_ b: Bencher) {
    let short = FrozenDictionary<String, Int>(entries(30) { "k\($0 * 77)" })
    let names = FrozenDictionary<String, Int>(entries(200) { "identifier\($0)" })
    let paths = FrozenDictionary<String, Int>(entries(5000) { "src/module/\($0 * 7)/file.sb" })
    let headers = FrozenDictionary<String, Int>(ignoringAsciiCase: entries(50) { "X-Header-\($0 * 31)-Name" })
    let shortKeys = (0..<45).map { "k\($0 * 77)" }
    let nameKeys = (0..<300).map { "identifier\($0)" }
    let pathKeys = (0..<7500).map { "src/module/\($0 * 7)/file.sb" }
    let headerKeys = (0..<75).map { "x-header-\($0 * 31)-NAME" }
    b.check(b.iterate { run(short, shortKeys, names, nameKeys, paths, pathKeys, headers, headerKeys) })
}
