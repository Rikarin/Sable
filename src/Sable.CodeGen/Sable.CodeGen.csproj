<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Sable.CodeGen</RootNamespace>
    <AssemblyName>Sable.CodeGen</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sable.SIL/Sable.SIL.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The runtime, every file of it: sable_runtime.c includes the rest. -->
    <EmbeddedResource Include="../../runtime/*.c;../../runtime/*.h" LogicalName="Sable.CodeGen.runtime/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../tools/lldb/sable_lldb.py" LogicalName="Sable.CodeGen.sable_lldb.py" />
  </ItemGroup>
</Project>
