module TextTests

// Sable.Text's functions on strings, tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Text
import Sable.Testing

@test(arguments: [("-42", 10, -42), ("ff", 16, 255), ("+7", 10, 7), ("Zz", 36, 1295), ("10", 99, 10), ("-9223372036854775808", 10, Int.min)])
fn parsingIntegers(_ text: String, _ radix: Int, _ value: Int) {
    assertEqual(parseInt(text, radix: radix), value)
}

@test(arguments: ["4x", "", "-", "1!", "9223372036854775808", "99999999999999999999"])
fn whatIsNoIntegerOrTooBigIsNone(_ text: String) {
    assertEqual(parseInt(text), none)
}

@test
fn escapingHtml() {
    assertEqual(escapedHtml("<a href=\"x\">&</a>"), "&lt;a href=&quot;x&quot;&gt;&amp;&lt;/a&gt;")
}

@test(arguments: [("plain", "plain"), ("'", "&#39;"), (">", "&gt;"), ("\"x\"", "&quot;x&quot;")])
fn escapingEachCharacter(_ text: String, _ escaped: String) {
    assertEqual(escapedHtml(text), escaped)
}
