module Sable.Globalization

import Sable.Text

/// A locale's way of writing numbers, made once to write many: what
/// `format(_:locale:)` makes for each number it is given. ECMA-402's
/// Intl.NumberFormat.
///
/// ```sable
/// let money = NumberFormatter(.currency("CZK"), locale: Locale.of("cs")!)
/// assert(money.format(1234.5) == "1\u{A0}234,50\u{A0}Kč")
/// let read: F64 = try! money.parse("1 234,50 Kč")
/// assert(read == 1234.5)
/// ```
public struct NumberFormatter {
    /// What numbers are written as.
    public let numberFormat: NumberFormat
    /// Whose way they are written in.
    public let locale: Locale
    let pattern: NumberPattern
    /// The digits 0 to 9.
    let digits: Char[>..]
    let decimal: String
    let group: String
    let minus: String
    let signs: NumberSigns
    let exponent: String
    let notANumber: String
    let infinity: String
    let minimumGrouping: Int
    let currencyCode: String
    let currency: String
    let minimumFraction: Int
    let maximumFraction: Int
    /// What goes before a finite number and after it, and a negative one.
    let positive: (String, String)
    let negative: (String, String)

    /// The locale's way of writing numbers in the format. Money in a
    /// currency that is not three letters traps.
    public init(_ format: NumberFormat, locale: Locale) {
        let data = locale.data
        let system = locale.numberingSystem
        let (symbols, patterns) = data.numbers(system)
        var code = ""
        var which = 0
        match format.kind {
            case .Decimal    => { }
            case .Percent    => { which = 1 }
            case .Scientific => { which = 2 }
            case .Currency(let asked) => {
                which = format.accounting ? 4 : 3
                code = asked.asciiUppercased()
                precondition(code.count == 3 && isAlpha(asked.asciiLowercased()), "a currency is three letters, not '\(asked)'")
            }
        }
        let money = which >= 3
        let pattern = NumberPattern(patterns[which])
        let currency = currencyText(code, format.currencyDisplay, data)
        let signs = NumberSigns(format.sign, minus: symbols[2], plus: symbols[3], percent: symbols[4], currency: currency, pattern)
        var least = pattern.minimumFraction
        var most = pattern.maximumFraction
        if which == 2 {
            least = 0
            most = 3
        } else if money {
            least = (listed(currencyDigits, code) ?? "2").toInt() ?? 2
            most = least
        }
        if let asked = format.minimumFractionDigits {
            least = asked
            most = most < asked ? asked : most
        }
        if let asked = format.maximumFractionDigits {
            most = asked
            least = least > asked ? asked : least
        }
        self.numberFormat = format
        self.locale = locale
        self.pattern = pattern
        self.digits = (listed(numberingSystems, system) ?? "0123456789").toArray()
        self.decimal = money ? symbols[9] : symbols[0]
        self.group = money ? symbols[10] : symbols[1]
        self.minus = symbols[2]
        self.signs = signs
        self.exponent = symbols[6]
        self.notANumber = symbols[7]
        self.infinity = symbols[8]
        self.minimumGrouping = data.text("minimumGrouping").toInt() ?? 1
        self.currencyCode = code
        self.currency = currency
        self.minimumFraction = least
        self.maximumFraction = most
        self.positive = signs.affixes(negative: false, isNaN: false, isFinite: true)
        self.negative = signs.affixes(negative: true, isNaN: false, isFinite: true)
    }

    /// The number as the locale writes it.
    public fn format<T: LocalizableNumber>(_ value: T) -> String {
        if digits[0] == '0' && numberFormat.kind != .Scientific {
            let shift = numberFormat.kind == .Percent ? 2 : 0
            if let (scaled, places) = value.scaled(places: maximumFraction + shift) {
                if places >= shift {
                    return written(scaled, places - shift)
                }
                if scaled > -1_000_000_000_000_000 && scaled < 1_000_000_000_000_000 {
                    return written(scaled * 100, places)
                }
            }
        }
        if numberFormat.kind == .Scientific {
            var spec = FormatSpec()
            spec.kind = .Exponent
            spec.precision = maximumFraction
            return localized(withoutZeros(value.format(spec)))
        }
        return localized(plainText(value))
    }

    /// The whole number divided by a power of ten as the locale writes it, in
    /// ASCII digits: what 'localized' writes of its plain digits, without
    /// their being written first.
    fn written(_ value: Int, _ places: Int) -> String {
        let (leading, trailing) = value < 0 ? negative : positive
        var rest = value < 0 ? 0 - value : value
        var fraction = places
        while fraction > minimumFraction && rest % 10 == 0 {
            rest = rest / 10
            fraction -= 1
        }
        let zeros = fraction < minimumFraction ? minimumFraction - fraction : 0
        var whole = 0 - fraction
        var left = rest
        while left > 0 {
            left = left / 10
            whole += 1
        }
        whole = whole < numberFormat.minimumIntegerDigits ? numberFormat.minimumIntegerDigits : whole
        whole = whole < 1 ? 1 : whole
        let primary = pattern.primaryGroup
        let least = numberFormat.grouping == .Always ? 1 : minimumGrouping
        var separators = 0
        if numberFormat.grouping != .Never && primary > 0 && whole >= primary + least && whole > primary {
            separators = 1 + (whole - primary - 1) / pattern.secondaryGroup
        }
        let point = fraction + zeros > 0 ? decimal.utf8Count : 0
        var at = leading.utf8Count + whole + separators * group.utf8Count + point + fraction + zeros + trailing.utf8Count
        var bytes: U8[>..] = []
        bytes.append(repeating: 0x30, count: at)
        // From the end to the start.
        putBefore(&at, trailing, &bytes)
        at -= zeros
        var i = 0
        while i < fraction {
            at -= 1
            bytes[at] = U8(48 + rest % 10)
            rest = rest / 10
            i += 1
        }
        if point > 0 {
            putBefore(&at, decimal, &bytes)
        }
        var next = separators > 0 ? primary : whole
        i = 0
        while i < whole {
            if i == next {
                putBefore(&at, group, &bytes)
                next += pattern.secondaryGroup
            }
            at -= 1
            bytes[at] = U8(48 + rest % 10)
            rest = rest / 10
            i += 1
        }
        putBefore(&at, leading, &bytes)
        unsafe {
            return String.fromUtf8Unchecked(bytes)
        }
    }

    /// The number's digits, as many as the format writes.
    fn plainText<T: LocalizableNumber>(_ value: T) -> String {
        let isPercent = numberFormat.kind == .Percent
        let shortest = value.plainDigits(places: none, percent: isPercent)
        let parts = NumberParts(shortest)
        if parts.fraction.count <= maximumFraction {
            return withoutZeros(shortest)
        }
        return withoutZeros(value.plainDigits(places: maximumFraction, percent: isPercent))
    }

    /// The digits with their fraction as long as the format wants it: zeros
    /// taken from its end, or put there.
    fn withoutZeros(_ text: String) -> String {
        var parts = NumberParts(text)
        if !parts.isFinite {
            return text
        }
        while parts.fraction.count > minimumFraction && parts.fraction.hasSuffix("0") {
            parts.fraction = parts.fraction.slice(from: 0, to: parts.fraction.count - 1)
        }
        parts.fraction = parts.fraction.paddedEnd(toWidth: minimumFraction, with: '0')
        return parts.text
    }

    /// Plain digits as the locale writes them, every one of them.
    fn localized(_ text: String) -> String {
        let parts = NumberParts(text)
        var body = ""
        if parts.isFinite {
            body = grouped(parts.whole.paddedStart(toWidth: numberFormat.minimumIntegerDigits, with: '0'))
            if !parts.fraction.isEmpty {
                body += decimal + inDigits(parts.fraction)
            }
            if let power = parts.power {
                body += exponent + (power < 0 ? minus + inDigits("\(0 - power)") : inDigits("\(power)"))
            }
        } else {
            body = parts.isNaN ? notANumber : infinity
        }
        let (leading, trailing) = parts.isFinite ? (parts.negative ? negative : positive) : signs.affixes(negative: parts.negative, isNaN: parts.isNaN, isFinite: false)
        return leading + body + trailing
    }

    /// The whole digits in the locale's digits and groups.
    fn grouped(_ whole: String) -> String {
        let primary = pattern.primaryGroup
        let least = numberFormat.grouping == .Always ? 1 : minimumGrouping
        if numberFormat.grouping == .Never || primary == 0 || whole.count < primary + least {
            return inDigits(whole)
        }
        var pieces: String[>..] = []
        var end = whole.count - primary
        pieces.append(inDigits(whole.slice(from: end, to: whole.count)))
        while end > 0 {
            let start = end > pattern.secondaryGroup ? end - pattern.secondaryGroup : 0
            pieces.append(inDigits(whole.slice(from: start, to: end)))
            end = start
        }
        pieces.reverse()
        return pieces.joined(separator: group)
    }

    /// ASCII digits as the locale's.
    fn inDigits(_ text: String) -> String {
        return localDigits(text, digits)
    }
}

/// Puts the text's bytes before the place, which is moved to their start.
fn putBefore(_ at: inout Int, _ text: String, _ bytes: inout U8[>..]) {
    var i = text.utf8Count
    while i > 0 {
        i -= 1
        at -= 1
        bytes[at] = text.utf8[i]
    }
}

/// How the locale writes the currency.
fn currencyText(_ code: String, _ display: CurrencyDisplay, _ data: LocaleData) -> String {
    if code.isEmpty || display == .Code {
        return code
    }
    if display == .Narrow {
        if let found = listed(data.text("currencies.narrow").replacing("|", with: "\n"), code) {
            return found
        }
        if let found = listed(currencyNarrowSymbols, code) {
            return found
        }
    }
    if let found = listed(data.text("currencies").replacing("|", with: "\n"), code) {
        return found
    }
    return listed(currencySymbols, code) ?? code
}

/// ASCII digits as the ten given.
fn localDigits(_ text: String, _ digits: Char[>..]) -> String {
    if digits[0] == '0' {
        return text
    }
    var written: Char[>..] = []
    for c in text {
        written.append(c >= '0' && c <= '9' ? digits[c.codePoint - 48] : c)
    }
    return String(written)
}
