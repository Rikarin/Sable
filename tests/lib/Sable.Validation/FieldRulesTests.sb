module ValidationTests

import Sable.Testing
import Sable.Validation

@test
fn whatIsSaidIsOfTheLastCheck() {
    let result = verdict(5) {
        $0.greaterThan(9).message("big").code("Big").severity(.Warning)
            .lessThan(1).message { (whole, value) in "small, not \(value!)" }.severity(.Info)
            .equal(4)
    }
    assertEqual(result.toString(), "big\nsmall, not 5\n'It' must be equal to 4.")
    assertEqual(result.failures.map(\.code), ["Big", "LessThan", "Equal"])
    assertEqual(result.failures.map(\.severity), [Severity.Warning, Severity.Info, Severity.Error])
    assertEqual(result.failures[0].attemptedValue ?? "", "5")
}

@test
fn aValueWithOnlyWarningsIsNotValidAndHasNoErrors() {
    let result = verdict(5) { $0.greaterThan(9).severity(.Warning) }
    expect(!result.isValid)
    expect(!result.hasErrors)
}

@test
fn placeholdersStandForWhatTheRuleIsOf() {
    assertEqual(message("abc") { $0.length(5...9).message("{PropertyName}|{PropertyValue}|{MinLength}|{MaxLength}|{TotalLength}|{Nothing}|{{x}}") },
        "It|abc|5|9|3|{Nothing}|{x}")
    let failure = verdict("abc") { $0.minLength(4) }.failures[0]
    assertEqual(failure.placeholders["MinLength"] ?? "", "4")
    assertEqual(failure.placeholders["PropertyPath"] ?? "?", "")
}

@test
fn aFieldIsCalledByItsPathsWordsOrAsItIsNamed() {
    var customer = ada()
    customer.address.postalCode = ""
    let result = verdictOf(customer) {
        $0.field(\.address.postalCode).notEmpty()
        $0.field(\.address.postalCode).named("ZIP").notEmpty()
        $0.field(\.address.postalCode).reported(at: "zip").notEmpty()
    }
    assertEqual(result.toString(), "'Address Postal Code' must not be empty.\n'ZIP' must not be empty.\n'Address Postal Code' must not be empty.")
    assertEqual(result.failures[2].path, "zip")
}

@test
fn aComparisonWithAFieldNamesIt() {
    var customer = ada()
    customer.limit = 3
    let result = verdictOf(customer) { $0.field(\.age).lessThanOrEqual(\.limit).message("{PropertyName} {ComparisonProperty} {ComparisonValue}") }
    assertEqual(result.toString(), "Age Limit 3")
}

@test
fn mustWithSeesTheWholeValue() {
    assertEqual(found(ada()) { $0.field(\.age).mustWith { (whole, age) in whole.country == "SK" && age > 1 } }, ["age Must"])
}

@test
fn aCustomRuleReportsWhatItFinds() {
    let result = verdict([1, 2, 3]) {
        $0.custom { (numbers, context) in
            if numbers.count > 2 {
                context.fail("{PropertyName} has {Count}", code: "Many", severity: .Warning, placeholders: ["Count": "\(numbers.count)"])
                context.fail("first", under: "[0]")
            }
        }
    }
    assertEqual(result.toString(), "It has 3\nfirst")
    assertEqual(result.failures[0].code, "Many")
    assertEqual(result.failures[1].code, "Custom")
    assertEqual(result.failures[1].path, "[0]")
    assertEqual(verdict(1) { $0.custom { (n, context) in context.fail("x") }.code("Own").severity(.Info) }.failures[0].code, "Own")
}

extension FieldRules where V == String {
    @discardable
    fn slug() -> FieldRules<T, V> {
        return matches("^[a-z0-9-]+$").code("Slug").message("'{PropertyName}' is no slug.")
    }
}

@test
fn aProgramsOwnRuleIsAnExtension() {
    assertEqual(message("A") { $0.slug() }, "'It' is no slug.")
    expect(passes("a-1") { $0.slug() })
}
