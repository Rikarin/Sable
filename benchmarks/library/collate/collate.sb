module CollateBench

import Sable.Globalization
import Sable.Testing

// Words in Swedish order: sorted by comparison, then by their sort keys.

fn run(_ words: String[>..], _ swedish: Collator) -> String {
    let sorted = words.sorted(by: swedish.areInIncreasingOrder)
    let keyed = words.map { (swedish.sortKey($0), $0) }.sorted { a, b in a.0 < b.0 }
    return "\(sorted[0]) \(sorted[sorted.count - 1]) \(sorted[2500]) \(keyed[2500].1)"
}

@bench
fn measure(_ b: Bencher) {
    let letters = ["a", "b", "c", "e", "k", "l", "o", "r", "s", "t", "å", "ä", "ö"]
    var words: String[>..] = []
    var x = 42
    for _ in 0..<5000 {
        var word = ""
        for _ in 0..<6 {
            x = (x * 1103515245 + 12345) % 2147483648
            word += letters[x / 65536 % letters.count]
        }
        words.append(word)
    }
    let swedish = Collator(Locale.of("sv")!)
    b.check(b.iterate { run(words, swedish) })
}
