module IntegerMathTests

// IntegerMath (Sable.Math), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Math

import Sable.Math
import Sable.Testing

@test
fn isqrtIsTheFloorOfTheSquareRoot() {
    assertEqual(isqrt(0), 0)
    assertEqual(isqrt(1), 1)
    assertEqual(isqrt(2), 1)
    assertEqual(isqrt(15), 3)
    assertEqual(isqrt(16), 4)
    assertEqual(isqrt(17), 4)
    assertEqual(isqrt(999_999_999_999), 999_999)
    assertEqual(isqrt(1_000_000_000_000), 1_000_000)
}

@test
fn isqrtIsExactWhereF64sSquareRootIsNot() {
    // 2^53 + 1's root as an F64 rounds: the steps put it right.
    assertEqual(isqrt(9_007_199_254_740_993), 94_906_265)
    assertEqual(isqrt(4_611_686_014_132_420_609), 2_147_483_647)
    assertEqual(isqrt(4_611_686_014_132_420_608), 2_147_483_646)
    assertEqual(isqrt(9_223_372_036_854_775_807), 3_037_000_499)
}

@test(traps: "isqrt's argument must not be negative, but is -4")
fn isqrtOfANegativeNumberTraps() {
    let _ = isqrt(-4)
}

@test
fn factorialMultipliesOneThroughN() {
    assertEqual(factorial(0), 1)
    assertEqual(factorial(1), 1)
    assertEqual(factorial(5), 120)
    assertEqual(factorial(20), 2_432_902_008_176_640_000)
}

@test(traps: "integer overflow")
fn factorialPastTwentyTraps() {
    let _ = factorial(21)
}

@test(traps: "factorial's argument must not be negative, but is -1")
fn factorialOfANegativeNumberTraps() {
    let _ = factorial(-1)
}

@test
fn binomialCountsSubsets() {
    assertEqual(binomial(5, 2), 10)
    assertEqual(binomial(5, 3), 10)
    assertEqual(binomial(10, 0), 1)
    assertEqual(binomial(10, 10), 1)
    assertEqual(binomial(0, 0), 1)
    assertEqual(binomial(52, 5), 2_598_960)
}

@test
fn binomialOutsideZeroThroughNIsZero() {
    assertEqual(binomial(5, -1), 0)
    assertEqual(binomial(5, 6), 0)
    assertEqual(binomial(-3, 2), 0)
}

@test
fn binomialDoesNotOverflowOnTheWayToAResultThatFits() {
    assertEqual(binomial(62, 31), 465_428_353_255_261_088)
    assertEqual(binomial(66, 33), 7_219_428_434_016_265_740)
    assertEqual(binomial(1_000_000, 2), 499_999_500_000)
}

@test(traps: "integer overflow")
fn binomialTrapsWhenTheResultDoesNotFit() {
    let _ = binomial(68, 34)
}

@test
fn powModReducesEveryProduct() {
    assertEqual(powMod(4, 13, 497), 445)
    assertEqual(powMod(2, 0, 7), 1)
    assertEqual(powMod(2, 0, 1), 0)
    assertEqual(powMod(-2, 3, 5), 2)
    assertEqual(powMod(3, 200, 1_000_000_007), 136_318_165)
    assertEqual(powMod(9_223_372_036_854_775_806, 2, 9_223_372_036_854_775_807), 1)
}

@test(traps: "the modulus must be positive, not 0")
fn powModByZeroTraps() {
    let _ = powMod(2, 3, 0)
}

@test(traps: "the exponent must not be negative, but is -1")
fn powModToANegativePowerTraps() {
    let _ = powMod(2, -1, 7)
}

@test
fn modInverseUndoesMultiplication() {
    assertEqual(modInverse(3, 11) ?? -1, 4)
    assertEqual(modInverse(10, 17) ?? -1, 12)
    assertEqual(modInverse(-3, 11) ?? -1, 7)
    assertEqual(modInverse(14, 1) ?? -1, 0)
    assertEqual(modInverse(9_223_372_036_854_775_806, 9_223_372_036_854_775_807) ?? -1, 9_223_372_036_854_775_806)
}

@test
fn modInverseIsNoneWithACommonFactor() {
    assert(modInverse(2, 4) == none, "2 has no inverse modulo 4")
    assert(modInverse(0, 7) == none, "0 has no inverse")
    assert(modInverse(21, 14) == none, "7 divides both")
}

@test(traps: "the modulus must be positive, not 0")
fn modInverseModuloZeroTraps() {
    let _ = modInverse(3, 0)
}

@test(traps: "the modulus must be positive, not -7")
fn powModByANegativeModulusTraps() {
    let _ = powMod(2, 3, -7)
}

@test(traps: "the modulus must be positive, not -11")
fn modInverseModuloANegativeNumberTraps() {
    let _ = modInverse(3, -11)
}
