module SmallVecTests

// SmallVec (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn aSmallVecStaysInlineUpToItsInlineCapacity() {
    var small = SmallVec<Int, 3>()
    expect(small.isEmpty)
    assertEqual(small.inlineCapacity, 3)
    assertEqual(small.capacity, 3)
    small.append(1)
    small.append(2)
    small.append(3)
    expect(!small.isSpilled)
    assertEqual(small.count, 3)
    expect(small.toArray() == [1, 2, 3])
}

@test
fn oneElementPastTheInlineCapacityMovesToTheHeap() {
    var small = SmallVec<Int, 2>([1, 2])
    expect(!small.isSpilled)
    small.append(3)
    expect(small.isSpilled)
    expect(small.capacity >= 3)
    assertEqual(small.count, 3)
    expect(small.toArray() == [1, 2, 3])
}

@test
fn appendingManyAtOnceSpillsOnce() {
    var small = SmallVec<Int, 2>()
    small.append(contentsOf: [1, 2, 3, 4])
    expect(small.isSpilled)
    expect(small.toArray() == [1, 2, 3, 4])
    small.append(contentsOf: [5])
    assertEqual(small.count, 5)
}

@test
fn subscriptReadsAndWritesInlineAndOnTheHeap() {
    var small = SmallVec<String, 2>(["a", "b"])
    small[1] = "B"
    assertEqualText(small[1], "B")
    small.append("c")
    small[0] = "A"
    assertEqualText(small[0], "A")
    assertEqualText(small[2], "c")
}

@test
fn firstAndLastAreNoneWhenEmpty() {
    var small = SmallVec<Int, 2>()
    expect(small.first == none)
    expect(small.last == none)
    small.append(4)
    small.append(5)
    expect(small.first == 4)
    expect(small.last == 5)
}

@test
fn insertMovesTheElementsAfterUp() {
    var small = SmallVec<Int, 4>([1, 3])
    small.insert(2, at: 1)
    small.insert(0, at: 0)
    expect(!small.isSpilled)
    expect(small.toArray() == [0, 1, 2, 3])
    small.insert(4, at: 4)
    expect(small.isSpilled)
    small.insert(9, at: 2)
    expect(small.toArray() == [0, 1, 9, 2, 3, 4])
}

@test(traps: "SmallVec.insert: index out of range")
fn insertPastTheEndTraps() {
    var small = SmallVec<Int, 2>()
    small.insert(1, at: 1)
}

@test(traps: "SmallVec.truncate: negative count")
fn truncateToANegativeCountTraps() {
    var small = SmallVec<Int, 2>([1])
    small.truncate(to: -1)
}

@test
fn removeAtClosesTheGap() {
    var small = SmallVec<Int, 3>([1, 2, 3])
    assertEqual(small.remove(at: 1), 2)
    expect(small.toArray() == [1, 3])
    small.append(contentsOf: [4, 5])
    assertEqual(small.remove(at: 0), 1)
    expect(small.toArray() == [3, 4, 5])
}

@test
fn removeLastAndPopLastTakeFromTheEnd() {
    var small = SmallVec<Int, 1>([1, 2])
    assertEqual(small.removeLast(), 2)
    expect(small.popLast() == 1)
    expect(small.popLast() == none)
    var inline = SmallVec<Int, 2>([7])
    assertEqual(inline.removeLast(), 7)
}

@test
fn truncateKeepsThePrefix() {
    var small = SmallVec<Int, 2>([1, 2, 3, 4])
    small.truncate(to: 10)
    assertEqual(small.count, 4)
    small.truncate(to: 1)
    expect(small.toArray() == [1])
}

@test
fn removeAllAndShrinkToFitComeBackInline() {
    var small = SmallVec<Int, 2>([1, 2, 3])
    small.removeAll()
    expect(small.isEmpty)
    expect(!small.isSpilled)
    small.append(contentsOf: [1, 2, 3])
    small.shrinkToFit()
    expect(small.isSpilled, "three do not fit inline")
    _ = small.removeLast()
    small.shrinkToFit()
    expect(!small.isSpilled)
    expect(small.toArray() == [1, 2])
    small.shrinkToFit()
    expect(!small.isSpilled)
}

@test
fn reserveCapacityPastTheInlineRoomSpills() {
    var small = SmallVec<Int, 4>([1])
    small.reserveCapacity(3)
    expect(!small.isSpilled)
    small.reserveCapacity(10)
    expect(small.isSpilled)
    expect(small.capacity >= 10)
    small.reserveCapacity(20)
    expect(small.capacity >= 20)
    expect(small.toArray() == [1])
}

@test
fn containsFindsAnEqualElement() {
    var small = SmallVec<String, 2>(["a"])
    expect(small.contains("a"))
    expect(!small.contains("b"))
    small.append(contentsOf: ["b", "c"])
    expect(small.contains("c"))
    expect(!small.contains("d"))
}

@test
fn aSmallVecIsGoneThroughInOrder() {
    var small = SmallVec<Int, 2>([1, 2, 3])
    var total = 0
    for n in small {
        total = total * 10 + n
    }
    assertEqual(total, 123)
    small.removeAll()
    for _ in small {
        fail("an empty vector gives nothing")
    }
}

@test
fn aCopyOfASmallVecIsItsOwn() {
    var a = SmallVec<Int, 2>([1])
    let b = a
    a.append(2)
    a[0] = 9
    assertEqual(b.count, 1)
    assertEqual(b[0], 1)
}

fn built<C: RangeReplaceableCollection>(_ n: Int) -> C where C.Element == Int {
    var made = C()
    made.reserveCapacity(n)
    var i = 0
    while i < n {
        made.append(element: i)
        i += 1
    }
    return made
}

@test
fn aSmallVecIsMadeAndGrownAsARangeReplaceableCollection() {
    var small: SmallVec<Int, 2> = built(5)
    assertEqual(small.count, 5)
    expect(small.isSpilled)
    small.replaceSubrange(1..<4, with: [9])
    expect(small.toArray() == [0, 9, 4])
    small.clear()
    expect(small.isEmpty)
}

@test
fn aSmallVecIsARandomAccessCollection() {
    var small = SmallVec<Int, 4>([5, 6, 7])
    assertEqual(small.distance(from: small.startIndex, to: small.endIndex), 3)
    assertEqual(small[small.index(before: small.endIndex)], 7)
    assertEqual(small.index(small.startIndex, offsetBy: 1), 1)
    assertEqual(small.lastIndex(of: 6) ?? -1, 1)
    small.swapAt(0, 2)
    expect(small.toArray() == [7, 6, 5])
}

@test
fn aSmallVecIsReadFromTheEndInlineOrNot() {
    var small = SmallVec<Int, 2>([1, 2])
    assertEqual(small[^1], 2)
    small.append(3)
    assertEqual(small[^1], 3)
    assertEqual(small[^3], 1)
}

@test
fn aSmallVecIsSlicedInlineOrNot() {
    var small = SmallVec<Int, 4>([1, 2, 3])
    expect(small[1...] == [2, 3])
    expect(small[..<^1] == [1, 2])
    small.append(4)
    small.append(5)
    expect(small.isSpilled)
    expect(small[^2...] == [4, 5])
    expect(small[1..<3] == [2, 3])
}

@test
fn aSmallVecIsMadeFromAnySequence() {
    let inline = SmallVec<Int, 4>(1...3)
    expect(inline.toArray() == [1, 2, 3])
    let spilled: SmallVec<Int, 2> = (1...5).collect()
    assertEqual(spilled.count, 5)
}

@test
fn aSmallVecIsWrittenFromTheEndInlineOrNot() {
    var small = SmallVec<Int, 2>([1, 2])
    small[^1] = 9
    expect(small.toArray() == [1, 9])
    small.append(3)
    small[^3] = 0
    small[1...^1] = SmallVec<Int, 2>([5])
    expect(small.toArray() == [0, 5])
}

@test
fn aSmallVecWithinItsRoomAllocatesOnceAtMost() {
    // Its inline room's buffer, once, and nothing per element; none at all
    // once T[..N] is laid out inline (#304).
    let made = allocations(during: () => {
        var v = SmallVec<Int, 8>()
        var i = 0
        while i < 8 {
            v.append(i)
            i += 1
        }
        v[0] = 5
        _ = v.remove(at: 2)
        v.insert(7, at: 0)
        var total = 0
        for x in v {
            total += x
        }
        _ = v.contains(total)
        _ = v.first
        _ = v.popLast()
        v.truncate(to: 3)
    })
    expect(made <= 1, "\(made) allocations")
    // Past its room, it moves to the heap: an allocation, as it should.
    let spilled = allocations(during: () => {
        var v = SmallVec<Int, 2>()
        v.append(1)
        v.append(2)
        v.append(3)
    })
    expect(spilled > 0)
}

@bench
fn fillingASmallVecWithinItsRoom(_ b: Bencher) {
    b.iterate(() => {
        var v = SmallVec<Int, 16>()
        var i = 0
        while i < 16 {
            v.append(i)
            i += 1
        }
        var total = 0
        for x in v {
            total += x
        }
    })
}
