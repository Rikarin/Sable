module SortedDictionaryTests

// SortedDictionary (Sable.Collections): against a model — a Dictionary for
// the entries, and its keys sorted for the order — under arbitrary inserts,
// removals and queries, and by example.

import CollectionsSupport
import Sable.Collections
import Sable.Testing

fn keysOf<S: Sequence>(_ entries: S) -> Int[>..] where S.Element == (key: Int, value: Int), S.Failure == Never {
    var keys: Int[>..] = []
    for entry in entries {
        keys.append(entry.key)
    }
    return keys
}

fn sortedKeys(_ model: [Int: Int]) -> Int[>..] {
    var keys: Int[>..] = []
    for (key, _) in model {
        keys.append(key)
    }
    keys.sort()
    return keys
}

@test
fn eachOperationByExample() {
    var d = SortedDictionary<String, Int>()
    expect(d.isEmpty)
    expect(d.first == none && d.last == none)
    d["m"] = 1
    d["c"] = 2
    d["x"] = 3
    expect(d.updateValue(20, forKey: "c") == 2)
    assertEqual(d.count, 3)
    assertEqual(d["c"] ?? 0, 20)
    expect(d.contains("x") && !d.contains("a"))
    assertEqual(d.keys.joined(separator: ","), "c,m,x")
    assertEqual(d.values.count, 3)
    assertEqual(d.first!.key, "c")
    assertEqual(d.last!.key, "x")
    assertEqual(d.floor("n")!.key, "m")
    assertEqual(d.floor("m")!.key, "m")
    expect(d.floor("a") == none)
    assertEqual(d.ceiling("d")!.key, "m")
    expect(d.ceiling("y") == none)
    d["m"] = none
    expect(!d.contains("m"))
    expect(d.remove("zz") == none)
    assertEqual(d.popFirst()!.key, "c")
    assertEqual(d.popLast()!.key, "x")
    expect(d.popFirst() == none)
    d.removeAll()
    expect(d.isEmpty)
}

@test
fn literalsCopiesAndEquality() {
    let a = SortedDictionary<Int, String>([(3, "c"), (1, "a"), (2, "b")])
    var b = a
    b[4] = "d"
    assertEqual(a.count, 3)
    assertEqual(b.count, 4)
    expect(a != b)
    b[4] = none
    expect(a == b)
    assertEqual(a.debugDescription(), "[1: \"a\", 2: \"b\", 3: \"c\"]")
    assertEqual(SortedDictionary<Int, Int>().debugDescription(), "[:]")
}

@test
fn positionsAreRanks() {
    var d = SortedDictionary<Int, Int>()
    var i = 0
    while i < 100 {
        d[i * 3] = i
        i += 1
    }
    assertEqual(d[d.startIndex].key, 0)
    assertEqual(d[d.index(before: d.endIndex)].key, 297)
    assertEqual(d[d.index(d.startIndex, offsetBy: 50)].key, 150)
    assertEqual(d.index(forKey: 30)!.rank, 10)
    expect(d.index(forKey: 31) == none)
    assertEqual(d[d.index(after: d.startIndex)].key, 3)
    var walked = 0
    var at = d.startIndex
    while at != d.endIndex {
        walked += 1
        at = d.index(after: at)
    }
    assertEqual(walked, 100)
}

@test
fn rangesOfKeys() {
    var pairs: (Int, Int)[>..] = []
    var i = 0
    while i < 50 {
        pairs.append((i * 2, i))
        i += 1
    }
    let d = SortedDictionary<Int, Int>(pairs)
    assertEqual(keysOf(d.range(10..<16)).count, 3)
    assertEqual(keysOf(d.range(10...16)).count, 4)
    assertEqual(keysOf(d.range(11...15)).count, 2)
    assertEqual(keysOf(d.range(90...)).count, 5)
    assertEqual(keysOf(d.range(..<4)).count, 2)
    assertEqual(keysOf(d.range(...4)).count, 3)
    assertEqual(keysOf(d.range(200...)).count, 0)
    assertEqual(keysOf(d.range(5..<5)).count, 0)
    assertEqual(keysOf(d.range(-10...0))[0], 0)
}

@test
fn splitAndAppend() {
    var low = SortedDictionary<Int, Int>()
    var i = 0
    while i < 1000 {
        low[i] = i * i
        i += 1
    }
    let high = low.split(at: 600)
    assertEqual(low.count, 600)
    assertEqual(high.count, 400)
    assertEqual(low.last!.key, 599)
    assertEqual(high.first!.key, 600)
    var more: (Int, Int)[>..] = []
    i = 600
    while i < 2000 {
        more.append((i, i))
        i += 1
    }
    low.append(contentsOf: more)
    assertEqual(low.count, 2000)
    assertEqual(low[1500] ?? 0, 1500)
    // Out of order, or overlapping: added one by one.
    low.append(contentsOf: [(5, -5), (3000, 1), (2, -2)])
    assertEqual(low.count, 2001)
    assertEqual(low[5] ?? 0, -5)
    let unordered = SortedDictionary<Int, Int>([(3, 1), (1, 2), (3, 9)])
    assertEqual(unordered.count, 2)
    assertEqual(unordered[3] ?? 0, 9)
}

@derive(Debug)
union SortedStep {
    Update(Int)
    Remove(Int)
    FloorAndCeiling(Int)
    Range(from: Int, count: Int)
    PopFirst
    PopLast
}

@test
fn randomOperationsAgreeWithAModel() {
    let keys = Gen.number(in: 0...799)
    let step = Gen.weighted([
        (8, keys.map { SortedStep.Update($0) }),
        (6, keys.map { SortedStep.Remove($0) }),
        (2, keys.map { SortedStep.FloorAndCeiling($0) }),
        (2, keys.zip(Gen.number(in: 0...99)).map { SortedStep.Range(from: $0.0, count: $0.1) }),
        (1, Gen.always(SortedStep.PopFirst)),
        (1, Gen.always(SortedStep.PopLast)),
    ])
    forAll(many(step, upTo: 4000), cases: 18) { (steps: SortedStep[>..]) in
        var d = SortedDictionary<Int, Int>()
        var model: [Int: Int] = [:]
        var number = 0
        for step in steps {
            number += 1
            var agrees = true
            match step {
                case .Update(let key) => {
                    agrees = d.updateValue(number, forKey: key) == model.updateValue(number, forKey: key)
                }
                case .Remove(let key) => {
                    agrees = d.remove(key) == model.remove(key)
                }
                case .FloorAndCeiling(let key) => {
                    var below: Int? = none
                    var above: Int? = none
                    for (k, _) in model {
                        if k <= key && k >= (below ?? k) {
                            below = k
                        }
                        if k >= key && k <= (above ?? k) {
                            above = k
                        }
                    }
                    agrees = d.floor(key)?.key == below && d.ceiling(key)?.key == above
                }
                case .Range(let key, let count) => {
                    let upper = key + count
                    var expected = 0
                    for (k, _) in model {
                        if k >= key && k < upper {
                            expected += 1
                        }
                    }
                    agrees = keysOf(d.range(key..<upper)).count == expected
                }
                case .PopFirst => {
                    let first = sortedKeys(model).first
                    agrees = d.popFirst()?.key == first
                    if let first = first {
                        model.remove(first)
                    }
                }
                case .PopLast => {
                    let last = sortedKeys(model).last
                    agrees = d.popLast()?.key == last
                    if let last = last {
                        model.remove(last)
                    }
                }
            }
            if !agrees || d.count != model.count {
                recordFailure("step \(number), \(step:?), does not agree: \(d.count) entries, the model's \(model.count)")
                return
            }
        }
        let keys = sortedKeys(model)
        expect(keysOf(d) == keys)
        var rank = 0
        while rank < keys.count {
            expect(d[SortedIndex { rank: rank }].key == keys[rank])
            rank += 37
        }
    }
}
