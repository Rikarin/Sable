module TypeTests

// Type (Sable.Core), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

struct Point {
    var x: Int
    var name: String
}

class Box {
    var value: Int = 0
}

union Tag {
    Label(String)
    Empty
}

@noncopy
struct Unique {
    var id: Int
}

@test
fn anIntsMetadataSaysItsLayout() {
    let m: Type = Int.self
    assertEqual(m.name, "Int")
    assertEqual(m.size, 8)
    assertEqual(m.alignment, 8)
    assertEqual(m.stride, 8)
    assert(m.isTrivial)
    assert(!m.isNoncopyable)
}

@test
fn eachKindIsReported() {
    assert(Box.self.kind == .Class)
    assert(Point.self.kind == .Struct)
    assert(Tag.self.kind == .Union)
    assert(Int?.self.kind == .Optional)
    assert((Int, Bool).self.kind == .Tuple)
    assert(((Int) -> Int).self.kind == .Function)
    assert(Int[>..].self.kind == .Array)
    assert(String.self.kind == .String)
    assert(Type.self.kind == .Metatype)
    assert(Bool.self.kind == .Scalar)
}

@test
fn aStructsFieldsAreItsStoredFieldsInOrder() {
    let m: Type = Point.self
    assertEqual(m.fieldCount, 2)
    assertEqual(m.fieldName(at: 0), "x")
    assertEqual(m.fieldOffset(at: 0), 0)
    assert(m.fieldType(at: 0) == Int.self)
    assertEqual(m.fieldName(at: 1), "name")
    assertEqual(m.fieldOffset(at: 1), 8)
    assert(m.fieldType(at: 1) == String.self)
}

@test
fn anOptionalsArgumentIsTheWrappedType() {
    let m: Type = String?.self
    assertEqual(m.argumentCount, 1)
    assert(m.argument(at: 0) == String.self)
    assert(!m.isTrivial)
}

@test
fn aTypeIsEqualOnlyToItself() {
    let p: Type = Point.self
    assert(p == Point.self)
    assert(p != Box.self)
    assert(p != Point?.self)
}

@test
fn aTypeIsWrittenAsItsName() {
    let t: Type = Int?.self
    assertEqual("\(t)", "Int?")
    assertEqual("\(String.self)", "String")
    assertEqual("[\(Int.self:>5)]", "[  Int]")
    assertEqual("\(t:?)", "Int?")
}

@test
fn equalTypesHashAlike() {
    let a: Type = Point.self
    let b: Type = Point.self
    assertEqual(a.hashValue, b.hashValue)
}

@test
fn aDictionaryIsKeyedByType() {
    var names: [Type: String] = [:]
    names[Int.self] = "int"
    names[Point.self] = "point"
    names[type(of: "text")] = "string"
    assertEqual(names[Int.self] ?? "", "int")
    assertEqual(names[String.self] ?? "", "string")
    assertEqual(names[Point.self] ?? "", "point")
    assert(names[Box.self] == none)
    assertEqual(names.count, 3)
}

class Animal { }

class Dog: Animal { }

protocol Pet { }

extension Dog: Pet { }

@test
fn typeOfAnObjectIsItsOwnClass() {
    let animal: Animal = Dog()
    assert(type(of: animal) == Dog.self)
    assert(type(of: animal) != Animal.self)
}

@test
fn typeOfAnExistentialIsWhatItHolds() {
    let value: any Equatable = 3
    assert(type(of: value) == Int.self)
    let pet: any Pet = Dog()
    assert(type(of: pet) == Dog.self)
}

@test
fn typeOfAnyOtherValueIsItsStaticType() {
    assert(type(of: 3) == Int.self)
    assert(type(of: Point { x: 1, name: "" }) == Point.self)
    let nothing: Int? = none
    assert(type(of: nothing) == Int?.self)
}

@test
fn aSubclassIsASubtypeOfItsSuperclass() {
    assert(Dog.self.isSubtype(of: Animal.self))
    assert(!Animal.self.isSubtype(of: Dog.self))
    assert(Dog.self.isSubtype(of: Dog.self))
}

@test
fn aConformingTypeIsASubtypeOfTheExistential() {
    assert(Dog.self.isSubtype(of: (any Pet).self))
    assert(!Animal.self.isSubtype(of: (any Pet).self))
    assert(Int.self.isSubtype(of: (any Hashable).self))
    assert(!Point.self.isSubtype(of: (any Hashable).self))
}

@test
fn isInstanceChecksAValueAgainstATypeKnownAtRunTime() {
    let animal: Animal = Dog()
    let wanted: Type[] = [Animal.self, Dog.self, (any Pet).self, Int.self]
    var found = ""
    for t in wanted {
        found += t.isInstance(animal) ? "y" : "n"
    }
    assertEqual(found, "yyyn")
    assert(Int.self.isInstance(3))
    assert(!Int.self.isInstance("3"))
}

@test
fn aMoveOnlyTypeIsNoncopyable() {
    assert(Unique.self.isNoncopyable)
    assert(!Unique.self.isTrivial)
}

@test
fn theValueWitnessesCopyMoveAssignAndDestroy() {
    let m: Type = Point.self
    let p = Point { x: 1, name: "a" + "b" }
    assertEqual(m.copy(p).name, "ab")
    assertEqual(m.move(p).x, 1)
    var target = Point { x: 2, name: "c" }
    m.assign(p, to: &target)
    assertEqual(target.name, "ab")
    m.destroyCopy(of: p)
    assertEqual(p.name, "ab")
}
