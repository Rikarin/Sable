module DecodeErrorTests

// DecodeError and Padding (Sable.Text), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Testing
import Sable.Text

@test
fn eachCaseNamesItsOffset() {
    let errors: DecodeError[>..] = [.InvalidCharacter(at: 1, byte: 0x2A), .InvalidLength(at: 2), .InvalidPadding(at: 3), .TrailingBits(at: 4)]
    var expected = 1
    for error in errors {
        assertEqual(error.offset, expected)
        expected += 1
    }
}

@test
fn eachCaseDescribesWhatIsWrongAndWhere() {
    assertEqual(DecodeError.InvalidCharacter(at: 3, byte: 0x2A).description(), "invalid character 0x2A at 3")
    assertEqual(DecodeError.InvalidLength(at: 4).description(), "the text ends partway through the group at 4")
    assertEqual(DecodeError.InvalidPadding(at: 5).description(), "invalid padding at 5")
    assertEqual(DecodeError.TrailingBits(at: 6).description(), "the digit at 6 has bits the bytes do not use")
}

@test
fn debugWritesTheCaseAsSourceDoes() {
    assertEqual(DecodeError.InvalidCharacter(at: 3, byte: 42).debugDescription(), "DecodeError.InvalidCharacter(at: 3, byte: 42)")
    assertEqual(DecodeError.InvalidLength(at: 4).debugDescription(), "DecodeError.InvalidLength(at: 4)")
    assertEqual(DecodeError.InvalidPadding(at: 5).debugDescription(), "DecodeError.InvalidPadding(at: 5)")
    assertEqual(DecodeError.TrailingBits(at: 6).debugDescription(), "DecodeError.TrailingBits(at: 6)")
}

@test
fn errorsAreEqualByCaseAndFields() {
    expect(DecodeError.InvalidCharacter(at: 1, byte: 2) == .InvalidCharacter(at: 1, byte: 2))
    expect(DecodeError.InvalidCharacter(at: 1, byte: 2) != .InvalidCharacter(at: 1, byte: 3))
    expect(DecodeError.InvalidLength(at: 1) == .InvalidLength(at: 1))
    expect(DecodeError.InvalidLength(at: 1) != .InvalidPadding(at: 1))
    expect(DecodeError.InvalidPadding(at: 1) == .InvalidPadding(at: 1))
    expect(DecodeError.TrailingBits(at: 1) == .TrailingBits(at: 1))
    expect(DecodeError.TrailingBits(at: 1) != .TrailingBits(at: 2))
}

@test
fn paddingRulesAreDistinct() {
    expect(Padding.Required != Padding.Either && Padding.Either != Padding.Forbidden)
}
