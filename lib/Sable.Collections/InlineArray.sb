module Sable.Collections

/// Exactly `N` elements: Swift's InlineArray, .NET's [InlineArray(N)],
/// Rust's `[T; N]`. It is the built-in fixed-size array, `Element[N]`, by
/// the name other languages give it, with every member an array has. Its
/// elements are where it is — in a local, a field, a payload — so making,
/// reading, writing and copying one allocates nothing; a member written over
/// slices (`reverse()`, `firstIndex`) is lent the elements where they are.
///
/// For up to `N` elements that can grow and shrink within that room, inline
/// too, use `Element[..N]`; for an array that may outgrow it, `SmallVec`.
///
/// ```sable
/// var corners: InlineArray<Int, 4> = [0, 1, 2, 3]
/// corners[2] = 7
/// assert(corners.count == 4)
/// assert(corners.toArray() == [0, 1, 7, 3])
/// ```
public alias InlineArray<Element, N: Int> = Element[N]
