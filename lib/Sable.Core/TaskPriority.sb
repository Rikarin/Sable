module Sable.Core

/// How urgent a task is. A child has its parent's unless it is given one.
/// The executor runs tasks in the order they become ready, whatever their
/// priority, for now.
@derive(Equatable, Debug)
public struct TaskPriority {
    public let rawValue: Int

    public init(rawValue: Int) {
        self.rawValue = rawValue
    }

    public static var high: TaskPriority => TaskPriority(rawValue: 25)
    public static var medium: TaskPriority => TaskPriority(rawValue: 21)
    public static var low: TaskPriority => TaskPriority(rawValue: 17)
    public static var background: TaskPriority => TaskPriority(rawValue: 9)
}
