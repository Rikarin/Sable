module Sable.Collections

/// A set of small non-negative integers, a bit each: 64 to a word, the
/// words growing to hold the largest member. Membership is a shift and a
/// mask; union and intersection work a word at a time.
public class BitSet {
    var words: U64[>..] = []
    var members: Int = 0

    public init() { }

    /// A set of the sequence's values. What going through them throws, it throws.
    public init<S: Sequence>(_ values: S) throws(S.Failure) where S.Element == Int {
        for try value in values {
            insert(value)
        }
    }

    /// How many integers it holds.
    public var count: Int => members
    public var isEmpty: Bool => members == 0

    fn bit(_ value: Int) -> U64 {
        return U64(1) << U64(value & 63)
    }

    /// Adds the value, which must not be negative; true if it was not there.
    @inline(always)
    public fn insert(_ value: Int) -> Bool {
        let word = value >> 6
        if value < 0 || word >= words.count {
            extend(to: word + 1)
        }
        let held = words[word]
        let mask = bit(value)
        if (held & mask) != 0 {
            return false
        }
        words[word] = held | mask
        members = members + 1
        return true
    }

    // At least so many words; a negative count traps, as indexing an array by
    // it does. A call, as it is hardly ever made: 'insert' is then short
    // enough to be part of what calls it.
    @inline(never)
    fn extend(to count: Int) {
        if count <= 0 {
            let nothing: Int[>..] = []
            let _ = nothing[count - 1]
        }
        while words.count < count {
            words.append(0)
        }
    }

    /// Removes the value; true if it was there.
    public fn remove(_ value: Int) -> Bool {
        if !contains(value) {
            return false
        }
        let word = value >> 6
        words[word] = words[word] & ~bit(value)
        members = members - 1
        return true
    }

    public fn contains(_ value: Int) -> Bool {
        let word = value >> 6
        return value >= 0 && word < words.count && (words[word] & bit(value)) != 0
    }

    /// Removes every value.
    public fn removeAll() {
        words = []
        members = 0
    }

    /// The values in this set or the other, or both.
    public fn union(_ other: BitSet) -> BitSet {
        let (longer, shorter) = if words.count >= other.words.count { (words, other.words) } else { (other.words, words) }
        var both = longer
        var i = 0
        let shared = shorter.count
        while i < shared {
            both[i] = longer[i] | shorter[i]
            i = i + 1
        }
        return BitSet(words: both)
    }

    /// The values in both sets.
    public fn intersection(_ other: BitSet) -> BitSet {
        let mine = words
        let theirs = other.words
        let shared = mine.count < theirs.count ? mine.count : theirs.count
        var common = U64[>..](repeating: 0, count: shared)
        var i = 0
        while i < shared {
            common[i] = mine[i] & theirs[i]
            i = i + 1
        }
        return BitSet(words: common)
    }

    /// The values in this set and not the other.
    public fn subtracting(_ other: BitSet) -> BitSet {
        let mine = words
        let theirs = other.words
        let shared = mine.count < theirs.count ? mine.count : theirs.count
        var left = mine
        var i = 0
        while i < shared {
            left[i] = mine[i] & ~theirs[i]
            i = i + 1
        }
        return BitSet(words: left)
    }

    /// Whether every value in this set is in the other.
    public fn isSubset(of other: BitSet) -> Bool {
        var i = 0
        while i < words.count {
            let theirs: U64 = i < other.words.count ? other.words[i] : 0
            if (words[i] & ~theirs) != 0 {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// The bits set in the words: each word's lowest set bit cleared until none is left.
    // A set of the bits of these words, counted.
    init(words: U64[>..]) {
        self.words = words
        members = BitSet.population(words)
    }

    static fn population(_ words: U64[>..]) -> Int {
        var total = 0
        for word in words {
            total += word.popCount
        }
        return total
    }

    /// The members in one set or the other, not both.
    ///
    /// ```sable
    /// let a = BitSet([1, 2, 3])
    /// assert(a.symmetricDifference(BitSet([3, 4])).toArray() == [1, 2, 4])
    /// ```
    public fn symmetricDifference(_ other: BitSet) -> BitSet {
        let (longer, shorter) = if words.count >= other.words.count { (words, other.words) } else { (other.words, words) }
        var either = longer
        var i = 0
        let shared = shorter.count
        while i < shared {
            either[i] = longer[i] ^ shorter[i]
            i = i + 1
        }
        return BitSet(words: either)
    }

    /// Adds the other's members.
    public fn formUnion(_ other: BitSet) {
        if words.count < other.words.count {
            extend(to: other.words.count)
        }
        var i = 0
        while i < other.words.count {
            words[i] = words[i] | other.words[i]
            i += 1
        }
        members = BitSet.population(words)
    }

    /// Keeps only the members the other has too.
    public fn formIntersection(_ other: BitSet) {
        var i = 0
        while i < words.count {
            words[i] = i < other.words.count ? words[i] & other.words[i] : 0
            i += 1
        }
        members = BitSet.population(words)
    }

    /// Removes the other's members.
    public fn subtract(_ other: BitSet) {
        var i = 0
        while i < words.count && i < other.words.count {
            words[i] = words[i] & ~other.words[i]
            i += 1
        }
        members = BitSet.population(words)
    }

    /// Keeps the members in one set or the other, not both.
    public fn formSymmetricDifference(_ other: BitSet) {
        if words.count < other.words.count {
            extend(to: other.words.count)
        }
        var i = 0
        while i < other.words.count {
            words[i] = words[i] ^ other.words[i]
            i += 1
        }
        members = BitSet.population(words)
    }

    /// Whether every member of the other is one of this set's.
    public fn isSuperset(of other: BitSet) -> Bool {
        return other.isSubset(of: self)
    }

    /// Whether this set is a subset of the other, and smaller.
    public fn isStrictSubset(of other: BitSet) -> Bool {
        return members < other.members && isSubset(of: other)
    }

    /// Whether this set is a superset of the other, and larger.
    public fn isStrictSuperset(of other: BitSet) -> Bool {
        return other.isStrictSubset(of: self)
    }

    /// Whether the two sets have no member in common.
    ///
    /// ```sable
    /// assert(BitSet([1, 2]).isDisjoint(with: BitSet([3, 64])))
    /// ```
    public fn isDisjoint(with other: BitSet) -> Bool {
        var i = 0
        while i < words.count && i < other.words.count {
            if (words[i] & other.words[i]) != 0 {
                return false
            }
            i += 1
        }
        return true
    }

    /// The least member, or none when there are none: a word's trailing
    /// zeros, not a bit at a time.
    ///
    /// ```sable
    /// assert(BitSet([70, 3, 9]).min == 3)
    /// assert(BitSet().min == none)
    /// ```
    public var min: Int? {
        get {
            var i = 0
            while i < words.count {
                if words[i] != 0 {
                    return i * 64 + words[i].trailingZeroCount
                }
                i += 1
            }
            return none
        }
    }

    /// The greatest member, or none when there are none.
    ///
    /// ```sable
    /// assert(BitSet([70, 3, 9]).max == 70)
    /// ```
    public var max: Int? {
        get {
            var i = words.count - 1
            while i >= 0 {
                if words[i] != 0 {
                    return i * 64 + 63 - words[i].leadingZeroCount
                }
                i -= 1
            }
            return none
        }
    }

    /// The members within the range, ascending, a word at a time: those of
    /// `lowerBound` and above, below `upperBound`.
    ///
    /// ```sable
    /// let bits = BitSet([1, 5, 64, 100, 130])
    /// assert(bits.members(in: 5..<101) == [5, 64, 100])
    /// ```
    public fn members(in range: Range<Int>) -> Int[>..] {
        var found: Int[>..] = []
        var value = range.lowerBound < 0 ? 0 : range.lowerBound
        while value < range.upperBound && value >> 6 < words.count {
            var bits = words[value >> 6] >> U64(value & 63)
            if bits == 0 {
                value = ((value >> 6) + 1) << 6
                continue
            }
            value += bits.trailingZeroCount
            if value < range.upperBound {
                found.append(value)
            }
            value += 1
        }
        return found
    }
}

extension BitSet: Sequence, FromSequence<Int> {
    /// An iterator over the members, ascending.
    public fn makeIterator() -> BitSetIterator {
        return BitSetIterator { words: words, word: -1, bits: 0 }
    }
}

/// Gives a bit set's members, ascending, a word at a time. It holds the
/// set's words as they were when it was made.
public struct BitSetIterator: Iterator {
    let words: U64[>..]
    var word: Int

    // The current word's bits not given yet.
    var bits: U64

    /// The next member, or none past the largest.
    public mutating fn next() -> Int? {
        while bits == 0 {
            word += 1
            if word >= words.count {
                return none
            }
            bits = words[word]
        }

        let at = bits.trailingZeroCount
        bits = bits & (bits - 1)
        return word * 64 + at
    }
}
