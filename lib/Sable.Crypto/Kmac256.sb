module Sable.Crypto

/// KMAC256, SP 800-185: a message authentication code of any length from
/// Keccak, its length part of what it authenticates — a shorter code is not
/// the start of a longer one. A customization, text of the caller's, makes
/// the codes of one use no good for another.
///
/// ```sable
/// let key = SymmetricKey.random(byteCount: 32)
/// let message: U8[>..] = [1, 2, 3]
/// let code = Kmac256.authenticationCode(for: message, using: key)
/// assert(code.count == 64)
/// assert(Kmac256.isValid(code.bytes, for: message, using: key))
/// assert(!Kmac256.isValid(code.bytes, for: [1, 2], using: key))
/// ```
public struct Kmac256: Sendable {
    var sponge: Sponge

    /// A code begun under the key, which should have at least 32 bytes.
    public init(key: SymmetricKey, customization: U8[:] = []) {
        sponge = kmacSponge(rate: 136, key: key, customization: customization)
    }

    /// Authenticates the bytes after those already given.
    public mutating fn update(_ bytes: U8[:]) {
        sponge.update(bytes)
    }

    /// Authenticates the text's UTF-8 bytes after those already given.
    public mutating fn update(utf8 text: String) {
        var bytes: U8[>..] = []
        bytes.append(utf8: text)
        sponge.update(bytes)
    }

    /// The code, of so many bytes, of every byte given so far; more can
    /// still be given.
    public fn finalize(count: Int = 64) -> Digest {
        precondition(count >= 0, "a code of \(count) bytes")
        var ended = sponge
        ended.update(kmacRightEncode((count * 8) unchecked as U64))
        return Digest(taking: ended.output(count: count))
    }

    /// KMACXOF256: output of a length that is not fixed beforehand, and that
    /// the code does not cover.
    ///
    /// ```sable
    /// let key = SymmetricKey.random(byteCount: 32)
    /// var reader = Kmac256(key: key).reader()
    /// assert(reader.read(count: 100) != reader.read(count: 100))
    /// ```
    public fn reader() -> OutputReader {
        var ended = sponge
        ended.update(kmacRightEncode(0))
        return OutputReader(sponge: ended.finish(), rate: 136)
    }

    /// Whether the code, of whatever length, is that of every byte given so
    /// far, compared in constant time; more can still be given. One of fewer
    /// than 16 bytes never is. .NET's `VerifyCurrentHash`.
    ///
    /// ```sable
    /// var code = Kmac256(key: SymmetricKey.random(byteCount: 32))
    /// code.update(utf8: "a message")
    /// assert(code.isValid(code.finalize(count: 24).bytes))
    /// assert(!code.isValid(code.finalize(count: 32).bytes[..<24]))
    /// ```
    public fn isValid(_ code: U8[:]) -> Bool {
        return code.count >= 16 && constantTimeEquals(self.finalize(count: code.count).bytes, code)
    }

    /// Whether the code is that of every byte given so far, compared in
    /// constant time. One of fewer than 16 bytes never is.
    public fn isValid(_ code: Digest) -> Bool {
        return self.isValid(code.bytes)
    }

    /// Whether the output is the start of `reader()`'s, compared in constant
    /// time. Less than 16 bytes of it never is. .NET's `KmacXof256.Verify`.
    public fn isValidOutput(_ output: U8[:]) -> Bool {
        if output.count < 16 {
            return false
        }
        var reader = self.reader()
        return constantTimeEquals(reader.read(count: output.count), output)
    }

    /// The code of the bytes, at once.
    public static fn authenticationCode(
        for bytes: U8[:],
        using key: SymmetricKey,
        count: Int = 64,
        customization: U8[:] = []
    ) -> Digest {
        var code = Kmac256(key: key, customization: customization)
        code.update(bytes)
        return code.finalize(count: count)
    }

    /// Whether the code, of whatever length, is the bytes' under the key,
    /// compared in constant time. One of fewer than 16 bytes never is.
    public static fn isValid(
        _ code: U8[:],
        for bytes: U8[:],
        using key: SymmetricKey,
        customization: U8[:] = []
    ) -> Bool {
        var expected = Kmac256(key: key, customization: customization)
        expected.update(bytes)
        return expected.isValid(code)
    }

    /// Whether the code, of whatever length, is the bytes' under the key,
    /// compared in constant time. One of fewer than 16 bytes never is.
    public static fn isValid(
        _ code: Digest,
        for bytes: U8[:],
        using key: SymmetricKey,
        customization: U8[:] = []
    ) -> Bool {
        return Kmac256.isValid(code.bytes, for: bytes, using: key, customization: customization)
    }
}
