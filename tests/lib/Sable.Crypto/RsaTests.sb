module RsaTests

// RSA (Sable.Crypto): OpenSSL's keys and signatures, and what is refused. Run
// with tools/stdlib-coverage.sh Sable.Crypto; Wycheproof's are
// tools/conformance/publickey.

import Sable.Crypto
import Sable.Testing
import Sable.Text

fn hex(_ text: String) -> U8[>..] {
    return try! Hex.decode(text)
}

fn text(_ text: String) -> U8[>..] {
    return text.utf8.toArray()
}
