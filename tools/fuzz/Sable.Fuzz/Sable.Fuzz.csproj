<Project Sdk="Microsoft.NET.Sdk">
  <!-- The coverage-guided fuzzer: SharpFuzz targets for the parser, the front
       end, the package resolver and the package files, run by libFuzzer
       (through libfuzzer-dotnet) or by its own in-process loop.
       tools/fuzz/coverage.sh publishes it and instruments the Sable
       assemblies; Program.cs says how to run it by hand. It is not in
       Sable.slnx, so that an ordinary build does not need SharpFuzz; the
       nightly fuzz workflow builds it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Sable.Fuzz</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- One input at a time, on one thread: the workstation collector, without
         a background thread running while an input is timed. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Sable.SIL/Sable.SIL.csproj" />
    <ProjectReference Include="../../../src/Sable.Driver/Sable.Driver.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- What the test suites' fuzzers hold the compiler and the resolver to,
         shared so that the two kinds of fuzzer cannot drift apart. -->
    <Compile Include="../../../tests/Sable.SIL.Tests/FrontEndCheck.cs" Link="Shared/FrontEndCheck.cs" />
    <Compile Include="../../../tests/Sable.CodeGen.Tests/ResolverCheck.cs" Link="Shared/ResolverCheck.cs" />
  </ItemGroup>
</Project>
