module Sable.Collections

/// First in, first out: two stacks, the second refilled from the first
/// when it runs dry, so each element moves once.
public class Queue<Element> {
    var incoming: Element[>..] = []
    var outgoing: Element[>..] = []

    /// An empty queue.
    public init() { }

    /// The sequence's elements, enqueued in order: the first is at the
    /// front. What going through them throws, it throws.
    public init<S: Sequence>(_ elements: S) throws(S.Failure) where S.Element == Element {
        for try element in elements {
            incoming.append(element)
        }
    }

    /// How many elements it holds.
    public var count: Int => incoming.count + outgoing.count

    /// Whether it holds no elements.
    public var isEmpty: Bool => incoming.count + outgoing.count == 0

    /// Adds the element at the back.
    public fn enqueue(_ item: Element) {
        incoming.append(item)
    }

    /// Takes the front element out and gives it back, or none when empty.
    public fn dequeue() -> Element? {
        if outgoing.count == 0 {
            while incoming.count > 0 {
                outgoing.append(incoming.removeLast())
            }
        }
        if outgoing.count == 0 {
            return none
        }
        return outgoing.removeLast()
    }
}

extension Queue: Sequence, FromSequence<Element> {
    /// An iterator over the elements from the front to the back: the order
    /// 'dequeue' would give them, leaving the queue as it is.
    public fn makeIterator() -> ChainIterator<ReversedIterator<Element[>..]>, ArrayIterator<Element>> {
        return outgoing.reversed().chained(with: incoming).makeIterator()
    }
}
