module U64Tests

// U64 (Sable.Core): its limits, and the numeric protocols' operations at
// its width, at the limits. Run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

@test
fn theLimitsAreTheWidthsBounds() {
    assertEqual(U64.min, 0)
    assertEqual(U64.max, (U64.max - 0))
    assertEqual(U64.zero, 0)
    assertEqual(U64.one, 1)
    assertEqual(U64.bitWidth, 64)
    expect(!U64.isSigned, "U64 is unsigned")
}

@test
fn theLimitsPrintInDecimal() {
    assertEqual(U64.min.toString(), "0")
    assertEqual(U64.max.toString(), "18446744073709551615")
}

@test
fn addingPastTheGreatestValueWrapsSaturatesOrReportsIt() {
    assertEqual(U64.max.wrappingAdd(1), U64.min)
    assertEqual(U64.max.saturatingAdd(1), U64.max)
    expect(U64.max.checkedAdd(1) == none, "the sum does not fit")
    let (sum, overflowed) = U64.max.overflowingAdd(1)
    assertEqual(sum, U64.min)
    expect(overflowed, "the sum overflowed")
}

@test
fn subtractingPastTheLeastValueWrapsSaturatesOrReportsIt() {
    assertEqual(U64.min.wrappingSub(1), U64.max)
    assertEqual(U64.min.saturatingSub(1), U64.min)
    expect(U64.min.checkedSub(1) == none, "the difference does not fit")
    let (difference, overflowed) = U64.min.overflowingSub(1)
    assertEqual(difference, U64.max)
    expect(overflowed, "the difference overflowed")
}

@test
fn multiplyingPastTheLimitsWrapsSaturatesOrReportsIt() {
    assertEqual(U64.max.wrappingMul(2), U64.max - 1)
    assertEqual(U64.max.saturatingMul(2), U64.max)
    expect(U64.max.checkedMul(2) == none, "the product does not fit")
    let (product, overflowed) = U64.max.overflowingMul(2)
    assertEqual(product, U64.max - 1)
    expect(overflowed, "the product overflowed")
    let (high, low) = U64.max.multipliedFullWidth(by: U64.max)
    assertEqual(high, (U64.max - 1))
    assertEqual(low, 1)
}

@test
fn theBitCountsSeeEveryBit() {
    assertEqual(U64.zero.leadingZeroCount, 64)
    assertEqual(U64.zero.trailingZeroCount, 64)
    assertEqual(U64.one.leadingZeroCount, 63)
    assertEqual(U64.max.popCount, 64)
    assertEqual(U64((U64.max - 9223372036854775807)).trailingZeroCount, 63)
    assertEqual(U64.max.leadingOneCount, 64)
    assertEqual(U64.max.trailingOneCount, 64)
}

@test
fn rotationsAndSwapsWorkAtTheWidth() {
    assertEqual(U64.one.rotatedLeft(by: 64), 1)
    assertEqual(U64.one.rotatedRight(by: 1), (U64.max - 9223372036854775807))
    assertEqual(U64.one.rotatedLeft(by: -1), (U64.max - 9223372036854775807))
    assertEqual(U64.one.bitReversed, (U64.max - 9223372036854775807))
    assertEqual(U64(72623859790382856).byteSwapped, 578437695752307201)
    assertEqual(U64(72623859790382856).bigEndianBytes().count, 8)
    assertEqual(U64.fromBigEndianBytes(U64.max.bigEndianBytes()) ?? 0, U64.max)
    assertEqual(U64.fromLittleEndianBytes(U64.min.littleEndianBytes()) ?? 1, U64.min)
}

@test
fn conversionsStopAtTheLimits() {
    expect(U64.exactly(U128.max) == none, "only a U128 holds U128's greatest value")
    expect(U64.exactly(I128.min) == none, "only an I128 holds I128's least value")
    assertEqual(U64.clamping(U128.max), U64.max)
    assertEqual(U64.clamping(I128.min), U64.min)
    assertEqual(U64.truncating(U128.max), U64.max)
    assertEqual(U64.exactly(U64.max) ?? 0, U64.max)
}

@test
fn theRemainderOfTheLeastValueByMinusOneIsZero() {
    assertEqual(U64.max.wrappingDiv(U64.max), 1)
    assertEqual(U64.max.wrappingRem(2), 1)
    expect(U64.max.checkedDiv(0) == none, "there is no quotient by zero")
}

@test(traps: "integer overflow")
fn addingPastTheGreatestValueTraps() {
    var x = U64.max
    x = x + 1
    assertEqual(x, 0)
}

@test(traps: "integer overflow")
fn subtractingPastTheLeastValueTraps() {
    var x = U64.min
    x = x - 1
    assertEqual(x, 0)
}

@test
fn negatingAnUnsignedValueWrapsOrSaturates() {
    assertEqual(U64.one.wrappingNeg(), U64.max)
    assertEqual(U64.one.saturatingNeg(), 0)
    expect(U64.one.checkedNeg() == none, "an unsigned type has no -1")
    assertEqual(U64.zero.checkedNeg() ?? 1, 0)
    assertEqual(U64.max.abs(), U64.max)
}
