module FileTests

// File (Sable.IO): copied, renamed, moved, linked, asked about and removed,
// all of it in directories the tests make. FileMetadata, FileKind and
// FilePermissions with it.

import IoSupport
import Sable.IO
import Sable.Process
import Sable.Testing
import Sable.Time

fn text(_ path: FilePath) -> String {
    return (try? File.read(path)) ?? "nothing"
}

// Whether symbolic links may be made here: not by every user of Windows.
fn linksMayBeMade(_ directory: FilePath) -> Bool {
    let link = directory.appending("may-link")
    if (try? File.createSymlink(at: link, to: "nowhere")) == none {
        return false
    }
    try! File.remove(link)
    return true
}

@test
fn aCopyHasTheBytesAndThePermissions(temp: TemporaryFiles) throws {
    let from = temp.path.appending("from.bin")
    let to = temp.path.appending("to.bin")
    var bytes: U8[>..] = []
    var i = 0
    while i < 100000 {
        bytes.append(U8.truncating(i * 31))
        i += 1
    }
    try File.writeBytes(from, bytes)
    try File.setPermissions(from, FilePermissions(mode: 0o444))
    try File.copy(from: from, to: to)
    expect(try File.readBytes(to) == bytes)
    expect((try File.metadata(to)).permissions.isReadOnly)

    // Over a file there, which gets the permissions too.
    let other = temp.path.appending("other.bin")
    try File.write(other, "a longer text than the one that replaces it, so that its end would show")
    let short = temp.path.appending("short.bin")
    try File.write(short, "short")
    try File.setPermissions(short, (try File.metadata(short)).permissions.readOnly())
    try File.copy(from: short, to: other)
    assertEqual(text(other), "short")
    expect((try File.metadata(other)).permissions.isReadOnly)
    try File.setPermissions(short, (try File.metadata(short)).permissions.writable())
}

@test
fn aCopyThatMayNotReplaceIsAnError(temp: TemporaryFiles) throws {
    let from = temp.path.appending("from")
    let to = temp.path.appending("to")
    try File.write(from, "from")
    try File.write(to, "to")
    expectIoError("AlreadyExists", "it replaced one there") {
        try File.copy(from: from, to: to, overwrite: false)
    }
    assertEqual(text(to), "to")
    try File.copy(from: from, to: temp.path.appending("new"), overwrite: false)
    assertEqual(text(temp.path.appending("new")), "from")
}

@test
fn aFileCopiedToItselfIsLeftAsItWas(temp: TemporaryFiles) throws {
    let path = temp.path.appending("one")
    let again = temp.path.appending("again")
    try File.write(path, "kept")
    try File.createHardLink(at: again, to: path)
    for target in [path, again] {
        expectIoError("InvalidInput", "it was copied to itself") {
            try File.copy(from: path, to: target)
        }
        assertEqual(text(path), "kept")
    }
}

@test
fn whatIsNoFileIsNotCopied(temp: TemporaryFiles) throws {
    expectIoError("IsDirectory", "a directory was copied as a file") {
        try File.copy(from: temp.path, to: temp.path.appending("to"))
    }
    expectIoError("NotFound", "nothing was copied") {
        try File.copy(from: temp.path.appending("missing"), to: temp.path.appending("to"))
    }
    expect(!File.exists(temp.path.appending("to")))
}

@test
fn aRenameReplacesOrRefuses(temp: TemporaryFiles) throws {
    let a = temp.path.appending("a")
    let b = temp.path.appending("b")
    try File.write(a, "a")
    try File.write(b, "b")
    expectIoError("AlreadyExists", "it replaced one there") {
        try File.rename(from: a, to: b, overwrite: false)
    }
    assertEqual(text(b), "b")
    try File.rename(from: a, to: b)
    assertEqual(text(b), "a")
    expect(!File.exists(a))
    try File.rename(from: b, to: a, overwrite: false)
    assertEqual(text(a), "a")
    // A directory too.
    try Directory.create(temp.path.appending("d/e"), recursive: true)
    try File.rename(from: temp.path.appending("d"), to: temp.path.appending("f"))
    expect(Directory.exists(temp.path.appending("f/e")))
    expectIoError("NotFound", "nothing was renamed") {
        try File.rename(from: temp.path.appending("missing"), to: a)
    }
}

@test
fn aMoveIsARename(temp: TemporaryFiles) throws {
    let a = temp.path.appending("a")
    let b = temp.path.appending("b")
    try File.write(a, "a")
    try File.move(from: a, to: b)
    assertEqual(text(b), "a")
    try File.write(a, "again")
    expectIoError("AlreadyExists", "it replaced one there") {
        try File.move(from: a, to: b, overwrite: false)
    }
    try File.move(from: a, to: b)
    assertEqual(text(b), "again")
}

@test
fn metadataSaysWhatIsThere(temp: TemporaryFiles) throws {
    let path = temp.path.appending("file")
    let before = UtcDateTime.now().secondsSinceEpoch - 5
    try File.write(path, "twelve bytes")
    let metadata = try File.metadata(path)
    assertEqual(metadata.size, 12)
    expect(metadata.isFile && !metadata.isDirectory && !metadata.isSymlink)
    expect(metadata.kind == FileKind.File)
    expect(metadata.modified.secondsSinceEpoch >= before)
    expect(metadata.accessed.secondsSinceEpoch >= before)
    // Linux keeps it on some file systems alone.
    #if os(linux)
    #else
    expect(metadata.created != none)
    #endif
    if let created = metadata.created {
        expect(created.secondsSinceEpoch >= before)
        // When it was written does not change when it was made.
        try File.setModified(path, UtcDateTime.fromUnix(4_000_000_000))
        expect((try File.metadata(path)).created == created)
        try File.setModified(path, metadata.modified)
    }
    expect(!metadata.permissions.isReadOnly)
    let opened = try File.open(path)
    let same = try opened.metadata()
    assertEqual(same.size, 12)
    expect(same.kind == FileKind.File && same.modified == metadata.modified)
    opened.close()

    expect((try File.metadata("\(temp.path)")).isDirectory)
    expectIoError("NotFound", "nothing has metadata") {
        _ = try File.metadata(temp.path.appending("missing"))
    }
}

@test
fn timesAndPermissionsAreSet(temp: TemporaryFiles) throws {
    let path = temp.path.appending("file")
    try File.write(path, "x")
    let then = UtcDateTime { secondsSinceEpoch: 1234567890, nanosecond: 123456700 }
    try File.setModified(path, then)
    expect((try File.metadata(path)).modified == then)
    try File.setAccessed(path, UtcDateTime.fromUnix(1000))
    let metadata = try File.metadata(path)
    expect(metadata.accessed == UtcDateTime.fromUnix(1000))
    expect(metadata.modified == then)
    // Before 1970 as well.
    let old = UtcDateTime { secondsSinceEpoch: -100, nanosecond: 500000000 }
    try File.setModified(path, old)
    expect((try File.metadata(path)).modified == old)

    try File.setPermissions(path, FilePermissions(mode: 0o400))
    expect((try File.metadata(path)).permissions.isReadOnly)
    try File.setPermissions(path, FilePermissions(mode: 0o640))
    let given = (try File.metadata(path)).permissions
    expect(!given.isReadOnly)
    #if os(windows)
    #else
    assertEqual(given.mode, 0o640)
    #endif

    let missing = temp.path.appending("missing")
    expectIoError("NotFound", "nothing was written") {
        try File.setModified(missing, then)
    }
    expectIoError("NotFound", "nothing has permissions") {
        try File.setPermissions(missing, given)
    }
}

@test(arguments: [(0o644, "rw-r--r--"), (0o751, "rwxr-x--x"), (0, "---------")])
fn permissionsAreWrittenAsLsWritesThem(_ mode: Int, _ text: String) {
    expect("\(FilePermissions(mode: mode))" == text)
}

@test
fn permissionsAreGivenAndTaken() {
    assertEqual("\(FilePermissions(mode: 0o644):12)".count, 12)
    expect(FilePermissions(mode: 0o644).executable() == FilePermissions(mode: 0o755))
    expect(FilePermissions(mode: 0o444).writable() == FilePermissions(mode: 0o644))
    expect(FilePermissions(mode: 0o111).isExecutable && !FilePermissions(mode: 0o666).isExecutable)
    assertEqual(FilePermissions(mode: 0o600).debugDescription(), "FilePermissions(rw-------)")
    assertEqual(FilePermissions(mode: 0o600).hashValue, FilePermissions(mode: 0o100600).hashValue)
}

@test
fn aHardLinkIsTheFile(temp: TemporaryFiles) throws {
    let path = temp.path.appending("file")
    let other = temp.path.appending("other")
    try File.write(path, "one")
    try File.createHardLink(at: other, to: path)
    try File.append(other, " more")
    assertEqual(text(path), "one more")
    try File.remove(path)
    assertEqual(text(other), "one more")
    expectIoError("NotFound", "nothing was linked") {
        try File.createHardLink(at: path, to: temp.path.appending("missing"))
    }
    expectIoError("AlreadyExists", "one there was replaced") {
        try File.createHardLink(at: other, to: other)
    }
}

@test
fn aSymbolicLinkLeadsToItsTarget(temp: TemporaryFiles) throws {
    try skip(if: !linksMayBeMade(temp.path), "symbolic links may not be made here")
    let path = temp.path.appending("file")
    let link = temp.path.appending("link")
    try File.write(path, "text")
    try File.createSymlink(at: link, to: "file")
    assertEqual(text(link), "text")
    expect(try File.readLink(link) == FilePath("file"))
    expect((try File.metadata(link)).isFile)
    let itself = try File.metadata(link, followLinks: false)
    expect(itself.isSymlink && itself.kind == FileKind.SymbolicLink)
    expect(try link.canonical() == try path.canonical())
    // Removed itself, and not what it leads to.
    try File.remove(link)
    assertEqual(text(path), "text")

    // To a directory, and to nothing.
    let inside = temp.path.appending("inside")
    try Directory.create(inside)
    try File.createSymlink(at: link, to: inside)
    expect(Directory.exists(link) && !File.exists(link))
    try File.write(link.appending("x"), "x")
    assertEqual(text(inside.appending("x")), "x")
    try File.remove(link)
    assertEqual(text(inside.appending("x")), "x")
    try File.createSymlink(at: link, to: temp.path.appending("nowhere"))
    expect(!File.exists(link) && !Directory.exists(link))
    expectIoError("NotFound", "it leads nowhere") {
        _ = try File.metadata(link)
    }
    expect((try File.metadata(link, followLinks: false)).isSymlink)
    expectIoError("AlreadyExists", "one there was replaced") {
        try File.createSymlink(at: link, to: "file")
    }
    try File.rename(from: link, to: temp.path.appending("moved"))
    expect(try File.readLink(temp.path.appending("moved")) == temp.path.appending("nowhere"))
    expectIoError("InvalidInput", "a file is no link") {
        _ = try File.readLink(path)
    }
}

@test
fn onlyWhatIsNamedIsRemoved(temp: TemporaryFiles) throws {
    let directory = temp.path.appending("d")
    try Directory.create(directory)
    expectIoError("IsDirectory", "a directory was removed as a file") {
        try File.remove(directory)
    }
    expectIoError("NotFound", "nothing was removed") {
        try File.remove(temp.path.appending("missing"))
    }
    for path in ["", ".", "..", "\(directory)/.."] {
        expectIoError("InvalidInput", "'\(path)' was removed") {
            try File.remove(path)
        }
    }
    expect(Directory.exists(directory))
    // A NUL would cut the path short.
    let file = temp.path.appending("file")
    try File.write(file, "kept")
    expectIoError("InvalidInput", "a path with a NUL named something") {
        try File.remove("\(file)\0/inside")
    }
    assertEqual(text(file), "kept")
    expect(!File.exists("\(file)\0"))
}

@test
fn aFileIsReadAndAddedTo(temp: TemporaryFiles) throws {
    let path = temp.path.appending("file")
    try File.write(path, "one\r\ntwo\n")
    try File.append(path, "three")
    expect(try File.readLines(path) == ["one", "two", "three"])
    try File.appendBytes("\(path)", [0xFF])
    assertEqual(try File.read(path), "one\r\ntwo\nthree\u{FFFD}")
    for missing in ["", "\(path)-missing", "\(path)/inside"] {
        expectIoError("NotFound", "nothing was read") {
            _ = try File.readBytes(missing)
        }
    }
}

// Across file systems, where a machine of most kinds has two.
@test
fn aMoveBetweenFileSystemsIsACopy(temp: TemporaryFiles) throws {
    try skip(if: !Directory.exists("/dev/shm"), "there is no second file system")
    let other = try Temp.directory(in: FilePath("/dev/shm"))
    let a = temp.path.appending("a")
    let b = other.path.appending("b")
    try File.write(a, "a")
    try File.setPermissions(a, FilePermissions(mode: 0o640))
    try File.setModified(a, UtcDateTime.fromUnix(1000))
    try File.move(from: a, to: b)
    assertEqual(text(b), "a")
    expect(!File.exists(a))
    let metadata = try File.metadata(b)
    assertEqual(metadata.permissions.mode, 0o640)
    expect(metadata.modified == UtcDateTime.fromUnix(1000))
    try File.write(a, "again")
    expectIoError("AlreadyExists", "it replaced one there") {
        try File.move(from: a, to: b, overwrite: false)
    }
    assertEqual(text(b), "a")
    expect(try Directory.list(other.path) == ["b"])
    try File.createSymlink(at: temp.path.appending("link"), to: "nowhere")
    try File.move(from: temp.path.appending("link"), to: other.path.appending("link"))
    expect(try File.readLink(other.path.appending("link")) == FilePath("nowhere"))
    try Directory.create(temp.path.appending("d"))
    expectIoError("CrossesFileSystems", "a directory was moved") {
        try File.move(from: temp.path.appending("d"), to: other.path.appending("d"))
    }
}

#if os(windows)
// A link to a directory that anyone may make, and the system's own.
@test
fn aJunctionIsALink(temp: TemporaryFiles) async throws {
    let outside = temp.path.appending("outside")
    let tree = temp.path.appending("tree")
    try Directory.create(outside)
    try Directory.create(tree)
    try File.write(outside.appending("kept"), "kept")
    let link = tree.appending("link")
    expect((try await Command("cmd").arguments(["/c", "mklink", "/J", "\(link)", "\(outside)"]).output()).status.success)
    expect((try File.metadata(link, followLinks: false)).isSymlink)
    expect((try File.metadata(link)).isDirectory)
    expect(try File.readLink(link) == outside)
    for try entry in try Directory.walk(tree) {
        assertEqual(entry.name, "link")
        expect(entry.isSymlink, entry.name)
    }
    try Directory.remove(tree, recursive: true)
    expect(!Directory.exists(tree))
    assertEqual(text(outside.appending("kept")), "kept")
}
#else
@test
fn aFifoIsNoFileToCopy(temp: TemporaryFiles) async throws {
    let fifo = temp.path.appending("fifo")
    expect((try await Command("mkfifo").argument("\(fifo)").status()).success)
    expect((try File.metadata(fifo)).kind == FileKind.Fifo)
    for try entry in try Directory.entries(temp.path) {
        assertEqual(entry.kind, FileKind.Fifo)
    }
    expectIoError("InvalidInput", "a FIFO was copied") {
        try File.copy(from: fifo, to: temp.path.appending("to"))
    }
    expectIoError("InvalidInput", "a FIFO was copied with its directory") {
        try Directory.copy(from: temp.path, to: "\(temp.path)-copy")
    }
    try Directory.remove("\(temp.path)-copy", recursive: true)
    try File.remove(fifo)
}

@test
fn aDeviceIsOne() throws {
    expect((try File.metadata("/dev/null")).kind == FileKind.CharacterDevice)
}

@test
fn aPathNeedNotBeUtf8(temp: TemporaryFiles) throws {
    // macOS's own file systems take no other.
    #if os(linux)
    let path = temp.path.appending(FilePath(bytes: [0x61, 0xFF]))
    try File.write(path, "x")
    for try entry in try Directory.entries(temp.path) {
        assertEqual(entry.path.bytes, path.bytes)
        try File.remove(entry.path)
    }
    expect(try Directory.list(temp.path) == [])
    #endif
}
#endif
