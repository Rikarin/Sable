module Sable.Process

import Sable.IO

/// A child's standard input: what is written to it, the child reads. A
/// write suspends the task while the pipe is full, not its thread. Deeply
/// immutable, so Sendable: one task may write it while another reads what
/// the child writes. Closed as it goes, or by `close()`: the child then
/// reads to its end.
@immutable
public final class ChildInput: AsyncWriter {
    let handle: Int

    init(handle: Int) {
        self.handle = handle
    }

    deinit {
        Runtime.closeSocket(handle)
    }

    /// Every one of the bytes written, waiting while the child is slow to
    /// read them. A child that stopped reading throws Disconnected; a task
    /// cancelled, Cancelled, some of them written perhaps.
    public fn write(_ bytes: U8[:]) async throws(IoError) {
        var from = 0
        while from < bytes.count {
            let written = Runtime.writeSocket(handle, bytes[from...])
            if Runtime.socketStatus() == 0 {
                from += written
            } else {
                try await waitForPipe(handle, writable: true)
            }
        }
    }

    /// The text written, as UTF-8.
    public fn write(_ text: String) async throws(IoError) {
        try await write(text.utf8.toArray())
    }

    /// Nothing more is written: the child reads to its end.
    public fn close() {
        Runtime.closeSocket(handle)
    }
}

/// Waits for the pipe, once a call on it has found it would block; or
/// throws, if the call failed, or the task is cancelled.
fn waitForPipe(_ handle: Int, writable: Bool) async throws(IoError) {
    if Runtime.socketStatus() != 1 {
        throw IoError.Disconnected
    }
    if Task.isCancelled {
        throw IoError.Cancelled
    }
    await Runtime.waitForSocket(handle, writable: writable)
    if Task.isCancelled {
        throw IoError.Cancelled
    }
}
