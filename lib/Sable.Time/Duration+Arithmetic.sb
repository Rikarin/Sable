module Sable.Time

// A duration's arithmetic: the operators, which trap where a result does
// not fit, and the checked and saturating forms, which do not. By an F64 it
// is exact, then rounded once to the nanosecond: the product is made in 128
// bits from the float's own.

extension Duration: AdditiveArithmetic {
    /// The sum; traps where it does not fit, as the other operators do.
    public operator + (a: Duration, b: Duration) -> Duration {
        return Duration { totalNanoseconds: a.totalNanoseconds + b.totalNanoseconds }
    }

    /// The difference.
    public operator - (a: Duration, b: Duration) -> Duration {
        return Duration { totalNanoseconds: a.totalNanoseconds - b.totalNanoseconds }
    }
}

extension Duration {
    /// As long the other way.
    public prefix operator - (a: Duration) -> Duration {
        return Duration { totalNanoseconds: 0 - a.totalNanoseconds }
    }

    /// So many times as long.
    public operator * (a: Duration, factor: Int) -> Duration {
        return Duration { totalNanoseconds: a.totalNanoseconds * factor }
    }

    /// So many times as long.
    public operator * (factor: Int, a: Duration) -> Duration {
        return a * factor
    }

    /// So many times as long, to the nearest nanosecond, the even one of
    /// two as near. Traps where it does not fit, or for NaN.
    public operator * (a: Duration, factor: F64) -> Duration {
        if let product = a.checkedMul(factor) {
            return product
        }
        fatalError("a duration times \(factor) does not fit")
    }

    /// So many times as long, to the nearest nanosecond.
    public operator * (factor: F64, a: Duration) -> Duration {
        return a * factor
    }

    /// The part of it, rounded towards zero. Traps for a divisor of zero.
    public operator / (a: Duration, divisor: Int) -> Duration {
        return Duration { totalNanoseconds: a.totalNanoseconds / divisor }
    }

    /// How many times as long as the other it is, with the fraction: an
    /// infinity or NaN for another of no time.
    ///
    /// ```sable
    /// assert(Duration.seconds(1) / Duration.milliseconds(400) == 2.5)
    /// ```
    public operator / (a: Duration, b: Duration) -> F64 {
        return F64(a.totalNanoseconds) / F64(b.totalNanoseconds)
    }

    /// What is left of it after as many whole ones of the other as it
    /// holds, of its own sign. Traps for another of no time.
    public operator % (a: Duration, b: Duration) -> Duration {
        return Duration { totalNanoseconds: a.totalNanoseconds % b.totalNanoseconds }
    }

    /// As long, forwards. Traps for `min`.
    public var magnitude: Duration => totalNanoseconds < 0 ? -self : self

    /// How many whole ones of the other it holds, rounded towards zero.
    /// Traps for another of no time.
    ///
    /// ```sable
    /// assert(Duration.seconds(10).count(of: .seconds(3)) == 3)
    /// ```
    public fn count(of other: Duration) -> Int {
        return totalNanoseconds / other.totalNanoseconds
    }

    // ---- checked: none where the result does not fit -------------------

    /// The sum, or none where it does not fit.
    ///
    /// ```sable
    /// assert(Duration.max.checkedAdd(.nanoseconds(1)) == none)
    /// assert(Duration.max.saturatingAdd(.nanoseconds(1)) == Duration.max)
    /// ```
    public fn checkedAdd(_ other: Duration) -> Duration? {
        return made(totalNanoseconds.checkedAdd(other.totalNanoseconds))
    }

    /// The difference, or none where it does not fit.
    public fn checkedSub(_ other: Duration) -> Duration? {
        return made(totalNanoseconds.checkedSub(other.totalNanoseconds))
    }

    /// The product, or none where it does not fit.
    public fn checkedMul(_ factor: Int) -> Duration? {
        return made(totalNanoseconds.checkedMul(factor))
    }

    /// The product to the nearest nanosecond, the even one of two as near;
    /// none where it does not fit, or for NaN.
    public fn checkedMul(_ factor: F64) -> Duration? {
        return made(scaled(totalNanoseconds, factor))
    }

    /// The quotient, rounded towards zero; none for a divisor of zero, or
    /// where it does not fit.
    public fn checkedDiv(_ divisor: Int) -> Duration? {
        return made(totalNanoseconds.checkedDiv(divisor))
    }

    /// As long the other way, or none where that does not fit: for `min`.
    public fn checkedNeg() -> Duration? {
        return made(totalNanoseconds.checkedNeg())
    }

    /// As long, forwards, or none where that does not fit: for `min`.
    public fn checkedAbs() -> Duration? {
        return made(totalNanoseconds.checkedAbs())
    }

    fn made(_ nanoseconds: Int?) -> Duration? {
        if let nanoseconds = nanoseconds {
            return Duration { totalNanoseconds: nanoseconds }
        }
        return none
    }

    // ---- saturating: the nearest there is where it does not fit --------

    /// The sum, or `max` or `min` where it does not fit.
    public fn saturatingAdd(_ other: Duration) -> Duration {
        return Duration { totalNanoseconds: totalNanoseconds.saturatingAdd(other.totalNanoseconds) }
    }

    /// The difference, or `max` or `min` where it does not fit.
    public fn saturatingSub(_ other: Duration) -> Duration {
        return Duration { totalNanoseconds: totalNanoseconds.saturatingSub(other.totalNanoseconds) }
    }

    /// The product, or `max` or `min` where it does not fit.
    public fn saturatingMul(_ factor: Int) -> Duration {
        return Duration { totalNanoseconds: totalNanoseconds.saturatingMul(factor) }
    }

    /// The product to the nearest nanosecond, or `max` or `min` where it
    /// does not fit; no time for NaN.
    public fn saturatingMul(_ factor: F64) -> Duration {
        if let product = checkedMul(factor) {
            return product
        }
        if factor.isNaN || totalNanoseconds == 0 {
            return Duration.zero
        }
        return (factor < 0.0) == (totalNanoseconds < 0) ? Duration.max : Duration.min
    }

    /// As long the other way; `max` for `min`.
    public fn saturatingNeg() -> Duration {
        return Duration.zero.saturatingSub(self)
    }

    /// As long, forwards; `max` for `min`.
    public fn saturatingAbs() -> Duration {
        return totalNanoseconds < 0 ? saturatingNeg() : self
    }

    // ---- Rounding ------------------------------------------------------

    /// Rounded to a multiple of the unit: to the nearest, a half away from
    /// zero, unless the rule says otherwise. Traps for a unit not above
    /// zero, and where the multiple does not fit.
    ///
    /// ```sable
    /// assert(Duration.milliseconds(1500).rounded(to: .seconds(1)) == Duration.seconds(2))
    /// assert(Duration.milliseconds(-1500).rounded(to: .seconds(1), .Up) == Duration.seconds(-1))
    /// ```
    public fn rounded(to unit: Duration, _ rule: RoundingRule = .ToNearestOrAwayFromZero) -> Duration {
        if let multiple = checkedRounded(to: unit, rule) {
            return multiple
        }
        fatalError("a duration rounded does not fit")
    }

    /// Rounded to a multiple of the unit, towards zero, which always fits.
    /// Traps for a unit not above zero.
    public fn truncated(to unit: Duration) -> Duration {
        precondition(unit.totalNanoseconds > 0, "a duration is rounded to a unit above zero")
        return Duration { totalNanoseconds: totalNanoseconds - totalNanoseconds % unit.totalNanoseconds }
    }

    /// Rounded to a multiple of the unit, or none where that does not fit.
    /// Traps for a unit not above zero.
    public fn checkedRounded(to unit: Duration, _ rule: RoundingRule = .ToNearestOrAwayFromZero) -> Duration? {
        let towardZero = truncated(to: unit)
        let rest = (totalNanoseconds % unit.totalNanoseconds).abs()
        if rest == 0 {
            return self
        }
        // Both are under the unit, so neither overflows.
        let missing = unit.totalNanoseconds - rest
        let away = match rule {
            case .TowardZero              => false
            case .AwayFromZero            => true
            case .Up                      => totalNanoseconds > 0
            case .Down                    => totalNanoseconds < 0
            case .ToNearestOrAwayFromZero => rest >= missing
            case .ToNearestOrEven         => rest > missing || rest == missing && totalNanoseconds / unit.totalNanoseconds % 2 != 0
        }
        if !away {
            return towardZero
        }
        return totalNanoseconds < 0 ? towardZero.checkedSub(unit) : towardZero.checkedAdd(unit)
    }
}

/// n * factor to the nearest integer, the even one of two as near; none
/// where it does not fit, or for a factor that is no finite number.
fn scaled(_ n: Int, _ factor: F64) -> Int? {
    if !factor.isFinite {
        return none
    }
    if n == 0 || factor == 0.0 {
        return 0
    }
    // The factor is significand * 2^exponent, exactly.
    let bits = factor.bits
    let field = Int((bits >> 52) & 0x7ff)
    let fraction = bits & 0xfffffffffffff
    let significand = field == 0 ? fraction : fraction | 0x10000000000000
    let exponent = field == 0 ? -1074 : field - 1075
    let negative = (factor < 0.0) != (n < 0)
    // Under 2^63 * 2^53, and 2^63 itself times it.
    var product = U128(n.magnitude) * U128(significand)
    if exponent >= 0 {
        // A significand at least 2^52: past 2^11 it does not fit, and up
        // to that there is room.
        if exponent > 11 {
            return none
        }
        product = product << U128(exponent)
    } else if exponent < -119 {
        // Less than half of one.
        product = 0
    } else {
        let shift = U128(0 - exponent)
        let rest = product & ((U128.one << shift) - 1)
        let half = U128.one << (shift - 1)
        product = product >> shift
        if rest > half || rest == half && product % 2 == 1 {
            product += 1
        }
    }
    return signedInt(product, negative)
}

/// The magnitude with its sign, or none where that is no Int.
fn signedInt(_ magnitude: U128, _ negative: Bool) -> Int? {
    if negative {
        // Int.min's is one more than Int.max's.
        return magnitude > 0x8000000000000000 ? none : Int.truncating(0 - I128(magnitude))
    }
    return magnitude > 0x7fffffffffffffff ? none : Int(magnitude)
}
