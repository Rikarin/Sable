module Pbkdf2Bench

// PBKDF2 against .NET's Rfc2898DeriveBytes.Pbkdf2: SHA-256's and SHA-512's,
// two hundred thousand iterations of each.

import Sable.Crypto

@main
fn main() {
    let password = SymmetricKey(U8[>..](repeating: 7, count: 20))
    let salt = U8[>..](repeating: 9, count: 16)
    let a = (try! Pbkdf2<Sha256>.deriveKey(from: password, salt: salt, iterations: 200_000, byteCount: 32)).bytes()
    let b = (try! Pbkdf2<Sha512>.deriveKey(from: password, salt: salt, iterations: 200_000, byteCount: 64)).bytes()
    var total = 0
    for byte in a {
        total = total * 31 % 1_000_003 + Int(byte)
    }
    for byte in b {
        total = total * 31 % 1_000_003 + Int(byte)
    }
    print(total)
}
