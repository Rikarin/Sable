module Sable.Core

// Sorting an array: in place, 'sort', or into an array of its own,
// 'sorted' (docs/06's pairing). Every kind of array has these. The sort is
// stable — elements neither goes before keep their order — and is a merge
// sort, O(n log n) comparisons, with one scratch array of the array's size.

extension<Element> Element[:] {
    /// Sorts the elements in place by 'before', which says whether its
    /// first argument goes ahead of its second: a stable merge sort.
    ///
    /// Runs of 16 are put in order by insertion first; then runs are
    /// merged pairwise, back and forth between the array and one scratch
    /// array, until one run is left — a run already in order with the next
    /// is copied, not merged. The merge does not branch on 'before': it
    /// moves the element the comparison picks and steps both indices by it,
    /// taking from the left run on a tie.
    ///
    /// ```sable
    /// var words: String[>..] = ["pear", "fig", "banana"]
    /// words.sort(by: (a: String, b: String) => a.count < b.count)
    /// assert(words == ["fig", "pear", "banana"])
    /// ```
    public mutating fn sort(by before: (Element, Element) -> Bool) {
        let n = self.count
        if n < 2 {
            return
        }

        let run = 16
        var start = 0
        while start < n {
            let end = start + run < n ? start + run : n
            var i = start + 1
            while i < end {
                let held = self[i]
                var j = i
                while j > start && before(held, self[j - 1]) {
                    self[j] = self[j - 1]
                    j = j - 1
                }
                if j != i {
                    self[j] = held
                }
                i = i + 1
            }
            start = end
        }
        if n <= run {
            return
        }

        // The scratch array shares the buffer until the first pass writes
        // to it, which copies it: the one allocation the sort makes.
        var scratch: Element[:] = self
        var inScratch = false
        var width = run
        while width < n {
            if inScratch {
                self.mergeRuns(of: width, from: scratch, by: before)
            } else {
                scratch.mergeRuns(of: width, from: self, by: before)
            }
            inScratch = !inScratch
            width = width * 2
        }
        if inScratch {
            self.copy(from: scratch)
        }
    }

    /// Every pair of runs of 'width' in 'source', merged into one run of
    /// twice the width here, at the same place; 'source' has as many
    /// elements as this.
    mutating fn mergeRuns(of width: Int, from source: Element[:], by before: (Element, Element) -> Bool) {
        let n = source.count
        var low = 0
        while low < n {
            let middle = low + width < n ? low + width : n
            let high = middle + width < n ? middle + width : n
            var k = low
            if middle >= high || !before(source[middle], source[middle - 1]) {
                while k < high {
                    self[k] = source[k]
                    k = k + 1
                }
            } else {
                var x = low
                var y = middle
                while x < middle && y < high {
                    let takeRight = before(source[y], source[x])
                    self[k] = source[takeRight ? y : x]
                    let step = takeRight ? 1 : 0
                    y = y + step
                    x = x + 1 - step
                    k = k + 1
                }
                while x < middle {
                    self[k] = source[x]
                    x = x + 1
                    k = k + 1
                }
                while y < high {
                    self[k] = source[y]
                    y = y + 1
                    k = k + 1
                }
            }
            low = high
        }
    }

    /// The elements ordered by 'before', in an array of their own: a stable
    /// merge sort.
    public fn sorted(by before: (Element, Element) -> Bool) -> Element[>..] {
        var result = self.toArray()
        result.sort(by: before)
        return result
    }
}

extension<Element: Comparable> Element[:] {
    /// Sorts the elements in place, ascending: a stable merge sort.
    ///
    /// ```sable
    /// var xs: Int[>..] = [5, 3, 9, 1]
    /// xs.sort()
    /// assert(xs == [1, 3, 5, 9])
    /// ```
    public mutating fn sort() {
        self.sort(by: (a: Element, b: Element) => a < b)
    }

    /// The elements in ascending order, in an array of their own: a stable
    /// merge sort.
    public fn sorted() -> Element[>..] {
        var result = self.toArray()
        result.sort()
        return result
    }
}
