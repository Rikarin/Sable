module FileCopyBench

import Sable.IO
import Sable.Testing

// File.copy: a thousand copies of a file of four thousand bytes and ten of
// one of four million, each over the copy before, which is then asked its
// size; and the last read.
// The paths are absolute, as resolving a relative one is costly in .NET.

fn run(_ small: FilePath, _ large: FilePath, _ copy: FilePath) throws(IoError) -> String {
    var total = 0
    for _ in 0..<1000 {
        try File.copy(from: small, to: copy)
        total += (try File.metadata(copy)).size
    }
    for _ in 0..<10 {
        try File.copy(from: large, to: copy)
        total += (try File.metadata(copy)).size
    }
    let last = try File.readBytes(copy)
    return "\(total) \(last.count) \(last[last.count - 1])"
}

@bench
fn measure(_ b: Bencher) {
    let small = FilePath("file-copy-sable-small.bin").absolute()
    let large = FilePath("file-copy-sable-large.bin").absolute()
    let copy = FilePath("file-copy-sable-copy.bin").absolute()
    try! File.writeBytes(small, U8[>..](repeating: 7, count: 4000))
    try! File.writeBytes(large, U8[>..](repeating: 9, count: 4000000))
    b.check(b.iterate { try! run(small, large, copy) })
    try! File.remove(small)
    try! File.remove(large)
    try! File.remove(copy)
}
