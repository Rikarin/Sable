module Vector3Tests

import Sable.Math.Geometry
import Sable.Serialize
import Sable.Testing

let a: Vector3 = Vector3(1, 5, -3)
let b: Vector3 = Vector3(4, 2, 0.5)

@test
fn itsLayoutIsItsComponentsInOrder() {
    assertEqual(MemoryLayout<Vector3>.size, 12)
    assertEqual(MemoryLayout<Vector3>.stride, 12)
    assertEqual(MemoryLayout<Vector3>.alignment, 4)
    assertEqual(Vector3.componentCount, 3)
    let all: F32[>..] = [a.x, a.y, a.z]
    assertEqual(all, [1, 5, -3])
}

@test
fn itsComponentsAreReadAndWrittenByIndex() {
    var v = a
    for i in 0..<3 {
        assertEqual(v[i], a[i])
        v[i] = b[i]
    }
    assertEqual(v, b)
    expectPanic("has no component 3") {
        _ = a[3]
    }
    expectPanic("has no component -1") {
        var v = a
        v[-1] = 0
    }
}

@test
fn arithmeticIsByComponent() {
    assertEqual(a + b, Vector3(5, 7, -2.5))
    assertEqual(a - b, Vector3(-3, 3, -3.5))
    assertEqual(a * b, Vector3(4, 10, -1.5))
    assertEqual(a / b, Vector3(0.25, 2.5, -6.0))
    assertEqual(a * 2, Vector3(2, 10, -6))
    assertEqual(2 * a, Vector3(2, 10, -6))
    assertEqual(a / 2, Vector3(0.5, 2.5, -1.5))
    assertEqual(-a, Vector3(-1, -5, 3))
    var v = a
    v += b
    v -= b
    v *= 2
    assertEqual(v, a * 2)
    assertEqual([a, b].reduce(Vector3.zero) { $0 + $1 }, a + b)
}

@test
fn lengthsAndDistancesAgreeWithTheirSquares() {
    let v = Vector3(3, 4, 12)
    assertEqual(v.length, 13)
    assertEqual(v.lengthSquared, 169)
    assertEqual(Vector3.zero.distance(to: v), 13)
    assertEqual(Vector3.zero.distanceSquared(to: v), 169)
    assertEqual(a.dot(b), 12.5)
    assertEqual(a.sum, 3)
}

@test
fn aVectorIsMadeUnitAndAVanishingOneZero() {
    assert(nearEqual(a.normalized().length, 1))
    assertEqual(Vector3.zero.normalized(), Vector3.zero)
    assertEqual((a * 1e-9).normalized(), Vector3.zero)
    assert(!Vector3.zero.normalized().isNaN)
}

@test
fn theLeastTheGreatestAndTheBoundsAreByComponent() {
    assertEqual(a.min(b), Vector3(1, 2, -3))
    assertEqual(a.max(b), Vector3(4, 5, 0.5))
    assertEqual(a.abs(), Vector3(1, 5, 3))
    assertEqual(a.clamped(lower: Vector3.zero, upper: Vector3(repeating: 3)), Vector3(1, 3, 0))
    assertEqual(a.minComponent, -3)
    assertEqual(a.maxComponent, 5)
    let nan = Vector3(repeating: F32.nan)
    assert(a.min(nan).isNaN && a.max(nan).isNaN && nan.minComponent.isNaN)
    assert(Vector3.zero.min(-Vector3.zero).x.isSignMinus)
    assert(!(-Vector3.zero).max(Vector3.zero).x.isSignMinus)
}

@test
fn roundingIsByComponent() {
    let v = Vector3(1.5, -2.5, 0.25)
    assertEqual(v.floor(), Vector3(1, -3, 0))
    assertEqual(v.ceil(), Vector3(2, -2, 1))
    assertEqual(v.truncated(), Vector3(1, -2, 0))
    assertEqual(v.rounded(), Vector3(2, -2, 0))
    assertEqual(Vector3(4, 9, 16).squareRoot(), Vector3(2, 3, 4))
    assertEqual(a.map { $0 + 1 }, a + Vector3.one)
}

@test
fn itIsInterpolatedInALine() {
    assertEqual(a.lerp(to: b, 0), a)
    assertEqual(Vector3.zero.lerp(to: Vector3.one * 4, 0.5), Vector3.one * 2)
    assertEqual(Vector3.zero.lerp(to: Vector3.one, 2), Vector3.one * 2)
}

@test
fn itIsReflectedAndProjected() {
    let up = Vector3.unitY
    assertEqual(Vector3(1, -1, 0).reflected(normal: up), Vector3(1, 1, 0))
    assertEqual(Vector3(3, 4, 0).projected(onto: Vector3.unitX), Vector3(3, 0, 0))
    assertEqual(a.projected(onto: Vector3.zero), Vector3.zero)
}

@test
fn equalityIsExactAndNearEqualIsNot() {
    let almost = Vector3.one
    var nudged = almost
    nudged.x = 1.0000005
    assert(almost != nudged)
    assert(almost.nearEqual(nudged))
    for i in 0..<3 {
        var other = almost
        other[i] = 1.5
        assert(almost != other)
        assert(!almost.nearEqual(other))
        assert(almost.nearEqual(other, tolerance: 0.5))
    }
    let nan = Vector3(repeating: F32.nan)
    assert(nan != nan && nan.isNaN && !nan.isFinite)
    assert(-Vector3.zero == Vector3.zero)
    assertEqual((-Vector3.zero).hashValue, Vector3.zero.hashValue)
    assertEqual(a.hashValue, Vector3(1, 5, -3).hashValue)
    assert(Vector3.zero.isZero && !a.isZero && !a.isNaN && a.isFinite)
    assert(!Vector3(repeating: F32.infinity).isFinite)
}

@test
fn itIsWrittenAsItsComponents() {
    let v = Vector3(1.5, -2.25, 0)
    assertEqual("\(v)", "(1.5, -2.25, 0.0)")
    assertEqual("\(v:.2)", "(1.50, -2.25, 0.00)")
    assertEqual("\(v:>40.0)".count, 40)
    assertEqual("\(v:?)", "Vector3(1.5, -2.25, 0.0)")
    assertEqual(v.debugDescription(), "Vector3(1.5, -2.25, 0.0)")
}

@test
fn itIsSerialisedByName() {
    let v = Vector3(1.5, -2.25, 0)
    assertEqual(try! Json.decode(Vector3.self, from: try! Json.encode(v)), v)
    assert(try! Json.encode(v).contains("\"y\":-2.25"))
}

@test
fn itIsMadeFromFloatsIntegersAndLanes() {
    let floats: F32[>..] = [9, 1, 5, -3, 8, 9]
    assertEqual(Vector3(from: floats, at: 1), a)
    var into: F32[>..] = [0, 0, 0, 0, 0, 0]
    a.copy(to: &into, at: 1)
    assertEqual(Vector3(from: into, at: 1), a)
    assertEqual(into[0], 0)
    expectPanic("") {
        var short: F32[>..] = [0]
        a.copy(to: &short)
    }
    assertEqual(Vector3(Int3(1, 5, -3)), a)
    assertEqual(Vector3(a.simd), a)
    assertEqual(a.simd[2], -3)
    assertEqual(a.toArray(), [1, 5, -3])
    assertEqual(Vector3(repeating: 2), Vector3.one * 2)
}

@test
fn theCrossProductIsRightHanded() {
    assertEqual(Vector3.unitX.cross(Vector3.unitY), Vector3.unitZ)
    assertEqual(Vector3.unitY.cross(Vector3.unitZ), Vector3.unitX)
    assertEqual(Vector3.unitZ.cross(Vector3.unitX), Vector3.unitY)
    assertEqual(a.cross(b).dot(a), 0)
}

@test
fn theDirectionsAreNamed() {
    assertEqual(Vector3.up, Vector3(0, 1, 0))
    assertEqual(Vector3.down, -Vector3.up)
    assertEqual(Vector3.right, Vector3(1, 0, 0))
    assertEqual(Vector3.left, -Vector3.right)
    assertEqual(Vector3.forward, Vector3(0, 0, -1))
    assertEqual(Vector3.backward, -Vector3.forward)
}

@test
fn itIsMadeOfAShorterOneAndHoldsIt() {
    assertEqual(Vector3(Vector2(1, 5), -3), a)
    assertEqual(a.xy, Vector2(1, 5))
}
