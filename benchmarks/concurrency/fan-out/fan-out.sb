module FanOut

import Sable.Testing

// A CPU-bound fan-out: sixteen tasks of the same arithmetic, which the pool
// spreads over the cores.

fn spin(_ seed: Int, _ rounds: Int) -> Int {
    var x = seed
    for _ in 0..<rounds {
        x = (x * 1103515245 + 12345) % 2147483648
    }
    return x
}

fn run() async -> String {
    var tasks: Task<Int>[>..] = []
    for i in 0..<16 {
        tasks.append(Task.spawn { spin(i, 25_000_000) })
    }
    var total = 0
    for task in tasks {
        total = (total + await task.value) % 1000003
    }
    return "\(total)"
}

@bench
fn measure(_ b: Bencher) async {
    b.check(await b.iterateAsync { await run() })
}
