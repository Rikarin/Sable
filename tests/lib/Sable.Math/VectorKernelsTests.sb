module VectorKernelsTests

// VectorKernels (Sable.Math): sums, products, norms, softmax and
// elementwise arithmetic over arrays of floats, a vector at a time with a
// scalar tail — lengths chosen to have both.

import Sable.Math
import Sable.Testing

/// Fails unless the two are within the tolerance of each other.
fn assertClose(_ actual: F64, _ expected: F64, tolerance: F64 = 1e-12) {
    let difference = actual > expected ? actual - expected : expected - actual
    assert(difference <= tolerance, "expected \(expected), got \(actual)")
}

/// 0, 1, 2, … as F32s.
fn rampF32(_ count: Int) -> F32[>..] {
    var values: F32[>..] = []
    for i in 0..<count {
        values.append(F32(i))
    }
    return values
}

/// 0, 1, 2, … as F64s.
fn rampF64(_ count: Int) -> F64[>..] {
    var values: F64[>..] = []
    for i in 0..<count {
        values.append(F64(i))
    }
    return values
}

@test
fn sumAddsEveryElement() {
    assertEqual(TensorPrimitives.sum(rampF32(37)), 666)
    assertEqual(TensorPrimitives.sum(rampF64(21)), 210)
    let empty: F64[>..] = []
    assertEqual(TensorPrimitives.sum(empty), 0)
    let few: F32[>..] = [1.5, 2.5]
    assertEqual(TensorPrimitives.sum(few), 4)
}

@test
fn dotSumsTheProducts() {
    assertEqual(TensorPrimitives.dot(rampF32(19), rampF32(19)), 2109)
    assertEqual(TensorPrimitives.dot(rampF64(11), rampF64(11)), 385)
}

@test
fn normIsTheLength() {
    let x: F32[>..] = [3, 4]
    assertEqual(TensorPrimitives.norm(x), 5)
    var y = rampF64(9)
    y[8] = 0
    assertEqual(TensorPrimitives.norm(y), 140.0.squareRoot())
}

@test
fn cosineSimilarityIsTheAnglesCosine() {
    let x = rampF64(20)
    assertClose(TensorPrimitives.cosineSimilarity(x, x), 1.0)
    var negated: F64[>..] = []
    for value in x {
        negated.append(-value)
    }
    assertClose(TensorPrimitives.cosineSimilarity(x, negated), -1.0)
    let a: F32[>..] = [1, 0]
    let b: F32[>..] = [0, 1]
    assertEqual(TensorPrimitives.cosineSimilarity(a, b), 0)
    assertClose(F64(TensorPrimitives.cosineSimilarity(rampF32(33), rampF32(33))), 1.0, tolerance: 1e-6)
}

@test
fn minAndMaxFindTheExtremes() {
    var x = rampF32(40)
    x[17] = -3
    x[38] = 100
    assertEqual(TensorPrimitives.min(x), -3)
    assertEqual(TensorPrimitives.max(x), 100)
    var y = rampF64(5)
    y[3] = -1
    assertEqual(TensorPrimitives.min(y), -1)
    assertEqual(TensorPrimitives.max(y), 4)
    var z = rampF64(30)
    z[29] = 1000
    assertEqual(TensorPrimitives.max(z), 1000)
    assertEqual(TensorPrimitives.min(z), 0)
    let one: F32[>..] = [7]
    assertEqual(TensorPrimitives.max(one), 7)
}

@test
fn elementwiseArithmeticWritesTheDestination() {
    let x = rampF32(18)
    var y: F32[>..] = []
    for _ in 0..<18 {
        y.append(2)
    }
    var result = rampF32(18)
    TensorPrimitives.add(x, y, into: &result)
    assertEqual(result[17], 19)
    TensorPrimitives.subtract(x, y, into: &result)
    assertEqual(result[0], -2)
    assertEqual(result[17], 15)
    TensorPrimitives.multiply(x, y, into: &result)
    assertEqual(result[16], 32)
    assertEqual(result[17], 34)
    TensorPrimitives.divide(x, y, into: &result)
    assertEqual(result[15], 7.5)
    assertEqual(result[17], 8.5)

    let p = rampF64(9)
    let q = rampF64(9)
    var wide = rampF64(10)
    TensorPrimitives.add(p, q, into: &wide)
    assertEqual(wide[8], 16)
    assertEqual(wide[9], 9)
    TensorPrimitives.subtract(p, q, into: &wide)
    assertEqual(wide[8], 0)
    TensorPrimitives.multiply(p, q, into: &wide)
    assertEqual(wide[8], 64)
    TensorPrimitives.divide(q, q, into: &wide)
    assertEqual(wide[8], 1)
}

@test
fn softmaxIsPositiveAndSumsToOne() {
    var result = rampF32(20)
    TensorPrimitives.softmax(rampF32(20), into: &result)
    assertClose(F64(TensorPrimitives.sum(result)), 1.0, tolerance: 1e-6)
    assert(result[19] > result[18])
    var wide = rampF64(3)
    TensorPrimitives.softmax(rampF64(3), into: &wide)
    assertClose(TensorPrimitives.sum(wide), 1.0)
    assertClose(wide[1] / wide[0], 2.718281828459045)
    var big = rampF64(11)
    TensorPrimitives.softmax(rampF64(11), into: &big)
    assertClose(TensorPrimitives.sum(big), 1.0)
}
