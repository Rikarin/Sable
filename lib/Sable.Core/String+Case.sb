module Sable.Core

// Case: a string's letters made upper or lower case by Unicode's full
// mappings, and strings compared with case set aside. Text with nothing to
// change is given back as it is; text that has some keeps its unchanged
// runs whole, as slices, and is joined once.

extension String {
    /// How two strings are compared (`compare(_:options:)`).
    @flags
    public enum CompareOptions {
        /// Letters that differ only in case are the same: each scalar is
        /// compared case-folded (`Char.caseFolded`).
        IgnoringCase

        /// A run of ASCII digits is compared as the number it writes, so
        /// "file9" comes before "file10" — the order a person sorts names in.
        Numeric
    }

    /// The string in upper case, by Unicode's full mappings: 'ß' is "SS",
    /// so the result may be longer. The same everywhere: no language's own
    /// rules, such as Turkish dotted 'i'.
    ///
    /// ```sable
    /// assert("Straße".uppercased() == "STRASSE")
    /// assert("ǆemal".uppercased() == "ǄEMAL")
    /// ```
    public fn uppercased() -> String {
        return self.mappingCase(upper: true)
    }

    /// The string in lower case, by Unicode's full mappings, with a capital
    /// sigma at a word's end made the final 'ς' (Unicode's Final_Sigma).
    ///
    /// ```sable
    /// assert("ΟΔΟΣ".lowercased() == "οδος")
    /// assert("ÀB".lowercased() == "àb")
    /// ```
    public fn lowercased() -> String {
        return self.mappingCase(upper: false)
    }

    /// The string with its ASCII letters in upper case, and every other
    /// scalar as it is: for protocols and file formats, which mean ASCII.
    public fn asciiUppercased() -> String {
        return self.shiftingAscii(from: 0x61, by: 0xE0)
    }

    /// The string with its ASCII letters in lower case, and every other
    /// scalar as it is.
    public fn asciiLowercased() -> String {
        return self.shiftingAscii(from: 0x41, by: 0x20)
    }

    /// The string case-folded in full (Unicode's CaseFolding.txt, statuses
    /// C and F): two strings that differ only in case fold to the same one,
    /// even where a scalar folds to more than one ('ß' to "ss"), as
    /// `Char.caseFolded`, one scalar to one, cannot.
    ///
    /// ```sable
    /// assert("Straße".caseFolded() == "strasse")
    /// assert("STRASSE".caseFolded() == "strasse")
    /// assert("ǅ".caseFolded() == "ǆ")
    /// ```
    public fn caseFolded() -> String {
        if self.isAscii {
            return self.asciiLowercased()
        }
        return self.mappingScalars(foldingCasePairs, foldingCaseIndex, foldingCaseBlocks, limit: foldingCaseLimit, letters: 0x41, sigma: false) { code in
            unicodeSpecial(fullFoldingTable, count: fullFoldingTableCount, code)
        }
    }

    /// Whether the strings are equal, scalar by scalar, or — ignoring case —
    /// equal once both are case-folded.
    ///
    /// ```sable
    /// assert("Hello".equals("hELLO", ignoringCase: true))
    /// assert(!"Hello".equals("hELLO", ignoringCase: false))
    /// ```
    public fn equals(_ other: String, ignoringCase: Bool) -> Bool {
        if !ignoringCase {
            return self == other
        }
        return self.compare(other, options: .IgnoringCase) == .Equal
    }

    /// How the string orders against the other: scalar by scalar, as `<`
    /// does, unless the options say to ignore case or to compare runs of
    /// digits as numbers.
    ///
    /// ```sable
    /// assert("file9".compare("file10", options: .Numeric) == .Less)
    /// assert("file9".compare("file10", options: []) == .Greater)
    /// assert("ABC".compare("abd", options: .IgnoringCase) == .Less)
    /// ```
    public fn compare(_ other: String, options: String.CompareOptions) -> Ordering {
        return Ordering.of(sign: self.compareSign(other, options))
    }

    // Negative, zero or positive as the string orders before, with or after the other.
    fn compareSign(_ other: String, _ options: String.CompareOptions) -> Int {
        let ignoringCase = options.contains(.IgnoringCase)
        let numeric = options.contains(.Numeric)
        if !ignoringCase && !numeric {
            return Runtime.compareStrings(self, other)
        }
        var left = 0
        var right = 0
        let leftEnd = self.utf8Count
        let rightEnd = other.utf8Count
        // As far as both are ASCII: a byte is a scalar, and folds as one.
        while ignoringCase && !numeric && left < leftEnd && left < rightEnd {
            let a = self.utf8Byte(left)
            let b = other.utf8Byte(left)
            if (a | b) >= 0x80 {
                break
            }
            if a != b {
                let x = a &- 0x41 < 26 ? a + 32 : a
                let y = b &- 0x41 < 26 ? b + 32 : b
                if x != y {
                    return x < y ? -1 : 1
                }
            }
            left = left + 1
        }
        right = left
        while left < leftEnd && right < rightEnd {
            var a = self.scalar(at: left)
            var b = other.scalar(at: right)
            if numeric && a.isDigit && b.isDigit {
                let leftDigits = self.digitRunEnd(left)
                let rightDigits = other.digitRunEnd(right)
                let order = String.compareDigits(self, left, leftDigits, other, right, rightDigits)
                if order != 0 {
                    return order
                }
                left = leftDigits
                right = rightDigits
                continue
            }
            if ignoringCase {
                a = a.caseFolded
                b = b.caseFolded
            }
            if a != b {
                return a < b ? -1 : 1
            }
            left = self.offsetAfter(left)
            right = other.offsetAfter(right)
        }
        return left < leftEnd ? 1 : right < rightEnd ? -1 : 0
    }

    // ---- Helpers ----------------------------------------------------------

    /// The string in upper or lower case, each scalar by its full mapping.
    fn mappingCase(upper: Bool) -> String {
        if self.isAscii {
            return upper ? self.asciiUppercased() : self.asciiLowercased()
        }
        if upper {
            return self.mappingScalars(upperCasePairs, upperCaseIndex, upperCaseBlocks, limit: upperCaseLimit, letters: 0x61, sigma: false) { code in
                unicodeSpecial(upperSpecialTable, count: upperSpecialTableCount, code)
            }
        }
        return self.mappingScalars(lowerCasePairs, lowerCaseIndex, lowerCaseBlocks, limit: lowerCaseLimit, letters: 0x41, sigma: true) { code in
            unicodeSpecial(lowerSpecialTable, count: lowerSpecialTableCount, code)
        }
    }

    /// The string with each scalar moved as the case table says, an ASCII
    /// letter from 'letters' on by its bit of case, and a scalar the table
    /// marks made what 'special' says; with 'sigma', a capital sigma that
    /// ends a word made a final one. The string itself when none changes.
    fn mappingScalars(_ pairs: String, _ index: String, _ blocks: String, limit: Int, letters: U8, sigma: Bool, special: (Int) -> String?) -> String {
        let end = self.utf8Count
        unsafe {
            var buffer = StringBuffer.allocate(capacity: end + 8)
            var changed = 0
            var i = 0
            var j = 0
            while true {
                let reached = self.mapScalars(from: i, to: buffer, at: j, pairs, index, blocks, limit: limit, letters: letters, sigma: sigma)
                i = reached.read
                j = reached.written
                changed |= reached.changed
                var text = ""
                if reached.marked >= 0 {
                    changed = 1
                    let next = self.offsetAfter(i)
                    text = reached.marked == 0x3A3 ? "ς" : special(reached.marked) ?? self.utf8Slice(i, next)
                    i = next
                }
                // Room for what is left when, as nearly always, no scalar
                // becomes a longer one; and for what one became.
                let needed = j + text.utf8Count + (i < end ? end - i + 8 : 0)
                if needed > buffer.capacity {
                    buffer = buffer.growing(used: j, capacity: needed)
                }
                buffer.store(utf8: text, from: 0, to: text.utf8Count, at: j)
                j += text.utf8Count
                if i >= end {
                    break
                }
            }
            if changed == 0 {
                buffer.discard()
                return self
            }
            return buffer.finish(count: j)
        }
    }

    /// The scalars from a byte of the string on, mapped and written from a
    /// byte of the others on, as far as there is surely room for them and
    /// none is marked as having a mapping of its own — or is a capital sigma
    /// that ends a word: which, or -1.
    fn mapScalars(from start: Int, to bytes: StringBuffer, at: Int, _ pairs: String, _ index: String, _ blocks: String, limit: Int, letters: U8, sigma: Bool) -> (read: Int, written: Int, changed: Int, marked: Int) {
        // What takes a letter's byte, and any above, to 0x80 and past it.
        let past = U64(0x80 - letters) &* 0x0101_0101_0101_0101
        let end = self.utf8Count
        let room = bytes.capacity - 8
        var changed = 0
        var i = start
        var j = at
        while i < end && j <= room {
            let word = self.utf8Window(i)
            let lead = Int(word & 0xFF)
            if lead < 0x80 {
                // The ASCII bytes before one that is not, at once: each
                // letter's bit of case is its byte's top bit in the one sum
                // and not the other. Bytes past them are written over next.
                let tops = word & 0x8080_8080_8080_8080
                var run = tops == 0 ? 8 : tops.trailingZeroCount >> 3
                run = run < end - i ? run : end - i
                let kept = run == 8 ? U64.max : (1 << U64(8 * run)) - 1
                let isLetter = asciiLetters(word, past) & kept
                bytes.store(word ^ isLetter >> 2, at: j)
                changed |= Int(isLetter >> 2)
                i += run
                j += run
                continue
            }
            var code = Int(word >> 8 & 0x3F)
            var width = 2
            if lead < 0xE0 {
                // Two bytes, which the mapping nearly always keeps two: what
                // it changes of them, unless the first has a bit it never can.
                code |= (lead & 0x1F) << 6
                let mask = pairs.utf8Word(code * 2 - 0x100) &- 0x3030
                if (mask & 0x20) == 0 {
                    bytes.store(word ^ mask & 0xFFFF, at: j)
                    changed |= Int(mask & 0xFFFF)
                    i += 2
                    j += 2
                    continue
                }
            } else if lead < 0xF0 {
                width = 3
                code = (lead & 0x0F) << 12 | code << 6 | Int(word >> 16 & 0x3F)
            } else {
                width = 4
                code = (lead & 0x07) << 18 | code << 12 | Int(word >> 16 & 0x3F) << 6 | Int(word >> 24 & 0x3F)
            }
            let value = unicodeStaged(index, blocks, limit: limit, code)
            if value >= caseSpecial || code == 0x3A3 && sigma && self.endsWord(sigmaAt: i) {
                // Final_Sigma: a sigma after a cased letter and not before one.
                return (read: i, written: j, changed: changed, marked: code)
            }
            let mapped = caseMoved(code, value)
            changed |= value
            var encoded: U64 = 0
            var written = 2
            if mapped < 0x80 {
                encoded = mapped unchecked as U64
                written = 1
            } else if mapped < 0x800 {
                encoded = (0x80C0 | mapped >> 6 | (mapped & 0x3F) << 8) unchecked as U64
            } else if mapped < 0x10000 {
                encoded = (0x8080E0 | mapped >> 12 | (mapped >> 6 & 0x3F) << 8 | (mapped & 0x3F) << 16) unchecked as U64
                written = 3
            } else {
                encoded = (0x808080F0 | mapped >> 18 | (mapped >> 12 & 0x3F) << 8 | (mapped >> 6 & 0x3F) << 16 | (mapped & 0x3F) << 24) unchecked as U64
                written = 4
            }
            bytes.store(encoded, at: j)
            i += width
            j += written
        }
        return (read: i, written: j, changed: changed, marked: -1)
    }

    /// Whether the capital sigma at the offset is a word's last letter.
    fn endsWord(sigmaAt offset: Int) -> Bool {
        var before = offset
        var casedBefore = false
        while before > 0 {
            before = self.offsetBefore(before)
            let scalar = self.scalar(at: before)
            if !scalar.isCaseIgnorable {
                casedBefore = scalar.isCased
                break
            }
        }
        if !casedBefore {
            return false
        }
        var after = self.offsetAfter(offset)
        while after < self.utf8Count {
            let scalar = self.scalar(at: after)
            if !scalar.isCaseIgnorable {
                return !scalar.isCased
            }
            after = self.offsetAfter(after)
        }
        return true
    }

    /// The string with its ASCII letters of one case, the twenty-six from
    /// 'first', moved by 'shift' — they are their own bytes.
    fn shiftingAscii(from first: U8, by shift: U8) -> String {
        if self.utf8Count <= 128 {
            return self.shiftingShortAscii(from: first)
        }
        var bytes: U8[>..] = []
        bytes.append(utf8: self)
        if !bytes.shiftAsciiLetters(from: first, by: shift) {
            return self
        }
        // Still well-formed: no byte of a longer sequence is a letter.
        unsafe {
            return Runtime.stringFromValidUtf8(bytes)
        }
    }

    /// The same of a short string, eight bytes at a time and written in place.
    fn shiftingShortAscii(from first: U8) -> String {
        let end = self.utf8Count
        let past = U64(0x80 - first) &* 0x0101_0101_0101_0101
        var changed: U64 = 0
        unsafe {
            let buffer = StringBuffer.allocate(capacity: end + 8)
            var i = 0
            while i < end {
                let word = self.utf8Window(i)
                let bits = asciiLetters(word, past) >> 2
                changed |= bits
                buffer.store(word ^ bits, at: i)
                i += 8
            }
            if changed == 0 {
                buffer.discard()
                return self
            }
            return buffer.finish(count: end)
        }
    }

    /// Where the run of ASCII digits from the offset ends.
    fn digitRunEnd(_ offset: Int) -> Int {
        var end = offset
        while end < self.utf8Count && self.utf8Byte(end) >= 0x30 && self.utf8Byte(end) <= 0x39 {
            end = end + 1
        }
        return end
    }

    /// Two runs of digits compared as numbers: leading zeros passed over,
    /// then the longer is the greater, then digit by digit.
    static fn compareDigits(_ a: String, _ aStart: Int, _ aEnd: Int, _ b: String, _ bStart: Int, _ bEnd: Int) -> Int {
        var i = aStart
        var j = bStart
        while i < aEnd - 1 && a.utf8Byte(i) == 0x30 {
            i = i + 1
        }
        while j < bEnd - 1 && b.utf8Byte(j) == 0x30 {
            j = j + 1
        }
        if aEnd - i != bEnd - j {
            return aEnd - i < bEnd - j ? -1 : 1
        }
        while i < aEnd {
            if a.utf8Byte(i) != b.utf8Byte(j) {
                return a.utf8Byte(i) < b.utf8Byte(j) ? -1 : 1
            }
            i = i + 1
            j = j + 1
        }
        return 0
    }
}

/// The top bit of each byte of the word that is one of the twenty-six ASCII
/// letters of a case, 'past' being what takes the first of them, in every
/// byte, to 0x80: a byte below 0x80 whose sum with that is at least 0x80, and
/// less than twenty-six past it.
@inline(always)
fn asciiLetters(_ word: U64, _ past: U64) -> U64 {
    let tops: U64 = 0x8080_8080_8080_8080
    let sums = (word & ~tops) &+ past
    return sums & ~(sums &- 0x1A1A_1A1A_1A1A_1A1A) & ~word & tops
}
