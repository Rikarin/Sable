module TypeMetadataTests

// TypeMetadata (Sable.Core), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

struct Point {
    var x: Int
    var name: String
}

class Box {
    var value: Int = 0
}

union Tag {
    Label(String)
    Empty
}

@noncopy
struct Unique {
    var id: Int
}

@test
fn anIntsMetadataSaysItsLayout() {
    let m = TypeMetadata.of(Int.self)
    assertEqual(m.name, "Int")
    assertEqual(m.size, 8)
    assertEqual(m.alignment, 8)
    assertEqual(m.stride, 8)
    assert(m.isTrivial)
    assert(!m.isNoncopyable)
}

@test
fn eachKindIsReported() {
    assert(TypeMetadata.of(Box.self).kind == .Class)
    assert(TypeMetadata.of(Point.self).kind == .Struct)
    assert(TypeMetadata.of(Tag.self).kind == .Union)
    assert(TypeMetadata.of(Int?.self).kind == .Optional)
    assert(TypeMetadata.of((Int, Bool).self).kind == .Tuple)
    assert(TypeMetadata.of(((Int) -> Int).self).kind == .Function)
    assert(TypeMetadata.of(Int[>..].self).kind == .Array)
    assert(TypeMetadata.of(String.self).kind == .String)
    assert(TypeMetadata.of(TypeMetadata.self).kind == .Metatype)
    assert(TypeMetadata.of(Bool.self).kind == .Scalar)
}

@test
fn aStructsFieldsAreItsStoredFieldsInOrder() {
    let m = TypeMetadata.of(Point.self)
    assertEqual(m.fieldCount, 2)
    assertEqual(m.fieldName(at: 0), "x")
    assertEqual(m.fieldOffset(at: 0), 0)
    assert(m.fieldType(at: 0) == TypeMetadata.of(Int.self))
    assertEqual(m.fieldName(at: 1), "name")
    assertEqual(m.fieldOffset(at: 1), 8)
    assert(m.fieldType(at: 1) == TypeMetadata.of(String.self))
}

@test
fn anOptionalsArgumentIsTheWrappedType() {
    let m = TypeMetadata.of(String?.self)
    assertEqual(m.argumentCount, 1)
    assert(m.argument(at: 0) == TypeMetadata.of(String.self))
    assert(!m.isTrivial)
}

@test
fn metadataIsEqualOnlyForOneType() {
    assert(TypeMetadata.of(Point.self) == TypeMetadata.of(Point.self))
    assert(TypeMetadata.of(Point.self) != TypeMetadata.of(Box.self))
}

@test
fn aMoveOnlyTypeIsNoncopyable() {
    assert(TypeMetadata.of(Unique.self).isNoncopyable)
    assert(!TypeMetadata.of(Unique.self).isTrivial)
}

@test
fn theValueWitnessesCopyMoveAssignAndDestroy() {
    let m = TypeMetadata.of(Point.self)
    let p = Point { x: 1, name: "a" + "b" }
    assertEqual(m.copy(p).name, "ab")
    assertEqual(m.move(p).x, 1)
    var target = Point { x: 2, name: "c" }
    m.assign(p, to: &target)
    assertEqual(target.name, "ab")
    m.destroyCopy(of: p)
    assertEqual(p.name, "ab")
}
