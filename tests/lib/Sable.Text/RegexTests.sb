    ("(a|)", "a", "0-1 0-1"),
    ("(a*)*", "b", "0-0 -"),
    ("(a*)+", "b", "0-0 0-0"),
    ("(a*|b)*", "ab", "0-2 1-2"),
])
fn basicSearchesFromRe2(_ pattern: String, _ text: String, _ expected: String) throws(RegexError) {
    try checkSearch(pattern, text, expected)
}

@test(arguments: [
