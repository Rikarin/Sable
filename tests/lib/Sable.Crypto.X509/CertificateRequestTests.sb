@test
fn opensslsRequestIsRead() {
    let request = try! CertificateRequest.parse(pem: opensslRequest)
    assertEqual(request.debugDescription(), "CertificateRequest(CN=ask)")
    expect(request.isSigned && request.alternativeNames == [.Dns("ask.example.com")] && request.extensions.count == 1)
    assertEqual(request.pem.trimmed(), opensslRequest.trimmed())
    var der = request.der
    der[der.count - 1] = der[der.count - 1] ^ 1
    expect(!(try! CertificateRequest.parse(der: der)).isSigned)
    expect((try? CertificateRequest.parse(der: der[..<^1])) == none && (try? CertificateRequest.parse(pem: rsaPem)) == none)
}

@test
fn everyKeysRequestIsSigned() {
    let keys = [EcdsaPrivateKey<P256>.generate().anyKey, EcdsaPrivateKey<P384>.generate().anyKey, EcdsaPrivateKey<P521>.generate().anyKey, Ed25519PrivateKey.generate().anyKey, try! PrivateKey.parse(pem: rsaPem)]
    for key in keys {
        let request = try! CertificateRequest.make(subject: DistinguishedName(commonName: "x"), names: [.Dns("a.example"), .Uri("https://a.example/")], key: key)
        assert(request.isSigned && request.subject.first(.commonName) == "x" && request.alternativeNames.count == 2)
        assertEqual(try! request.publicKey(), key.publicKey)
        let empty = try! CertificateRequest.make(subject: DistinguishedName([]), names: [], key: key)
        assert(empty.isSigned && empty.extensions.isEmpty)
        let certificate = try! CertificateBuilder(subject: DistinguishedName(commonName: "x")).selfSigned(with: key)
        assert(certificate.isSigned(by: key.publicKey) && certificate.alternativeNames.isEmpty)
    }
    expect((try? CertificateRequest.make(subject: DistinguishedName([]), names: [], key: X25519PrivateKey.generate().anyKey)) == none)
    expect((try? CertificateRequest.make(subject: DistinguishedName([]), names: [], key: keys[3], algorithm: .Ecdsa(.Sha256))) == none)
}

// A byte of it changed is another request, or none, and never traps.
@test
fn whatIsNoRequestIsRefused() {
    let request = try! CertificateRequest.parse(pem: opensslRequest)
    var i = 0
    var signed = 0
    while i < request.der.count {
        var der = request.der
        der[i] = der[i] ^ 0x21
        if let other = try? CertificateRequest.parse(der: der) {
            signed += other.isSigned ? 1 : 0
        }
        i += 1
    }
    assertEqual(signed, 0)
}

@test
fn otherAlgorithmsAreWrittenAndRead() {
    let rsa = try! PrivateKey.parse(pem: rsaPem)
    for algorithm in [SignatureAlgorithm.RsaPkcs1(.Sha384), SignatureAlgorithm.RsaPkcs1(.Sha512), SignatureAlgorithm.RsaPss(.Sha384, maskHash: .Sha256, saltByteCount: 20)] {
        let certificate = try! CertificateBuilder(subject: DistinguishedName(commonName: "x")).selfSigned(with: rsa, algorithm: algorithm)
        require(certificate.signatureAlgorithm == algorithm && certificate.isSigned(by: rsa.publicKey))
    }
    let key = EcdsaPrivateKey<P256>.generate().anyKey
    let certificate = try! CertificateBuilder(subject: DistinguishedName(commonName: "x")).selfSigned(with: key, algorithm: .Ecdsa(.Sha512))
    expect(certificate.signatureAlgorithm == .Ecdsa(.Sha512) && certificate.isSigned(by: key.publicKey) && !certificate.isSigned(by: rsa.publicKey))
}

@test
fn whatABuilderIsGivenIsWritten() {
    let key = Ed25519PrivateKey.generate().anyKey
    var builder = CertificateBuilder(subject: DistinguishedName(commonName: "x"), isAuthority: true)
    builder.notBefore = UtcDateTime.of(year: 2049, month: 12, day: 31, hour: 23, minute: 59, second: 59)!
    builder.notAfter = UtcDateTime.of(year: 2050, month: 1, day: 1, hour: 0, minute: 0, second: 0)!
    builder.basicConstraints = BasicConstraints(isAuthority: true, pathLength: 3)
    builder.keyUsage = [.KeyCertSign, .CrlSign, .DecipherOnly]
    builder.nameConstraints = NameConstraints(permitted: [.Dns("example.com"), .Ip([10, 0, 0, 0, 255, 0, 0, 0])], excluded: [.Email("x@example.com")])
    builder.alternativeNames = [.Dns("a"), .Ip([1, 2, 3, 4]), .Email("a@b"), .Uri("x:y"), .Directory(DistinguishedName(commonName: "n")), .Other(ObjectIdentifier([1, 2, 3]), [5, 0]), .RegisteredId(ObjectIdentifier([1, 2])), .Unknown([0xA3, 0x00])]
    builder.purposes = [KeyPurpose.timeStamping, KeyPurpose.ocspSigning, KeyPurpose.emailProtection]
    builder.serialNumber = [0xFF, 1]
    let made = try! builder.selfSigned(with: key)
    expect(made.notBefore == builder.notBefore && made.notAfter == builder.notAfter)
    expect(made.basicConstraints == builder.basicConstraints && made.keyUsage == builder.keyUsage)
    expect(made.nameConstraints == builder.nameConstraints && made.alternativeNames == builder.alternativeNames)
    expect(made.purposes! == builder.purposes && made.serialNumber == [0, 0xFF, 1])
    builder.keyUsage = .None
    expect((try! builder.selfSigned(with: key)).keyUsage == none)
}
