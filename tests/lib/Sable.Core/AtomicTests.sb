module AtomicTests

// Atomic, MemoryOrdering and OnceCell (Sable.Core).

import Sable.Testing
import Sable.Time

@test
fn anAtomicIntegerIsChangedWhole() {
    let n = Atomic<Int>(0)
    assertEqual(n.add(5), 0)
    assertEqual(n.subtract(2), 5)
    assertEqual(n.load(), 3)
    assertEqual(n.exchange(10), 3)
    let failed = n.compareExchange(expected: 3, desired: 99)
    expect(!failed.exchanged && failed.original == 10)
    let swapped = n.compareExchange(expected: 10, desired: 12)
    expect(swapped.exchanged && swapped.original == 10)
    assertEqual(n.bitwiseAnd(0b1010), 12)
    assertEqual(n.bitwiseOr(0b0101), 8)
    assertEqual(n.bitwiseXor(0b1111), 13)
    assertEqual(n.load(ordering: .Relaxed), 2)
    assertEqual(n.max(40), 2)
    assertEqual(n.min(7), 40)
    assertEqual(n.load(ordering: .Acquire), 7)
    n.store(-3, ordering: .Release)
    assertEqual(n.update { $0 * $0 }, -3)
    assertEqual(n.load(), 9)
}

@test
fn everyWidthWrapsAsItsType() {
    let byte = Atomic<U8>(250)
    assertEqual(byte.add(10), 250)
    assertEqual(byte.load(), 4)
    let signed = Atomic<I8>(-128)
    assertEqual(signed.subtract(1), -128)
    assertEqual(signed.load(), 127)
    assertEqual(signed.min(-5), 127)
    assertEqual(signed.load(), -5)
    let unsigned = Atomic<U32>(5)
    assertEqual(unsigned.max(4000000000), 5)
    assertEqual(unsigned.load(), 4000000000)
    let wide = Atomic<U64>(U64.max)
    assertEqual(wide.add(1), U64.max)
    assertEqual(wide.load(), 0)
    let half = Atomic<I16>(0)
    assertEqual(half.compareExchangeWeak(expected: 0, desired: 1).original, 0)
}

@test
fn anAtomicFlagIsSetAndCleared() {
    let flag = Atomic<Bool>(false)
    expect(!flag.logicalOr(true))
    expect(flag.load())
    expect(flag.logicalXor(true))
    expect(!flag.load())
    expect(!flag.logicalAnd(true))
    expect(flag.compareExchange(expected: false, desired: true).exchanged)
    expect(flag.exchange(false))
    atomicFence()
    atomicFence(.Acquire)
}

@test
fn aOnceCellIsMadeOnce() {
    let cell = OnceCell<String>()
    expect(cell.get() == none)
    var made = 0
    assertEqual(cell.getOrInit {
        made += 1
        return "first"
    }, "first")
    assertEqual(cell.getOrInit {
        made += 1
        return "second"
    }, "first")
    assertEqual(made, 1)
    assertEqual(cell.get(), "first")
}

@test
fn manyTasksCountTogether() async {
    let counter = Atomic<Int>(0)
    let cell = OnceCell<Int>()
    let made = Atomic<Int>(0)
    await withTaskGroup(of: Int.self) { group in
        var task = 0
        while task < 8 {
            group.spawn {
                var i = 0
                while i < 20000 {
                    counter.add(1, ordering: .Relaxed)
                    i += 1
                }
                return cell.getOrInit {
                    made.add(1)
                    return 42
                }
            }
            task += 1
        }
        for await value in group {
            assertEqual(value, 42)
        }
    }
    assertEqual(counter.load(), 160000)
    assertEqual(made.load(), 1)
}

@test
fn anAtomicTakesEveryOrdering() {
    let n = Atomic<Int>(1)
    assertEqual(n.add(1, ordering: .AcquireRelease), 1)
    assertEqual(n.exchange(5, ordering: .Acquire), 2)
    assertEqual(n.subtract(1, ordering: .Release), 5)
    assertEqual(n.update(ordering: .AcquireRelease) { $0 + 6 }, 4)
    n.store(n.load(ordering: .SequentiallyConsistent) * 2, ordering: .Relaxed)
    assertEqual(n.load(), 20)
    atomicFence(.Release)
    atomicFence(.AcquireRelease)
    expect(MemoryOrdering.Acquire != MemoryOrdering.Release)
    assertEqual("\(MemoryOrdering.AcquireRelease)", "AcquireRelease")
}

@test(traps: "a load cannot release")
fn aReleaseLoadTraps() {
    _ = Atomic<Int>(0).load(ordering: .Release)
}

@test(traps: "a load cannot release")
fn anAcquireReleaseLoadTraps() {
    _ = Atomic<Int>(0).load(ordering: .AcquireRelease)
}

@test(traps: "a store cannot acquire")
fn anAcquireStoreTraps() {
    Atomic<Int>(0).store(1, ordering: .Acquire)
}

@test(traps: "a store cannot acquire")
fn anAcquireReleaseStoreTraps() {
    Atomic<Int>(0).store(1, ordering: .AcquireRelease)
}

@test
fn anUpdateIsTriedAgainWhenTheValueChangedMeanwhile() {
    let n = Atomic<Int>(1)
    var tries: Int[>..] = []
    let before = n.update { value in
        if tries.isEmpty {
            // What another task could do between the load and the exchange.
            n.store(10)
        }
        tries.append(value)
        return value + 1
    }
    assertEqual(before, 10)
    assertEqual(n.load(), 11)
    // A weak exchange may fail for no reason, so there may be more tries.
    assertEqual(tries[0], 1)
    assertEqual(tries[tries.count - 1], 10)
}

class Counted {
    let gone: Atomic<Int>

    init(_ gone: Atomic<Int>) {
        self.gone = gone
    }

    deinit {
        gone.add(1)
    }
}

@test
fn aOnceCellLetsItsValueGoIfItMadeOne() {
    let gone = Atomic<Int>(0)
    do {
        let empty = OnceCell<Counted>()
        expect(empty.get() == none)
    }
    assertEqual(gone.load(), 0)
    do {
        let cell = OnceCell<Counted>()
        _ = cell.getOrInit { Counted(gone) }
        assertEqual(gone.load(), 0)
    }
    assertEqual(gone.load(), 1)
}

@test
fn aOnceCellsAskersWaitForTheTaskMakingIt() async {
    let cell = OnceCell<Int>()
    let asking = Atomic<Bool>(false)
    let making = Atomic<Bool>(false)
    let maker = Task.spawn {
        return cell.getOrInit {
            making.store(true)
            while !asking.load() { }
            // Time for the asker to find it being made.
            let start = Instant.now()
            while start.elapsed < Duration.milliseconds(50) { }
            return 7
        }
    }
    while !making.load() {
        await Task.yield()
    }
    let asker = Task.spawn {
        expect(cell.get() == none)
        asking.store(true)
        return cell.getOrInit { 8 }
    }
    assertEqual(await asker.value, 7)
    assertEqual(await maker.value, 7)
}
