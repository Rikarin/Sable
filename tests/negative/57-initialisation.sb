module Negative.Initialisation

public struct Point { public var x: Int, public var y: Int }
public union Shape { Circle(radius: F64), Empty }

fn readBeforeWrite() -> Int {
    var n: Int
    return n                            //! S6008 before anything assigns
}

fn writeThenRead() -> Int {
    var n: Int
    n = 1
    return n
}

fn oneBranchOnly(_ flag: Bool) -> Int {
    var n: Int
    if flag {
        n = 1
    }
    return n                            //! S6008 before anything assigns
}

fn bothBranches(_ flag: Bool) -> Int {
    var n: Int
    if flag {
        n = 1
    } else {
        n = 2
    }
    return n
}

fn oneBranchExits(_ flag: Bool) -> Int {
    var n: Int
    if flag {
        n = 1
    } else {
        return 0
    }
    return n
}

fn aLoopMayNotRun(_ xs: Int[]) -> Int {
    var n: Int
    for x in xs {
        n = x
    }
    return n                            //! S6008 before anything assigns
}

fn aRepeatAlwaysRuns() -> Int {
    var n: Int
    repeat {
        n = 1
    } while false
    return n
}

fn everyMatchArmAssigns(_ s: Shape) -> Int {
    var n: Int
    match s {
        case .Circle(let r) => { n = 1 }
        case .Empty => { n = 0 }
    }
    return n
}

fn oneArmDoesNot(_ s: Shape) -> Int {
    var n: Int
    match s {
        case .Circle(let r) => { n = 1 }
        case .Empty => { }
    }
    return n                            //! S6008 before anything assigns
}

fn readingInsideTheAssignment() -> Int {
    var n: Int
    n = n + 1                           //! S6008 before anything assigns
    return n
}

fn aFieldOfAnUninitialisedValue() -> Int {
    var p: Point
    return p.x                          //! S6008 before anything assigns
}

fn aGuardAssigns(_ n: Int?) -> Int {
    guard let value = n else {
        return 0
    }
    return value
}

fn anIfLetAssigns(_ n: Int?) -> Int {
    if let value = n {
        return value
    }
    return 0
}

fn aCatchCannotRelyOnTheBody() -> Int {
    var n: Int
    do {
        let t = try read()
        n = 1
    } catch {
        return n                        //! S6008 before anything assigns
    }
    return n
}

fn read() throws(Shape) -> Int { return 1 }

fn aClosureCannotSeeTheFuture() -> Int {
    var n: Int
    let f = () => { return n }          //! S6008 before anything assigns
    n = 1
    return f()
}

public class Named {
    public var name: String
    public var count: Int

    public init() {                     //! S3028 'count' is not initialised on every path
        name = "a"
    }

    public init(name: String) {
        self.name = name
        count = 0
    }

    public init(flag: Bool) {           //! S3028 'name' is not initialised on every path
        if flag {
            name = "yes"
        }
        count = 1
    }

    public init(both: Bool) {
        if both {
            name = "yes"
        } else {
            name = "no"
        }
        count = 1
    }

    public init(early: Int) {
        name = "e"
        count = 0
        describe()
    }

    public init(reads: Int) {
        name = "r"
        count = count + 1               //! S6008 'count' is read here before the initialiser assigns it
    }

    public init(calls: Int) {
        name = "c"
        describe()                      //! S6008 'self' is used here before 'count' is initialised
        count = calls
    }

    public init(passes: Int) {
        name = "p"
        keep(self)                      //! S6008 'self' is used here before 'count' is initialised
        count = passes
    }

    public fn describe() { }
}

fn keep(_ n: Named) { }

public class Defaults {
    public var held: Named
    public var count: Int = 0

    public init() {                     //! S3028 'held' is not initialised
        count = 1
    }
}

public struct Pair {
    public var a: Int
    public var b: Int

    public init(a: Int) {               //! S3028 'b' is not initialised
        self.a = a
    }

    public init(copy: Pair) {
        self = copy
    }

    public init(a: Int, b: Int) {
        self.a = a
        self.b = b + self.a
    }
}

public class FieldValues {
    public var x: Int = y               //! S6008 'y' is used here before the instance exists
    public var y: Int = 1
    public var z: Int = FieldValues.start
    public var w: Int = twice()         //! S6008 'twice' is used here before the instance exists
    public lazy var v: Int = x + y

    public static let start: Int = 3

    public init() { }

    public fn twice() -> Int { return 2 }
}
