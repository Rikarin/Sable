module Sable.Core

// What the operating system gives a program, through the runtime: the
// calls Sable.IO, Sable.Time and Sable.Process are written over
// (docs/06 §6.4), and 'print'. Each is a '@builtin', which the runtime
// implements in C (runtime/) and the interpreter in .NET.

/// The runtime's own calls, all static: standard streams, files,
/// directories, the environment, clocks and processes.
///
/// A call that can fail gives a value either way, and 'succeeded' then says
/// whether the last one did; those are wrapped here into an optional, so
/// that nothing above sees a value that is not one.
public struct Runtime {
    // ---- Standard streams ------------------------------------------------

    /// Writes the text to standard output, as it is.
    @builtin("io_write")
    public static fn write(text: String)

    /// Writes the text to standard error, as it is.
    @builtin("io_write_error")
    public static fn writeError(text: String)

    /// The next line of standard input without its line break, or none at its end.
    public static fn readLine() -> String? {
        let line = Runtime.rawReadLine()
        if Runtime.succeeded() {
            return line
        }
        return none
    }

    // ---- Files and directories -------------------------------------------

    /// The file's contents, or none when it cannot be read.
    public static fn readFile(path: String) -> String? {
        let text = Runtime.rawReadFile(path)
        if Runtime.succeeded() {
            return text
        }
        return none
    }

    /// Writes the text to the file, replacing it or adding to its end;
    /// whether that worked.
    @builtin("io_write_file")
    public static fn writeFile(path: String, text: String, append: Bool) -> Bool

    @builtin("io_file_exists")
    public static fn fileExists(path: String) -> Bool

    @builtin("io_is_directory")
    public static fn isDirectory(path: String) -> Bool

    @builtin("io_remove_file")
    public static fn removeFile(path: String) -> Bool

    @builtin("io_make_directory")
    public static fn makeDirectory(path: String) -> Bool

    /// The names in the directory, in no particular order, or none when it
    /// cannot be read.
    public static fn listDirectory(path: String) -> String[>..]? {
        let names = Runtime.rawListDirectory(path)
        if Runtime.succeeded() {
            return names
        }
        return none
    }

    // ---- The environment -------------------------------------------------

    /// The environment variable's value, or none when it is not set.
    public static fn environment(name: String) -> String? {
        let value = Runtime.rawEnvironment(name)
        if Runtime.succeeded() {
            return value
        }
        return none
    }

    /// How many arguments the program was given, its own name first.
    @builtin("io_argument_count")
    public static fn argumentCount() -> Int

    @builtin("io_argument")
    public static fn argument(index: Int) -> String

    /// The argument's bytes as the system gave them, UTF-8 or not.
    @builtin("io_argument_bytes")
    public static fn argumentBytes(index: Int) -> U8[>..]

    /// The variable set (Environment.set): false when the system refused.
    @builtin("env_set")
    public unsafe static fn setEnvironment(_ name: String, _ value: String) -> Bool

    /// The variable removed (Environment.remove): false when refused.
    @builtin("env_remove")
    public unsafe static fn removeEnvironment(_ name: String) -> Bool

    /// Every variable, as "NAME=value".
    @builtin("env_all")
    public static fn environmentEntries() -> String[>..]

    /// Every variable as the system has it, UTF-8 or not: "NAME=value" and a
    /// NUL after each.
    @builtin("env_bytes")
    public static fn environmentBytes() -> U8[>..]

    /// A text about the system (Platform, Environment): 0 the host's name,
    /// 1 the user's, 2 the home directory, 3 the temporary one, 4 the OS
    /// version, 5 the user's locale; empty where it gives none.
    @builtin("system_text")
    public static fn systemText(_ which: Int) -> String

    /// A number about the system (Platform): 0 processors, 1 the page
    /// size, 2 physical memory in bytes.
    @builtin("system_number")
    public static fn systemNumber(_ which: Int) -> Int

    /// A count of the memory manager's (MemoryStatistics).
    @builtin("memory_statistic")
    public static fn memoryStatistic(_ which: Int) -> Int

    /// Counts retains, releases and bytes allocated from now on, or no
    /// longer, as SABLE_STATS does for a whole run (Sable.Testing's Bencher).
    @builtin("memory_counting")
    public static fn countMemory(_ on: Bool)

    /// What a benchmark measures by besides the clock: 0 this process's
    /// processor time in nanoseconds, 1 that of the processes it waited
    /// for, 2 the instructions it has run, 3 the cycles it took; -1 where
    /// the system does not say.
    @builtin("measurement")
    public static fn measurement(_ which: Int) -> Int

    // ---- Time ------------------------------------------------------------
    // A monotonic clock for measuring, the wall clock for dates, both in
    // nanoseconds; and sleeping, for at least as long as asked.

    @builtin("time_monotonic")
    public static fn monotonicNanoseconds() -> Int

    /// As 'monotonicNanoseconds', but stopped while the machine sleeps.
    @builtin("time_suspending")
    public static fn suspendingNanoseconds() -> Int

    @builtin("time_wall_clock")
    public static fn wallClockNanoseconds() -> Int

    @builtin("time_sleep")
    public static fn sleep(nanoseconds: Int)

    /// The value made shareable between tasks: every object it holds
    /// counted atomically from now on, as one crossing to another task is.
    /// What a lock's value is given as it goes in, many tasks reaching it
    /// through memory the compiler does not see them share.
    @intrinsic
    public static fn share<T>(_ value: T)

    // ---- Locks ------------------------------------------------------------
    // The system's mutex and condition variable, by handle, for
    // Sable.Concurrency's Mutex, RwLock, Condition, Semaphore, Barrier and
    // CountdownLatch. A thread that waits on one blocks. A condition's wait
    // takes its mutex held, and a time of the monotonic clock to stop at,
    // or a negative one for none; it may wake for no reason.

    // ---- Files by handle ----------------------------------------------------
    // Sable.IO's FileHandle (runtime/io.c, "File handles"): a descriptor, or
    // a Windows HANDLE, as an integer. A call that fails gives -1, nothing or
    // false, and 'fileError' then says why: 1 not found, 2 permission denied,
    // 3 already exists, 4 a directory, 5 interrupted, 6 invalid input, 7
    // anything else, 'fileErrorCode' the system's own code. A read gives a
    // new array of what it read, none at the end; a position or offset of -1
    // is the file's own position.

    @builtin("file_error")
    public static fn fileError() -> Int

    @builtin("file_error_code")
    public static fn fileErrorCode() -> Int

    @builtin("file_open")
    public static fn fileOpen(_ path: String, _ flags: Int, _ permissions: Int) -> Int

    @builtin("file_read")
    public static fn fileRead(_ file: Int, _ most: Int, _ offset: Int) -> U8[>..]

    @builtin("file_write")
    public static fn fileWrite(_ file: Int, _ bytes: U8[:], _ offset: Int) -> Int

    @builtin("file_seek")
    public static fn fileSeek(_ file: Int, _ offset: Int, _ whence: Int) -> Int

    @builtin("file_sync")
    public static fn fileSync(_ file: Int) -> Bool

    @builtin("file_set_length")
    public static fn fileSetLength(_ file: Int, _ length: Int) -> Bool

    /// What it is: its size, kind (0 a file, 1 a directory, 2 a symbolic
    /// link, 3 a FIFO, 4 a socket, 5 a character and 6 a block device, 7
    /// anything else), mode bits; seconds since 1970 and the nanoseconds
    /// after of when it was written, read and made, and whether the last is
    /// known (1). None on failure.
    @builtin("file_metadata")
    public static fn fileMetadata(_ file: Int) -> Int[>..]

    @builtin("file_close")
    public static fn fileClose(_ file: Int) -> Bool

    /// Standard input (0), output (1) or error (2), as a file.
    @builtin("file_standard")
    public static fn fileStandard(_ which: Int) -> Int

    @builtin("file_copy")
    public static fn fileCopy(_ source: String, _ target: String, _ replace: Bool) -> Bool

    /// The path made absolute, every link resolved; empty when nothing is
    /// there, fileError then saying why.
    @builtin("file_canonical")
    public static fn fileCanonical(_ path: String) -> String

    /// The file's first 'length' bytes mapped (0 to read, 1 to read and
    /// write, 2 to write a private copy): an array whose elements are the
    /// mapping, which is never changed in place but by fileMapStore — a
    /// change made any other way is made to a copy. Empty for a length of
    /// zero; empty with fileError set when the system will not map it.
    @builtin("file_map")
    public static fn fileMap(_ file: Int, _ length: Int, _ mode: Int) -> U8[>..]

    /// The bytes written into a mapping made to be written, from 'at' on;
    /// false, writing nothing, for one made to read or past its end.
    @builtin("file_map_store")
    public static fn fileMapStore(_ mapped: U8[>..], _ at: Int, _ bytes: U8[:]) -> Bool

    /// What was written to the mapping's bytes from 'at' on, written to the file.
    @builtin("file_map_flush")
    public static fn fileMapFlush(_ mapped: U8[>..], _ at: Int, _ count: Int) -> Bool

    /// How the mapping will be read (0 normal, 1 in order, 2 anywhere,
    /// 3 soon, 4 not again soon), for the system to read ahead or let go.
    @builtin("file_map_advise")
    public static fn fileMapAdvise(_ mapped: U8[>..], _ advice: Int)

    // ---- The file system ---------------------------------------------------
    // By path, failing as a file handle's calls do ('fileError': 8 not
    // empty, 9 not a directory, 10 across file systems, 11 not on this
    // system). What Sable.IO's File, Directory, Temp and FileWatcher are
    // written over.

    /// What is at the path, or what a link there leads to: as 'fileMetadata'.
    @builtin("fs_metadata")
    public static fn pathMetadata(_ path: String, _ follow: Bool) -> Int[>..]

    @builtin("fs_set_permissions")
    public static fn setPathPermissions(_ path: String, _ permissions: Int) -> Bool

    /// When it was last written (0) or read (1).
    @builtin("fs_set_time")
    public static fn setPathTime(_ path: String, _ which: Int, _ seconds: Int, _ nanoseconds: Int) -> Bool

    @builtin("fs_make_directory")
    public static fn createDirectory(_ path: String, _ permissions: Int) -> Bool

    /// A file or a link itself, or an empty directory.
    @builtin("fs_remove")
    public static fn removePath(_ path: String, _ directory: Bool) -> Bool

    /// A directory and all in it, no link followed.
    @builtin("fs_remove_tree")
    public static fn removeTree(_ path: String) -> Bool

    @builtin("fs_rename")
    public static fn renamePath(_ source: String, _ target: String, _ replace: Bool) -> Bool

    /// A hard link (0), or a symbolic one to a file (1) or a directory (2).
    @builtin("fs_link")
    public static fn linkPath(_ target: String, _ path: String, _ kind: Int) -> Bool

    @builtin("fs_read_link")
    public static fn readLink(_ path: String) -> U8[>..]

    /// A directory open to read its entries, or 0.
    @builtin("fs_open_directory")
    public static fn openDirectory(_ path: String) -> Int

    /// The next entry: its kind (255 where the directory does not say) and
    /// its name's bytes; none at the end, or on failure.
    @builtin("fs_next_entry")
    public static fn nextEntry(_ directory: Int) -> U8[>..]

    @builtin("fs_close_directory")
    public static fn closeDirectory(_ directory: Int)

    /// The path watched: a handle, to be given back by 'unwatchPath', or 0.
    @builtin("fs_watch")
    public static fn watchPath(_ path: String, _ recursive: Bool) -> Int

    /// What 'waitForSocket' waits for, for more to be taken.
    @builtin("fs_watch_event")
    public static fn watchEvent(_ watch: Int) -> Int

    /// What happened next (1 made, 2 written, 3 removed, 4 to be looked at
    /// again) and the bytes of where, inside the path watched; none for now.
    @builtin("fs_watch_take")
    public static fn takeWatched(_ watch: Int) -> U8[>..]

    @builtin("fs_unwatch")
    public static fn unwatchPath(_ watch: Int)

    // ---- Threads ------------------------------------------------------------
    // The system's threads, by handle, for Sable.Concurrency's Thread: made,
    // started, waited for until a time of the monotonic clock (or, negative,
    // for as long as it takes). A handle is released by whoever has it.

    /// A thread that 'startThread' starts: its name, the bytes of stack it is
    /// to have (0: as many as the main thread) and its priority, -2 to 2.
    @builtin("thread_new")
    public static fn threadNew(_ name: String, _ stackSize: Int, _ priority: Int) -> Int

    @builtin("thread_release")
    public static fn threadRelease(_ thread: Int)

    /// The calling thread, to release.
    @builtin("thread_current")
    public static fn threadCurrent() -> Int

    @builtin("thread_id")
    public static fn threadId(_ thread: Int) -> Int

    @builtin("thread_name")
    public static fn threadName(_ thread: Int) -> String

    /// The work run on the thread made, on the system's own.
    @intrinsic
    public static fn startThread(_ thread: Int, _ work: () -> ())

    /// Whether the thread has ended, having waited for it.
    @builtin("thread_join")
    public static fn threadJoin(_ thread: Int, until: Int) -> Bool

    @builtin("thread_ended")
    public static fn threadEnded(_ thread: Int) -> Bool

    /// The calling thread's token taken: whether it had, or was given, one.
    @builtin("thread_park")
    public static fn threadPark(until: Int) -> Bool

    @builtin("thread_unpark")
    public static fn threadUnpark(_ thread: Int)

    @builtin("thread_yield")
    public static fn threadYield()

    /// How many threads run tasks: 0 when the main thread runs every one.
    @builtin("thread_workers")
    public static fn workerCount() -> Int

    /// The machine's processors (runtime/topology.c): how many processors and
    /// caches; for each processor its id, core, package, node and efficiency
    /// class; then for each cache its level, kind (1 data, 2 instruction, 3
    /// unified), size, line size, how many processors share it, and their ids.
    @builtin("thread_topology")
    public static fn processorTopology() -> Int[>..]

    /// The calling thread's priority, -2 to 2: whether the system took it.
    @builtin("thread_priority_set")
    public static fn setThreadPriority(_ level: Int) -> Bool

    /// The calling thread's priority, -2 to 2, as the system has it.
    @builtin("thread_priority_get")
    public static fn threadPriority() -> Int

    /// Binds the calling thread to the processors: whether the system did.
    @builtin("thread_affinity_set")
    public static fn setThreadAffinity(_ processors: Int[>..]) -> Bool

    /// The processors the calling thread may run on; empty where the system
    /// does not say.
    @builtin("thread_affinity_get")
    public static fn threadAffinity() -> Int[>..]

    /// The pool's placement: the cores it leaves as it starts, and its workers'
    /// priority and processors (empty: any). Whether the cores will be left.
    @builtin("thread_pool_place")
    public static fn placeWorkers(_ reserved: Int, _ priority: Int, _ processors: Int[>..]) -> Bool

    /// What the calling thread blocks on until a task says that it is done.
    /// Traps on a thread that runs tasks, other than the main one.
    @builtin("thread_block_new")
    public static fn blockNew() -> Int

    @builtin("thread_block_done")
    public static fn blockDone(_ block: Int)

    @builtin("thread_block_wait")
    public static fn blockWait(_ block: Int)

    /// The work run by this thread and, at once, by as many of the pool's as
    /// come, so that at most 'degree' run it (0: as many as there are
    /// workers); it divides what there is to do, and returns once nothing is
    /// left to take. This returns once every run of it has.
    @intrinsic
    public static fn runLoop(_ degree: Int, _ work: () -> ())

    /// Said by a thread that takes another piece of what it runs in a loop.
    @builtin("thread_loop_more")
    public static fn loopMore()

    // A value for each thread, by a key: where it is, 0 until the thread has
    // one; put there, with what destroys it as the thread ends.

    @builtin("thread_local_key")
    public static fn threadLocalKey() -> Int

    @builtin("thread_local_free")
    public static fn threadLocalFree(_ key: Int)

    @builtin("thread_local_find")
    public static fn threadLocalFind(_ key: Int) -> Int

    @intrinsic
    public static fn setThreadLocal(_ key: Int, _ cell: Int, _ destroy: () -> ())

    // A value bound where the running task is, and in the children it spawns
    // there: where it is, or 0; bound, and the innermost binding ended. It is
    // destroyed once neither that nor a child has it.

    @builtin("task_local_key")
    public static fn taskLocalKey() -> Int

    @builtin("task_local_find")
    public static fn taskLocalFind(_ key: Int) -> Int

    @intrinsic
    public static fn pushTaskLocal(_ key: Int, _ cell: Int, _ destroy: () -> ())

    @builtin("task_local_pop")
    public static fn popTaskLocal()

    // ---- Locks, and reader/writer locks -------------------------------------

    @builtin("lock_new")
    public static fn lockNew() -> Int

    /// How many bytes before a lock are its maker's to use, for what it
    /// guards: on the lock's own cache line, so that a thread that has
    /// taken the lock has them too. Aligned as an Int is.
    public static const lockRoom = 24

    @builtin("lock_free")
    public static fn lockFree(_ lock: Int)

    @builtin("lock_acquire")
    public static fn lockAcquire(_ lock: Int)

    /// As 'lockAcquire', by a thread that comes for many things at once: if
    /// the lock is held, it lets them gather for a microsecond or so first.
    @builtin("lock_acquire_later")
    public static fn lockAcquireLater(_ lock: Int)

    @builtin("lock_try_acquire")
    public static fn lockTryAcquire(_ lock: Int) -> Bool

    @builtin("lock_release")
    public static fn lockRelease(_ lock: Int)

    @builtin("rwlock_new")
    public static fn rwLockNew() -> Int

    @builtin("rwlock_free")
    public static fn rwLockFree(_ lock: Int)

    // Takes the lock to read: what rwLockReadDone is given.
    @builtin("rwlock_read")
    public static fn rwLockRead(_ lock: Int) -> Int

    @builtin("rwlock_read_done")
    public static fn rwLockReadDone(_ lock: Int, _ counted: Int)

    @builtin("rwlock_write")
    public static fn rwLockWrite(_ lock: Int)

    @builtin("rwlock_write_done")
    public static fn rwLockWriteDone(_ lock: Int)

    @builtin("condition_new")
    public static fn conditionNew() -> Int

    @builtin("condition_free")
    public static fn conditionFree(_ condition: Int)

    @builtin("condition_wait")
    public static fn conditionWait(_ condition: Int, _ lock: Int, until: Int)

    @builtin("condition_signal")
    public static fn conditionSignal(_ condition: Int)

    @builtin("condition_broadcast")
    public static fn conditionBroadcast(_ condition: Int)

    // ---- Sockets -----------------------------------------------------------
    // Streams and datagrams, by handle (0: none), every socket nonblocking
    // and watched by the runtime's I/O reactor: kqueue, epoll or an I/O
    // completion port. A call that would block gives nothing, and
    // 'socketStatus' then says 1 (2: it failed, and 'socketError' why); the
    // caller waits for the socket with 'waitForSocket' — the task suspends,
    // its worker runs others — and calls again. What Sable.Net's types, and
    // Sable.Process's pipes, are written over.
    //
    // An address is its family (4, 6; 1, a Unix domain socket's), its 128
    // bits' halves, its scope, its port and its path. One a call gives is
    // kept for 'socketAddress' and 'socketPath', to be taken before the task
    // suspends.

    /// What the last socket call did: 0 done, 1 would block, 2 failed.
    @builtin("net_status")
    public static fn socketStatus() -> Int

    /// Why it failed, by the numbers platform.h's NET_ERROR_ have.
    @builtin("net_error")
    public static fn socketError() -> Int

    /// The system's own code for it.
    @builtin("net_error_code")
    public static fn socketErrorCode() -> Int

    /// A part of the address the last call gave: 0 its family, 1 and 2 its
    /// halves, 3 its scope, 4 its port; 5, whether the datagram that came
    /// with it was cut short.
    @builtin("net_address")
    public static fn socketAddress(_ part: Int) -> Int

    /// And a Unix domain socket's path.
    @builtin("net_path")
    public static fn socketPath() -> String

    /// A socket listening on the address. Of 'flags', 1 shares the address,
    /// 2 the port, 4 has an IPv6 socket take IPv4 too, 8 replaces a Unix
    /// domain socket's file.
    @builtin("net_listen")
    public static fn listen(_ family: Int, _ high: Int, _ low: Int, _ scope: Int, _ port: Int, _ path: String, _ backlog: Int, _ flags: Int) -> Int

    /// A connection taken from a listening socket, and its peer's address.
    @builtin("net_accept")
    public static fn accept(_ socket: Int) -> Int

    /// A connection begun: once the socket is writable, 'socketConnected'
    /// says whether it was made.
    @builtin("net_connect")
    public static fn connect(_ family: Int, _ high: Int, _ low: Int, _ scope: Int, _ port: Int, _ path: String) -> Int

    @builtin("net_connected")
    public static fn socketConnected(_ socket: Int) -> Bool

    /// Up to so many bytes read; none at the end of what the other end sends.
    @builtin("net_read")
    public static fn readSocket(_ socket: Int, _ most: Int) -> U8[>..]

    /// Some of the bytes written: how many.
    @builtin("net_write")
    public static fn writeSocket(_ socket: Int, _ bytes: U8[:]) -> Int

    /// A datagram socket bound to the address.
    @builtin("net_datagram")
    public static fn datagramSocket(_ family: Int, _ high: Int, _ low: Int, _ scope: Int, _ port: Int, _ path: String, _ flags: Int) -> Int

    /// The datagram socket sends to the address, and takes only its datagrams.
    @builtin("net_connect_datagram")
    public static fn connectDatagramSocket(_ socket: Int, _ family: Int, _ high: Int, _ low: Int, _ scope: Int, _ port: Int, _ path: String) -> Bool

    /// A datagram sent to the address: its family 0, to the one it is
    /// connected to.
    @builtin("net_send")
    public static fn sendDatagram(_ socket: Int, _ bytes: U8[:], _ family: Int, _ high: Int, _ low: Int, _ scope: Int, _ port: Int, _ path: String) -> Int

    /// A datagram received, and whom it is from.
    @builtin("net_receive")
    public static fn receiveDatagram(_ socket: Int, _ most: Int) -> U8[>..]

    /// The socket's own address, or its peer's, for 'socketAddress'.
    @builtin("net_name")
    public static fn socketName(_ socket: Int, peer: Bool) -> Bool

    /// One of platform.h's NET_OPTION_.
    @builtin("net_set_option")
    public static fn setSocketOption(_ socket: Int, _ option: Int, _ value: Int) -> Bool

    @builtin("net_option")
    public static fn socketOption(_ socket: Int, _ option: Int) -> Int

    /// In a multicast group, or out of it, on the interface of the index.
    @builtin("net_membership")
    public static fn socketMembership(_ socket: Int, join: Bool, _ family: Int, _ high: Int, _ low: Int, _ interface: Int) -> Bool

    /// No more is written, and the other end reads to its end; or no more
    /// is read.
    @builtin("net_shutdown")
    public static fn shutdownSocket(_ socket: Int, writing: Bool)

    /// Closed; waiting tasks wake to find it so. Closing twice does nothing.
    @builtin("net_close")
    public static fn closeSocket(_ socket: Int)

    /// The host's addresses, of a family or (0) any, looked up on a thread
    /// of the runtime's: a lookup, or 0, to be ended with 'endLookup'.
    @builtin("net_resolve")
    public static fn beginLookup(_ host: String, _ family: Int) -> Int

    /// What to wait for, for the lookup to be done.
    @builtin("net_resolve_event")
    public static fn lookupEvent(_ lookup: Int) -> Int

    /// How many addresses it found, 'socketStatus' saying how it went.
    @builtin("net_resolved")
    public static fn lookupCount(_ lookup: Int) -> Int

    /// One of them, for 'socketAddress'.
    @builtin("net_resolved_take")
    public static fn takeLookupAddress(_ lookup: Int, _ index: Int)

    /// No longer wanted: what it has yet to find is dropped.
    @builtin("net_resolve_end")
    public static fn endLookup(_ lookup: Int)

    /// The machine's interfaces listed, a row for each address: how many
    /// rows, or -1. With false, what was listed is let go of.
    @builtin("net_interfaces")
    public static fn interfaces(list: Bool) -> Int

    @builtin("net_interface_name")
    public static fn interfaceName(_ row: Int) -> String

    /// A part of a row: 0 the interface's index, 1 its flags, 2 its MTU, 3
    /// its hardware address or -1, 4 its address's prefix length; 5, its
    /// address's family, the address kept for 'socketAddress'.
    @builtin("net_interface")
    public static fn interfacePart(_ row: Int, _ part: Int) -> Int

    /// The index of the interface of that name, or 0.
    @builtin("net_interface_index")
    public static fn interfaceIndex(_ name: String) -> Int

    /// Waits until the socket is ready to read, or to write: the running
    /// task suspends until the reactor says so, and its worker runs others.
    /// The compiler writes it: a place the task may suspend.
    @intrinsic
    public static async fn waitForSocket(_ socket: Int, writable: Bool)

    // ---- Processes -------------------------------------------------------
    // Another program run to its end, its output kept; and this one's
    // directory and identity.

    /// Runs the program found on PATH with the input written to it, and
    /// gives its output; none when nothing by that name starts.
    /// 'lastExitStatus' and 'lastErrorOutput' then say how it ended.
    public static fn run(program: String, arguments: String[>..], input: String) -> String? {
        let output = Runtime.rawRun(program, arguments, input)
        if Runtime.succeeded() {
            return output
        }
        return none
    }

    @builtin("process_status")
    public static fn lastExitStatus() -> Int

    /// The signal that ended the program 'run' ran, or 0.
    @builtin("process_status_signal")
    public static fn lastExitSignal() -> Int

    @builtin("process_error_output")
    public static fn lastErrorOutput() -> String

    /// Why the last 'run' or 'spawn' could not start its program: 1 not
    /// found, 2 permission denied, 3 its directory, 4 not a program the
    /// system runs, 5 a stream's file, 6 not on this system, 7 anything
    /// else; and the system's own code, or which stream.
    @builtin("process_error")
    public static fn processError() -> Int

    @builtin("process_error_code")
    public static fn processErrorCode() -> Int

    /// The program started and left running: a child's handle, to be given
    /// back by 'releaseChild', or 0. In 'flags' two bits for each standard
    /// stream — 0 this program's own, 1 nothing, 2 a pipe, 3 the file of
    /// that position in 'files' — and 64 when the environment is all the
    /// child is to have, "NAME=value" each. An empty directory is this
    /// program's.
    @builtin("process_spawn")
    public static fn spawn(_ program: String, _ arguments: String[>..], _ environment: String[>..], _ flags: Int, _ directory: String, _ files: String[>..]) -> Int

    /// This program's end of a child's stream (0 to 2), read, written,
    /// waited for and closed as a socket is; 0 when it is no pipe.
    @builtin("process_pipe")
    public static fn childPipe(_ child: Int, _ which: Int) -> Int

    @builtin("process_child_id")
    public static fn childId(_ child: Int) -> Int

    @builtin("process_ended")
    public static fn childEnded(_ child: Int) -> Bool

    /// How a child that has ended did: its exit code, or the signal that
    /// ended it (0 for none).
    @builtin("process_exit_code")
    public static fn childExit(_ child: Int, signal: Bool) -> Int

    /// What 'waitForSocket' waits for, for the child to have ended, and
    /// 'closeSocket' closes: 0 when it has.
    @builtin("process_exit_event")
    public static fn childExitEvent(_ child: Int) -> Int

    /// The signal sent to the child, or (-1) it and all it started killed:
    /// 0 done, 1 it has ended, 2 it could not be.
    @builtin("process_signal")
    public static fn signalChild(_ child: Int, _ signal: Int) -> Int

    @builtin("process_release")
    public static fn releaseChild(_ child: Int)

    /// The program ended here, with the status.
    @builtin("process_exit")
    public static fn exit(_ status: Int) -> Never

    /// The program ended here, as a trap ends it, with nothing said.
    @builtin("process_abort")
    public static fn abort() -> Never

    /// Listening for the signals, a bit each by number: a handle, to be
    /// given back by 'unwatchSignals'; 0 when one cannot be caught.
    @builtin("signal_watch")
    public static fn watchSignals(_ signals: Int) -> Int

    /// What 'waitForSocket' waits for, for a signal to have come.
    @builtin("signal_event")
    public static fn signalEvent(_ watch: Int) -> Int

    /// A signal that came, taken; 0 for none.
    @builtin("signal_take")
    public static fn takeSignal(_ watch: Int) -> Int

    @builtin("signal_unwatch")
    public static fn unwatchSignals(_ watch: Int)

    /// The signal sent to this program.
    @builtin("signal_raise")
    public static fn raiseSignal(_ signal: Int) -> Bool

    /// Whether a standard stream (0, 1 or 2) is a terminal.
    @builtin("terminal_is")
    public static fn isTerminal(_ stream: Int) -> Bool

    /// Whether it is a terminal that reads escape sequences, asked to if it
    /// must be (Windows).
    @builtin("terminal_styles")
    public static fn terminalStyles(_ stream: Int) -> Bool

    /// Its columns, shifted left by 32, and its rows; 0 where there is no
    /// saying.
    @builtin("terminal_size")
    public static fn terminalSize(_ stream: Int) -> Int

    /// Standard input's terminal put in a mode: 0 as it was found, 1 raw, 2
    /// raw with the interrupt's keys as any others. The mode it had; -1
    /// where there is no terminal. Undone however the program ends.
    @builtin("terminal_mode")
    public static fn terminalMode(_ mode: Int) -> Int

    /// What standard output's terminal is about to show, undone however the
    /// program ends: 1 the alternate screen, 2 no cursor.
    @builtin("terminal_show")
    public static fn terminalShow(_ shown: Int)

    /// A byte typed at standard input's terminal, within so many
    /// milliseconds, or however long for less than none: -1 when there will
    /// be no more, -2 when there was none in that time.
    @builtin("terminal_read")
    public static fn terminalRead(_ milliseconds: Int) -> Int

    /// A pseudoterminal, for the tests of what needs a terminal: 0 where the
    /// system has none such.
    @builtin("pty_open")
    public static fn ptyOpen() -> Int

    /// The file a program's streams are to be for it to be their terminal.
    @builtin("pty_name")
    public static fn ptyName(_ pty: Int) -> String

    /// A call on it: 0 closes it; 1 reads a byte of what was written to the
    /// terminal, as terminalRead; 2 types a byte; 3 sets its size, as
    /// terminalSize has it; 4 gives its mode (1 whole lines, 2 echo, 4 the
    /// interrupt's keys).
    @builtin("pty_call")
    public static fn ptyCall(_ pty: Int, _ call: Int, _ argument: Int) -> Int

    /// This program's streams made the pseudoterminal's of the name, and it
    /// the program's controlling terminal if that is asked.
    @builtin("pty_attach")
    public static fn ptyAttach(_ name: String, _ controlling: Bool) -> Bool

    /// The message sent as a datagram to the Unix socket named, as systemd's
    /// sd_notify does: a path, or '@' and an abstract name (Linux). 0 sent, 1
    /// the system has none such, 2 it could not be sent.
    @builtin("process_notify")
    public static fn notifyService(_ socket: String, _ message: String) -> Int

    /// A Windows service's part with the Service Control Manager: 0
    /// connects to it, waiting until it has (a stop it asks for comes as
    /// SIGTERM); 1, 2 and 3 tell it the service is running, stopping and
    /// stopped. 0 done, 1 the program is not a service, 2 it failed, 3 there
    /// are no Windows services here.
    @builtin("process_service")
    public static fn windowsService(_ call: Int) -> Int

    @builtin("process_current_directory")
    public static fn currentDirectory() -> String

    @builtin("process_change_directory")
    public static fn changeDirectory(path: String) -> Bool

    /// How many objects (arrays' buffers among them) the running thread
    /// has allocated so far: compared before and after, how many some code
    /// allocates. The interpreter counts its own the same way.
    @builtin("memory_allocations")
    public static fn allocationCount() -> Int

    @builtin("process_id")
    public static fn processId() -> Int

    /// The path this program was started by, to start it again with; empty
    /// where there is none, as in the interpreter.
    @builtin("process_executable_path")
    public static fn executablePath() -> String

    // ---- Stopping ----------------------------------------------------------

    /// Stops the program as a trap does: 'fatal error: ' and the message on
    /// standard error, the place on the next line ('at file:line', left out
    /// when empty), a backtrace with SABLE_BACKTRACE set, and status 134.
    /// What fatalError and precondition are written over.
    @builtin("trap")
    public static fn trap(message: String, site: String) -> Never

    /// The frames of the calls that led here, a line each, the caller's
    /// first: 'symbol at file:line:column' in a debug build, 'symbol +
    /// offset' otherwise, natively; none in the interpreter.
    @builtin("backtrace_capture")
    public static fn backtraceFrames() -> String[>..]

    /// Stops the program as a trap does, but with status 1: what an error
    /// that leaves main ends it with (uncaughtError).
    @builtin("trap_uncaught")
    public static fn stopUncaught(message: String, site: String) -> Never

    /// Ends the program, with status 124, once so many nanoseconds have
    /// passed and then the grace: after the first the message, and where
    /// every thread and task is, go to standard error, and the running task
    /// is cancelled. 0 for no limit, the one before forgotten, and the task
    /// no longer cancelled if it was for that one. The task asks for both
    /// before it ends. It does not hold while a debugger is attached,
    /// nor where there are no threads (WebAssembly, the interpreter).
    @builtin("watchdog")
    public static fn watchdog(_ nanoseconds: Int, grace: Int, _ message: String)

    /// Has every trap from now on said by the hook, in place of the
    /// report: given the message, the place ('file:line:column', or empty)
    /// and the frames, a line each. What Sable.Diagnostics' Panic.setHook
    /// is written over; it runs on whichever thread trapped.
    @builtin("trap_hook_set")
    public static fn setTrapHook(_ hook: @escaping (String, String, String[>..]) -> Void)

    /// The hook set, taken out, leaving the default report in its place;
    /// 'otherwise' when none was set.
    @builtin("trap_hook_take")
    public static fn takeTrapHook(otherwise: @escaping (String, String, String[>..]) -> Void) -> (String, String, String[>..]) -> Void

    // ---- Strings, in one call --------------------------------------------
    // What String's conformances and Sable.Text are written over: hashing
    // and ordering by the UTF-8 bytes, and joining, in one call rather than
    // a call per scalar or a copy per part.

    /// The text's UTF-8 bytes hashed under a key (folded multiplies): what a
    /// Hasher folds a string in with.
    @builtin("string_hash")
    public static fn hashString(text: String, key: Int) -> Int

    /// The seed every Hasher starts from: random for each run of the
    /// program, unless SABLE_DETERMINISTIC_HASHING=1 fixes it.
    @builtin("hash_seed")
    public static fn hashSeed() -> Int

    /// 64 bits from the operating system's random source (a trap when
    /// it fails), fresh at each call: what SystemRandomNumberGenerator draws.
    @builtin("random_bits")
    public static fn randomBits() -> Int

    /// Where the part next occurs in the text at or after the scalar
    /// position: its scalar index, or -1. Natively a vectorised byte search.
    @builtin("string_find")
    public static fn findString(text: String, part: String, from: Int) -> Int

    /// Where the part next occurs in the text at or after the UTF-8 offset:
    /// its UTF-8 offset, or -1. Natively a vectorised byte search, with no
    /// scalars counted.
    @builtin("string_utf8_find")
    public static fn findUtf8(text: String, part: String, from: Int) -> Int

    /// Where the last occurrence of the part that ends at or before the
    /// UTF-8 offset starts: its UTF-8 offset, or -1.
    @builtin("string_utf8_find_last")
    public static fn findLastUtf8(text: String, part: String, before: Int) -> Int

    /// Where the first ill-formed UTF-8 sequence in the bytes starts, or -1
    /// when they are all well-formed: no overlong forms, no surrogates,
    /// nothing past U+10FFFF, nothing cut short. Natively, ASCII is passed
    /// over sixteen bytes at a time. Sable.Text's codecs are written over it.
    @builtin("utf8_validate")
    public static fn validateUtf8(bytes: U8[:]) -> Int

    // A byte in a slice of bytes, natively searched with the C library's
    // vectorised memchr, or counted sixteen bytes at a time: what U8[:]'s
    // own contains, firstIndex(of:), firstIndex(ofAny:) and count(of:) are.

    @builtin("bytes_find")
    public static fn findByte(_ bytes: U8[:], _ byte: U8) -> Int

    @builtin("bytes_find_any")
    public static fn findAnyByte(_ bytes: U8[:], _ candidates: U8[:]) -> Int

    @builtin("bytes_count")
    public static fn countByte(_ bytes: U8[:], _ byte: U8) -> Int

    /// The bytes as a string when they are well-formed UTF-8 — checked, then
    /// copied, in two passes over them — or none.
    public static fn decodeUtf8(bytes: U8[:]) -> String? {
        if Runtime.validateUtf8(bytes) >= 0 {
            return none
        }
        unsafe {
            return Runtime.stringFromValidUtf8(bytes)
        }
    }

    /// The bytes as a string, copied and not checked: they must be
    /// well-formed UTF-8, which the runtime's counting, indexing and slicing
    /// of a string assume, reading past a sequence cut short otherwise.
    /// Sable.Text's 'String.fromUtf8Unchecked' is written over it.
    @builtin("string_from_utf8_unchecked")
    public unsafe static fn stringFromValidUtf8(_ bytes: U8[:]) -> String

    /// The first 'count' bytes of the words, each little-endian, as a
    /// string: short ASCII text made in registers, with no array to fill
    /// first. The bytes must be ASCII and the count at most forty, neither
    /// of which is checked.
    @builtin("string_from_ascii_words")
    public unsafe static fn stringFromAscii(_ first: U64, _ second: U64, _ third: U64, _ fourth: U64, _ fifth: U64, count: Int) -> String

    @builtin("string_join")
    public static fn joinStrings(parts: String[>..], separator: String) -> String

    /// Negative, zero or positive as the left orders before, with or after the right.
    @builtin("string_compare")
    public static fn compareStrings(left: String, right: String) -> Int

    // ---- Ranges of a string's bytes ----------------------------------------
    // What a Substring reads through: the forms above over a range of a
    // string's bytes, each from one offset up to another that must be
    // scalar boundaries in order inside it (the runtime does not check), so
    // a piece of a text is read where it lies rather than copied out first.

    /// How many scalars the bytes from one offset up to another hold: at
    /// once for an ASCII string.
    @builtin("string_count_range")
    public static fn countScalars(_ text: String, _ from: Int, _ to: Int) -> Int

    /// Negative, zero or positive as the left range of bytes orders before,
    /// with or after the right: `compareStrings` over the two ranges.
    @builtin("string_compare_range")
    public static fn compareStrings(_ left: String, _ leftFrom: Int, _ leftTo: Int, _ right: String, _ rightFrom: Int, _ rightTo: Int) -> Int

    /// Where the part's range of bytes first occurs inside the text's: its
    /// UTF-8 offset in the text, or -1.
    @builtin("string_utf8_find_range")
    public static fn findUtf8(_ text: String, _ from: Int, _ to: Int, _ part: String, _ partFrom: Int, _ partTo: Int) -> Int

    /// Where the first byte of the text's range is that is in one of the
    /// ranges of ASCII bytes, each two characters, its least and its
    /// greatest: its UTF-8 offset in the text, or -1. Natively, up to four
    /// are looked for sixteen bytes at a time.
    @builtin("string_utf8_find_any")
    public static fn findAnyUtf8(_ text: String, _ from: Int, _ to: Int, _ ranges: String) -> Int

    /// Where the part's range of bytes last occurs inside the text's: its
    /// UTF-8 offset in the text, or -1.
    @builtin("string_utf8_find_last_range")
    public static fn findLastUtf8(_ text: String, _ from: Int, _ to: Int, _ part: String, _ partFrom: Int, _ partTo: Int) -> Int

    /// The range of bytes hashed under a key as a string of just those
    /// bytes is: a Substring hashes as its String.
    @builtin("string_hash_range")
    public static fn hashString(_ text: String, _ from: Int, _ to: Int, key: Int) -> Int

    // ---- The fallible calls, raw -----------------------------------------

    /// Whether the last fallible call succeeded.
    @builtin("io_succeeded")
    static fn succeeded() -> Bool

    @builtin("io_read_line")
    static fn rawReadLine() -> String

    @builtin("io_read_file")
    static fn rawReadFile(_ path: String) -> String

    @builtin("io_list_directory")
    static fn rawListDirectory(_ path: String) -> String[>..]

    @builtin("io_environment")
    static fn rawEnvironment(_ name: String) -> String

    @builtin("process_run")
    static fn rawRun(_ program: String, _ arguments: String[>..], _ input: String) -> String
}

extension Region {
    /// The value, moved into the region; a reference to it, rooted in the
    /// region, back (docs/02 §2.1). The compiler gives the body: room is
    /// bumped in the region and the value stored there, for any type.
    @intrinsic
    public fn alloc<T>(_ value: T) -> T&

    /// Everything in the region destroyed, its memory kept for what comes next.
    @builtin("region_reset")
    public fn reset()
}
