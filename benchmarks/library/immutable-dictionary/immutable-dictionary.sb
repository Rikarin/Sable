module ImmutableDictionaryBench

// ImmutableDictionary<Int, Int>: built in place, read, changed with every
// version kept for a while, taken apart.

import Sable.Collections

fn key(_ i: Int) -> Int => (i * 1103515245 + 12345) % 2147483648

@main
fn main() {
    var map = ImmutableDictionary<Int, Int>()
    for i in 0..<200000 {
        map[key(i)] = i
    }
    var total = 0
    for i in 0..<400000 {
        if let value = map[key(i)] {
            total += value
        }
    }
    var versions: ImmutableDictionary<Int, Int>[>..] = []
    var current = map
    for i in 0..<100000 {
        current = current.setting(key(i * 3), to: i)
        if i % 1000 == 0 {
            versions.append(current)
        }
    }
    for version in versions {
        total += version.count
    }
    for i in 0..<100000 {
        map.remove(key(i * 2))
    }
    for (key, value) in map {
        total = total &+ (key ^ value)
    }
    print("\(total) \(map.count) \(current.count)")
}
