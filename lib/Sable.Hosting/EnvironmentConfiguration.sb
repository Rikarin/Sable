module Sable.Hosting

import Sable.IO

/// Configuration from the environment's variables: "Http:Port" is the
/// variable `Http__Port`, else `HTTP__PORT`, after the prefix.
///
/// ```sable
/// let configuration = EnvironmentConfiguration(prefix: "SHOP_")
/// assert(configuration.value("No:Such:Key") == none)   // SHOP_No__Such__Key
/// ```
public struct EnvironmentConfiguration: HostConfiguration {
    /// What each variable's name starts with.
    public let start: String

    /// The variables whose names start with the prefix.
    public init(prefix start: String = "") {
        self.start = start
    }

    /// The key's variable's value, when it is set.
    public fn value(_ key: String) -> String? {
        let name = key.replacing(":", with: "__")
        if let exact = Environment.variable(start + name) {
            return exact
        }
        return Environment.variable(start + name.uppercased())
    }
}
