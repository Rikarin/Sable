module SecureRandomTests

// SecureRandom (Sable.Crypto). Run with
//     tools/stdlib-coverage.sh Sable.Crypto

import Sable.Crypto
import Sable.Testing

@test(arguments: [0, 1, 7, 255, 256, 257, 1000, 100_000])
fn itGivesAsManyBytesAsAreAskedFor(_ count: Int) {
    expect(SecureRandom.bytes(count).count == count)
}

// Every byte of a long run is as likely as any: none is missing from 100,000.
@test
fn everyByteComes() {
    var seen = U8[>..](repeating: 0, count: 256)
    for byte in SecureRandom.bytes(100_000) {
        seen[Int(byte)] = 1
    }
    expect(!seen.contains(element: 0))
}

@test
fn fillingReplacesEveryByte() {
    var bytes = U8[>..](repeating: 0, count: 1000)
    SecureRandom.fill(&bytes)
    // Each 100 bytes of zeros left has a chance of one in 2^800.
    var start = 0
    while start < 1000 {
        expect(bytes[start..<start + 100] != U8[>..](repeating: 0, count: 100)[0...], "from \(start)")
        start += 100
    }
    let before = bytes
    SecureRandom.fill(&bytes[..<500])
    expect(bytes[500...] == before[500...])
    expect(bytes[..<500] != before[..<500])
}

@test
fn noTwoAreAlike() {
    expect(SecureRandom.bytes(32) != SecureRandom.bytes(32))
}

@test
fn manyBytesAreFilledToTheEnd() {
    let bytes = SecureRandom.bytes(1_000_003)
    var counts = Int[>..](repeating: 0, count: 256)
    for byte in bytes {
        counts[Int(byte)] += 1
    }
    // Each 3906 times, give or take ten times the deviation.
    expect(counts.allSatisfy { $0 > 3280 && $0 < 4532 })
    expect(bytes[999_940...] != U8[>..](repeating: 0, count: 63))
}
