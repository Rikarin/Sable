module Sable.IO

import Sable.Concurrency

/// Bytes passed from a writing task to a reading one through buffers of
/// the pipe's own, rented from a BufferPool: .NET's System.IO.Pipelines,
/// what a server reads requests through. The writer fills buffers and
/// flushes them to the reader; the reader is given every byte not yet
/// consumed, in the buffers they lie in, and says how far it consumed and
/// how far it looked — so a parser that needs more than it has asks for
/// more without copying what it has, and gets it when more is written.
///
/// A writer that gets `pauseWriterThreshold` bytes ahead of its reader
/// waits in its flush until the reader is back at or under
/// `resumeWriterThreshold`: the pipe never holds much more than that. A
/// reader that needs a message whole waits for the rest of it, so both
/// thresholds must be above the largest message: a writer held back by a
/// reader that is waiting for it waits for ever, as .NET's does.
///
/// `reader` and `writer` are its two ends.
///
/// ```sable
/// let pipe = Pipe()
/// let writing = Task.spawn {
///     try! await pipe.writer.write([104, 105, 10])
///     await pipe.writer.complete()
/// }
/// let result = await pipe.reader.read()
/// assert(result.buffer.firstIndex(of: 10) == 2)
/// await pipe.reader.advance(consumed: 3)
/// await writing.value
/// ```
@immutable
public final class Pipe {
    /// How far ahead of its reader a writer gets before its flush waits.
    public let pauseWriterThreshold: Int
    /// How far ahead of its reader a waiting writer goes on again: at or
    /// under it, 0 meaning once the reader has consumed everything.
    public let resumeWriterThreshold: Int
    /// How big a buffer the writer fills: the most a segment holds.
    public let segmentSize: Int

    // Behind a lock held for no longer than a copy: an end waits by parking
    // in a wait list, whose ticket it takes before it looks, so that a wake
    // between its look and its park is not missed.
    let state: Mutex<PipeState>
    let readers: WaitList
    let writers: WaitList

    public init(pauseWriterThreshold: Int = 65536, resumeWriterThreshold: Int = 32768, segmentSize: Int = 4096) {
        precondition(resumeWriterThreshold <= pauseWriterThreshold && segmentSize > 0, "a pipe resumes at or under where it pauses")
        self.pauseWriterThreshold = pauseWriterThreshold
        self.resumeWriterThreshold = resumeWriterThreshold
        self.segmentSize = segmentSize
        self.state = Mutex(PipeState(segmentSize))
        self.readers = WaitList()
        self.writers = WaitList()
    }

    /// The end bytes are read from.
    public var reader: PipeReader {
        get {
            return PipeReader { pipe: self }
        }
    }

    /// The end bytes are written to.
    public var writer: PipeWriter {
        get {
            return PipeWriter { pipe: self }
        }
    }

    /// Bytes flushed and not yet consumed.
    public var length: Int => state.withLock { $0.buffered }

    // ---- Writing -----------------------------------------------------------

    fn copyIn(_ bytes: U8[:]) {
        state.withLock { $0.copyIn(bytes) }
    }

    fn takeIn(_ segment: U8[>..]) {
        state.withLock { $0.takeIn(segment) }
    }

    fn flushWritten() async -> FlushResult {
        return await flushed([])
    }

    // The bytes copied in and flushed, with whatever was before them: under
    // the lock once, unless the flush must wait.
    fn flushed(_ bytes: U8[:]) async -> FlushResult {
        let (wakes, ended) = state.withLock { (state: inout PipeState) -> (Bool, FlushResult?) in
            let onto = state.copyOn(bytes)
            state.copyIn(bytes[onto..<bytes.count])
            let published = state.publish()
            let wakes = (published || onto > 0) && state.readerWaits
            if wakes {
                state.readerWaits = false
            }
            // Full, it waits until what is left is less than that.
            let full = state.buffered >= pauseWriterThreshold
            return (wakes, state.flushUnder(full ? resumeWriterThreshold : Int.max))
        }
        if wakes {
            readers.wakeAll()
        }
        if let result = ended {
            return result
        }
        while true {
            let ticket = writers.ticket
            if let result = state.withLock({ $0.flushUnder(resumeWriterThreshold) }) {
                return result
            }
            await writers.park(since: ticket)
        }
    }

    fn completeWriting() {
        state.withLock { (state: inout PipeState) in
            let _ = state.publish()
            state.writerCompleted = true
            state.readerWaits = false
        }
        readers.wakeAll()
    }

    fn cancelFlush() {
        state.withLock { $0.flushCanceled = true }
        writers.wakeAll()
    }

    fn rentBuffer(_ minimumCapacity: Int) -> U8[>..] {
        let least = minimumCapacity < segmentSize ? segmentSize : minimumCapacity
        return state.withLock { $0.pool.rent(minimumCapacity: least) }
    }

    // ---- Reading -----------------------------------------------------------

    fn readBuffered() async -> ReadResult {
        while true {
            let ticket = readers.ticket
            if let result = tryReadBuffered() {
                return result
            }
            await readers.park(since: ticket)
        }
    }

    fn tryReadBuffered() -> ReadResult? {
        return state.withLock { $0.read() }
    }

    fn advanceReader(consumed: Int, examined: Int) {
        let wakes = state.withLock { (state: inout PipeState) -> Bool in
            state.advance(consumed, examined)
            let wakes = state.writerWaits && state.buffered <= resumeWriterThreshold
            if wakes {
                state.writerWaits = false
            }
            return wakes
        }
        if wakes {
            writers.wakeAll()
        }
    }

    fn completeReading() {
        state.withLock { $0.completeReading() }
        writers.wakeAll()
    }

    fn cancelRead() {
        state.withLock { $0.readCanceled = true }
        readers.wakeAll()
    }
}

// How many segments a pipe keeps to fill again: more than the bytes a writer
// may be ahead by take, of writes that fill a good part of one each.
const segmentsKept = 64

// What a pipe holds.
struct PipeState {
    let segmentSize: Int
    let pool: BufferPool
    // Flushed, for the reader: segments[first...], the first read from
    // 'head' on, 'buffered' bytes in all.
    var segments: U8[>..][>..]
    var first: Int
    var head: Int
    var buffered: Int
    // How many segments there were when the reader was last given them: it
    // holds those until it advances, and the ones after are the writer's to
    // go on filling.
    var held: Int
    // How many of the buffered bytes the reader has looked at: a read waits
    // for more than these.
    var examined: Int
    // Written and not yet flushed: whole segments, and the one being filled.
    var unflushed: U8[>..][>..]
    var tail: U8[>..]
    var writerCompleted: Bool
    var readerCompleted: Bool
    var readCanceled: Bool
    var flushCanceled: Bool
    // A task has looked, since the list it parks in was last woken, and
    // found it must wait: an end wakes the other only if one has.
    var readerWaits: Bool
    var writerWaits: Bool

    init(_ segmentSize: Int) {
        self.segmentSize = segmentSize
        pool = BufferPool(maximumPerSize: segmentsKept)
        segments = []
        first = 0
        head = 0
        buffered = 0
        held = 0
        examined = 0
        unflushed = []
        tail = []
        writerCompleted = false
        readerCompleted = false
        readCanceled = false
        flushCanceled = false
        readerWaits = false
        writerWaits = false
    }

    // What a flush gives once no more than this is buffered, or it need not
    // wait for that; none while it must.
    mutating fn flushUnder(_ most: Int) -> FlushResult? {
        if buffered > most && !readerCompleted && !flushCanceled {
            writerWaits = true
            return none
        }
        let canceled = flushCanceled
        flushCanceled = false
        return FlushResult { isCompleted: readerCompleted, isCanceled: canceled }
    }

    // As many of the bytes as the last segment flushed has room for, if the
    // reader does not hold it: flushed with it. How many.
    mutating fn copyOn(_ bytes: U8[:]) -> Int {
        let last = segments.count - 1
        if last < first || last < held || readerCompleted || !tail.isEmpty || !unflushed.isEmpty {
            return 0
        }
        let room = segments[last].capacity - segments[last].count
        let take = bytes.count < room ? bytes.count : room
        if take > 0 {
            segments[last].append(contentsOf: bytes[0..<take])
            buffered += take
        }
        return take
    }

    mutating fn copyIn(_ bytes: U8[:]) {
        var from = 0
        while from < bytes.count {
            if tail.capacity - tail.count == 0 {
                if !tail.isEmpty {
                    unflushed.append(tail)
                }
                tail = pool.rent(minimumCapacity: segmentSize)
            }
            let room = tail.capacity - tail.count
            let take = bytes.count - from < room ? bytes.count - from : room
            tail.append(contentsOf: bytes[from..<(from + take)])
            from += take
        }
    }

    mutating fn takeIn(_ segment: U8[>..]) {
        if !segment.isEmpty {
            if !tail.isEmpty {
                unflushed.append(tail)
                tail = []
            }
            unflushed.append(segment)
        }
    }

    // What was written, made the reader's: whether anything was.
    mutating fn publish() -> Bool {
        if !tail.isEmpty {
            unflushed.append(tail)
            tail = []
        }
        if readerCompleted {
            unflushed = []
            return false
        }
        for segment in unflushed {
            buffered += segment.count
            segments.append(segment)
        }
        let added = !unflushed.isEmpty
        unflushed = []
        return added
    }

    fn current() -> ByteSequence {
        var live: U8[>..][>..] = []
        var i = first
        while i < segments.count {
            live.append(segments[i])
            i += 1
        }
        return ByteSequence(segments: live, start: head, count: buffered)
    }

    // The result of a read, or none while it must wait.
    mutating fn read() -> ReadResult? {
        precondition(!readerCompleted, "a pipe read after its reader completed")
        if buffered <= examined && !writerCompleted && !readCanceled {
            readerWaits = true
            return none
        }
        let canceled = readCanceled
        readCanceled = false
        held = segments.count
        return ReadResult { buffer: current(), isCompleted: writerCompleted, isCanceled: canceled }
    }

    mutating fn advance(_ consumed: Int, _ seen: Int) {
        precondition(consumed >= 0 && consumed <= seen && seen <= buffered, "a pipe advanced by \(consumed) consumed and \(seen) examined of \(buffered)")
        held = 0
        var left = consumed
        while left > 0 {
            let inFirst = segments[first].count - head
            if left < inFirst {
                head += left
                left = 0
            } else {
                left -= inFirst
                let done = segments[first]
                segments[first] = []
                pool.giveBack(move done)
                first += 1
                head = 0
            }
        }
        // Emptied, or mostly dropped: start again, so the list does not grow.
        if first == segments.count {
            segments = []
            first = 0
        } else if first > 32 && first * 2 > segments.count {
            var kept: U8[>..][>..] = []
            var i = first
            while i < segments.count {
                kept.append(segments[i])
                i += 1
            }
            segments = kept
            first = 0
        }
        buffered -= consumed
        examined = seen - consumed
    }

    mutating fn completeReading() {
        readerCompleted = true
        segments = []
        first = 0
        head = 0
        buffered = 0
        held = 0
        examined = 0
    }
}
