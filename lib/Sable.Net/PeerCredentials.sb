module Sable.Net

/// Who is at the other end of a local connection, as the system says: the
/// process, and its user, when it connected. Either is none where the
/// system does not say (a user's identifier on Windows).
///
/// ```sable
/// fn isMine(_ connection: UnixStream) throws -> Bool {
///     let peer = try connection.peerCredentials()
///     return peer.userId == PeerCredentials.currentUserId
/// }
/// ```
public struct PeerCredentials {
    /// The process's identifier.
    public let processId: Int?

    /// Its user's identifier (POSIX's uid).
    public let userId: Int?

    public init(processId: Int?, userId: Int?) {
        self.processId = processId
        self.userId = userId
    }

    /// This process's user's identifier; none on Windows.
    public static var currentUserId: Int? {
        get {
            #if os(windows)
            return none
            #else
            return Int(currentUser())
            #endif
        }
    }
}

#if !os(windows)
@extern("c", "getuid")
fn currentUser() -> U32
#endif
