module FixedWidthIntegerRandomTests

// Random integers in a range (FixedWidthInteger+Random.sb, Sable.Core).

import Sable.Testing
import RandomStatistics

@test
fn aHalfOpenRangeLeavesOutItsUpperBound() {
    var generator = SeededRandomNumberGenerator(seed: 10)
    var seen: Bool[>..] = [false, false, false]
    var i = 0
    while i < 300 {
        let n = Int.random(in: 4..<7, using: &generator)
        assert(n >= 4 && n < 7)
        seen[n - 4] = true
        i += 1
    }
    assert(seen.allSatisfy({ $0 }))
}

@test
fn aClosedRangeTakesBothEnds() {
    var generator = SeededRandomNumberGenerator(seed: 11)
    var low = false
    var high = false
    var i = 0
    while i < 300 {
        let n = I8.random(in: -2...2, using: &generator)
        assert(n >= -2 && n <= 2)
        low = low || n == -2
        high = high || n == 2
        i += 1
    }
    assert(low && high)
}

@test
fn aRangeWiderThanTheTypesPositivesWorks() {
    var generator = SeededRandomNumberGenerator(seed: 12)
    var negative = false
    var positive = false
    var i = 0
    while i < 200 {
        let n = I8.random(in: I8.min..<I8.max, using: &generator)
        negative = negative || n < 0
        positive = positive || n > 0
        i += 1
    }
    assert(negative && positive)
}

@test
fn theWholeOfATypeIsARange() {
    var generator = SeededRandomNumberGenerator(seed: 13)
    var everSet: U8 = 0
    var i = 0
    while i < 100 {
        everSet = everSet | U8.random(in: U8.min...U8.max, using: &generator)
        _ = I64.random(in: I64.min...I64.max, using: &generator)
        _ = U128.random(in: U128.min...U128.max, using: &generator)
        i += 1
    }
    assert(everSet == 255)
}

@test
fn a128BitRangeStaysInIt() {
    var generator = SeededRandomNumberGenerator(seed: 14)
    let low: U128 = 100000000000000000000000
    let high: U128 = 100000000000000000000010
    var i = 0
    while i < 50 {
        let n = U128.random(in: low...high, using: &generator)
        assert(n >= low && n <= high)
        let m = I128.random(in: -5..<5, using: &generator)
        assert(m >= -5 && m < 5)
        i += 1
    }
}

@test
fn aOneValueRangeGivesThatValue() {
    assertEqual(Int.random(in: 9...9), 9)
    assertEqual(Int.random(in: 9..<10), 9)
}

@test
fn theSystemsGeneratorIsTheDefault() {
    let n = U16.random(in: 1000..<2000)
    assert(n >= 1000 && n < 2000)
    let m = Int.random(in: -3...3)
    assert(m >= -3 && m <= 3)
}

@test(traps: "a random value of an empty range")
fn anEmptyHalfOpenRangeTraps() {
    _ = Int.random(in: 3..<3)
}

@test(traps: "a random value of an empty range")
fn anUpsideDownClosedRangeTraps() {
    var generator = SeededRandomNumberGenerator(seed: 1)
    _ = Int.random(in: ClosedRange(lowerBound: 3, upperBound: 2), using: &generator)
}

// Every value of the range as often as every other.
fn assertRangeEven<T: FixedWidthInteger>(_ range: ClosedRange<T>, _ count: Int, seed: U64) {
    var generator = SeededRandomNumberGenerator(seed: seed)
    var counts = zeroCounts(count)
    for _ in 0..<(500 * count) {
        let n = T.random(in: range, using: &generator)
        counts[Int.fromWideBitPattern(n.wideBitPattern.wrappingSub(range.lowerBound.wideBitPattern))] += 1
    }
    assertEven(counts)
}

@test
fn rangesAreEvenWhateverTheirSigns() {
    assertRangeEven(I8.min...I8.max, 256, seed: 40)
    assertRangeEven(U8.min...U8.max, 256, seed: 41)
    assertRangeEven(I8.min...(I8.max - 1), 255, seed: 42)
    assertRangeEven((-100 as I8)...100, 201, seed: 43)
    assertRangeEven(I64.min...(I64.min + 6), 7, seed: 44)
    assertRangeEven((I64.max - 6)...I64.max, 7, seed: 45)
    assertRangeEven((U64.max - 6)...U64.max, 7, seed: 46)
    assertRangeEven((-3 as I128)...3, 7, seed: 47)
    assertRangeEven((U128.max - 6)...U128.max, 7, seed: 48)
}

// The top bits of a range as wide as its type, or one value short of it.
@test
fn rangesAsWideAsTheirTypeAreEven() {
    var generator = SeededRandomNumberGenerator(seed: 50)
    var whole = zeroCounts(64)
    var short = zeroCounts(64)
    var wide = zeroCounts(64)
    var wideShort = zeroCounts(64)
    for _ in 0..<20000 {
        whole[Int((I64.random(in: I64.min...I64.max, using: &generator) >> 58) + 32)] += 1
        short[Int((I64.random(in: I64.min..<I64.max, using: &generator) >> 58) + 32)] += 1
        wide[Int.fromWideBitPattern(U128.random(in: U128.min...U128.max, using: &generator) >> 122)] += 1
        wideShort[Int((I128.random(in: I128.min..<I128.max, using: &generator) >> 122) + 32)] += 1
    }
    assertEven(whole)
    assertEven(short)
    assertEven(wide)
    assertEven(wideShort)
}

@test
fn aRangeOfA64BitTypeTakesOneDraw() {
    var generator = Pcg64(seed: 1)
    var ahead = generator
    ahead.advance(by: 2)
    _ = I64.random(in: I64.min...I64.max, using: &generator)
    _ = U64.random(in: 0...9, using: &generator)
    assertEqual(generator.next(), ahead.next())
}
