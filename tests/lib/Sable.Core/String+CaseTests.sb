module StringCaseTests

// String's case mappings and comparisons (Sable.Core), tested with '@test':
// run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

@test
fn uppercasedUsesTheFullMappings() {
    assertEqual("Straße".uppercased(), "STRASSE")
    assertEqual("ǆemal".uppercased(), "ǄEMAL")
    assertEqual("hello, wörld".uppercased(), "HELLO, WÖRLD")
    assertEqual("ﬁx".uppercased(), "FIX")
    assertEqual("".uppercased(), "")
}

@test
fn lowercasedUsesTheFullMappings() {
    assertEqual("HELLO, WÖRLD".lowercased(), "hello, wörld")
    assertEqual("İ".lowercased(), "i\u{307}")
    assertEqual("ÀB".lowercased(), "àb")
}

@test
fn textWithNothingToChangeIsGivenBack() {
    assertEqual("ALREADY 1".uppercased(), "ALREADY 1")
    assertEqual("already 1".lowercased(), "already 1")
    assertEqual("中文".uppercased(), "中文")
}

@test
fn aFinalSigmaIsLowercasedToTheFinalForm() {
    assertEqual("ΟΔΟΣ".lowercased(), "οδος")
    assertEqual("ΟΔΟΣ ΟΔΟΣ".lowercased(), "οδος οδος")
    assertEqual("ΣΑΣ".lowercased(), "σας")
    assertEqual("Σ".lowercased(), "σ")
    assertEqual("ΑΣ'".lowercased(), "ας'")
    assertEqual("ΑΣ'Α".lowercased(), "ασ'α")
    assertEqual("'Σ".lowercased(), "'σ")
    assertEqual("1Σ".lowercased(), "1σ")
}

@test
fn asciiCaseChangesOnlyAsciiLetters() {
    assertEqual("Héllo".asciiUppercased(), "HéLLO")
    assertEqual("HÉLLO".asciiLowercased(), "hÉllo")
    assertEqual("123".asciiUppercased(), "123")
}

@test
fn caseFoldingMakesCaseVariantsTheSame() {
    assertEqual("HeLLo Σ".caseFolded(), "hello σ")
    assertEqual("already".caseFolded(), "already")
}

@test
fn equalityIgnoringCase() {
    expect("Hello".equals("hELLO", ignoringCase: true), "ASCII")
    expect("ΟΔΟΣ".equals("οδος", ignoringCase: true), "Greek, with a final sigma")
    expect("\u{212A}elvin".equals("kelvin", ignoringCase: true), "the Kelvin sign")
    expect(!"Hello".equals("hELLO", ignoringCase: false), "with case")
    expect("Hello".equals("Hello", ignoringCase: false), "the same")
    expect(!"Hello".equals("Hell", ignoringCase: true), "a prefix is not equal")
}

@test
fn comparingWithNoOptionsIsByScalar() {
    expect("abc".compare("abd", options: []) == .Less, "c before d")
    expect("b".compare("abc", options: []) == .Greater, "b after a")
    assertEqual("same".compare("same", options: []), .Equal)
}

@test
fn comparingIgnoringCase() {
    expect("ABC".compare("abd", options: .IgnoringCase) == .Less, "c before d")
    assertEqual("ABC".compare("abc", options: .IgnoringCase), .Equal)
    expect("abc".compare("AB", options: .IgnoringCase) == .Greater, "longer after")
    expect("ab".compare("ABC", options: .IgnoringCase) == .Less, "shorter before")
}

@test
fn comparingNumerically() {
    expect("file9".compare("file10", options: .Numeric) == .Less, "9 before 10")
    expect("file9".compare("file10", options: []) == .Greater, "but '9' after '1'")
    assertEqual("file007".compare("file7", options: .Numeric), .Equal)
    expect("file10b".compare("file10a", options: .Numeric) == .Greater, "the rest decides")
    expect("v2.10".compare("v2.9", options: .Numeric) == .Greater, "each run of digits")
    expect("12".compare("13", options: .Numeric) == .Less, "equal lengths, digit by digit")
    expect("0".compare("00", options: .Numeric) == .Equal, "zeros are zero")
}

@test
fn comparingNumericallyAndIgnoringCase() {
    expect("FILE9".compare("file10", options: [.Numeric, .IgnoringCase]) == .Less, "both at once")
}
