module Base32Tests

// Base32 (Sable.Text), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Testing
import Sable.Text
import TextSupport

// RFC 4648 §10: what it encodes, as Base32 and as base32hex.
@test(arguments: [
    ("", "", ""), ("f", "MY======", "CO======"), ("fo", "MZXQ====", "CPNG===="), ("foo", "MZXW6===", "CPNMU==="),
    ("foob", "MZXW6YQ=", "CPNMUOG="), ("fooba", "MZXW6YTB", "CPNMUOJ1"), ("foobar", "MZXW6YTBOI======", "CPNMUOJ1E8======"),
])
fn theRfc4648TestVectors(_ text: String, _ standard: String, _ hex: String) throws(DecodeError) {
    let bytes = text.utf8Bytes()
    expect(Base32.encode(bytes) == standard)
    expect(Base32.encode(bytes, alphabet: .Hex) == hex)
    expect(try Base32.decode(standard) == bytes)
    expect(try Base32.decode(hex, alphabet: .Hex) == bytes)
}

@test
fn anyBytesRoundTrip() {
    forAll { (bytes: U8[>..], padding: Bool) in
        let text = Base32.encode(bytes, padding: padding)
        expect(text.utf8Count == Base32.encodedLength(bytes.count, padding: padding))
        expect(try Base32.decode(text, padding: padding ? .Required : .Forbidden) == bytes)
    }
}

@test
fn lettersDecodeInEitherCase() {
    assertBytes(try! Base32.decode("mzxw6ytboi"), "foobar".utf8Bytes())
    assertBytes(try! Base32.decode("MzXw6YtBoI======"), "foobar".utf8Bytes())
    assertBytes(try! Base32.decode("cpnmuoj1e8", alphabet: .Hex), "foobar".utf8Bytes())
}

@test
fn aTotpSecretDecodes() {
    // RFC 6238's SHA-1 test key, "12345678901234567890", as authenticator
    // apps are given it.
    assertBytes(try! Base32.decode("GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ"), "12345678901234567890".utf8Bytes())
}

@test(arguments: [.Standard, .Hex])
fn everyLengthRoundTripsUnderEveryAlphabetAndPadding(_ alphabet: Base32.Alphabet) {
    var count = 0
    while count <= 50 {
        let bytes = sample(count)
        let padded = Base32.encode(bytes, alphabet: alphabet)
        let bare = Base32.encode(bytes, alphabet: alphabet, padding: false)
        assertEqual(padded.utf8Count, Base32.encodedLength(count))
        assertEqual(bare.utf8Count, Base32.encodedLength(count, padding: false))
        assertEqual(padded.utf8Count % 8, 0)
        assert(!bare.contains("="), "no padding when told")
        assertBytes(try! Base32.decode(padded, alphabet: alphabet), bytes)
        assertBytes(try! Base32.decode(bare, alphabet: alphabet), bytes)
        assertBytes(try! Base32.decode(padded, alphabet: alphabet, padding: .Required), bytes)
        assertBytes(try! Base32.decode(bare, alphabet: alphabet, padding: .Forbidden), bytes)
        assertEqual(Base32.decodedLength(bare.utf8Count), count)
        assert(Base32.decodedLength(padded.utf8Count) >= count, "an upper bound for padded text")
        count += 1
    }
}

@test
fn theHexAlphabetSortsAsItsBytesDo() {
    let low: U8[>..] = [0x10, 0xFF]
    let high: U8[>..] = [0x11, 0x00]
    expect(Base32.encode(low, alphabet: .Hex) < Base32.encode(high, alphabet: .Hex), "base32hex keeps the order")
}

@test
fn encodingIntoABufferAppendsTheDigits() {
    var buffer = ByteBuffer()
    Base32.encode("foo".utf8Bytes(), into: &buffer)
    Base32.encode("f".utf8Bytes(), into: &buffer, alphabet: .Hex, padding: false)
    assertBytes(buffer.bytes, "MZXW6===CO".utf8Bytes())
}

@test
fn decodingBytesIsDecodingTheirText() {
    assertBytes(try! Base32.decode(bytes: "MZXW6YQ=".utf8Bytes()), "foob".utf8Bytes())
}

@test(arguments: [
    ("MZXW1YTB", .Standard, .InvalidCharacter(at: 4, byte: 0x31)),
    ("MZXW6YTBO8", .Standard, .InvalidCharacter(at: 9, byte: 0x38)),
    ("CPNMW===", .Hex, .InvalidCharacter(at: 4, byte: 0x57)),
    ("MZX*", .Standard, .InvalidCharacter(at: 3, byte: 0x2A)),
])
fn aCharacterOutsideTheAlphabetIsNamedWithItsOffset(_ text: String, _ alphabet: Base32.Alphabet, _ error: DecodeError) {
    expectThrows(error) { _ = try Base32.decode(text, alphabet: alphabet) }
}

@test(arguments: [("M", .InvalidLength(at: 0)), ("MZX", .InvalidLength(at: 0)), ("MZXW6YTBMZXW6Y", .InvalidLength(at: 8))])
fn aLastGroupNoBytesCanEndWithIsTheWrongLength(_ text: String, _ error: DecodeError) {
    expectThrows(error) { _ = try Base32.decode(text) }
}

@test(arguments: [
    ("MY", .Required, .InvalidPadding(at: 2)),
    ("MY======", .Forbidden, .InvalidPadding(at: 2)),
    ("MY=====", .Either, .InvalidPadding(at: 2)),
    ("MZXW6YTB=", .Either, .InvalidPadding(at: 8)),
    ("MY======MY======", .Either, .InvalidPadding(at: 2)),
    ("MY=======", .Either, .InvalidPadding(at: 2)),
    ("M=======", .Either, .InvalidPadding(at: 1)),
])
fn paddingIsCheckedAgainstTheRule(_ text: String, _ padding: Padding, _ error: DecodeError) {
    expectThrows(error) { _ = try Base32.decode(text, padding: padding) }
}

@test(arguments: [
    ("MZ======", .TrailingBits(at: 1)),
    ("MZXR====", .TrailingBits(at: 3)),
    ("MZXW7===", .TrailingBits(at: 4)),
    ("MZXW6YR=", .TrailingBits(at: 6)),
])
fn bitsTheBytesDoNotUseAreRejected(_ text: String, _ error: DecodeError) {
    expectThrows(error) { _ = try Base32.decode(text) }
}

@test
fn lengthsCountGroupsAndTheirRemainder() {
    assertEqual(Base32.encodedLength(0), 0)
    assertEqual(Base32.encodedLength(1, padding: false), 2)
    assertEqual(Base32.encodedLength(2, padding: false), 4)
    assertEqual(Base32.encodedLength(4, padding: false), 7)
    assertEqual(Base32.encodedLength(6), 16)
    assertEqual(Base32.decodedLength(7), 4)
    assertEqual(Base32.decodedLength(8), 5)
}
