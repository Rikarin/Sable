module Sable.Core

/// Values that describe themselves for debugging, the way source would
/// write them: `Point(x: 1, y: 2)`, `"text"`, `'c'`. What `@derive(Debug)`
/// makes, from the fields' own descriptions.
public protocol Debug {
    fn debugDescription() -> String
}

extension Int: Debug {
    public fn debugDescription() -> String { return "\(self)" }
}
extension I8: Debug {
    public fn debugDescription() -> String { return "\(self)" }
}
extension I16: Debug {
    public fn debugDescription() -> String { return "\(self)" }
}
extension I32: Debug {
    public fn debugDescription() -> String { return "\(self)" }
}
extension I64: Debug {
    public fn debugDescription() -> String { return "\(self)" }
}
extension U8: Debug {
    public fn debugDescription() -> String { return "\(self)" }
}
extension U16: Debug {
    public fn debugDescription() -> String { return "\(self)" }
}
extension U32: Debug {
    public fn debugDescription() -> String { return "\(self)" }
}
extension U64: Debug {
    public fn debugDescription() -> String { return "\(self)" }
}
extension UInt: Debug {
    public fn debugDescription() -> String { return "\(self)" }
}
extension I128: Debug {
    public fn debugDescription() -> String { return "\(self)" }
}
extension U128: Debug {
    public fn debugDescription() -> String { return "\(self)" }
}
extension F16: Debug {
    public fn debugDescription() -> String { return floatDebugText("\(self)") }
}
extension F32: Debug {
    public fn debugDescription() -> String { return floatDebugText("\(self)") }
}
extension F64: Debug {
    public fn debugDescription() -> String { return floatDebugText("\(self)") }
}

/// A float as a literal is written: '4.0', not '4', so it reads as a float.
fn floatDebugText(_ text: String) -> String {
    var i = 0
    while i < text.count {
        let c = text.at(i)
        if c == '.' || c == 'e' || c == 'E' || c == 'n' || c == 'i' {
            return text
        }
        i = i + 1
    }
    return text + ".0"
}
extension Bool: Debug {
    public fn debugDescription() -> String { return self ? "true" : "false" }
}

extension Char: Debug {
    /// In single quotes, as a literal is written.
    public fn debugDescription() -> String { return "'" + String.fromChar(self) + "'" }
}

extension String: Debug {
    /// In double quotes, with a quote, a backslash, a newline or a tab escaped.
    public fn debugDescription() -> String {
        // Runs with nothing to escape are kept whole and the pieces joined
        // once: a '+' per scalar would copy everything so far again.
        var pieces: String[>..] = ["\""]
        var start = 0
        var i = 0
        while i < self.count {
            let c = self.at(i)
            let escape = c == '"' ? "\\\"" : c == '\\' ? "\\\\" : c == '\n' ? "\\n" : c == '\t' ? "\\t" : ""
            if escape.count > 0 {
                pieces.append(self.slice(from: start, to: i))
                pieces.append(escape)
                start = i + 1
            }
            i = i + 1
        }
        pieces.append(self.slice(from: start, to: self.count))
        pieces.append("\"")
        return Runtime.joinStrings(pieces, "")
    }
}
