module Sable.Crypto

import Sable.Text

/// Passwords hashed to be stored, and checked against what was stored: text
/// in the PHC string format, which says the algorithm, its parameters and
/// the salt, so that a hash can be checked after the defaults change.
///
/// ```sable
/// let argon2 = try! Argon2id(memoryKiB: 64, iterations: 1, parallelism: 1)
/// let stored = argon2.hash(password: "correct horse")
/// assert(stored.hasPrefix("$argon2id$v=19$m=64,t=1,p=1$"))
/// assert(try! PasswordHash.verify(password: "correct horse", against: stored))
/// assert(!(try! PasswordHash.verify(password: "wrong", against: stored)))
/// ```
public struct PasswordHash {
    private init() { }

    /// The password hashed by Argon2id with its default parameters, under a
    /// new salt.
    ///
    /// ```sable
    /// let stored = PasswordHash.hash(password: "correct horse")
    /// assert(try! PasswordHash.verify(password: "correct horse", against: stored))
    /// ```
    public static fn hash(password: String) -> String {
        return (try! Argon2id()).hash(password: password)
    }

    /// Whether the password is the one the text is the hash of, by
    /// whichever of Argon2id, scrypt and PBKDF2 the text says, the hashes
    /// compared in constant time. Throws when the text is not a hash of
    /// one of those, and when it asks for more memory, or more work, than
    /// the limits: what is stored may have been tampered with. Memory that
    /// is written more than sixteen times the limit over is too much work,
    /// and PBKDF2, which takes none, has iterations of its own.
    ///
    /// ```sable
    /// do {
    ///     _ = try PasswordHash.verify(password: "x", against: "$argon2id$v=19$m=4000000000,t=9,p=1$c2FsdHNhbHQ$aGFzaGhhc2hoYXNoaGFzaA")
    /// } catch {
    ///     assert("\(error.description())" == "Argon2id with 4000000000 KiB takes more than 1073741824 bytes")
    /// }
    /// ```
    public static fn verify(
        password: String,
        against encoded: String,
        maximumMemory: Int = 1_073_741_824,
        maximumIterations: Int = 10_000_000
    ) throws(CryptoError) -> Bool {
        let parsed = try PhcString.parse(encoded)
        let secret = passwordKey(password)
        let derived = match parsed.algorithm {
            case "argon2id" => try verifyArgon2id(parsed, secret, maximumMemory)
            case "scrypt"   => try verifyScrypt(parsed, secret, maximumMemory)
            case _          => try verifyPbkdf2(parsed, secret, maximumIterations)
        }
        return derived == SymmetricKey(parsed.hash)
    }
}

extension Argon2id {
    /// The password hashed under a new salt of 16 bytes, to 32 bytes, as a
    /// PHC string: what `PasswordHash.verify` checks.
    public fn hash(password: String) -> String {
        return hash(password: password, salt: SecureRandom.bytes(16))
    }

    fn hash(password: String, salt: U8[:]) -> String {
        let key = try! deriveKey(from: passwordKey(password), salt: salt, byteCount: 32)
        return PhcString.encode("argon2id$v=19$m=\(memoryKiB),t=\(iterations),p=\(parallelism)", salt, key)
    }
}

extension Scrypt {
    /// The password hashed under a new salt of 16 bytes, to 32 bytes, as a
    /// PHC string: what `PasswordHash.verify` checks.
    public fn hash(password: String) -> String {
        return hash(password: password, salt: SecureRandom.bytes(16))
    }

    fn hash(password: String, salt: U8[:]) -> String {
        let key = try! deriveKey(from: passwordKey(password), salt: salt, byteCount: 32)
        return PhcString.encode("scrypt$ln=\(cost.trailingZeroCount),r=\(blockSize),p=\(parallelism)", salt, key)
    }
}

extension Pbkdf2 {
    /// The password hashed under a new salt of 16 bytes, to a digest's
    /// bytes, as a PHC string: what `PasswordHash.verify` checks. For
    /// SHA-256 and SHA-512, whose names the format has.
    ///
    /// ```sable
    /// let stored = try! Pbkdf2<Sha256>.hash(password: "correct horse", iterations: 1000)
    /// assert(stored.hasPrefix("$pbkdf2-sha256$i=1000,l=32$"))
    /// assert(try! PasswordHash.verify(password: "correct horse", against: stored))
    /// ```
    public static fn hash(password: String, iterations: Int) throws(CryptoError) -> String {
        let salt = SecureRandom.bytes(16)
        let name = try pbkdf2Name((H.self as Type).name)
        let key = try Pbkdf2<H>.deriveKey(from: passwordKey(password), salt: salt, iterations: iterations, byteCount: H.digestByteCount)
        return PhcString.encode("pbkdf2-\(name)$i=\(iterations),l=\(H.digestByteCount)", salt, key)
    }
}

/// The PHC string format's name for a hash function.
fn pbkdf2Name(_ type: String) throws(CryptoError) -> String {
    return match type {
        case "Sable.Crypto.Sha256" => "sha256"
        case "Sable.Crypto.Sha512" => "sha512"
        case _                     => throw CryptoError.InvalidParameter(reason: "the PHC format has no name for PBKDF2 with \(type)")
    }
}

/// The password's UTF-8 bytes, kept as a secret is.
fn passwordKey(_ password: String) -> SymmetricKey {
    var bytes: U8[>..] = []
    bytes.append(utf8: password)
    let key = SymmetricKey(bytes)
    bytes.zeroSecurely()
    return key
}

fn verifyArgon2id(_ parsed: PhcString, _ secret: SymmetricKey, _ maximumMemory: Int) throws(CryptoError) -> SymmetricKey {
    if parsed.version != 19 {
        throw CryptoError.InvalidEncoding(reason: "only Argon2id's version 19 is known")
    }
    let values = try parsed.parameters(["m", "t", "p"])
    let argon2 = try Argon2id(memoryKiB: values[0], iterations: values[1], parallelism: values[2], maximumMemory: maximumMemory)
    // All the passes together write no more than sixteen times the limit.
    if values[1] > maximumMemory / 64 / values[0] {
        throw CryptoError.LimitExceeded(reason: "Argon2id with \(values[1]) passes over \(values[0]) KiB takes too long")
    }
    return try argon2.deriveKey(from: secret, salt: parsed.salt, byteCount: parsed.hash.count)
}

fn verifyScrypt(_ parsed: PhcString, _ secret: SymmetricKey, _ maximumMemory: Int) throws(CryptoError) -> SymmetricKey {
    try parsed.refuseVersion()
    let values = try parsed.parameters(["ln", "r", "p"])
    if values[0] < 1 || values[0] > 40 {
        throw CryptoError.InvalidEncoding(reason: "a scrypt cost of 2^\(values[0])")
    }
    let scrypt = try Scrypt(cost: 1 << values[0], blockSize: values[1], parallelism: values[2], maximumMemory: maximumMemory)
    // The mixing, as Argon2id's passes; and the blocks that are mixed, each
    // 32 bytes of which PBKDF2 makes with an HMAC.
    if values[2] > maximumMemory / 8 / values[1] / scrypt.cost || values[2] > maximumMemory / 8192 / values[1] {
        throw CryptoError.LimitExceeded(reason: "scrypt with a cost of 2^\(values[0]), \(values[2]) times over, takes too long")
    }
    return try scrypt.deriveKey(from: secret, salt: parsed.salt, byteCount: parsed.hash.count)
}

fn verifyPbkdf2(_ parsed: PhcString, _ secret: SymmetricKey, _ maximumIterations: Int) throws(CryptoError) -> SymmetricKey {
    try parsed.refuseVersion()
    let values = try parsed.parameters(["i", "l"])
    if values[1] != parsed.hash.count {
        throw CryptoError.InvalidEncoding(reason: "a hash of \(parsed.hash.count) bytes, said to have \(values[1])")
    }
    if values[0] > maximumIterations {
        throw CryptoError.LimitExceeded(reason: "PBKDF2 with \(values[0]) iterations takes too long")
    }
    return parsed.algorithm == "pbkdf2-sha256"
        ? try Pbkdf2<Sha256>.deriveKey(from: secret, salt: parsed.salt, iterations: values[0], byteCount: parsed.hash.count)
        : try Pbkdf2<Sha512>.deriveKey(from: secret, salt: parsed.salt, iterations: values[0], byteCount: parsed.hash.count)
}

/// A PHC string's parts:
/// `$algorithm[$v=version]$name=value,...$salt$hash`, the last two in
/// Base64 with no padding.
struct PhcString {
    let algorithm: String
    let version: Int?
    let names: String[>..]
    let values: Int[>..]
    let salt: U8[>..]
    let hash: U8[>..]

    static fn encode(_ head: String, _ salt: U8[:], _ key: SymmetricKey) -> String {
        return "$" + head + "$" + Base64.encode(salt, padding: false) + "$" + Base64.encode(key.bytes(), padding: false)
    }

    /// The parts, each checked: an algorithm that is known, parameters that
    /// are numbers as they would be written, a salt of 8 to 64 bytes and a
    /// hash of 16 to 64 — so that no text, however made, is a hash that
    /// every password has.
    static fn parse(_ text: String) throws(CryptoError) -> PhcString {
        // Far longer than any: not worth reading.
        if text.utf8Count > 512 {
            throw CryptoError.InvalidEncoding(reason: "a password hash of \(text.utf8Count) bytes")
        }
        let parts = text.split('$')
        if parts.count < 5 || parts.count > 6 || parts[0] != "" {
            throw CryptoError.InvalidEncoding(reason: "a password hash has an algorithm, parameters, a salt and a hash, with a '$' before each")
        }
        let algorithm = parts[1]
        if algorithm != "argon2id" && algorithm != "scrypt" && algorithm != "pbkdf2-sha256" && algorithm != "pbkdf2-sha512" {
            throw CryptoError.InvalidEncoding(reason: "no password hash of that algorithm is known")
        }
        var version: Int? = none
        if parts.count == 6 {
            let pair = parts[2].split('=')
            if pair.count != 2 || pair[0] != "v" {
                throw CryptoError.InvalidEncoding(reason: "a password hash's version is not a number")
            }
            version = try PhcString.number(pair[1])
        }
        var names: String[>..] = []
        var values: Int[>..] = []
        for parameter in parts[parts.count - 3].split(',') {
            let pair = parameter.split('=')
            if pair.count != 2 {
                throw CryptoError.InvalidEncoding(reason: "a password hash's parameters are not names and numbers")
            }
            names.append(pair[0])
            values.append(try PhcString.number(pair[1]))
        }
        let salt = try PhcString.decode(parts[parts.count - 2])
        let hash = try PhcString.decode(parts[parts.count - 1])
        if salt.count < 8 || salt.count > 64 || hash.count < 16 || hash.count > 64 {
            throw CryptoError.InvalidEncoding(reason: "a password hash has a salt of 8 to 64 bytes and a hash of 16 to 64, not \(salt.count) and \(hash.count)")
        }
        return PhcString { algorithm: algorithm, version: version, names: names, values: values, salt: salt, hash: hash }
    }

    /// The values of the parameters, which must be those, in that order.
    fn parameters(_ expected: String[:]) throws(CryptoError) -> Int[>..] {
        var same = names.count == expected.count
        var i = 0
        while same && i < names.count {
            same = names[i] == expected[i]
            i += 1
        }
        if !same {
            throw CryptoError.InvalidEncoding(reason: "a password hash of \(algorithm) has the parameters \(expected.joined(separator: ", "))")
        }
        return values
    }

    fn refuseVersion() throws(CryptoError) {
        if version != none {
            throw CryptoError.InvalidEncoding(reason: "a password hash of \(algorithm) has no version")
        }
    }

    /// A number of at most ten digits, with no zero before the others.
    static fn number(_ text: String) throws(CryptoError) -> Int {
        var bytes: U8[>..] = []
        bytes.append(utf8: text)
        var value = 0
        var good = bytes.count >= 1 && bytes.count <= 10 && (bytes.count == 1 || bytes[0] != 0x30)
        for byte in bytes {
            good = good && byte >= 0x30 && byte <= 0x39
            if good {
                value = value * 10 + Int(byte) - 0x30
            }
        }
        if !good {
            throw CryptoError.InvalidEncoding(reason: "a password hash's parameter is not a number")
        }
        return value
    }

    static fn decode(_ text: String) throws(CryptoError) -> U8[>..] {
        do {
            return try Base64.decode(text, padding: .Forbidden)
        } catch {
            throw CryptoError.InvalidEncoding(reason: "a password hash's salt or hash is not Base64")
        }
    }
}
