module TimeUtcOffsetTests

import Sable.Testing
import Sable.Time

@test
fn anOffsetIsAtMostADayAndTwoHours() {
    assertEqual(UtcOffset.of(seconds: 93599)!.toString(), "+25:59:59")
    expect(UtcOffset.of(seconds: 93600) == none)
    expect(UtcOffset.of(seconds: -93600) == none)
    expect(UtcOffset.of(hours: 26) == none)
    expect(UtcOffset.of(hours: 1, minutes: 60) == none)
    expect(UtcOffset.of(hours: 1, seconds: -60) == none)
    assertEqual(UtcOffset.hours(30), UtcOffset.hours(25))
    assertEqual(UtcOffset.hours(-30), UtcOffset.hours(-25))
}

@test
fn anOffsetHasPartsWithItsSign() {
    let offset = UtcOffset.of(hours: -3, minutes: -30, seconds: -15)!
    assertEqual(offset.totalSeconds, -12615)
    assertEqual(offset.hours, -3)
    assertEqual(offset.minutes, -30)
    assertEqual(offset.seconds, -15)
    assertEqual(offset.toString(), "-03:30:15")
    assertEqual(offset.negated().toString(), "+03:30:15")
    assertEqual(offset.duration, Duration.seconds(-12615))
    assertEqual(UtcOffset.utc.toString(), "+00:00")
    expect(offset < UtcOffset.utc)
    assertEqual(offset.hashValue, UtcOffset.of(seconds: -12615)!.hashValue)
    assertEqual(UtcOffset.hours(5).debugDescription(), "+05:00")
}

@test(arguments: [
    ("Z", UtcOffset.utc),
    ("+05:30", UtcOffset.of(hours: 5, minutes: 30)!),
    ("-0400", UtcOffset.hours(-4)),
    ("+01", UtcOffset.hours(1)),
    ("+00:19:32", UtcOffset.of(seconds: 1172)!),
    ("−02:00", UtcOffset.hours(-2)),
])
fn offsetsReadEveryISO8601Form(_ text: String, _ expected: UtcOffset) throws {
    expect(try UtcOffset.parse(text) == expected)
}

@test(arguments: [
    ("", ParseError.Empty),
    ("05:00", ParseError.Invalid(at: 0)),
    ("+26:00", ParseError.Invalid(at: 1)),
    ("+05:60", ParseError.Invalid(at: 1)),
    ("+5", ParseError.InvalidDigit(at: 2)),
    ("+05:00x", ParseError.Invalid(at: 6)),
])
fn anOffsetThatIsNotOneSaysWhere(_ text: String, _ error: ParseError) {
    expectThrows(error) { _ = try UtcOffset.parse(text) }
}
