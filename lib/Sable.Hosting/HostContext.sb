module Sable.Hosting

import Sable.Concurrency
import Sable.Diagnostics
import Sable.Time

/// What a service may be made from: what the builder was set to, and the
/// host's lifetime. Given to the closure that makes it (`HostedServices.add`).
public struct HostContext: Sendable {
    /// Where the program runs.
    public let environment: HostEnvironment
    /// What it is configured by.
    public let configuration: any HostConfiguration
    /// How it logs.
    public let logging: HostLogging
    /// When the host starts and stops, and how to ask it to.
    public let lifetime: ApplicationLifetime
    /// The time it goes by.
    public let clock: any HostClock

    /// Waits this long by the host's clock; throws CancellationError as
    /// soon as the token is cancelled, or the task is.
    public fn sleep(for duration: Duration, cancellation: CancellationToken) async throws(CancellationError) {
        try await sleep(until: clock.now.adding(duration), cancellation: cancellation)
    }

    /// Waits until the host's clock says this time, or the token is cancelled.
    public fn sleep(until time: UtcDateTime, cancellation: CancellationToken) async throws(CancellationError) {
        let clock = self.clock
        do {
            try await withCancellation(cancellation) {
                try await clock.sleep(until: time)
            }
        } catch {
            throw CancellationError()
        }
    }
}
