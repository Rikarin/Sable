module Sable.IO.Ports

/// How a serial port talks: its rate and its frames. 9600 baud, 8 data
/// bits, no parity, one stop bit and no flow control, to begin with.
///
/// ```sable
/// let options = SerialOptions { baudRate: 115200, flowControl: .RtsCts }
/// assert(options.dataBits == 8 && options.parity == .None)
/// ```
public struct SerialOptions {
    /// Bits a second: any the device takes. Linux sets a rate termios has
    /// no name for (250,000, 31,250) by termios2's BOTHER, on the machines
    /// whose termios2 is the kernel's common one (x86, Arm, RISC-V,
    /// LoongArch); macOS by IOSSIOSPEED.
    public var baudRate: Int = 9600

    /// Bits of data in each character: 5 to 8.
    public var dataBits: Int = 8

    /// The bit that checks each character, if any.
    public var parity: Parity = .None

    /// The bits that end each character.
    public var stopBits: StopBits = .One

    /// How either end says to wait.
    public var flowControl: FlowControl = .None

    var parityNumber: Int {
        get {
            return match parity {
                case .None  => 0
                case .Odd   => 1
                case .Even  => 2
                case .Mark  => 3
                case .Space => 4
            }
        }
    }

    var stopNumber: Int {
        get {
            return match stopBits {
                case .One          => 1
                case .Two          => 2
                case .OnePointFive => 3
            }
        }
    }

    var flowNumber: Int {
        get {
            return match flowControl {
                case .None    => 0
                case .RtsCts  => 1
                case .XonXoff => 2
            }
        }
    }
}
