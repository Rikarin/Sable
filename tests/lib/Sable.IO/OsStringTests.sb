module OsStringTests

// OsString and OsStr (Sable.IO), and the paths, arguments and environment
// variables they are of. Run with
//     tools/stdlib-coverage.sh Sable.IO

import Sable.IO
import Sable.Testing

@test
fn textIsItsUtf8() {
    let text = OsString("héllo")
    assertEqual(text.bytes, [0x68, 0xC3, 0xA9, 0x6C, 0x6C, 0x6F])
    assertEqual(text.string, "héllo")
    expect(!text.isEmpty)
    expect(OsString("").isEmpty)
    assertEqual("\(text)", "héllo")
    assertEqual(text.debugDescription(), "\"héllo\"")
}

@test
fn whatIsNotTextIsKept() {
    let odd = OsString(bytes: [0x61, 0xFF, 0x62])
    assertEqual(odd.string, none)
    assertEqual("\(odd)", "a\u{FFFD}b")
    assertEqual(odd.bytes, [0x61, 0xFF, 0x62])
    assertEqual(odd.view.string, none)
    assertEqual("\(odd.view)", "a\u{FFFD}b")
    assertEqual(odd.view.debugDescription(), "\"a\u{FFFD}b\"")
}

@test
fn equalAndOrderedByBytes() {
    assertEqual(OsString("a"), OsString(bytes: [0x61]))
    expect(OsString("a") != OsString("b"))
    expect(OsString("a") < OsString("ab"))
    expect(OsString(bytes: [0xFF]) > OsString("z"))
    expect(OsString("a").view == OsString("a").view)
    var counts: [OsString: Int] = [:]
    counts[OsString("x")] = 1
    counts[OsString(bytes: [0x78])] = 2
    assertEqual(counts.count, 1)
    var views: [OsStr: Int] = [:]
    views[OsString("x").view] = 1
    assertEqual(views[OsStr(bytes: [0x78])], 1)
}

let wideTexts: U16[>..][>..] = [[], [0x41], [0xE9, 0x20AC], [0xD83D, 0xDE00], [0xD800], [0xDC00, 0xD800], [0x61, 0xD83D, 0x62], [0xD83D, 0xD83D, 0xDE00]]

@test(arguments: wideTexts)
fn wideTextComesBackAsItWas(_ units: U16[>..]) {
    expect(OsString(wide: units).wide == units)
}

@test
fn wideTextIsTextsUtf16() {
    assertEqual(OsString(wide: [0xD83D, 0xDE00]).string, "😀")
    assertEqual(OsString("a😀é").wide, [0x61, 0xD83D, 0xDE00, 0xE9])
}

let badBytes: (U8[>..], U16[>..])[>..] = [
    ([0x80], [0xFFFD]),
    ([0xC0], [0xFFFD]),
    ([0xC1], [0xFFFD]),
    ([0xF5], [0xFFFD]),
    ([0xE2], [0xFFFD]),
    ([0xFF], [0xFFFD]),
    ([0xC3, 0x28], [0xFFFD, 0x28]),
    ([0xE0, 0x80, 0x80], [0xFFFD, 0xFFFD, 0xFFFD]),
    ([0xF4, 0x90, 0x80, 0x80], [0xFFFD, 0xFFFD, 0xFFFD, 0xFFFD]),
]

@test(arguments: badBytes)
fn bytesThatAreNotUtf8AreReplacedInWideText(_ bytes: U8[>..], _ wide: U16[>..]) {
    expect(OsString(bytes: bytes).wide == wide)
}

@test
fn aViewIsTakenApart() {
    let whole = OsString(bytes: [0x2D, 0x2D, 0x6F, 0x3D, 0xFF])
    let (name, value) = whole.view.split(once: 0x3D)!
    assertEqual(name.string, "--o")
    assertEqual(value.toOsString().bytes, [0xFF])
    expect(whole.view.hasPrefix("--"))
    expect(!whole.view.hasPrefix("--out"))
    expect(OsString("x").view.split(once: 0x3D) == none)
    expect(OsStr(bytes: []).isEmpty)
}

@test
fn aPathIsTheSystemsText() {
    let path = FilePath(OsString(bytes: [0x61, 0x2F, 0xFF, 0x2E, 0x62]), style: .Posix)
    assertEqual(path.pathExtension, "b")
    assertEqual(path.osString.bytes, [0x61, 0x2F, 0xFF, 0x2E, 0x62])
    assertEqual(OsString("a/b").filePath, FilePath("a/b"))
    expect(!File.exists(OsString("surely-no-such-file")))
}

@test
fn anEnvironmentVariableKeepsItsBytes() {
    #if !os(windows)
    let name = OsString("SABLE_OS_STRING")
    let value = OsString(bytes: [0x78, 0xFF, 0x79])
    unsafe {
        Environment.set(name, value)
    }
    assertEqual(Environment.variable(name), value)
    assertEqual(Environment.variable("SABLE_OS_STRING"), "x\u{FFFD}y")
    assertEqual(Environment.osVariables()[name], value)
    unsafe {
        Environment.remove("SABLE_OS_STRING")
    }
    assertEqual(Environment.variable(name), none)
    #endif
}

@test
fn anEmptyVariableIsThere() {
    unsafe {
        Environment.set(OsString("SABLE_OS_EMPTY"), OsString("a=b"))
    }
    assertEqual(Environment.variable(OsString("SABLE_OS_EMPTY")), OsString("a=b"))
    unsafe {
        Environment.remove("SABLE_OS_EMPTY")
    }
}

@test
fn theArgumentsAreTheSystemsText() {
    let all = Environment.osArguments()
    assertEqual(all.count, Environment.arguments().count)
    var i = 0
    while i < all.count {
        assertEqual("\(all[i])", Environment.arguments()[i])
        i += 1
    }
}
