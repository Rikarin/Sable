module ConcurrentStackTests

// ConcurrentStack (Sable.Concurrency): against an array one operation at a
// time, and under pushers and poppers at once, where nothing is lost and
// nothing is given twice.

import Sable.Concurrency
import Sable.Testing

@test
fn aStackGivesBackTheLastFirst() {
    let stack = ConcurrentStack<Int>()
    expect(stack.isEmpty)
    expect(stack.pop() == none)
    expect(stack.peek() == none)
    stack.push(1)
    stack.push(contentsOf: [2, 3, 4])
    assertEqual(stack.count, 4)
    assertEqual(stack.peek() ?? 0, 4)
    assertEqual(stack.pop() ?? 0, 4)
    let top = stack.pop(upTo: 2)
    assertEqual(top.count, 2)
    assertEqual(top[0], 3)
    assertEqual(top[1], 2)
    assertEqual(stack.pop(upTo: 5).count, 1)
    expect(stack.isEmpty)
    stack.push(9)
    stack.removeAll()
    assertEqual(stack.count, 0)
}

@test
fn pushersAndPoppersAtOnceLoseNothing() async {
    let stack = ConcurrentStack<Int>()
    let popped = Atomic<Int>(0)
    let sums = await withTaskGroup(of: Int.self) { group -> Int in
        var task = 0
        while task < 2 {
            let base = task * 100000
            group.spawn {
                var i = 0
                while i < 20000 {
                    stack.push(base + i)
                    i += 1
                    if i % 1000 == 0 {
                        await yieldNow()
                    }
                }
                return 0
            }
            group.spawn {
                var sum = 0
                while popped.load() < 40000 {
                    if let value = stack.pop() {
                        sum += value
                        popped.add(1)
                    } else {
                        await yieldNow()
                    }
                }
                return sum
            }
            task += 1
        }
        var total = 0
        for await sum in group {
            total += sum
        }
        return total
    }
    // 0..<20000 and 100000..<120000, each once.
    assertEqual(sums, 2 * (19999 * 20000 / 2) + 20000 * 100000)
    expect(stack.isEmpty)
}
