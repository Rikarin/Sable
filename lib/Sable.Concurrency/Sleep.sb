module Sable.Concurrency

import Sable.Time

/// Waits at least this long, letting every other task run meanwhile; a
/// task cancelled before or while it sleeps wakes at once, and throws.
public fn sleep(_ duration: Duration) async throws(CancellationError) {
    try await Task.sleep(nanoseconds: duration.totalNanoseconds)
}

/// Waits at least this long on the clock, letting every other task run
/// meanwhile; a task cancelled before or while it waits goes on at once,
/// and the wait throws.
public fn sleep<C: Clock>(_ duration: Duration, clock: C) async throws(CancellationError) {
    try await clock.sleep(for: duration)
}

/// Lets every task queued run before this one goes on.
public fn yieldNow() async {
    await Task.yield()
}

extension Task {
    /// Waits at least this long, off the run queue: Swift's
    /// `Task.sleep(for:)`. A task cancelled before or while it sleeps wakes
    /// at once, and the sleep throws CancellationError.
    public static fn sleep(for duration: Duration) async throws(CancellationError) {
        try await Task.sleep(nanoseconds: duration.totalNanoseconds)
    }

    /// Waits at least this long on the clock.
    ///
    /// ```sable
    /// try! await Task.sleep(for: Duration.milliseconds(1), clock: SuspendingClock())
    /// ```
    public static fn sleep<C: Clock>(for duration: Duration, clock: C) async throws(CancellationError) {
        try await clock.sleep(for: duration)
    }

    /// Waits until the monotonic clock shows the instant.
    public static fn sleep(until deadline: Instant) async throws(CancellationError) {
        try await MonotonicClock().sleep(until: deadline)
    }

    /// Waits until the clock shows the instant.
    public static fn sleep<C: Clock>(until deadline: C.Instant, clock: C) async throws(CancellationError) {
        try await clock.sleep(until: deadline)
    }
}
