module TimeZoneBench

import Sable.Testing
import Sable.Time

// Time zones: the offset of New York at half a million moments of twenty years.

fn run(_ zone: TimeZone) throws(TimeZoneError) -> String {
    var total = 0
    for i in 0..<500000 {
        let moment = UtcDateTime.fromUnix(946684800 + i * 1261)
        let there = moment.zoned(in: zone)
        total += there.hour
        if there.isDaylightSaving { total += 1 }
    }
    return "\(total)"
}

@bench
fn measure(_ b: Bencher) {
    let zone = try! TimeZone.find("America/New_York")
    b.check(b.iterate { try! run(zone) })
}
