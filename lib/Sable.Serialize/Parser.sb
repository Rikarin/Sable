module Sable.Serialize

// JSON as a JsonValue, made of a JsonReader's tokens: the reader has the
// grammar, the options and the errors, and keeps how deep it all nests
// within bounds.

/// The JSON the bytes hold, UTF-8, read where they are: an array is shared
/// with the parser, not copied — a mapped file's bytes are parsed in place.
/// Ill-formed UTF-8 is an error at its first byte.
///
/// ```sable
/// let bytes: U8[>..] = [0x5B, 0x31, 0x2C, 0x22, 0xC3, 0xA9, 0x22, 0x5D]
/// let value = try! parse(bytes: bytes)
/// assert(render(value) == "[1,\"é\"]")
/// ```
public fn parse(bytes: U8[:]) throws(ParseError) -> JsonValue {
    return try parseWith(bytes: bytes, strict())
}

/// The JSON the bytes hold, as the options allow.
public fn parseWith(bytes: U8[:], _ options: ParseOptions) throws(ParseError) -> JsonValue {
    var reader = JsonReader(bytes, options: options)
    return try documentOf(&reader)
}

/// The JSON the text is.
///
/// ```sable
/// let value = try! parse("{\"a\": [1, 2]}")
/// assert(countOf(field(value, "a")!) == 2)
/// ```
public fn parse(_ text: String) throws(ParseError) -> JsonValue {
    return try parseWith(text, strict())
}

/// The JSON the text is, as the options allow.
public fn parseWith(_ text: String, _ options: ParseOptions) throws(ParseError) -> JsonValue {
    var reader = JsonReader(text, options: options)
    return try documentOf(&reader)
}

// The one value a reader at the start has.
fn documentOf(_ reader: inout JsonReader) throws(ParseError) -> JsonValue {
    let value = try valueOf(&reader, try tokenOf(&reader))
    if try tokenAfter(&reader) {
        throw ParseError.TrailingText(at: reader.position)
    }
    return value
}

// The next token of a value, comments aside: there is one, or an error.
fn tokenOf(_ reader: inout JsonReader) throws(ParseError) -> JsonToken {
    while let token = try reader.next() {
        if token != .Comment {
            return token
        }
    }
    throw reader.unexpected(reader.at, "a value")
}

// Whether there is a token, comments aside.
fn tokenAfter(_ reader: inout JsonReader) throws(ParseError) -> Bool {
    while let token = try reader.next() {
        if token != .Comment {
            return true
        }
    }
    return false
}

// The value whose first token the reader is at.
fn valueOf(_ reader: inout JsonReader, _ token: JsonToken) throws(ParseError) -> JsonValue {
    match token {
        case .String => {
            return JsonValue.Text(value: reader.text())
        }
        case .Number => {
            return JsonValue.Number(value: try reader.float())
        }
        case .BeginObject => {
            var members: Member[>..] = []
            while try tokenOf(&reader) == .Key {
                let key = reader.text()
                members.append(Member { key: key, value: try valueOf(&reader, try tokenOf(&reader)) })
            }
            return JsonValue.Object(members: members)
        }
        case .BeginArray => {
            var items: JsonValue[>..] = []
            while true {
                let next = try tokenOf(&reader)
                if next == .EndArray {
                    return JsonValue.Array(items: items)
                }
                items.append(try valueOf(&reader, next))
            }
        }
        case .True => {
            return JsonValue.Bool(value: true)
        }
        case .False => {
            return JsonValue.Bool(value: false)
        }
        default => {
            return JsonValue.Null
        }
    }
}
