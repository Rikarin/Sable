# The least share of lines and of branches (percent) the standard library's
# own tests must run in each file of lib/, checked by tools/stdlib-coverage.sh.
#
#   <file or glob>  <lines>  <branches>   # why
#
# The last line that names a file wins. '*' is the default every new file
# must meet; an override below it needs a reason, and one marked "raise me"
# is a file that was under the default when the check began: raise it (or
# drop the line) as its tests grow, never lower it.

*  85 70

# Under the default when the check began (raise me): the share each had then.
lib/Sable.Build/BuildScript.sb                     0  70   # raise me: no tests yet
lib/Sable.Build/Condition.sb                       0   0   # raise me: no tests yet
lib/Sable.Build/Dependency.sb                      0  70   # raise me: no tests yet
lib/Sable.Build/Manifest.sb                        0   0   # raise me: no tests yet
lib/Sable.Build/Profile.sb                         0  70   # raise me: no tests yet
lib/Sable.Build/Target.sb                          0  70   # raise me: no tests yet
lib/Sable.Build/TargetSettings.sb                  0  70   # raise me: no tests yet
lib/Sable.Core/Debug.sb                            0   0   # raise me: no tests yet
lib/Sable.Core/Mirror.sb                           0  70   # raise me: no tests yet
lib/Sable.Core/PartialRangeFrom.sb                 0  70   # raise me: no tests yet
lib/Sable.Core/PartialRangeThrough.sb              0  70   # raise me: no tests yet
lib/Sable.Core/PartialRangeUpTo.sb                 0  70   # raise me: no tests yet
lib/Sable.Core/Runtime.sb                          0   0   # raise me: no tests yet
lib/Sable.Core/TypeInfo.sb                         0   0   # raise me: no tests yet
lib/Sable.Diagnostics/Field.sb                     0  70   # raise me: no tests yet
lib/Sable.Diagnostics/Level.sb                     0   0   # raise me: no tests yet
lib/Sable.Diagnostics/Logger.sb                    0   0   # raise me: no tests yet
lib/Sable.Generators/Attribute.sb                  0   0   # raise me: no tests yet
lib/Sable.Generators/Case.sb                       0   0   # raise me: no tests yet
lib/Sable.Generators/Declaration.sb                0   0   # raise me: no tests yet
lib/Sable.Generators/Field.sb                      0   0   # raise me: no tests yet
lib/Sable.Generators/GeneratorRequest.sb           0   0   # raise me: no tests yet
lib/Sable.Generators/Output.sb                     0  70   # raise me: no tests yet
lib/Sable.Generators/Package.sb                    0   0   # raise me: no tests yet
lib/Sable.Generators/Parameter.sb                  0   0   # raise me: no tests yet
lib/Sable.Generators/TypeRef.sb                    0   0   # raise me: no tests yet
lib/Sable.IO/Console.sb                            0   0   # raise me: no tests yet
lib/Sable.Serialize/Difference.sb                  0   0   # raise me: no tests yet
lib/Sable.Serialize/JsonValue.sb                   0   0   # raise me: no tests yet
lib/Sable.Serialize/MergePatch.sb                  0   0   # raise me: no tests yet
lib/Sable.Serialize/ParseOptions.sb                0  70   # raise me: no tests yet
lib/Sable.Serialize/Parser.sb                      0   0   # raise me: no tests yet
lib/Sable.Serialize/Pointer.sb                     0   0   # raise me: no tests yet
lib/Sable.Serialize/PrintOptions.sb                0  70   # raise me: no tests yet
lib/Sable.Serialize/Printing.sb                    0   0   # raise me: no tests yet
lib/Sable.Serialize/Statistics.sb                  0   0   # raise me: no tests yet
lib/Sable.Serialize/TextHelpers.sb                 0   0   # raise me: no tests yet
lib/Sable.Serialize/Transform.sb                   0   0   # raise me: no tests yet
lib/Sable.Testing/Assertions.sb                    0   0   # raise me: no tests yet
lib/Sable.Testing/Bencher.sb                       0   0   # raise me: no tests yet
lib/Sable.Testing/TestCase.sb                     45  40   # raise me

# Under the default for a reason the tests cannot change.
lib/Sable.Crypto/Sha256Blocks.sb                   0   0   # run only where the processor has no SHA-256 of its own; CryptoTests runs it everywhere
lib/Sable.Crypto/Sha512Blocks.sb                   0   0   # run only where the processor has no SHA-512 of its own; CryptoTests runs it everywhere
lib/Sable.Crypto/KeccakPermutation.sb               0   0   # run only where the processor has no Keccak of its own; CryptoTests runs it everywhere
lib/Sable.Math/VectorKernels.sb                    50  40   # run only where the processor has no AVX2; SABLE_PORTABLE and Sable.CodeGen.Tests run it everywhere
lib/Sable.Text/TranscodingKernels.sb              50  50   # run only where the runtime has no kernel; Sable.CodeGen.Tests run it interpreted
lib/Sable.Net/UdpSocket.sb                        85  60   # the system's buffers cannot be made to fill, nor a socket have no address
lib/Sable.Net/UnixStream.sb                       75  30   # only Linux has a full queue to be tried again
lib/Sable.IO/File.sb                              80  70   # a move between file systems needs two of them, as macOS has not
lib/Sable.Time/SuspendingClock.sb                85  50   # sleeping again takes a machine that slept meanwhile
