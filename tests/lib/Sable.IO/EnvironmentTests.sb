module EnvironmentTests

// Environment (Sable.IO): variables read, listed, set and removed; the
// arguments as text and as bytes; the places the program has; and the
// known folders by each system's rules, whichever system runs the test.

import Sable.IO
import Sable.Process
import Sable.Testing

@test
fn variablesAreListedSetAndRemoved() {
    let name = "SABLE_ENVIRONMENT_TEST_VALUE"
    expect(Environment.variable(name) == none)
    unsafe {
        Environment.set(name, "one = two")
    }
    assertEqual(Environment.variable(name) ?? "-", "one = two")
    let all = Environment.variables()
    assertEqual(all[name] ?? "-", "one = two")
    expect(all.count > 1)
    unsafe {
        Environment.set(name, "")
    }
    assertEqual(Environment.variable(name) ?? "-", "")
    unsafe {
        Environment.remove(name)
        Environment.remove(name)
    }
    expect(Environment.variable(name) == none)
    expect(Environment.variables()[name] == none)
}

@test(skip(if: Platform.operatingSystem == .Windows || Platform.operatingSystem == .Wasi, "there is no sh"))
fn aVariableSetIsAChildsToo() throws {
    unsafe {
        Environment.set("SABLE_ENVIRONMENT_TEST_CHILD", "inherited")
    }
    let done = try Process.run("sh", ["-c", "printf %s \"$SABLE_ENVIRONMENT_TEST_CHILD\""])
    assertEqual(done.output, "inherited")
    unsafe {
        Environment.remove("SABLE_ENVIRONMENT_TEST_CHILD")
    }
    let after = try Process.run("sh", ["-c", "printf %s \"${SABLE_ENVIRONMENT_TEST_CHILD-unset}\""])
    assertEqual(after.output, "unset")
}

@test
fn argumentsAsTextAndAsBytes() {
    let text = Environment.arguments()
    let bytes = Environment.osArguments()
    assertEqual(text.count, bytes.count)
    var i = 0
    while i < text.count {
        assertEqual(text[i].utf8Count, bytes[i].bytes.count)
        i += 1
    }
}

@test
fn theProgramsPlaces() {
    let here = Environment.currentDirectory
    expect(here.isAbsolute)
    expect(Environment.changeCurrentDirectory(to: here))
    expect(!Environment.changeCurrentDirectory(to: FilePath("sable-no-such-directory")))
    let home = require(Environment.homeDirectory)
    expect(home.isAbsolute)
    expect(Directory.exists("\(home)"))
    let temporary = Environment.temporaryDirectory
    expect(temporary.isAbsolute)
    expect(Directory.exists("\(temporary)"))
    if let program = Environment.executablePath {
        expect(program.isAbsolute)
    }
    expect(Environment.knownFolder(.Home) == home)
    expect(Environment.knownFolder(.Temporary) == temporary)
    let config = require(Environment.knownFolder(.Config))
    expect(config.isAbsolute && config.starts(with: home) || Environment.variable("XDG_CONFIG_HOME") != none)
}

fn folder(_ kind: KnownFolder, _ system: OperatingSystem, _ variables: Dictionary<String, String>) -> String {
    let home = system == .Windows ? FilePath("C:\\Users\\ana", style: .Windows) : FilePath(system == .MacOS ? "/Users/ana" : "/home/ana", style: .Posix)
    if let path = Environment.knownFolder(kind, on: system, home: home, variables: variables) {
        return "\(path)"
    }
    return "none"
}

// Linux: the XDG base and user directories, and WASI its rules. macOS:
// Apple's Library. Windows: the roaming and local application data, and the
// user's.
let folders: (KnownFolder, OperatingSystem, String)[>..] = [
    (.Home, .Linux, "/home/ana"),
    (.Config, .Linux, "/home/ana/.config"),
    (.Cache, .Linux, "/home/ana/.cache"),
    (.Data, .Linux, "/home/ana/.local/share"),
    (.State, .Linux, "/home/ana/.local/state"),
    (.Documents, .Linux, "/home/ana/Documents"),
    (.Downloads, .Linux, "/home/ana/Downloads"),
    (.Desktop, .Linux, "/home/ana/Desktop"),
    (.Pictures, .Linux, "/home/ana/Pictures"),
    (.Music, .Linux, "/home/ana/Music"),
    (.Videos, .Linux, "/home/ana/Videos"),
    (.Temporary, .Linux, "/tmp"),
    (.Data, .MacOS, "/Users/ana/Library/Application Support"),
    (.State, .MacOS, "/Users/ana/Library/Application Support"),
    (.Cache, .MacOS, "/Users/ana/Library/Caches"),
    (.Documents, .MacOS, "/Users/ana/Documents"),
    (.Downloads, .MacOS, "/Users/ana/Downloads"),
    (.Desktop, .MacOS, "/Users/ana/Desktop"),
    (.Pictures, .MacOS, "/Users/ana/Pictures"),
    (.Music, .MacOS, "/Users/ana/Music"),
    (.Videos, .MacOS, "/Users/ana/Movies"),
    (.Temporary, .MacOS, "/tmp"),
    (.Config, .Windows, "C:\\Users\\ana\\AppData\\Roaming"),
    (.Data, .Windows, "C:\\Users\\ana\\AppData\\Roaming"),
    (.Cache, .Windows, "C:\\Users\\ana\\AppData\\Local"),
    (.State, .Windows, "C:\\Users\\ana\\AppData\\Local"),
    (.Documents, .Windows, "C:\\Users\\ana\\Documents"),
    (.Downloads, .Windows, "C:\\Users\\ana\\Downloads"),
    (.Desktop, .Windows, "C:\\Users\\ana\\Desktop"),
    (.Pictures, .Windows, "C:\\Users\\ana\\Pictures"),
    (.Music, .Windows, "C:\\Users\\ana\\Music"),
    (.Videos, .Windows, "C:\\Users\\ana\\Videos"),
    (.Temporary, .Windows, "C:\\Users\\ana\\AppData\\Local\\Temp"),
    (.Config, .Wasi, "/home/ana/.config"),
]

@test(arguments: folders)
fn knownFoldersFollowEachSystemsRules(_ kind: KnownFolder, _ system: OperatingSystem, _ path: String) {
    expect(folder(kind, system, Dictionary<String, String>()) == path)
}

// A relative one is passed over, and macOS does not ask the XDG variables.
let xdgFolders: (KnownFolder, OperatingSystem, String)[>..] = [
    (.Config, .Linux, "/etc/ana"),
    (.Cache, .Linux, "/home/ana/.cache"),
    (.Downloads, .Linux, "/data/downloads"),
    (.Temporary, .Linux, "/scratch"),
    (.Config, .MacOS, "/Users/ana/Library/Application Support"),
    (.Temporary, .MacOS, "/scratch"),
]

@test(arguments: xdgFolders)
fn variablesSayWhereFoldersAre(_ kind: KnownFolder, _ system: OperatingSystem, _ path: String) {
    let variables: [String: String] = ["XDG_CONFIG_HOME": "/etc/ana", "XDG_CACHE_HOME": "relative/is/ignored", "XDG_DOWNLOAD_DIR": "/data/downloads", "TMPDIR": "/scratch"]
    expect(folder(kind, system, variables) == path)
}

let windowsFolders: (KnownFolder, String)[>..] = [
    (.Config, "D:\\Roaming"),
    (.Cache, "D:\\Local"),
    (.Temporary, "D:\\Temp"),
]

@test(arguments: windowsFolders)
fn windowsVariablesSayWhereFoldersAre(_ kind: KnownFolder, _ path: String) {
    let variables: [String: String] = ["APPDATA": "D:\\Roaming", "LOCALAPPDATA": "D:\\Local", "TEMP": "D:\\Temp"]
    expect(folder(kind, .Windows, variables) == path)
}

@test(traps: "'' is not an environment variable's name")
fn anEmptyNameTraps() {
    unsafe {
        Environment.set("", "x")
    }
}

@test(traps: "'A=B' is not an environment variable's name")
fn aNameWithEqualsTraps() {
    unsafe {
        Environment.remove("A=B")
    }
}
