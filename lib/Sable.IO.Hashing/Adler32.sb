module Sable.IO.Hashing

/// Adler-32, zlib's checksum (RFC 1950): two sums of the bytes modulo 65521,
/// the second of the first's running values. Thirty-two bytes a step, in
/// vectors.
///
/// ```sable
/// assert(Adler32.hash("Wikipedia".utf8Bytes()) == 0x11E60398)
/// var adler = Adler32()
/// adler.update(utf8: "Wiki")
/// adler.update(utf8: "pedia")
/// assert(adler.value == 0x11E60398)
/// assert(adler.hashBytes() == [0x11, 0xE6, 0x03, 0x98])
/// ```
public struct Adler32: NonCryptographicHash {
    var low: U32
    var high: U32

    /// Nothing given yet.
    public init() {
        low = 1
        high = 0
    }

    /// Four bytes.
    public static var hashByteCount: Int => 4

    /// The checksum of every byte given so far.
    public var value: U32 => high << 16 | low

    /// The checksum of the bytes, at once.
    public static fn hash(_ bytes: U8[:]) -> U32 {
        var adler = Adler32()
        adler.update(bytes)
        return adler.value
    }

    public mutating fn update(_ bytes: U8[:]) {
        let before = self
        self = bytes.withPointer { (start: RawPtr<U8>) -> Adler32 in
            var after = before
            unsafe {
                after.update(at: start.address, count: bytes.count)
            }
            return after
        }
    }

    /// The bytes at an address, after those already given: for the library's
    /// codecs, which work in memory of their own.
    package unsafe mutating fn update(at address: Int, count: Int) {
        var a = low
        var b = high
        var at = address
        var left = count
        while left > 0 {
            // As many as cannot overflow: 5552 is the most, a multiple of 16.
            let run = left < 5536 ? left : 5536
            left = left &- run
            let whole = run & ~31
            if whole > 0 {
                let (sum, weighted) = adlerBlocks(at, whole)
                b = b &+ (whole unchecked as U32) &* a &+ weighted
                a = a &+ sum
                at = at &+ whole
            }
            var rest = run &- whole
            if rest >= 16 {
                let (sum, weighted) = adlerSixteen(at)
                b = b &+ 16 &* a &+ weighted
                a = a &+ sum
                at = at &+ 16
                rest = rest &- 16
            }
            while rest > 0 {
                a = a &+ (load8(at) unchecked as U32)
                b = b &+ a
                at = at &+ 1
                rest = rest &- 1
            }
            a = a % 65521
            b = b % 65521
        }
        low = a
        high = b
    }

    public mutating fn reset() {
        low = 1
        high = 0
    }

    /// The checksum as four bytes, the most significant first, as zlib
    /// stores it.
    public fn hashBytes() -> U8[>..] => value.bigEndianBytes()
}

/// Of the bytes at an address, a multiple of 32 and at most 5536 of them: the
/// sum of the bytes, and the sum of each times how many bytes from it to the
/// end, itself counted. Each lane of a vector is a column, the bytes at one
/// place in each step of 32: their sum, and the sum of that sum after each
/// step. A byte of step k (of n) at place j is counted 32 (n - k) - j times,
/// which is 32 times its column's sums, less j times its column. The sums are
/// kept in sixteen bits a lane for 22 steps at a time, the most that cannot
/// overflow, and added to thirty-two bits between: a step is two loads, four
/// widening additions and four additions.
@inline(always)
unsafe fn adlerBlocks(_ address: Int, _ count: Int) -> (U32, U32) {
    var columns = SIMD<U32, 32>()
    var sums = SIMD<U32, 32>()
    var at = address
    var steps = count >> 5
    while steps > 0 {
        let run = steps < 22 ? steps : 22
        steps = steps &- run
        var runColumns = SIMD<U16, 32>()
        var runSums = SIMD<U16, 32>()
        let end = at &+ (run << 5)
        while at < end {
            runColumns = runColumns &+ SIMD<U16, 32>.converting(RawPtr<U8>(address: at).load(as: SIMD<U8, 32>.self))
            runSums = runSums &+ runColumns
            at = at &+ 32
        }
        // The sums after each of the run's steps have the columns before it in
        // them as many times.
        sums = sums &+ columns &* SIMD<U32, 32>(repeating: run unchecked as U32) &+ SIMD<U32, 32>.converting(runSums)
        columns = columns &+ SIMD<U32, 32>.converting(runColumns)
    }
    let places = SIMD<U32, 32>.sequence(start: 0, step: 1)
    return (columns.reduceAdd(), sums.reduceAdd() &* 32 &- (columns &* places).reduceAdd())
}

/// Of the sixteen bytes at an address, the same: neither sum is more than
/// sixteen bits.
@inline(always)
unsafe fn adlerSixteen(_ address: Int) -> (U32, U32) {
    let bytes = SIMD<U16, 16>.converting(RawPtr<U8>(address: address).load(as: SIMD<U8, 16>.self))
    let places = SIMD<U16, 16>(repeating: 16) &- SIMD<U16, 16>.sequence(start: 0, step: 1)
    return (bytes.reduceAdd() unchecked as U32, (bytes &* places).reduceAdd() unchecked as U32)
}
