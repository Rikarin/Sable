extension U8 {
    /// The number in decimal.
    @builtin("string_from_U8")
    public fn toString() -> String

    /// The number itself: an unsigned one is never below zero.
    public fn abs() -> U8 { return self }

    /// The smaller of the two.
    @builtin("min_U8")
    public fn min(other: U8) -> U8

    /// The larger of the two.
    @builtin("max_U8")
    public fn max(other: U8) -> U8
}

