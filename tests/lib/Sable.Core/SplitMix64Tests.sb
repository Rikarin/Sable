module SplitMix64Tests

// SplitMix64 (Sable.Core), pinned to the published outputs of Vigna's
// splitmix64.c.

import Sable.Testing

@test
fn aSeedGivesTheReferenceSequence() {
    var generator = SplitMix64(seed: 1234567)
    let expected: U64[>..] = [6457827717110365317, 3203168211198807973, 9817491932198370423, 4593380528125082431, 16408922859458223821]
    for value in expected {
        assertEqual(generator.next(), value)
    }
}

@test
fn zeroIsASeedAsGoodAsAnother() {
    var generator = SplitMix64(seed: 0)
    let expected: U64[>..] = [16294208416658607535, 7960286522194355700, 487617019471545679]
    for value in expected {
        assertEqual(generator.next(), value)
    }
}
