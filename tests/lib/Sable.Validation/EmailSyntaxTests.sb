module ValidationTests

import Sable.Testing
import Sable.Validation

@test(arguments: [
    ("a@b", true), ("firstname lastname@x", true), ("\"a b\"@c", true), ("test@domain com", true), ("", false),
    ("@", false), ("a@", false), ("@b", false), ("a@b@c", false), ("a@b\n", false), ("ab", false),
])
fn aSimpleAddressHasOneAtInsideIt(_ text: String, _ isOne: Bool) {
    expect(EmailSyntax.Simple.accepts(text) == isOne)
}

@test(arguments: [
    ("ada@example.org", true), ("a.b+c@x-y.example", true), ("!#$%&'*+/=?^_`{|}~-@a", true), ("..@a", true),
    ("a@1.2", true), ("a@localhost", true), ("a@" + "b".repeated(63), true), ("", false), ("a", false), ("@a", false),
    ("a@", false), ("a@-b", false), ("a@b-", false), ("a@b..c", false), ("a@.b", false), ("a@b.", false),
    ("a b@c", false), ("\"a\"@b", false), ("a@b_c", false), ("a@b@c", false), ("é@a", false), ("a@é", false),
    ("a@[1.2.3.4]", false), ("a@" + "b".repeated(64), false),
])
fn anHtmlAddressIsWhatTheStandardsPatternTakes(_ text: String, _ isOne: Bool) {
    expect(EmailSyntax.Html.accepts(text) == isOne)
}

@test(arguments: [
    ("ada@example.org", true), ("user+mailbox/department=shipping@example.com", true),
    ("\"Joe.\\\\Blow\"@example.com", true), ("\"ada lovelace\"@example.org", true), ("\" \"@example.org", true),
    ("\"a@b\"@example.org", true), ("a@[192.0.2.1]", true), ("a@[IPv6:2001:db8::1]", true), ("a@[ipv6:::1]", true),
    ("δοκιμή@παράδειγμα.δοκιμή", true), ("a@münchen.de", true), ("a@xn--mnchen-3ya.de", true),
    ("l".repeated(64) + "@x.org", true), ("", false), ("a", false), ("@b", false), ("a@", false), (".a@b", false),
    ("a.@b", false), ("a..b@c", false), ("a b@c", false), ("\"a@b", false), ("\"a\"b@c", false), ("\"a\\", false),
    ("\"\u{7}\"@b", false), ("a@[192.0.2.300]", false), ("a@[2001:db8::1]", false), ("a@[IPv6:192.0.2.1]", false),
    ("a@[1.2.3.4", false), ("a@-b.org", false), ("a@b_c.org", false), ("l".repeated(65) + "@x.org", false),
    ("a@" + "b".repeated(64) + ".org", false), ("a@" + "abcdefghi.".repeated(26) + "org", false),
])
fn aMailboxIsRfc5321s(_ text: String, _ isOne: Bool) {
    expect(EmailSyntax.Smtp.accepts(text) == isOne)
}

@test
fn theRuleTakesAnySyntax() {
    expect(!passes("a b@c") { $0.email() })
    expect(passes("a b@c") { $0.email(.Simple) })
    expect(passes("a@[192.0.2.1]") { $0.email(.Smtp) })
    assertEqual(message("x") { $0.email() }, "'It' is not a valid email address.")
}
