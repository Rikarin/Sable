module FormatIntBench

// Integers as text: two million of them, small and large.

@main
fn main() {
    var x = 12345
    var characters = 0
    for i in 0..<1000000 {
        x = (x * 1103515245 + 12345) % 2147483648
        characters += (x * x).toString().count + i.toString().count
    }
    print(characters)
}
