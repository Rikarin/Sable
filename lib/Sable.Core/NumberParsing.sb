module Sable.Core

// What the numbers' Parsable conformances share (Int+Parsing.sb and the
// rest): reading an integer's sign and magnitude in a radix, and checking a
// float's text before the runtime rounds it. Each reads a Substring — a
// String's whole, or a piece of a larger text — at byte offsets of its
// string, where its bytes lie, and neither allocates for text that is only
// a number: a float's text is copied only to take separators out of it.
// What an error says is where, in scalars from the text's start.

/// Where the number's own text starts and ends, as byte offsets in the
/// text's string, inside the white space the styles allow around it; Empty
/// when there is nothing else.
fn numberBounds(_ text: Substring, _ styles: NumberStyles) throws(ParseError) -> (Int, Int) {
    var start = text.start
    var end = text.end
    if styles.contains(.LeadingWhite) {
        while start < end && text.base.scalar(at: start).isWhitespace {
            start = text.base.offsetAfter(start)
        }
    }
    if styles.contains(.TrailingWhite) {
        while end > start {
            let previous = text.base.offsetBefore(end)
            if !text.base.scalar(at: previous).isWhitespace {
                break
            }
            end = previous
        }
    }
    if start == end {
        throw .Empty
    }
    return (start, end)
}

/// Where a byte offset of the text's string is, in scalars from the text's
/// start: what an error reports.
fn scalarPosition(_ text: Substring, _ offset: Int) -> Int {
    return Runtime.countScalars(text.base, text.start, offset)
}

/// A scalar's value as a digit, in any radix up to 36 — letters of either
/// case past 9 — or 99 for one that is no digit at all.
fn digitValue(_ c: Char) -> Int {
    let code = c.codePoint
    if code >= 48 && code <= 57 {
        return code - 48
    }
    if code >= 97 && code <= 122 {
        return code - 87
    }
    if code >= 65 && code <= 90 {
        return code - 55
    }
    return 99
}

/// Whether the scalar is a separator the styles allow: '_', or ',' where a
/// whole part's digits are read.
fn isSeparator(_ c: Char, _ styles: NumberStyles, _ thousands: Bool) -> Bool {
    return c == '_' && styles.contains(.Separators) || c == ',' && thousands && styles.contains(.Thousands)
}

/// An integer's sign and distance from zero, as the text writes it in the
/// radix under the styles. Every scalar is checked before a magnitude past
/// U128's greatest is reported, so a stray letter is the error a long
/// number with one in it gets. A radix outside 2 to 36 is no radix: it traps.
fn parseInteger(_ text: Substring, _ radix: Int, _ styles: NumberStyles) throws(ParseError) -> (Bool, U128) {
    if radix < 2 || radix > 36 {
        // The message is made only when it is said: an integer parsed
        // allocates nothing.
        preconditionFailure("a radix must be 2 to 36, not \(radix)")
    }
    let (start, end) = try numberBounds(text, styles)
    let bytes = text.base
    // A byte offset, stepped a byte at a time past the ASCII a number is
    // written in: anything else is refused where it starts.
    var i = start
    var negative = false
    let first = bytes.scalar(at: i)
    if (first == '+' || first == '-') && styles.contains(.Sign) {
        negative = first == '-'
        i = i + 1
    }
    if styles.contains(.Prefix) && i + 1 < end && bytes.scalar(at: i) == '0' {
        let mark = bytes.scalar(at: i + 1)
        if radix == 16 && (mark == 'x' || mark == 'X') || radix == 8 && (mark == 'o' || mark == 'O') || radix == 2 && (mark == 'b' || mark == 'B') {
            i = i + 2
        }
    }
    let base = U128(radix)
    let greatest: U128 = 340282366920938463463374607431768211455
    let cutoff = greatest / base
    var magnitude: U128 = 0
    var overflowed = false
    // A digit is wanted first, and after each separator.
    var wanted = true
    while i < end {
        let c = bytes.scalar(at: i)
        let digit = digitValue(c)
        if digit < radix {
            let value = U128(digit)
            if overflowed || magnitude > cutoff || magnitude * base > greatest - value {
                overflowed = true
            } else {
                magnitude = magnitude * base + value
            }
            wanted = false
        } else if !wanted && i + 1 < end && isSeparator(c, styles, true) {
            wanted = true
        } else {
            throw .InvalidDigit(at: scalarPosition(text, i))
        }
        i = i + 1
    }
    if wanted {
        throw .InvalidDigit(at: scalarPosition(text, i))
    }
    if overflowed {
        throw negative ? ParseError.Underflow : ParseError.Overflow
    }
    return (negative, magnitude)
}

/// A signed integer type's value from a sign and magnitude: at most its
/// greatest, or one past it when negative, which is its least.
fn signedValue(_ negative: Bool, _ magnitude: U128, _ greatest: U128) throws(ParseError) -> I128 {
    if !negative {
        if magnitude > greatest {
            throw .Overflow
        }
        return I128(magnitude)
    }
    if magnitude > greatest + 1 {
        throw .Underflow
    }
    if magnitude == 0 {
        return 0
    }
    // Through one less, which is positive in every width: the least I128
    // has no positive twin.
    return 0 - I128(magnitude - 1) - 1
}

/// An unsigned integer type's value from a sign and magnitude: "-0" is 0,
/// and any other negative number is below its least.
fn unsignedValue(_ negative: Bool, _ magnitude: U128, _ greatest: U128) throws(ParseError) -> U128 {
    if negative && magnitude != 0 {
        throw .Underflow
    }
    if magnitude > greatest {
        throw .Overflow
    }
    return magnitude
}

// ---- Floats -----------------------------------------------------------------

/// A float's text checked against the form a float is written in —
///
///     [sign] (digits [. [digits]] | . digits) [(e | E) [sign] digits]
///
/// or the words inf, infinity and nan, in any case — with the white space
/// and separators the styles allow; and given back as the runtime parses it:
/// the text itself, not copied, when it has nothing to take out, else
/// without them. A word is given back as "inf", "-inf" or "nan".
fn plainFloat(_ text: Substring, _ styles: NumberStyles) throws(ParseError) -> Substring {
    let (start, end) = try numberBounds(text, styles)
    let bytes = text.base
    // Byte offsets, stepped a byte at a time past ASCII, as parseInteger's.
    var i = start
    let first = bytes.scalar(at: i)
    if first == '+' || first == '-' {
        if !styles.contains(.Sign) {
            throw .InvalidDigit(at: scalarPosition(text, i))
        }
        i = i + 1
    }
    if i < end && (bytes.scalar(at: i) == 'i' || bytes.scalar(at: i) == 'I' || bytes.scalar(at: i) == 'n' || bytes.scalar(at: i) == 'N') {
        let word = asciiLowercased(Substring.of(bytes, i, end))
        if word == "inf" || word == "infinity" {
            return Substring(first == '-' ? "-inf" : "inf")
        }
        if word == "nan" {
            return Substring("nan")
        }
        throw .InvalidDigit(at: scalarPosition(text, i))
    }
    var separated = false
    let (whole, afterWhole, wholeSeparated) = try decimalRun(text, i, end, styles, true)
    separated = wholeSeparated
    i = afterWhole
    var fraction = 0
    if i < end && bytes.scalar(at: i) == '.' {
        let (digits, afterFraction, fractionSeparated) = try decimalRun(text, i + 1, end, styles, false)
        fraction = digits
        separated = separated || fractionSeparated
        i = afterFraction
    }
    if whole + fraction == 0 {
        throw .InvalidDigit(at: scalarPosition(text, i))
    }
    if i < end && (bytes.scalar(at: i) == 'e' || bytes.scalar(at: i) == 'E') {
        var j = i + 1
        if j < end && (bytes.scalar(at: j) == '+' || bytes.scalar(at: j) == '-') {
            j = j + 1
        }
        let (digits, afterExponent, exponentSeparated) = try decimalRun(text, j, end, styles, false)
        if digits == 0 {
            throw .InvalidDigit(at: scalarPosition(text, afterExponent))
        }
        separated = separated || exponentSeparated
        i = afterExponent
    }
    if i < end {
        throw .InvalidDigit(at: scalarPosition(text, i))
    }
    if !separated {
        return Substring.of(bytes, start, end)
    }
    // Every scalar from here to the end is ASCII, checked above.
    var pieces: String[>..] = []
    var run = start
    var k = start
    while k < end {
        let c = bytes.scalar(at: k)
        if c == '_' || c == ',' {
            pieces.append(bytes.utf8Slice(run, k))
            run = k + 1
        }
        k = k + 1
    }
    pieces.append(bytes.utf8Slice(run, end))
    return Substring(Runtime.joinStrings(pieces, ""))
}

/// How many decimal digits there are from the byte offset on, a separator
/// the styles allow between two of them; where they end; and whether there
/// was a separator. One anywhere else is refused where it is.
fn decimalRun(_ text: Substring, _ start: Int, _ end: Int, _ styles: NumberStyles, _ thousands: Bool) throws(ParseError) -> (Int, Int, Bool) {
    let bytes = text.base
    var digits = 0
    var separated = false
    var i = start
    while i < end {
        let c = bytes.scalar(at: i)
        let code = c.codePoint
        if code >= 48 && code <= 57 {
            digits = digits + 1
        } else if isSeparator(c, styles, thousands) {
            if i == start || !isDigitByte(bytes.utf8Byte(i - 1)) || i + 1 >= end || !isDigitByte(bytes.utf8Byte(i + 1)) {
                throw .InvalidDigit(at: scalarPosition(text, i))
            }
            separated = true
        } else {
            break
        }
        i = i + 1
    }
    return (digits, i, separated)
}

/// Whether a byte is an ASCII decimal digit; no byte of another scalar is.
fn isDigitByte(_ byte: U8) -> Bool {
    return byte >= 48 && byte <= 57
}

/// ASCII letters in lower case: 'NaN' as 'nan'.
fn asciiLowercased(_ text: Substring) -> String {
    var pieces: String[>..] = []
    for c in text {
        let code = c.codePoint
        pieces.append(code >= 65 && code <= 90 ? String.fromChar(Char.fromCodePoint(code + 32)!) : String.fromChar(c))
    }
    return Runtime.joinStrings(pieces, "")
}

/// The float a word plainFloat gave stands for, or none for a number.
fn specialFloat(_ plain: Substring) -> F64? {
    if plain == "inf" {
        return infinity()
    }
    if plain == "-inf" {
        return 0.0 - infinity()
    }
    if plain == "nan" {
        let inf = infinity()
        return inf - inf
    }
    return none
}

/// What a number too large for the type rounds to: infinity, of its sign.
fn overflowedFloat(_ plain: Substring) -> F64 {
    return plain.first == '-' ? 0.0 - infinity() : infinity()
}

/// Positive infinity: the greatest F64 times ten, which rounds to it.
fn infinity() -> F64 {
    let greatest = 1.7976931348623157e308
    return greatest * 10.0
}

/// The decimal a plain float's text writes, as NumberFormatting.sb's digits
/// and point; its sign aside. The text is ASCII, so its bytes are its
/// scalars.
fn decimalOf(_ plain: Substring) -> (String, Int) {
    let bytes = plain.base
    let first = bytes.scalar(at: plain.start)
    let start = first == '+' || first == '-' ? plain.start + 1 : plain.start
    var mantissaEnd = plain.end
    var exponent = 0
    var i = start
    while i < plain.end {
        let c = bytes.scalar(at: i)
        if c == 'e' || c == 'E' {
            mantissaEnd = i
            exponent = Substring.of(bytes, i + 1, plain.end).toInt() ?? 0
            break
        }
        i = i + 1
    }
    return shortestDecimal(bytes.utf8Slice(start, mantissaEnd) + "e" + "\(exponent)")
}

/// Which of two decimals (digits and point, both positive) is greater: -1,
/// 0 or 1.
fn compareDecimals(_ left: (String, Int), _ right: (String, Int)) -> Int {
    let (a, pointA) = left
    let (b, pointB) = right
    if pointA != pointB {
        return pointA < pointB ? -1 : 1
    }
    let order = Runtime.compareStrings(a, b)
    return order < 0 ? -1 : order > 0 ? 1 : 0
}

/// A hexadecimal float, `-0x1.8p1`, read by fromHexString once white space
/// the styles allow is trimmed: `.Invalid(at: 0)` where it is not one.
fn hexFloat<T: FloatingPoint>(_ text: Substring, _ styles: NumberStyles) throws(ParseError) -> T {
    let (start, end) = try numberBounds(text, styles)
    let trimmed = text.base[String.Index(utf8Offset: start)..<String.Index(utf8Offset: end)].toString()
    if (trimmed.hasPrefix("-") || trimmed.hasPrefix("+")) && !styles.contains(.Sign) {
        throw .InvalidDigit(at: scalarPosition(text, start))
    }
    guard let value = T.fromHexString(trimmed) else {
        throw .Invalid(at: scalarPosition(text, start))
    }
    return value
}
