module UserSecretsTests

import Sable.Configuration
import Sable.IO
import Sable.Testing

import ConfigurationSupport

@test
async fn userSecretsAreKeptOutsideTheRepository() {
    let folder = try! Temp.directory()
    let secrets = UserSecrets(id: "shop", folder: folder.path)
    expect((try! await secrets.load()).isEmpty)
    try! secrets.set("Database:Password", "hunter2")
    try! secrets.set("Api:Key", "k")
    try! secrets.remove("Api:Key")
    try! secrets.remove("Nothing")
    let values = try! await secrets.load()
    assertEqual(values.keys, ["Database:Password"])
    expect(secrets.path == folder.path.appending("shop").appending("secrets.json"))
    expect(secrets.isSecret && secrets.name == "user secrets shop" && secrets.id == "shop")
    expect(File.exists(secrets.path))
    assertEqual(try! File.read(secrets.path), "{\n  \"Database:Password\": \"hunter2\"\n}\n")
}

@test
fn userSecretsAreUnderTheUsersSettings() {
    let secrets = UserSecrets(id: "shop")
    expect(secrets.path == UserSecrets.folder.appending("shop").appending("secrets.json"))
    expect(UserSecrets.folder.fileName == "UserSecrets")
    if let settings = Environment.knownFolder(.Config) {
        expect(UserSecrets.folder.starts(with: settings))
    }
}

@test
async fn userSecretsThatCannotBeWrittenSaySo() {
    let folder = try! Temp.directory()
    let blocker = folder.path.appending("taken")
    try! File.write(blocker, "a file, not a folder")
    let secrets = UserSecrets(id: "shop", folder: blocker)
    let error = require(expectThrows(ConfigurationError.self) { try secrets.set("a", "1") })
    expect(error.description().hasPrefix("user secrets shop: not read: "), error.description())
}

@test
async fn aProviderSaysNoFilesAndNoSecretsUnlessItDoes() {
    let memory = MemoryConfigurationProvider()
    expect(memory.files.isEmpty && !memory.isSecret)
    expect((try! await memory.load()).isEmpty)
}
