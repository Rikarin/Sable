<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Sable.Symbols</RootNamespace>
    <AssemblyName>Sable.Symbols</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sable.Syntax/Sable.Syntax.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sable.Core: the primitives' members and the core protocols, in Sable, part of every compilation. -->
    <EmbeddedResource Include="../../lib/Sable.Core/*.sb" LogicalName="lib/Sable.Core/%(Filename)%(Extension)" />
    <!-- The standard library as a package: its modules' tiers (LibraryTiers). -->
    <EmbeddedResource Include="../../lib/package.sb" LogicalName="lib/package.sb" />
  </ItemGroup>
</Project>
