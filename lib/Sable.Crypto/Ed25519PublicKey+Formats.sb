module Sable.Crypto

extension Ed25519PublicKey: AsymmetricPublicKey {
    public init(_ key: PublicKey) throws(CryptoError) {
        guard case .Ed25519(let own) = key else {
            throw CryptoError.InvalidKey(reason: "not an Ed25519 key")
        }
        self = own
    }

    public var anyKey: PublicKey => .Ed25519(self)
}
