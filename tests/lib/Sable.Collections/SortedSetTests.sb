module SortedSetTests

// SortedSet (Sable.Collections): against a Set and a sorted array as the
// model, under random operations and set algebra, and by example.

import Sable.Collections
import Sable.Testing

/// Arrays compared by what they print, as assertEqual needs Equatable.
fn assertSame(_ got: Int[>..], _ expected: Int[>..]) {
    assertEqual("\(got)", "\(expected)")
}

/// A random walk of numbers: xorshift.
struct Walk {
    var state: U64

    mutating fn next(_ below: Int) -> Int {
        state = state ^ (state << 13)
        state = state ^ (state >> 7)
        state = state ^ (state << 17)
        return Int(state % U64(below))
    }
}

fn elements<S: Sequence>(_ values: S) -> Int[>..] where S.Element == Int, S.Failure == Never {
    var all: Int[>..] = []
    for value in values {
        all.append(value)
    }
    return all
}

@test
fn eachOperationByExample() {
    var s = SortedSet<Int>()
    expect(s.isEmpty && s.first == none && s.last == none)
    expect(s.insert(5))
    expect(!s.insert(5))
    s.insert(1)
    s.insert(9)
    assertSame(s.toArray(), [1, 5, 9])
    expect(s.contains(9) && !s.contains(2))
    assertEqual(s.first ?? 0, 1)
    assertEqual(s.last ?? 0, 9)
    assertEqual(s.floor(6) ?? 0, 5)
    expect(s.floor(0) == none)
    assertEqual(s.ceiling(6) ?? 0, 9)
    expect(s.ceiling(10) == none)
    expect(s.remove(5))
    expect(!s.remove(5))
    assertEqual(s.popFirst() ?? 0, 1)
    assertEqual(s.popLast() ?? 0, 9)
    expect(s.popLast() == none && s.popFirst() == none)
    let literal = SortedSet<String>(["b", "a", "b"])
    assertEqual(literal.count, 2)
    assertEqual(literal.debugDescription(), "SortedSet([\"a\", \"b\"])")
    s.insert(3)
    s.removeAll()
    expect(s.isEmpty)
}

@test
fn positionsRangesSplitAndAppend() {
    var s = SortedSet<Int>([9, 1, 5, 3, 7])
    assertEqual(s[s.startIndex], 1)
    assertEqual(s[s.index(before: s.endIndex)], 9)
    assertEqual(s[s.index(after: s.startIndex)], 3)
    assertEqual(s[s.index(s.startIndex, offsetBy: 3)], 7)
    assertEqual(s.index(of: 5)!.rank, 2)
    expect(s.index(of: 4) == none)
    assertSame(elements(s.range(3..<7)), [3, 5])
    assertSame(elements(s.range(3...7)), [3, 5, 7])
    assertSame(elements(s.range(6...)), [7, 9])
    assertSame(elements(s.range(..<5)), [1, 3])
    assertSame(elements(s.range(...5)), [1, 3, 5])
    let high = s.split(at: 5)
    assertSame(s.toArray(), [1, 3])
    assertSame(high.toArray(), [5, 7, 9])
    s.append(contentsOf: [10, 11, 12])
    assertSame(s.toArray(), [1, 3, 10, 11, 12])
    s.append(contentsOf: [2, 2, 0])
    assertSame(s.toArray(), [0, 1, 2, 3, 10, 11, 12])
}

@test
fn setAlgebra() {
    let a = SortedSet<Int>([1, 2, 3, 4])
    let b = SortedSet<Int>([3, 4, 5])
    assertSame(a.union(b).toArray(), [1, 2, 3, 4, 5])
    assertSame(a.intersection(b).toArray(), [3, 4])
    assertSame(a.subtracting(b).toArray(), [1, 2])
    assertSame(a.symmetricDifference(b).toArray(), [1, 2, 5])
    var c = a
    c.formUnion(b)
    assertEqual(c.count, 5)
    c.subtract(SortedSet<Int>([1]))
    assertSame(c.toArray(), [2, 3, 4, 5])
    c.formIntersection(a)
    assertSame(c.toArray(), [2, 3, 4])
    c.formSymmetricDifference(b)
    assertSame(c.toArray(), [2, 5])
    expect(SortedSet<Int>([3, 4]).isSubset(of: a))
    expect(SortedSet<Int>([3, 4]).isStrictSubset(of: a))
    expect(!a.isStrictSubset(of: a) && a.isSubset(of: a))
    expect(a.isSuperset(of: SortedSet<Int>([1])))
    expect(a.isStrictSuperset(of: SortedSet<Int>([1])))
    expect(!b.isSubset(of: a))
    expect(a.isDisjoint(with: SortedSet<Int>([7, 8])))
    expect(!a.isDisjoint(with: b))
    expect(a == SortedSet<Int>([4, 3, 2, 1]))
    expect(a != b)
}

@test
fn randomOperationsAgreeWithAModel() {
    var s = SortedSet<Int>()
    var model = Set<Int>()
    var walk = Walk { state: 0xD1B54A32D192ED03 }
    var step = 0
    while step < 30000 {
        let value = walk.next(1000)
        let op = walk.next(4)
        if op < 2 {
            assertEqual(s.insert(value), model.insert(value))
        } else if op == 2 {
            assertEqual(s.remove(value), model.remove(value))
        } else {
            assertEqual(s.contains(value), model.contains(value))
        }
        assertEqual(s.count, model.count)
        step += 1
    }
    var sorted = model.toArray()
    sorted.sort()
    assertSame(s.toArray(), sorted)

    // Set algebra against the model, for sets of many sizes.
    var round = 0
    while round < 40 {
        var x = Set<Int>()
        var y = Set<Int>()
        var i = 0
        while i < walk.next(300) {
            x.insert(walk.next(400))
            i += 1
        }
        i = 0
        while i < walk.next(300) {
            y.insert(walk.next(400))
            i += 1
        }
        let sx = SortedSet<Int>(x.toArray())
        let sy = SortedSet<Int>(y.toArray())
        var joined = x.union(y).toArray()
        joined.sort()
        var both = x.intersection(y).toArray()
        both.sort()
        var only = x.subtracting(y).toArray()
        only.sort()
        var either = x.symmetricDifference(y).toArray()
        either.sort()
        assertSame(sx.union(sy).toArray(), joined)
        assertSame(sx.intersection(sy).toArray(), both)
        assertSame(sx.subtracting(sy).toArray(), only)
        assertSame(sx.symmetricDifference(sy).toArray(), either)
        assertEqual(sx.isSubset(of: sy), x.isSubset(of: y))
        assertEqual(sx.isDisjoint(with: sy), x.isDisjoint(with: y))
        round += 1
    }
}
