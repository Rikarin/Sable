module ArraySortTests

// Sorting an array (Sable.Core, Array+Sort.sb), tested with '@test': run
// with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

/// 'count' pseudo-random values below 'bound', the same each time.
fn scrambled(_ count: Int, _ bound: Int) -> Int[>..] {
    var values: Int[>..] = []
    var x = 42
    var i = 0
    while i < count {
        x = (x * 1103515245 + 12345) % 2147483648
        values.append(x % bound)
        i = i + 1
    }
    return values
}

@test
fn sortOrdersASmallArrayInPlace() {
    var values: Int[>..] = [5, 3, 9, 1, 4, 1]
    values.sort()
    assert(values == [1, 1, 3, 4, 5, 9])
}

@test
fn sortOrdersALargeArrayInPlace() {
    var values = scrambled(1000, 500)
    values.sort()
    assertEqual(values.count, 1000)
    assert(values.isSorted())
}

@test
fn sortOfAnOddNumberOfPassesEndsInTheArray() {
    // 40 elements: runs of 16, then merges of width 16 and 32, two passes;
    // 20 elements: one pass, which leaves the result in the scratch.
    var twenty = scrambled(20, 100)
    twenty.sort()
    assert(twenty.isSorted())
    var forty = scrambled(40, 100)
    forty.sort()
    assert(forty.isSorted())
}

@test
fn sortOfAnAlreadySortedArrayKeepsIt() {
    var values: Int[>..] = []
    var i = 0
    while i < 100 {
        values.append(i)
        i = i + 1
    }
    values.sort()
    assertEqual(values[0], 0)
    assertEqual(values[99], 99)
    assert(values.isSorted())
}

@test
fn sortOfNothingOrOneChangesNothing() {
    var empty: Int[>..] = []
    empty.sort()
    assertEqual(empty.count, 0)
    var one: String[>..] = ["x"]
    one.sort()
    assert(one == ["x"])
}

@test
fn sortByIsStable() {
    // Ordered by tens only: within each ten, the order they came in.
    var values = scrambled(300, 100000)
    var tagged: Int[>..] = []
    var i = 0
    while i < values.count {
        tagged.append((values[i] % 10) * 1000 + i)
        i = i + 1
    }
    tagged.sort(by: (a: Int, b: Int) => a / 1000 < b / 1000)
    i = 1
    while i < tagged.count {
        let sameTen = tagged[i] / 1000 == tagged[i - 1] / 1000
        assert(tagged[i] / 1000 >= tagged[i - 1] / 1000)
        assert(!sameTen || tagged[i] > tagged[i - 1])
        i = i + 1
    }
}

@test
fn sortWorksOnEveryKindOfArray() {
    var fixed: Int[] = [3, 1, 2]
    fixed.sort()
    assert(fixed == [1, 2, 3])
    var shrink: String[>..<] = ["b", "c", "a"]
    shrink.sort()
    assert(shrink == ["a", "b", "c"])
}

@test
fn sortedLeavesTheArrayAsItWas() {
    let words: String[>..] = ["pear", "fig", "banana"]
    assert(words.sorted() == ["banana", "fig", "pear"])
    assert(words.sorted(by: (a: String, b: String) => a.count < b.count) == ["fig", "pear", "banana"])
    assert(words == ["pear", "fig", "banana"])
}

@test
fn sortedOfASliceSortsItsRun() {
    let values: Int[>..] = [9, 4, 7, 1, 8]
    assert(values[1..<4].sorted() == [1, 4, 7])
}

@bench
fn sortAThousand() {
    var values = scrambled(1000, 1000000)
    values.sort()
}
