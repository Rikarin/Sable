module SleepCancelBench

import Sable.Concurrency
import Sable.Testing
import Sable.Time

// Sleeps cut short: fifty thousand tasks, each to sleep an hour, all
// cancelled one by one and awaited.

fn run() async -> String {
    var tasks: Task<Int>[>..] = []
    for _ in 0..<50000 {
        tasks.append(
            Task.spawn {
                do {
                    try await Task.sleep(for: Duration.hours(1))
                    return 0
                } catch {
                    return 1
                }
            })
    }
    for task in tasks {
        task.cancel()
    }
    var total = 0
    for task in tasks {
        total += await task.value
    }
    return "\(total)"
}

@bench
fn measure(_ b: Bencher) async {
    b.check(await b.iterateAsync { await run() })
}
