module StringSearchTests

// String's searches, splitting and replacing (Sable.Core), tested with
// '@test': run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

fn offset(_ index: String.Index?) -> Int {
    if let found = index {
        return found.utf8Offset
    }
    return -1
}

@test
fn containsFindsEachKindOfPattern() {
    let text = "hello, wörld"
    expect(text.contains("o, w"), "a string")
    expect(text.contains('ö'), "a character")
    expect(text.contains(CharSet(",;")), "a set")
    expect(text.contains(where: { c in c.isPunctuation }), "a test")
    expect(!text.contains("world"), "not a string that is not there")
    expect(!text.contains('z'), "nor a character")
    expect(!text.contains(where: { c in c.isDigit }), "nor what no character passes")
    expect(text.contains(""), "the empty string is everywhere")
    expect("".contains(""), "even in the empty string")
    expect(!"".contains('a'), "nothing is in the empty string")
}

@test
fn prefixesAndSuffixes() {
    let text = "café au lait"
    expect(text.hasPrefix("café") && text.hasPrefix('c') && text.hasPrefix(""), "prefixes")
    expect(!text.hasPrefix("lait") && !text.hasPrefix('a') && !"".hasPrefix('a'), "not prefixes")
    expect(text.hasSuffix("lait") && text.hasSuffix('t') && text.hasSuffix(""), "suffixes")
    expect(!text.hasSuffix("café") && !text.hasSuffix('l') && !"".hasSuffix('a'), "not suffixes")
    expect(!"ab".hasPrefix("abc") && !"ab".hasSuffix("abc"), "a pattern longer than the text")
    expect("é".hasSuffix('é') && !"é".hasSuffix('e'), "a suffix of more than one byte")
    expect(text.hasPrefix(CharSet.asciiLetters) && text.hasSuffix(CharSet.asciiLetters), "a set at either end")
    expect(!text.hasPrefix(CharSet.asciiDigits) && !text.hasSuffix(CharSet.asciiDigits), "a set at neither end")
}

@test
fn firstAndLastIndices() {
    let text = "a→b→c"
    assertEqual(offset(text.firstIndex(of: '→')), 1)
    assertEqual(offset(text.lastIndex(of: '→')), 5)
    assertEqual(offset(text.firstIndex(of: "b→")), 4)
    assertEqual(offset(text.lastIndex(of: "→")), 5)
    assertEqual(offset(text.firstIndex(where: { c in c == 'c' })), 8)
    assertEqual(offset(text.lastIndex(where: { c in c.isAsciiLetter })), 8)
    assertEqual(offset(text.lastIndex(where: { c in c == 'a' })), 0)
    assertEqual(offset(text.firstIndex(of: 'z')), -1)
    assertEqual(offset(text.lastIndex(of: 'z')), -1)
    assertEqual(offset(text.lastIndex(where: { c in c.isDigit })), -1)
    assertEqual(offset(text.firstIndex(where: { c in c.isDigit })), -1)
    assertEqual(offset("".lastIndex(of: "")), 0)
    assertEqual(offset("ab".lastIndex(of: "abc")), -1)
}

@test
fn rangesOfMatches() {
    let text = "abcabc"
    let first = text.firstRange(of: "bc")!
    assertEqual(first.lowerBound.utf8Offset, 1)
    assertEqual(first.upperBound.utf8Offset, 3)
    let last = text.lastRange(of: "bc")!
    assertEqual(last.lowerBound.utf8Offset, 4)
    let all = text.ranges(of: "bc")
    assertEqual(all.count, 2)
    assertEqual(all[1].lowerBound.utf8Offset, 4)
    expect(text.firstRange(of: "x") == none && text.lastRange(of: "x") == none, "no match, no range")
    assertEqual("aaaa".ranges(of: "aa").count, 2)
}

@test
fn anEmptyPatternMatchesBetweenEveryTwoScalars() {
    assertEqual("aé".ranges(of: "").count, 3)
    assertEqual("aé".count(of: ""), 3)
    assertEqual("aé".replacing("", with: "-"), "-a-é-")
    assertEqual("ab".split(""), ["", "a", "b", ""])
}

@test
fn countingMatches() {
    assertEqual("banana".count(of: "an"), 2)
    assertEqual("banana".count(of: 'a'), 3)
    assertEqual("aaaa".count(of: "aa"), 2)
    assertEqual("banana".count(of: "x"), 0)
    assertEqual("a1b22c".count(where: { c in c.isDigit }), 3)
    assertEqual("a1b22c".count(of: CharSet.asciiDigits), 3)
    assertEqual("banana".count, 6)
}

@test(arguments: [
    ("a-b-c", "-", "+", "a+b+c"), ("a--b", "--", "—", "a—b"), ("aaa", "a", "aa", "aaaaaa"),
    ("nothing", "x", "y", "nothing"), ("", "a", "b", "")
])
fn replacingEveryMatch(_ text: String, _ pattern: String, _ replacement: String, _ replaced: String) {
    expect(text.replacing(pattern, with: replacement) == replaced)
}

@test
fn replacingACharacter() {
    assertEqual("a-b-c".replacing('-', with: "+"), "a+b+c")
}

@test
fn replacingWhatATestAccepts() {
    assertEqual("x1y22".replacing(where: { c in c.isDigit }, with: "#"), "x#y##")
}

@test(arguments: [("a-b-c", 1, "ab-c"), ("a-b-c", 0, "a-b-c"), ("a-b-c", 5, "abc")])
fn replacingAtMostSoMany(_ text: String, _ count: Int, _ replaced: String) {
    expect(text.replacing("-", with: "", maxCount: count) == replaced)
}

@test(arguments: [
    ("a,b,,c", ["a", "b", "", "c"], ["a", "b", "c"]), (",a,", ["", "a", ""], ["a"]), (",,", ["", "", ""], []), ("", [""], [])
])
fn splittingKeepsEmptyRunsUnlessAskedNot(_ text: String, _ all: String[>..], _ nonEmpty: String[>..]) {
    expect(text.split(",") == all)
    expect(text.split(',') == all)
    expect(text.split(",", omittingEmpty: true) == nonEmpty)
}

@test
fn splittingAtAStringTakesAllOfIt() {
    expect("a::b".split("::") == ["a", "b"])
}

// A text put together again is what it was, however it was split.
@test
fn aTextSplitAndJoinedIsItself() {
    forAll(Gen.string(of: Gen.element(of: ['a', 'é', ',', '-', '😀']), count: 0...40)) { (text: String) in
        for separator in [",", "-,", "é"] {
            let parts = text.split(separator)
            expect(parts.joined(separator: separator) == text)
            expect(parts.count == text.count(of: separator) + 1)
            expect(text.ranges(of: separator).count == parts.count - 1)
            expect(text.replacing(separator, with: "!") == parts.joined(separator: "!"))
            expect(parts.allSatisfy { !$0.contains(separator) })
        }
    }
}

@test
fn splittingAtMostSoManyTimes() {
    assertEqual("k=v=w".split('=', maxSplits: 1), ["k", "v=w"])
    assertEqual("k=v=w".split('=', maxSplits: 0), ["k=v=w"])
    assertEqual("==k=v".split('=', maxSplits: 1, omittingEmpty: true), ["k", "v"])
}

@test
fn splittingWhereATestAccepts() {
    assertEqual("a1b22c".split(where: { c in c.isDigit }), ["a", "b", "", "c"])
    assertEqual("a1b22c".split(omittingEmpty: true, where: { c in c.isDigit }), ["a", "b", "c"])
    assertEqual("a1b22c".split(maxSplits: 1, where: { c in c.isDigit }), ["a", "b22c"])
}

@test
fn splittingAtWhiteSpace() {
    assertEqual("  the\tquick\u{3000}brown \n fox ".splitWhitespace(), ["the", "quick", "brown", "fox"])
    assertEqual("   ".splitWhitespace().count, 0)
}

@test
fn splittingOnce() {
    let pair = "key=value=more".splitOnce('=')!
    assertEqual(pair.0, "key")
    assertEqual(pair.1, "value=more")
    let last = "key=value=more".splitLastOnce("=")!
    assertEqual(last.0, "key=value")
    assertEqual(last.1, "more")
    expect("plain".splitOnce('=') == none, "no separator, no pair")
    expect("plain".splitLastOnce('=') == none, "nor from the end")
}

@test(arguments: [
    ("one\r\ntwo\n\nthree\n", ["one", "two", "", "three"]), ("one", ["one"]), ("\n", [""]), ("", []), ("a\r", ["a"])
])
fn linesDropTheirEndings(_ text: String, _ lines: String[>..]) {
    expect(text.lines() == lines)
}

@test
fn trimmingAPrefixOrSuffix() {
    assertEqual("v1.2".trimmingPrefix("v"), "1.2")
    assertEqual("1.2".trimmingPrefix("v"), "1.2")
    assertEqual("vv1".trimmingPrefix('v'), "v1")
    assertEqual("file.txt".trimmingSuffix(".txt"), "file")
    assertEqual("file.txt".trimmingSuffix(".md"), "file.txt")
    assertEqual("a1".trimmingSuffix(CharSet.asciiDigits), "a")
}

@test
fn searchesAreLinearOnLongText() {
    // A quadratic search would take seconds here.
    var parts: String[>..] = []
    var i = 0
    while i < 20000 {
        parts.append("é,")
        i = i + 1
    }
    let text = parts.joined()
    assertEqual(text.split(',').count, 20001)
    assertEqual(text.count(of: 'é'), 20000)
    assertEqual(text.replacing(",", with: "").count, 20000)
    assertEqual(text.lastIndex(of: 'é')!.utf8Offset, 59997)
}

@bench
fn findingAStringInLongText(_ b: Bencher) {
    var parts: String[>..] = []
    var i = 0
    while i < 4096 {
        parts.append("lorem ipsum dolor sit amet ")
        i = i + 1
    }
    parts.append("needle")
    let text = parts.joined()
    b.iterate(() => {
        _ = text.firstIndex(of: "needle")
    })
}

@bench
fn splittingLongText(_ b: Bencher) {
    var parts: String[>..] = []
    var i = 0
    while i < 4096 {
        parts.append("field,")
        i = i + 1
    }
    let text = parts.joined()
    b.iterate(() => {
        _ = text.split(",")
    })
}
