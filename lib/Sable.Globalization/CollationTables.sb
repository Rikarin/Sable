/// The strings a collation orders its own way.
fn collationTailoring(_ tag: String) -> String? {
    return match tag {
        case "sv"              => tailoringSv
        case "da"              => tailoringDa
        case "nb"              => tailoringNb
        case "de-u-co-phonebk" => tailoringDeUCoPhonebk
        case "es"              => tailoringEs
        case "es-u-co-trad"    => tailoringEsUCoTrad
        case "fr-CA"           => tailoringFrCa
        case "pl"              => tailoringPl
        case "cs"              => tailoringCs
        case "sk"              => tailoringSk
        case "sl"              => tailoringSl
        case "hr"              => tailoringHr
        case "sr"              => tailoringSr
        case "hu"              => tailoringHu
        case "ro"              => tailoringRo
        case "bg"              => tailoringBg
        case "ru"              => tailoringRu
        case "uk"              => tailoringUk
        case "el"              => tailoringEl
        case "tr"              => tailoringTr
        case "lt"              => tailoringLt
        case "lv"              => tailoringLv
        case "et"              => tailoringEt
        case "fi"              => tailoringFi
        case "is"              => tailoringIs
        case "cy"              => tailoringCy
        case "mt"              => tailoringMt
        case "ar"              => tailoringAr
        case "fa"              => tailoringFa
        case "he"              => tailoringHe
        case "hi"              => tailoringHi
        case "bn"              => tailoringBn
        case "mr"              => tailoringMr
        case "ta"              => tailoringTa
        case "th"              => tailoringTh
        case "vi"              => tailoringVi
        case _                 => none
    }
}

/// The order of scripts a collation has.
fn collationReorder(_ tag: String) -> String? {
    return match tag {
        case "hr" => reorderHr
        case "sr" => reorderSr
        case "bg" => reorderBg
        case "ru" => reorderRu
        case "uk" => reorderUk
        case "el" => reorderEl
        case "ar" => reorderAr
        case "fa" => reorderFa
        case "he" => reorderHe
        case "hi" => reorderHi
        case "bn" => reorderBn
        case "mr" => reorderMr
        case "ta" => reorderTa
        case "th" => reorderTh
        case _    => none
    }
}

/// The ways a collation differs in its settings.
fn collationSettings(_ tag: String) -> String? {
    return match tag {
        case "da"    => "upper"
        case "fr-CA" => "backwards"
        case "mt"    => "upper"
        case "th"    => "shifted"
        case _       => none
    }
}

