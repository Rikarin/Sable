module Int4Tests

import Sable.Math.Geometry
import Sable.Serialize
import Sable.Testing

let a: Int4 = Int4(7, -3, 2, 9)
let b: Int4 = Int4(2, 2, -2, 4)

@test
fn itsLayoutIsItsComponentsInOrder() {
    assertEqual(MemoryLayout<Int4>.size, 16)
    assertEqual(MemoryLayout<Int4>.alignment, 4)
}

@test
fn itsComponentsAreReadAndWrittenByIndex() {
    var v = a
    for i in 0..<4 {
        assertEqual(v[i], a[i])
        v[i] = b[i]
    }
    assertEqual(v, b)
    expectPanic("has no component 4") {
        _ = a[4]
    }
    expectPanic("has no component -1") {
        var v = a
        v[-1] = 0
    }
}

@test
fn arithmeticIsIntegersAndDividesTowardZero() {
    assertEqual(a + b, Int4(9, -1, 0, 13))
    assertEqual(a - b, Int4(5, -5, 4, 5))
    assertEqual(a * b, Int4(14, -6, -4, 36))
    assertEqual(a / b, Int4(3, -1, -1, 2))
    assertEqual(a * 2, Int4(14, -6, 4, 18))
    assertEqual(2 * a, Int4(14, -6, 4, 18))
    assertEqual(a / 2, Int4(3, -1, 1, 4))
    assertEqual(-a, Int4(-7, 3, -2, -9))
    assertEqual(a.min(b), Int4(2, -3, -2, 4))
    assertEqual(a.max(b), Int4(7, 2, 2, 9))
    assertEqual(a.abs(), Int4(7, 3, 2, 9))
    assertEqual(a.clamped(lower: Int4.zero, upper: Int4(repeating: 5)), Int4(5, 0, 2, 5))
    expectPanic("overflow") {
        _ = Int4(repeating: I32.max) + Int4.one
    }
}

@test
fn itIsMadeOfFloatsTowardZero() {
    assertEqual(Int4(truncating: Vector4(1.9, -1.9, 3, 0.5)), Int4(1, -1, 3, 0))
    assertEqual(Int4(repeating: 3), Int4.one * 3)
    assertEqual(Int4.unitX + Int4.unitY + Int4.unitZ + Int4.unitW, Int4.one)
    assertEqual(a.simd[3], 9)
}

@test
fn itIsEqualHashedWrittenAndSerialised() {
    assertEqual(a.hashValue, Int4(7, -3, 2, 9).hashValue)
    for i in 0..<4 {
        var other = a
        other[i] += 1
        require(a != other)
    }
    assertEqual("\(a)", "(7, -3, 2, 9)")
    assertEqual(a.debugDescription(), "Int4(7, -3, 2, 9)")
    assertEqual("\(a:?)", "Int4(7, -3, 2, 9)")
    assertEqual(try! Json.decode(Int4.self, from: try! Json.encode(a)), a)
}

@test
fn itHoldsShorterOnes() {
    assertEqual(a.xy, Int2(7, -3))
    assertEqual(a.xyz, Int3(7, -3, 2))
}
