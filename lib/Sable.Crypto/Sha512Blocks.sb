module Sable.Crypto

/// SHA-384's and SHA-512's compression function, portably.
struct Sha512Blocks: BlockHash {
    static var blockBytes: Int => 128

    static var stateBytes: Int => 64

    static var lengthBytes: Int => 16

    static var bigEndianLength: Bool => true

    static var kernel: Int => Native.sha512

    unsafe static fn compress(state: Int, block: Int) {
        // The message's schedule, in a window of sixteen words.
        let w = block + blockBytes
        let k = sha512Constants
        var i = 0
        while i < 16 {
            store64(load64(block + 8 * i).byteSwapped, w + 8 * i)
            i += 1
        }
        var a = load64(state)
        var b = load64(state + 8)
        var c = load64(state + 16)
        var d = load64(state + 24)
        var e = load64(state + 32)
        var f = load64(state + 40)
        var g = load64(state + 48)
        var h = load64(state + 56)
        var t = 0
        while t < 80 {
            if t >= 16 {
                // Sixteen words on, all at once.
                i = 0
                while i < 16 {
                    let w1 = load64(w + 8 * ((i + 1) & 15))
                    let w14 = load64(w + 8 * ((i + 14) & 15))
                    let s0 = w1.rotatedRight(by: 1) ^ w1.rotatedRight(by: 8) ^ (w1 >> 7)
                    let s1 = w14.rotatedRight(by: 19) ^ w14.rotatedRight(by: 61) ^ (w14 >> 6)
                    store64(load64(w + 8 * i) &+ s0 &+ load64(w + 8 * ((i + 9) & 15)) &+ s1, w + 8 * i)
                    i += 1
                }
            }
            // Sixteen rounds, eight written out so that no word moves.
            i = 0
            while i < 16 {
                h = h &+ (e.rotatedRight(by: 14) ^ e.rotatedRight(by: 18) ^ e.rotatedRight(by: 41)) &+ (g ^ (e & (f ^ g))) &+ load64(k + 8 * (t + i)) &+ load64(w + 8 * (i))
                d = d &+ h
                h = h &+ (a.rotatedRight(by: 28) ^ a.rotatedRight(by: 34) ^ a.rotatedRight(by: 39)) &+ ((a & b) | (c & (a | b)))
                g = g &+ (d.rotatedRight(by: 14) ^ d.rotatedRight(by: 18) ^ d.rotatedRight(by: 41)) &+ (f ^ (d & (e ^ f))) &+ load64(k + 8 * (t + i + 1)) &+ load64(w + 8 * (i + 1))
                c = c &+ g
                g = g &+ (h.rotatedRight(by: 28) ^ h.rotatedRight(by: 34) ^ h.rotatedRight(by: 39)) &+ ((h & a) | (b & (h | a)))
                f = f &+ (c.rotatedRight(by: 14) ^ c.rotatedRight(by: 18) ^ c.rotatedRight(by: 41)) &+ (e ^ (c & (d ^ e))) &+ load64(k + 8 * (t + i + 2)) &+ load64(w + 8 * (i + 2))
                b = b &+ f
                f = f &+ (g.rotatedRight(by: 28) ^ g.rotatedRight(by: 34) ^ g.rotatedRight(by: 39)) &+ ((g & h) | (a & (g | h)))
                e = e &+ (b.rotatedRight(by: 14) ^ b.rotatedRight(by: 18) ^ b.rotatedRight(by: 41)) &+ (d ^ (b & (c ^ d))) &+ load64(k + 8 * (t + i + 3)) &+ load64(w + 8 * (i + 3))
                a = a &+ e
                e = e &+ (f.rotatedRight(by: 28) ^ f.rotatedRight(by: 34) ^ f.rotatedRight(by: 39)) &+ ((f & g) | (h & (f | g)))
                d = d &+ (a.rotatedRight(by: 14) ^ a.rotatedRight(by: 18) ^ a.rotatedRight(by: 41)) &+ (c ^ (a & (b ^ c))) &+ load64(k + 8 * (t + i + 4)) &+ load64(w + 8 * (i + 4))
                h = h &+ d
                d = d &+ (e.rotatedRight(by: 28) ^ e.rotatedRight(by: 34) ^ e.rotatedRight(by: 39)) &+ ((e & f) | (g & (e | f)))
                c = c &+ (h.rotatedRight(by: 14) ^ h.rotatedRight(by: 18) ^ h.rotatedRight(by: 41)) &+ (b ^ (h & (a ^ b))) &+ load64(k + 8 * (t + i + 5)) &+ load64(w + 8 * (i + 5))
                g = g &+ c
                c = c &+ (d.rotatedRight(by: 28) ^ d.rotatedRight(by: 34) ^ d.rotatedRight(by: 39)) &+ ((d & e) | (f & (d | e)))
                b = b &+ (g.rotatedRight(by: 14) ^ g.rotatedRight(by: 18) ^ g.rotatedRight(by: 41)) &+ (a ^ (g & (h ^ a))) &+ load64(k + 8 * (t + i + 6)) &+ load64(w + 8 * (i + 6))
                f = f &+ b
                b = b &+ (c.rotatedRight(by: 28) ^ c.rotatedRight(by: 34) ^ c.rotatedRight(by: 39)) &+ ((c & d) | (e & (c | d)))
                a = a &+ (f.rotatedRight(by: 14) ^ f.rotatedRight(by: 18) ^ f.rotatedRight(by: 41)) &+ (h ^ (f & (g ^ h))) &+ load64(k + 8 * (t + i + 7)) &+ load64(w + 8 * (i + 7))
                e = e &+ a
                a = a &+ (b.rotatedRight(by: 28) ^ b.rotatedRight(by: 34) ^ b.rotatedRight(by: 39)) &+ ((b & c) | (d & (b | c)))
                i += 8
            }
            t += 16
        }
        store64(load64(state) &+ a, state)
        store64(load64(state + 8) &+ b, state + 8)
        store64(load64(state + 16) &+ c, state + 16)
        store64(load64(state + 24) &+ d, state + 24)
        store64(load64(state + 32) &+ e, state + 32)
        store64(load64(state + 40) &+ f, state + 40)
        store64(load64(state + 48) &+ g, state + 48)
        store64(load64(state + 56) &+ h, state + 56)
    }
}

/// The first bits of the fractional parts of the cube roots of the first primes.
let sha512Constants: Int = constantTable([
    0x428A2F98D728AE22, 0x7137449123EF65CD, 0xB5C0FBCFEC4D3B2F, 0xE9B5DBA58189DBBC,
    0x3956C25BF348B538, 0x59F111F1B605D019, 0x923F82A4AF194F9B, 0xAB1C5ED5DA6D8118,
    0xD807AA98A3030242, 0x12835B0145706FBE, 0x243185BE4EE4B28C, 0x550C7DC3D5FFB4E2,
    0x72BE5D74F27B896F, 0x80DEB1FE3B1696B1, 0x9BDC06A725C71235, 0xC19BF174CF692694,
    0xE49B69C19EF14AD2, 0xEFBE4786384F25E3, 0x0FC19DC68B8CD5B5, 0x240CA1CC77AC9C65,
    0x2DE92C6F592B0275, 0x4A7484AA6EA6E483, 0x5CB0A9DCBD41FBD4, 0x76F988DA831153B5,
    0x983E5152EE66DFAB, 0xA831C66D2DB43210, 0xB00327C898FB213F, 0xBF597FC7BEEF0EE4,
    0xC6E00BF33DA88FC2, 0xD5A79147930AA725, 0x06CA6351E003826F, 0x142929670A0E6E70,
    0x27B70A8546D22FFC, 0x2E1B21385C26C926, 0x4D2C6DFC5AC42AED, 0x53380D139D95B3DF,
    0x650A73548BAF63DE, 0x766A0ABB3C77B2A8, 0x81C2C92E47EDAEE6, 0x92722C851482353B,
    0xA2BFE8A14CF10364, 0xA81A664BBC423001, 0xC24B8B70D0F89791, 0xC76C51A30654BE30,
    0xD192E819D6EF5218, 0xD69906245565A910, 0xF40E35855771202A, 0x106AA07032BBD1B8,
    0x19A4C116B8D2D0C8, 0x1E376C085141AB53, 0x2748774CDF8EEB99, 0x34B0BCB5E19B48A8,
    0x391C0CB3C5C95A63, 0x4ED8AA4AE3418ACB, 0x5B9CCA4F7763E373, 0x682E6FF3D6B2B8A3,
    0x748F82EE5DEFB2FC, 0x78A5636F43172F60, 0x84C87814A1F0AB72, 0x8CC702081A6439EC,
    0x90BEFFFA23631E28, 0xA4506CEBDE82BDE9, 0xBEF9A3F7B2C67915, 0xC67178F2E372532B,
    0xCA273ECEEA26619C, 0xD186B8C721C0C207, 0xEADA7DD6CDE0EB1E, 0xF57D4F7FEE6ED178,
    0x06F067AA72176FBA, 0x0A637DC5A2C898A6, 0x113F9804BEF90DAE, 0x1B710B35131C471B,
    0x28DB77F523047D84, 0x32CAAB7B40C72493, 0x3C9EBE0A15C9BEBC, 0x431D67C49C100D4C,
    0x4CC5D4BECB3E42B6, 0x597F299CFC657E2A, 0x5FCB6FAB3AD6FAEC, 0x6C44198C4A475817,
] as U64[>..])
