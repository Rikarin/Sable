module Sable.Math.Geometry

import Sable.Serialize

/// A scale, then a rotation, then a translation: where something is in its
/// parent, or a bone in a pose. Unlike a matrix it can be interpolated, and
/// its parts read. 40 bytes.
///
/// Composing two is exact but for rounding where scales are uniform; a scale
/// that differs by axis under a rotated parent would be a shear, which this
/// cannot hold, and the scales are multiplied as if it were none.
///
/// ```sable
/// let local = Transform(translation: Vector3(1, 0, 0))
/// let parent = Transform(translation: Vector3(0, 5, 0), scale: Vector3(repeating: 2))
/// assert((local * parent).translation == Vector3(2, 5, 0))
/// assert((local * parent).transformPosition(Vector3.zero) == Vector3(2, 5, 0))
/// ```
@derive(Serializable)
public struct Transform: Hashable, Sendable {
    /// Where it is.
    public var translation: Vector3

    /// How it is turned.
    public var rotation: Quaternion

    /// How it is scaled, along its own axes.
    public var scale: Vector3

    /// The transform of the parts, each left out one that changes nothing.
    public init(translation: Vector3 = Vector3(0, 0, 0), rotation: Quaternion = Quaternion(0, 0, 0, 1), scale: Vector3 = Vector3(1, 1, 1)) {
        self.translation = translation
        self.rotation = rotation
        self.scale = scale
    }

    /// The transform that changes nothing.
    public static var identity: Transform => Transform()

    /// The transform as a matrix.
    public var matrix: Matrix4x4 => Matrix4x4(scale: scale, rotation: rotation, translation: translation)

    /// A point scaled, turned and moved.
    public fn transformPosition(_ position: Vector3) -> Vector3 => rotation.transform(position * scale) + translation

    /// A direction scaled and turned.
    public fn transformDirection(_ direction: Vector3) -> Vector3 => rotation.transform(direction * scale)

    /// The transform that undoes this one, where the scale is uniform; a
    /// scale near zero has zero for its inverse.
    ///
    /// ```sable
    /// let t = Transform(translation: Vector3(1, 2, 3), scale: Vector3(repeating: 2))
    /// assert((t * t.inverted()).nearEqual(Transform.identity))
    /// ```
    public fn inverted() -> Transform {
        let reciprocal = Vector3(safeReciprocal(scale.x), safeReciprocal(scale.y), safeReciprocal(scale.z))
        let back = rotation.conjugate
        return Transform(translation: back.transform(-translation) * reciprocal, rotation: back, scale: reciprocal)
    }

    /// The transform so far from this to the other, the amount held to
    /// 0...1: the translation and the scale in a line, the rotation by `nlerp`.
    public fn lerp(to other: Transform, _ amount: F32) -> Transform {
        let t = saturated(amount)
        return Transform(translation: translation.lerp(to: other.translation, t), rotation: rotation.nlerp(to: other.rotation, t), scale: scale.lerp(to: other.scale, t))
    }

    /// What this does that the reference does not: what `adding` adds to another.
    public fn difference(from reference: Transform) -> Transform {
        let ratio = Vector3(scale.x * safeReciprocal(reference.scale.x), scale.y * safeReciprocal(reference.scale.y), scale.z * safeReciprocal(reference.scale.z))
        return Transform(translation: translation - reference.translation, rotation: reference.rotation.conjugate * rotation, scale: ratio)
    }

    /// The transform with so much of a difference (0...1) on top: at 0 this
    /// one, at 1 with all of it.
    public fn adding(_ difference: Transform, weight: F32) -> Transform {
        let w = saturated(weight)
        return Transform(
            translation: translation + difference.translation * w,
            rotation: rotation * Quaternion.identity.nlerp(to: difference.rotation, w),
            scale: scale * Vector3.one.lerp(to: difference.scale, w)
        )
    }

    /// Whether each part is near the other's.
    public fn nearEqual(_ other: Transform, tolerance: F32 = 0.000001) -> Bool {
        return translation.nearEqual(other.translation, tolerance: tolerance) && rotation.nearEqual(other.rotation, tolerance: tolerance) && scale.nearEqual(other.scale, tolerance: tolerance)
    }

    /// The left transform and then the right: `local * parent`.
    public operator * (lhs: Transform, rhs: Transform) -> Transform {
        return Transform(translation: rhs.translation + rhs.rotation.transform(lhs.translation * rhs.scale), rotation: lhs.rotation * rhs.rotation, scale: lhs.scale * rhs.scale)
    }

    /// Whether the parts are exactly equal, as IEEE has it.
    public operator == (lhs: Transform, rhs: Transform) -> Bool {
        return lhs.translation == rhs.translation && lhs.rotation == rhs.rotation && lhs.scale == rhs.scale
    }

    /// The parts' hashes.
    public fn hash(into hasher: inout Hasher) {
        hasher.combine(translation)
        hasher.combine(rotation)
        hasher.combine(scale)
    }
}

extension Transform: Formattable {
    /// The translation, the rotation and the scale, in parentheses.
    public fn format(_ spec: FormatSpec) -> String {
        return spec.padded("(\(translation.format(bare(spec))), \(rotation.format(bare(spec))), \(scale.format(bare(spec))))")
    }

    // The spec without its width.
    fn bare(_ spec: FormatSpec) -> FormatSpec {
        var part = spec
        part.width = 0
        return part
    }
}

extension Transform: Debug {
    /// As source writes it.
    public fn debugDescription() -> String {
        return "Transform(translation: \(translation.debugDescription()), rotation: \(rotation.debugDescription()), scale: \(scale.debugDescription()))"
    }
}
