module Sable.DependencyInjection

/// The services a program has, as they are registered: .NET's
/// `IServiceCollection`. `build` checks them and makes the provider.
///
/// ```sable
/// protocol Clock: Sendable {
///     fn now() -> Int
/// }
///
/// struct FixedClock: Clock {
///     let time: Int
///     fn now() -> Int { return time }
/// }
///
/// var services = ServiceCollection()
/// services.addSingleton((any Clock).self) { _services in FixedClock { time: 12 } }
/// let provider = try! services.build()
/// assert(try! provider.resolve((any Clock).self).now() == 12)
///
/// // A test's own, in place of it.
/// services.replaceSingleton((any Clock).self) { _services in FixedClock { time: 3 } }
/// assert(try! (try! services.build()).resolve((any Clock).self).now() == 3)
/// ```
///
/// What `@container` says at compile time, a collection says as it is built:
/// `services.add(AppServices.self)` adds all a container knows, and what is
/// added, replaced or removed after is checked with it.
public struct ServiceCollection {
    /// The registrations, in order. Of two of one service, the later is the
    /// one given where one is asked for.
    public var descriptors: ServiceDescriptor[>..] = []

    var openServices: OpenService[>..] = []

    public init() { }

    // ---- Singletons ----------------------------------------------------

    /// One for the program, made from its own dependencies.
    public mutating fn addSingleton<T: Injectable & Sendable>(_ type: T.Type, key: String? = none) {
        add(ServiceDescriptor.of(type, ServiceLifetime.Singleton, key))
    }

    /// One for the program, the service `S` being a `T`.
    public mutating fn addSingleton<S: Sendable, T: Injectable>(_ service: S.Type, _ type: T.Type, key: String? = none) {
        add(ServiceDescriptor.of(service, type, ServiceLifetime.Singleton, key))
    }

    /// One for the program, made by the closure.
    public mutating fn addSingleton<S: Sendable>(_ service: S.Type, key: String? = none, _ make: @escaping @Sendable (ServiceScope) throws -> S) {
        add(ServiceDescriptor.of(service, ServiceLifetime.Singleton, key, make))
    }

    /// One for the program, made as the provider is built by a closure that
    /// waits: `buildAsync` waits for it.
    public mutating fn addSingleton<S: Sendable>(_ service: S.Type, key: String? = none, _ make: @escaping @Sendable async (ServiceScope) throws -> S) {
        add(ServiceDescriptor(ServiceKey(service, key: key), waiting: [], { scope in try await make(scope) }))
    }

    /// One for the program, made as the provider is built from its own
    /// dependencies, by waiting for it.
    public mutating fn addSingleton<T: AsyncInjectable & Sendable>(_ type: T.Type, key: String? = none) {
        add(ServiceDescriptor(ServiceKey(type, key: key), waiting: T.dependencies(), { scope in try await T.make(scope) }))
    }

    /// One for the program, the service `S` being a `T`, made as the provider
    /// is built by waiting for it.
    public mutating fn addSingleton<S: Sendable, T: AsyncInjectable>(_ service: S.Type, _ type: T.Type, key: String? = none) {
        add(ServiceDescriptor(ServiceKey(service, key: key), waiting: T.dependencies(), { scope in try await T.make(scope) }))
    }

    /// One for the program, already made. Whose it is, disposes it.
    public mutating fn addSingleton<S: Sendable>(_ service: S.Type, key: String? = none, value: S) {
        add(ServiceDescriptor.of(service, key, value))
    }

    // ---- Scoped --------------------------------------------------------

    /// One for each scope, made from its own dependencies.
    public mutating fn addScoped<T: Injectable>(_ type: T.Type, key: String? = none) {
        add(ServiceDescriptor.of(type, ServiceLifetime.Scoped, key))
    }

    /// One for each scope, the service `S` being a `T`.
    public mutating fn addScoped<S, T: Injectable>(_ service: S.Type, _ type: T.Type, key: String? = none) {
        add(ServiceDescriptor.of(service, type, ServiceLifetime.Scoped, key))
    }

    /// One for each scope, made by the closure.
    public mutating fn addScoped<S>(_ service: S.Type, key: String? = none, _ make: @escaping @Sendable (ServiceScope) throws -> S) {
        add(ServiceDescriptor.of(service, ServiceLifetime.Scoped, key, make))
    }

    // ---- Transient -----------------------------------------------------

    /// A new one each time, made from its own dependencies.
    public mutating fn addTransient<T: Injectable>(_ type: T.Type, key: String? = none) {
        add(ServiceDescriptor.of(type, ServiceLifetime.Transient, key))
    }

    /// A new one each time, the service `S` being a `T`.
    public mutating fn addTransient<S, T: Injectable>(_ service: S.Type, _ type: T.Type, key: String? = none) {
        add(ServiceDescriptor.of(service, type, ServiceLifetime.Transient, key))
    }

    /// A new one each time, made by the closure.
    public mutating fn addTransient<S>(_ service: S.Type, key: String? = none, _ make: @escaping @Sendable (ServiceScope) throws -> S) {
        add(ServiceDescriptor.of(service, ServiceLifetime.Transient, key, make))
    }

    // ---- The registrations ---------------------------------------------

    /// Adds a registration.
    public mutating fn add(_ descriptor: ServiceDescriptor) {
        descriptors.append(descriptor)
    }

    /// Adds all that a module registers.
    public mutating fn add<M: ServiceModule>(_ services: M) {
        services.register(in: &self)
    }

    /// Adds all that a container, or a package's `Services`, registers.
    public mutating fn add<M: StandardModule>(_ services: M.Type) {
        M.standard().register(in: &self)
    }

    /// Adds a registration unless its service has one: whether it did.
    @discardable
    public mutating fn tryAdd(_ descriptor: ServiceDescriptor) -> Bool {
        if contains(descriptor.key) {
            return false
        }
        add(descriptor)
        return true
    }

    /// Adds a registration in place of those its service has.
    public mutating fn replace(_ descriptor: ServiceDescriptor) {
        remove(descriptor.key)
        add(descriptor)
    }

    /// One for the program, made by the closure, in place of the service's own.
    public mutating fn replaceSingleton<S: Sendable>(_ service: S.Type, key: String? = none, _ make: @escaping @Sendable (ServiceScope) throws -> S) {
        replace(ServiceDescriptor.of(service, ServiceLifetime.Singleton, key, make))
    }

    /// One for the program, already made, in place of the service's own.
    public mutating fn replaceSingleton<S: Sendable>(_ service: S.Type, key: String? = none, value: S) {
        replace(ServiceDescriptor.of(service, key, value))
    }

    /// One for each scope, made by the closure, in place of the service's own.
    public mutating fn replaceScoped<S>(_ service: S.Type, key: String? = none, _ make: @escaping @Sendable (ServiceScope) throws -> S) {
        replace(ServiceDescriptor.of(service, ServiceLifetime.Scoped, key, make))
    }

    /// A new one each time, made by the closure, in place of the service's own.
    public mutating fn replaceTransient<S>(_ service: S.Type, key: String? = none, _ make: @escaping @Sendable (ServiceScope) throws -> S) {
        replace(ServiceDescriptor.of(service, ServiceLifetime.Transient, key, make))
    }

    /// Removes a service's registrations.
    public mutating fn remove(_ type: Type, key: String? = none) {
        remove(ServiceKey(type, key: key))
    }

    /// Removes a service's registrations.
    public mutating fn remove(_ key: ServiceKey) {
        descriptors = descriptors.filter { $0.key != key }.toArray()
    }

    /// Whether the service is registered.
    public fn contains(_ type: Type, key: String? = none) -> Bool {
        return contains(ServiceKey(type, key: key))
    }

    /// Whether the service is registered.
    public fn contains(_ key: ServiceKey) -> Bool {
        for each in descriptors {
            if each.key == key {
                return true
            }
        }
        return false
    }
}
