module Sable.Build

/// A build for one target, named by its triple as `--target` takes it:
/// `[targets."wasm32-wasi"]` in TOML.
public struct TargetSettings {
    var triple: String
    var reflection: Bool

    /// With `reflection: false`, the build carries no reflection, as
    /// `--deny-reflection` asks: `Mirror` and `TypeInfo` are errors.
    public static fn target(_ triple: String, reflection: Bool = true) -> TargetSettings {
        return TargetSettings { triple: triple, reflection: reflection }
    }
}
