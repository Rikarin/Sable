module Sable.Core

// A range of integers, of any width, is a collection of them: a 'for' over
// one counts and makes no iterator, and this is what generic code sees of
// it. Its positions are its values, so reading one gives the position back.
// Steps are taken through the 128 bits every integer fits in, so that the
// distance between two I8s, say, is an Int however far apart they are; once
// specialised for a type, that is the type's own arithmetic.

/// Gives a range's integers, from its lower bound up.
public struct RangeIterator<Bound: FixedWidthInteger>: Iterator {
    var upcoming: Bound
    let end: Bound

    /// The next integer, or none at the end.
    public mutating fn next() -> Bound? {
        if !(upcoming < end) {
            return none
        }
        let value = upcoming
        // Below the end, so one more is no overflow.
        upcoming = value &+ Bound.truncating(1)
        return value
    }
}

extension Range where Bound: FixedWidthInteger {
    /// How many values the range has: none when the bounds are the wrong
    /// way round.
    ///
    /// ```sable
    /// assert((2..<5).count == 3)
    /// assert((-100 as I8..<100).count == 200)
    /// ```
    public var count: Int => isEmpty ? 0 : Int.truncating(upperBound.wideBitPattern &- lowerBound.wideBitPattern)
}

extension Range where Bound == Int {
    /// Every 'step'-th value, from the lower bound: Rust's 'step_by'. A
    /// negative step gives nothing, as the range only goes up; a step of zero
    /// gives nothing either.
    ///
    /// ```sable
    /// var values: Int[>..] = []
    /// for i in (0..<10).step(by: 3) {
    ///     values.append(i)
    /// }
    /// assert(values == [0, 3, 6, 9])
    /// ```
    public fn step(by step: Int) -> StrideTo {
        return stride(from: lowerBound, to: step > 0 ? upperBound : lowerBound, by: step)
    }
}

extension Range: RandomAccessCollection where Bound: FixedWidthInteger {
    /// An iterator from the lower bound.
    public fn makeIterator() -> RangeIterator<Bound> {
        return RangeIterator<Bound> { upcoming: lowerBound, end: upperBound }
    }

    /// The first value's position: the lower bound.
    public var startIndex: Bound => lowerBound

    /// The position past the last value: the upper bound, or the lower
    /// bound when the range is empty, as one the wrong way round is.
    public var endIndex: Bound => isEmpty ? lowerBound : upperBound

    /// The next position.
    public fn index(after position: Bound) -> Bound => position + Bound.truncating(1)

    /// The position before.
    public fn index(before position: Bound) -> Bound => position - Bound.truncating(1)

    /// The position 'distance' on, which may be back.
    public fn index(_ position: Bound, offsetBy distance: Int) -> Bound =>
        Bound.fromWideBitPattern(position.wideBitPattern &+ U128.truncating(distance))

    /// How far on 'end' is from 'start'.
    public fn distance(from start: Bound, to end: Bound) -> Int => Int.truncating(end.wideBitPattern &- start.wideBitPattern)

    /// The value at a position, which is the position itself.
    public subscript(position: Bound) -> Bound {
        get => position
    }
}
