module Sable.Crypto.X509

/// An address's bytes and its text. Sable.Net has a type for these; it is
/// not used here so that what makes connections can use this module.
struct IpText {
    /// The text of four bytes, or of sixteen in groups.
    static fn write(_ bytes: U8[:]) -> String {
        if bytes.count == 4 {
            return "\(bytes[0]).\(bytes[1]).\(bytes[2]).\(bytes[3])"
        }
        var groups: String[>..] = []
        var i = 0
        while i + 1 < bytes.count {
            let group = U16(bytes[i]) << 8 | U16(bytes[i + 1])
            groups.append("\(group:x)")
            i += 2
        }
        return groups.joined(separator: ":")
    }

    /// The one text RFC 5952 has for an address: the longest run of zero
    /// groups, the first of those, left out.
    static fn canonical(_ bytes: U8[:]) -> String {
        if bytes.count == 4 {
            return write(bytes)
        }
        var groups: String[>..] = []
        for group in write(bytes).split(separator: ':') {
            groups.append("\(group)")
        }
        var best = 0
        var bestCount = 1
        var i = 0
        while i < groups.count {
            var end = i
            while end < groups.count && groups[end] == "0" {
                end += 1
            }
            if end - i > bestCount {
                best = i
                bestCount = end - i
            }
            i = end + 1
        }
        if bestCount < 2 {
            return groups.joined(separator: ":")
        }
        return groups[..<best].toArray().joined(separator: ":") + "::" + groups[best + bestCount...].toArray().joined(separator: ":")
    }

    /// The bytes of an address's text, if it is one.
    static fn read(_ text: String) -> U8[>..]? {
        if text.contains(':') {
            return readSix(text)
        }
        return readFour(text)
    }

    static fn readFour(_ text: String) -> U8[>..]? {
        var bytes: U8[>..] = []
        for part in text.split(separator: '.') {
            let digits = part.utf8.toArray()
            if digits.isEmpty || digits.count > 3 || (digits.count > 1 && digits[0] == 0x30) {
                return none
            }
            var value = 0
            for digit in digits {
                if digit < 0x30 || digit > 0x39 {
                    return none
                }
                value = value * 10 + Int(digit) - 0x30
            }
            if value > 255 {
                return none
            }
            bytes.append(U8(value))
        }
        return bytes.count == 4 ? bytes : none
    }

    static fn readSix(_ text: String) -> U8[>..]? {
        // What is before a "::" and what is after it.
        var halves: String[>..] = []
        for half in text.split("::") {
            halves.append("\(half)")
        }
        if halves.count > 2 {
            return none
        }
        guard let head = groups(halves[0]) else {
            return none
        }
        if halves.count == 1 {
            return head.count == 16 ? head : none
        }
        guard let tail = groups(halves[1]) else {
            return none
        }
        if head.count + tail.count > 14 {
            return none
        }
        var bytes = head
        bytes.append(repeating: 0, count: 16 - head.count - tail.count)
        bytes.append(contentsOf: tail)
        return bytes
    }

    static fn groups(_ text: String) -> U8[>..]? {
        var bytes: U8[>..] = []
        if text.isEmpty {
            return bytes
        }
        var parts: String[>..] = []
        for part in text.split(separator: ':') {
            parts.append("\(part)")
        }
        var i = 0
        while i < parts.count {
            if i == parts.count - 1 && parts[i].contains('.') {
                guard let four = readFour(parts[i]) else {
                    return none
                }
                bytes.append(contentsOf: four)
                i += 1
                continue
            }
            let digits = parts[i].utf8.toArray()
            if digits.isEmpty || digits.count > 4 {
                return none
            }
            var value = 0
            for digit in digits {
                let lower = digit | 0x20
                if digit >= 0x30 && digit <= 0x39 {
                    value = value * 16 + Int(digit) - 0x30
                } else if lower >= 0x61 && lower <= 0x66 {
                    value = value * 16 + Int(lower) - 0x57
                } else {
                    return none
                }
            }
            bytes.append(U8(value / 256))
            bytes.append(U8(value % 256))
            i += 1
        }
        return bytes
    }
}
