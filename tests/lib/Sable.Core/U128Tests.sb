module U128Tests

// U128 (Sable.Core): its limits, and the numeric protocols' operations at
// its width, at the limits. Run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

@test
fn theLimitsAreTheWidthsBounds() {
    assertEqual(U128.min, 0)
    assertEqual(U128.max, 340282366920938463463374607431768211455)
    assertEqual(U128.zero, 0)
    assertEqual(U128.one, 1)
    assertEqual(U128.bitWidth, 128)
    expect(!U128.isSigned, "U128 is unsigned")
}

@test
fn theLimitsPrintInDecimal() {
    assertEqual(U128.min.toString(), "0")
    assertEqual(U128.max.toString(), "340282366920938463463374607431768211455")
}

@test
fn addingPastTheGreatestValueWrapsSaturatesOrReportsIt() {
    assertEqual(U128.max.wrappingAdd(1), U128.min)
    assertEqual(U128.max.saturatingAdd(1), U128.max)
    expect(U128.max.checkedAdd(1) == none, "the sum does not fit")
    let (sum, overflowed) = U128.max.overflowingAdd(1)
    assertEqual(sum, U128.min)
    expect(overflowed, "the sum overflowed")
}

@test
fn subtractingPastTheLeastValueWrapsSaturatesOrReportsIt() {
    assertEqual(U128.min.wrappingSub(1), U128.max)
    assertEqual(U128.min.saturatingSub(1), U128.min)
    expect(U128.min.checkedSub(1) == none, "the difference does not fit")
    let (difference, overflowed) = U128.min.overflowingSub(1)
    assertEqual(difference, U128.max)
    expect(overflowed, "the difference overflowed")
}

@test
fn multiplyingPastTheLimitsWrapsSaturatesOrReportsIt() {
    assertEqual(U128.max.wrappingMul(2), U128.max - 1)
    assertEqual(U128.max.saturatingMul(2), U128.max)
    expect(U128.max.checkedMul(2) == none, "the product does not fit")
    let (product, overflowed) = U128.max.overflowingMul(2)
    assertEqual(product, U128.max - 1)
    expect(overflowed, "the product overflowed")
    let (high, low) = U128.max.multipliedFullWidth(by: U128.max)
    assertEqual(high, 340282366920938463463374607431768211454)
    assertEqual(low, 1)
}

@test
fn theBitCountsSeeEveryBit() {
    assertEqual(U128.zero.leadingZeroCount, 128)
    assertEqual(U128.zero.trailingZeroCount, 128)
    assertEqual(U128.one.leadingZeroCount, 127)
    assertEqual(U128.max.popCount, 128)
    assertEqual(U128(170141183460469231731687303715884105728).trailingZeroCount, 127)
    assertEqual(U128.max.leadingOneCount, 128)
    assertEqual(U128.max.trailingOneCount, 128)
}

@test
fn rotationsAndSwapsWorkAtTheWidth() {
    assertEqual(U128.one.rotatedLeft(by: 128), 1)
    assertEqual(U128.one.rotatedRight(by: 1), 170141183460469231731687303715884105728)
    assertEqual(U128.one.rotatedLeft(by: -1), 170141183460469231731687303715884105728)
    assertEqual(U128.one.bitReversed, 170141183460469231731687303715884105728)
    assertEqual(U128(1339673755198158349044581307228491536).byteSwapped, 21345817372864405881847059188222722561)
    assertEqual(U128(1339673755198158349044581307228491536).bigEndianBytes().count, 16)
    assertEqual(U128.fromBigEndianBytes(U128.max.bigEndianBytes()) ?? 0, U128.max)
    assertEqual(U128.fromLittleEndianBytes(U128.min.littleEndianBytes()) ?? 1, U128.min)
}

@test
fn conversionsStopAtTheLimits() {
    expect(U128.exactly(U128.max) == U128.max, "only a U128 holds U128's greatest value")
    expect(U128.exactly(I128.min) == none, "only an I128 holds I128's least value")
    assertEqual(U128.clamping(U128.max), U128.max)
    assertEqual(U128.clamping(I128.min), U128.min)
    assertEqual(U128.truncating(U128.max), U128.max)
    assertEqual(U128.exactly(U128.max) ?? 0, U128.max)
}

@test
fn theRemainderOfTheLeastValueByMinusOneIsZero() {
    assertEqual(U128.max.wrappingDiv(U128.max), 1)
    assertEqual(U128.max.wrappingRem(2), 1)
    expect(U128.max.checkedDiv(0) == none, "there is no quotient by zero")
}

@test(traps: "integer overflow")
fn addingPastTheGreatestValueTraps() {
    var x = U128.max
    x = x + 1
    assertEqual(x, 0)
}

@test(traps: "integer overflow")
fn subtractingPastTheLeastValueTraps() {
    var x = U128.min
    x = x - 1
    assertEqual(x, 0)
}

@test
fn negatingAnUnsignedValueWrapsOrSaturates() {
    assertEqual(U128.one.wrappingNeg(), U128.max)
    assertEqual(U128.one.saturatingNeg(), 0)
    expect(U128.one.checkedNeg() == none, "an unsigned type has no -1")
    assertEqual(U128.zero.checkedNeg() ?? 1, 0)
    assertEqual(U128.max.abs(), U128.max)
}

@test(arguments: [("0", 10, 0), ("12", 10, 12), ("+7f", 16, 127), ("340282366920938463463374607431768211455", 10, U128.max)])
fn shortAndLongTextsAreParsed(_ text: String, _ radix: Int, _ value: U128) throws {
    expect(try U128.parse(text, radix: radix) == value)
}

@test(arguments: [("-1", .Underflow), ("340282366920938463463374607431768211456", .Overflow), ("1x", .InvalidDigit(at: 1))])
fn aTextThatIsNoU128IsRefused(_ text: String, _ error: ParseError) {
    expectThrows(error) { _ = try U128.parse(text) }
}
