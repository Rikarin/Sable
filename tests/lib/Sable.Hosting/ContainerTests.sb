module HostContainerTests

import Sable.Concurrency
import Sable.Configuration
import Sable.DependencyInjection
import Sable.Hosting
import Sable.Serialize
import Sable.Testing

@immutable
@injectable(.Singleton)
final class Ledger: Disposable {
    let lines: Mutex<String[>..]> = Mutex([])
    init() { }
    fn add(_ line: String) {
        lines.withLock { $0.append(line) }
    }
    fn dispose() { add("disposed") }
    var all: String => lines.withLock { $0.joined(separator: " ") }
}

@immutable
@injectable(.Singleton)
final class Worker: HostedService {
    let ledger: Ledger
    let lifetime: ApplicationLifetime
    let name: String
    init(ledger: Ledger, lifetime: ApplicationLifetime, environment: HostEnvironment, @keyed("name") name: String) {
        self.ledger = ledger
        self.lifetime = lifetime
        self.name = environment.name.isEmpty ? "nowhere" : name
    }
    async fn run(cancellation: CancellationToken) throws {
        ledger.add("\(name) ran")
        lifetime.requestStop()
    }
}

fn builder(_ ledger: Ledger) -> ApplicationBuilder {
    let builder = ApplicationBuilder()
    builder.container.addSingleton(Ledger.self) { _services in ledger }
    builder.services.add("worker", Worker.self)
    return builder
}

@test
async fn aServiceIsMadeByTheContainer() {
    let ledger = Ledger()
    let builder = builder(ledger)
    builder.container.addSingleton(String.self, key: "name", value: "worker")
    let host = try! await builder.build()
    try! await host.run()
    assertEqual(ledger.all, "worker ran disposed")
}

@test
async fn whatMustBeWaitedForIs() {
    let ledger = Ledger()
    let builder = builder(ledger)
    builder.container.addSingleton(String.self, key: "name") { _services in
        await Task.yield()
        return "late"
    }
    let host = try! await builder.build()
    try! await host.run()
    assertEqual(ledger.all, "late ran disposed")
}

@derive(Serializable)
struct Greeting: Sendable {
    var text: String
}

@immutable
@injectable(.Singleton)
final class Greeter: HostedService {
    let ledger: Ledger
    let text: String
    let lifetime: ApplicationLifetime
    init(ledger: Ledger, greeting: Options<Greeting>, lifetime: ApplicationLifetime) {
        self.ledger = ledger
        text = greeting.value.text
        self.lifetime = lifetime
    }
    async fn run(cancellation: CancellationToken) throws {
        ledger.add(text)
        lifetime.requestStop()
    }
}

@test
async fn optionsAreBoundFromTheHostsConfiguration() {
    let ledger = Ledger()
    let builder = ApplicationBuilder(arguments: ["--Greeting:Text=hello"])
    builder.logging.minimumLevel = none
    builder.options.handleSignals = false
    builder.container.addSingleton(Ledger.self) { _services in ledger }
    builder.container.configure(Greeting.self, section: "Greeting")
    builder.services.add("greeter", Greeter.self)
    let host = try! await builder.build()
    try! await host.run()
    assertEqual(ledger.all, "hello disposed")
}

@test
async fn optionsThatDoNotBindStopTheHostBeingBuilt() {
    let builder = ApplicationBuilder()
    builder.container.configure(Greeting.self, section: "HostContainerTests:NoGreeting")
    await expectThrows(saying: "Sable.Configuration.OptionsMonitor<HostContainerTests.Greeting> could not be made: HostContainerTests:NoGreeting:text: missing") { _ = try await builder.build() }
}
