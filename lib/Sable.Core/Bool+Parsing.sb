module Sable.Core

extension Bool: Parsable {
    /// `true` or `false`, as `format` writes them, and nothing else: no other
    /// case, no white space. `.Invalid` at the first scalar that is neither's.
    ///
    /// ```sable
    /// assert(try! Bool.parse("false") == false)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S) throws(ParseError) -> Bool {
        let piece = text.asSubstring
        if piece.isEmpty {
            throw .Empty
        }
        if piece == "true" {
            return true
        }
        if piece == "false" {
            return false
        }
        let word = piece.first == 't' ? "true" : "false"
        var i = 0
        for c in piece {
            if i >= word.count || c != word.at(i) {
                break
            }
            i = i + 1
        }
        throw .Invalid(at: i)
    }
}
