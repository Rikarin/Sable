module ThrowingSequenceTests

// Sequence's algorithms and lazy views over a sequence that throws as it is
// gone through (SYNTAX.md §18, "Throwing iteration"): each rethrows its
// Failure, so what it gives over a generator that does not fail is what it
// gives over an array, and an error part-way is the call's. Run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

union Broken: Error { At(Int) }

/// 1, 2, ... up to n, failing in place of 'failAt' when it is reached.
fn numbers(upTo n: Int, failAt: Int = 0) throws(Broken) -> some Sequence<Int> {
    var i = 1
    while i <= n {
        if i == failAt {
            throw .At(i)
        }
        yield i
        i += 1
    }
}

/// The error a call threw, or none.
fn failure<T>(_ body: () throws(Broken) -> T) -> Int? {
    do {
        let _ = try body()
        return none
    } catch .At(let at) {
        return at
    }
}

@test
fn mapAndFilterGiveWhatTheyGiveOverAnArray() throws {
    assert(try numbers(upTo: 4).map { $0 * 10 } == [10, 20, 30, 40])
    assert(try numbers(upTo: 4).filter { $0 % 2 == 0 } == [2, 4])
    assert(try numbers(upTo: 4).compactMap { $0 > 2 ? $0 : none } == [3, 4])
    assert(try numbers(upTo: 2).flatMap { [$0, $0] } == [1, 1, 2, 2])
}

@test
fn anErrorPartWayIsTheCalls() {
    assertEqual(failure { try numbers(upTo: 5, failAt: 3).map { $0 } }, 3)
    assertEqual(failure { try numbers(upTo: 5, failAt: 2).filter { $0 > 0 } }, 2)
    assertEqual(failure { try numbers(upTo: 5, failAt: 4).reduce(0) { $0 + $1 } }, 4)
    assertEqual(failure { try numbers(upTo: 5, failAt: 1).count(where: { $0 > 0 }) }, 1)
    assertEqual(failure { try numbers(upTo: 5, failAt: 5).sorted() }, 5)
    assertEqual(failure { try numbers(upTo: 5, failAt: 2).toArray() }, 2)
}

@test
fn anAlgorithmThatStopsEarlyNeverReachesTheError() throws {
    assertEqual(try numbers(upTo: 9, failAt: 5).first(where: { $0 == 2 }), 2)
    assert(try numbers(upTo: 9, failAt: 5).contains(where: { $0 == 3 }))
    assert(!(try numbers(upTo: 9, failAt: 5).allSatisfy { $0 > 1 }))
    assert(try numbers(upTo: 9, failAt: 5).prefix(3) == [1, 2, 3])
    assert(try numbers(upTo: 9, failAt: 5).prefix(while: { $0 < 3 }) == [1, 2])
}

@test
fn reductionsAndOrderingRethrow() throws {
    assertEqual(try numbers(upTo: 4).reduce(0) { $0 + $1 }, 10)
    assertEqual(try numbers(upTo: 4).sum(), 10)
    assertEqual(try numbers(upTo: 4).product(), 24)
    assertEqual(try numbers(upTo: 4).max(), 4)
    assertEqual(try numbers(upTo: 4).min(by: { $0 > $1 }), 4)
    assert(try numbers(upTo: 3).sorted(by: { $0 > $1 }) == [3, 2, 1])
    assert(try numbers(upTo: 5).dropFirst(3) == [4, 5])
    assert(try numbers(upTo: 5).suffix(2) == [4, 5])
    assertEqual(try numbers(upTo: 5).chunks(of: 2).count, 3)
    assert(try numbers(upTo: 3).elementsEqual([1, 2, 3]))
    assert(try numbers(upTo: 3).starts(with: [1, 2]))
    assert(try numbers(upTo: 3).contains(2))
}

@test
fn collectingThrowsWhatGoingThroughThrows() throws {
    let all: Int[>..] = try numbers(upTo: 3).collect()
    assert(all == [1, 2, 3])
    let made: Int[>..] = try numbers(upTo: 2).collect()
    assert(made == [1, 2])
    assertEqual(failure {
        let partial: Int[>..] = try numbers(upTo: 3, failAt: 3).collect()
        return partial.count
    }, 3)
    var grown: Int[>..] = [0]
    try grown.append(contentsOf: numbers(upTo: 2))
    assert(grown == [0, 1, 2])
}

@test
fn lazyViewsThrowTheirBasesFailure() throws {
    var seen: Int[>..] = []
    for try n in numbers(upTo: 5).lazy.map({ $0 * 2 }).filter({ $0 > 2 }) {
        seen.append(n)
    }
    assert(seen == [4, 6, 8, 10])
    assertEqual(failure {
        var total = 0
        for try n in numbers(upTo: 5, failAt: 3).lazy.map({ $0 * 2 }) {
            total += n
        }
        return total
    }, 3)
    var pairs = 0
    for try (offset, n) in numbers(upTo: 3).enumerated() {
        pairs += offset * n
    }
    assertEqual(pairs, 8)
    assertEqual(failure {
        var count = 0
        for try _ in zip(numbers(upTo: 5, failAt: 2), [1, 2, 3]) {
            count += 1
        }
        return count
    }, 2)
}

@test
fn whatCannotFailNeedsNoTry() {
    assert([1, 2, 3].map { $0 + 1 } == [2, 3, 4])
    assertEqual((1...4).reduce(0) { $0 + $1 }, 10)
    assert(stride(from: 0, to: 6, by: 2).lazy.map { $0 + 1 }.toArray() == [1, 3, 5])
}
