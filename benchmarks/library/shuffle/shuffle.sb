module ShuffleBench

import Sable.Testing

// An array of a hundred thousand integers shuffled fifty times: its sum.

fn run() -> String {
    var generator = SeededRandomNumberGenerator(seed: 1)
    var values = (0..<100000).toArray()
    for _ in 0..<50 {
        values.shuffle(using: &generator)
    }
    var total = 0
    for i in 0..<100000 {
        total += values[i]
    }
    return "\(total)"
}

@bench
fn measure(_ b: Bencher) {
    b.check(b.iterate { run() })
}
