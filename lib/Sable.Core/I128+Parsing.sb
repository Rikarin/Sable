module Sable.Core

extension I128: Parsable {
    /// The number the text writes in decimal, with a sign if it likes: what
    /// `format` writes with nothing said. `.Overflow` past the greatest I128,
    /// `.Underflow` past the least.
    ///
    /// ```sable
    /// assert(try! I128.parse("-170141183460469231731687303715884105728") == -170141183460469231731687303715884105728)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S) throws(ParseError) -> I128 {
        return try I128.parse(text, radix: 10, styles: .Sign)
    }

    /// The number the text writes in the radix — 2 to 36, with letters of
    /// either case past 9; another traps — with what else the styles allow:
    /// white space, a sign, the radix's prefix, separators.
    ///
    /// ```sable
    /// assert(try! I128.parse("0x7f", radix: 16, styles: .Prefix) == 127)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S, radix: Int, styles: NumberStyles = .Sign) throws(ParseError) -> I128 {
        let (negative, magnitude) = try parseInteger(text.asSubstring, radix, styles)
        return try signedValue(negative, magnitude, 170141183460469231731687303715884105727)
    }
}
