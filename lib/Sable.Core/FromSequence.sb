module Sable.Core

/// A type that can be made from a sequence of its elements, by its
/// initialiser 'init(_:)': what 'collect()' makes, and what 'String(chars)',
/// '[K: V](pairs)' and a collection's 'Set(xs)' call. Swift's
/// 'init<S: Sequence>(_:)'; Rust's FromIterator.
///
/// ```sable
/// let squares: Int[>..] = stride(from: 1, through: 3, by: 1).lazy.map { $0 * $0 }.collect()
/// assert(squares[2] == 9)
/// assert(String(['h', 'i']) == "hi")
/// let ages = [String: Int]([("ada", 36), ("alan", 41)])
/// assert(ages["alan"] == 41)
/// ```
public protocol FromSequence<Element> {
    /// One made of the sequence's elements, in order; what going through
    /// them throws, it throws.
    init<S: Sequence>(_ elements: S) throws(S.Failure) where S.Element == Element
}

extension Sequence {
    /// The elements, made into whatever is wanted of them: an array, a
    /// dictionary of pairs, a string of characters. What going through
    /// them throws, it throws.
    public fn collect<C: FromSequence<Element>>() throws(Failure) -> C {
        return try C(self)
    }
}
