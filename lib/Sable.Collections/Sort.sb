module Sable.Collections

// Sorting as functions, from before every array had 'sort' and 'sorted' as
// members (Sable.Core, Array+Sort.sb): each is the member, a stable merge
// sort, kept for the code written against these.

/// Sorts the values in place, ascending: 'values.sort()'.
public fn sort<T: Comparable>(_ values: inout T[>..]) {
    values.sort()
}

/// Sorts the values in place by 'before', which says whether its first
/// argument goes ahead of its second: 'values.sort(by: before)'.
public fn sort<T>(_ values: inout T[>..], by before: (T, T) -> Bool) {
    values.sort(by: before)
}

/// The values in ascending order: 'values.sorted()'.
public fn sorted<T: Comparable>(_ values: T[>..]) -> T[>..] {
    return values.sorted()
}

/// The values ordered by 'before': 'values.sorted(by: before)'.
public fn sorted<T>(_ values: T[>..], by before: (T, T) -> Bool) -> T[>..] {
    return values.sorted(by: before)
}
