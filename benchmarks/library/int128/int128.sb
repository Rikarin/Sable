module Int128Bench

// I128: five million multiplications, divisions and remainders.

@main
fn main() {
    var x: I128 = 12345678901234567890
    var total: I128 = 0
    for i in 0..<5000000 {
        x = (x * 6364136223846793005 + 1442695040888963407) % 18446744073709551557
        total = (total + x / I128(i + 1)) % 1000000000000000000007
    }
    print("\(x) \(total)")
}
