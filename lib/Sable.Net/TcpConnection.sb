module Sable.Net

/// A TCP connection, or listener, of this machine's, as the system listed
/// it (`NetworkStatistics.tcpConnections`): .NET's `TcpConnectionInformation`.
public struct TcpConnection {
    /// This end.
    public let local: SocketAddress

    /// The other end: any address and port 0 for a listener.
    public let remote: SocketAddress

    /// Where it is in its life.
    public let state: TcpState

    /// The process it is of, where the system says: Windows says each;
    /// Linux and macOS, those of the processes this one may look into
    /// (its user's, or every one to root). None for a connection no
    /// process has any more (TIME_WAIT's).
    public let processId: Int?
}
