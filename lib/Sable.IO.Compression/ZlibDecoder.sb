module Sable.IO.Compression

/// Zlib's format (RFC 1950), deflate and an Adler-32, decompressed as it
/// comes, its checksum checked.
///
/// ```sable
/// let decoder = ZlibDecoder()
/// var bytes = ByteBuffer()
/// let step = try! decoder.decompress(Zlib.compress([1, 2, 3]), into: &bytes)
/// assert(step.status == .Finished && bytes.bytes == [1, 2, 3])
/// ```
public final class ZlibDecoder: Decompressor {
    let stream: InflateStream

    /// Of a stream of any length, with no dictionary.
    public init() {
        stream = InflateStream(format: .Zlib, limits: DecompressionLimits(), dictionary: [])
    }

    /// Decompressing no more than the limits, with the dictionary if the
    /// stream says it was compressed with it.
    public init(limits: DecompressionLimits, dictionary: U8[>..] = []) {
        stream = InflateStream(format: .Zlib, limits: limits, dictionary: dictionary)
    }

    public static var isConcatenable: Bool => false

    public var isFinished: Bool => stream.isFinished

    public fn decompress(_ source: U8[:], into output: inout ByteBuffer, limit: Int) throws(CompressionError) -> CompressionProgress {
        return try stream.step(source, into: &output, limit: limit)
    }
}
