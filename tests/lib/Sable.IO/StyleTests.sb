module StyleTests

// Style, TerminalColor and ColorSupport (Sable.IO), tested with '@test': run
// with
//     tools/stdlib-coverage.sh Sable.IO

import Sable.IO
import Sable.Testing

let esc = "\u{1B}["

@test
fn aPlainStyleWritesNothing() {
    expect(Style().isPlain)
    expect(Style().escape(for: .TrueColor) == "")
    expect(Style().apply(to: "x", for: .TrueColor) == "x")
    expect(!Style().bold().isPlain)
}

@test
fn everyAttributeHasItsCode() {
    let all = Style().bold().dim().italic().underlined().blinking().inverse().hidden().strikethrough()
    expect(all.escape(for: .Monochrome) == "\(esc)1;2;3;4;5;7;8;9m")
    expect(all.isBold && all.isDim && all.isItalic && all.isUnderlined && all.isBlinking && all.isInverse && all.isHidden && all.isStrikethrough)
}

@test
fn coloursAreLeftOutWhereNoneAreShown() {
    let style = Style().foreground(.green).background(.blue)
    expect(style.escape(for: .Monochrome) == "")
    expect(style.escape(for: .None) == "")
    expect(style.escape(for: .Basic) == "\(esc)32;44m")
    expect(style.apply(to: "go", for: .Basic) == "\(esc)32;44mgo\(esc)0m")
    expect(Style.reset == "\(esc)0m")
}

@test
fn brightColoursHaveTheirOwnCodes() {
    expect(Style().foreground(.brightRed).background(.brightWhite).escape(for: .Basic) == "\(esc)91;107m")
}

@test
fn coloursAreMadeTheNearestTheTerminalHas() {
    let orange = TerminalColor.Rgb(red: 255, green: 128, blue: 0)
    expect(orange.nearest(for: .TrueColor) == orange)
    expect(orange.nearest(for: .Extended) == TerminalColor.Indexed(index: 208))
    expect(orange.nearest(for: .Basic) == TerminalColor.yellow)
    expect(TerminalColor.Indexed(index: 196).nearest(for: .Basic) == TerminalColor.brightRed)
    expect(TerminalColor.Indexed(index: 3).nearest(for: .Basic) == TerminalColor.yellow)
    expect(TerminalColor.Indexed(index: 244).nearest(for: .Extended) == TerminalColor.Indexed(index: 244))
    expect(TerminalColor.Indexed(index: 250).nearest(for: .Basic) == TerminalColor.white)
    expect(TerminalColor.Rgb(red: 10, green: 10, blue: 10).nearest(for: .Extended) == TerminalColor.Indexed(index: 232))
    expect(TerminalColor.Rgb(red: 0, green: 0, blue: 0).nearest(for: .Extended) == TerminalColor.Indexed(index: 16))
    expect(TerminalColor.Rgb(red: 250, green: 250, blue: 250).nearest(for: .Extended) == TerminalColor.Indexed(index: 231))
    expect(TerminalColor.Rgb(red: 240, green: 240, blue: 240).nearest(for: .Extended) == TerminalColor.Indexed(index: 255))
}

@test
fn eachColourHasItsParameters() {
    expect(TerminalColor.black.parameters(background: false) == "30")
    expect(TerminalColor.white.parameters(background: true) == "47")
    expect(TerminalColor.brightBlack.parameters(background: false) == "90")
    expect(TerminalColor.Indexed(index: 17).parameters(background: false) == "38;5;17")
    expect(TerminalColor.Rgb(red: 1, green: 2, blue: 3).parameters(background: true) == "48;2;1;2;3")
}

@test
fn theNamedColoursAreTheSixteen() {
    let named: TerminalColor[>..] = [.black, .red, .green, .yellow, .blue, .magenta, .cyan, .white, .brightBlack, .brightRed, .brightGreen, .brightYellow, .brightBlue, .brightMagenta, .brightCyan, .brightWhite]
    for i in 0..<16 {
        expect(named[i] == TerminalColor.Basic(index: i))
    }
}

@test
fn hexColoursAreRead() {
    expect(TerminalColor.hex("#FFa500") == TerminalColor.Rgb(red: 255, green: 165, blue: 0))
    expect(TerminalColor.hex("#12345") == none)
    expect(TerminalColor.hex("012345x") == none)
    expect(TerminalColor.hex("#12345g") == none)
}

// ---- ColorSupport -------------------------------------------------------------------

let supportCases: ([String: String], Bool, ColorSupport)[>..] = [
    ([:], false, .None),
    (["TERM": "xterm-256color"], false, .None),
    (["TERM": "xterm"], true, .Basic),
    (["TERM": "xterm-256color"], true, .Extended),
    (["TERM": "xterm", "COLORTERM": "truecolor"], true, .TrueColor),
    (["TERM": "xterm", "COLORTERM": "24bit"], true, .TrueColor),
    (["TERM": "xterm-direct"], true, .TrueColor),
    (["TERM": "xterm", "WT_SESSION": "1"], true, .TrueColor),
    (["TERM": "dumb"], true, .None),
    (["TERM": "xterm", "NO_COLOR": "1"], true, .Monochrome),
    (["TERM": "xterm", "NO_COLOR": ""], true, .Basic),
    (["TERM": "xterm", "CLICOLOR": "0"], true, .Monochrome),
    (["TERM": "xterm-256color", "CLICOLOR_FORCE": "1"], false, .Extended),
    (["TERM": "dumb", "CLICOLOR_FORCE": "1"], false, .Basic),
    (["TERM": "xterm", "CLICOLOR_FORCE": "0"], false, .None),
    (["TERM": "xterm", "CLICOLOR_FORCE": "1", "NO_COLOR": "1"], false, .Monochrome),
]

@test(arguments: supportCases)
fn colourSupportFollowsTheVariables(_ variables: [String: String], _ isTerminal: Bool, _ expected: ColorSupport) {
    let found = ColorSupport.detect(isTerminal: isTerminal, variables: { variables[$0] })
    expect(found == expected, "\(found:?)")
}

@test
fn onlySomeSupportsHaveColour() {
    expect(!ColorSupport.None.hasColor)
    expect(!ColorSupport.Monochrome.hasColor)
    expect(ColorSupport.Basic.hasColor && ColorSupport.Extended.hasColor && ColorSupport.TrueColor.hasColor)
}

@test
fn aPipeShowsNothing() {
    // The test's output is a pipe; CLICOLOR_FORCE would make it show styles.
    if Runtime.environment("CLICOLOR_FORCE") == none {
        expect(ColorSupport.of(stream: 1) == .None)
        expect(Console.errorColorSupport == .None)
    }
}
