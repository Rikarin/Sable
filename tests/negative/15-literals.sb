module Negative.Literals

fn strayCharacter() -> Int {
    return 1 ¤ 2   //! S0001 unexpected character //! S1002 expected an expression //! S6005
}

fn unterminatedRawString() -> String {
    return #"never closed              //! S0005 unterminated raw string
}

fn badUnicodeEscape() -> String {
    return "\u{zz}"                     //! S0009
}

fn leadingUnderscoreInNumber() -> Int {
    return 0x_1                         //! S0012
}

fn integerOverflow() -> Int {
    return 99999999999999999999999      //! S0014
}

fn badFloat() -> F64 {
    return 1.0e                         //! S0015 not a valid numeric literal
}

fn hexFloatNeedsExponent() -> F64 {
    return 0x1.8                        //! S0016
}

fn emptyEscapedIdentifier() -> Int {
    return ``                           //! S0020 cannot be empty //! S2002 no symbol
}

fn unterminatedInterpolation() -> String {
    return "value: \(1"   //! S0021 unterminated string interpolation //! S0003 unterminated string
}
