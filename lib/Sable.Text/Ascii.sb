module Sable.Text

/// ASCII, bytes below 0x80: checking for it, comparing it without case,
/// and changing its case — what protocols and file formats, whose keywords
/// and headers are ASCII, need, without Unicode's tables. Strings have
/// `isAscii`, `asciiUppercased()` and `String.fromAscii` for the same.
///
/// ```sable
/// let header: U8[>..] = [0x48, 0x6F, 0x53, 0x74]
/// let lower: U8[>..] = [0x68, 0x6F, 0x73, 0x74]
/// assert(Ascii.isValid(header))
/// assert(Ascii.equalsIgnoringCase(header, lower))
/// ```
public struct Ascii {
    private init() { }

    /// Whether every byte is ASCII.
    public static fn isValid(_ bytes: U8[:]) -> Bool {
        var seen: U8 = 0
        for byte in bytes {
            seen = seen | byte
        }
        return seen < 0x80
    }

    /// Whether the bytes are the same but for the case of ASCII letters.
    public static fn equalsIgnoringCase(_ a: U8[:], _ b: U8[:]) -> Bool {
        return a.equalsIgnoringAsciiCase(b)
    }

    /// The bytes with each ASCII lower-case letter made upper case.
    public static fn uppercased(_ bytes: U8[:]) -> U8[>..] {
        var result = bytes.toArray()
        result.shiftAsciiLetters(from: 0x61, by: 0xE0)
        return result
    }

    /// The bytes with each ASCII upper-case letter made lower case.
    public static fn lowercased(_ bytes: U8[:]) -> U8[>..] {
        var result = bytes.toArray()
        result.shiftAsciiLetters(from: 0x41, by: 0x20)
        return result
    }
}
