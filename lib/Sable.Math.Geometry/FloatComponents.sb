module Sable.Math.Geometry

/// A value that is so many `F32`s one after another and nothing else, so that
/// an array of them is an array of `F32`s: the vectors, the matrices, the
/// quaternion and the plane of this module, in C's layout, aligned to 4. A
/// type of the program's own may conform if it is laid out so; its size is
/// checked where a view is made.
///
/// ```sable
/// assert(Matrix4x4.componentCount == 16)
/// assert(Vector3(1, 2, 3).toArray() == [1, 2, 3])
/// ```
public protocol FloatComponents {
    /// How many `F32`s a value is.
    static var componentCount: Int { get }
}

extension Vector2: FloatComponents { }
extension Vector3: FloatComponents { }
extension Vector4: FloatComponents { }
extension Quaternion: FloatComponents { }
extension Plane: FloatComponents { }
extension Matrix3x2: FloatComponents { }
extension Matrix3x3: FloatComponents { }
extension Matrix4x4: FloatComponents { }

/// Traps unless the type is as large as its components.
fn checkLayout<T: FloatComponents>(_ type: T.Type) {
    if MemoryLayout<T>.stride != T.componentCount * 4 {
        preconditionFailure("a FloatComponents type of \(T.componentCount) components that takes \(MemoryLayout<T>.stride) bytes")
    }
}

extension<Element: FloatComponents> Element[:] {
    /// The elements' components where they lie, as one run of `F32`s, for as
    /// long as 'body' runs, to be read and not written: nothing is copied.
    ///
    /// ```sable
    /// let points = [Vector2(1, 2), Vector2(3, 4)]
    /// assert(points.withComponents { $0.toArray() } == [1, 2, 3, 4])
    /// ```
    public fn withComponents<R, E: Error>(_ body: (UnsafeBuffer<F32>) throws(E) -> R) throws(E) -> R {
        checkLayout(Element.self)
        let total = self.count * Element.componentCount
        return try self.withPointer { (start: RawPtr<Element>) throws(E) -> R in
            unsafe {
                return try body(UnsafeBuffer<F32>.viewing(start.cast(to: F32.self), count: total))
            }
        }
    }

    /// The elements' bytes where they lie, for as long as 'body' runs, to be
    /// read and not written: what a buffer of the GPU's is filled from.
    ///
    /// ```sable
    /// assert([Vector3.zero, Vector3.one].withBytes { $0.count } == 24)
    /// ```
    public fn withBytes<R, E: Error>(_ body: (UnsafeBuffer<U8>) throws(E) -> R) throws(E) -> R {
        checkLayout(Element.self)
        let total = self.count * Element.componentCount * 4
        return try self.withPointer { (start: RawPtr<Element>) throws(E) -> R in
            unsafe {
                return try body(UnsafeBuffer<U8>.viewing(start.cast(to: U8.self), count: total))
            }
        }
    }

    /// The elements' components where they lie, to be read and written there
    /// for as long as 'body' runs.
    ///
    /// ```sable
    /// var points = [Vector2(1, 2), Vector2(3, 4)]
    /// points.withMutableComponents { all in
    ///     var view = all
    ///     view[2] = 30
    /// }
    /// assert(points[1] == Vector2(30, 4))
    /// ```
    public mutating fn withMutableComponents<R, E: Error>(_ body: (UnsafeBuffer<F32>) throws(E) -> R) throws(E) -> R {
        checkLayout(Element.self)
        let total = self.count * Element.componentCount
        return try self.withMutablePointer { (start: RawPtr<Element>) throws(E) -> R in
            unsafe {
                return try body(UnsafeBuffer<F32>.viewing(start.cast(to: F32.self), count: total))
            }
        }
    }
}

extension FloatComponents {
    /// The value's components, in an array of their own.
    public fn toArray() -> F32[>..] {
        return [self].withComponents { $0.toArray() }
    }
}
