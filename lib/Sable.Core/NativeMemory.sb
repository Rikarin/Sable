module Sable.Core

/// Memory by the byte, from the system: .NET's NativeMemory, C's
/// 'aligned_alloc' and 'free'. Every member is 'unsafe': nothing frees what
/// is allocated but 'deallocate', and nothing checks that what is freed was
/// allocated, or is not used after.
///
/// ```sable
/// unsafe {
///     let bytes = NativeMemory.allocate(byteCount: 16, alignment: 16, zeroed: true)
///     defer { NativeMemory.deallocate(bytes) }
///     assert(bytes.address % 16 == 0)
///     assert(bytes.load(at: 15) == 0)
/// }
/// ```
public struct NativeMemory {
    /// Room for 'byteCount' bytes at an address that is a multiple of
    /// 'alignment', a power of two; its bytes zero when 'zeroed', otherwise
    /// as they come. Traps when there is no room.
    public unsafe static fn allocate(byteCount: Int, alignment: Int = 16, zeroed: Bool = false) -> RawPtr<U8> {
        let address = RawMemory.allocate(byteCount, alignment)
        if zeroed {
            RawMemory.fill(address, 0, byteCount)
        }
        return RawPtr<U8>(address: address)
    }

    /// The room 'allocate' gave, given back. Freeing null does nothing.
    public unsafe static fn deallocate<T>(_ pointer: RawPtr<T>) {
        RawMemory.free(pointer.address)
    }

    /// 'byteCount' bytes copied from 'source' to 'target', as their bits:
    /// C's 'memmove', so the runs may overlap.
    public unsafe static fn copy<T, U>(from source: RawPtr<T>, to target: RawPtr<U>, byteCount: Int) {
        precondition(byteCount >= 0, "copying \(byteCount) bytes")
        RawMemory.copy(to: target.address, from: source.address, byteCount)
    }

    /// The bytes copied to 'target' on, where there is room for them.
    ///
    /// ```sable
    /// unsafe {
    ///     let memory = NativeMemory.allocate(byteCount: 4)
    ///     defer { NativeMemory.deallocate(memory) }
    ///     NativeMemory.copy(from: [1, 2, 3, 4], to: memory)
    ///     assert(memory.load(at: 2) == 3)
    /// }
    /// ```
    public unsafe static fn copy(from bytes: U8[:], to target: RawPtr<U8>) {
        RawMemory.store(target.address, bytes)
    }

    /// 'byteCount' bytes from 'source' on, copied over the slice's from an
    /// offset on, all of which must be in it.
    ///
    /// ```sable
    /// unsafe {
    ///     let memory = NativeMemory.allocate(byteCount: 4, zeroed: true)
    ///     defer { NativeMemory.deallocate(memory) }
    ///     var bytes: U8[>..] = [7, 7, 7, 7, 7]
    ///     NativeMemory.copy(from: memory, to: &bytes, at: 1, byteCount: 4)
    ///     assert(bytes == [7, 0, 0, 0, 0])
    /// }
    /// ```
    public unsafe static fn copy(from source: RawPtr<U8>, to bytes: inout U8[:], at offset: Int, byteCount: Int) {
        let count = bytes.count
        precondition(byteCount >= 0 && offset >= 0 && offset <= count - byteCount, "\(byteCount) bytes from \(offset) of \(count)")
        bytes.fill(from: offset, raw: source.address, byteCount)
    }

    /// 'byteCount' bytes from 'source' on added at the end of the bytes.
    ///
    /// ```sable
    /// unsafe {
    ///     let memory = NativeMemory.allocate(byteCount: 4, zeroed: true)
    ///     defer { NativeMemory.deallocate(memory) }
    ///     var bytes: U8[>..] = [7]
    ///     NativeMemory.append(from: memory, byteCount: 2, to: &bytes)
    ///     assert(bytes == [7, 0, 0])
    /// }
    /// ```
    public unsafe static fn append(from source: RawPtr<U8>, byteCount: Int, to bytes: inout U8[>..]) {
        bytes.append(raw: source.address, byteCount)
    }

    /// 'byteCount' bytes from 'target' on, each set to the byte: C's 'memset'.
    public unsafe static fn fill<T>(_ target: RawPtr<T>, with byte: U8, byteCount: Int) {
        precondition(byteCount >= 0, "filling \(byteCount) bytes")
        RawMemory.fill(target.address, byte, byteCount)
    }
}

extension U8[:] {
    @builtin("bytes_from_raw")
    unsafe mutating fn fill(from offset: Int, raw address: Int, _ byteCount: Int)
}

extension U8[>..] {
    @builtin("array_append_raw")
    unsafe mutating fn append(raw address: Int, _ byteCount: Int)
}
