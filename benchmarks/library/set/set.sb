module SetBench

import Sable.Collections

// Set<Int>: two sets of 300,000 pseudo-random numbers, their union,
// intersection and difference, then every member looked up.

@main
fn main() {
    var a = Set<Int>()
    var b = Set<Int>()
    var x = 12345
    for _ in 0..<300000 {
        x = (x * 1103515245 + 12345) % 2147483648
        a.insert(x / 7 % 500000)
        x = (x * 1103515245 + 12345) % 2147483648
        b.insert(x / 7 % 500000)
    }

    let both = a.union(b)
    let common = a.intersection(b)
    let only = a.subtracting(b)
    var hits = 0
    for i in 0..<500000 {
        if both.contains(i) { hits += 1 }
        if common.contains(i) { hits += 1 }
        if only.contains(i) { hits += 1 }
    }
    print("\(a.count) \(b.count) \(both.count) \(common.count) \(only.count) \(hits)")
}
