module TrustStoreTests

// TrustStore (Sable.Crypto.X509): the system's, files' and one's own. Run with
// tools/stdlib-coverage.sh Sable.Crypto.X509.

import X509Support
import Sable.Crypto
import Sable.Crypto.X509
import Sable.IO
import Sable.Testing

@test
fn aBundleIsReadButForWhatIsNoCertificate() {
    let store = try! TrustStore.parse(bundle: "# a note\n" + rootPem + "\n-----BEGIN CERTIFICATE-----\nAQID\n-----END CERTIFICATE-----\n" + edPem + "\n-----BEGIN OTHER-----\nAQID\n-----END OTHER-----\n")
    assertEqual(store.certificates.count, 2)
    expect(store.contains(try! Certificate.parse(pem: rootPem)) && store.contains(try! Certificate.parse(pem: edPem)))
    expectThrows { _ = try TrustStore.parse(bundle: "-----BEGIN CERTIFICATE-----\n") }
    let key = EcdsaPrivateKey<P256>.generate().anyKey
    let other = try! CertificateBuilder(subject: store.certificates[0].subject).selfSigned(with: key)
    expect(!store.contains(other))
    expect(TrustStore([]).certificates.isEmpty)
}

// The environment's is the process's, so one test has both.
@test
fn theSystemsIsReadOrTheOneTheEnvironmentNames() throws {
    let directory = try Temp.directory()
    let file = "\(directory.path)/roots.pem"
    try File.write(file, rootPem)
    try File.write("\(directory.path)/more.pem", edPem + "\n" + rootPem)
    try File.write("\(directory.path)/note.txt", "nothing")
    unsafe {
        Environment.set("SSL_CERT_FILE", file)
        assertEqual(TrustStore.system().certificates.count, 1)
        Environment.set("SSL_CERT_FILE", "\(directory.path)/none")
        assertEqual(TrustStore.system().certificates.count, 0)
        Environment.remove("SSL_CERT_FILE")
        Environment.set("SSL_CERT_DIR", "\(directory.path)")
        assertEqual(TrustStore.system().certificates.count, 2)
        Environment.set("SSL_CERT_DIR", "\(directory.path)/none")
        assertEqual(TrustStore.system().certificates.count, 0)
        Environment.remove("SSL_CERT_DIR")
    }
    // A machine may have none, as a container does.
    for certificate in TrustStore.system().certificates {
        expect(certificate.der.count > 0)
    }
}
