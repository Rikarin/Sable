module Sable.Serialize

import Sable.Math.Geometry

// Sable.Math.Geometry's values: each a struct of its fields by name, as
// '@derive(Serializable)' would write it. They are here, as Sable.Time's are,
// so that a program of vectors that serialises nothing has none of this module.

extension Vector2: Serializable {
    /// A struct of `x`, `y`.
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        try encoder.beginStruct("Vector2", count: 2)
        try encoder.encodeField("x")
        try x.encode(to: encoder)
        try encoder.encodeField("y")
        try y.encode(to: encoder)
        try encoder.endStruct()
    }
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Vector2 {
        try decoder.beginStruct("Vector2")
        let x = try F32.decode(from: decoder.field("x"))
        let y = try F32.decode(from: decoder.field("y"))
        return Vector2(x, y)
    }
}

