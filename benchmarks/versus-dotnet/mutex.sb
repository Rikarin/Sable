module Mutex

import Sable.Concurrency

// Mutex<Int> against .NET 11's Lock: four tasks on the pool, each taking
// the lock a quarter of a million times to add one to a shared count — the
// lock contended throughout. ../dotnet/Program.cs does the same with four
// threads and 'lock', and prints the same line.

@main
fn main() async {
    let count = Mutex<Int>(0)
    await withTaskGroup(of: Int.self) { group in
        var task = 0
        while task < 4 {
            group.spawn {
                var i = 0
                while i < 250000 {
                    count.withLock { $0 += 1 }
                    i = i + 1
                }
                return 0
            }
            task = task + 1
        }
        await group.waitForAll()
    }
    print("\(count.withLock { $0 })")
}
