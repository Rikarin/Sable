module SplitMix64Tests

// SplitMix64 (Sable.Core), pinned to the published outputs of Vigna's
// splitmix64.c.

import Sable.Testing
import CoreTestSupport

@test
fn aSeedGivesTheReferenceSequence() {
    var generator = SplitMix64(seed: 1234567)
    expect(draws(5, from: &generator) == [6457827717110365317, 3203168211198807973, 9817491932198370423, 4593380528125082431, 16408922859458223821])
}

@test
fn zeroIsASeedAsGoodAsAnother() {
    var generator = SplitMix64(seed: 0)
    expect(draws(3, from: &generator) == [16294208416658607535, 7960286522194355700, 487617019471545679])
}
