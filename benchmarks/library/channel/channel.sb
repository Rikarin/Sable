module ChannelBench

import Sable.Concurrency
import Sable.Testing

// Channel<Int>: one task sends half a million numbers, another receives them.

fn run() async -> String {
    let channel = Channel<Int>()
    let producer = Task.spawn {
        for i in 0..<500000 {
            await channel.send(i)
        }
        await channel.close()
    }
    var total = 0
    while let value = await channel.receive() {
        total += value
    }
    await producer.value
    return "\(total)"
}

@bench
fn measure(_ b: Bencher) async {
    b.check(await b.iterateAsync { await run() })
}
