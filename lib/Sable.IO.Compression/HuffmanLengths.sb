module Sable.IO.Compression

/// How many bits each symbol's code has, a byte each, in a Huffman code for
/// symbols as frequent as given, a U32 each, that is no longer than 'limit'.
/// A code has two symbols at least: where fewer are used, the first ones that
/// are not are given codes too. 'work' has room for 4 bytes a symbol and 128
/// more. The sum of the frequencies is below 2^22, and there are at most 1024
/// symbols. How many symbols are used is given back.
unsafe fn huffmanLengths(_ frequencies: Int, count: Int, limit: Int, lengths: Int, work: Int) -> Int {
    fillBytes(lengths, with: 0, count)
    // Each used symbol under its frequency.
    let nodes = work &+ 128
    var used = 0
    var i = 0
    while i < count {
        let frequency = load32(frequencies &+ 4 &* i)
        if frequency != 0 {
            store32(frequency << 10 | (i unchecked as U32), nodes &+ 4 &* used)
            used = used &+ 1
        }
        i = i &+ 1
    }
    if used < 2 {
        if used == 1 {
            let symbol = (load32(nodes) & 1023) unchecked as Int
            store8(1, lengths &+ symbol)
            store8(1, lengths &+ (symbol == 0 ? 1 : 0))
        } else {
            store8(1, lengths)
            store8(1, lengths &+ 1)
        }
        return used
    }
    sortWords(nodes, used)

    // The tree, in place (Moffat and Katajainen's way): an inner node's
    // frequency over the leaf's symbol that was there, then its parent.
    let symbols: U32 = 1023
    var leaf = 0
    var inner = 0
    var made = 0
    while used &- made > 1 {
        var sum: U32 = 0
        let hasLeaf = leaf < used
        if leaf &+ 1 < used && (inner == made || (load32(nodes &+ 4 &* (leaf &+ 1)) & ~symbols) <= (load32(nodes &+ 4 &* inner) & ~symbols)) {
            sum = (load32(nodes &+ 4 &* leaf) & ~symbols) &+ (load32(nodes &+ 4 &* (leaf &+ 1)) & ~symbols)
            leaf = leaf &+ 2
        } else if inner &+ 2 <= made && (!hasLeaf || (load32(nodes &+ 4 &* (inner &+ 1)) & ~symbols) < (load32(nodes &+ 4 &* leaf) & ~symbols)) {
            let first = load32(nodes &+ 4 &* inner)
            let second = load32(nodes &+ 4 &* (inner &+ 1))
            sum = (first & ~symbols) &+ (second & ~symbols)
            store32((first & symbols) | (made unchecked as U32) << 10, nodes &+ 4 &* inner)
            store32((second & symbols) | (made unchecked as U32) << 10, nodes &+ 4 &* (inner &+ 1))
            inner = inner &+ 2
        } else {
            let first = load32(nodes &+ 4 &* inner)
            sum = (load32(nodes &+ 4 &* leaf) & ~symbols) &+ (first & ~symbols)
            store32((first & symbols) | (made unchecked as U32) << 10, nodes &+ 4 &* inner)
            leaf = leaf &+ 1
            inner = inner &+ 1
        }
        store32(sum | (load32(nodes &+ 4 &* made) & symbols), nodes &+ 4 &* made)
        made = made &+ 1
    }

    // How many codes there are of each length: from the root, each inner node
    // a leaf of its depth made two of the next; one too deep splits the
    // deepest leaf that may be.
    let counts = work
    i = 0
    while i < 32 {
        store32(0, counts &+ 4 &* i)
        i = i &+ 1
    }
    store32(2, counts &+ 4)
    let root = used &- 2
    store32(load32(nodes &+ 4 &* root) & symbols, nodes &+ 4 &* root)
    var node = root &- 1
    while node >= 0 {
        let entry = load32(nodes &+ 4 &* node)
        let parent = (entry >> 10) unchecked as Int
        var depth = (load32(nodes &+ 4 &* parent) >> 10) unchecked as Int &+ 1
        store32((entry & symbols) | (depth unchecked as U32) << 10, nodes &+ 4 &* node)
        if depth >= limit {
            depth = limit &- 1
            while load32(counts &+ 4 &* depth) == 0 {
                depth = depth &- 1
            }
        }
        store32(load32(counts &+ 4 &* depth) &- 1, counts &+ 4 &* depth)
        store32(load32(counts &+ 4 &* (depth &+ 1)) &+ 2, counts &+ 4 &* (depth &+ 1))
        node = node &- 1
    }

    // The least frequent have the longest.
    i = 0
    var length = limit
    while length > 0 {
        var these = load32(counts &+ 4 &* length)
        while these > 0 {
            store8(length, lengths &+ ((load32(nodes &+ 4 &* i) & symbols) unchecked as Int))
            i = i &+ 1
            these = these &- 1
        }
        length = length &- 1
    }
    return used
}

/// So many words sorted, the least first: Shell's sort.
unsafe fn sortWords(_ words: Int, _ count: Int) {
    var gap = 301
    while gap > 0 {
        var i = gap
        while i < count {
            let word = load32(words &+ 4 &* i)
            var j = i
            while j >= gap && load32(words &+ 4 &* (j &- gap)) > word {
                store32(load32(words &+ 4 &* (j &- gap)), words &+ 4 &* j)
                j = j &- gap
            }
            store32(word, words &+ 4 &* j)
            i = i &+ 1
        }
        gap = gap == 301 ? 132 : (gap == 132 ? 57 : (gap == 57 ? 23 : (gap == 23 ? 10 : (gap == 10 ? 4 : (gap == 4 ? 1 : 0)))))
    }
}

/// The codes of symbols whose lengths are given, in canonical order, their
/// bits reversed as they are written least significant first: in a U32 each,
/// the code with its length at bit 24.
unsafe fn huffmanCodes(lengths: Int, count: Int, codes: Int, work: Int) {
    var i = 0
    while i < 16 {
        store32(0, work &+ 4 &* i)
        i = i &+ 1
    }
    i = 0
    while i < count {
        let at = work &+ 4 &* load8(lengths &+ i)
        store32(load32(at) &+ 1, at)
        i = i &+ 1
    }
    // Where each length's codes start.
    store32(0, work)
    var code: U32 = 0
    var before: U32 = 0
    i = 1
    while i < 16 {
        code = (code &+ before) << 1
        before = load32(work &+ 4 &* i)
        store32(code, work &+ 4 &* i)
        i = i &+ 1
    }
    i = 0
    while i < count {
        let length = load8(lengths &+ i)
        if length == 0 {
            store32(0, codes &+ 4 &* i)
        } else {
            let at = work &+ 4 &* length
            let next = load32(at)
            store32(next &+ 1, at)
            let reversed = next.bitReversed >> (((32 &- length) & 31) unchecked as U32)
            store32(reversed | (length unchecked as U32) << 24, codes &+ 4 &* i)
        }
        i = i &+ 1
    }
}
