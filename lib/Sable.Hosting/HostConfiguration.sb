module Sable.Hosting

/// What the host and its services are configured by: text by key, the parts
/// of a key parted by ':' ("Database:Url"). The seam a configuration
/// library plugs into; `EnvironmentConfiguration` is the one there is.
///
/// ```sable
/// struct Fixed: HostConfiguration {
///     fn value(_ key: String) -> String? => key == "Http:Port" ? "8080" : none
/// }
/// let builder = ApplicationBuilder()
/// builder.configuration = Fixed()
/// assert(builder.configuration.value("Http:Port") == "8080")
/// ```
public protocol HostConfiguration: Sendable {
    /// The key's value, when it has one.
    fn value(_ key: String) -> String?

    /// Reads again what may have changed: a SIGHUP's doing. By default, nothing.
    fn reload() async throws
}

extension HostConfiguration {
    public fn reload() async throws { }
}
