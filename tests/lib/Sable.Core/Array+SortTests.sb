module ArraySortTests

// Sorting an array (Sable.Core, Array+Sort.sb), tested with '@test': run
// with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

/// 'count' pseudo-random values below 'bound', the same each time.
fn scrambled(_ count: Int, _ bound: Int) -> Int[>..] {
    var values: Int[>..] = []
    var x = 42
    var i = 0
    while i < count {
        x = (x * 1103515245 + 12345) % 2147483648
        values.append(x % bound)
        i = i + 1
    }
    return values
}

@test
fn sortOrdersASmallArrayInPlace() {
    var values: Int[>..] = [5, 3, 9, 1, 4, 1]
    values.sort()
    expect(values == [1, 1, 3, 4, 5, 9])
}

@test
fn sortOrdersALargeArrayInPlace() {
    var values = scrambled(1000, 500)
    values.sort()
    assertEqual(values.count, 1000)
    expect(values.isSorted())
}

// 40 elements: runs of 16, then merges of width 16 and 32, two passes;
// 20 elements: one pass, which leaves the result in the scratch.
@test(arguments: [20, 40])
fn sortOfAnOddNumberOfPassesEndsInTheArray(_ count: Int) {
    var values = scrambled(count, 100)
    values.sort()
    expect(values.isSorted())
}

@test
fn sortOfAnAlreadySortedArrayKeepsIt() {
    var values: Int[>..] = []
    var i = 0
    while i < 100 {
        values.append(i)
        i = i + 1
    }
    values.sort()
    assertEqual(values[0], 0)
    assertEqual(values[99], 99)
    expect(values.isSorted())
}

@test
fn sortOfNothingOrOneChangesNothing() {
    var empty: Int[>..] = []
    empty.sort()
    assertEqual(empty.count, 0)
    var one: String[>..] = ["x"]
    one.sort()
    expect(one == ["x"])
}

@test
fn sortByIsStable() {
    // Ordered by tens only: within each ten, the order they came in.
    var values = scrambled(300, 100000)
    var tagged: Int[>..] = []
    var i = 0
    while i < values.count {
        tagged.append((values[i] % 10) * 1000 + i)
        i = i + 1
    }
    tagged.sort(by: (a: Int, b: Int) => a / 1000 < b / 1000)
    i = 1
    while i < tagged.count {
        let sameTen = tagged[i] / 1000 == tagged[i - 1] / 1000
        expect(tagged[i] / 1000 >= tagged[i - 1] / 1000)
        expect(!sameTen || tagged[i] > tagged[i - 1])
        i = i + 1
    }
}

@test
fn sortWorksOnEveryKindOfArray() {
    var fixed: Int[] = [3, 1, 2]
    fixed.sort()
    expect(fixed == [1, 2, 3])
    var shrink: String[>..<] = ["b", "c", "a"]
    shrink.sort()
    expect(shrink == ["a", "b", "c"])
}

@test
fn sortedLeavesTheArrayAsItWas() {
    let words: String[>..] = ["pear", "fig", "banana"]
    expect(words.sorted() == ["banana", "fig", "pear"])
    expect(words.sorted(by: (a: String, b: String) => a.count < b.count) == ["fig", "pear", "banana"])
    expect(words == ["pear", "fig", "banana"])
}

@test
fn sortedOfASliceSortsItsRun() {
    let values: Int[>..] = [9, 4, 7, 1, 8]
    expect(values[1..<4].sorted() == [1, 4, 7])
}

@bench
fn sortAThousand() {
    var values = scrambled(1000, 1000000)
    values.sort()
}

// Every size to 40, and some past it.
fn shapeSizes() -> Int[>..] {
    var sizes = (0..<40).toArray()
    sizes.append(contentsOf: stride(from: 40, to: 600, by: 37))
    return sizes
}

@test(arguments: shapeSizes())
fn sortUnstableAgreesWithSortOnManyShapes(_ size: Int) {
    // Random, few distinct values, sorted, reversed, all equal, and
    // an organ pipe: what defeats a quicksort's pivot.
    let up = (0..<size).toArray()
    let shapes: Int[>..][>..] = [
        scrambled(size, 1000000), scrambled(size, 3), up, up.map { size - $0 },
        Int[>..](repeating: 7, count: size), up.map { $0 < size / 2 ? $0 : size - $0 }
    ]
    for shape in shapes {
        var unstable = shape
        unstable.sortUnstable()
        expect(unstable == shape.sorted())
        var descending = shape
        descending.sortUnstable(by: (a: Int, b: Int) => a > b)
        expect(descending == shape.sorted(by: { $0 > $1 }))
    }
}

@test
fn sortUnstableByExample() {
    var xs: Int[>..] = [9, 5, 3, 7, 1, 0]
    xs.sortUnstable()
    expect(xs == [0, 1, 3, 5, 7, 9])
    var words: String[>..] = ["pear", "fig", "kiwi", "banana"]
    words.sortUnstable(by: (a: String, b: String) => a.count < b.count)
    assertEqual(words[0], "fig")
    assertEqual(words[3], "banana")
}

@test
fn byteArraysSearchTheirOwnWay() {
    var bytes: U8[>..] = []
    var i = 0
    while i < 5000 {
        bytes.append(U8.truncating(i % 251))
        i = i + 1
    }
    expect(bytes.contains(element: 250) && !bytes[0..<100].contains(element: 250))
    assertEqual(bytes.firstIndex(of: 250) ?? -1, 250)
    assertEqual(bytes[300...].firstIndex(of: 0) ?? -1, 202)
    assertEqual(bytes.count(of: 7), 20)
    assertEqual(bytes[0..<0].count(of: 7), 0)
    assertEqual(bytes.firstIndex(ofAny: [200, 100]) ?? -1, 100)
    assertEqual(bytes.firstIndex(ofAny: [3]) ?? -1, 3)
    expect(bytes.firstIndex(ofAny: []) == none)
    expect(bytes[0..<10].firstIndex(of: 99) == none)
    expect(bytes[0..<10].firstIndex(ofAny: [99, 98]) == none)
}

@test
fn sortOfARangeOrdersThoseElementsInTheArray() {
    var values: Int[>..] = [9, 5, 3, 7, 1, 0]
    values[1..<5].sort()
    expect(values == [9, 1, 3, 5, 7, 0])
    values[^3...].sortUnstable()
    expect(values == [9, 1, 3, 0, 5, 7])
}

@test
fn sortOfARangeOfAFixedArrayOrdersThoseElements() {
    var values: Int[] = [4, 3, 2, 1]
    values[..<^1].sort()
    expect(values == [2, 3, 4, 1])
}

// Equal keys keep the order they came in, whatever the array and its length.
@test
fn aSortByAKeyOfAnyArrayIsStable() {
    forAll(Gen.number(in: 0...9).array(count: 0...200)) { (keys: Int[>..]) in
        var tagged: (Int, Int)[>..] = []
        for (place, key) in keys.enumerated() {
            tagged.append((key, place))
        }
        tagged.sort(by: (a: (Int, Int), b: (Int, Int)) => a.0 < b.0)
        for pair in tagged.windows(of: 2) {
            expect(pair[0].0 < pair[1].0 || pair[0].0 == pair[1].0 && pair[0].1 < pair[1].1)
        }
        expect(tagged.count == keys.count)
    }
}

// Any array sorted is in order, and what it was: each value as often.
@test
fn anArraySortedIsItselfInOrder() {
    fn counts(_ values: I16[>..]) -> [I16: Int] {
        var counts: [I16: Int] = [:]
        for value in values {
            counts[value] = (counts[value] ?? 0) + 1
        }
        return counts
    }
    forAll(Gen.arbitrary(I16.self).array(count: 0...200)) { (values: I16[>..]) in
        var sorted = values
        sorted.sort()
        var unstable = values
        unstable.sortUnstable()
        require(sorted.isSorted())
        expect(unstable == sorted)
        let before = counts(values)
        for (value, count) in counts(sorted) {
            expect(before[value] == count)
        }
        expect(sorted.count == values.count)
    }
}
