module OrderedDictionaryTests

// OrderedDictionary (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn anEmptyDictionaryHasNoKeys() {
    let dictionary = OrderedDictionary<String, Int>()
    assertEqual(dictionary.count, 0)
    assert(dictionary.isEmpty)
    assert(dictionary.get("a") == none)
    assert(!dictionary.contains("a"))
    assert(dictionary.index(of: "a") == none)
    assert(dictionary.remove("a") == none)
}

@test
fn keysKeepTheOrderTheyWereAdded() {
    let dictionary = OrderedDictionary<String, Int>()
    dictionary.set("zebra", 1)
    dictionary.set("apple", 2)
    dictionary.set("mango", 3)
    assertEqual(dictionary.count, 3)
    assert(!dictionary.isEmpty)
    assert(dictionary.map({ entry in entry.0 }) == ["zebra", "apple", "mango"])
    assert(dictionary.map({ entry in entry.1 }) == [1, 2, 3])
}

@test
fn settingAKeyAgainKeepsItsPlace() {
    let dictionary = OrderedDictionary<String, Int>()
    dictionary.set("a", 1)
    dictionary.set("b", 2)
    dictionary.set("a", 10)
    assertEqual(dictionary.count, 2)
    assertEqual(dictionary.get("a") ?? 0, 10)
    assertEqual(dictionary.index(of: "a") ?? -1, 0)
    assert(dictionary.map({ entry in entry.1 }) == [10, 2])
}

@test
fn keysAndValuesCanBeReadByPosition() {
    let dictionary = OrderedDictionary<Int, String>()
    dictionary.set(30, "thirty")
    dictionary.set(10, "ten")
    assertEqual(dictionary.key(at: 1), 10)
    assertEqual(dictionary.value(at: 0), "thirty")
    assertEqual(dictionary.index(of: 10) ?? -1, 1)
    assert(dictionary.contains(30))
}

@test(traps: "array index out of range")
fn aPositionPastTheEndTraps() {
    let dictionary = OrderedDictionary<Int, Int>()
    dictionary.set(1, 1)
    _ = dictionary.key(at: 1)
}

@test
fn removingAKeyClosesUpTheOrder() {
    let dictionary = OrderedDictionary<String, Int>()
    dictionary.set("a", 1)
    dictionary.set("b", 2)
    dictionary.set("c", 3)
    dictionary.set("d", 4)
    assertEqual(dictionary.remove("b") ?? 0, 2)
    assert(dictionary.map({ entry in entry.0 }) == ["a", "c", "d"])
    assertEqual(dictionary.index(of: "c") ?? -1, 1)
    assertEqual(dictionary.index(of: "d") ?? -1, 2)
    assertEqual(dictionary.get("d") ?? 0, 4)
    assert(dictionary.remove("b") == none)
    assertEqual(dictionary.remove("d") ?? 0, 4)
    assert(dictionary.map({ entry in entry.0 }) == ["a", "c"])
}

@test
fn aRemovedKeyAddedAgainGoesAtTheEnd() {
    let dictionary = OrderedDictionary<String, Int>()
    dictionary.set("a", 1)
    dictionary.set("b", 2)
    _ = dictionary.remove("a")
    dictionary.set("a", 3)
    assert(dictionary.map({ entry in entry.0 }) == ["b", "a"])
    assert(dictionary.map({ entry in entry.1 }) == [2, 3])
}

@test
fn removeAllEmptiesTheDictionary() {
    let dictionary = OrderedDictionary<String, Int>()
    dictionary.set("a", 1)
    dictionary.set("b", 2)
    dictionary.removeAll()
    assertEqual(dictionary.count, 0)
    assert(!dictionary.contains("a"))
    dictionary.set("c", 3)
    assertEqual(dictionary.index(of: "c") ?? -1, 0)
}

@test
fn manyKeysStayInOrder() {
    let dictionary = OrderedDictionary<Int, Int>()
    var i = 0
    while i < 200 {
        dictionary.set(i * 7 % 200, i)
        i = i + 1
    }
    assertEqual(dictionary.count, 200)
    assertEqual(dictionary.key(at: 0), 0)
    assertEqual(dictionary.key(at: 1), 7)
    assertEqual(dictionary.get(14) ?? -1, 2)
}

@test
fn anOrderedDictionaryIsGoneThroughInOrder() {
    let ages = OrderedDictionary<String, Int>()
    ages.set("b", 2)
    ages.set("a", 1)
    var seen: String[>..] = []
    for (key, value) in ages {
        seen.append("\(key)=\(value)")
    }
    assertEqualText(seen.joined(separator: ","), "b=2,a=1")
}

@test
fn anOrderedDictionaryIsACollectionOfItsEntriesByPosition() {
    let ages = OrderedDictionary<String, Int>()
    ages.set("ann", 31)
    ages.set("bo", 42)
    ages.set("cy", 7)
    assertEqual(ages[0].0, "ann")
    assertEqual(ages[2].1, 7)
    assertEqual(ages.distance(from: ages.startIndex, to: ages.endIndex), 3)
    assertEqual(ages.index(ages.startIndex, offsetBy: 2), 2)
    assertEqual(ages.firstIndex(where: { $0.1 > 40 }) ?? -1, 1)
    assertEqual(ages.last?.0 ?? "", "cy")
    assert(ages.reversed().map({ $0.0 }).toArray() == ["cy", "bo", "ann"])
    assertEqual(ages.index(before: ages.index(after: 0)), 0)
}

@test
fn anOrderedDictionaryIsReadFromTheEndInItsOrder() {
    let ordered = OrderedDictionary<String, Int>()
    ordered.set("a", 1)
    ordered.set("b", 2)
    let last = ordered[^1]
    assertEqual(last.0, "b")
    assertEqual(last.1, 2)
}

@test
fn anOrderedDictionaryIsMadeFromAnySequenceOfPairs() {
    let ordered = OrderedDictionary([("b", 1), ("a", 2), ("b", 3)])
    assertEqual(ordered.count, 2)
    assertEqual(ordered.key(at: 0), "b")
    assertEqual(ordered.get("b"), 3)
    let collected: OrderedDictionary<Int, Int> = (1...3).map { ($0, $0 * 10) }.collect()
    assertEqual(collected.value(at: 2), 30)
}

@test
fn anOrderedDictionaryChangesByPosition() {
    let ordered = OrderedDictionary<String, Int>([("a", 1), ("c", 3)])
    assert(ordered.insert(2, forKey: "b", at: 1))
    assert(!ordered.insert(9, forKey: "a", at: 0))
    assert(ordered.keys == ["a", "b", "c"])
    assert(ordered.values == [1, 2, 3])
    assertEqual(ordered.index(of: "c"), 2)
    ordered.swapAt(0, 2)
    assert(ordered.keys == ["c", "b", "a"])
    assertEqual(ordered.index(of: "a"), 2)
    let (key, value) = ordered.remove(at: 1)
    assert(key == "b" && value == 2)
    assert(ordered.keys == ["c", "a"])
    assertEqual(ordered.index(of: "a"), 1)
    ordered.sortByKeys()
    assert(ordered.keys == ["a", "c"])
    ordered.sort(by: { $0.1 > $1.1 })
    assert(ordered.keys == ["c", "a"])
    assertEqual(ordered.get("a"), 1)
}

// Keys that collide, as their hash has three bits: the slots of one are
// moved over by taking out another's.
struct Crowded: Hashable {
    let id: Int

    operator == (lhs: Crowded, rhs: Crowded) -> Bool => lhs.id == rhs.id

    fn hash(into hasher: inout Hasher) {
        hasher.combine(id % 8)
    }
}

struct Entry {
    let id: Int
    let text: String
}

@test
fn anOrderedDictionaryAgreesWithAnArrayUnderRandomChanges() {
    var generator = SeededRandomNumberGenerator(seed: 42)
    let ordered = OrderedDictionary<Crowded, String>()
    var model = List<Entry>()
    for step in 0..<3000 {
        let id = Int(generator.next() % 60)
        let at = model.firstIndex(where: { $0.id == id })
        match generator.next() % 6 {
            case 0, 1 => {
                ordered.set(Crowded { id: id }, "v\(step)")
                if let at = at {
                    model[at] = Entry { id: id, text: "v\(step)" }
                } else {
                    model.append(Entry { id: id, text: "v\(step)" })
                }
            }
            case 2 => {
                let removed = ordered.remove(Crowded { id: id })
                if let at = at {
                    assertEqual(removed ?? "", model[at].text)
                    _ = model.remove(at: at)
                } else {
                    assert(removed == none)
                }
            }
            case 3 => {
                let place = Int(generator.next() % U64(model.count + 1))
                let added = ordered.insert("i\(step)", forKey: Crowded { id: id }, at: place)
                assertEqual(added, at == none)
                if added {
                    model.insert(Entry { id: id, text: "i\(step)" }, at: place)
                }
            }
            case 4 => {
                if model.count > 1 {
                    let i = Int(generator.next() % U64(model.count))
                    let j = Int(generator.next() % U64(model.count))
                    ordered.swapAt(i, j)
                    let held = model[i]
                    model[i] = model[j]
                    model[j] = held
                }
            }
            default => {
                if step % 10 == 0 {
                    ordered.sort(by: { $0.0.id < $1.0.id })
                    model.sort(by: { $0.id < $1.id })
                } else if model.count > 0 {
                    let (key, value) = ordered.remove(at: model.count / 2)
                    let wanted = model.remove(at: model.count / 2)
                    assert(key.id == wanted.id && value == wanted.text)
                }
            }
        }
        assertEqual(ordered.count, model.count)
        for i in 0..<model.count {
            assert(ordered.key(at: i).id == model[i].id && ordered.value(at: i) == model[i].text)
            assertEqual(ordered.index(of: Crowded { id: model[i].id }) ?? -1, i)
        }
        assert(ordered.contains(Crowded { id: id }) == (model.firstIndex(where: { $0.id == id }) != none))
    }
}
