module IntTests

// Int (Sable.Core): its limits, and the numeric protocols' operations at
// its width, at the limits. Run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

@test
fn theLimitsAreTheWidthsBounds() {
    assertEqual(Int.min, -9223372036854775808)
    assertEqual(Int.max, 9223372036854775807)
    assertEqual(Int.zero, 0)
    assertEqual(Int.one, 1)
    assertEqual(Int.bitWidth, 64)
    assert(Int.isSigned, "Int is signed")
}

@test
fn theLimitsPrintInDecimal() {
    assertEqual(Int.min.toString(), "-9223372036854775808")
    assertEqual(Int.max.toString(), "9223372036854775807")
}

@test
fn addingPastTheGreatestValueWrapsSaturatesOrReportsIt() {
    assertEqual(Int.max.wrappingAdd(1), Int.min)
    assertEqual(Int.max.saturatingAdd(1), Int.max)
    assert(Int.max.checkedAdd(1) == none, "the sum does not fit")
    let (sum, overflowed) = Int.max.overflowingAdd(1)
    assertEqual(sum, Int.min)
    assert(overflowed, "the sum overflowed")
}

@test
fn subtractingPastTheLeastValueWrapsSaturatesOrReportsIt() {
    assertEqual(Int.min.wrappingSub(1), Int.max)
    assertEqual(Int.min.saturatingSub(1), Int.min)
    assert(Int.min.checkedSub(1) == none, "the difference does not fit")
    let (difference, overflowed) = Int.min.overflowingSub(1)
    assertEqual(difference, Int.max)
    assert(overflowed, "the difference overflowed")
}

@test
fn multiplyingPastTheLimitsWrapsSaturatesOrReportsIt() {
    assertEqual(Int.max.wrappingMul(2), -2)
    assertEqual(Int.max.saturatingMul(2), Int.max)
    assert(Int.max.checkedMul(2) == none, "the product does not fit")
    let (product, overflowed) = Int.max.overflowingMul(2)
    assertEqual(product, -2)
    assert(overflowed, "the product overflowed")
    let (high, low) = Int.max.multipliedFullWidth(by: Int.max)
    assertEqual(high, 4611686018427387903)
    assertEqual(low, 1)
}

@test
fn theBitCountsSeeEveryBit() {
    assertEqual(Int.zero.leadingZeroCount, 64)
    assertEqual(Int.zero.trailingZeroCount, 64)
    assertEqual(Int.one.leadingZeroCount, 63)
    assertEqual(Int.max.popCount, 63)
    assertEqual(Int(-9223372036854775808).trailingZeroCount, 63)
    assertEqual(Int.max.leadingOneCount, 0)
    assertEqual(Int.max.trailingOneCount, 63)
}

@test
fn rotationsAndSwapsWorkAtTheWidth() {
    assertEqual(Int.one.rotatedLeft(by: 64), 1)
    assertEqual(Int.one.rotatedRight(by: 1), -9223372036854775808)
    assertEqual(Int.one.rotatedLeft(by: -1), -9223372036854775808)
    assertEqual(Int.one.bitReversed, -9223372036854775808)
    assertEqual(Int(72623859790382856).byteSwapped, 578437695752307201)
    assertEqual(Int(72623859790382856).bigEndianBytes().count, 8)
    assertEqual(Int.fromBigEndianBytes(Int.max.bigEndianBytes()) ?? 0, Int.max)
    assertEqual(Int.fromLittleEndianBytes(Int.min.littleEndianBytes()) ?? 1, Int.min)
}

@test
fn conversionsStopAtTheLimits() {
    assert(Int.exactly(U128.max) == none, "only a U128 holds U128's greatest value")
    assert(Int.exactly(I128.min) == none, "only an I128 holds I128's least value")
    assertEqual(Int.clamping(U128.max), Int.max)
    assertEqual(Int.clamping(I128.min), Int.min)
    assertEqual(Int.truncating(U128.max), -1)
    assertEqual(Int.exactly(Int.max) ?? 0, Int.max)
}

@test
fn theRemainderOfTheLeastValueByMinusOneIsZero() {
    assertEqual(Int.min.wrappingDiv(-1), Int.min)
    assertEqual(Int.min.wrappingRem(-1), 0)
    assert(Int.min.checkedDiv(-1) == none, "the quotient does not fit")
}

@test(traps: "integer overflow")
fn addingPastTheGreatestValueTraps() {
    var x = Int.max
    x = x + 1
    assertEqual(x, 0)
}

@test(traps: "integer overflow")
fn subtractingPastTheLeastValueTraps() {
    var x = Int.min
    x = x - 1
    assertEqual(x, 0)
}

@test(traps: "integer overflow")
fn theLeastValueHasNoAbsoluteValue() {
    assertEqual(Int.min.abs(), 0)
}

@test
fn theLeastValuesAbsoluteValueWrapsOrSaturates() {
    assertEqual(Int.min.wrappingAbs(), Int.min)
    assertEqual(Int.min.saturatingAbs(), Int.max)
    assertEqual(Int.min.saturatingNeg(), Int.max)
    assert(Int.min.checkedAbs() == none, "the least value has no absolute value")
    let (magnitude, overflowed) = Int.min.overflowingAbs()
    assertEqual(magnitude, Int.min)
    assert(overflowed, "the absolute value overflowed")
}
