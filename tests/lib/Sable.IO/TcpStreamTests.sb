module TcpStreamTests

// TcpStream (Sable.IO), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.IO

import Sable.IO
import Sable.Testing

/// Bytes as text, to compare.
fn text(_ bytes: U8[>..]) -> String {
    var said = ""
    for b in bytes {
        said += "\(b) "
    }
    return said
}

/// Accepts one connection and sends back what it reads, each byte one more.
fn echoOnce(_ listener: TcpListener) async throws(IoError) {
    let connection = try await listener.accept()
    let bytes = try await connection.readAll()
    var reply: U8[>..] = []
    for b in bytes {
        reply.append(b == 255 ? 0 : b + 1)
    }
    try await connection.write(reply)
    connection.finishWriting()
}

@test
fn aStreamWritesAndReadsBytes() async {
    do {
        let listener = try TcpListener.bind(host: "127.0.0.1", port: 0)
        let server = Task.spawn { try? await echoOnce(listener) }
        let stream = try await TcpStream.connect(host: "127.0.0.1", port: listener.port)
        try await stream.write([1, 2, 255])
        stream.finishWriting()
        assertEqual(text(try await stream.readAll()), text([2, 3, 0]))
        await server.value
    } catch {
        assert(false, error.description())
    }
}

@test
fn aReadGivesWhatHasComeAndNothingAtTheEnd() async {
    do {
        let listener = try TcpListener.bind(host: "127.0.0.1", port: 0)
        let server = Task.spawn { try? await echoOnce(listener) }
        let stream = try await TcpStream.connect(host: "127.0.0.1", port: listener.port)
        try await stream.write([9])
        stream.finishWriting()
        assertEqual(text(try await stream.read(upTo: 10)), text([10]))
        assertEqual(try await stream.read(upTo: 10).count, 0)
        await server.value
    } catch {
        assert(false, error.description())
    }
}

@test
fn aLargeWriteWaitsForItsReader() async {
    do {
        let listener = try TcpListener.bind(host: "127.0.0.1", port: 0)
        let server = Task.spawn { try? await echoOnce(listener) }
        let stream = try await TcpStream.connect(host: "127.0.0.1", port: listener.port)
        var bytes: U8[>..] = []
        for i in 0..<300_000 {
            bytes.append(U8(i % 200))
        }
        try await stream.write(bytes)
        stream.finishWriting()
        let reply = try await stream.readAll()
        assertEqual(reply.count, 300_000)
        assertEqual(reply[299_999], 200)
        await server.value
    } catch {
        assert(false, error.description())
    }
}

@test
fn connectingWhereNothingListensThrows() async {
    var port = 0
    do {
        let listener = try TcpListener.bind(host: "127.0.0.1", port: 0)
        port = listener.port
        listener.close()
        let _ = try await TcpStream.connect(host: "127.0.0.1", port: port)
        assert(false, "connected")
    } catch {
        assertEqual(error.description(), "'127.0.0.1:\(port)' could not be reached")
    }
}

@test
fn connectingToANameThatIsNotThereThrows() async {
    var thrown = false
    do {
        let _ = try await TcpStream.connect(host: "no-such-host.invalid", port: 1)
    } catch {
        thrown = true
    }
    assert(thrown)
}

@test
fn usingAClosedStreamThrows() async {
    do {
        let listener = try TcpListener.bind(host: "127.0.0.1", port: 0)
        let server = Task.spawn { try? await listener.accept() }
        let stream = try await TcpStream.connect(host: "127.0.0.1", port: listener.port)
        stream.close()
        var said = ""
        do {
            let _ = try await stream.read(upTo: 1)
        } catch {
            said = error.description()
        }
        assertEqual(said, "the connection failed or was closed")
        said = ""
        do {
            try await stream.write([1])
        } catch {
            said = error.description()
        }
        assertEqual(said, "the connection failed or was closed")
        let _ = await server.value
    } catch {
        assert(false, error.description())
    }
}
