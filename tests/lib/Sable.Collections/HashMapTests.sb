module HashMapTests

// HashMap (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn aHashMapIsGoneThroughInTheOrderItsKeysWereSet() {
    let map = HashMap<String, Int>()
    map.set("b", 2)
    map.set("a", 1)
    map.set("c", 3)
    let _ = map.remove("a")
    map.set("b", 20)
    var seen: String[>..] = []
    for (key, value) in map {
        seen.append("\(key)=\(value)")
    }
    assertEqualText(seen.joined(separator: ","), "b=20,c=3")
    assertEqual(HashMap<String, Int>().toArray().count, 0)
}

@test
fn hashMapSetsGetsAndRemoves() {
    let map = HashMap<String, Int>()
    var i = 0
    while i < 100 {
        map.set("key\(i)", i * i)
        i = i + 1
    }
    assertEqual(map.get("key7") ?? -1, 49)
    assertEqual(map.get("key99") ?? -1, 9801)
    assert(map.contains("key0"))
    assert(map.remove("key0"))
    assert(!map.contains("key0"), "a removed key is gone")
    assert(!map.remove("key0"), "a key is removed once")
    assertEqual(map.allKeys().count, 99)
}

@test
fn anEmptyMapHasNothing() {
    let map = HashMap<Int, String>()
    assert(map.isEmpty)
    assertEqual(map.count, 0)
    assert(map.get(1) == none)
    assert(!map.contains(1))
    assert(!map.remove(1))
}

@test
fn settingAKeyAgainReplacesItsValue() {
    let map = HashMap<String, Int>()
    map.set("a", 1)
    map.set("a", 2)
    assertEqual(map.count, 1)
    assert(!map.isEmpty)
    assertEqual(map.get("a") ?? 0, 2)
    assert(map.get("b") == none)
}

@test
fn keysAndValuesAreInTheOrderTheyWereSet() {
    let map = HashMap<String, Int>()
    map.set("z", 1)
    map.set("a", 2)
    map.set("m", 3)
    let _ = map.remove("a")
    assert(map.allKeys() == ["z", "m"])
    assert(map.allValues() == [1, 3])
}

@test
fn removedSlotsAreReusedAndDroppedOnGrowth() {
    let map = HashMap<Int, Int>()
    var i = 0
    while i < 40 {
        map.set(i, i)
        i = i + 1
    }
    i = 0
    while i < 40 {
        assert(map.remove(i))
        i = i + 2
    }
    i = 100
    while i < 200 {
        map.set(i, i)
        i = i + 1
    }
    assertEqual(map.count, 120)
    assertEqual(map.get(1) ?? -1, 1)
    assert(map.get(2) == none)
    assertEqual(map.get(150) ?? -1, 150)
    assertEqual(map.allKeys().count, 120)
}

@test
fn removeAllEmptiesTheMap() {
    let map = HashMap<Int, Int>()
    map.set(1, 1)
    map.set(2, 2)
    map.removeAll()
    assertEqual(map.count, 0)
    assert(map.get(1) == none)
    map.set(3, 3)
    assertEqual(map.get(3) ?? 0, 3)
}

@bench
fn hashMapInserts(_ b: Bencher) {
    b.iterate(() => {
        let map = HashMap<Int, Int>()
        var i = 0
        while i < 64 {
            map.set(i, i)
            i = i + 1
        }
    })
}
