module Sable.Process

import Sable.Text

/// How a program run to its end ended, and what it wrote.
public struct Completed {
    /// How it ended.
    public let status: ExitStatus
    /// What it wrote to standard output.
    public let outputBytes: U8[>..]
    /// What it wrote to standard error.
    public let errorBytes: U8[>..]

    /// Whether it ended with status 0.
    public var succeeded: Bool => status.success

    /// What it wrote to standard output, as text; bytes that are not UTF-8
    /// are U+FFFD.
    public var output: String => String.fromUtf8Lossy(outputBytes)

    /// What it wrote to standard error, as text.
    public var errors: String => String.fromUtf8Lossy(errorBytes)
}
