module ValidationTests

import Sable.Testing
import Sable.Validation

@test
fn aLengthIsWithinBothBounds() {
    for (text, good) in [("a", false), ("ab", true), ("abc", true), ("abcd", false)] {
        expect(passes(text) { $0.length(2...3) } == good, text)
    }
    assertEqual(message("a") { $0.length(2...3) }, "'It' must be between 2 and 3 long. It is 1 long.")
    assertEqual(message("a") { $0.length(2) }, "'It' must be 2 long. It is 1 long.")
    assertEqual(message("a") { $0.minLength(2) }, "'It' must be at least 2 long. It is 1 long.")
    assertEqual(message("abc") { $0.maxLength(2) }, "'It' must be 2 long or less. It is 3 long.")
    expect(passes("ab") { $0.length(2).minLength(2).maxLength(2) })
}

@test
fn aLengthIsOfCharactersAndOfElements() {
    expect(passes("\u{1F600}\u{1F600}") { $0.length(2) })
    expect(passes([1, 2, 3]) { $0.length(3) })
    expect(!passes([1, 2, 3]) { $0.maxLength(2) })
}

@test
fn uniqueRefusesAnElementThatRepeats() {
    expect(passes([1, 2, 3]) { $0.unique() })
    assertEqual(message([1, 2, 1]) { $0.unique() }, "'It' must not repeat a value.")
}
