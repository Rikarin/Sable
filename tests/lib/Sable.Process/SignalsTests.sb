module SignalsTests

// Signals, SignalSequence and SignalRegistration (Sable.Process), tested
// with '@test': run with
//     tools/stdlib-coverage.sh Sable.Process

import Sable.Process
import Sable.Testing
import Sable.Time

// Shells, paths and signals as POSIX has them; Windows' are tested by
// Sable.CodeGen.Tests' ProcessTests.
#if !os(windows)

@test
fn aSignalListenedForComes() async {
    let signals = try! Signals.on(.Terminate)
    expect(Signals.raise(.Terminate))
    var iterator = signals.makeAsyncIterator()
    expect(await iterator.next()! == Signal.Terminate)
}

@test
fn aSignalAnotherProgramSendsComes() async {
    let signals = try! Signals.on([.User1, .User2])
    let sent = try! await Command("sh").arguments(["-c", "kill -USR2 $PPID"]).status()
    expect(sent.success)
    for await signal in signals {
        assert(signal == Signal.User2)
        break
    }
}

@test
fn aSignalWakesATaskWaitingForIt() async {
    let signals = try! Signals.on(.Interrupt)
    let waiting = Task.spawn {
        var iterator = signals.makeAsyncIterator()
        return await iterator.next()
    }
    try? await Task.sleep(for: Duration.milliseconds(30))
    Signals.raise(.Interrupt)
    expect(await waiting.value! == Signal.Interrupt)
}

@test
fn signalsOfTwoKindsBothCome() async {
    let signals = try! Signals.on([.User1, .User2])
    Signals.raise(.User2)
    Signals.raise(.User1)
    var iterator = signals.makeAsyncIterator()
    var numbers = [await iterator.next()!.number, await iterator.next()!.number]
    numbers.sort()
    var expected = [Signal.User1.number, Signal.User2.number]
    expected.sort()
    expect(numbers == expected)
}

@test
fn everyListenerHearsIt() async {
    let one = try! Signals.on(.User1)
    let two = try! Signals.on(.User1)
    Signals.raise(.User1)
    var first = one.makeAsyncIterator()
    var second = two.makeAsyncIterator()
    expect(await first.next()! == Signal.User1)
    expect(await second.next()! == Signal.User1)
}

@test
fn itComesAgain() async {
    let signals = try! Signals.on(.User1)
    var iterator = signals.makeAsyncIterator()
    var i = 0
    while i < 20 {
        Signals.raise(.User1)
        assert(await iterator.next()! == Signal.User1)
        i += 1
    }
}

@test
fn aTaskCancelledHearsNoMore() async {
    let signals = try! Signals.on(.User1)
    let waiting = Task.spawn {
        var heard = 0
        for await _ in signals {
            heard += 1
        }
        return heard
    }
    try? await Task.sleep(for: Duration.milliseconds(20))
    waiting.cancel()
    assertEqual(await waiting.value, 0)
}

@test
fn aHandlerRunsEachTime() async {
    let counted = Atomic(0)
    let registration = try! Signals.handle(.User1) { _signal in
        _ = counted.update { $0 + 1 }
    }
    Signals.raise(.User1)
    while counted.load() < 1 {
        try? await Task.sleep(for: Duration.milliseconds(1))
    }
    Signals.raise(.User1)
    while counted.load() < 2 {
        try? await Task.sleep(for: Duration.milliseconds(1))
    }
    registration.cancel()
    assertEqual(counted.load(), 2)
}

@test
fn aSignalNoOneListensForDoesWhatItDid() async {
    // In a child: listening in this program, let go, and not caught there.
    do {
        let signals = try! Signals.on(.Terminate)
        Signals.raise(.Terminate)
        var iterator = signals.makeAsyncIterator()
        expect(await iterator.next()! == Signal.Terminate)
    }
    let listening = try! Signals.on(.Terminate)
    let child = try! Command("sleep").argument("60").spawn()
    expect(try! child.signal(.Terminate))
    expect(try! await child.wait() == ExitStatus(signal: .Terminate))
    _ = listening
}

@test
fn whatCannotBeCaughtIsRefused() {
    for signal in [Signal.Kill, Signal.Stop, Signal.SegmentationFault, Signal.Other(number: 0), Signal.Other(number: 63)] {
        expectThrows(saying: ProcessError.Unsupported.description()) { _ = try Signals.on([.User1, signal]) }
    }
    expect(!Signals.raise(.Other(number: 0)))
}

@test
fn waitingForASignalKeepsNoProgramGoing() async {
    // The test ends, though its task never does.
    let signals = try! Signals.on(.User2)
    _ = Task.detached {
        for await _ in signals { }
    }
    try? await Task.sleep(for: Duration.milliseconds(10))
}

#endif
