module WatchTests

// Watch and WatchReceiver (Sable.Concurrency), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Concurrency

import ConcurrencySupport
import Sable.Concurrency
import Sable.Testing

@test
fn itHoldsTheLatestValue() {
    let watch = Watch<Int>(1)
    assertEqual(watch.value, 1)
    assertEqual(watch.version, 0)
    expect(watch.send(2))
    assertEqual(watch.value, 2)
    assertEqual(watch.version, 1)
}

@test
fn aReceiverWaitsForAChange() async {
    let watch = Watch<String>("old")
    let receiver = watch.subscribe()
    let reader = Task.spawn {
        var mine = receiver
        return await mine.changed()
    }
    await settle()
    watch.send("new")
    expect(await reader.value == "new")
}

@test
fn aSlowReceiverSkipsToTheNewest() async {
    let watch = Watch<Int>(0)
    var receiver = watch.subscribe()
    expect(!receiver.hasChanged)
    for i in 1...5 {
        watch.send(i)
    }
    expect(receiver.hasChanged)
    expect(await receiver.changed() == 5)
    expect(!receiver.hasChanged)
}

@test
fn borrowingMarksTheValueSeen() {
    let watch = Watch<Int>(3)
    var receiver = watch.subscribe()
    watch.send(4)
    expect(receiver.hasChanged)
    assertEqual(receiver.borrowAndMarkSeen(), 4)
    expect(!receiver.hasChanged)
}

@test
fn updateChangesTheValueInPlace() {
    let watch = Watch<Int[>..]>([1])
    expect(watch.update { $0.append(2) })
    expect(watch.value == [1, 2])
    assertEqual(watch.version, 1)
}

@test
fn everyReceiverSeesTheChange() async {
    let watch = Watch<Int>(0)
    var readers: Task<Int?>[>..] = []
    for _ in 0..<3 {
        let receiver = watch.subscribe()
        readers.append(Task.spawn {
            var mine = receiver
            return await mine.changed()
        })
    }
    await settle()
    watch.send(7)
    for reader in readers {
        assertEqual(await reader.value, 7)
    }
}

@test
fn closingEndsTheWaitOnceTheLastIsSeen() async {
    let watch = Watch<Int>(0)
    var receiver = watch.subscribe()
    watch.send(1)
    watch.close()
    expect(watch.isClosed)
    expect(!watch.send(2))
    expect(!watch.update { $0 += 1 })
    // The change made before closing is still seen, then none.
    expect(await receiver.changed() == 1)
    expect(await receiver.changed() == none)
}

@test
fn closingWakesAWaitingReceiver() async {
    let watch = Watch<Int>(0)
    let receiver = watch.subscribe()
    let reader = Task.spawn {
        var mine = receiver
        return await mine.changed()
    }
    await settle()
    watch.close()
    expect(await reader.value == none)
}

@test
fn aWaitingReceiverIsCancelled() async {
    let watch = Watch<Int>(0)
    let receiver = watch.subscribe()
    let reader = Task.spawn {
        var mine = receiver
        return await mine.changed()
    }
    await settle()
    reader.cancel()
    expect(await reader.value == none)
}

@test
fn iteratingGivesTheValueThenEachChange() async {
    let watch = Watch<Int>(10)
    var iterator = watch.makeAsyncIterator()
    expect(await iterator.next() == 10)
    watch.send(20)
    watch.send(30)
    expect(await iterator.next() == 30)
    watch.close()
    expect(await iterator.next() == none)
}

@test
fn aReceiverIsItsOwnIterator() async {
    let watch = Watch<Int>(1)
    let receiver = watch.subscribe()
    watch.send(2)
    watch.close()
    var got: Int[>..] = []
    for await value in receiver {
        got.append(value)
    }
    expect(got == [2])
}
