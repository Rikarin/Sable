module Sable.Concurrency

/// A lock a task holds across suspensions, and waits for by suspending: for
/// work between awaits that no other task may interleave with, which an
/// actor's own reentrancy would let in. `withLock` holds it for an async
/// closure.
///
/// ```sable
/// let gate = AsyncMutex()
/// let n = await gate.withLock { 42 }
/// assert(n == 42)
/// ```
@immutable
public final class AsyncMutex {
    let gate: AsyncSemaphore

    public init() {
        gate = AsyncSemaphore(permits: 1)
    }

    /// Takes the lock, suspending until it is free. Those that wait get it
    /// in the order they came.
    public fn lock() async {
        await gate.acquire()
    }

    /// Takes the lock if it is free now: whether it did.
    public fn tryLock() -> Bool {
        return gate.tryAcquire()
    }

    /// Lets the lock go, to the task that has waited longest, if one does.
    /// One that is free stays so.
    public fn unlock() {
        gate.giveBack(1, atMost: 1)
    }

    /// Whether some task holds the lock now.
    public var isLocked: Bool => gate.availablePermits == 0
}

extension AsyncMutex {
    /// What the closure gives, the lock held while it runs, however many
    /// times it suspends; let go whether it returns or throws.
    public fn withLock<R, E: Error>(_ body: async () throws(E) -> R) async throws(E) -> R {
        await lock()
        do {
            let result = try await body()
            unlock()
            return result
        } catch {
            unlock()
            throw error
        }
    }
}
