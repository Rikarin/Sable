module Sable.Core

extension U128: Parsable {
    /// The number the text writes in decimal, with a sign if it likes: what
    /// `format` writes with nothing said. `.Overflow` past the greatest U128,
    /// `.Underflow` past the least.
    ///
    /// ```sable
    /// assert(try! U128.parse("340282366920938463463374607431768211455") == 340282366920938463463374607431768211455)
    /// ```
    public static fn parse(_ text: String) throws(ParseError) -> U128 {
        return try U128.parse(text, radix: 10, styles: .Sign)
    }

    /// The number the text writes in the radix — 2 to 36, with letters of
    /// either case past 9; another traps — with what else the styles allow:
    /// white space, a sign, the radix's prefix, separators.
    ///
    /// ```sable
    /// assert(try! U128.parse("0x7f", radix: 16, styles: .Prefix) == 127)
    /// ```
    public static fn parse(_ text: String, radix: Int, styles: NumberStyles = .Sign) throws(ParseError) -> U128 {
        let (negative, magnitude) = try parseInteger(text, radix, styles)
        return try unsignedValue(negative, magnitude, 340282366920938463463374607431768211455)
    }
}
