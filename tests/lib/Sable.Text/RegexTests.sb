        "[a[bc]]+", "xcbad", "1-4",
        #"[\d\s]+"#, "a1 2b", "1-4",
        #"[^\D]+"#, "a12b", "1-3",
        #"\p{Lu}"#, "aB", "1-2",
        #"\pL+"#, "12abc", "2-5",
        #"\P{L}+"#, "ab12", "2-4",
        #"\p{^L}+"#, "ab12", "2-4",
        #"\p{Uppercase_Letter}+"#, "aBCd", "1-3",
        #"\p{gc=Nd}+"#, "x42", "1-3",
        #"\d+"#, "x١٢٣", "1-7",
        #"\w+"#, "żółw!", "0-7",
        #"\s+"#, "a\u{3000}b", "1-4",
        #"[\p{Lu}\d]+"#, "aB1c", "1-3",
        #"\p{Alphabetic}+"#, "1ab2", "1-3",
        #"\p{White_Space}"#, "a b", "1-2",
        #"\p{Any}"#, "😀", "0-4",
        #"[\p{L}&&\p{ASCII}]+"#, "éab", "2-4",
        #"\x41\x{1F600}é"#, "A😀é", "0-7",
        #"\t\n\r\f\v\a\e\0"#, "\t\n\r\u{C}\u{B}\u{7}\u{1B}\u{0}", "0-8",
