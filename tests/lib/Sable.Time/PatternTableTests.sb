module TimePatternTableTests

// What .NET 11's DateTimeOffset.ToString(pattern, CultureInfo.InvariantCulture)
// writes, against OffsetDateTime.format(pattern:). Generated by
// tools/time/dotnet-patterns.cs: do not edit; run it again.

import Sable.Testing
import Sable.Time

struct PatternCase {
    let moment: Int
    let pattern: String
    let expected: String
}

fn moment(_ index: Int) -> OffsetDateTime {
    return match index {
        case 0 => OffsetDateTime.of(year: 2026, month: 11, day: 17, hour: 9, minute: 5, second: 3, nanosecond: 123456700, offset: UtcOffset.of(seconds: 3600)!)!
        case 1 => OffsetDateTime.of(year: 2005, month: 1, day: 2, hour: 0, minute: 0, second: 0, nanosecond: 0, offset: UtcOffset.of(seconds: -18000)!)!
        case 2 => OffsetDateTime.of(year: 1999, month: 12, day: 31, hour: 23, minute: 59, second: 59, nanosecond: 999000000, offset: UtcOffset.of(seconds: 19800)!)!
        case 3 => OffsetDateTime.of(year: 2024, month: 2, day: 29, hour: 12, minute: 30, second: 7, nanosecond: 50000000, offset: UtcOffset.of(seconds: 0)!)!
        case 4 => OffsetDateTime.of(year: 987, month: 7, day: 4, hour: 13, minute: 4, second: 5, nanosecond: 100, offset: UtcOffset.of(seconds: -34200)!)!
        case 5 => OffsetDateTime.of(year: 2010, month: 10, day: 10, hour: 10, minute: 10, second: 10, nanosecond: 100000000, offset: UtcOffset.of(seconds: 45900)!)!
        case _ => OffsetDateTime.of(year: 1970, month: 1, day: 1, offset: UtcOffset.utc)!
    }
}

