module Sable.Core

extension I16: Parsable {
    /// The number the text writes in decimal, with a sign if it likes: what
    /// `format` writes with nothing said. `.Overflow` past the greatest I16,
    /// `.Underflow` past the least.
    ///
    /// ```sable
    /// assert(try! I16.parse("-32768") == -32768)
    /// ```
    public static fn parse(_ text: String) throws(ParseError) -> I16 {
        return try I16.parse(text, radix: 10, styles: .Sign)
    }

    /// The number the text writes in the radix — 2 to 36, with letters of
    /// either case past 9; another traps — with what else the styles allow:
    /// white space, a sign, the radix's prefix, separators.
    ///
    /// ```sable
    /// assert(try! I16.parse("0x7f", radix: 16, styles: .Prefix) == 127)
    /// ```
    public static fn parse(_ text: String, radix: Int, styles: NumberStyles = .Sign) throws(ParseError) -> I16 {
        let (negative, magnitude) = try parseInteger(text, radix, styles)
        let value = try signedValue(negative, magnitude, 32767)
        return I16(value)
    }
}
