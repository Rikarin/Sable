module StringEncodingTests

// Strings to and from UTF-8, UTF-16, UTF-32, Latin-1 and ASCII (Sable.Text),
// tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Testing
import Sable.Text

fn bytes(_ values: Int[>..]) -> U8[>..] {
    var result: U8[>..] = []
    for value in values {
        result.append(U8(value))
    }
    return result
}

fn units(_ values: Int[>..]) -> U16[>..] {
    var result: U16[>..] = []
    for value in values {
        result.append(U16(value))
    }
    return result
}

@test
fn wellFormedUtf8BecomesText() {
    assertEqual((try? String.fromUtf8(bytes([0x63, 0x61, 0x66, 0xC3, 0xA9]))) ?? "?", "café")
    assertEqual((try? String.fromUtf8(bytes([]))) ?? "?", "")
    let text = (try? String.fromUtf8(bytes([0xF0, 0x9F, 0x98, 0x80, 0x21]))) ?? "?"
    assertEqual(text.count, 2)
    assertEqual(text.utf8Count, 5)
}

@test
fn illFormedUtf8ThrowsWhereItIs() {
    var caught = false
    do {
        let _ = try String.fromUtf8(bytes([0x61, 0xE2, 0x82, 0x28]))
    } catch {
        caught = true
        assertEqual(error.validUpTo, 1)
        assertEqual(error.errorLength ?? 0, 2)
    }
    assert(caught, "the error was thrown")
}

@test
fn lossyDecodingReplacesEachMaximalSubpart() {
    assertEqual(String.fromUtf8Lossy(bytes([0x61, 0xF0, 0x9F, 0x62])), "a\u{FFFD}b")
    assertEqual(String.fromUtf8Lossy(bytes([0x61, 0x80, 0x80, 0x62])), "a\u{FFFD}\u{FFFD}b")
    assertEqual(String.fromUtf8Lossy(bytes([0xC0, 0xAF])), "\u{FFFD}\u{FFFD}")
    assertEqual(String.fromUtf8Lossy(bytes([0xED, 0xA0, 0x80])), "\u{FFFD}\u{FFFD}\u{FFFD}")
    assertEqual(String.fromUtf8Lossy(bytes([0x61, 0xE2, 0x82])), "a\u{FFFD}")
    assertEqual(String.fromUtf8Lossy(bytes([0x68, 0x69])), "hi")
    assertEqual(String.fromUtf8Lossy(bytes([])), "")
}

@test
fn utf16BecomesText() {
    assertEqual((try? String.fromUtf16(units([0x48, 0x69, 0xD83D, 0xDE00]))) ?? "?", "Hi😀")
    assertEqual((try? String.fromUtf16(units([0x20AC]))) ?? "?", "€")
    assertEqual(String.fromUtf16Lossy(units([0x61, 0xD800, 0x62, 0xDC00])), "a\u{FFFD}b\u{FFFD}")
    assertEqual(String.fromUtf16Lossy(units([0xD83D])), "\u{FFFD}")
}

@test
fn anUnpairedSurrogateThrowsWhereItIs() {
    var index = -1
    do {
        let _ = try String.fromUtf16(units([0x61, 0x62, 0xDE00]))
    } catch {
        index = error.index
        assertEqual(error.debugDescription(), "unpaired surrogate at code unit 2")
        assert(error == Utf16Error(index: 2) && error != Utf16Error(index: 1), "errors compare by index")
    }
    assertEqual(index, 2)
}

@test
fn utf32BecomesTextWhenEachCodeIsAScalar() {
    var codes: U32[>..] = [0x61, 0x20AC, 0x1F600]
    assertEqual(String.fromUtf32(codes) ?? "?", "a€😀")
    codes.append(0xD800)
    assert(String.fromUtf32(codes) == none, "a surrogate is no scalar")
}

@test
fn latin1BytesAreTheirOwnScalars() {
    assertEqual(String.fromLatin1(bytes([0x63, 0x61, 0x66, 0xE9])), "café")
    assertEqual(String.fromLatin1(bytes([0x41, 0x42])), "AB")
    assertEqual(String.fromLatin1(bytes([0xFF, 0x80])), "\u{FF}\u{80}")
}

@test
fn asciiBytesBecomeTextOnlyWhenAscii() {
    assertEqual(String.fromAscii(bytes([0x6F, 0x6B])) ?? "?", "ok")
    assert(String.fromAscii(bytes([0x6F, 0xE9])) == none, "0xE9 is not ASCII")
}

@test
fn encodingToEachForm() {
    let text = "a€😀"
    assert(text.utf8Bytes() == bytes([0x61, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80]), "UTF-8")
    assert(text.utf16Units() == units([0x61, 0x20AC, 0xD83D, 0xDE00]), "UTF-16")
    assertEqual(text.utf16Count, 4)
    let codes: U32[>..] = [0x61, 0x20AC, 0x1F600]
    assert(text.utf32Units() == codes, "UTF-32")
    assert("café".latin1Bytes()! == bytes([0x63, 0x61, 0x66, 0xE9]), "Latin-1")
    assert(text.latin1Bytes() == none, "€ is not Latin-1")
    assert("ok".asciiBytes()! == bytes([0x6F, 0x6B]), "ASCII")
    assert("café".asciiBytes() == none, "é is not ASCII")
}

@test
fn encodingAndDecodingRoundTrip() {
    let text = "Grüße, 世界 😀\u{0}"
    assertEqual((try? String.fromUtf8(text.utf8Bytes())) ?? "?", text)
    assertEqual((try? String.fromUtf16(text.utf16Units())) ?? "?", text)
    assertEqual(String.fromUtf32(text.utf32Units()) ?? "?", text)
}
