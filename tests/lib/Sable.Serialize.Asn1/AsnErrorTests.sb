module AsnErrorTests

import Sable.Serialize.Asn1
import Sable.Testing

@test
fn aReadersErrorSaysWhere() {
    var reader = AsnReader([0x01, 0x01, 0xFF], rules: .Der)
    let error = require(expectThrows(AsnError.self) { try reader.readNull() })
    expect(error.offset == 0)
    expect(error.description().hasPrefix("byte 0: expected "))
}

let errors: (AsnError, Int?, String)[>..] = [
    (.UnexpectedEnd(at: 1), 1, "byte 1: the bytes end inside a value"),
    (.Malformed(at: 2, reason: "bad"), 2, "byte 2: bad"),
    (.NotCanonical(at: 3, reason: "long"), 3, "byte 3: long"),
    (.TrailingData(at: 5), 5, "byte 5: more after the last value"),
    (.TooDeep(at: 6, limit: 9), 6, "byte 6: nested more than 9 deep"),
    (.OutOfRange(at: 7, reason: "large"), 7, "byte 7: large"),
    (.Invalid(reason: "asked"), none, "asked"),
]

@test(arguments: errors)
fn eachErrorSaysWhereAndWhat(_ error: AsnError, _ offset: Int?, _ text: String) {
    expect(error.offset == offset)
    expect(error.description() == text)
}
