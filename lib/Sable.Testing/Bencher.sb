module Sable.Testing

import Sable.Math

/// Times a body: a '@bench' function that takes one calls 'iterate' with
/// what to measure, set-up kept outside it.
///
/// What the body returns is kept from the optimiser ('blackBox'), as is the
/// body; what it is given is the benchmark's to keep ('blackBox(input)').
///
/// ```sable
/// let b = Bencher("sum", BenchSettings.quick)
/// let values = [1, 2, 3]
/// let sum = b.iterate { values.sum() }
/// b.check("\(sum)")
/// b.itemsPerIteration = values.count
/// assertEqual(b.measurement!.check, "6")
/// ```
public class Bencher {
    /// What the body works on in an iteration, for a throughput beside the
    /// time: bytes, or things of any kind; 0 for none.
    public var bytesPerIteration: Int = 0
    public var itemsPerIteration: Int = 0
    /// How many times the body does what is measured: its times and counts
    /// are divided by it.
    public var operationsPerIteration: Int = 1

    let name: String
    let settings: BenchSettings
    var schedule: BenchSchedule
    var memory: BenchMemory? = none
    var counters: BenchCounters? = none
    var checked: String = ""

    // The run going on: what it has taken, and where the clocks, the counts
    // and the processor's counters were as its present part began.
    var wall: Int = 0
    var processor: Int = 0
    var instructions: Int = 0
    var cycles: Int = 0
    var counted: Int = 0
    var memoryTotal: BenchMemory = BenchMemory()
    var begunWall: Int = 0
    var begunProcessor: Int = 0
    var begunInstructions: Int = 0
    var begunCycles: Int = 0
    var begunMemory: BenchMemory = BenchMemory()

    public init(_ name: String, _ settings: BenchSettings = BenchSettings()) {
        self.name = name
        self.settings = settings
        self.schedule = BenchSchedule(settings)
    }

    /// What 'iterate' measured; none until it has.
    public var measurement: BenchMeasurement? {
        get {
            if schedule.phase != .Done {
                return none
            }
            return BenchMeasurement(
                name: name, samples: schedule.samples, wallOverhead: schedule.overhead(processor: false),
                processorOverhead: schedule.overhead(processor: true), memory: memory ?? BenchMemory(), counters: counters, check: checked,
                operations: max(operationsPerIteration, 1), bytes: bytesPerIteration, items: itemsPerIteration
            )
        }
    }

    /// What the benchmark computed, to be the same wherever it is run: in
    /// each of its processes, each job's, and the ports to other languages
    /// (tools/bench/compare.py).
    public fn check(_ text: String) {
        checked = text
    }

    /// Runs the body over and over, as the settings say, and gives what it
    /// returned last.
    @discardable
    public fn iterate<R>(_ body: @escaping () -> R) -> R {
        let body = blackBox(body)
        let empty: () -> Void = blackBox({ })
        var last: R? = none
        while schedule.phase != .Done {
            let count = schedule.iterations
            begin()
            if schedule.phase == .Overhead {
                for _ in 0..<count {
                    blackBox(empty())
                }
            } else {
                for _ in 1..<count {
                    _ = blackBox(body())
                }
                last = blackBox(body())
            }
            end()
        }
        return last!
    }

    /// As 'iterate', for a body that awaits: each iteration is awaited
    /// before the next, and the time it spends suspended is part of its time.
    @discardable
    public async fn iterateAsync<R>(_ body: @escaping async () -> R) -> R {
        let body = blackBox(body)
        var last: R? = none
        while schedule.phase != .Done {
            let count = schedule.iterations
            begin()
            if schedule.phase != .Overhead {
                for _ in 1..<count {
                    _ = blackBox(await body())
                }
                last = blackBox(await body())
            }
            end()
        }
        return last!
    }

    /// As 'iterate', each iteration given a value of its own that 'setup'
    /// makes, and 'cleanup' is given after it, neither of them timed. The
    /// values are made 'batch' at a time, all of them alive at once: fewer
    /// for large ones.
    ///
    /// ```sable
    /// let b = Bencher("sorted", BenchSettings.quick)
    /// let values = [3, 1, 2]
    /// b.iterate(setup: { values }, { (copy: inout Int[]) in copy.sort() })
    /// assert(b.measurement != none)
    /// ```
    @discardable
    public fn iterate<T, R>(
        setup: () -> T,
        _ body: @escaping (inout T) -> R,
        batch: Int = 16,
        cleanup: (inout T) -> Void = { (value: inout T) in }
    ) -> R {
        let body = blackBox(body)
        let empty: (inout T) -> Void = blackBox({ (value: inout T) in })
        var last: R? = none
        while schedule.phase != .Done {
            var left = schedule.iterations
            let overhead = schedule.phase == .Overhead
            while left > 0 {
                let count = min(left, max(batch, 1))
                left -= count
                var values: T[>..] = []
                values.reserveCapacity(count)
                for _ in 0..<count {
                    values.append(setup())
                }
                begin()
                if overhead {
                    for i in 0..<count {
                        empty(&values[i])
                    }
                } else {
                    for i in 1..<count {
                        _ = blackBox(body(&values[i - 1]))
                    }
                    last = blackBox(body(&values[count - 1]))
                }
                pause()
                for i in 0..<count {
                    cleanup(&values[i])
                }
            }
            finish()
        }
        return last!
    }

    /// As 'iterateAsync', each iteration given a value of its own, as
    /// 'iterate(setup:)' gives it.
    @discardable
    public async fn iterateAsync<T, R>(
        setup: @escaping async () -> T,
        _ body: @escaping async (T) -> R,
        batch: Int = 16,
        cleanup: @escaping async (T) -> Void = { (value: T) in }
    ) -> R {
        let body = blackBox(body)
        var last: R? = none
        while schedule.phase != .Done {
            var left = schedule.iterations
            let overhead = schedule.phase == .Overhead
            while left > 0 {
                let count = min(left, max(batch, 1))
                left -= count
                var values: T[>..] = []
                values.reserveCapacity(count)
                for _ in 0..<count {
                    values.append(await setup())
                }
                begin()
                if !overhead {
                    for i in 0..<count {
                        last = blackBox(await body(values[i]))
                    }
                }
                pause()
                for i in 0..<count {
                    await cleanup(values[i])
                }
            }
            finish()
        }
        return last!
    }

    // A part of a run begins: the last thing it does is to read the clock.
    fn begin() {
        if schedule.phase == .Counters {
            begunInstructions = Runtime.measurement(2)
            begunCycles = Runtime.measurement(3)
        } else if schedule.phase == .Memory {
            Runtime.countMemory(true)
            begunMemory = BenchMemory.now
        }
        begunProcessor = processorTime()
        begunWall = Runtime.monotonicNanoseconds()
    }

    // And ends, the clock read first.
    fn pause() {
        wall += Runtime.monotonicNanoseconds() - begunWall
        processor += processorTime() - begunProcessor
        if schedule.phase == .Memory {
            memoryTotal = memoryTotal.adding(BenchMemory.now, less: begunMemory)
            Runtime.countMemory(false)
        } else if schedule.phase == .Counters {
            instructions = begunInstructions < 0 ? -1 : instructions + Runtime.measurement(2) - begunInstructions
            cycles = begunCycles < 0 ? -1 : cycles + Runtime.measurement(3) - begunCycles
        }
    }

    // The run is over.
    fn finish() {
        if schedule.phase == .Memory {
            memory = memoryTotal.divided(by: F64(schedule.iterations))
        } else if schedule.phase == .Counters && (instructions >= 0 || cycles >= 0) {
            let count = F64(schedule.iterations)
            counters = BenchCounters(instructions: instructions < 0 ? -1.0 : F64(instructions) / count, cycles: cycles < 0 ? -1.0 : F64(cycles) / count)
        }
        schedule.record(wall: F64(wall), processor: F64(processor))
        wall = 0
        processor = 0
    }

    fn end() {
        pause()
        finish()
    }

    // Of this process and of those it has waited for.
    fn processorTime() -> Int {
        return Runtime.measurement(0) + Runtime.measurement(1)
    }
}
