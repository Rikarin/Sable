module FileLinesBench

import Sable.IO

// Files: 300,000 lines written as one text, then read back a line at a time.

@main
fn main() throws(IoError) {
    var lines: String[>..] = []
    for i in 0..<300000 {
        lines.append("line \(i) of the file, with some more text after it\n")
    }
    try File.write("file-lines-sable.txt", lines.joined())
    var count = 0
    var characters = 0
    for try line in try File.lines("file-lines-sable.txt") {
        count += 1
        characters += line.count
    }
    try File.remove("file-lines-sable.txt")
    print("\(count) \(characters)")
}
