module Sable.Core

/// A value that can be put back as it was made, keeping what it allocated:
/// what an object pool calls as a value comes back, so that the next to
/// rent it finds it empty — .NET's `IResettable`.
///
/// ```sable
/// struct Scratch: Resettable {
///     var lines: String[>..]
///
///     mutating fn reset() {
///         lines.removeAll(keepingCapacity: true)
///     }
/// }
/// var scratch = Scratch { lines: [] }
/// scratch.lines.append("used")
/// scratch.reset()
/// assert(scratch.lines.isEmpty)
/// ```
public protocol Resettable {
    /// Back to empty, as made, with the room it has kept.
    mutating fn reset()
}

extension<Element> Element[>..]: Resettable {
    /// Every element taken out, the room kept.
    ///
    /// ```sable
    /// var scratch: Int[>..] = [1, 2, 3]
    /// scratch.reset()
    /// assert(scratch.isEmpty && scratch.capacity >= 3)
    /// ```
    public mutating fn reset() {
        removeAll(keepingCapacity: true)
    }
}
