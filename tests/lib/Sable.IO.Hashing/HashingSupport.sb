module HashingSupport

// What Sable.IO.Hashing's tests are written with: xxHash's sanity buffer, and
// each hash of its first so many bytes, as xxHash's own code (Python's xxhash
// 3.7), zlib (Adler-32) and a CRC computed a bit at a time from the CRC
// catalogue's parameters (tools/conformance/hashing/run.py) give them.
// tools/conformance/hashing runs every length to 4160.

import Sable.IO.Hashing
import Sable.Testing

/// xxHash's sanity buffer (tests/sanity_test.c): each byte the top of a
/// product, multiplied on by PRIME64 a byte.
public fn sanityBuffer(_ count: Int) -> U8[>..] {
    var bytes = U8[>..](repeating: 0, count: count)
    var generator: U64 = 2654435761
    var i = 0
    while i < count {
        bytes[i] = U8(generator >> 56)
        generator = generator &* 11400714785074694797
        i += 1
    }
    return bytes
}

/// The lengths of the buffer the vectors are of.
public let vectorLengths = [0, 1, 3, 4, 8, 9, 16, 17, 63, 64, 65, 128, 129, 240, 241, 1024, 1025, 4160]

/// The seed of the seeded vectors: XXH32's its low half.
public let vectorSeed: U64 = 0x9E37_79B1_85EB_CA8D

