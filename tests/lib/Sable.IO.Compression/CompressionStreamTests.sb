module CompressionStreamTests

// Readers that decompress and writers that compress, over memory and over a
// pipe, with reads that give a few bytes at a time.

import CompressionData
import Sable.IO
import Sable.IO.Compression
import Sable.Testing

/// A reader that gives at most a few bytes a read.
struct Trickle: Reader {
    var bytes: U8[>..]
    var position: Int = 0

    mutating fn read(upTo count: Int) throws(IoError) -> U8[>..] {
        let take = count < 7 ? count : 7
        let end = position + take < bytes.count ? position + take : bytes.count
        let got = bytes[position..<end].toArray()
        position = end
        return got
    }
}

/// A writer that cannot be written to.
struct Full: Writer {
    mutating fn write(_ bytes: U8[:]) throws(IoError) {
        throw .Failed(path: "full")
    }

    mutating fn flush() throws(IoError) { }
}

@test
fn readersDecompress() throws {
    let bytes = sample(7, 200_000)
    var gzip = GzipReader(Trickle(bytes: join(Gzip.compress(bytes), Gzip.compress([1, 2]))))
    expect(try gzip.readToEnd() == join(bytes, [1, 2]))
    expect(try gzip.read(upTo: 10).isEmpty)
    var zlib = ZlibReader(Trickle(bytes: join(Zlib.compress(bytes), [5])))
    var all: U8[>..] = []
    while true {
        let read = try zlib.read(upTo: 1000)
        expect(read.count <= 1000)
        if read.isEmpty {
            break
        }
        all.append(contentsOf: read)
    }
    expect(all == bytes)
    var raw = DeflateReader(MemoryStream(join(Deflate.compress(bytes), [5, 6])))
    expect(try raw.readToEnd() == bytes && raw.unread.toArray() == [5, 6])
    expect(try raw.read(upTo: 0).isEmpty)
    var trailed = GzipReader(MemoryStream(join(Gzip.compress([1]), [7, 8])))
    expect(try trailed.readToEnd() == [1] && trailed.unread.toArray() == [7, 8])
}

@test
fn readersSayWhatIsWrong() {
    let packed = Gzip.compress(sample(4, 1000))
    var short = GzipReader(MemoryStream(packed[..<(packed.count - 1)].toArray()))
    expectThrows(saying: IoError.UnexpectedEof.description()) { _ = try short.readToEnd() }
    var empty = GzipReader(MemoryStream())
    expectThrows(saying: IoError.UnexpectedEof.description()) { _ = try empty.readToEnd() }
    var changed = packed
    changed[0] = 0
    var damagedReader = GzipReader(MemoryStream(changed))
    expectThrows(saying: IoError.InvalidData(what: "the data is corrupt: no gzip header").description()) { _ = try damagedReader.readToEnd() }
    let limits = DecompressionLimits(maximumLength: 999)
    var limited = GzipReader(MemoryStream(packed), decoder: GzipDecoder(limits: limits))
    expectThrows(saying: IoError.InvalidData(what: "more would be decompressed than the limits allow").description()) { _ = try limited.readToEnd() }
}

@test(tags: ["slow"], timeout: .minutes(1))
fn writersCompress() throws {
    let bytes = sample(4, 300_000)
    let gzip = GzipWriter(MemoryStream(), encoder: GzipEncoder(level: 9))
    let zlib = ZlibWriter(MemoryStream())
    let raw = DeflateWriter(MemoryStream())
    var at = 0
    while at < bytes.count {
        let piece = bytes[at..<(at + 1000)]
        try gzip.write(piece)
        try zlib.write(piece)
        try raw.write(piece)
        at += 1000
        if at == 100_000 {
            try zlib.flush()
            var reader = ZlibReader(MemoryStream(zlib.inner.bytes))
            assertEqual(try reader.readExactly(100_000), bytes[..<100_000].toArray())
        }
    }
    try gzip.finish()
    try gzip.finish()
    try gzip.flush()
    try zlib.finish()
    try raw.finish()
    expect(try Gzip.decompress(gzip.inner.bytes) == bytes)
    expect(try Zlib.decompress(zlib.inner.bytes) == bytes)
    expect(try Deflate.decompress(raw.inner.bytes) == bytes)
    let full = GzipWriter(Full())
    expectThrows(saying: IoError.Failed(path: "full").description()) { try full.finish() }
}

/// A class over the bytes written, to look at them once the writer is gone.
final class Kept: Writer {
    var bytes: U8[>..] = []

    fn write(_ written: U8[:]) throws(IoError) {
        bytes.append(contentsOf: written)
    }

    fn flush() throws(IoError) { }
}

@test
fn lettingGoOfAWriterFinishesIt() throws {
    let kept = Kept()
    if true {
        let writer = GzipWriter(kept)
        try writer.write([1, 2, 3])
    }
    expect(try Gzip.decompress(kept.bytes) == [1, 2, 3])
}

@test
fn theAsyncOnesToo() async throws {
    let bytes = sample(4, 50_000)
    let pipe = Pipe(pauseWriterThreshold: 1 << 20)
    let writer = AsyncGzipWriter(pipe.writer)
    try await writer.write(bytes[..<20_000])
    try await writer.flush()
    try await writer.write(bytes[20_000...])
    try await writer.finish()
    try await writer.finish()
    await pipe.writer.complete()
    let reader = AsyncGzipReader(pipe.reader)
    var all: U8[>..] = []
    while true {
        let read = try await reader.read(upTo: 3000)
        if read.isEmpty {
            break
        }
        all.append(contentsOf: read)
    }
    expect(all == bytes)
    expect(try await reader.read(upTo: 10).isEmpty && reader.unread.isEmpty)

    let short = Pipe()
    try await short.writer.write([0x1F, 0x8B])
    await short.writer.complete()
    let cut = AsyncGzipReader(short.reader)
    await expectThrows(saying: IoError.UnexpectedEof.description()) { _ = try await cut.read(upTo: 10) }

    let wrong = Pipe()
    try await wrong.writer.write([9, 9, 9, 9, 9, 9, 9, 9, 9, 9])
    await wrong.writer.complete()
    let bad = AsyncZlibReader(wrong.reader)
    await expectThrows(saying: "the data is corrupt: no zlib header") { _ = try await bad.read(upTo: 10) }
}

@test
fn aStepSaysWhatItDid() throws {
    let packed = Zlib.compress([1, 2])
    let decoder = ZlibDecoder()
    var bytes = ByteBuffer()
    let step = try decoder.decompress(packed, into: &bytes)
    expect(step == CompressionProgress(consumed: packed.count, produced: 2, status: .Finished))
    expect(decoder.isFinished && step.status.debugDescription() == "CompressionStatus.Finished")
}

let errors: (CompressionError, String)[>..] = [
    (.Truncated, "the data ends before the stream does"),
    (.LimitExceeded, "more would be decompressed than the limits allow"),
    (.DictionaryNeeded(id: 7), "the data needs the dictionary 7"),
    (.Corrupt("it is odd"), "the data is corrupt: it is odd"),
    (.WindowTooLarge(bytes: 9), "the data needs a window of 9 bytes"),
]

@test(arguments: errors)
fn errorsSayWhatTheyAre(_ error: CompressionError, _ text: String) {
    expect(error.description() == text)
}

@test
fn errorsAreEqualWhenTheySayTheSame() {
    expect(CompressionError.LimitExceeded != CompressionError.Truncated)
    expect(CompressionError.WindowTooLarge(bytes: 1) != .WindowTooLarge(bytes: 2))
}
