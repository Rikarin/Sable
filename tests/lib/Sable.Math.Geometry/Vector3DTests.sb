module Vector3DTests

import Sable.Math.Geometry
import Sable.Serialize
import Sable.Testing

let a: Vector3D = Vector3D(1, 5, -3)
let b: Vector3D = Vector3D(4, 2, 0.5)

@test
fn itsLayoutIsItsComponentsInOrder() {
    assertEqual(MemoryLayout<Vector3D>.size, 24)
    assertEqual(MemoryLayout<Vector3D>.stride, 24)
    assertEqual(MemoryLayout<Vector3D>.alignment, 8)
    assertEqual(Vector3D.componentCount, 3)
    let all: F64[>..] = [a.x, a.y, a.z]
    assertEqual(all, [1, 5, -3])
}

@test
fn itsComponentsAreReadAndWrittenByIndex() {
    var v = a
    for i in 0..<3 {
        assertEqual(v[i], a[i])
        v[i] = b[i]
    }
    assertEqual(v, b)
    expectPanic("has no component 3") {
        _ = a[3]
    }
    expectPanic("has no component -1") {
        var v = a
        v[-1] = 0
    }
}

@test
fn arithmeticIsByComponent() {
    assertEqual(a + b, Vector3D(5, 7, -2.5))
    assertEqual(a - b, Vector3D(-3, 3, -3.5))
    assertEqual(a * b, Vector3D(4, 10, -1.5))
    assertEqual(a / b, Vector3D(0.25, 2.5, -6.0))
    assertEqual(a * 2, Vector3D(2, 10, -6))
    assertEqual(2 * a, Vector3D(2, 10, -6))
    assertEqual(a / 2, Vector3D(0.5, 2.5, -1.5))
    assertEqual(-a, Vector3D(-1, -5, 3))
    var v = a
    v += b
    v -= b
    v *= 2
    assertEqual(v, a * 2)
    assertEqual([a, b].reduce(Vector3D.zero) { $0 + $1 }, a + b)
}

@test
fn lengthsAndDistancesAgreeWithTheirSquares() {
    let v = Vector3D(3, 4, 12)
    assertEqual(v.length, 13)
    assertEqual(v.lengthSquared, 169)
    assertEqual(Vector3D.zero.distance(to: v), 13)
    assertEqual(Vector3D.zero.distanceSquared(to: v), 169)
    assertEqual(a.dot(b), 12.5)
    assertEqual(a.sum, 3)
}

@test
fn aVectorIsMadeUnitAndAVanishingOneZero() {
    expect(nearEqual(a.normalized().length, 1))
    assertEqual(Vector3D.zero.normalized(), Vector3D.zero)
    assertEqual((a * 1e-15).normalized(), Vector3D.zero)
    expect(!Vector3D.zero.normalized().isNaN)
}

@test
fn theLeastTheGreatestAndTheBoundsAreByComponent() {
    assertEqual(a.min(b), Vector3D(1, 2, -3))
    assertEqual(a.max(b), Vector3D(4, 5, 0.5))
    assertEqual(a.abs(), Vector3D(1, 5, 3))
    assertEqual(a.clamped(lower: Vector3D.zero, upper: Vector3D(repeating: 3)), Vector3D(1, 3, 0))
    assertEqual(a.minComponent, -3)
    assertEqual(a.maxComponent, 5)
    let nan = Vector3D(repeating: F64.nan)
    expect(a.min(nan).isNaN && a.max(nan).isNaN && nan.minComponent.isNaN)
    expect(Vector3D.zero.min(-Vector3D.zero).x.isSignMinus)
    expect(!(-Vector3D.zero).max(Vector3D.zero).x.isSignMinus)
}

@test
fn roundingIsByComponent() {
    let v = Vector3D(1.5, -2.5, 0.25)
    assertEqual(v.floor(), Vector3D(1, -3, 0))
    assertEqual(v.ceil(), Vector3D(2, -2, 1))
    assertEqual(v.truncated(), Vector3D(1, -2, 0))
    assertEqual(v.rounded(), Vector3D(2, -2, 0))
    assertEqual(Vector3D(4, 9, 16).squareRoot(), Vector3D(2, 3, 4))
    assertEqual(a.map { $0 + 1 }, a + Vector3D.one)
}

@test
fn itIsInterpolatedInALine() {
    assertEqual(a.lerp(to: b, 0), a)
    assertEqual(Vector3D.zero.lerp(to: Vector3D.one * 4, 0.5), Vector3D.one * 2)
    assertEqual(Vector3D.zero.lerp(to: Vector3D.one, 2), Vector3D.one * 2)
}

@test
fn itIsReflectedAndProjected() {
    let up = Vector3D.unitY
    assertEqual(Vector3D(1, -1, 0).reflected(normal: up), Vector3D(1, 1, 0))
    assertEqual(Vector3D(3, 4, 0).projected(onto: Vector3D.unitX), Vector3D(3, 0, 0))
    assertEqual(a.projected(onto: Vector3D.zero), Vector3D.zero)
}

@test
fn equalityIsExactAndNearEqualIsNot() {
    let almost = Vector3D.one
    var nudged = almost
    nudged.x = 1.0000000000005
    expect(almost != nudged)
    expect(almost.nearEqual(nudged))
    for i in 0..<3 {
        var other = almost
        other[i] = 1.5
        require(almost != other)
        require(!almost.nearEqual(other))
        require(almost.nearEqual(other, tolerance: 0.5))
    }
    let nan = Vector3D(repeating: F64.nan)
    expect(nan != nan && nan.isNaN && !nan.isFinite)
    expect(-Vector3D.zero == Vector3D.zero)
    assertEqual((-Vector3D.zero).hashValue, Vector3D.zero.hashValue)
    assertEqual(a.hashValue, Vector3D(1, 5, -3).hashValue)
    expect(Vector3D.zero.isZero && !a.isZero && !a.isNaN && a.isFinite)
    expect(!Vector3D(repeating: F64.infinity).isFinite)
}

@test
fn itIsWrittenAsItsComponents() {
    let v = Vector3D(1.5, -2.25, 0)
    assertEqual("\(v)", "(1.5, -2.25, 0.0)")
    assertEqual("\(v:.2)", "(1.50, -2.25, 0.00)")
    assertEqual("\(v:>40.0)".count, 40)
    assertEqual("\(v:?)", "Vector3D(1.5, -2.25, 0.0)")
    assertEqual(v.debugDescription(), "Vector3D(1.5, -2.25, 0.0)")
}

@test
fn itIsSerialisedByName() {
    let v = Vector3D(1.5, -2.25, 0)
    assertEqual(try! Json.decode(Vector3D.self, from: try! Json.encode(v)), v)
    expect(try! Json.encode(v).contains("\"y\":-2.25"))
}

@test
fn itIsMadeF32sNearAnOrigin() {
    let origin = Vector3D(repeating: 100_000_000)
    let there = origin + Vector3D(0.125, 0.25, 0.5)
    assertEqual(there.relative(to: origin), Vector3(0.125, 0.25, 0.5))
    assertEqual(Vector3D(Vector3.one), Vector3D.one)
    assertEqual(Vector3D.one.toF32, Vector3.one)
}

@test
fn theCrossProductIsRightHanded() {
    assertEqual(Vector3D.unitX.cross(Vector3D.unitY), Vector3D.unitZ)
    assertEqual(Vector3D.unitY.cross(Vector3D.unitZ), Vector3D.unitX)
    assertEqual(Vector3D.unitZ.cross(Vector3D.unitX), Vector3D.unitY)
    assertEqual(a.cross(b).dot(a), 0)
}

@test
fn theDirectionsAreNamed() {
    assertEqual(Vector3D.up, Vector3D(0, 1, 0))
    assertEqual(Vector3D.down, -Vector3D.up)
    assertEqual(Vector3D.right, Vector3D(1, 0, 0))
    assertEqual(Vector3D.left, -Vector3D.right)
    assertEqual(Vector3D.forward, Vector3D(0, 0, -1))
    assertEqual(Vector3D.backward, -Vector3D.forward)
}
