module Sable.Net.Tls

import Sable.Crypto.X509
import Sable.IO

/// A TLS 1.3 connection over a stream, of a client (`connect`) or of a
/// server (`accept`): what is written is sealed before it goes, and what is
/// read was opened as it came. The stream is any `AsyncReader &
/// AsyncWriter`, a `TcpStream` most often. Read it from one task at a time,
/// and write it from one at a time.
///
/// ```sable
/// fn fetch<S: AsyncReader & AsyncWriter>(over tcp: S) async throws -> U8[>..] {
///     let tls = try await TlsStream.connect(tcp, host: "localhost")
///     try await tls.write("GET / HTTP/1.0\r\n\r\n".utf8Bytes())
///     return try await tls.read(upTo: 4096)
/// }
///
/// fn answer<S: AsyncReader & AsyncWriter>(over tcp: S, _ options: TlsServerOptions) async throws {
///     let tls = try await TlsStream.accept(tcp, options: options)
///     _ = try await tls.read(upTo: 4096)
///     try await tls.write("HTTP/1.0 204 No Content\r\n\r\n".utf8Bytes())
///     try await tls.close()
/// }
/// ```
public final class TlsStream<S: AsyncReader & AsyncWriter>: AsyncReader, AsyncWriter {
    let transport: S
    var client: TlsClientConnection? = none
    var server: TlsServerConnection? = none
    /// What the transport is read into, made once and grown to a record's
    /// size if reads fill it.
    var buffer: U8[>..] = []

    /// Application data opened and not yet read, from 'pendingAt' on.
    var pending: U8[>..] = []
    var pendingAt = 0

    init(_ transport: S) {
        self.transport = transport
    }

    /// A connection to the host over the stream, once its handshake is
    /// over: the server's certificate must be the host's, as the options
    /// say it is checked.
    public static fn connect(_ transport: S, host: String, options: TlsClientOptions = TlsClientOptions()) async throws(TlsError) -> TlsStream<S> {
        return try await TlsStream<S>.connect(transport, connection: TlsClientConnection(host: host, options: options))
    }

    /// The client connection given over the stream, once its handshake is
    /// over.
    public static fn connect(_ transport: S, connection: TlsClientConnection) async throws(TlsError) -> TlsStream<S> {
        let stream = TlsStream<S>(transport)
        stream.client = connection
        try await stream.handshake()
        return stream
    }

    /// The server's end of a connection a client made over the stream, once
    /// its handshake is over.
    public static fn accept(_ transport: S, options: TlsServerOptions) async throws(TlsError) -> TlsStream<S> {
        return try await TlsStream<S>.accept(transport, connection: TlsServerConnection(options: options))
    }

    /// The server connection given over the stream, once its handshake is
    /// over.
    public static fn accept(_ transport: S, connection: TlsServerConnection) async throws(TlsError) -> TlsStream<S> {
        let stream = TlsStream<S>(transport)
        stream.server = connection
        try await stream.handshake()
        return stream
    }

    fn handshake() async throws(TlsError) {
        try await flush()
        while !isHandshakeComplete {
            if !(try await pull()) {
                throw TlsError.Failed(.handshakeFailure, reason: "the stream ended in the handshake")
            }
            try await flush()
        }
    }

    /// The application protocol chosen; none if none was.
    public var applicationProtocol: String? => client != none ? client!.applicationProtocol : server!.applicationProtocol

    /// The suite the records are sealed with.
    public var cipherSuite: TlsCipherSuite => client != none ? client!.cipherSuite! : server!.cipherSuite!

    /// The name the client asked the server for; on a client's stream, the
    /// host connected to.
    public var serverName: String? => client != none ? client!.host : server!.serverName

    /// The other end's certificates as it sent them, its own first: the
    /// server's, on a client's stream, and the client's, if it sent any, on a
    /// server's.
    public var peerCertificates: Certificate[>..] => client != none ? client!.peerCertificates : server!.peerCertificates

    /// Whether the handshake resumed a session of a ticket.
    public var isResumed: Bool => client != none ? client!.isResumed : server!.isResumed

    var isHandshakeComplete: Bool => client != none ? client!.isHandshakeComplete : server!.isHandshakeComplete

    var isPeerClosed: Bool => client != none ? client!.isPeerClosed : server!.isPeerClosed

    fn takeReceived() -> U8[>..] {
        if client != none {
            return client!.takeReceived()
        }
        return server!.takeReceived()
    }

    fn takeOutgoing() -> U8[>..] {
        if client != none {
            return client!.takeOutgoing()
        }
        return server!.takeOutgoing()
    }

    /// The room of the bytes sent, kept for the next to be sealed into.
    fn reuseOutgoing(_ bytes: U8[>..]) {
        if client != none {
            client!.records.reuseOutgoing(bytes)
        } else {
            server!.records.reuseOutgoing(bytes)
        }
    }

    fn receive(_ bytes: U8[:]) throws(TlsError) {
        if client != none {
            try client!.receive(bytes)
        } else {
            try server!.receive(bytes)
        }
    }

    /// Up to 'count' bytes of application data, as soon as any have come;
    /// none once the other end has closed the connection. A fault of TLS is
    /// `InvalidData`.
    public fn read(upTo count: Int) async throws(IoError) -> U8[>..] {
        while true {
            if pendingAt == pending.count {
                pending = takeReceived()
                pendingAt = 0
            }
            if pendingAt < pending.count {
                // All of it handed over when it fits, and a copy of some when not.
                if pendingAt == 0 && pending.count <= count {
                    let taken = pending
                    pending = []
                    return taken
                }
                let end = pending.count - pendingAt > count ? pendingAt + count : pending.count
                let taken = pending[pendingAt..<end].toArray()
                pendingAt = end
                if pendingAt == pending.count {
                    pending = []
                    pendingAt = 0
                }
                return taken
            }
            if isPeerClosed {
                return []
            }
            var more = false
            do {
                more = try await pull()
                try await flush()
            } catch {
                throw TlsStream<S>.ioError(error)
            }
            if !more {
                throw IoError.UnexpectedEof
            }
        }
    }

    /// The bytes sealed and sent.
    public fn write(_ bytes: U8[:]) async throws(IoError) {
        do {
            if client != none {
                try client!.write(bytes)
            } else {
                try server!.write(bytes)
            }
            try await flush()
        } catch {
            throw TlsStream<S>.ioError(error)
        }
    }

    /// close_notify sent: this end writes no more.
    public fn close() async throws(IoError) {
        if client != none {
            client!.close()
        } else {
            server!.close()
        }
        do {
            try await flush()
        } catch {
            throw TlsStream<S>.ioError(error)
        }
    }

    /// Whether more came from the stream; what came is read.
    fn pull() async throws(TlsError) -> Bool {
        // The buffer taken out while it is read into, so that it is no
        // other's to copy.
        var bytes = buffer
        buffer = []
        if bytes.isEmpty {
            bytes = U8[>..](repeating: 0, count: TlsStream<S>.firstReadByteCount)
        }
        var got = 0
        do {
            got = try await transport.read(into: &bytes)
        } catch {
            buffer = bytes
            throw TlsError.Io(error)
        }
        if got == 0 {
            buffer = bytes
            return false
        }
        do {
            try receive(bytes[0..<got])
        } catch {
            let failure = error
            buffer = bytes
            _ = try? await transport.write(takeOutgoing())
            throw failure
        }
        if got == bytes.count && bytes.count < TlsStream<S>.readByteCount {
            bytes = U8[>..](repeating: 0, count: TlsStream<S>.readByteCount)
        }
        buffer = bytes
        return true
    }

    /// A read's bytes at first, enough for a handshake's, and once reads
    /// fill that, a whole record's.
    static var firstReadByteCount: Int => 4096
    static var readByteCount: Int => 5 + TlsRecordCipher.maximumContentByteCount + 256

    fn flush() async throws(TlsError) {
        var bytes = takeOutgoing()
        if bytes.isEmpty {
            return
        }
        do {
            try await transport.write(bytes)
        } catch {
            throw TlsError.Io(error)
        }
        bytes.removeAll(keepingCapacity: true)
        reuseOutgoing(bytes)
    }

    static fn ioError(_ error: TlsError) -> IoError {
        if case .Io(let inner) = error {
            return inner
        }
        return IoError.InvalidData(what: "TLS: \(error.description())")
    }
}
