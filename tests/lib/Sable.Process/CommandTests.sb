module CommandTests

// Command and Stdio (Sable.Process), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Process

import Sable.Concurrency
import Sable.IO
import Sable.Net
import Sable.Process
import Sable.Testing
import Sable.Time

import ProcessSupport

// Shells, paths and signals as POSIX has them; Windows' are tested by
// Sable.CodeGen.Tests' ProcessTests.
#if !os(windows)

// ---- What it is given -------------------------------------------------------

@test
fn aCommandIsAValue() {
    let one = Command("echo").argument("a")
    let two = one.arguments(["b", "c"])
    assertEqual(one.program, "echo")
    expect(one.argumentList == ["a"])
    expect(two.argumentList == ["a", "b", "c"])
}

@test
fn argumentsReachTheProgramAsTheyAre() async {
    let odd: String[>..] = ["two words", "", "\"quoted\"", "it's", "*", "$HOME", "a;b", "back\\slash\\", "\\\"", "ünï", "new\nline"]
    var expected = ""
    for argument in odd {
        expected += "<" + argument + ">"
    }
    let done = try! await Command("printf").argument("<%s>").arguments(odd).output()
    assertEqual(done.output, expected)
}

@test
fn theEnvironmentIsThisProgramsAndWhatIsSet() async {
    unsafe {
        Environment.set("SABLE_COMMAND_INHERITED", "yes")
        Environment.set("SABLE_COMMAND_REPLACED", "old")
        Environment.set("SABLE_COMMAND_REMOVED", "old")
    }
    let done = try! await sh("echo $SABLE_COMMAND_INHERITED $SABLE_COMMAND_REPLACED $SABLE_COMMAND_ADDED ${SABLE_COMMAND_REMOVED-unset}")
        .environment("SABLE_COMMAND_REPLACED", "new").environment("SABLE_COMMAND_ADDED", "a=b").removeEnvironment("SABLE_COMMAND_REMOVED").output()
    assertEqual(done.output, "yes new a=b unset\n")
    // And this program's own is as it was.
    expect(Environment.variable("SABLE_COMMAND_REPLACED") == "old")
    expect(Environment.variable("SABLE_COMMAND_ADDED") == none)
}

@test
fn aClearedEnvironmentHasOnlyWhatIsSetAfter() async {
    let done = try! await Command("env").environment("BEFORE", "1").clearEnvironment().environment("ONLY", "this").output()
    assertEqual(done.output, "ONLY=this\n")
    let nothing = try! await Command("env").clearEnvironment().output()
    assertEqual(nothing.output, "")
}

@test
fn aVariableRemovedAndSetAgainIsSet() async {
    let done = try! await sh("echo $SABLE_COMMAND_AGAIN").removeEnvironment("SABLE_COMMAND_AGAIN").environment("SABLE_COMMAND_AGAIN", "set").output()
    assertEqual(done.output, "set\n")
}

@test
fn itStartsInItsDirectory() async {
    let done = try! await Command("pwd").workingDirectory("/").output()
    assertEqual(done.output, "/\n")
}

@test
fn aPathIsFoundFromThisProgramsDirectory() async {
    let name = "sable-process-\(Process.id())-here"
    var options = OpenOptions.writing
    options.permissions = 0o755
    let file = try! File.open(name, options: options)
    try! file.write("#!/bin/sh\npwd\n".utf8.toArray())
    file.close()
    let done = try! await Command("./" + name).workingDirectory("/").output()
    try! File.remove(name)
    assertEqual(done.output, "/\n")
}

@test
fn itHasNoneOfThisProgramsFiles(files: TemporaryFiles) async {
    let before = try! await Command("ls").argument("/dev/fd").output()
    let path = files.path("open")
    let file = try! File.open(path, options: .writing)
    let listener = try! TcpListener.bind(SocketAddress(.v4Loopback, port: 0))
    let other = try! Command("cat").stdin(.Piped).stdout(.Piped).spawn()
    let after = try! await Command("ls").argument("/dev/fd").output()
    other.kill()
    _ = try! await other.wait()
    file.close()
    listener.close()
    // Its three streams, and what 'ls' opened to look.
    expect(after.output.contains("2\n") && !after.output.contains("5"), after.output)
    assertEqual(after.output, before.output)
}

@test
fn itsBrokenPipesAreItsOwn() async {
    // 'yes' ends by SIGPIPE, which it must not have been given ignored.
    let done = try! await sh("yes | head -n 1").output()
    assertEqual(done.output, "y\n")
}

// ---- Its streams --------------------------------------------------------------

@test
fn nothingIsReadUnlessSaid() async {
    let done = try! await Command("cat").output()
    expect(done.succeeded && done.output == "")
}

@test
fn aStreamCanBeAFile(files: TemporaryFiles) async {
    let input = files.path("in")
    let output = files.path("out")
    try! File.writeBytes(input, "from a file".utf8.toArray())
    let status = try! await Command("cat").stdin(.File(path: input)).stdout(.File(path: output)).status()
    expect(status.success)
    expect(try! File.readBytes(output) == "from a file".utf8.toArray())
    // Emptied as it is opened.
    let again = try! await sh("printf x").stdout(.File(path: output)).status()
    expect(again.success)
    expect(try! File.readBytes(output) == [0x78])
}

@test
fn outputAndErrorsToOneFileAreInOrder(files: TemporaryFiles) async {
    let path = files.path("both")
    let status = try! await sh("echo one; echo two >&2; echo three").stdout(.File(path: path)).stderr(.File(path: path)).status()
    expect(status.success)
    expect(try! File.readBytes(path) == "one\ntwo\nthree\n".utf8.toArray())
}

@test
fn nothingIsKeptOfAStreamThatIsNothing() async {
    let done = try! await sh("echo out; echo err >&2").stderr(.Null).output()
    assertEqual(done.output, "out\n")
    assertEqual(done.errors, "")
}

@test
fn aStreamPipedToNoOneIsNothing() async {
    // Nothing reads them: piped, it would wait for ever.
    let status = try! await sh("head -c 1000000 /dev/zero").stdin(.Piped).stdout(.Piped).stderr(.Piped).status()
    expect(status.success)
}

@test
fn moreThanAPipeHoldsToBothDoesNotWait() async {
    let done = try! await sh("head -c 3000000 /dev/zero; head -c 3000000 /dev/zero >&2; head -c 1000 /dev/zero").output()
    assertEqual(done.outputBytes.count, 3001000)
    assertEqual(done.errorBytes.count, 3000000)
}

@test
fn moreThanAPipeHoldsBothWaysDoesNotWait() async {
    var bytes: U8[>..] = []
    var i = 0
    while i < 2_000_000 {
        bytes.append(U8.truncating(i * 31))
        i += 1
    }
    let done = try! await Command("cat").output(input: bytes)
    expect(done.outputBytes == bytes)
}

@test
fn manyAtOnceAllEnd() async {
    let running = (0..<20).map { (i: Int) in
        Task.spawn { try! await sh("echo \(i); head -c 100000 /dev/zero >&2").output() }
    }
    var i = 0
    for task in running {
        let done = await task.value
        assertEqual(done.output, "\(i)\n")
        assertEqual(done.errorBytes.count, 100000)
        i += 1
    }
}

// ---- Why it did not start -------------------------------------------------------

@test
fn whatIsNotThereIsNotFound() {
    expectThrows(saying: ProcessError.NotFound(program: "surely-not-a-program").description()) { _ = try Command("surely-not-a-program").spawn() }
    expectThrows(saying: ProcessError.NotFound(program: "/surely/not/here").description()) { _ = try Command("/surely/not/here").spawn() }
    expectThrows(saying: ProcessError.NotFound(program: "").description()) { _ = try Command("").spawn() }
}

@test
fn whatMayNotBeRunIsDenied(files: TemporaryFiles) {
    let path = files.path("plain")
    try! File.writeBytes(path, "#!/bin/sh\n".utf8.toArray())
    expectThrows(saying: ProcessError.PermissionDenied(program: path).description()) { _ = try Command(path).spawn() }
    expectThrows(saying: ProcessError.PermissionDenied(program: "/").description()) { _ = try Command("/").spawn() }
}

@test
fn whatIsNoProgramIsNotExecutable(files: TemporaryFiles) {
    // No shell is asked to make something of it.
    let path = try! files.program("text", "echo no\n")
    expectThrows(saying: ProcessError.NotExecutable(program: path).description()) { _ = try Command(path).spawn() }
}

@test
fn aDirectoryThatIsNotThereIsSaidToBe() {
    expectThrows(saying: ProcessError.NoDirectory(path: "/surely/not/here").description()) { _ = try Command("true").workingDirectory("/surely/not/here").spawn() }
}

@test
fn aFileThatCannotBeOpenedIsSaid() {
    expectThrows(saying: ProcessError.File(path: "/surely/not/here").description()) { _ = try Command("true").stdin(.File(path: "/surely/not/here")).spawn() }
    expectThrows(saying: ProcessError.File(path: "/surely/not/there").description()) { _ = try Command("true").stderr(.File(path: "/surely/not/there")).spawn() }
}

@test
fn whatCannotBeGivenIsRefused() {
    expectThrows(saying: ProcessError.InvalidArgument(text: "\u{0}").description()) { _ = try Command("true").argument("\u{0}").spawn() }
    expectThrows(saying: ProcessError.InvalidArgument(text: "").description()) { _ = try Command("true").environment("", "x").spawn() }
    expectThrows(saying: ProcessError.InvalidArgument(text: "A=B").description()) { _ = try Command("true").environment("A=B", "x").spawn() }
}

// ---- Cancelled -----------------------------------------------------------------

@test
fn oneCancelledIsKilled(files: TemporaryFiles) async {
    let path = files.path("pid")
    let running = Task.spawn {
        await expectThrows(saying: ProcessError.Cancelled.description()) { _ = try await sh("echo $$ > \(path); exec sleep 60").output() }
    }
    var id = ""
    while !id.contains('\n') {
        try? await Task.sleep(for: Duration.milliseconds(5))
        id = (try? File.read(path)) ?? ""
    }
    running.cancel()
    _ = await running.value
    expect(await isGone(id.trimmed()))
}

@test
fn aStatusWaitedForTooLongIsKilled() async {
    let error = await expectThrows(TimeoutError.self) {
        _ = try await withTimeout(Duration.milliseconds(50)) { try await Command("sleep").argument("60").status() }
    }
    expect(error?.duration == Duration.milliseconds(50))
}

@test
fn argumentsAndVariablesNeedNotBeText() async {
    unsafe {
        Environment.set(OsString("SABLE_COMMAND_ODD"), OsString(bytes: [0x61, 0xFF]))
    }
    let odd = OsString(bytes: [0xFE, 0x62])
    let script = "printf '%s %s %s' \"$SABLE_COMMAND_ODD\" \"$SABLE_COMMAND_SET\" \"$0\""
    let command = sh(script).argument(odd).environment("SABLE_COMMAND_SET", odd)
    assertEqual(command.argumentList[2], "\u{FFFD}b")
    assertEqual(try! await command.output().outputBytes, [0x61, 0xFF, 0x20, 0xFE, 0x62, 0x20, 0xFE, 0x62])
    unsafe {
        Environment.remove("SABLE_COMMAND_ODD")
    }
}

@test
fn anArgumentWithANulIsRefused() {
    expectThrows(saying: ProcessError.InvalidArgument(text: "a\u{0}").description()) { _ = try Command("true").argument(OsString(bytes: [0x61, 0])).spawn() }
}

#endif
