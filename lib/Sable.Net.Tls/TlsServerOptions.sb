module Sable.Net.Tls

import Sable.Crypto
import Sable.Crypto.X509
import Sable.Time

/// How a server answers: the certificate chain it sends, its own first,
/// the private key of that certificate, which signs the handshake, and the
/// application protocols (ALPN, RFC 7301) and suites it takes, the one it
/// prefers first. A key of P-256 or P-384 signs with ECDSA, of Ed25519 with
/// Ed25519, and of RSA with RSA-PSS. Tickets of sessions are sealed with a
/// key made with the options, so that servers of the same options resume
/// each other's sessions.
///
/// ```sable
/// let key = EcdsaPrivateKey<P256>.generate().anyKey
/// let certificate = try! CertificateBuilder(subject: DistinguishedName([]), host: "localhost").selfSigned(with: key)
/// var options = TlsServerOptions(certificateChain: [certificate], privateKey: key)
/// options.applicationProtocols = ["h2", "http/1.1"]
/// assert(options.cipherSuites.count == 3)
/// ```
public struct TlsServerOptions: Sendable {
    /// The certificates sent, the server's own first, then each one's
    /// issuer.
    public var certificateChain: Certificate[>..]

    /// The key of the first certificate.
    public var privateKey: PrivateKey

    /// The application protocols taken, the one preferred first; none for a
    /// server that takes no part in ALPN.
    public var applicationProtocols: String[>..] = []

    /// The suites taken, the one preferred first.
    public var cipherSuites: TlsCipherSuite[>..] = TlsCipherSuite.all

    /// The groups of the key exchange taken, the one preferred first: a
    /// client that takes it but sent a share of another is asked for one of
    /// it.
    public var groups: TlsGroup[>..] = TlsGroup.all

    /// The key the tickets of sessions are sealed with, with AES-GCM: 16 or
    /// 32 bytes, made afresh with the options; none for a server that
    /// issues no ticket and resumes no session.
    public var ticketKey: SymmetricKey?

    /// How long after it was issued a ticket is taken; no more than seven
    /// days is said to the client.
    public var ticketLifetime: Duration = Duration.seconds(7200)

    /// Whether the client is asked for a certificate, and whose are
    /// believed.
    public var clientAuthentication: TlsClientAuthentication = .NotAsked

    /// The time tickets are issued and checked at, and clients'
    /// certificates; none is the system's now.
    public var time: UtcDateTime? = none

    public init(certificateChain: Certificate[:], privateKey: PrivateKey) {
        self.certificateChain = certificateChain.toArray()
        self.privateKey = privateKey
        self.ticketKey = SymmetricKey.random(byteCount: 32)
    }
}
