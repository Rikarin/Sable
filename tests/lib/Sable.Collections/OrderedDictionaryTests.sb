module OrderedDictionaryTests

// OrderedDictionary (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn anOrderedDictionaryKeepsTheOrderKeysWereFirstSet() {
    let ages = OrderedDictionary<String, Int>()
    ages.set("cy", 3)
    ages.set("ann", 31)
    ages.set("bo", 40)
    ages.set("cy", 4)
    assertEqual(ages.count, 3)
    assertEqualText(ages.keys().joined(separator: ","), "cy,ann,bo")
    assertEqual(ages.get("cy") ?? -1, 4)
    assertEqual(ages.index(of: "bo") ?? -1, 2)
    assertEqualText(ages.key(at: 1), "ann")
    assertEqual(ages.value(at: 2), 40)
}

@test
fn removingAKeyClosesTheGap() {
    let ages = OrderedDictionary<String, Int>()
    ages.set("a", 1)
    ages.set("b", 2)
    ages.set("c", 3)
    assertEqual(ages.remove("b") ?? -1, 2)
    assert(ages.remove("b") == none, "it is gone")
    assert(!ages.contains("b"))
    assertEqualText(ages.keys().joined(separator: ","), "a,c")
    assertEqual(ages.values().reduce(0) { $0 + $1 }, 4)
    assertEqual(ages.index(of: "c") ?? -1, 1)
    ages.removeAll()
    assert(ages.isEmpty)
}

@test
fn anOrderedDictionaryIsGoneThroughInOrder() {
    let ages = OrderedDictionary<String, Int>()
    ages.set("b", 2)
    ages.set("a", 1)
    var seen: String[>..] = []
    for (key, value) in ages {
        seen.append("\(key)=\(value)")
    }
    assertEqualText(seen.joined(separator: ","), "b=2,a=1")
}
