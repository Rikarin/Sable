module Sable.IO.Compression

/// What a decoder wrote last, in memory: what it may copy from, and, at its
/// end, what has not been given to its caller yet.
struct OutputWindow {
    let block: Block
    /// How many of the bytes before the end must be kept.
    var history: Int
    /// Where the bytes start that may be copied from, the first not given
    /// away, and the end.
    var start: Int
    var drained: Int
    var end: Int

    /// With room for 'room' bytes after the history, and some to spare.
    init(history: Int, room: Int) {
        self.history = history
        block = Block(count: history + room + 64)
        start = block.address
        drained = start
        end = start
    }

    /// Where writing must stop: 64 bytes from where the memory does.
    var limit: Int => block.address &+ block.count &- 64

    /// How many bytes its caller has not been given.
    var pending: Int => end &- drained

    /// As many of them as may be, at the end of the buffer: how many.
    mutating fn drain(into output: inout ByteBuffer, limit: Int) -> Int {
        let count = pending < limit ? pending : limit
        if count > 0 {
            let from = drained
            output.write(reserving: count) { bytes, at in
                unsafe {
                    NativeMemory.copy(from: RawPtr<U8>(address: from), to: &bytes, at: at, byteCount: count)
                }
                return count
            }
            drained = drained + count
        }
        return count
    }

    /// Room made: with nothing pending, all but the history is let go of.
    mutating fn makeRoom() {
        if end &- block.address > history && pending == 0 {
            let keep = end &- start < history ? end &- start : history
            unsafe {
                copyBytes(from: end - keep, to: block.address, keep)
            }
            start = block.address
            end = start + keep
            drained = end
        }
    }

    /// Nothing kept of what was written: what comes next starts anew.
    mutating fn forget() {
        start = end
    }

    /// The bytes as if they had been written, and given away: a dictionary.
    mutating fn preset(_ bytes: U8[:]) {
        let kept = bytes.count < history ? bytes : bytes[bytes.count - history...]
        unsafe {
            NativeMemory.copy(from: kept, to: RawPtr<U8>(address: block.address))
        }
        start = block.address
        end = start + kept.count
        drained = end
    }
}
