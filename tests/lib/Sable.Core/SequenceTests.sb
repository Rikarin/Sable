module SequenceTests

// Iterator and Sequence (Sable.Core), and what every sequence can be asked
// (Sequence+Algorithms.sb): run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

fn text(_ values: Int[:]) -> String {
    return values.map { "\($0)" }.joined(separator: ",")
}

// A sequence of the program's own, by its iterator alone, so that the
// algorithms are tested through the protocol and not only on arrays.
struct Countdown: Sequence {
    let from: Int

    fn makeIterator() -> CountdownIterator {
        return CountdownIterator { remaining: from }
    }
}

struct CountdownIterator: Iterator {
    var remaining: Int

    mutating fn next() -> Int? {
        if remaining <= 0 {
            return none
        }
        remaining -= 1
        return remaining + 1
    }
}

fn total<S: Sequence>(_ values: S) -> Int where S.Element == Int {
    var sum = 0
    for value in values {
        sum += value
    }
    return sum
}

@test
fn aSequenceOfItsOwnGoesThroughAForLoop() {
    var seen: Int[>..] = []
    let countdown = Countdown { from: 3 }
    for value in countdown {
        seen.append(value)
    }
    assertEqualText(text(seen), "3,2,1")
}

@test
fn aSequencesElementIsItsIteratorsElement() {
    assertEqual(total(Countdown { from: 4 }), 10)
    assertEqual(total([1, 2, 3]), 6)
    assertEqual(total(stride(from: 0, to: 10, by: 5)), 5)
}

@test
fn anEmptySequenceGivesNothing() {
    assertEqual(total(Countdown { from: 0 }), 0)
    assertEqual(Countdown { from: 0 }.toArray().count, 0)
}

@test
fn mapTransformsEachElementInOrder() {
    assertEqualText(text(Countdown { from: 3 }.map { $0 * 10 }), "30,20,10")
    assertEqual(Countdown { from: 0 }.map { $0 }.count, 0)
}

@test
fn filterKeepsTheElementsTheClosureAccepts() {
    assertEqualText(text(Countdown { from: 6 }.filter { $0 % 2 == 0 }), "6,4,2")
    assertEqual(Countdown { from: 3 }.filter { $0 < 0 }.count, 0)
}

@test
fn compactMapLeavesOutNone() {
    let kept = Countdown { from: 5 }.compactMap { (value: Int) -> Int? in value % 2 == 1 ? value * 100 : none }
    assertEqualText(text(kept), "500,300,100")
}

@test
fn flatMapJoinsTheSequencesTheClosureMakes() {
    assertEqualText(text(Countdown { from: 3 }.flatMap { Countdown { from: $0 } }), "3,2,1,2,1,1")
}

@test
fn reduceCombinesFromTheInitialValue() {
    assertEqual(Countdown { from: 4 }.reduce(100) { $0 - $1 }, 90)
    assertEqual(Countdown { from: 0 }.reduce(7) { $0 + $1 }, 7)
}

@test
fn forEachVisitsEveryElement() {
    var sum = 0
    Countdown { from: 4 }.forEach { sum += $0 }
    assertEqual(sum, 10)
}

@test
fn firstWhereFindsTheFirstMatch() {
    assertEqual(Countdown { from: 9 }.first(where: { $0 % 4 == 0 }) ?? -1, 8)
    assert(Countdown { from: 3 }.first(where: { $0 > 3 }) == none, "nothing matches")
}

@test
fn containsWhereAndAllSatisfy() {
    assert(Countdown { from: 5 }.contains(where: { $0 == 5 }))
    assert(!Countdown { from: 5 }.contains(where: { $0 == 6 }))
    assert(Countdown { from: 5 }.allSatisfy { $0 > 0 })
    assert(!Countdown { from: 5 }.allSatisfy { $0 > 1 })
    assert(Countdown { from: 0 }.allSatisfy { $0 < 0 }, "true when there are none")
}

@test
fn countWhereCountsTheMatches() {
    assertEqual(Countdown { from: 10 }.count(where: { $0 % 3 == 0 }), 3)
}

@test
fn minAndMaxByAClosure() {
    let values: Int[>..] = [4, 9, 1, 9, 1]
    assertEqual(values.min(by: { $0 < $1 }) ?? -1, 1)
    assertEqual(values.max(by: { $0 < $1 }) ?? -1, 9)
    assert(Countdown { from: 0 }.min(by: { $0 < $1 }) == none, "none when there are none")
    assert(Countdown { from: 0 }.max(by: { $0 < $1 }) == none, "none when there are none")
}

@test
fn minAndMaxByAKeyKeepTheFirstAndLastOfEquals() {
    let words: String[>..] = ["bb", "a", "cc", "d"]
    assertEqualText(words.min(byKey: { $0.count }) ?? "?", "a")
    assertEqualText(words.max(byKey: { $0.count }) ?? "?", "cc")
    assert(Countdown { from: 0 }.min(byKey: { $0 }) == none, "none when there are none")
    assert(Countdown { from: 0 }.max(byKey: { $0 }) == none, "none when there are none")
}

@test
fn minAndMaxOfComparableElements() {
    assertEqual(Countdown { from: 4 }.min() ?? -1, 1)
    assertEqual(Countdown { from: 4 }.max() ?? -1, 4)
}

@test
fn sortedOrdersTheElements() {
    let values: Int[>..] = [5, 3, 8, 1, 9, 2, 7]
    assertEqualText(text(values.sorted()), "1,2,3,5,7,8,9")
    assertEqualText(text(values.sorted(by: { $0 > $1 })), "9,8,7,5,3,2,1")
    assertEqual(Countdown { from: 0 }.sorted().count, 0)
    assertEqualText(text(Countdown { from: 1 }.sorted()), "1")
}

@test
fn sortingIsStable() {
    // By the tens alone: equal keys keep the order they came in.
    let values: Int[>..] = [31, 12, 33, 14, 35, 16, 11]
    assertEqualText(text(values.sorted(by: { $0 / 10 < $1 / 10 })), "12,14,16,11,31,33,35")
    assertEqualText(text(values.sorted(byKey: { $0 / 10 })), "12,14,16,11,31,33,35")
}

@test
fn sortingManyElementsIsCorrect() {
    var values: Int[>..] = []
    var i = 0
    while i < 1000 {
        values.append((i * 7919) % 1000)
        i += 1
    }
    let ordered = values.sorted()
    var j = 0
    while j < 1000 {
        assertEqual(ordered[j], j)
        j += 1
    }
}

@test
fn groupedKeepsEachGroupInOrder() {
    let groups = Countdown { from: 7 }.grouped(by: { $0 % 3 })
    assertEqualText(text(groups[0] ?? []), "6,3")
    assertEqualText(text(groups[1] ?? []), "7,4,1")
    assertEqualText(text(groups[2] ?? []), "5,2")
    assertEqual(groups.count, 3)
}

@test
fn countedCountsEachKey() {
    let counts = Countdown { from: 7 }.counted(by: { $0 % 2 })
    assertEqual(counts[0] ?? -1, 3)
    assertEqual(counts[1] ?? -1, 4)
}

@test
fn distinctKeepsTheFirstOfEach() {
    let values: Int[>..] = [3, 1, 3, 2, 1, 4]
    assertEqualText(text(values.distinct()), "3,1,2,4")
    assertEqualText(text(values.distinct(byKey: { $0 % 2 })), "3,2")
}

@test
fn chunksSplitIntoArraysOfTheSize() {
    let chunks = Countdown { from: 5 }.chunks(of: 2)
    assertEqual(chunks.count, 3)
    assertEqualText(text(chunks[0]), "5,4")
    assertEqualText(text(chunks[2]), "1")
    assertEqual(Countdown { from: 4 }.chunks(of: 2).count, 2)
}

@test(traps: "a chunk's size must be at least 1, not 0")
fn chunksOfNothingTraps() {
    let _ = Countdown { from: 3 }.chunks(of: 0)
}

@test(traps: "a window's size must be at least 1, not 0")
fn windowsOfNothingTraps() {
    let _ = Countdown { from: 3 }.windows(of: 0)
}

@test
fn windowsSlideOneAtATime() {
    let windows = Countdown { from: 4 }.windows(of: 3)
    assertEqual(windows.count, 2)
    assertEqualText(text(windows[0]), "4,3,2")
    assertEqualText(text(windows[1]), "3,2,1")
    assertEqual(Countdown { from: 2 }.windows(of: 3).count, 0)
}

@test
fn partitionedSplitsByTheClosure() {
    let parts = Countdown { from: 6 }.partitioned(by: { $0 > 3 })
    assertEqualText(text(parts.matching), "6,5,4")
    assertEqualText(text(parts.rest), "3,2,1")
}

@test
fn prefixAndDropFirst() {
    assertEqualText(text(Countdown { from: 5 }.prefix(2)), "5,4")
    assertEqualText(text(Countdown { from: 2 }.prefix(5)), "2,1")
    assertEqual(Countdown { from: 5 }.prefix(0).count, 0)
    assertEqualText(text(Countdown { from: 5 }.dropFirst(3)), "2,1")
    assertEqual(Countdown { from: 2 }.dropFirst(5).count, 0)
}

@test
fn suffixAndDropLast() {
    assertEqualText(text(Countdown { from: 5 }.suffix(2)), "2,1")
    assertEqualText(text(Countdown { from: 2 }.suffix(5)), "2,1")
    assertEqual(Countdown { from: 5 }.suffix(0).count, 0)
    assertEqual(Countdown { from: 5 }.suffix(-1).count, 0)
    assertEqualText(text(Countdown { from: 5 }.dropLast(3)), "5,4")
    assertEqual(Countdown { from: 2 }.dropLast(5).count, 0)
    assertEqualText(text(Countdown { from: 2 }.dropLast(0)), "2,1")
}

@test
fn splitKeepsTheRunsBetweenSeparators() {
    let values: Int[>..] = [1, 0, 2, 3, 0, 0, 4]
    let runs = values.split(where: { $0 == 0 })
    assertEqual(runs.count, 4)
    assertEqualText(text(runs[0]), "1")
    assertEqualText(text(runs[1]), "2,3")
    assertEqual(runs[2].count, 0)
    assertEqualText(text(runs[3]), "4")
    assertEqual(Countdown { from: 0 }.split(where: { $0 == 0 }).count, 1)
}

@test
fn interspersedPutsTheSeparatorBetween() {
    assertEqualText(text(Countdown { from: 3 }.interspersed(with: 0)), "3,0,2,0,1")
    assertEqualText(text(Countdown { from: 1 }.interspersed(with: 0)), "1")
    assertEqual(Countdown { from: 0 }.interspersed(with: 0).count, 0)
}

@test
fn joinedFlattensASequenceOfSequences() {
    let nested: Int[>..][>..] = [[1, 2], [], [3]]
    assertEqualText(text(nested.joined()), "1,2,3")
    assertEqualText(text(Countdown { from: 2 }.map { Countdown { from: $0 } }.joined()), "2,1,1")
}

@test
fn prefixWhileAndDropWhile() {
    assertEqualText(text(Countdown { from: 5 }.prefix(while: { $0 > 3 })), "5,4")
    assertEqualText(text(Countdown { from: 5 }.drop(while: { $0 > 3 })), "3,2,1")
    assertEqualText(text(Countdown { from: 3 }.drop(while: { $0 > 0 })), "")
}

@test
fn elementsEqualComparesInOrder() {
    assert(Countdown { from: 3 }.elementsEqual([3, 2, 1]))
    assert(!Countdown { from: 3 }.elementsEqual([3, 2]))
    assert(!Countdown { from: 2 }.elementsEqual([2, 1, 0]))
    assert(!Countdown { from: 3 }.elementsEqual([3, 1, 2]))
    assert(Countdown { from: 2 }.elementsEqual(["2", "1"], by: { "\($0)" == $1 }))
}

@test
fn startsWithComparesThePrefix() {
    assert(Countdown { from: 5 }.starts(with: [5, 4]))
    assert(Countdown { from: 5 }.starts(with: Countdown { from: 0 }))
    assert(!Countdown { from: 5 }.starts(with: [5, 3]))
    assert(!Countdown { from: 1 }.starts(with: [1, 0]))
}

@test
fn lexicographicallyPrecedesComparesInDictionaryOrder() {
    let a: Int[>..] = [1, 2, 3]
    assert(a.lexicographicallyPrecedes([1, 3]))
    assert(!a.lexicographicallyPrecedes([1, 2]))
    assert(!a.lexicographicallyPrecedes([1, 2, 3]))
    assert(a.lexicographicallyPrecedes([1, 2, 3, 0]))
    assert(!a.lexicographicallyPrecedes([0, 9]))
}

@test
fn sumAndProductOfAnySequenceOfNumbers() {
    assertEqual(Countdown { from: 4 }.sum(), 10)
    assertEqual(Countdown { from: 4 }.product(), 24)
    assertEqual(Countdown { from: 0 }.sum(), 0)
    assertEqual(Countdown { from: 0 }.product(), 1)
    assertEqual([1, 2, 3, 4].lazy.filter { $0 % 2 == 0 }.map { $0 * 10 }.sum(), 60)
}

@test
fn containsAnEqualElement() {
    assert(Countdown { from: 5 }.contains(3))
    assert(!Countdown { from: 5 }.contains(6))
}

@test
fn joinedPutsTheSeparatorBetween() {
    let words: String[>..] = ["a", "b", "c"]
    assertEqualText(words.joined(separator: ", "), "a, b, c")
    let empty: String[>..] = []
    assertEqualText(empty.joined(separator: "-"), "")
}

@test
fn enumeratedGivesEachOffset() {
    var pairs: String[>..] = []
    let countdown = Countdown { from: 3 }
    for (offset, value) in countdown.enumerated() {
        pairs.append("\(offset):\(value)")
    }
    assertEqualText(pairs.joined(separator: " "), "0:3 1:2 2:1")
}

@test
fn chainedGivesOneThenTheOther() {
    assertEqualText(text(Countdown { from: 2 }.chained(with: [7, 8]).toArray()), "2,1,7,8")
    assertEqualText(text(Countdown { from: 0 }.chained(with: Countdown { from: 1 }).toArray()), "1")
}

@test
fn zipPairsUntilEitherEnds() {
    var pairs: String[>..] = []
    let countdown = Countdown { from: 5 }
    for (number, letter) in zip(countdown, "ab") {
        pairs.append("\(number)\(String.fromChar(letter))")
    }
    assertEqualText(pairs.joined(separator: " "), "5a 4b")
    var count = 0
    let one = Countdown { from: 1 }
    for _ in zip("abc", one) {
        count += 1
    }
    for _ in zip(one, "abc") {
        count += 1
    }
    assertEqual(count, 2)
}

@test
fn collectMakesAnArray() {
    let values: Int[>..] = Countdown { from: 3 }.collect()
    assertEqualText(text(values), "3,2,1")
    let shrinking: Int[>..<] = Countdown { from: 2 }.collect()
    assertEqual(shrinking.count, 2)
}

@test
fn collectMakesAStringOfCharacters() {
    let backwards: String = "héllo".toArray().reversed().collect()
    assertEqualText(backwards, "olléh")
    let nothing: String = "".toArray().collect()
    assertEqualText(nothing, "")
}
