module I8Tests

// I8 (Sable.Core): its limits, and the numeric protocols' operations at
// its width, at the limits. Run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

@test
fn theLimitsAreTheWidthsBounds() {
    assertEqual(I8.min, -128)
    assertEqual(I8.max, 127)
    assertEqual(I8.zero, 0)
    assertEqual(I8.one, 1)
    assertEqual(I8.bitWidth, 8)
    expect(I8.isSigned, "I8 is signed")
}

@test
fn theLimitsPrintInDecimal() {
    assertEqual(I8.min.toString(), "-128")
    assertEqual(I8.max.toString(), "127")
}

@test
fn addingPastTheGreatestValueWrapsSaturatesOrReportsIt() {
    assertEqual(I8.max.wrappingAdd(1), I8.min)
    assertEqual(I8.max.saturatingAdd(1), I8.max)
    expect(I8.max.checkedAdd(1) == none, "the sum does not fit")
    let (sum, overflowed) = I8.max.overflowingAdd(1)
    assertEqual(sum, I8.min)
    expect(overflowed, "the sum overflowed")
}

@test
fn subtractingPastTheLeastValueWrapsSaturatesOrReportsIt() {
    assertEqual(I8.min.wrappingSub(1), I8.max)
    assertEqual(I8.min.saturatingSub(1), I8.min)
    expect(I8.min.checkedSub(1) == none, "the difference does not fit")
    let (difference, overflowed) = I8.min.overflowingSub(1)
    assertEqual(difference, I8.max)
    expect(overflowed, "the difference overflowed")
}

@test
fn multiplyingPastTheLimitsWrapsSaturatesOrReportsIt() {
    assertEqual(I8.max.wrappingMul(2), -2)
    assertEqual(I8.max.saturatingMul(2), I8.max)
    expect(I8.max.checkedMul(2) == none, "the product does not fit")
    let (product, overflowed) = I8.max.overflowingMul(2)
    assertEqual(product, -2)
    expect(overflowed, "the product overflowed")
    let (high, low) = I8.max.multipliedFullWidth(by: I8.max)
    assertEqual(high, 63)
    assertEqual(low, 1)
}

@test
fn theBitCountsSeeEveryBit() {
    assertEqual(I8.zero.leadingZeroCount, 8)
    assertEqual(I8.zero.trailingZeroCount, 8)
    assertEqual(I8.one.leadingZeroCount, 7)
    assertEqual(I8.max.popCount, 7)
    assertEqual(I8(-128).trailingZeroCount, 7)
    assertEqual(I8.max.leadingOneCount, 0)
    assertEqual(I8.max.trailingOneCount, 7)
}

@test
fn rotationsAndSwapsWorkAtTheWidth() {
    assertEqual(I8.one.rotatedLeft(by: 8), 1)
    assertEqual(I8.one.rotatedRight(by: 1), -128)
    assertEqual(I8.one.rotatedLeft(by: -1), -128)
    assertEqual(I8.one.bitReversed, -128)
    assertEqual(I8(1).byteSwapped, 1)
    assertEqual(I8(1).bigEndianBytes().count, 1)
    assertEqual(I8.fromBigEndianBytes(I8.max.bigEndianBytes()) ?? 0, I8.max)
    assertEqual(I8.fromLittleEndianBytes(I8.min.littleEndianBytes()) ?? 1, I8.min)
}

@test
fn conversionsStopAtTheLimits() {
    expect(I8.exactly(U128.max) == none, "only a U128 holds U128's greatest value")
    expect(I8.exactly(I128.min) == none, "only an I128 holds I128's least value")
    assertEqual(I8.clamping(U128.max), I8.max)
    assertEqual(I8.clamping(I128.min), I8.min)
    assertEqual(I8.truncating(U128.max), -1)
    assertEqual(I8.exactly(I8.max) ?? 0, I8.max)
}

@test
fn theRemainderOfTheLeastValueByMinusOneIsZero() {
    assertEqual(I8.min.wrappingDiv(-1), I8.min)
    assertEqual(I8.min.wrappingRem(-1), 0)
    expect(I8.min.checkedDiv(-1) == none, "the quotient does not fit")
}

@test(traps: "integer overflow")
fn addingPastTheGreatestValueTraps() {
    var x = I8.max
    x = x + 1
    assertEqual(x, 0)
}

@test(traps: "integer overflow")
fn subtractingPastTheLeastValueTraps() {
    var x = I8.min
    x = x - 1
    assertEqual(x, 0)
}

@test(traps: "integer overflow")
fn theLeastValueHasNoAbsoluteValue() {
    assertEqual(I8.min.abs(), 0)
}

@test
fn theLeastValuesAbsoluteValueWrapsOrSaturates() {
    assertEqual(I8.min.wrappingAbs(), I8.min)
    assertEqual(I8.min.saturatingAbs(), I8.max)
    assertEqual(I8.min.saturatingNeg(), I8.max)
    expect(I8.min.checkedAbs() == none, "the least value has no absolute value")
    let (magnitude, overflowed) = I8.min.overflowingAbs()
    assertEqual(magnitude, I8.min)
    expect(overflowed, "the absolute value overflowed")
}
