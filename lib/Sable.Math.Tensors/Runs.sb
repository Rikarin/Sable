module Sable.Math.Tensors

/// The runs elementwise work over a shape goes by, for up to three operands
/// at once (two read and one written, or fewer): each operand's strides, its
/// offset, and a run, the dimension that moves fastest, which a kernel does
/// a vector at a time where its steps let it. Dimensions of length 1 are
/// dropped, and two that follow one another in every operand's storage are
/// merged into one, so that a tensor and a scalar, or two contiguous
/// tensors, are one run; a broadcast operand repeats within a run by a step
/// of zero. The order is the result's layout's: the last dimension fastest
/// for row-major, the first for column-major.
///
/// `next()` moves to each run in turn, from the first; `a`, `b` and `c` are
/// the operands' offsets at its start, and `aStep`, `bStep` and `cStep`
/// their steps along it.
struct Runs {
    /// The lengths of the dimensions other than the run's, slowest first.
    let outer: Int[>..]
    let aStrides: Int[>..]
    let bStrides: Int[>..]
    let cStrides: Int[>..]

    /// The run's length, and each operand's step along it.
    let length: Int
    let aStep: Int
    let bStep: Int
    let cStep: Int

    /// How many runs there are: none where a length is zero.
    let count: Int

    /// The current run's offsets.
    var a: Int
    var b: Int
    var c: Int

    var index: Int[>..]
    var done: Int

    /// The runs over a shape of three operands, by their strides and offsets,
    /// in the order of a layout.
    init(_ shape: Int[:], _ aStrides: Int[:], _ aOffset: Int, _ bStrides: Int[:], _ bOffset: Int, _ cStrides: Int[:], _ cOffset: Int, layout: TensorLayout) {
        // The dimensions fastest first, merged where every operand allows.
        var lengths: Int[>..] = []
        var sa: Int[>..] = []
        var sb: Int[>..] = []
        var sc: Int[>..] = []
        var total = 1
        let rank = shape.count
        var k = 0
        while k < rank {
            let axis = layout == .RowMajor ? rank - 1 - k : k
            let n = shape[axis]
            total = total * n
            k += 1
            if n == 1 {
                continue
            }
            let last = lengths.count - 1
            if last >= 0 && aStrides[axis] == sa[last] * lengths[last] && bStrides[axis] == sb[last] * lengths[last] && cStrides[axis] == sc[last] * lengths[last] {
                lengths[last] = lengths[last] * n
                continue
            }
            lengths.append(n)
            sa.append(aStrides[axis])
            sb.append(bStrides[axis])
            sc.append(cStrides[axis])
        }

        count = total == 0 ? 0 : lengths.count == 0 ? 1 : total / lengths[0]
        length = total == 0 ? 0 : lengths.count == 0 ? 1 : lengths[0]
        aStep = lengths.count == 0 ? 0 : sa[0]
        bStep = lengths.count == 0 ? 0 : sb[0]
        cStep = lengths.count == 0 ? 0 : sc[0]

        // The rest, slowest first.
        var outer: Int[>..] = []
        var oa: Int[>..] = []
        var ob: Int[>..] = []
        var oc: Int[>..] = []
        var i = lengths.count - 1
        while i >= 1 {
            outer.append(lengths[i])
            oa.append(sa[i])
            ob.append(sb[i])
            oc.append(sc[i])
            i -= 1
        }
        self.outer = outer
        self.aStrides = oa
        self.bStrides = ob
        self.cStrides = oc
        a = aOffset
        b = bOffset
        c = cOffset
        index = Int[>..](repeating: 0, count: outer.count)
        done = 0
    }

    /// The runs over a shape of two operands.
    init(_ shape: Int[:], _ aStrides: Int[:], _ aOffset: Int, _ bStrides: Int[:], _ bOffset: Int, layout: TensorLayout) {
        self.init(shape, aStrides, aOffset, bStrides, bOffset, bStrides, bOffset, layout: layout)
    }

    /// The runs over a shape of one operand, row-major.
    init(_ shape: Int[:], _ strides: Int[:], _ offset: Int) {
        self.init(shape, strides, offset, strides, offset, strides, offset, layout: .RowMajor)
    }

    /// Moves to the next run, or the first: false when there are no more.
    @inline(always)
    mutating fn next() -> Bool {
        if done == count {
            return false
        }
        if done > 0 {
            var axis = outer.count - 1
            while axis >= 0 {
                index[axis] += 1
                a += aStrides[axis]
                b += bStrides[axis]
                c += cStrides[axis]
                if index[axis] < outer[axis] {
                    break
                }
                let n = outer[axis]
                a -= aStrides[axis] * n
                b -= bStrides[axis] * n
                c -= cStrides[axis] * n
                index[axis] = 0
                axis -= 1
            }
        }
        done += 1
        return true
    }
}
