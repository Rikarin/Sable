module RangeTests

// Range (Sable.Core): the values from a lower bound up to, not including,
// an upper one.

import Sable.Testing

@test
fn aRangeHoldsItsLowerBoundAndNotItsUpper() {
    let r = 2..<5
    assert(r.contains(2))
    assert(r.contains(4))
    assert(!r.contains(5))
    assert(!r.contains(1))
    assert(!r.isEmpty)
    assertEqual(r.count, 3)
}

@test
fn aRangeWhoseBoundsMeetIsEmpty() {
    let r = 3..<3
    assert(r.isEmpty)
    assertEqual(r.count, 0)
    assert(!r.contains(3))
    let words = "a"..<"c"
    assert(words.contains("b"))
    assert(!words.isEmpty)
}

@test
fn anUpsideDownRangeIsEmpty() {
    let r = Range(lowerBound: 5, upperBound: 2)
    assert(r.isEmpty)
    assertEqual(r.count, 0)
}

@test
fn rangesOverlapWhenTheyShareAValue() {
    assert((0..<5).overlaps(4..<9))
    assert(!(0..<5).overlaps(5..<9))
    assert(!(0..<5).overlaps(3..<3))
    assert((0..<5).overlaps(4...9))
    assert(!(0..<5).overlaps(5...9))
    assert((0...5).overlaps(5...9))
    assert(!(0...4).overlaps(5...9))
    assert((4...9).overlaps(0..<5))
    assert(!(5...9).overlaps(0..<5))
}

@test
fn aClampedRangeLiesWithinItsLimits() {
    assertEqual((0..<10).clamped(to: 3..<7), 3..<7)
    assertEqual((0..<5).clamped(to: 3..<7), 3..<5)
    assertEqual((8..<9).clamped(to: 3..<7), 7..<7)
    assertEqual((0..<1).clamped(to: 3..<7), 3..<3)
    assertEqual((0...10).clamped(to: 3...7), 3...7)
    assertEqual((8...9).clamped(to: 3...7), 7...7)
}

@test
fn aSubrangeHasNoValueOutsideTheOther() {
    assert((2..<4).isSubrange(of: 0..<10))
    assert((0..<10).isSubrange(of: 0..<10))
    assert(!(2..<12).isSubrange(of: 0..<10))
    assert((20..<20).isSubrange(of: 0..<10))
    assert((2...4).isSubrange(of: 0...10))
    assert(!(2...11).isSubrange(of: 0...10))
}

@test
fn aRangeOfAnyIntegerCountsItsValues() {
    assertEqual((-100 as I8..<100).count, 200)
    assertEqual((0 as U8...255).count, 256)
    assertEqual((1...3).count, 3)
    assertEqual((3...1).count, 0)
    assertEqual((10 as U64..<20).count, 10)
}

@test
fn aRangeGoesBackwardsReversed() {
    assert((0..<5).reversed().toArray() == [4, 3, 2, 1, 0])
    assert((1...4).reversed().toArray() == [4, 3, 2, 1])
    assert((250 as U8...255).reversed().toArray() == [255, 254, 253, 252, 251, 250] as U8[>..])
    assert((-2 as I16..<2).toArray() == [-2, -1, 0, 1] as I16[>..])
    assertEqual((5...8)[2], 7)
    assert((3..<3).reversed().toArray() == [] as Int[>..])
}

fn sum<S: Sequence>(_ values: S) -> Int where S.Element == I8, S.Failure == Never {
    var total = 0
    for value in values {
        total += Int(value)
    }
    return total
}

@test
fn aRangeOfNarrowIntegersIsASequence() {
    assertEqual(sum(-3 as I8..<4), 0)
    assertEqual(sum(1 as I8...3), 6)
    assertEqual(sum(120 as I8...127), 988)
}

@test
fn aRangeStepsBy() {
    assert((0..<10).step(by: 3).toArray() == [0, 3, 6, 9])
    assert((0..<9).step(by: 3).toArray() == [0, 3, 6])
    assert((0...9).step(by: 3).toArray() == [0, 3, 6, 9])
    assert((0..<10).step(by: 0).toArray() == [] as Int[>..])
    assert((0...10).step(by: -1).toArray() == [] as Int[>..])
}

@test
fn aClosedRangeHoldsBothItsBounds() {
    let r = 2...5
    assert(r.contains(2) && r.contains(5))
    assert(!r.contains(1) && !r.contains(6))
    assert(("a"..."c").contains("b"))
    assert(!("a"..."c").contains("d"))
    let upsideDown = ClosedRange(lowerBound: 5, upperBound: 2)
    assert(upsideDown.isEmpty && !upsideDown.contains(3))
    assertEqual(upsideDown.count, 0)
}

@test
fn closedRangesOverlapWhenTheyShareAValue() {
    let empty = ClosedRange(lowerBound: 5, upperBound: 2)
    assert(!empty.overlaps(0...9))
    assert(!(0...9).overlaps(empty))
    assert(!(5...9).overlaps(0...4))
    assert((5...9).overlaps(0...5))
    assert((0...9).overlaps(3...4) && (3...4).overlaps(0...9))
}

@test
fn aClosedRangeIsClampedAtEitherEnd() {
    assertEqual((4...5).clamped(to: 3...7), 4...5)
    assertEqual((0...5).clamped(to: 3...7), 3...5)
    assertEqual((4...10).clamped(to: 3...7), 4...7)
    assertEqual((0...1).clamped(to: 3...7), 3...3)
}

@test
fn aClosedSubrangeHasNoValueOutsideTheOther() {
    assert(!(-1...4).isSubrange(of: 0...10))
    assert((0...10).isSubrange(of: 0...10))
    assert(ClosedRange(lowerBound: 25, upperBound: 20).isSubrange(of: 0...10))
}

@test
fn closedRangesCompareAndDescribeThemselves() {
    assert(2...5 == 2...5)
    assert(2...5 != 3...5)
    assert(2...5 != 2...6)
    assertEqual("\(2...5)", "2...5")
    assertEqual("\("a"..."c")", "\"a\"...\"c\"")
}

// The collection's own operations, as generic code reaches them.
fn everyOther<C: RandomAccessCollection>(_ values: C) -> C.Element[>..] where C.Index == Int {
    var picked: C.Element[>..] = []
    var i = values.startIndex
    while values.distance(from: i, to: values.endIndex) > 0 {
        picked.append(values[i])
        if values.distance(from: i, to: values.endIndex) == 1 {
            i = values.index(after: i)
        } else {
            i = values.index(i, offsetBy: 2)
        }
    }
    return picked
}

@test
fn aClosedRangeIsARandomAccessCollection() {
    assert(everyOther(1...5) == [1, 3, 5])
    assert(everyOther(1...4) == [1, 3])
    assert(everyOther(253 as U8...255) == [253, 255] as U8[>..])
    assert(everyOther(I8.min...-126) == [-128, -126] as I8[>..])
}

@test(traps: "position 4 is out of range for count 4")
fn aPositionPastAClosedRangeTraps() {
    _ = (5...8)[4]
}

@test(traps: "position -1 is out of range for count 4")
fn aNegativePositionOfAClosedRangeTraps() {
    _ = (5...8)[-1]
}
