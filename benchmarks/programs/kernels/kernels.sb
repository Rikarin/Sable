module Kernels

// The vector kernels (Sable.Math's TensorPrimitives, over SIMD<F32, 16>):
// a dot product, a sum and an elementwise multiply over 4096 F32s, fifty
// thousand times, with one element changed a round so that no round's
// work is the last's. The same work as plain loops — whose float sums the
// auto-vectoriser may not reorder, so they stay a lane at a time — took
// eight times as long when this was written (docs/06 §SIMD).

import Sable.Math
import Sable.Testing

fn run() -> String {
    let n = 4096
    var x: F32[>..] = []
    var y: F32[>..] = []
    for i in 0..<n {
        x.append(F32(i % 7 - 3))
        y.append(F32(i % 5 - 2))
    }
    var products: F32[>..] = y

    var total = 0.0
    var round = 0
    while round < 50000 {
        x[round % n] = F32(round % 7 - 3)
        total = total + F64(TensorPrimitives.dot(x, y)) + F64(TensorPrimitives.sum(x))
        TensorPrimitives.multiply(x, y, into: &products)
        total = total + F64(products[round % n])
        round = round + 1
    }

    return "\(total:.1f)"
}

@main
fn main() {
    print(run())
}

@bench
fn measure(_ b: Bencher) {
    b.check(b.iterate { run() })
}
