fn matmul5() {
    expectTensor(Tensor.matmul(arange([1, 2, 3], from: 1), arange([4, 3, 2], from: -3)), [4, 2, 2], [-2, 4, -11, 4, 34, 40, 79, 94, 70, 76, 169, 184, 106, 112, 259, 274])
}

@test
fn matmul5OfF64AndF32() {
    let a = arange([1, 2, 3], from: 1).map { F64($0) / 8 }
    let b = arange([4, 3, 2], from: -3).map { F64($0) / 4 }
    expectClose(Tensor.matmul(a, b), [4, 2, 2], [-0.0625, 0.125, -0.34375, 0.125, 1.0625, 1.25, 2.46875, 2.9375, 2.1875, 2.375, 5.28125, 5.75, 3.3125, 3.5, 8.09375, 8.5625])
    let narrow = Tensor.matmul(a.map { F32($0) }, b.map { F32($0) }).map { F64($0) }
    expectClose(narrow, [4, 2, 2], [-0.0625, 0.125, -0.34375, 0.125, 1.0625, 1.25, 2.46875, 2.9375, 2.1875, 2.375, 5.28125, 5.75, 3.3125, 3.5, 8.09375, 8.5625])
}

