module DependencyInjectionGenerators

import Sable.Generators
import Sable.Text

// A type, told from every other: with the modules its names are in.
fn identity(_ type: TypeRef) -> String {
    return spelled(type, "", qualified: true)
}

// A type as a message says it: `Repository<Order>`.
fn short(_ type: TypeRef) -> String {
    return spelled(type, "", qualified: false)
}

// A type's name with nothing but letters and digits in it: `repositoryOfOrder`.
fn identifier(_ type: TypeRef) -> String {
    let text = TextBuilder()
    var first = true
    for character in short(type) {
        if character.isLetter || character.isDigit {
            text.append(first ? character.lowercased() : "\(character)")
            first = false
        } else if character == '<' {
            text.append("Of")
        } else if character == '?' {
            text.append("OrNone")
        }
    }
    return first ? "service" : text.build()
}

// The types a generated file names, and the modules they are found in.
struct TypeWriter {
    let moduleName: String
    var imports: String[>..] = []

    init(in moduleName: String) {
        self.moduleName = moduleName
    }

    // A type as code in the module writes it.
    mutating fn source(_ type: TypeRef) -> String {
        note(type)
        return spelled(type, moduleName, qualified: true, code: true)
    }

    // A type where more is said of it: `(any Clock)` of `(any Clock).self`.
    mutating fn name(_ type: TypeRef) -> String {
        return grouped(source(type), type)
    }

    mutating fn note(_ type: TypeRef) {
        add(type.moduleName)
        for argument in type.arguments {
            note(argument)
        }
    }

    mutating fn add(_ name: String) {
        if !name.isEmpty && name != moduleName && name != "Sable.Core" && !imports.contains(name) {
            imports.append(name)
        }
    }

    // "Payments.", before a name of the module; "" for one that needs none.
    mutating fn qualifier(_ name: String) -> String {
        add(name)
        return name.isEmpty || name == moduleName || name == "Sable.Core" ? "" : name + "."
    }

    fn importLines() -> String {
        let text = TextBuilder()
        for name in imports {
            text.appendLine("import \(name)")
        }
        return text.build()
    }
}

// What is made of more than a name, where brackets or a member follow it.
fn grouped(_ text: String, _ type: TypeRef) -> String {
    return type.kind == "protocol" || type.kind == "function" ? "(\(text))" : text
}

fn spelled(_ type: TypeRef, _ moduleName: String, qualified: Bool, code: Bool = false) -> String {
    let inner = type.arguments.map { spelled($0, moduleName, qualified: qualified, code: code) }.toArray()
    if type.kind == "optional" {
        return grouped(inner[0], type.arguments[0]) + "?"
    }
    if type.kind == "array" {
        return grouped(inner[0], type.arguments[0]) + type.suffix
    }
    if type.kind == "dictionary" {
        return "[\(inner[0]): \(inner[1])]"
    }
    if type.kind == "tuple" {
        return "(" + inner.joined(separator: ", ") + ")"
    }
    if type.kind == "function" && !inner.isEmpty {
        var given = inner
        let result = given.removeLast()
        let waits = type.suffix.contains("async") ? "async " : ""
        let throwing = type.suffix.contains("throws") ? "throws " : ""
        return "\(waits)(" + given.joined(separator: ", ") + ") \(throwing)-> \(result)"
    }
    if type.kind == "parameter" || type.kind == "unresolved" {
        return type.text.isEmpty ? type.name : type.text
    }
    var name = type.qualifiedName
    if qualified && !type.moduleName.isEmpty && !(code && (type.moduleName == moduleName || type.moduleName == "Sable.Core")) {
        name = type.moduleName + "." + name
    }
    if code && type.kind == "protocol" {
        name = "any " + name
    }
    return inner.isEmpty ? name : name + "<" + inner.joined(separator: ", ") + ">"
}

// A type with another for each type parameter.
fn substituted(_ type: TypeRef, _ names: String[>..], _ types: TypeRef[>..]) -> TypeRef {
    if type.kind == "parameter" {
        if let at = names.firstIndex(of: type.name) {
            return types[at]
        }
        return type
    }
    if type.arguments.isEmpty {
        return type
    }
    var result = type
    result.arguments = type.arguments.map { substituted($0, names, types) }.toArray()
    return result
}

// What each type parameter of the pattern stands for in the type; none when
// the type is not one of the pattern's.
fn matched(_ pattern: TypeRef, _ type: TypeRef, _ names: String[>..]) -> TypeRef[>..]? {
    var bound: TypeRef?[>..] = []
    while bound.count < names.count {
        bound.append(none)
    }
    if !bind(pattern, type, names, &bound) {
        return none
    }
    var result: TypeRef[>..] = []
    for each in bound {
        guard let type = each else {
            return none
        }
        result.append(type)
    }
    return result
}

fn bind(_ pattern: TypeRef, _ type: TypeRef, _ names: String[>..], _ bound: inout TypeRef?[>..]) -> Bool {
    if pattern.kind == "parameter" {
        guard let at = names.firstIndex(of: pattern.name) else {
            return false
        }
        if let known = bound[at] {
            return identity(known) == identity(type)
        }
        bound[at] = type
        return true
    }
    if pattern.kind != type.kind || pattern.qualifiedName != type.qualifiedName || pattern.moduleName != type.moduleName
        || pattern.suffix != type.suffix || pattern.arguments.count != type.arguments.count {
        return false
    }
    for i in 0..<pattern.arguments.count {
        if !bind(pattern.arguments[i], type.arguments[i], names, &bound) {
            return false
        }
    }
    return true
}
