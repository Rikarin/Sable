module Sable.Concurrency

// Channels (docs/04 §4.3, docs/06 §6.7), written in Sable over the core's
// WaitList. What is sent is added to one ring of values under one lock, and
// taken from another ring under another: a receiver that finds its ring
// empty swaps it for the senders', so that the two ends meet once for many
// values, not at each. A bounded channel, whose senders must know what is
// held, has one ring and one lock. Neither lock is held for longer than a
// few values' moving, so neither end waits for the other to run, as it
// would for an actor. A receiver with nothing to take, or a sender with no
// room, parks in a wait list, holding no thread, until what it waits for
// changes: it says so (the waiting counts), and takes the list's ticket,
// under the lock it looked under, so that a wake between its look and its
// park is not missed; and it parks cancellably, so that the task's
// cancellation wakes it, and it gives up — having looked once more, so a
// change it was woken for is not lost with it. Each value wakes a receiver,
// and each room made a sender, while any are counted: whoever wakes one
// counts it out. One that went another way stays counted, which costs a
// wake of no one.

/// Values passed from task to task in the order sent, that cannot fail:
/// a ThrowingChannel whose Failure is Never. What is sent crosses from one
/// task to another, so it is Sendable.
///
/// ```sable
/// let channel = Channel<Int>()
/// let consumer = Task.spawn {
///     var total = 0
///     for await value in channel {
///         total += value
///     }
///     return total
/// }
/// for i in 1...3 {
///     await channel.send(i)
/// }
/// await channel.close()
/// print(await consumer.value)   // 6
/// ```
public alias Channel<Element: Sendable> = ThrowingChannel<Element, Never>

/// Values passed from task to task in the order sent: .NET's
/// `System.Threading.Channels`, Rust's `mpsc`, Swift's `AsyncChannel`.
/// Any number of tasks send, and any number receive: each value goes to
/// one receiver, the one that asks first. Unbounded, a channel holds
/// whatever is sent; bounded, it holds at most so many values, and its
/// full mode says what a send to it while full does — wait for room (the
/// sender's backpressure), or drop a value. Closed, it takes no more, and
/// its receivers have what it holds, then none — or, closed with an
/// error, the error thrown.
///
/// A send or a receive that waits is cancellable: the waiting task's
/// cancellation ends the wait, the send returning `.Cancelled` and the
/// receive none, with nothing sent or taken.
///
/// ```sable
/// let jobs = Channel<Int>(capacity: 2)
/// let worker = Task.spawn {
///     var done = 0
///     for await job in jobs {
///         done += job
///     }
///     return done
/// }
/// for job in 1...10 {
///     await jobs.send(job)     // waits while two are queued
/// }
/// await jobs.close()
/// assert(await worker.value == 55)
/// ```
@immutable
public final class ThrowingChannel<Element: Sendable, Failure: Error>: AsyncSequence {
    public alias Iter = ChannelIterator<Element, Failure>

    // The senders' lock guards 'back', 'flags' and 'failure'; the
    // receivers', taken first where both are, 'front'.
    let sendLock: Int
    let receiveLock: Int
    let back: ChannelRing<Element>
    let front: ChannelRing<Element>
    // Whether it is closed, and how many receivers, and senders, may be
    // parked, or about to be: each a word, in the room on the senders' lock's
    // cache line, whose holder alone reads them.
    let flags: RawPtr<Int>
    let failure: RawPtr<Failure?>
    let receivers: WaitList
    let senders: WaitList

    /// How many values it holds at most; none when unbounded.
    public let capacity: Int?

    /// What a send to it does while it is full.
    public let fullMode: ChannelFullMode

    /// An unbounded channel: a send never waits.
    public convenience init() {
        self.init(room: none, fullMode: .Wait)
    }

    /// A channel holding at most so many values; a send while it is full
    /// does as the full mode says — by default, waits for room.
    public convenience init(capacity: Int, fullMode: ChannelFullMode = .Wait) {
        precondition(capacity > 0, "a channel cannot hold \(capacity) values")
        self.init(room: capacity, fullMode: fullMode)
    }

    init(room: Int?, fullMode: ChannelFullMode) {
        capacity = room
        self.fullMode = fullMode
        receivers = WaitList()
        senders = WaitList()
        sendLock = Runtime.lockNew()
        receiveLock = Runtime.lockNew()
        unsafe {
            back = ChannelRing.make()
            front = ChannelRing.make()
            flags = RawPtr<Int>(address: sendLock - Runtime.lockRoom)
            flags.initialize(repeating: 0, count: channelFlags)
            failure = RawPtr<Failure?>.allocate(count: 1)
            failure.initialize(to: none)
        }
    }

    deinit {
        unsafe {
            back.destroy()
            front.destroy()
            failure.deinitialize()
            failure.deallocate()
        }
        Runtime.lockFree(sendLock)
        Runtime.lockFree(receiveLock)
    }

    /// Sends the value, waiting while the channel is full if its full mode
    /// is `.Wait`: what became of it. A send to a closed channel is
    /// `.Closed`, and one whose task is cancelled while it waits for room
    /// `.Cancelled`; either way the value is not sent.
    @discardable
    public fn send(_ value: Element) async -> SendResult {
        while true {
            match offer(value, waiting: true) {
                case .Done(let result) => {
                    return result
                }
                case .Full(let ticket) => {
                    if Task.isCancelled {
                        return .Cancelled
                    }
                    await senders.parkCancellably(since: ticket)
                }
            }
        }
    }

    /// Sends the value if it can without waiting: `.Full` if the channel is
    /// full and would have the sender wait.
    @discardable
    public fn trySend(_ value: Element) -> SendResult {
        match offer(value, waiting: false) {
            case .Done(let result) => {
                return result
            }
            case .Full(_) => {
                return .Full
            }
        }
    }

    // The value taken if there is room, or room made by the full mode;
    // waiting, the receivers are told that a sender without room will park.
    fn offer(_ value: Element, waiting: Bool) -> ChannelOffer {
        Runtime.share(value)
        Runtime.lockAcquire(sendLock)
        unsafe {
            if flags.load(at: channelClosed) != 0 {
                Runtime.lockRelease(sendLock)
                return .Done(.Closed)
            }
            // A value dropped is destroyed with the lock let go, as its
            // deinit may do anything.
            var dropped: Element? = none
            if let capacity = capacity {
                if back.count() >= capacity {
                    match fullMode {
                        case .Wait => {
                            if waiting {
                                flags.store(flags.load(at: channelSenders) + 1, at: channelSenders)
                            }
                            let ticket = senders.ticket
                            Runtime.lockRelease(sendLock)
                            return .Full(ticket)
                        }
                        case .DropWrite => {
                            Runtime.lockRelease(sendLock)
                            return .Done(.Dropped)
                        }
                        case .DropOldest => {
                            dropped = back.removeFirst()
                        }
                        case .DropNewest => {
                            dropped = back.removeLast()
                        }
                    }
                }
            }
            back.append(value)
            let waiting = flags.load(at: channelReceivers)
            if waiting > 0 {
                flags.store(waiting - 1, at: channelReceivers)
            }
            Runtime.lockRelease(sendLock)
            if waiting > 0 {
                receivers.wakeOne()
            }
            dropped = none
        }
        return .Done(.Sent)
    }

    /// The next value, waiting for one: none once the channel is closed and
    /// empty, or if the receiving task is cancelled while it waits. Closed
    /// with an error and empty, it throws the error.
    public fn receive() async throws(Failure) -> Element? {
        while true {
            match poll(waiting: true) {
                case .Value(let value) => {
                    return value
                }
                case .Ended => {
                    return none
                }
                case .Failed(let error) => {
                    throw error
                }
                case .Empty(let ticket) => {
                    if Task.isCancelled {
                        return none
                    }
                    await receivers.parkCancellably(since: ticket)
                }
            }
        }
    }

    /// The next value if one is there now; none otherwise.
    public fn tryReceive() -> Element? {
        match poll(waiting: false) {
            case .Value(let value) => {
                return value
            }
            case _ => {
                return none
            }
        }
    }

    // What a receiver finds; waiting, the senders are told that it will park.
    fn poll(waiting: Bool) -> ChannelPoll<Element, Failure> {
        if capacity != none {
            return pollBounded(waiting)
        }
        Runtime.lockAcquire(receiveLock)
        unsafe {
            if front.count() == 0 {
                Runtime.lockAcquire(sendLock)
                front.swap(with: back)
                if front.count() == 0 {
                    let found = nothing(waiting)
                    Runtime.lockRelease(sendLock)
                    Runtime.lockRelease(receiveLock)
                    return found
                }
                Runtime.lockRelease(sendLock)
            }
            let value = front.removeFirst()
            Runtime.lockRelease(receiveLock)
            return .Value(value)
        }
    }

    fn pollBounded(_ waiting: Bool) -> ChannelPoll<Element, Failure> {
        Runtime.lockAcquire(sendLock)
        unsafe {
            if back.count() == 0 {
                let found = nothing(waiting)
                Runtime.lockRelease(sendLock)
                return found
            }
            let value = back.removeFirst()
            let waiting = flags.load(at: channelSenders)
            if waiting > 0 {
                flags.store(waiting - 1, at: channelSenders)
            }
            Runtime.lockRelease(sendLock)
            if waiting > 0 {
                senders.wakeOne()
            }
            return .Value(value)
        }
    }

    // What a receiver finds that finds no value. Under the senders' lock.
    fn nothing(_ waiting: Bool) -> ChannelPoll<Element, Failure> {
        unsafe {
            if flags.load(at: channelClosed) != 0 {
                if let error = failure.load() {
                    return .Failed(error)
                }
                return .Ended
            }
            if waiting {
                flags.store(flags.load(at: channelReceivers) + 1, at: channelReceivers)
            }
        }
        return .Empty(receivers.ticket)
    }

    /// No more values will come: sends from now on are `.Closed`, those
    /// waiting for room among them, and receivers get what the channel
    /// holds, then none. Closing it again does nothing.
    public fn close() {
        end(none)
    }

    /// Closed with an error: receivers get what the channel holds, then the
    /// error, thrown — .NET's `Complete(exception)`. Closing it again, with
    /// or without an error, does nothing.
    public fn close(error: Failure) {
        end(error)
    }

    fn end(_ error: Failure?) {
        Runtime.share(error)
        Runtime.lockAcquire(sendLock)
        unsafe {
            if flags.load(at: channelClosed) == 0 {
                flags.store(1, at: channelClosed)
                failure.store(error)
            }
        }
        Runtime.lockRelease(sendLock)
        receivers.wakeAll()
        senders.wakeAll()
    }

    /// Whether it has been closed; it may still hold values to receive.
    public var isClosed: Bool {
        get {
            Runtime.lockAcquire(sendLock)
            var closed = false
            unsafe {
                closed = flags.load(at: channelClosed) != 0
            }
            Runtime.lockRelease(sendLock)
            return closed
        }
    }

    /// Values sent and not yet received.
    public var count: Int {
        get {
            Runtime.lockAcquire(receiveLock)
            Runtime.lockAcquire(sendLock)
            var held = 0
            unsafe {
                held = front.count() + back.count()
            }
            Runtime.lockRelease(sendLock)
            Runtime.lockRelease(receiveLock)
            return held
        }
    }

    /// Whether it holds no values now.
    public var isEmpty: Bool => count == 0

    /// Its values as they are received, for 'for await'.
    public fn makeAsyncIterator() -> ChannelIterator<Element, Failure> {
        return ChannelIterator<Element, Failure> { channel: self, done: false }
    }
}

// A channel's flags, by their words.
const channelClosed = 0
const channelReceivers = 1
const channelSenders = 2
const channelFlags = 3

// What became of a value offered: what a send says, or, with no room for
// it, the ticket to wait for room since.
union ChannelOffer {
    Done(SendResult)
    Full(Int)
}

// What a receiver finds: a value, the end, the error it ended with, or
// nothing yet, with the ticket to wait since.
union ChannelPoll<Element, Failure> {
    Value(Element)
    Ended
    Failed(Failure)
    Empty(Int)
}

/// Receives a channel's values, one per 'next()': what 'for await value in
/// channel' goes through, until the channel is closed and empty, or the
/// task is cancelled. Several iterators of one channel share its values.
public struct ChannelIterator<Value: Sendable, Failure: Error>: AsyncIterator {
    public alias Element = Value

    let channel: ThrowingChannel<Value, Failure>
    var done: Bool

    /// The next value received; none once there are no more, and after
    /// the channel's error has been thrown.
    public mutating fn next() async throws(Failure) -> Value? {
        if done {
            return none
        }
        do {
            if let value = try await channel.receive() {
                return value
            }
            done = true
            return none
        } catch {
            done = true
            throw error
        }
    }
}
