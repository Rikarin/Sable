module ConditionTests

// Condition (Sable.Concurrency).

import Sable.Concurrency
import Sable.Testing

@test
fn aConditionWakesAWaiterWhenTheValueIsReady() async {
    let queue: Mutex<Int[>..]> = Mutex([])
    let filled = Condition()
    let consumer = Task.spawn {
        var sum = 0
        var taken = 0
        while taken < 100 {
            sum += queue.withLock(when: filled, { !$0.isEmpty }) { $0.removeLast() }
            taken += 1
        }
        return sum
    }
    var i = 1
    while i <= 100 {
        queue.withLock { $0.append(i) }
        filled.notifyAll()
        i += 1
    }
    assertEqual(await consumer.value, 5050)
    let empty: Mutex<Int[>..]> = Mutex([])
    assert(empty.withLock(when: filled, within: 1000000, { !$0.isEmpty }) { $0.count } == none)
}

@test
fn notifyOneWakesTheOneWaiting() async {
    let ready = Mutex<Bool>(false)
    let changed = Condition()
    let asked = Atomic<Bool>(false)
    let waiter = Task.spawn {
        return ready.withLock(when: changed, { value -> Bool in
            asked.store(true)
            return value
        }) { $0 }
    }
    while !asked.load() {
        await Task.yield()
    }
    // The waiter asked holding the lock, so this takes it only once it waits.
    ready.withLock { $0 = true }
    changed.notifyOne()
    assert(await waiter.value)
}

@test
fn aWaitWithADeadlineEndsWhenTheValueIsReady() async {
    let count = Mutex<Int>(0)
    let changed = Condition()
    // Ready already: no wait.
    assertEqual(count.withLock(when: changed, within: 0, { $0 == 0 }) { $0 }, 0)
    let asked = Atomic<Bool>(false)
    let waiter = Task.spawn {
        return count.withLock(when: changed, within: 60000000000, { value -> Bool in
            asked.store(true)
            return value > 0
        }) { $0 * 10 }
    }
    while !asked.load() {
        await Task.yield()
    }
    count.withLock { $0 = 4 }
    changed.notifyAll()
    assertEqual(await waiter.value, 40)
}
