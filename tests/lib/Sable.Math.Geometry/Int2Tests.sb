module Int2Tests

import Sable.Math.Geometry
import Sable.Serialize
import Sable.Testing

let a: Int2 = Int2(7, -3)
let b: Int2 = Int2(2, 2)

@test
fn itsLayoutIsItsComponentsInOrder() {
    assertEqual(MemoryLayout<Int2>.size, 8)
    assertEqual(MemoryLayout<Int2>.alignment, 4)
}

@test
fn itsComponentsAreReadAndWrittenByIndex() {
    var v = a
    for i in 0..<2 {
        assertEqual(v[i], a[i])
        v[i] = b[i]
    }
    assertEqual(v, b)
    expectPanic("has no component 2") {
        _ = a[2]
    }
    expectPanic("has no component -1") {
        var v = a
        v[-1] = 0
    }
}

@test
fn arithmeticIsIntegersAndDividesTowardZero() {
    assertEqual(a + b, Int2(9, -1))
    assertEqual(a - b, Int2(5, -5))
    assertEqual(a * b, Int2(14, -6))
    assertEqual(a / b, Int2(3, -1))
    assertEqual(a * 2, Int2(14, -6))
    assertEqual(2 * a, Int2(14, -6))
    assertEqual(a / 2, Int2(3, -1))
    assertEqual(-a, Int2(-7, 3))
    assertEqual(a.min(b), Int2(2, -3))
    assertEqual(a.max(b), Int2(7, 2))
    assertEqual(a.abs(), Int2(7, 3))
    assertEqual(a.clamped(lower: Int2.zero, upper: Int2(repeating: 5)), Int2(5, 0))
    expectPanic("overflow") {
        _ = Int2(repeating: I32.max) + Int2.one
    }
}

@test
fn itIsMadeOfFloatsTowardZero() {
    assertEqual(Int2(truncating: Vector2(1.9, -1.9)), Int2(1, -1))
    assertEqual(Int2(repeating: 3), Int2.one * 3)
    assertEqual(Int2.unitX + Int2.unitY, Int2.one)
    assertEqual(a.simd[1], -3)
}

@test
fn itIsEqualHashedWrittenAndSerialised() throws {
    assertEqual(a.hashValue, Int2(7, -3).hashValue)
    for i in 0..<2 {
        var other = a
        other[i] += 1
        expect(a != other)
    }
    assertEqual("\(a)", "(7, -3)")
    assertEqual(a.debugDescription(), "Int2(7, -3)")
    assertEqual("\(a:?)", "Int2(7, -3)")
    assertEqual(try Json.decode(Int2.self, from: Json.encode(a)), a)
}

@test
fn itsAreaIsWide() {
    assertEqual(Int2(100000, 100000).area, 10000000000)
}
