module Sable.Collections

/// Keys to values, in the order the keys were added — an order that
/// removing a key closes up rather than leaving a gap in, and that can be
/// read by position. The keys and values are arrays in that order, with a
/// dictionary from each key to its position. Looking up, adding and
/// changing are constant time; removing is linear, as every later position
/// moves down one. (A `[Key: Value]` keeps its insertion order too, and
/// removes in constant time; this is for reading and changing by position.)
public class OrderedDictionary<Key: Hashable, Value> {
    var orderedKeys: Key[>..] = []
    var orderedValues: Value[>..] = []
    var positions: [Key: Int] = [:]

    /// An empty dictionary.
    public init() { }

    /// The sequence's pairs, each key with its value, in the order each key
    /// first comes; a key that comes again keeps its place and takes the
    /// last value given it. What going through them throws, it throws.
    public init<S: Sequence>(_ pairs: S) throws(S.Failure) where S.Element == (Key, Value) {
        for try (key, value) in pairs {
            self.set(key, value)
        }
    }

    /// How many keys it holds.
    public var count: Int => orderedKeys.count

    /// Whether it holds no keys.
    public var isEmpty: Bool => orderedKeys.count == 0

    /// The value for the key, or none.
    public fn get(_ key: Key) -> Value? {
        if let position = positions[key] {
            return orderedValues[position]
        }
        return none
    }

    /// Whether the dictionary holds the key.
    public fn contains(_ key: Key) -> Bool {
        return positions.contains(key)
    }

    /// Where the key is in the order, or none.
    public fn index(of key: Key) -> Int? {
        return positions[key]
    }

    /// Sets the key's value: a new key goes at the end, a key already there
    /// keeps its place.
    public fn set(_ key: Key, _ value: Value) {
        if let position = positions[key] {
            orderedValues[position] = value
            return
        }
        positions[key] = orderedKeys.count
        orderedKeys.append(key)
        orderedValues.append(value)
    }

    /// Removes the key, closing up the order behind it; its value, or none
    /// if it was not there.
    public fn remove(_ key: Key) -> Value? {
        if let position = positions[key] {
            let value = orderedValues[position]
            positions.remove(key)
            var i = position
            while i + 1 < orderedKeys.count {
                orderedKeys[i] = orderedKeys[i + 1]
                orderedValues[i] = orderedValues[i + 1]
                positions[orderedKeys[i]] = i
                i = i + 1
            }
            orderedKeys.removeLast()
            orderedValues.removeLast()
            return value
        }
        return none
    }

    /// The key at 'position' in the order; traps outside 0..<count.
    public fn key(at position: Int) -> Key {
        return orderedKeys[position]
    }

    /// The value at 'position' in the order; traps outside 0..<count.
    public fn value(at position: Int) -> Value {
        return orderedValues[position]
    }

    /// Removes every key.
    public fn removeAll() {
        orderedKeys = []
        orderedValues = []
        positions.removeAll()
    }
}

// An ordered dictionary is a random-access collection of its entries,
// each key with its value, by their position in the order.
extension OrderedDictionary: RandomAccessCollection, FromSequence<(Key, Value)> {
    /// An iterator over the entries, each key with its value, in order.
    public fn makeIterator() -> Zip2Iterator<ArrayIterator<Key>, ArrayIterator<Value>> {
        return zip(orderedKeys, orderedValues).makeIterator()
    }

    /// The entry at 'position' in the order; traps outside 0..<count.
    ///
    /// ```sable
    /// let ages = OrderedDictionary<String, Int>()
    /// ages.set("ann", 31)
    /// ages.set("bo", 42)
    /// assert(ages[1].0 == "bo" && ages[1].1 == 42)
    /// ```
    public subscript(position: Int) -> (Key, Value) {
        get => (orderedKeys[position], orderedValues[position])
    }

    /// The first entry's position: 0.
    public var startIndex: Int => 0

    /// The position past the last entry: the count.
    public var endIndex: Int => orderedKeys.count

    /// The next position.
    public fn index(after position: Int) -> Int => position + 1

    /// The position before.
    public fn index(before position: Int) -> Int => position - 1

    /// The position 'distance' on.
    public fn index(_ position: Int, offsetBy distance: Int) -> Int => position + distance

    /// How far on 'end' is from 'start'.
    public fn distance(from start: Int, to end: Int) -> Int => end - start
}
