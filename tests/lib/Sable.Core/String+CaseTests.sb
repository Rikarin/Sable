module StringCaseTests

// String's case mappings and comparisons (Sable.Core), tested with '@test':
// run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

@test(arguments: [
    ("Straße", "STRASSE"), ("ǆemal", "ǄEMAL"), ("hello, wörld", "HELLO, WÖRLD"), ("ﬁx", "FIX"), ("", "")
])
fn uppercasedUsesTheFullMappings(_ text: String, _ mapped: String) {
    expect(text.uppercased() == mapped)
}

@test(arguments: [("HELLO, WÖRLD", "hello, wörld"), ("İ", "i\u{307}"), ("ÀB", "àb")])
fn lowercasedUsesTheFullMappings(_ text: String, _ mapped: String) {
    expect(text.lowercased() == mapped)
}

@test
fn textWithNothingToChangeIsGivenBack() {
    assertEqual("ALREADY 1".uppercased(), "ALREADY 1")
    assertEqual("already 1".lowercased(), "already 1")
    assertEqual("中文".uppercased(), "中文")
}

@test(arguments: [
    ("ΟΔΟΣ", "οδος"), ("ΟΔΟΣ ΟΔΟΣ", "οδος οδος"), ("ΣΑΣ", "σας"), ("Σ", "σ"), ("ΑΣ'", "ας'"), ("ΑΣ'Α", "ασ'α"),
    ("'Σ", "'σ"), ("1Σ", "1σ")
])
fn aFinalSigmaIsLowercasedToTheFinalForm(_ text: String, _ mapped: String) {
    expect(text.lowercased() == mapped)
}

@test
fn asciiCaseChangesOnlyAsciiLetters() {
    assertEqual("Héllo".asciiUppercased(), "HéLLO")
    assertEqual("HÉLLO".asciiLowercased(), "hÉllo")
    assertEqual("123".asciiUppercased(), "123")
}

@test
fn caseFoldingMakesCaseVariantsTheSame() {
    assertEqual("HeLLo Σ".caseFolded(), "hello σ")
    assertEqual("already".caseFolded(), "already")
}

@test
fn equalityIgnoringCase() {
    expect("Hello".equals("hELLO", ignoringCase: true), "ASCII")
    expect("ΟΔΟΣ".equals("οδος", ignoringCase: true), "Greek, with a final sigma")
    expect("\u{212A}elvin".equals("kelvin", ignoringCase: true), "the Kelvin sign")
    expect(!"Hello".equals("hELLO", ignoringCase: false), "with case")
    expect("Hello".equals("Hello", ignoringCase: false), "the same")
    expect(!"Hello".equals("Hell", ignoringCase: true), "a prefix is not equal")
}

@test
fn comparingWithNoOptionsIsByScalar() {
    expect("abc".compare("abd", options: []) == .Less, "c before d")
    expect("b".compare("abc", options: []) == .Greater, "b after a")
    expect("same".compare("same", options: []) == .Equal, "the same")
}

@test(arguments: [
    ("ABC", "abd", .IgnoringCase, .Less, "c before d"), ("ABC", "abc", .IgnoringCase, .Equal, "the same"),
    ("abc", "AB", .IgnoringCase, .Greater, "longer after"), ("ab", "ABC", .IgnoringCase, .Less, "shorter before")
])
fn comparingIgnoringCase(_ a: String, _ b: String, _ options: String.CompareOptions, _ ordering: Ordering, _ why: String) {
    expect(a.compare(b, options: options) == ordering, why)
}

@test(arguments: [
    ("file9", "file10", .Numeric, .Less, "9 before 10"), ("file9", "file10", [], .Greater, "but '9' after '1'"),
    ("file007", "file7", .Numeric, .Equal, "the same"),
    ("file10b", "file10a", .Numeric, .Greater, "the rest decides"),
    ("v2.10", "v2.9", .Numeric, .Greater, "each run of digits"),
    ("12", "13", .Numeric, .Less, "equal lengths, digit by digit"),
    ("0", "00", .Numeric, .Equal, "zeros are zero")
])
fn comparingNumerically(_ a: String, _ b: String, _ options: String.CompareOptions, _ ordering: Ordering, _ why: String) {
    expect(a.compare(b, options: options) == ordering, why)
}

@test
fn comparingNumericallyAndIgnoringCase() {
    expect("FILE9".compare("file10", options: [.Numeric, .IgnoringCase]) == .Less, "both at once")
}
