module Sable.Crypto

/// Why a key could not be derived or read, a message not be sealed or opened,
/// or an encoded password hash not be read. A password or a signature that is
/// merely wrong is not an error: `verify` and `isValid` say false.
///
/// ```sable
/// do {
///     _ = try Argon2id(memoryKiB: 7, iterations: 1, parallelism: 1)
/// } catch {
///     assert("\(error.description())" == "Argon2id needs at least 8 KiB of memory for each lane: 7 KiB for 1")
/// }
/// ```
@derive(Equatable, Debug)
public union CryptoError: Error {
    /// A parameter is outside what the algorithm is defined for; the text says which.
    InvalidParameter(reason: String)

    /// More memory, or more work, would be needed than the limit allows.
    LimitExceeded(reason: String)

    /// Text that should be an encoded password hash is not one, or is one
    /// of an algorithm or version that is not known.
    InvalidEncoding(reason: String)

    /// What was to be opened, or unwrapped, is not what was sealed with the
    /// key, nonce and associated data given: one of them, or it, is another.
    AuthenticationFailed

    /// A message deciphered by an unauthenticated cipher does not end in the
    /// padding it should.
    InvalidPadding

    /// Bytes or text that should be a key are not one, or are one that must
    /// not be used.
    InvalidKey(reason: String)

    /// What is wrong.
    public fn description() -> String {
        return match self {
            case .InvalidParameter(let reason) => reason
            case .LimitExceeded(let reason)    => reason
            case .InvalidEncoding(let reason)  => reason
            case .AuthenticationFailed         => "what was to be opened is not what was sealed with this key, nonce and associated data"
            case .InvalidPadding               => "the message does not end in the padding it should"
            case .InvalidKey(let reason)       => reason
        }
    }
}
