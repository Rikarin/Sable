module Sable.Core

/// Tasks parked until woken: what an actor's method waits in for a change
/// another call to the actor makes — Sable.Concurrency's Channel parks its
/// receivers in one. A task parked inside an actor's method lets the actor
/// go while it waits, so the call that wakes it can run, and takes the
/// actor again as it goes on. Being woken says only that something changed:
/// a parked task looks again at what it waits for, and parks again if it
/// must. Its calls are safe from any thread, so it is '@immutable', and
/// Sendable.
///
/// ```sable
/// actor Gate {
///     var isOpen = false
///     let opened = WaitList()
///
///     fn pass() async {
///         while !isOpen {
///             await opened.park()
///         }
///     }
///
///     fn openUp() {
///         isOpen = true
///         opened.wakeAll()
///     }
/// }
/// ```
@immutable
public final class WaitList {
    let handle: Int

    public init() {
        handle = WaitList.make()
    }

    deinit {
        WaitList.free(handle)
    }

    /// Parks the running task until 'wakeAll()' is next called.
    public fn park() async {
        await Task.park(handle)
    }

    /// Parks the running task until 'wakeAll()' is next called or the task
    /// is cancelled; a task cancelled already does not park. Woken, it asks
    /// 'Task.isCancelled' to tell which: how a wait is made cancellable
    /// without anything to wake it but the cancellation.
    ///
    /// ```sable
    /// actor Mailbox {
    ///     var letters: String[>..] = []
    ///     let arrived = WaitList()
    ///
    ///     // The latest letter, or none once the task is cancelled.
    ///     fn take() async -> String? {
    ///         while letters.isEmpty {
    ///             if Task.isCancelled {
    ///                 return none
    ///             }
    ///             await arrived.parkCancellably()
    ///         }
    ///         return letters.removeLast()
    ///     }
    /// }
    /// ```
    public fn parkCancellably() async {
        await Task.parkCancellably(handle, -1)
    }

    /// As 'parkCancellably()', but not parked at all if 'wakeAll()' has
    /// been called since the ticket was taken: for state guarded by a lock
    /// rather than an actor, where a wake may come between the look at the
    /// state, under the lock, and the park, after it. The ticket is taken
    /// first, under the lock, then the state looked at.
    ///
    /// ```sable
    /// let list = WaitList()
    /// let ticket = list.ticket
    /// list.wakeAll()
    /// await list.parkCancellably(since: ticket)   // goes on at once
    /// ```
    public fn parkCancellably(since ticket: Int) async {
        await Task.parkCancellably(handle, ticket)
    }

    /// As 'park()', but not parked at all if the list has been woken since
    /// the ticket was taken; a cancellation does not wake it.
    ///
    /// ```sable
    /// let list = WaitList()
    /// let ticket = list.ticket
    /// list.wakeOne()
    /// await list.park(since: ticket)   // goes on at once
    /// ```
    public fn park(since ticket: Int) async {
        await Task.parkCancellably(handle, -2 - ticket)
    }

    /// How many times the list has been woken: what 'park(since:)' and
    /// 'parkCancellably(since:)' are given.
    public var ticket: Int => WaitList.ticketOf(handle)

    /// Wakes every task parked, in the order they parked.
    public fn wakeAll() {
        WaitList.wake(handle)
    }

    /// Wakes the task that parked first, if any is parked. For a change that
    /// is for one task alone, and which any parked could be given: one woken
    /// that gives up instead, as a task cancelled does, must wake the next.
    ///
    /// ```sable
    /// let list = WaitList()
    /// let first = Task.spawn { await list.park() }
    /// await Task.settle()
    /// let second = Task.spawn { await list.park() }
    /// await Task.settle()
    /// list.wakeOne()
    /// await first.value
    /// list.wakeOne()
    /// await second.value
    /// ```
    public fn wakeOne() {
        WaitList.wakeFirst(handle)
    }

    /// Parks the running task until it is given a grant, or takes one given
    /// while no task was parked: each 'grant()' ends one such park, the first
    /// to park's first, whichever of the two comes before the other. A list
    /// used so is parked in no other way.
    ///
    /// ```sable
    /// let list = WaitList()
    /// list.grant()
    /// await list.parkForGrant()   // goes on at once
    /// ```
    public fn parkForGrant() async {
        await Task.parkCancellably(handle, Int.min)
    }

    /// Ends one task's 'parkForGrant()', now or to come.
    public fn grant() {
        WaitList.giveGrant(handle)
    }

    @builtin("task_waitlist_grant")
    static fn giveGrant(_ handle: Int)

    @builtin("task_waitlist_wake_one")
    static fn wakeFirst(_ handle: Int)

    @builtin("task_waitlist_new")
    static fn make() -> Int

    @builtin("task_waitlist_free")
    static fn free(_ handle: Int)

    @builtin("task_waitlist_wake")
    static fn wake(_ handle: Int)

    @builtin("task_waitlist_ticket")
    static fn ticketOf(_ handle: Int) -> Int
}
