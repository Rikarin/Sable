module Sable.Math

// The hyperbolic functions and their inverses, of any float with the
// elementary functions (ElementaryFunctions.sb): libm's.

/// The hyperbolic sine; an infinity past where it overflows.
public fn sinh<T: ElementaryFunctions>(_ x: T) -> T => T.sinh(x)

/// The hyperbolic cosine, at least 1; +inf past where it overflows.
public fn cosh<T: ElementaryFunctions>(_ x: T) -> T => T.cosh(x)

/// The hyperbolic tangent, in [-1, 1].
public fn tanh<T: ElementaryFunctions>(_ x: T) -> T => T.tanh(x)

/// The inverse hyperbolic sine.
public fn asinh<T: ElementaryFunctions>(_ x: T) -> T => T.asinh(x)

/// The inverse hyperbolic cosine; NaN below 1.
public fn acosh<T: ElementaryFunctions>(_ x: T) -> T => T.acosh(x)

/// The inverse hyperbolic tangent; NaN outside [-1, 1], an infinity at ±1.
public fn atanh<T: ElementaryFunctions>(_ x: T) -> T => T.atanh(x)
