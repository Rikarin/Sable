module FileHandleTests

// FileHandle, OpenOptions and File's byte and text calls (Sable.IO), on
// files of their own beside the tests. Run with
//     tools/stdlib-coverage.sh Sable.IO

import IoSupport
import Sable.IO
import Sable.Testing

@test
fn readingWritingSeekingAndPositions() throws {
    let path = "sable-test-handle-positions.bin"
    let file = try File.open(path, options: {
        var options = OpenOptions.writing
        options.read = true
        return options
    }())
    expect(file.isOpen)
    try file.write([1, 2, 3, 4, 5, 6])
    assertEqual(try file.position(), 6)
    assertEqual(try file.seek(-4, from: .End), 2)
    expect(try file.read(upTo: 2) == [3, 4])
    assertEqual(try file.seek(1, from: .Current), 5)
    expect(try file.read(upTo: 10) == [6])
    expect(try file.read(upTo: 10).isEmpty)
    try file.seek(0, from: .Start)
    expect(try file.read(at: 4, upTo: 10) == [5, 6])
    try file.write(at: 1, [20, 30])
    expect(try file.read(at: 0, upTo: 3) == [1, 20, 30])
    expect(try file.read(at: 100, upTo: 3).isEmpty)
    try file.flush()
    try file.sync()

    let metadata = try file.metadata()
    assertEqual(metadata.size, 6)
    expect(metadata.isFile && !metadata.isDirectory)
    expect(metadata.modified.secondsSinceEpoch > 0)
    try file.setLength(2)
    assertEqual(try file.metadata().size, 2)
    try file.setLength(4)
    expect(try file.read(at: 0, upTo: 10) == [1, 20, 0, 0])

    file.close()
    expect(!file.isOpen)
    file.close()
    expectThrows(saying: "'\(path)' was given something the system does not take") { _ = try file.read(upTo: 1) }
    try File.remove(path)
}

@test
fn openOptionsSayWhatHappens() throws {
    let path = "sable-test-handle-options.txt"
    expectThrows(saying: "nothing is at '\(path)'") { _ = try File.open(path) }
    try File.write(path, "hello")

    var fresh = OpenOptions.writing
    fresh.createNew = true
    expectThrows(saying: "something is at '\(path)' already") { _ = try File.open(path, options: fresh) }

    expectIoError("IsDirectory", "a directory opened as a file") {
        _ = try File.open(".")
    }

    // Appending goes at the end, wherever the position was put.
    let appending = try File.open(path, options: .appending)
    try appending.write([0x21])
    appending.close()
    assertEqual(try File.read(path), "hello!")

    // Truncating empties it; reading a handle opened to write only fails.
    var emptying = OpenOptions()
    emptying.write = true
    emptying.truncate = true
    let emptied = try File.open(path, options: emptying)
    assertEqual(try emptied.metadata().size, 0)
    expectThrows { _ = try emptied.read(upTo: 1) }
    emptied.close()

    let reading = try File.open(path)
    expectThrows { try reading.write([1]) }
    try File.remove(path)
}

@test
fn wholeFilesAsBytesAndText() throws {
    let path = "sable-test-handle-whole.txt"
    let bytes = pattern(300000)
    try File.writeBytes(path, bytes)
    expect(try File.readBytes(path) == bytes)
    try File.appendBytes(path, [0x0A])
    assertEqual(try File.readBytes(path).count, 300001)

    try File.write(path, "one\r\ntwo\n\nthree")
    let lines = try File.readLines(path)
    assertEqual(lines.count, 4)
    assertEqual(lines[0], "one")
    assertEqual(lines[2], "")
    assertEqual(lines[3], "three")
    try File.append(path, "\n")
    assertEqual(try File.readLines(path).count, 4)
    try File.writeBytes(path, [0x61, 0xFF, 0x62])
    assertEqual(try File.read(path), "a\u{FFFD}b")
    try File.remove(path)
    expectIoError("NotFound", "a missing file removed") {
        try File.remove(path)
    }
}

@test
fn copyingAFileCopiesEveryByte() throws {
    let source = "sable-test-handle-copy-source.bin"
    let target = "sable-test-handle-copy-target.bin"
    let bytes = pattern(3 * 1024 * 1024 + 17)
    try File.writeBytes(source, bytes)
    try File.writeBytes(target, [1, 2, 3])
    try File.copy(from: source, to: target)
    expect(try File.readBytes(target) == bytes)
    expectThrows { try File.copy(from: "sable-test-no-such-file", to: target) }
    try File.remove(source)
    try File.remove(target)
}

@test
fn aBufferedWriterFlushesAsItGoes() throws {
    let path = "sable-test-handle-buffered.bin"
    if true {
        let writer = BufferedWriter(try File.open(path, options: .writing), capacity: 1000)
        var i = 0
        while i < 3000 {
            try writer.write([U8.truncating(i), U8.truncating(i >> 8)])
            i += 1
        }
    }
    let written = try File.readBytes(path)
    assertEqual(written.count, 6000)
    assertEqual(Int(written[5998]) | Int(written[5999]) << 8, 2999)

    var lines = BufferedReader(try File.open(path), capacity: 7)
    expect(try lines.read(upTo: 4) == [0, 0, 1, 0])
    try File.remove(path)
}

@test
fn theStandardStreamsAreHandles() throws {
    let output = Console.standardOutput
    try output.write([0x6F, 0x6B, 0x0A])
    try output.flush()
    let error = Console.standardError
    try error.write([])
    expect(Console.standardInput.isOpen)
}
