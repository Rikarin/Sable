module Utf16Tests

// Utf16 (Sable.Text), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Testing
import Sable.Text

@test
fn wellFormedUtf16IsValid() {
    expect(Utf16.isValid([]), "nothing")
    expect(Utf16.isValid([0x48, 0xD83D, 0xDE00, 0xFFFF]), "a pair, and the BMP's last")
    expect(Utf16.validate([0xD7FF, 0xE000]) == none, "around the surrogates")
}

@test(arguments: [([0xDE00, 0x48], 0), ([0x48, 0xD83D], 1), ([0xD83D, 0x48], 0), ([0xD83D, 0xD83D, 0xDE00], 0)])
fn anUnpairedSurrogateIsFound(_ units: U16[>..], _ at: Int) {
    assertEqual(Utf16.validate(units), at)
}

@test
fn aLoneLeadingSurrogateIsNotValid() {
    expect(!Utf16.isValid([0xDBFF]), "a lone leading surrogate")
}

@test
fn surrogateHalves() {
    expect(Utf16.isLeading(0xD800) && Utf16.isLeading(0xDBFF) && !Utf16.isLeading(0xDC00), "leading")
    expect(Utf16.isTrailing(0xDC00) && Utf16.isTrailing(0xDFFF) && !Utf16.isTrailing(0xDBFF) && !Utf16.isTrailing(0xE000), "trailing")
}
