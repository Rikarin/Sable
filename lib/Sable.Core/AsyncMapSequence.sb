module Sable.Core

/// An async sequence's elements, each transformed as it comes: what
/// 'map' on an AsyncSequence makes.
public struct AsyncMapSequence<Base: AsyncSequence, T>: AsyncSequence {
    let base: Base
    let transform: async (Base.Element) -> T

    /// An iterator from the first element.
    public fn makeAsyncIterator() -> AsyncMapIterator<Base.Iter, T> {
        return AsyncMapIterator<Base.Iter, T> { base: base.makeAsyncIterator(), transform: transform }
    }
}

/// Gives an async iterator's elements, transformed.
public struct AsyncMapIterator<Base: AsyncIterator, T>: AsyncIterator {
    var base: Base
    let transform: async (Base.Element) -> T

    /// The next element, transformed, or none past the last.
    public mutating fn next() async throws(Base.Failure) -> T? {
        guard let element = try await base.next() else {
            return none
        }
        return await transform(element)
    }
}
