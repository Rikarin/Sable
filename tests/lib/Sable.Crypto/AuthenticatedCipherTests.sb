module AuthenticatedCipherTests

// AesGcm, AesCcm, ChaCha20Poly1305 and XChaCha20Poly1305 (Sable.Crypto):
// published messages, every length around the kernels' strides, and misuse.
// Wycheproof's and NIST's vectors are run by tools/conformance/ciphers. Run with
//     tools/stdlib-coverage.sh Sable.Crypto

import CryptoSupport
import Sable.Crypto
import Sable.Testing

let key32: SymmetricKey = SymmetricKey(message(32))

fn gcm() -> AesGcm => try! AesGcm(key: key32)

fn ccm() -> AesCcm => try! AesCcm(key: key32)

fn chaCha() -> ChaCha20Poly1305 => try! ChaCha20Poly1305(key: key32)

fn xChaCha() -> XChaCha20Poly1305 => try! XChaCha20Poly1305(key: key32)

fn published<C: AuthenticatedCipher>(_ cipher: C, _ nonce: String, _ data: String, _ plaintext: String, _ ciphertext: String, _ tag: String) {
    let box = try! cipher.seal(hex(plaintext), nonce: hex(nonce), associatedData: hex(data))
    assertEqual("\(Digest(box.ciphertext))\(Digest(box.tag))", ciphertext + tag)
    expect((try! cipher.open(box, associatedData: hex(data))) == hex(plaintext))
}

// McGrew and Viega's cases 4 and 16, and the one the standard begins with.
@test
fn gcmIsAsPublished() {
    published(
        try! AesGcm(key: SymmetricKey(hex("feffe9928665731c6d6a8f9467308308"))),
        "cafebabefacedbaddecaf888",
        "feedfacedeadbeeffeedfacedeadbeefabaddad2",
        "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39",
        "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091",
        "5bc94fbc3221a5db94fae95ae7121a47"
    )
    published(
        try! AesGcm(key: SymmetricKey(hex("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308"))),
        "cafebabefacedbaddecaf888",
        "feedfacedeadbeeffeedfacedeadbeefabaddad2",
        "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39",
        "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662",
        "76fc6ece0f4e1768cddf8853bb2d551b"
    )
    let zero = try! AesGcm(key: SymmetricKey(U8[>..](repeating: 0, count: 16)))
    published(zero, "000000000000000000000000", "", "", "", "58e2fccefa7e3061367f1d57a4e7455a")
}

// Cases 5 and 6, whose nonces are of 8 and of 60 bytes.
@test
fn gcmTakesNoncesOfOtherLengths() {
    let key = SymmetricKey(hex("feffe9928665731c6d6a8f9467308308"))
    let data = "feedfacedeadbeeffeedfacedeadbeefabaddad2"
    let plaintext = "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39"
    published(
        try! AesGcm(key: key, nonceByteCount: 8),
        "cafebabefacedbad",
        data,
        plaintext,
        "61353b4c2806934a777ff51fa22a4755699b2a714fcdc6f83766e5f97b6c742373806900e49f24b22b097544d4896b424989b5e1ebac0f07c23f4598",
        "3612d2e79e3b0785561be14aaca2fccb"
    )
    published(
        try! AesGcm(key: key, nonceByteCount: 60),
        "9313225df88406e555909c5aff5269aa6a7a9538534f7da1e4c303d2a318a728c3c0c95156809539fcf0e2429a6b525416aedbf5a0de6a57a637b39b",
        data,
        plaintext,
        "8ce24998625615b603a033aca13fb894be9112a5c3a211a8ba262a3cca7e2ca701e4a9a4fba43c90ccdcb281d48c7c6fd62875d2aca417034c34aee5",
        "619cc5aefffe0bfa462af43c1699d050"
    )
}

// SP 800-38C's first two examples.
@test
fn ccmIsAsPublished() {
    let key = SymmetricKey(hex("404142434445464748494a4b4c4d4e4f"))
    published(try! AesCcm(key: key, tagByteCount: 4, nonceByteCount: 7), "10111213141516", "0001020304050607", "20212223", "7162015b", "4dac255d")
    published(
        try! AesCcm(key: key, tagByteCount: 6, nonceByteCount: 8),
        "1011121314151617",
        "000102030405060708090a0b0c0d0e0f",
        "202122232425262728292a2b2c2d2e2f",
        "d2a1f0e051ea5f62081a7792073d593d",
        "1fc64fbfaccd"
    )
}

// SP 800-38C's fourth example: 65536 bytes of associated data, whose length
// is written in six.
@test
fn ccmTakesLongAssociatedData() {
    let key = SymmetricKey(hex("404142434445464748494a4b4c4d4e4f"))
    var data: U8[>..] = []
    for i in 0..<65536 {
        data.append(U8(i & 0xFF))
    }
    let cipher = try! AesCcm(key: key, tagByteCount: 14, nonceByteCount: 13)
    let box = try! cipher.seal(hex("202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f"), nonce: hex("101112131415161718191a1b1c"), associatedData: data)
    assertEqual("\(Digest(box.ciphertext))", "69915dad1e84c6376a68c2967e4dab615ae0fd1faec44cc484828529463ccf72")
    assertEqual("\(Digest(box.tag))", "b4ac6bec93e8598e7f0dadbcea5b")
}

let sunscreen: String = "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e"

// RFC 8439's, §2.8.2, and draft-irtf-cfrg-xchacha's, §A.3.1.
@test
fn chaChaIsAsPublished() {
    let key = SymmetricKey(hex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"))
    published(
        try! ChaCha20Poly1305(key: key),
        "070000004041424344454647",
        "50515253c0c1c2c3c4c5c6c7",
        sunscreen,
        "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116",
        "1ae10b594f09e26a7e902ecbd0600691"
    )
    published(
        try! XChaCha20Poly1305(key: key),
        "404142434445464748494a4b4c4d4e4f5051525354555657",
        "50515253c0c1c2c3c4c5c6c7",
        sunscreen,
        "bd6d179d3e83d43b9576579493c0e939572a1700252bfaccbed2902c21396cbb731c7f1b0b4aa6440bf3a82f4eda7e39ae64c6708c54c216cb96b72e1213b4522f8c9ba40db5d945b11b69b982c1bb9e3f3fac2bc369488f76b2383565d3fff921f9664c97637da9768812f615c68b13b52e",
        "c0875924c1c7987947deafd8780acf49"
    )
}

fn everyLength<C: AuthenticatedCipher>(_ cipher: C) {
    let whole = message(1200)
    let nonce = message(cipher.nonceByteCount)
    var count = 0
    while count <= 1200 {
        let plaintext = whole[..<count]
        let data = whole[..<count % 70]
        let box = try! cipher.seal(plaintext, nonce: nonce, associatedData: data)
        assert(box.ciphertext.count == count && box.tag.count == cipher.tagByteCount, "\(count) bytes")
        assertEqual((try! cipher.open(box, associatedData: data)), plaintext.toArray())

        // In place, at an address that is no multiple of anything.
        var place = message(count + 13)
        var tag = U8[>..](repeating: 0, count: cipher.tagByteCount)
        for i in 0..<count {
            place[7 + i] = whole[i]
        }
        try! cipher.seal(inPlace: &place[7..<7 + count], nonce: nonce, associatedData: data, tag: &tag)
        assert(place[7..<7 + count].toArray() == box.ciphertext && tag == box.tag, "\(count) bytes in place")
        assert(place[6] == 45 && place[7 + count] == U8(((7 + count) * 7 + 3) & 0xFF), "what is beside \(count) bytes in place")
        try! cipher.open(inPlace: &place[7..<7 + count], nonce: nonce, associatedData: data, tag: tag)
        assertEqual(place[7..<7 + count].toArray(), plaintext.toArray())
        count += count < 300 ? 1 : 37
    }
}

enum Kind {
    Gcm
    Ccm
    ChaCha
    XChaCha
}

let kinds: Kind[>..] = [.Gcm, .Ccm, .ChaCha, .XChaCha]

@test(arguments: kinds)
fn everyLengthIsOpenedAsItWasSealed(_ kind: Kind) {
    match kind {
        case .Gcm     => everyLength(gcm())
        case .Ccm     => everyLength(ccm())
        case .ChaCha  => everyLength(chaCha())
        case .XChaCha => everyLength(xChaCha())
    }
}

// What the modes are made of, in the library's own others.
@test
fn aLongMessageIsWhatItsPartsMake() {
    let text = message(100_003)
    let nonce = message(12)
    let sealedText = try! gcm().seal(text, nonce: nonce)
    var counter = nonce
    counter.append(contentsOf: [0, 0, 0, 2])
    expect((try! (try! Hazmat.AesCtr(key: key32)).apply(text, counterBlock: counter)) == sealedText.ciphertext)
    var first: U8[>..] = [2]
    first.append(contentsOf: nonce)
    first.append(contentsOf: [0, 0, 1])
    expect((try! (try! Hazmat.AesCtr(key: key32)).apply(text, counterBlock: first)) == (try! ccm().seal(text, nonce: nonce)).ciphertext)

    // Each prefix's ciphertext is the whole one's.
    let whole = try! chaCha().seal(text, nonce: nonce)
    for count in [1, 63, 64, 192, 193, 255, 256, 257, 448, 511, 513, 4096, 16384, 16385, 99_999] {
        require((try! chaCha().seal(text[..<count], nonce: nonce)).ciphertext == whole.ciphertext[..<count].toArray())
    }
    expect((try! chaCha().open(whole)) == text)
    expect((try! gcm().open(sealedText)) == text)
}

fn refused<C: AuthenticatedCipher>(_ cipher: C, _ ciphertext: U8[:], _ nonce: U8[:], _ tag: U8[:], _ data: U8[:]) {
    expectThrows(CryptoError.AuthenticationFailed) { _ = try cipher.open(ciphertext, nonce: nonce, tag: tag, associatedData: data) }
    var place = ciphertext.toArray()
    var into = U8[>..](repeating: 0xAA, count: ciphertext.count)
    expectThrows(CryptoError.AuthenticationFailed) { try cipher.open(inPlace: &place, nonce: nonce, associatedData: data, tag: tag) }
    expectThrows(CryptoError.AuthenticationFailed) { try cipher.open(ciphertext, into: &into, nonce: nonce, associatedData: data, tag: tag) }

    // Nothing of the plaintext is anywhere.
    assert(constantTimeEquals(place, repeating: 0), "something was left in place")
    assert(constantTimeEquals(into, repeating: 0), "something was written")
}

fn changed(_ bytes: U8[:], _ at: Int, _ bit: Int) -> U8[>..] {
    var made = bytes.toArray()
    made[at] = made[at] ^ (1 << U8(bit))
    return made
}

fn whatIsChangedIsRefused<C: AuthenticatedCipher>(_ cipher: C, _ other: C) {
    for count in [0, 1, 16, 40, 200, 700] {
        let text = message(count)
        let data = message(21)
        let nonce = message(cipher.nonceByteCount)
        let box = try! cipher.seal(text, nonce: nonce, associatedData: data)

        // Any bit of the tag, and any end of it.
        for bit in 0..<8 * box.tag.count {
            refused(cipher, box.ciphertext, nonce, changed(box.tag, bit / 8, bit % 8), data)
        }
        for end in 0..<box.tag.count {
            refused(cipher, box.ciphertext, nonce, box.tag[..<end], data)
        }
        var longer = box.tag
        longer.append(0)
        refused(cipher, box.ciphertext, nonce, longer, data)

        // The ciphertext, cut short at either end, longer, or changed.
        for at in 0..<count {
            if at < 40 || at > count - 20 {
                refused(cipher, changed(box.ciphertext, at, at % 8), nonce, box.tag, data)
                refused(cipher, box.ciphertext[..<at], nonce, box.tag, data)
                refused(cipher, box.ciphertext[(at + 1)...], nonce, box.tag, data)
            }
        }
        var padded = box.ciphertext
        padded.append(0)
        refused(cipher, padded, nonce, box.tag, data)

        // The nonce, the associated data, and the key.
        for at in 0..<nonce.count {
            refused(cipher, box.ciphertext, changed(nonce, at, 3), box.tag, data)
        }
        refused(cipher, box.ciphertext, nonce, box.tag, [])
        refused(cipher, box.ciphertext, nonce, box.tag, data[..<20])
        refused(cipher, box.ciphertext, nonce, box.tag, changed(data, 5, 0))
        padded = data
        padded.append(0)
        refused(cipher, box.ciphertext, nonce, box.tag, padded)
        refused(other, box.ciphertext, nonce, box.tag, data)
    }
}

@test(arguments: kinds)
fn whatIsChangedIsRefusedAndGivesNothing(_ kind: Kind) throws {
    let other = SymmetricKey(message(33)[1...])
    match kind {
        case .Gcm     => whatIsChangedIsRefused(gcm(), try AesGcm(key: other))
        case .Ccm     => whatIsChangedIsRefused(ccm(), try AesCcm(key: other))
        case .ChaCha  => whatIsChangedIsRefused(chaCha(), try ChaCha20Poly1305(key: other))
        case .XChaCha => whatIsChangedIsRefused(xChaCha(), try XChaCha20Poly1305(key: other))
    }
}

// What is associated data, and what the message, cannot be moved from one to
// the other.
@test
fn theMessageIsNotItsAssociatedData() {
    let nonce = message(12)
    let box = try! gcm().seal([], nonce: nonce, associatedData: message(32))
    refused(gcm(), message(32), nonce, box.tag, [])
    let poly = try! chaCha().seal([], nonce: nonce, associatedData: message(32))
    refused(chaCha(), message(32), nonce, poly.tag, [])
}

fn reason<C: AuthenticatedCipher>(_ cipher: C, _ nonce: Int, text: Int, room: Int, tag: Int) -> CryptoError? {
    var place = message(room)
    var made = message(tag)
    do {
        try cipher.seal(message(text), into: &place, nonce: message(nonce), associatedData: [], tag: &made)
        return none
    } catch {
        expect(place == message(room) && made == message(tag), "something was written")
        return error
    }
}

@test
fn wrongLengthsAreErrorsAndWriteNothing() {
    expect(reason(gcm(), 12, text: 20, room: 20, tag: 16) == none)
    expect(reason(gcm(), 11, text: 20, room: 20, tag: 16)?.description() == "a nonce of this cipher has 12 bytes, not 11")
    expect(reason(gcm(), 0, text: 20, room: 20, tag: 16)?.description() == "a nonce of this cipher has 12 bytes, not 0")
    expect(reason(xChaCha(), 12, text: 20, room: 20, tag: 16)?.description() == "a nonce of this cipher has 24 bytes, not 12")
    expect(reason(gcm(), 12, text: 20, room: 19, tag: 16)?.description() == "the plaintext and the ciphertext are as long as each other, not 20 and 19 bytes")
    expect(reason(chaCha(), 12, text: 20, room: 21, tag: 16)?.description() == "the plaintext and the ciphertext are as long as each other, not 20 and 21 bytes")
    expect(reason(ccm(), 12, text: 20, room: 20, tag: 15)?.description() == "a tag of this cipher has 16 bytes, not 15")
    var place = message(5)
    var tag = message(17)
    expectThrows(saying: "a tag of this cipher has 16 bytes, not 17") { try gcm().seal(inPlace: &place, nonce: message(12), associatedData: [], tag: &tag) }
    expect(place == message(5))
    expectThrows(saying: "a nonce of this cipher has 12 bytes, not 13") { try gcm().open(inPlace: &place, nonce: message(13), associatedData: [], tag: message(16)) }
    expectThrows(saying: "the plaintext and the ciphertext are as long as each other, not 4 and 5 bytes") {
        try gcm().open(message(4), into: &place, nonce: message(12), associatedData: [], tag: message(16))
    }
}

@test(arguments: [16, 24, 32])
fn anAesKeyHasALengthOfThese(_ count: Int) throws {
    _ = try AesGcm(key: SymmetricKey(message(count)))
}

@test(arguments: [0, 1, 15, 17, 31, 33, 64])
fn keysHaveTheirLengths(_ count: Int) {
    expectThrows(saying: "an AES key has 16, 24 or 32 bytes, not \(count)") { _ = try AesGcm(key: SymmetricKey(message(count))) }
}

@test(arguments: [0, 16, 31, 33])
fn aChaChaKeyHasItsLength(_ count: Int) {
    expectThrows(saying: "a ChaCha20 key has 32 bytes, not \(count)") { _ = try ChaCha20Poly1305(key: SymmetricKey(message(count))) }
}

@test(arguments: [0, 4, 11, 17])
fn aGcmTagHasALengthOfThese(_ count: Int) {
    expectThrows(saying: "an AES-GCM tag has 12 to 16 bytes, not \(count)") { _ = try AesGcm(key: key32, tagByteCount: count) }
}

@test
fn aGcmNonceHasAByte() {
    expectThrows(saying: "an AES-GCM nonce has 1 byte or more, not 0") { _ = try AesGcm(key: key32, nonceByteCount: 0) }
}

@test(arguments: [0, 2, 5, 15, 18])
fn aCcmTagHasALengthOfThese(_ count: Int) {
    expectThrows(saying: "an AES-CCM tag has 4, 6, 8, 10, 12, 14 or 16 bytes, not \(count)") { _ = try AesCcm(key: key32, tagByteCount: count) }
}

@test(arguments: [6, 14])
fn aCcmNonceHasALengthOfThese(_ count: Int) {
    expectThrows(saying: "an AES-CCM nonce has 7 to 13 bytes, not \(count)") { _ = try AesCcm(key: key32, nonceByteCount: count) }
}

@test(arguments: [12, 13, 14, 15])
fn aShorterGcmTagIsTheLongerOnesFirstBytes(_ count: Int) throws {
    let box = try gcm().seal([1, 2, 3], nonce: message(12))
    let cut = try AesGcm(key: key32, tagByteCount: count).seal([1, 2, 3], nonce: message(12))
    expect(cut.tag == box.tag[..<count].toArray())
}

// A nonce of 13 bytes leaves two for the length.
@test
fn aCcmMessageIsNoLongerThanItsLengthCanSay() {
    let cipher = try! AesCcm(key: key32, nonceByteCount: 13)
    let longest = U8[>..](repeating: 1, count: 65535)
    let box = try! cipher.seal(longest, nonce: message(13))
    expect((try! cipher.open(box)) == longest)
    expectThrows(CryptoError.LimitExceeded(reason: "a message of this cipher has at most 65535 bytes, not 65536")) { _ = try cipher.seal(U8[>..](repeating: 1, count: 65536), nonce: message(13)) }
}

@test
fn randomNoncesAreCounted() {
    let cipher = try! AesCcm(key: key32, nonceByteCount: 7)
    let copy = cipher
    for i in 0..<4096 {
        _ = try! (i % 2 == 0 ? cipher : copy).randomNonce()
    }
    for _ in 0..<2 {
        expectThrows(CryptoError.LimitExceeded(reason: "this key has had 4096 random nonces of 7 bytes, and one more could be one it has had")) { _ = try cipher.seal([1]) }
    }

    // The caller's own are still the caller's.
    _ = try! cipher.seal([1], nonce: message(7))
    let short = try! AesGcm(key: key32, nonceByteCount: 4)
    _ = try! short.seal([1])
    let error = expectThrows(CryptoError.self) { _ = try short.seal([1]) }
    expect(error != CryptoError.AuthenticationFailed)
    expect((try! xChaCha().randomNonce()).count == 24)
    expect((try! gcm().randomNonce()).count == 12)
    expect((try! chaCha().randomNonce()) != (try! chaCha().randomNonce()))
}

// The array sealed from and the one sealed to are the same one's copies, or
// the associated data is: a value is never seen half changed.
@test
fn arraysThatShareTheirMemoryAreEachTheirOwn() {
    let nonce = message(12)
    let text = message(300)
    let expected = try! gcm().seal(text, nonce: nonce, associatedData: text)
    var target = text
    var tag = U8[>..](repeating: 0, count: 16)
    try! gcm().seal(text, into: &target, nonce: nonce, associatedData: text, tag: &tag)
    expect(text == message(300) && target == expected.ciphertext && tag == expected.tag)
    target = text
    try! gcm().seal(inPlace: &target, nonce: nonce, associatedData: text, tag: &tag)
    expect(text == message(300) && target == expected.ciphertext && tag == expected.tag)

    // Parts of one array that overlap.
    var buffer = text
    let before = buffer
    try! chaCha().seal(before[8..<208], into: &buffer[..<200], nonce: nonce, associatedData: before[100...], tag: &tag)
    let apart = try! chaCha().seal(text[8..<208], nonce: nonce, associatedData: text[100...])
    expect(buffer[..<200].toArray() == apart.ciphertext && tag == apart.tag)
    expect(buffer[200...].toArray() == text[200...].toArray())

    // And the tag is the text's own end.
    var packet = message(40)
    packet.append(repeating: 0, count: 16)
    var end = U8[>..](repeating: 0, count: 16)
    try! xChaCha().seal(inPlace: &packet[..<40], nonce: message(24), associatedData: [], tag: &end)
    for i in 0..<16 {
        packet[40 + i] = end[i]
    }
    let opened = try! xChaCha().open(packet[..<40], nonce: message(24), tag: packet[40...])
    expect(opened == message(40))
}

@test
fn aBoxIsItsParts() {
    let box = try! gcm().seal([1, 2, 3], associatedData: [4])
    let again = try! SealedBox(combined: box.combined)
    expect(again == box && again.ciphertext.count == 3)
    expect((try! gcm().open(again, associatedData: [4])) == [1, 2, 3])
    let long = try! xChaCha().seal([])
    expect((try! SealedBox(combined: long.combined, nonceByteCount: 24)) == long)
    for count in [0, 11, 12, 27] {
        expectThrows(CryptoError.AuthenticationFailed) { _ = try SealedBox(combined: box.combined[..<count]) }
    }
    expectThrows(CryptoError.AuthenticationFailed) { _ = try SealedBox(combined: box.combined, nonceByteCount: -1) }
    expectThrows(CryptoError.AuthenticationFailed) { _ = try gcm().open(try SealedBox(combined: box.combined[..<30]), associatedData: [4]) }
}

@test
fn anEmptyMessageHasATag() {
    let box = try! gcm().seal([])
    expect(box.ciphertext.isEmpty && box.tag.count == 16)
    expect((try! gcm().open(box)).isEmpty)
    refused(gcm(), [], box.nonce, message(16), [])
}

// The key is the cipher's own: what it was made of may go, or be zeroed.
@test
fn aCipherOutlivesItsKey() {
    var made = message(32)
    let cipher = try! ChaCha20Poly1305(key: SymmetricKey(made))
    let other = try! AesGcm(key: SymmetricKey(made))
    secureZero(&made)
    expect((try! cipher.seal([1, 2], nonce: message(12))) == (try! chaCha().seal([1, 2], nonce: message(12))))
    expect((try! other.seal([1, 2], nonce: message(12))) == (try! gcm().seal([1, 2], nonce: message(12))))
}
