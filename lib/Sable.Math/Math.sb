module Sable.Math

// Integer and floating-point arithmetic beyond the operators: written in
// Sable, over the core's Comparable.

/// The greater of two values.
public fn max<T: Comparable>(_ a: T, _ b: T) -> T {
    return a < b ? b : a
}

/// The lesser of two values.
public fn min<T: Comparable>(_ a: T, _ b: T) -> T {
    return b < a ? b : a
}

/// The value, kept within [low, high].
public fn clamp<T: Comparable>(_ value: T, _ low: T, _ high: T) -> T {
    if value < low {
        return low
    }
    if high < value {
        return high
    }
    return value
}

/// The greatest common divisor, never negative; gcd(0, 0) is 0.
public fn gcd(_ a: Int, _ b: Int) -> Int {
    var x = a < 0 ? 0 - a : a
    var y = b < 0 ? 0 - b : b
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    return x
}

/// The least common multiple, never negative; lcm with 0 is 0.
public fn lcm(_ a: Int, _ b: Int) -> Int {
    if a == 0 || b == 0 {
        return 0
    }
    let product = a / gcd(a, b) * b
    return product < 0 ? 0 - product : product
}

/// base to the power exponent, by squaring; traps on overflow, as '*' does.
public fn power(_ base: Int, _ exponent: Int) -> Int {
    var result = 1
    var b = base
    var e = exponent
    while e > 0 {
        if e % 2 == 1 {
            result = result * b
        }
        e = e / 2
        if e > 0 {
            b = b * b
        }
    }
    return result
}

/// Whether n is prime, by trial division.
public fn isPrime(_ n: Int) -> Bool {
    if n < 2 {
        return false
    }
    if n < 4 {
        return true
    }
    if n % 2 == 0 {
        return false
    }
    var d = 3
    while d <= n / d {
        if n % d == 0 {
            return false
        }
        d = d + 2
    }
    return true
}

/// The square root, by Newton's method; NaN-free: negative input gives 0.
public fn squareRoot(_ x: F64) -> F64 {
    if x <= 0.0 {
        return 0.0
    }
    var guess = x > 1.0 ? x / 2.0 : 1.0
    var i = 0
    while i < 64 {
        let next = 0.5 * (guess + x / guess)
        if next == guess {
            return next
        }
        guess = next
        i = i + 1
    }
    return guess
}

/// The largest integer not greater than x, as an Int.
public fn floor(_ x: F64) -> Int {
    let truncated = Int(x)
    return F64(truncated) > x ? truncated - 1 : truncated
}

/// The smallest integer not less than x, as an Int.
public fn ceiling(_ x: F64) -> Int {
    let truncated = Int(x)
    return F64(truncated) < x ? truncated + 1 : truncated
}

/// x rounded to the nearest integer, halves away from zero.
public fn round(_ x: F64) -> Int {
    return x < 0.0 ? 0 - floor(0.5 - x) : floor(x + 0.5)
}
