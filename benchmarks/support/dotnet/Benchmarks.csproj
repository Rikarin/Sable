<Project Sdk="Microsoft.NET.Sdk">
  <!-- The .NET ports of the benchmarks; not part of Sable.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <!-- With ICU, for normalisation. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../library/**/*.cs;../../programs/**/*.cs" />
    <!-- Microsoft.Extensions.DependencyInjection, which the SDK has with ASP.NET. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- TensorPrimitives and Tensor<T>, for tensor-primitives and tensor-matmul: a NuGet package, not in the box. -->
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0" />
    <!-- Crc32, Crc64, Adler32 and the xxHashes, for hashing: a NuGet package too. -->
    <PackageReference Include="System.IO.Hashing" Version="11.0.0" />
  </ItemGroup>
</Project>
