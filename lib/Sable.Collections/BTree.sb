module Sable.Collections

// The B-tree SortedDictionary and SortedSet are made of. Each node holds up
// to 2t - 1 keys in order, with a value for each, and an internal node one
// more child than keys, the child before key i holding the keys below it.
// Every node but the root holds at least t - 1 keys, so the tree's height
// is about log_t n: with t = 8, a million keys are five levels deep, and a
// node's keys are a few cache lines searched in a row.
//
// The nodes are numbered, a node given up going on a list to be used again,
// and what they hold is in arrays of every node's: node n's keys are the
// slots from 15n on, its values those of the same places, its children the
// sixteen from 16n, the first of them -1 in a leaf. A slot with no key is a
// hole (Array.sb). A copy of the tree shares the arrays until either changes
// it, as any array is shared. Each node also knows how many keys its subtree
// holds, so that a key's rank, and the key of a rank, are found in one walk
// down: what the collections' positions are.
//
// Insertion splits a full node on the way down (Cormen et al., 18.2), and
// removal makes sure on the way down that each node it goes into has a key
// to spare (18.3), borrowing one from a sibling or merging with it, so that
// neither walks back up.

/// Keys at least, past the root: t - 1; at most 2t - 1.
const bTreeDegree = 8
const bTreeMostKeys = 2 * bTreeDegree - 1
const bTreeMostChildren = 2 * bTreeDegree

struct BTree<Key: Comparable, Value> {
    var keys: Key[>..] = []
    var values: Value[>..] = []
    var children: I32[>..] = []
    // Each node's keys, and the keys in it and every node below it.
    var counts: I32[>..] = []
    var sizes: Int[>..] = []
    var unused: Int[>..] = []
    var root: Int = -1

    var count: Int => root < 0 ? 0 : sizes[root]

    // ---- Nodes ----------------------------------------------------------

    /// A leaf with no key.
    mutating fn makeNode() -> Int {
        if !unused.isEmpty {
            return unused.removeLast()
        }
        let n = counts.count
        if n == 0x7FFF_FFFF {
            fatalError("a B-tree has at most 2147483647 nodes")
        }
        keys.append(holes: bTreeMostKeys)
        values.append(holes: bTreeMostKeys)
        children.append(repeating: -1, count: bTreeMostChildren)
        counts.append(0)
        sizes.append(0)
        return n
    }

    /// The node, whose keys and children are gone already, to be used again.
    mutating fn giveUp(_ n: Int) {
        children[n * bTreeMostChildren] = -1
        counts[n] = 0
        sizes[n] = 0
        unused.append(n)
    }

    @inline(always)
    fn isLeaf(_ n: Int) -> Bool => children[n &* bTreeMostChildren] < 0

    @inline(always)
    fn child(_ n: Int, _ i: Int) -> Int => Int(children[n &* bTreeMostChildren &+ i])

    @inline(always)
    fn keyCount(_ n: Int) -> Int => Int(counts[n])

    /// Where key i of the node is, and its value.
    @inline(always)
    fn place(_ n: Int, _ i: Int) -> Int => n &* bTreeMostKeys &+ i

    fn isFull(_ n: Int) -> Bool => keyCount(n) == bTreeMostKeys

    /// Whether a value is anything to move: a set's is not.
    static var hasValues: Bool => (Value.self as Type).stride > 0

    /// The first of the node's keys not below the key, and whether it is
    /// the key.
    @inline(always)
    fn locate(_ key: Key, _ n: Int) -> (Int, Bool) {
        // The run of keys halved, stepping over its lower half or not with
        // no branch on which: as many steps whatever the key, so that there
        // is none for the machine to guess wrong.
        let start = place(n, 0)
        var low = start
        var size = keyCount(n)
        let end = start &+ size
        while size > 0 {
            let half = (size &+ 1) >> 1
            low = (keys[low &+ half &- 1] < key).selecting(low &+ half, low)
            size = size &- half
        }
        return (low &- start, low < end && !(key < keys[low]))
    }

    /// The key and its value put in the node as its ith, those from there
    /// on moved one along: there is room.
    mutating fn insertKey(_ n: Int, _ i: Int, _ key: Key, _ value: Value) {
        let at = place(n, i)
        let end = place(n, keyCount(n))
        if at < end {
            keys.rotate(from: at, to: end + 1, left: -1)
            if BTree.hasValues {
                values.rotate(from: at, to: end + 1, left: -1)
            }
        }
        keys[at] = key
        values[at] = value
        counts[n] = counts[n] + 1
    }

    /// Key i of the node and its value, taken out.
    mutating fn takeKey(_ n: Int, _ i: Int) -> (Key, Value) {
        let at = place(n, i)
        let end = place(n, keyCount(n))
        let key = keys.take(at: at)
        let value = values.take(at: at)
        if at + 1 < end {
            keys.rotate(from: at, to: end, left: 1)
            if BTree.hasValues {
                values.rotate(from: at, to: end, left: 1)
            }
        }
        counts[n] = counts[n] - 1
        return (key, value)
    }

    /// The child put before child i of the node, which has as many children
    /// as it is given ('had'), before its count of keys was changed.
    mutating fn insertChild(_ n: Int, _ i: Int, _ child: Int, had: Int) {
        let start = n * bTreeMostChildren
        children.rotate(from: start + i, to: start + had + 1, left: -1)
        children[start + i] = I32(child)
    }

    mutating fn takeChild(_ n: Int, _ i: Int, had: Int) -> Int {
        let start = n * bTreeMostChildren
        let child = Int(children[start + i])
        children.rotate(from: start + i, to: start + had, left: 1)
        return child
    }

    // ---- Reading --------------------------------------------------------

    fn contains(_ key: Key) -> Bool {
        var n = root
        while n >= 0 {
            let (i, found) = locate(key, n)
            if found {
                return true
            }
            n = child(n, isLeaf(n) ? 0 : i)
        }
        return false
    }

    fn value(_ key: Key) -> Value? {
        var n = root
        while n >= 0 {
            let (i, found) = locate(key, n)
            if found {
                return values[place(n, i)]
            }
            n = child(n, isLeaf(n) ? 0 : i)
        }
        return none
    }

    /// The key and value of a rank, 0 the least.
    fn entry(rank: Int) -> (Key, Value) {
        var n = root
        var r = rank
        while true {
            if isLeaf(n) {
                // One out of range is past the leaf's keys: a trap, as it
                // would be of an array of them.
                precondition(index: r, inBounds: keyCount(n))
                return (keys[place(n, r)], values[place(n, r)])
            }
            var j = 0
            while true {
                let below = sizes[child(n, j)]
                if r < below {
                    n = child(n, j)
                    break
                }
                if r == below {
                    return (keys[place(n, j)], values[place(n, j)])
                }
                r = r - below - 1
                j = j + 1
            }
        }
    }

    /// How many keys are below the key, or, with 'orEqual', not above it.
    fn rank(of key: Key, orEqual: Bool) -> Int {
        var n = root
        var r = 0
        while n >= 0 {
            let (at, found) = locate(key, n)
            let i = found && orEqual ? at + 1 : at
            if isLeaf(n) {
                return r + i
            }
            var j = 0
            while j < i {
                r = r + sizes[child(n, j)] + 1
                j = j + 1
            }
            if found && !orEqual {
                return r + sizes[child(n, i)]
            }
            if found {
                return r
            }
            n = child(n, i)
        }
        return r
    }

    // ---- Insertion ------------------------------------------------------

    /// Sets the key's value: the value it replaced, or none when the key is
    /// new.
    @discardable
    mutating fn insert(_ key: Key, _ value: Value) -> Value? {
        if root < 0 {
            root = makeNode()
        }
        // A key there already keeps its place: only its value changes. The
        // way down is kept, four bits a level: with at least eight children
        // to a node there is no memory for a tree of more levels than sixteen.
        var n = root
        var path = 0
        var depth = 0
        while true {
            let (i, found) = locate(key, n)
            if found {
                let at = place(n, i)
                let old = values.take(at: at)
                values[at] = value
                return old
            }
            path = path << 4 | i
            if isLeaf(n) {
                break
            }
            n = child(n, i)
            depth += 4
        }

        if !isFull(n) {
            // Into the leaf, each node on the way one key the larger.
            let leaf = n
            n = root
            while depth > 0 {
                sizes[n] = sizes[n] &+ 1
                n = child(n, path >> depth & 15)
                depth -= 4
            }
            sizes[leaf] = sizes[leaf] &+ 1
            insertKey(leaf, path & 15, key, value)
            return none
        }

        if isFull(root) {
            let above = makeNode()
            children[above * bTreeMostChildren] = I32(root)
            sizes[above] = sizes[root]
            root = above
            split(above, 0)
        }
        n = root
        while true {
            sizes[n] = sizes[n] + 1
            let (at, _) = locate(key, n)
            var i = at
            if isLeaf(n) {
                insertKey(n, i, key, value)
                return none
            }
            if isFull(child(n, i)) {
                split(n, i)
                if keys[place(n, i)] < key {
                    i = i + 1
                }
            }
            n = child(n, i)
        }
    }

    /// The full child i of the node split in two about its middle key,
    /// which moves up into the node.
    mutating fn split(_ parent: Int, _ i: Int) {
        let full = child(parent, i)
        let t = bTreeDegree
        let leaf = isLeaf(full)
        let right = makeNode()
        var j = t
        while j < bTreeMostKeys {
            keys[place(right, j - t)] = keys.take(at: place(full, j))
            values[place(right, j - t)] = values.take(at: place(full, j))
            j = j + 1
        }
        var size = t - 1
        if !leaf {
            j = t
            while j < bTreeMostChildren {
                let moved = children[full * bTreeMostChildren + j]
                children[right * bTreeMostChildren + j - t] = moved
                size = size + sizes[Int(moved)]
                j = j + 1
            }
        }
        counts[right] = I32(t - 1)
        sizes[right] = size
        let middleKey = keys.take(at: place(full, t - 1))
        let middleValue = values.take(at: place(full, t - 1))
        counts[full] = I32(t - 1)
        sizes[full] = sizes[full] - size - 1
        insertChild(parent, i + 1, right, had: keyCount(parent) + 1)
        insertKey(parent, i, middleKey, middleValue)
    }

    // ---- Removal --------------------------------------------------------

    /// Takes the key out: its value, or none when it is not there.
    @discardable
    mutating fn remove(_ key: Key) -> Value? {
        if !contains(key) {
            return none
        }
        let removed = removeIn(root, key)
        shrink()
        return removed
    }

    /// The least or the greatest key, with its value, taken out.
    @discardable
    mutating fn removeExtreme(greatest: Bool) -> (Key, Value)? {
        if root < 0 {
            return none
        }
        let removed = removeEnd(root, greatest)
        shrink()
        return removed
    }

    /// A root left with no key gives way to its one child, or the tree is
    /// empty.
    mutating fn shrink() {
        if root >= 0 && keyCount(root) == 0 {
            let old = root
            root = child(old, 0)
            giveUp(old)
        }
    }

    // The key, which is in the subtree of n, taken out of it; n has a key
    // to spare, or is the root.
    mutating fn removeIn(_ n: Int, _ key: Key) -> Value {
        sizes[n] = sizes[n] - 1
        let (i, found) = locate(key, n)
        if isLeaf(n) {
            return takeKey(n, i).1
        }
        if found {
            let left = child(n, i)
            let right = child(n, i + 1)
            if keyCount(left) >= bTreeDegree {
                // Replaced by the greatest key before it.
                return replace(n, i, removeEnd(left, true)).1
            }
            if keyCount(right) >= bTreeDegree {
                return replace(n, i, removeEnd(right, false)).1
            }
            // Both at their least: merged about the key, which goes down.
            merge(n, i)
            return removeIn(left, key)
        }
        let into = spare(n, i)
        return removeIn(into, key)
    }

    // Key i of n and its value, with another put in their place.
    mutating fn replace(_ n: Int, _ i: Int, _ entry: (Key, Value)) -> (Key, Value) {
        let at = place(n, i)
        let key = keys.take(at: at)
        let value = values.take(at: at)
        keys[at] = entry.0
        values[at] = entry.1
        return (key, value)
    }

    // The least or greatest key of the subtree of n, taken out.
    mutating fn removeEnd(_ n: Int, _ greatest: Bool) -> (Key, Value) {
        sizes[n] = sizes[n] - 1
        if isLeaf(n) {
            return takeKey(n, greatest ? keyCount(n) - 1 : 0)
        }
        let into = spare(n, greatest ? keyCount(n) : 0)
        return removeEnd(into, greatest)
    }

    /// Child i of n made to hold a key to spare before removal goes into
    /// it: by a key from a sibling that has one, or merged with a sibling.
    /// The child to go into.
    mutating fn spare(_ n: Int, _ i: Int) -> Int {
        let into = child(n, i)
        let count = keyCount(into)
        if count >= bTreeDegree {
            return into
        }
        if i > 0 && keyCount(child(n, i - 1)) >= bTreeDegree {
            // The left sibling's last key goes up, the parent's comes down.
            let left = child(n, i - 1)
            let last = keyCount(left)
            let down = replace(n, i - 1, takeKey(left, last - 1))
            insertKey(into, 0, down.0, down.1)
            var moved = 1
            if !isLeaf(left) {
                let grandchild = takeChild(left, last, had: last + 1)
                insertChild(into, 0, grandchild, had: count + 1)
                moved = moved + sizes[grandchild]
            }
            sizes[into] = sizes[into] + moved
            sizes[left] = sizes[left] - moved
            return into
        }
        if i < keyCount(n) && keyCount(child(n, i + 1)) >= bTreeDegree {
            let right = child(n, i + 1)
            let had = keyCount(right) + 1
            let down = replace(n, i, takeKey(right, 0))
            insertKey(into, count, down.0, down.1)
            var moved = 1
            if !isLeaf(right) {
                let grandchild = takeChild(right, 0, had: had)
                insertChild(into, count + 1, grandchild, had: count + 1)
                moved = moved + sizes[grandchild]
            }
            sizes[into] = sizes[into] + moved
            sizes[right] = sizes[right] - moved
            return into
        }
        if i < keyCount(n) {
            merge(n, i)
            return into
        }
        merge(n, i - 1)
        return child(n, i - 1)
    }

    /// Children i and i + 1 of n made one, about key i of n.
    mutating fn merge(_ n: Int, _ i: Int) {
        let left = child(n, i)
        let right = takeChild(n, i + 1, had: keyCount(n) + 1)
        let middle = takeKey(n, i)
        var count = keyCount(left)
        insertKey(left, count, middle.0, middle.1)
        count = count + 1
        let moved = keyCount(right)
        var j = 0
        while j < moved {
            keys[place(left, count + j)] = keys.take(at: place(right, j))
            values[place(left, count + j)] = values.take(at: place(right, j))
            j = j + 1
        }
        if !isLeaf(right) {
            j = 0
            while j <= moved {
                children[left * bTreeMostChildren + count + j] = children[right * bTreeMostChildren + j]
                j = j + 1
            }
        }
        counts[left] = I32(count + moved)
        sizes[left] = sizes[left] + 1 + sizes[right]
        giveUp(right)
    }

    // ---- Building -------------------------------------------------------

    /// A tree of keys already in order, each once, with their values: made
    /// level by level, in linear time, every node as full as the count
    /// allows.
    static fn build(_ keys: Key[:], _ values: Value[:]) -> BTree<Key, Value> {
        var tree = BTree<Key, Value>()
        if keys.isEmpty {
            return tree
        }
        var height = 0
        while BTree.capacity(height) < keys.count {
            height = height + 1
        }
        tree.root = tree.buildNode(keys, values, 0, keys.count, height)
        return tree
    }

    /// The most keys a subtree of the height holds: (2t)^(h + 1) - 1.
    static fn capacity(_ height: Int) -> Int {
        var most = 1
        var h = 0
        while h <= height {
            most = most * (bTreeMostKeys + 1)
            h = h + 1
        }
        return most - 1
    }

    mutating fn buildNode(_ allKeys: Key[:], _ allValues: Value[:], _ low: Int, _ high: Int, _ height: Int) -> Int {
        let n = high - low
        let made = makeNode()
        sizes[made] = n
        if height == 0 {
            var i = 0
            while i < n {
                keys[place(made, i)] = allKeys[low + i]
                values[place(made, i)] = allValues[low + i]
                i = i + 1
            }
            counts[made] = I32(n)
            return made
        }
        // As few children as hold them all, the keys shared out evenly.
        let below = BTree.capacity(height - 1)
        var parts = (n + 1 + below) / (below + 1)
        if parts < 2 {
            parts = 2
        }
        let shared = n - (parts - 1)
        var start = low
        var part = 0
        while part < parts {
            let take = shared / parts + (part < shared % parts ? 1 : 0)
            let built = buildNode(allKeys, allValues, start, start + take, height - 1)
            children[made * bTreeMostChildren + part] = I32(built)
            start = start + take
            if part < parts - 1 {
                keys[place(made, part)] = allKeys[start]
                values[place(made, part)] = allValues[start]
                start = start + 1
            }
            part = part + 1
        }
        counts[made] = I32(parts - 1)
        return made
    }
}

/// Goes through a B-tree's keys in order from a place, as far as a bound:
/// the iterator of SortedDictionary and SortedSet, and of their ranges.
struct BTreeCursor<Key: Comparable, Value> {
    let tree: BTree<Key, Value>
    // The nodes on the way down, and in each the next key to give.
    var path: Int[>..]
    var slots: Int[>..]
    // Keys from here on are past the end: above the bound, or, unless the
    // bound is in, at it.
    let upper: Key?
    let upperIncluded: Bool

    /// At the least key not below 'lower' (or, unless 'lowerIncluded', above
    /// it); at the least key of all when there is no lower bound.
    init(_ tree: BTree<Key, Value>, from lower: Key?, included lowerIncluded: Bool, to upper: Key?, included upperIncluded: Bool) {
        self.tree = tree
        self.path = []
        self.slots = []
        self.upper = upper
        self.upperIncluded = upperIncluded
        // At each node, the first key not below the bound (above it, if
        // the bound is out), and down into the child before that key.
        var n = tree.root
        while n >= 0 {
            var i = 0
            if let bound = lower {
                let (at, found) = tree.locate(bound, n)
                i = found && !lowerIncluded ? at + 1 : at
            }
            path.append(n)
            slots.append(i)
            if tree.isLeaf(n) {
                return
            }
            n = tree.child(n, i)
        }
    }

    // The way down to the least key of the subtree of n.
    mutating fn lowerFrom(_ start: Int) {
        var n = start
        while true {
            path.append(n)
            slots.append(0)
            if tree.isLeaf(n) {
                return
            }
            n = tree.child(n, 0)
        }
    }

    mutating fn next() -> (Key, Value)? {
        while !path.isEmpty {
            let n = path[path.count - 1]
            let i = slots[slots.count - 1]
            if i < tree.keyCount(n) {
                let key = tree.keys[tree.place(n, i)]
                if let bound = upper {
                    if bound < key || !upperIncluded && !(key < bound) {
                        path = []
                        return none
                    }
                }
                slots[slots.count - 1] = i + 1
                if !tree.isLeaf(n) {
                    lowerFrom(tree.child(n, i + 1))
                }
                return (key, tree.values[tree.place(n, i)])
            }
            path.removeLast()
            slots.removeLast()
        }
        return none
    }
}
