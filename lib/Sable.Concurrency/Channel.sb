module Sable.Concurrency

import Sable.Time

// Channels and waiting (docs/04 §4.3), written in Sable over the core's
// Task and WaitList; task groups are the core's. A channel is an actor, so
// its buffer is changed by one call at a time, whichever threads its
// senders and receivers run on; a receiver with nothing to take parks
// until a value is sent or the channel is closed, holding no thread.

/// Values passed from task to task in the order sent; unbounded. What is
/// sent crosses from one task to another, so it is Sendable.
///
/// ```sable
/// let channel = Channel<Int>()
/// let consumer = Task.spawn {
///     var total = 0
///     for await value in channel {
///         total += value
///     }
///     return total
/// }
/// for i in 1...3 {
///     await channel.send(i)
/// }
/// await channel.close()
/// print(await consumer.value)   // 6
/// ```
public actor Channel<Element: Sendable>: AsyncSequence {
    public alias Iter = ChannelIterator<Element>

    var buffer: Element[>..] = []
    var head: Int = 0
    var closed: Bool = false
    let receivers: WaitList = WaitList()

    public init() { }

    /// Adds the value for a receiver; a value sent after closing is dropped.
    public fn send(_ value: Element) {
        if !closed {
            buffer.append(value)
            receivers.wakeAll()
        }
    }

    /// No more values will come: receivers get none once the buffer is empty.
    public fn close() {
        closed = true
        receivers.wakeAll()
    }

    public var isClosed: Bool => closed

    /// Values sent and not yet received.
    public var pending: Int => buffer.count - head

    /// The next value, waiting for one; none once closed and empty.
    public fn receive() async -> Element? {
        while head >= buffer.count {
            if closed {
                return none
            }
            await receivers.park()
        }
        return take()
    }

    /// Its values as they are received, for 'for await'.
    public nonisolated fn makeAsyncIterator() -> ChannelIterator<Element> {
        return ChannelIterator<Element> { channel: self }
    }

    /// The next value if one is there now; none otherwise.
    public fn tryReceive() -> Element? {
        if head >= buffer.count {
            return none
        }
        return take()
    }

    fn take() -> Element {
        let value = buffer[head]
        head += 1
        // Emptied: start again, so a long-lived channel does not grow.
        if head == buffer.count {
            buffer = []
            head = 0
        }
        return value
    }
}

/// Receives a channel's values, one per 'next()': what 'for await value in
/// channel' goes through, until the channel is closed and empty.
public struct ChannelIterator<Value: Sendable>: AsyncIterator {
    public alias Element = Value

    let channel: Channel<Value>

    public mutating fn next() async -> Value? {
        return await channel.receive()
    }
}
