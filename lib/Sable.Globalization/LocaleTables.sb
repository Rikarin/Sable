/// The record of a locale that has one.
fn localeRecord(_ tag: String) -> String? {
    return match tag {
        case "en"      => recordEn
        case "en-001"  => recordEn001
        case "en-AU"   => recordEnAu
        case "en-CA"   => recordEnCa
        case "en-GB"   => recordEnGb
        case "en-IE"   => recordEnIe
        case "en-IN"   => recordEnIn
        case "en-NZ"   => recordEnNz
        case "en-ZA"   => recordEnZa
        case "de"      => recordDe
        case "de-AT"   => recordDeAt
        case "de-CH"   => recordDeCh
        case "fr"      => recordFr
        case "fr-CA"   => recordFrCa
        case "fr-CH"   => recordFrCh
        case "es"      => recordEs
        case "es-419"  => recordEs419
        case "es-MX"   => recordEsMx
        case "it"      => recordIt
        case "it-CH"   => recordItCh
        case "pt"      => recordPt
        case "pt-PT"   => recordPtPt
        case "nl"      => recordNl
        case "ca"      => recordCa
        case "sv"      => recordSv
        case "da"      => recordDa
        case "nb"      => recordNb
        case "fi"      => recordFi
        case "is"      => recordIs
        case "pl"      => recordPl
        case "cs"      => recordCs
        case "sk"      => recordSk
        case "sl"      => recordSl
        case "hr"      => recordHr
        case "sr"      => recordSr
        case "hu"      => recordHu
        case "ro"      => recordRo
        case "bg"      => recordBg
        case "ru"      => recordRu
        case "uk"      => recordUk
        case "el"      => recordEl
        case "tr"      => recordTr
        case "lt"      => recordLt
        case "lv"      => recordLv
        case "et"      => recordEt
        case "cy"      => recordCy
        case "ga"      => recordGa
        case "ar"      => recordAr
        case "ar-EG"   => recordArEg
        case "fa"      => recordFa
        case "he"      => recordHe
        case "hi"      => recordHi
        case "bn"      => recordBn
        case "mr"      => recordMr
        case "ta"      => recordTa
        case "th"      => recordTh
        case "vi"      => recordVi
        case "id"      => recordId
        case "ko"      => recordKo
        case "ja"      => recordJa
        case "zh"      => recordZh
        case "zh-Hant" => recordZhHant
        case _         => none
    }
}

const recordEn = """
    tag=en
    likely=en-Latn-US
    numbers=latn|latn
    symbols.latn=.|,|-|+|%|‰|E|NaN|∞|.|,
    patterns.latn=#,##0.###|#,##0%|#E0|¤#,##0.00|¤#,##0.00;(¤#,##0.00)
    minimumGrouping=1
    currencies=JPY=¥|USD=$
    currencies.narrow=
    era=BC|AD
    months=January|February|March|April|May|June|July|August|September|October|November|December
    months.short=Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec
    months.alone=January|February|March|April|May|June|July|August|September|October|November|December
    months.alone.short=Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec
    months.narrow=J|F|M|A|M|J|J|A|S|O|N|D
    days=Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday
    days.short=Mon|Tue|Wed|Thu|Fri|Sat|Sun
    days.alone=Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday
