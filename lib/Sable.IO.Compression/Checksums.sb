module Sable.IO.Compression

/// CRC-32 (IEEE 802.3's, reflected) of bytes as they come: eight bytes a step.
struct Crc32 {
    var state: U32 = 0xFFFF_FFFF

    /// What is in gzip's trailers, and zip's entries.
    var value: U32 => ~state

    /// The state after the bytes at an address, and above it how many of them
    /// it is after: as many as the processor has instructions for.
    @builtin("crc32_raw")
    unsafe static fn kernel(_ state: Int, _ address: Int, _ count: Int) -> Int

    unsafe mutating fn update(at address: Int, count: Int) {
        let table = crcTable
        var crc = state
        var at = address
        let end = address &+ count
        while end &- at >= 64 {
            let done = Crc32.kernel(crc unchecked as Int, at, end &- at)
            crc = done unchecked as U32
            if done >> 32 == 0 {
                break
            }
            at = at &+ (done >> 32)
        }
        while at &+ 8 <= end {
            crc = crcStep(table, crc, load64(at))
            at = at &+ 8
        }
        while at < end {
            crc = load32(table &+ 4 &* (((crc ^ (load8(at) unchecked as U32)) & 0xFF) unchecked as Int)) ^ (crc >> 8)
            at = at &+ 1
        }
        state = crc
    }
}

@inline(always)
unsafe fn crcStep(_ table: Int, _ crc: U32, _ word: U64) -> U32 {
    let x = word ^ (crc unchecked as U64)
    let a = load32(table &+ 4 &* (1792 &+ ((x & 0xFF) unchecked as Int))) ^ load32(table &+ 4 &* (1536 &+ ((x >> 8 & 0xFF) unchecked as Int)))
    let b = load32(table &+ 4 &* (1280 &+ ((x >> 16 & 0xFF) unchecked as Int))) ^ load32(table &+ 4 &* (1024 &+ ((x >> 24 & 0xFF) unchecked as Int)))
    let c = load32(table &+ 4 &* (768 &+ ((x >> 32 & 0xFF) unchecked as Int))) ^ load32(table &+ 4 &* (512 &+ ((x >> 40 & 0xFF) unchecked as Int)))
    let d = load32(table &+ 4 &* (256 &+ ((x >> 48 & 0xFF) unchecked as Int))) ^ load32(table &+ 4 &* ((x >> 56) unchecked as Int))
    return a ^ b ^ c ^ d
}

/// What each byte does to the checksum with none to seven after it.
let crcTable: Int = {
        () -> Int in
        var table = U32[>..](repeating: 0, count: 2048)
        var i = 0
        while i < 256 {
            var crc = U32(i)
            var bit = 0
            while bit < 8 {
                crc = (crc & 1) != 0 ? (crc >> 1) ^ 0xEDB8_8320 : crc >> 1
                bit += 1
            }
            table[i] = crc
            i += 1
        }
        while i < 2048 {
            let before = table[i - 256]
            table[i] = table[Int(before & 0xFF)] ^ (before >> 8)
            i += 1
        }
        return constantTable(table)
    }()

/// Adler-32 of bytes as they come: zlib's.
struct Adler32 {
    var low: U32 = 1
    var high: U32 = 0

    var value: U32 => high << 16 | low

    unsafe mutating fn update(at address: Int, count: Int) {
        var a = low
        var b = high
        var at = address
        var left = count
        while left > 0 {
            // As many as cannot overflow.
            var run = left < 5552 ? left : 5552
            left = left &- run
            while run >= 16 {
                var sum: U32 = 0
                var weighted: U32 = 0
                var i = 0
                while i < 16 {
                    let byte = load8(at &+ i) unchecked as U32
                    sum = sum &+ byte
                    weighted = weighted &+ byte &* ((16 &- i) unchecked as U32)
                    i = i &+ 1
                }
                b = b &+ (a << 4) &+ weighted
                a = a &+ sum
                at = at &+ 16
                run = run &- 16
            }
            while run > 0 {
                a = a &+ (load8(at) unchecked as U32)
                b = b &+ a
                at = at &+ 1
                run = run &- 1
            }
            a = a % 65521
            b = b % 65521
        }
        low = a
        high = b
    }

    mutating fn update(_ bytes: U8[:]) {
        // Through memory, a run at a time.
        let memory = Block(count: 4096)
        var i = 0
        while i < bytes.count {
            let end = i + 4096 < bytes.count ? i + 4096 : bytes.count
            unsafe {
                NativeMemory.copy(from: bytes[i..<end], to: RawPtr<U8>(address: memory.address))
                self.update(at: memory.address, count: end - i)
            }
            i = end
        }
    }
}
