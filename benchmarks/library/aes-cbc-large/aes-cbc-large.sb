module AesCbcLargeBench

// AES-256-CBC of 64 KiB, 200 times: enciphered, with its padding, and
// deciphered again, each into a new array. Prints the sum of the ciphertexts'
// first bytes.

import Sable.Crypto

@main
fn main() {
    let cipher = try! Hazmat.AesCbc(key: SymmetricKey(U8[>..](repeating: 7, count: 32)))
    var text = U8[>..](repeating: 1, count: 65536)
    var iv = U8[>..](repeating: 0, count: 16)
    var total = 0
    for i in 0..<200 {
        iv.writeU64(U64(i), at: 0, endian: .Little)
        let ciphertext = try! cipher.encrypt(text, iv: iv)
        total += Int(ciphertext[0])
        text = try! cipher.decrypt(ciphertext, iv: iv)
    }
    print(total + Int(text[65535]))
}
