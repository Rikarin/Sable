module ProcessSpawnBench

import Sable.Process
import Sable.Testing

// Command: a hundred runs of /bin/echo, what each printed read.
// The time is the children's too.

fn run() async throws -> String {
    var total = 0
    for i in 0..<100 {
        let done = try await Command("/bin/echo").argument("\(i)").output()
        if done.succeeded {
            total += try Int.parse(done.output.trimmed())
        }
    }
    return "\(total)"
}

@bench
fn measure(_ b: Bencher) async {
    b.check(await b.iterateAsync { try! await run() })
}
