module AtomicBench

import Sable.Testing

// Atomic<Int>: four tasks on the pool, each adding one to a shared count
// half a million times, then as often by compare-and-exchange.

fn run() async -> String {
    let count = Atomic<Int>(0)
    await withTaskGroup(of: Int.self) { group in
        for _ in 0..<4 {
            group.spawn {
                for _ in 0..<500000 {
                    count.add(1)
                }
                for _ in 0..<500000 {
                    var seen = count.load()
                    while true {
                        let (done, was) = count.compareExchange(expected: seen, desired: seen + 1)
                        if done { break }
                        seen = was
                    }
                }
                return 0
            }
        }
        await group.waitForAll()
    }
    return "\(count.load())"
}

@bench
fn measure(_ b: Bencher) async {
    b.check(await b.iterateAsync { await run() })
}
