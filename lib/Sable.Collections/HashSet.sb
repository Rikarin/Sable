module Sable.Collections

/// Distinct values, by hash: a `[Element: Bool]` underneath, so iteration
/// is in insertion order and every operation is a dictionary's.
public class HashSet<Element: Hashable> {
    var map: [Element: Bool] = [:]

    /// An empty set.
    public init() { }

    /// How many values it holds.
    public var count: Int => map.count

    /// Whether it holds no values.
    public var isEmpty: Bool => map.count == 0

    /// Adds the value; true if it was not there before.
    @discardable
    public fn insert(_ value: Element) -> Bool {
        return map.insert(true, forKey: value)
    }

    /// Whether the value is in the set.
    public fn contains(_ value: Element) -> Bool {
        return map.contains(value)
    }

    /// Takes the value out; true if it was there.
    @discardable
    public fn remove(_ value: Element) -> Bool {
        if let _ = map.remove(value) {
            return true
        }
        return false
    }

    /// The values, in the order they were first added.
    public fn elements() -> Element[>..] {
        return map.keys()
    }
}
