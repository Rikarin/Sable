module Sable.Math.Geometry

/// A value that is so many `F32`s one after another and nothing else, so that
/// an array of them is an array of `F32`s: the vectors, the matrices, the
/// quaternion and the plane of this module, in C's layout, aligned to 4. It is
/// PlainData, which a type of the program's own is held to where it says it
/// conforms; that its size is its components' is checked where a view is made.
///
/// ```sable
/// assert(Matrix4x4.componentCount == 16)
/// assert(Vector3(1, 2, 3).toArray() == [1, 2, 3])
/// ```
public protocol FloatComponents: PlainData {
    /// How many `F32`s a value is.
    static var componentCount: Int { get }

    /// The components, in an array of their own: a copy, where an array of
    /// values has a view (`components`).
    fn toArray() -> F32[>..]
}

extension Vector2: FloatComponents {
    /// The components, in an array of their own.
    public fn toArray() -> F32[>..] => [x, y]
}

extension Vector3: FloatComponents {
    /// The components, in an array of their own.
    public fn toArray() -> F32[>..] => [x, y, z]
}

extension Vector4: FloatComponents {
    /// The components, in an array of their own.
    public fn toArray() -> F32[>..] => [x, y, z, w]
}

extension Quaternion: FloatComponents {
    /// The components, in an array of their own.
    public fn toArray() -> F32[>..] => [x, y, z, w]
}

extension Plane: FloatComponents {
    /// The components, in an array of their own.
    public fn toArray() -> F32[>..] => [normal.x, normal.y, normal.z, d]
}

extension Matrix3x2: FloatComponents {
    /// The components, in an array of their own.
    public fn toArray() -> F32[>..] => [m11, m12, m21, m22, m31, m32]
}

extension Matrix3x3: FloatComponents {
    /// The components, in an array of their own.
    public fn toArray() -> F32[>..] => [m11, m12, m13, m21, m22, m23, m31, m32, m33]
}

extension Matrix4x4: FloatComponents {
    /// The components, in an array of their own.
    public fn toArray() -> F32[>..] => [m11, m12, m13, m14, m21, m22, m23, m24, m31, m32, m33, m34, m41, m42, m43, m44]
}

/// Traps unless the type is as large as its components.
fn checkLayout<T: FloatComponents>(_ type: T.Type) {
    if MemoryLayout<T>.stride != T.componentCount * 4 {
        preconditionFailure("a FloatComponents type of \(T.componentCount) components that takes \(MemoryLayout<T>.stride) bytes")
    }
}

extension<Element: FloatComponents> Element[:] {
    /// The elements' components where they lie, as one run of `F32`s: a view
    /// of the same buffer, nothing copied, which may be kept as any slice
    /// may. Its bytes are `bytes`, Sable.Core's, as any plain array's are:
    /// what a buffer of the GPU's is filled from.
    ///
    /// ```sable
    /// let points = [Vector2(1, 2), Vector2(3, 4)]
    /// assert(points.components == [1, 2, 3, 4])
    /// assert([Vector3.zero, Vector3.one].bytes.count == 24)
    /// ```
    public var components: F32[:] {
        get {
            checkLayout(Element.self)
            return reinterpreted(as: F32.self)
        }
    }

    /// The elements' components where they lie, to be read and written there
    /// for as long as 'body' runs: the view lent to change, as an `inout`
    /// slice, with nothing copied. A write through it changes the elements.
    ///
    /// ```sable
    /// var points = [Vector2(1, 2), Vector2(3, 4)]
    /// points.withMutableComponents { all in
    ///     all[2] = 30
    /// }
    /// assert(points[1] == Vector2(30, 4))
    /// ```
    public mutating fn withMutableComponents<R, E: Error>(_ body: (inout F32[:]) throws(E) -> R) throws(E) -> R {
        checkLayout(Element.self)
        return try body(&self.reinterpreted(as: F32.self))
    }
}
