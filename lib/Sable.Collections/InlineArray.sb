module Sable.Collections

/// Exactly `N` elements, stored inline in the value that holds them, with
/// no heap allocation: Swift's InlineArray, .NET's [InlineArray(N)], Rust's
/// `[T; N]`. It is the built-in fixed-size array, `Element[N]`, by the name
/// other languages give it, with every member an array has.
///
/// For up to `N` elements that can grow and shrink within that room, inline
/// too, use `Element[..N]`; for an array that may outgrow it, `SmallVec`.
///
/// ```sable
/// var corners: InlineArray<Int, 4> = [0, 1, 2, 3]
/// corners[2] = 7
/// assert(corners.count == 4)
/// assert(corners.toArray() == [0, 1, 7, 3])
/// ```
public alias InlineArray<Element, N: Int> = Element[N]
