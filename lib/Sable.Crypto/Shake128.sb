module Sable.Crypto

/// SHAKE128, FIPS 202: as many bytes of output as are asked for, 128 bits
/// strong once there are 32 of them. A longer output begins with a shorter one.
///
/// ```sable
/// let output = Shake128.hash(utf8: "abc", count: 8)
/// assert("\(Digest(output))" == "5881092dd818bf5c")
/// var shake = Shake128()
/// shake.update(utf8: "abc")
/// var reader = shake.reader()
/// assert(reader.read(count: 3) == output[..<3] && reader.read(count: 5) == output[3...])
/// ```
public struct Shake128: ExtendableOutputFunction {
    var sponge: Sponge

    public init() {
        sponge = Sponge(rate: 168, suffix: 0x1F)
    }

    public mutating fn update(_ bytes: U8[:]) {
        sponge.update(bytes)
    }

    public fn reader() -> OutputReader {
        return OutputReader(sponge: sponge.finish(), rate: 168)
    }
}
