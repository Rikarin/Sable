module BinarySearchBench

import Sable.Testing

// Binary search: two million searches in a sorted array of a million.

fn run(_ values: Int[>..]) -> String {
    var x = 12345
    var found = 0
    var total = 0
    for _ in 0..<2000000 {
        x = (x * 1103515245 + 12345) % 2147483648
        match values.binarySearch(for: x % 3000000) {
            case .Ok(let index) => {
                found += 1
                total += index
            }
            default => { }
        }
    }
    return "\(found) \(total)"
}

@bench
fn measure(_ b: Bencher) {
    var values: Int[>..] = []
    for i in 0..<1000000 {
        values.append(i * 3)
    }
    b.check(b.iterate { run(values) })
}
