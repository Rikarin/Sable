module Sable.Core

// Finding elements in an array: by a test, by value, by order. Every kind
// of array has these, as a slice (Array.sb). Each looks at each element at
// most once, but for 'partitionPoint', which halves the elements it looks
// at each step.

extension<Element> Element[:] {
    /// Whether each element goes ahead of, or alongside, the one after it,
    /// by 'before': whether no element is 'before' the one ahead of it.
    public fn isSorted(by before: (Element, Element) -> Bool) -> Bool {
        var i = 1
        while i < self.count {
            if before(self[i], self[i - 1]) {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// Where the elements that fail the test begin, in an array whose
    /// elements that pass it all come first — a sorted array, with a test
    /// of "goes before the value": the first place the value could go to
    /// keep it sorted. Found by halving, in O(log n) tests; for an array
    /// not split by the test, some place where one that passes is followed
    /// by one that fails.
    ///
    /// ```sable
    /// let xs: Int[>..] = [1, 3, 3, 7]
    /// assert(xs.partitionPoint(where: (x: Int) => x < 3) == 1)
    /// assert(xs.partitionPoint(where: (x: Int) => x <= 3) == 3)
    /// ```
    public fn partitionPoint(where predicate: (Element) -> Bool) -> Int {
        // Each step halves what is left, keeping its upper half or its
        // lower with no branch on which: the same steps whatever the
        // elements, so that there is none for the machine to guess wrong.
        var low = 0
        var size = self.count
        while size > 0 {
            let half = size >> 1
            low = predicate(self[low + half]).selecting(low + size - half, low)
            size = half
        }
        return low
    }

    /// Where an element is in a sorted array, found by halving, in
    /// O(log n) comparisons: '.Ok' with the place of one that 'compare'
    /// says is the one wanted (.Equal), or '.Err' with the place it could
    /// go to keep the array sorted. 'compare' says how an element stands to
    /// what is wanted: before it (.Less), it, or after it (.Greater).
    /// Rust's `binary_search_by`; .NET's `BinarySearch`, which gives the
    /// complement of the place instead.
    ///
    /// ```sable
    /// let xs: Int[>..] = [1, 3, 5, 7]
    /// assert(xs.binarySearch(by: (x: Int) => x.compare(5)) == .Ok(2))
    /// assert(xs.binarySearch(by: (x: Int) => x.compare(4)) == .Err(2))
    /// ```
    public fn binarySearch(by compare: (Element) -> Ordering) -> Outcome<Int, Int> {
        // As 'partitionPoint' halves, with no branch on the comparison's
        // answer: stopping early where it is equal would be one.
        var low = 0
        var size = self.count
        if size == 0 {
            return .Err(0)
        }
        while size > 1 {
            let half = size >> 1
            let middle = low + half
            low = (compare(self[middle]) == .Greater).selecting(low, middle)
            size = size - half
        }
        let order = compare(self[low])
        if order == .Equal {
            return .Ok(low)
        }
        return .Err(order == .Less ? low + 1 : low)
    }

    /// Where the value is in an array sorted in the comparator's order: as
    /// 'binarySearch(for:)' does in the elements' own.
    ///
    /// ```sable
    /// let xs: Int[>..] = [7, 5, 3, 1]
    /// assert(xs.binarySearch(for: 3, using: Comparator<Int>.natural().reversed()) == .Ok(2))
    /// ```
    public fn binarySearch(for value: Element, using comparator: Comparator<Element>) -> Outcome<Int, Int> {
        return self.binarySearch(by: (element: Element) => comparator.compare(element, value))
    }

    /// Where an element with this key is, in an array sorted by the key
    /// each element gives: as 'binarySearch(for:)' does by the element.
    public fn binarySearch<K: Comparable>(forKey key: K, by keyOf: (Element) -> K) -> Outcome<Int, Int> {
        return self.binarySearch(by: (element: Element) => keyOf(element).compare(key))
    }
}

extension<Element: Equatable> Element[:] {
    /// Where the first element equal to any of the candidates is, or none
    /// (.NET's IndexOfAny).
    public fn firstIndex(ofAny candidates: Element[:]) -> Int? {
        var i = 0
        while i < self.count {
            if candidates.contains(element: self[i]) {
                return i
            }
            i = i + 1
        }
        return none
    }

    /// Whether the array begins with the elements of 'start', in order.
    /// Every array begins with the empty one.
    public fn starts(with start: Element[:]) -> Bool {
        return start.count <= self.count && self.commonPrefixLength(with: start) == start.count
    }

    /// Whether the array ends with the elements of 'suffix', in order.
    public fn ends(with suffix: Element[:]) -> Bool {
        if suffix.count > self.count {
            return false
        }
        return self.slice(from: self.count - suffix.count, to: self.count).commonPrefixLength(with: suffix) == suffix.count
    }

    /// How many elements are equal to this one. Its 'count' is how many
    /// there are in all.
    ///
    /// ```sable
    /// let xs: Int[>..] = [3, 8, 3]
    /// assert(xs.count(of: 3) == 2)
    /// assert(xs.count == 3)
    /// ```
    public fn count(of element: Element) -> Int {
        var n = 0
        for candidate in self {
            if candidate == element {
                n = n + 1
            }
        }
        return n
    }

    /// How many elements, from the start, the two arrays have equal.
    public fn commonPrefixLength(with other: Element[:]) -> Int {
        let shorter = self.count < other.count ? self.count : other.count
        if shorter >= comparedByBits {
            let at = self.mismatch(other)
            if at >= 0 {
                return at
            }
        }
        var i = 0
        while i < shorter && self[i] == other[i] {
            i = i + 1
        }
        return i
    }
}

extension<Element: Comparable> Element[:] {
    /// Whether the elements are in ascending order: none less than the one
    /// ahead of it.
    public fn isSorted() -> Bool {
        return self.isSorted(by: (a: Element, b: Element) => a < b)
    }

    /// Where the value is in this sorted array, found by halving: '.Ok'
    /// with the place of an element equal to it (any one, if several are),
    /// or '.Err' with the place it could be inserted to keep the array
    /// sorted.
    ///
    /// ```sable
    /// let xs: Int[>..] = [1, 3, 5, 7]
    /// assert(xs.binarySearch(for: 7) == .Ok(3))
    /// assert(xs.binarySearch(for: 4) == .Err(2))
    /// assert(xs.binarySearch(for: 9) == .Err(4))
    /// ```
    public fn binarySearch(for value: Element) -> Outcome<Int, Int> {
        return self.binarySearch(by: (element: Element) => element.compare(value))
    }
}
