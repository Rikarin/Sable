module Sable.Diagnostics

/// What a span is to the trace: work within the process, or one side of a
/// call or a message between two. OpenTelemetry's SpanKind, .NET's
/// `ActivityKind`.
@derive(Equatable, Debug)
public enum SpanKind {
    /// Work within the process: the default.
    Internal
    /// A request this process serves.
    Server
    /// A request this process makes of another.
    Client
    /// A message sent, to be handled later.
    Producer
    /// A message received and handled.
    Consumer

    /// Its name, as OpenTelemetry writes it: "internal", "server".
    public var name: String {
        get {
            return match self {
                case .Internal => "internal"
                case .Server   => "server"
                case .Client   => "client"
                case .Producer => "producer"
                case .Consumer => "consumer"
            }
        }
    }
}
