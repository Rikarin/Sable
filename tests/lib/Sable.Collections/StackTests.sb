module StackTests

// Stack (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn aStackIsGoneThroughFromTheTopDown() {
    let stack = Stack<Int>()
    stack.push(1)
    stack.push(2)
    stack.push(3)
    var seen: String[>..] = []
    for value in stack {
        seen.append("\(value)")
    }
    assertEqualText(seen.joined(separator: ","), "3,2,1")
    assertEqual(stack.count, 3)
    assertEqual(Stack<Int>().toArray().count, 0)
}

@test
fn stackIsLastInFirstOut() {
    let stack = Stack<Int>()
    stack.push(1)
    stack.push(2)
    stack.push(3)
    assertEqual(stack.pop() ?? -1, 3)
    assertEqual(stack.peek() ?? -1, 2)
    assertEqual(stack.pop() ?? -1, 2)
    assertEqual(stack.pop() ?? -1, 1)
    assert(stack.pop() == none, "an empty stack pops none")
}

@test
fn anEmptyStackHasNothingToPeekAt() {
    let stack = Stack<String>()
    assert(stack.isEmpty)
    assertEqual(stack.count, 0)
    assert(stack.peek() == none)
}

@test
fn countFollowsPushesAndPops() {
    let stack = Stack<String>()
    stack.push("a")
    stack.push("b")
    assertEqual(stack.count, 2)
    assert(!stack.isEmpty)
    let _ = stack.pop()
    assertEqual(stack.count, 1)
    assertEqual(stack.peek() ?? "", "a")
}
