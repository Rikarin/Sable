module Utf16Bench

import Sable.Testing
import Sable.Text

// Text to UTF-16 and back: a megabyte of mixed text, fifty times.

fn run(_ bytes: U8[>..]) -> String {
    var total = 0
    for _ in 0..<50 {
        var units: U16[>..] = []
        _ = Utf8.toUtf16(bytes, into: &units)
        var back: U8[>..] = []
        _ = Utf8.fromUtf16(units, into: &back)
        total += units.count + back.count
    }
    return "\(total)"
}

@bench
fn measure(_ b: Bencher) {
    let bytes = "Grüße, мир, 世界 😀 and plain words too. ".repeated(20000).utf8Bytes()
    b.check(b.iterate { run(bytes) })
}
