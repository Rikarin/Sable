module Sable.Core

// Reading the tables of UnicodeTables.sb, which tools/unicode-tables.py
// generates and describes: fixed-width records of base-32 digits, '0' for 0
// to 'O' for 31, a dozen to a line. Each lookup is a binary search on the
// code point a record starts with — a dozen steps for the largest table —
// and Char's members answer ASCII without one. The case mappings, which
// whole texts are put through, are in two stages, of base 64: a lookup is
// three reads.

/// The number the digits from byte 'at' of the table write.
fn unicodeNumber(_ table: String, _ at: Int, _ width: Int) -> Int {
    var value = 0
    var i = 0
    while i < width {
        value = value * 32 + Int(table.utf8Byte(at + i)) - 48
        i = i + 1
    }
    return value
}

/// Where record r of a table of records 'width' digits wide starts.
fn unicodeRecord(_ record: Int, _ width: Int) -> Int {
    return record * width + record / unicodeRecordsPerLine
}

/// The last of the table's records whose code point (its first five digits)
/// is at or below the code, or -1 when even the first is above it.
fn unicodeSearch(_ table: String, count: Int, width: Int, _ code: Int) -> Int {
    var low = 0
    var high = count
    while low < high {
        let middle = (low + high) / 2
        if unicodeNumber(table, unicodeRecord(middle, width), 5) <= code {
            low = middle + 1
        } else {
            high = middle
        }
    }
    return low - 1
}

/// Whether a property, as a table of where it turns on and off, holds for
/// the code: an odd number of those at or below it, so the last is an on.
fn unicodeHas(_ table: String, count: Int, _ code: Int) -> Bool {
    return unicodeSearch(table, count: count, width: 5, code) % 2 == 0
}

/// Where the records of a block of sixty-four codes start, in a staged table
/// of 'limit' blocks: the first block's, which are zero, past them.
@inline(always)
fn unicodeStagedLine(_ index: String, limit: Int, _ block: Int) -> Int {
    if block >= limit {
        return 0
    }
    let at = block * 2 + (block >> 6)
    return (Int(index.utf8Byte(at)) + Int(index.utf8Byte(at + 1)) * 64 - 48 * 65) * 193
}

/// The code's record of three digits among those of its block.
@inline(always)
fn unicodeStagedRecord(_ blocks: String, _ line: Int, _ code: Int) -> Int {
    let digits = blocks.utf8Word(line + (code & 63) * 3) &- 0x303030
    return Int(digits & 0x3F | digits >> 2 & 0xFC0 | digits >> 4 & 0x3F000)
}

/// The value a staged table of 'limit' blocks of sixty-four records, three
/// digits each, has for the code.
@inline(always)
fn unicodeStaged(_ index: String, _ blocks: String, limit: Int, _ code: Int) -> Int {
    return unicodeStagedRecord(blocks, unicodeStagedLine(index, limit: limit, code >> 6), code)
}

/// In a case table's value, a scalar with a special mapping too.
const caseSpecial = 0x10000

/// The code moved by a case table's value for it: its simple mapping.
@inline(always)
fn caseMoved(_ code: Int, _ value: Int) -> Int {
    return code & ~0xFFFF | (code + value) & 0xFFFF
}

/// The simple upper-case mapping of the code.
fn upperCased(_ code: Int) -> Int {
    return caseMoved(code, unicodeStaged(upperCaseIndex, upperCaseBlocks, limit: upperCaseLimit, code))
}

/// The simple lower-case mapping of the code.
fn lowerCased(_ code: Int) -> Int {
    return caseMoved(code, unicodeStaged(lowerCaseIndex, lowerCaseBlocks, limit: lowerCaseLimit, code))
}

/// The simple case folding of the code.
fn foldedCase(_ code: Int) -> Int {
    return caseMoved(code, unicodeStaged(foldingCaseIndex, foldingCaseBlocks, limit: foldingCaseLimit, code))
}

/// The scalars a mapping to more than one, as records of (code, three
/// scalars, 0 for none), maps the code to; none when it has no such mapping.
fn unicodeSpecial(_ table: String, count: Int, _ code: Int) -> String? {
    let record = unicodeSearch(table, count: count, width: 20, code)
    if record < 0 {
        return none
    }
    let at = unicodeRecord(record, 20)
    if unicodeNumber(table, at, 5) != code {
        return none
    }
    var scalars: String[>..] = []
    var k = 1
    while k <= 3 {
        let scalar = unicodeNumber(table, at + k * 5, 5)
        if scalar != 0 {
            scalars.append(String.fromChar(Char.fromCodePoint(scalar)!))
        }
        k = k + 1
    }
    return Runtime.joinStrings(scalars, "")
}
