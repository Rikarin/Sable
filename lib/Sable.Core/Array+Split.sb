module Sable.Core

// An array cut into runs: by a separator, into chunks, into overlapping
// windows. Each run is a slice of the array (docs/02 §2.5) — a view of its
// buffer, with no element copied — and the runs come in an array of them.

extension<Element> Element[:] {
    /// The runs between the elements that pass the test, which are left
    /// out: one more run than there are separators, so a separator at
    /// either end, or two together, make an empty run (Rust's split).
    ///
    /// ```sable
    /// let xs: Int[>..] = [1, 0, 2, 3, 0, 4]
    /// let runs = xs.split(where: (x: Int) => x == 0)
    /// assert(runs.count == 3)
    /// assert(runs[1] == [2, 3])
    /// ```
    public fn split(where isSeparator: (Element) -> Bool) -> Element[:][>..] {
        var runs: Element[:][>..] = []
        var start = 0
        var i = 0
        while i < self.count {
            if isSeparator(self[i]) {
                runs.append(self[start..<i])
                start = i + 1
            }
            i = i + 1
        }
        runs.append(self[start..<self.count])
        return runs
    }

    /// The elements in runs of 'size', in order, the last shorter when the
    /// count is not a multiple of it; none for an empty array. A size of
    /// less than one traps.
    ///
    /// ```sable
    /// let xs: Int[>..] = [1, 2, 3, 4, 5]
    /// let chunks = xs.chunks(of: 2)
    /// assert(chunks.count == 3)
    /// assert(chunks[2] == [5])
    /// ```
    public fn chunks(of size: Int) -> Element[:][>..] {
        precondition(size >= 1, "a chunk's size must be at least 1, not \(size)")
        var runs: Element[:][>..] = []
        var start = 0
        while start < self.count {
            let end = self.count - start > size ? start + size : self.count
            runs.append(self[start..<end])
            start = end
        }
        return runs
    }

    /// Every run of 'size' elements in a row, from each place one starts:
    /// 'count - size + 1' of them, overlapping, and none when the array is
    /// shorter than 'size'. A size of less than one traps.
    ///
    /// ```sable
    /// let xs: Int[>..] = [1, 2, 3, 4]
    /// let windows = xs.windows(of: 3)
    /// assert(windows.count == 2)
    /// assert(windows[1] == [2, 3, 4])
    /// ```
    public fn windows(of size: Int) -> Element[:][>..] {
        precondition(size >= 1, "a window's size must be at least 1, not \(size)")
        var runs: Element[:][>..] = []
        var start = 0
        while start + size <= self.count {
            runs.append(self[start..<start + size])
            start = start + 1
        }
        return runs
    }
}
