module Sable.Time

public struct Clock {
    /// Waits at least this long, off the run queue: every other task runs
    /// meanwhile, and the program waits only when none can — two tasks that
    /// each sleep a second take a second between them. 'Runtime.sleep'
    /// waits without letting any task run. A task cancelled before or
    /// while it sleeps wakes at once, and the sleep throws CancellationError.
    public static async fn sleep(_ duration: Duration) throws(CancellationError) {
        try await Task.sleep(nanoseconds: duration.totalNanoseconds)
    }

    /// How long the body took to run.
    public static fn measure(_ body: () -> Void) -> Duration {
        let start = Instant.now()
        body()
        return start.elapsed
    }
}
