module Sable.IO

/// Paths as text, with '/' between their parts — on Windows, '\' too.
public struct Path {
    /// The two paths, one inside the other; an absolute second one stands alone.
    public static fn join(_ first: String, _ second: String) -> String {
        if first.count == 0 || isAbsolute(second) {
            return second
        }
        if isSeparator(first.at(first.count - 1)) {
            return first + second
        }
        return first + "/" + second
    }

    /// The last part: what follows the last '/'.
    public static fn fileName(_ path: String) -> String {
        let slash = lastSeparator(path)
        if slash < 0 {
            return path
        }
        return path.slice(slash + 1, path.count)
    }

    /// Everything before the last part; "." for a bare name, "/" at the root.
    public static fn directory(_ path: String) -> String {
        let slash = lastSeparator(path)
        if slash < 0 {
            return "."
        }
        if slash == 0 {
            return "/"
        }
        return path.slice(0, slash)
    }

    /// What follows the last part's last '.', when it has one not at its start.
    public static fn extension(_ path: String) -> String? {
        let name = Path.fileName(path)
        let dot = lastIndex(name, '.')
        if dot <= 0 {
            return none
        }
        return name.slice(dot + 1, name.count)
    }

    /// The path without its extension.
    public static fn withoutExtension(_ path: String) -> String {
        let name = Path.fileName(path)
        let dot = lastIndex(name, '.')
        if dot <= 0 {
            return path
        }
        return path.slice(0, path.count - (name.count - dot))
    }
}

/// What separates a path's parts: '/', and on Windows '\' as well.
fn isSeparator(_ c: Char) -> Bool {
    #if os(windows)
    return c == '/' || c == '\\'
    #else
    return c == '/'
    #endif
}

/// A path from the root: '/…', and on Windows 'C:…' or '\…' as well.
fn isAbsolute(_ path: String) -> Bool {
    if path.count == 0 {
        return false
    }
    #if os(windows)
    return isSeparator(path.at(0)) || path.count > 1 && path.at(1) == ':'
    #else
    return path.at(0) == '/'
    #endif
}

fn lastSeparator(_ text: String) -> Int {
    var i = text.count - 1
    while i >= 0 {
        if isSeparator(text.at(i)) {
            return i
        }
        i -= 1
    }
    return -1
}

fn lastIndex(_ text: String, _ wanted: Char) -> Int {
    var i = text.count - 1
    while i >= 0 {
        if text.at(i) == wanted {
            return i
        }
        i -= 1
    }
    return -1
}
