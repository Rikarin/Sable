module Sable.Crypto

/// The block of 'rate' bytes after a sponge's state absorbed into it, portably.
unsafe fn absorbKeccak(_ state: Int, rate: Int) {
    var i = 0
    while i < rate {
        store64(load64(state + i) ^ load64(state + 200 + i), state + i)
        i += 8
    }
    permuteKeccak(state)
}

/// Keccak-f[1600] on the 25 words at an address, portably (FIPS 202 §3.3).
unsafe fn permuteKeccak(_ state: Int) {
    var a0 = load64(state)
    var a1 = load64(state + 8)
    var a2 = load64(state + 16)
    var a3 = load64(state + 24)
    var a4 = load64(state + 32)
    var a5 = load64(state + 40)
    var a6 = load64(state + 48)
    var a7 = load64(state + 56)
    var a8 = load64(state + 64)
    var a9 = load64(state + 72)
    var a10 = load64(state + 80)
    var a11 = load64(state + 88)
    var a12 = load64(state + 96)
    var a13 = load64(state + 104)
    var a14 = load64(state + 112)
    var a15 = load64(state + 120)
    var a16 = load64(state + 128)
    var a17 = load64(state + 136)
    var a18 = load64(state + 144)
    var a19 = load64(state + 152)
    var a20 = load64(state + 160)
    var a21 = load64(state + 168)
    var a22 = load64(state + 176)
    var a23 = load64(state + 184)
    var a24 = load64(state + 192)
    var round = 0
    while round < 24 {
        // Theta: each column's parity into its neighbours'.
        let c0 = a0 ^ a5 ^ a10 ^ a15 ^ a20
        let c1 = a1 ^ a6 ^ a11 ^ a16 ^ a21
        let c2 = a2 ^ a7 ^ a12 ^ a17 ^ a22
        let c3 = a3 ^ a8 ^ a13 ^ a18 ^ a23
        let c4 = a4 ^ a9 ^ a14 ^ a19 ^ a24
        let d0 = c4 ^ c1.rotatedLeft(by: 1)
        let d1 = c0 ^ c2.rotatedLeft(by: 1)
        let d2 = c1 ^ c3.rotatedLeft(by: 1)
        let d3 = c2 ^ c4.rotatedLeft(by: 1)
        let d4 = c3 ^ c0.rotatedLeft(by: 1)
        // Rho and pi: each lane rotated, and moved.
        let b0 = (a0 ^ d0)
        let b1 = (a6 ^ d1).rotatedLeft(by: 44)
        let b2 = (a12 ^ d2).rotatedLeft(by: 43)
        let b3 = (a18 ^ d3).rotatedLeft(by: 21)
        let b4 = (a24 ^ d4).rotatedLeft(by: 14)
        let b5 = (a3 ^ d3).rotatedLeft(by: 28)
        let b6 = (a9 ^ d4).rotatedLeft(by: 20)
        let b7 = (a10 ^ d0).rotatedLeft(by: 3)
        let b8 = (a16 ^ d1).rotatedLeft(by: 45)
        let b9 = (a22 ^ d2).rotatedLeft(by: 61)
        let b10 = (a1 ^ d1).rotatedLeft(by: 1)
        let b11 = (a7 ^ d2).rotatedLeft(by: 6)
        let b12 = (a13 ^ d3).rotatedLeft(by: 25)
        let b13 = (a19 ^ d4).rotatedLeft(by: 8)
        let b14 = (a20 ^ d0).rotatedLeft(by: 18)
        let b15 = (a4 ^ d4).rotatedLeft(by: 27)
        let b16 = (a5 ^ d0).rotatedLeft(by: 36)
        let b17 = (a11 ^ d1).rotatedLeft(by: 10)
        let b18 = (a17 ^ d2).rotatedLeft(by: 15)
        let b19 = (a23 ^ d3).rotatedLeft(by: 56)
        let b20 = (a2 ^ d2).rotatedLeft(by: 62)
        let b21 = (a8 ^ d3).rotatedLeft(by: 55)
        let b22 = (a14 ^ d4).rotatedLeft(by: 39)
        let b23 = (a15 ^ d0).rotatedLeft(by: 41)
        let b24 = (a21 ^ d1).rotatedLeft(by: 2)
        // Chi, and iota into the first lane.
        a0 = b0 ^ (~b1 & b2) ^ load64(keccakConstants + 8 * round)
        a1 = b1 ^ (~b2 & b3)
        a2 = b2 ^ (~b3 & b4)
        a3 = b3 ^ (~b4 & b0)
        a4 = b4 ^ (~b0 & b1)
        a5 = b5 ^ (~b6 & b7)
        a6 = b6 ^ (~b7 & b8)
        a7 = b7 ^ (~b8 & b9)
        a8 = b8 ^ (~b9 & b5)
        a9 = b9 ^ (~b5 & b6)
        a10 = b10 ^ (~b11 & b12)
        a11 = b11 ^ (~b12 & b13)
        a12 = b12 ^ (~b13 & b14)
        a13 = b13 ^ (~b14 & b10)
        a14 = b14 ^ (~b10 & b11)
        a15 = b15 ^ (~b16 & b17)
        a16 = b16 ^ (~b17 & b18)
        a17 = b17 ^ (~b18 & b19)
        a18 = b18 ^ (~b19 & b15)
        a19 = b19 ^ (~b15 & b16)
        a20 = b20 ^ (~b21 & b22)
        a21 = b21 ^ (~b22 & b23)
        a22 = b22 ^ (~b23 & b24)
        a23 = b23 ^ (~b24 & b20)
        a24 = b24 ^ (~b20 & b21)
        round += 1
    }
    store64(a0, state)
    store64(a1, state + 8)
    store64(a2, state + 16)
    store64(a3, state + 24)
    store64(a4, state + 32)
    store64(a5, state + 40)
    store64(a6, state + 48)
    store64(a7, state + 56)
    store64(a8, state + 64)
    store64(a9, state + 72)
    store64(a10, state + 80)
    store64(a11, state + 88)
    store64(a12, state + 96)
    store64(a13, state + 104)
    store64(a14, state + 112)
    store64(a15, state + 120)
    store64(a16, state + 128)
    store64(a17, state + 136)
    store64(a18, state + 144)
    store64(a19, state + 152)
    store64(a20, state + 160)
    store64(a21, state + 168)
    store64(a22, state + 176)
    store64(a23, state + 184)
    store64(a24, state + 192)
}

/// The round constants, from a linear feedback shift register (FIPS 202 §3.2.5).
let keccakConstants: Int = constantTable([
    0x0000000000000001, 0x0000000000008082, 0x800000000000808A, 0x8000000080008000,
    0x000000000000808B, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
    0x000000000000008A, 0x0000000000000088, 0x0000000080008009, 0x000000008000000A,
    0x000000008000808B, 0x800000000000008B, 0x8000000000008089, 0x8000000000008003,
    0x8000000000008002, 0x8000000000000080, 0x000000000000800A, 0x800000008000000A,
    0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008,
] as U64[>..])
