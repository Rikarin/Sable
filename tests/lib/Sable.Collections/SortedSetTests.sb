module SortedSetTests

// SortedSet (Sable.Collections): against a Set and a sorted array as the
// model, under arbitrary operations and set algebra, and by example.

import CollectionsSupport
import Sable.Collections
import Sable.Testing

fn elements<S: Sequence>(_ values: S) -> Int[>..] where S.Element == Int, S.Failure == Never {
    var all: Int[>..] = []
    for value in values {
        all.append(value)
    }
    return all
}

@test
fn eachOperationByExample() {
    var s = SortedSet<Int>()
    expect(s.isEmpty && s.first == none && s.last == none)
    expect(s.insert(5))
    expect(!s.insert(5))
    s.insert(1)
    s.insert(9)
    expect(s.toArray() == [1, 5, 9])
    expect(s.contains(9) && !s.contains(2))
    assertEqual(s.first ?? 0, 1)
    assertEqual(s.last ?? 0, 9)
    assertEqual(s.floor(6) ?? 0, 5)
    expect(s.floor(0) == none)
    assertEqual(s.ceiling(6) ?? 0, 9)
    expect(s.ceiling(10) == none)
    expect(s.remove(5))
    expect(!s.remove(5))
    assertEqual(s.popFirst() ?? 0, 1)
    assertEqual(s.popLast() ?? 0, 9)
    expect(s.popLast() == none && s.popFirst() == none)
    let literal = SortedSet<String>(["b", "a", "b"])
    assertEqual(literal.count, 2)
    assertEqual(literal.debugDescription(), "SortedSet([\"a\", \"b\"])")
    s.insert(3)
    s.removeAll()
    expect(s.isEmpty)
}

@test
fn positionsRangesSplitAndAppend() {
    var s = SortedSet<Int>([9, 1, 5, 3, 7])
    assertEqual(s[s.startIndex], 1)
    assertEqual(s[s.index(before: s.endIndex)], 9)
    assertEqual(s[s.index(after: s.startIndex)], 3)
    assertEqual(s[s.index(s.startIndex, offsetBy: 3)], 7)
    assertEqual(s.index(of: 5)!.rank, 2)
    expect(s.index(of: 4) == none)
    expect(elements(s.range(3..<7)) == [3, 5])
    expect(elements(s.range(3...7)) == [3, 5, 7])
    expect(elements(s.range(6...)) == [7, 9])
    expect(elements(s.range(..<5)) == [1, 3])
    expect(elements(s.range(...5)) == [1, 3, 5])
    let high = s.split(at: 5)
    expect(s.toArray() == [1, 3])
    expect(high.toArray() == [5, 7, 9])
    s.append(contentsOf: [10, 11, 12])
    expect(s.toArray() == [1, 3, 10, 11, 12])
    s.append(contentsOf: [2, 2, 0])
    expect(s.toArray() == [0, 1, 2, 3, 10, 11, 12])
}

@test
fn setAlgebra() {
    let a = SortedSet<Int>([1, 2, 3, 4])
    let b = SortedSet<Int>([3, 4, 5])
    expect(a.union(b).toArray() == [1, 2, 3, 4, 5])
    expect(a.intersection(b).toArray() == [3, 4])
    expect(a.subtracting(b).toArray() == [1, 2])
    expect(a.symmetricDifference(b).toArray() == [1, 2, 5])
    var c = a
    c.formUnion(b)
    assertEqual(c.count, 5)
    c.subtract(SortedSet<Int>([1]))
    expect(c.toArray() == [2, 3, 4, 5])
    c.formIntersection(a)
    expect(c.toArray() == [2, 3, 4])
    c.formSymmetricDifference(b)
    expect(c.toArray() == [2, 5])
    expect(SortedSet<Int>([3, 4]).isSubset(of: a))
    expect(SortedSet<Int>([3, 4]).isStrictSubset(of: a))
    expect(!a.isStrictSubset(of: a) && a.isSubset(of: a))
    expect(a.isSuperset(of: SortedSet<Int>([1])))
    expect(a.isStrictSuperset(of: SortedSet<Int>([1])))
    expect(!b.isSubset(of: a))
    expect(a.isDisjoint(with: SortedSet<Int>([7, 8])))
    expect(!a.isDisjoint(with: b))
    expect(a == SortedSet<Int>([4, 3, 2, 1]))
    expect(a != b)
}

@derive(Debug)
union SetStep {
    Insert(Int)
    Remove(Int)
    Contains(Int)
}

@test
fn randomOperationsAgreeWithAModel() {
    let values = Gen.number(in: 0...999)
    let step = Gen.weighted([
        (2, values.map { SetStep.Insert($0) }),
        (1, values.map { SetStep.Remove($0) }),
        (1, values.map { SetStep.Contains($0) }),
    ])
    forAll(many(step, upTo: 5000), cases: 15) { (steps: SetStep[>..]) in
        var s = SortedSet<Int>()
        var model = Set<Int>()
        for step in steps {
            let agrees = match step {
                case .Insert(let value)   => s.insert(value) == model.insert(value)
                case .Remove(let value)   => s.remove(value) == model.remove(value)
                case .Contains(let value) => s.contains(value) == model.contains(value)
            }
            if !agrees || s.count != model.count {
                recordFailure("\(step:?) does not agree: \(s.count) values, the model's \(model.count)")
                return
            }
        }
        expect(s.toArray() == model.toArray().sorted())
    }
}

@test
fn setAlgebraAgreesWithThatOfSets() {
    let values = many(Gen.number(in: 0...399), upTo: 300)
    forAll(values, values, cases: 40) { (left: Int[>..], right: Int[>..]) in
        let x = Set<Int>(left)
        let y = Set<Int>(right)
        let sx = SortedSet<Int>(left)
        let sy = SortedSet<Int>(right)
        expect(sx.union(sy).toArray() == x.union(y).toArray().sorted())
        expect(sx.intersection(sy).toArray() == x.intersection(y).toArray().sorted())
        expect(sx.subtracting(sy).toArray() == x.subtracting(y).toArray().sorted())
        expect(sx.symmetricDifference(sy).toArray() == x.symmetricDifference(y).toArray().sorted())
        expect(sx.isSubset(of: sy) == x.isSubset(of: y))
        expect(sx.isDisjoint(with: sy) == x.isDisjoint(with: y))
    }
}
