module Sable.Concurrency

// Waits that suspend a task rather than block its thread: what a task on
// the shared pool takes instead of Mutex and Semaphore, whose waits block
// the worker. An actor, so its state is changed by one call at a time; a
// task that must wait parks in its WaitList and looks again when woken.

/// A lock a task holds across suspensions, and waits for by suspending: for
/// work between awaits that no other task may interleave with, which an
/// actor's own reentrancy would let in. `withLock` holds it for an async
/// closure.
///
/// ```sable
/// let gate = AsyncMutex()
/// let n = await gate.withLock { 42 }
/// assert(n == 42)
/// ```
public actor AsyncMutex {
    var locked: Bool = false
    let unlocked: WaitList = WaitList()

    public init() { }

    /// Takes the lock, suspending until it is free.
    public fn lock() async {
        while locked {
            await unlocked.park()
        }
        locked = true
    }

    /// Takes the lock if it is free now: whether it did.
    public fn tryLock() -> Bool {
        if locked {
            return false
        }
        locked = true
        return true
    }

    /// Lets the lock go, waking the tasks waiting for it.
    public fn unlock() {
        locked = false
        unlocked.wakeAll()
    }

    /// Whether some task holds the lock now.
    public var isLocked: Bool => locked
}

extension AsyncMutex {
    /// What the closure gives, the lock held while it runs, however many
    /// times it suspends; let go whether it returns or throws.
    public nonisolated fn withLock<R, E: Error>(_ body: async () throws(E) -> R) async throws(E) -> R {
        await self.lock()
        do {
            let result = try await body()
            await self.unlock()
            return result
        } catch {
            await self.unlock()
            throw error
        }
    }
}
