module Base64Tests

// Base64 (Sable.Text), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Testing
import Sable.Text
import TextSupport

@test(arguments: [
    ("", ""),
    ("f", "Zg=="),
    ("fo", "Zm8="),
    ("foo", "Zm9v"),
    ("foob", "Zm9vYg=="),
    ("fooba", "Zm9vYmE="),
    ("foobar", "Zm9vYmFy"),
])
fn theRfc4648TestVectorsEncode(_ text: String, _ encoded: String) {
    assertEqual(Base64.encode(text.utf8Bytes()), encoded)
}

@test(arguments: [
    ("", ""),
    ("Zg==", "f"),
    ("Zm8=", "fo"),
    ("Zm9v", "foo"),
    ("Zm9vYg==", "foob"),
    ("Zm9vYmE=", "fooba"),
    ("Zm9vYmFy", "foobar"),
])
fn theRfc4648TestVectorsDecode(_ encoded: String, _ text: String) {
    assertBytes(try! Base64.decode(encoded), text.utf8Bytes())
}

@test
fn theRfc4648SectionNineExamples() {
    let six: U8[>..] = [0x14, 0xFB, 0x9C, 0x03, 0xD9, 0x7E]
    assertEqual(Base64.encode(six), "FPucA9l+")
    assertEqual(Base64.encode(six[..<5]), "FPucA9k=")
    assertEqual(Base64.encode(six[..<4]), "FPucAw==")
    assertEqual(Base64.encode(six, alphabet: .UrlSafe), "FPucA9l-")
    assertBytes(try! Base64.decode("FPucA9l-", alphabet: .UrlSafe), six)
}

@test
fn everyByteValueRoundTripsInBothAlphabets() {
    var bytes: U8[>..] = []
    var value = 0
    while value < 256 {
        bytes.append(U8(value))
        value += 1
    }
    let standard = Base64.encode(bytes)
    let urlSafe = Base64.encode(bytes, alphabet: .UrlSafe)
    expect(standard.contains("+") && standard.contains("/"), "the standard alphabet's last digits")
    expect(urlSafe.contains("-") && urlSafe.contains("_"), "the URL-safe alphabet's last digits")
    expect(!urlSafe.contains("+") && !urlSafe.contains("/"), "nothing that needs escaping in a URL")
    assertBytes(try! Base64.decode(standard), bytes)
    assertBytes(try! Base64.decode(urlSafe, alphabet: .UrlSafe), bytes)
}

@test(arguments: [.Standard, .UrlSafe])
fn everyLengthRoundTripsUnderEveryAlphabetAndPadding(_ alphabet: Base64.Alphabet) {
    var count = 0
    while count <= 70 {
        let bytes = sample(count)
        let padded = Base64.encode(bytes, alphabet: alphabet)
        let bare = Base64.encode(bytes, alphabet: alphabet, padding: false)
        assertEqual(padded.utf8Count, Base64.encodedLength(count))
        assertEqual(bare.utf8Count, Base64.encodedLength(count, padding: false))
        assertEqual(padded.utf8Count % 4, 0)
        assert(!bare.contains("="), "no padding when told")
        assertBytes(try! Base64.decode(padded, alphabet: alphabet), bytes)
        assertBytes(try! Base64.decode(bare, alphabet: alphabet), bytes)
        assertBytes(try! Base64.decode(padded, alphabet: alphabet, padding: .Required), bytes)
        assertBytes(try! Base64.decode(bare, alphabet: alphabet, padding: .Forbidden), bytes)
        assertEqual(Base64.decodedLength(bare.utf8Count), count)
        assert(Base64.decodedLength(padded.utf8Count) >= count, "an upper bound for padded text")
        count += 1
    }
}

@test
fn aLongInputRoundTrips() {
    let bytes = sample(100_003)
    let text = Base64.encode(bytes)
    assertEqual(text.utf8Count, Base64.encodedLength(bytes.count))
    assertBytes(try! Base64.decode(text), bytes)
}

@test
fn encodingIntoABufferAppendsTheDigits() {
    var buffer = ByteBuffer()
    buffer.writeU8(0x21)
    Base64.encode("foobar".utf8Bytes(), into: &buffer)
    Base64.encode("f".utf8Bytes(), into: &buffer, alphabet: .UrlSafe, padding: false)
    assertBytes(buffer.bytes, "!Zm9vYmFyZg".utf8Bytes())
}

@test
fn decodingBytesIsDecodingTheirText() {
    assertBytes(try! Base64.decode(bytes: "Zm9vYmE=".utf8Bytes()), "fooba".utf8Bytes())
    assertBytes(try! Base64.decode(bytes: "_w".utf8Bytes(), alphabet: .UrlSafe, padding: .Forbidden), [0xFF])
}

@test
fn aSubstringDecodesWhereItLies() {
    let line = "data: Zm9vYg==;"
    let colon = line.firstIndex(of: ' ')!
    let semicolon = line.firstIndex(of: ';')!
    assertBytes(try! Base64.decode(line[line.index(after: colon)..<semicolon]), "foob".utf8Bytes())
}

@test
fn lengthsCountGroupsAndTheirRemainder() {
    assertEqual(Base64.encodedLength(0), 0)
    assertEqual(Base64.encodedLength(1), 4)
    assertEqual(Base64.encodedLength(1, padding: false), 2)
    assertEqual(Base64.encodedLength(2, padding: false), 3)
    assertEqual(Base64.encodedLength(3, padding: false), 4)
    assertEqual(Base64.decodedLength(0), 0)
    assertEqual(Base64.decodedLength(1), 0)
    assertEqual(Base64.decodedLength(2), 1)
    assertEqual(Base64.decodedLength(3), 2)
    assertEqual(Base64.decodedLength(4), 3)
}

@test(arguments: [
    ("Zm9v*mFy", .InvalidCharacter(at: 4, byte: 0x2A)),
    ("Zm 9v", .InvalidCharacter(at: 2, byte: 0x20)),
    ("Zm9vYmF\n", .InvalidCharacter(at: 7, byte: 0x0A)),
    ("Zm9vYé", .InvalidCharacter(at: 5, byte: 0xC3)),
    ("*m8", .InvalidCharacter(at: 0, byte: 0x2A)),
    ("Z*8", .InvalidCharacter(at: 1, byte: 0x2A)),
    ("Zm*", .InvalidCharacter(at: 2, byte: 0x2A)),
    ("Zm9v*", .InvalidCharacter(at: 4, byte: 0x2A)),
])
fn aCharacterOutsideTheAlphabetIsNamedWithItsOffset(_ text: String, _ error: DecodeError) {
    expectThrows(error) { _ = try Base64.decode(text) }
}

@test(arguments: [
    ("-_8=", .Standard, .InvalidCharacter(at: 0, byte: 0x2D)),
    ("+/8=", .UrlSafe, .InvalidCharacter(at: 0, byte: 0x2B)),
    ("ab_c", .Standard, .InvalidCharacter(at: 2, byte: 0x5F)),
])
fn eachAlphabetRejectsTheOthersDigits(_ text: String, _ alphabet: Base64.Alphabet, _ error: DecodeError) {
    expectThrows(error) { _ = try Base64.decode(text, alphabet: alphabet) }
}

@test(arguments: [
    ("Z", .Either, .InvalidLength(at: 0)),
    ("Zm9vY", .Either, .InvalidLength(at: 4)),
    ("Zm9vY", .Forbidden, .InvalidLength(at: 4)),
])
fn oneDigitLeftOverIsTheWrongLength(_ text: String, _ padding: Padding, _ error: DecodeError) {
    expectThrows(error) { _ = try Base64.decode(text, padding: padding) }
}

@test(arguments: [
    ("Zg", .Required, .InvalidPadding(at: 2)),
    ("Zm8", .Required, .InvalidPadding(at: 3)),
    ("Zg==", .Forbidden, .InvalidPadding(at: 2)),
    ("Zm8=", .Forbidden, .InvalidPadding(at: 3)),
])
fn paddingIsCheckedAgainstTheRule(_ text: String, _ padding: Padding, _ error: DecodeError) {
    expectThrows(error) { _ = try Base64.decode(text, padding: padding) }
}

@test
fn whatNeedsNoPaddingMeetsTheRule() {
    assertBytes(try! Base64.decode("Zm9v", padding: .Required), "foo".utf8Bytes())
    assertBytes(try! Base64.decode("", padding: .Required), [])
}

@test(arguments: [
    ("Zg=", .InvalidPadding(at: 2)),
    ("Zm8==", .InvalidPadding(at: 3)),
    ("Zm9v=", .InvalidPadding(at: 4)),
    ("Zm9v==", .InvalidPadding(at: 4)),
    ("Zg===", .InvalidPadding(at: 2)),
    ("Z===", .InvalidPadding(at: 1)),
    ("====", .InvalidPadding(at: 0)),
    ("=", .InvalidPadding(at: 0)),
])
fn theWrongAmountOfPaddingIsRejected(_ text: String, _ error: DecodeError) {
    expectThrows(error) { _ = try Base64.decode(text) }
}

@test(arguments: [("Zg==Zg==", .InvalidPadding(at: 2)), ("Zm8=Zm9v", .InvalidPadding(at: 3)), ("Zm9v=m9v", .InvalidPadding(at: 4))])
fn paddingInTheMiddleIsRejected(_ text: String, _ error: DecodeError) {
    expectThrows(error) { _ = try Base64.decode(text) }
}

@test(arguments: [
    ("Zh==", .TrailingBits(at: 1)),
    ("Zh", .TrailingBits(at: 1)),
    ("Zm9=", .TrailingBits(at: 2)),
    ("Zm9vZm9", .TrailingBits(at: 6)),
])
fn bitsTheBytesDoNotUseAreRejected(_ text: String, _ error: DecodeError) {
    expectThrows(error) { _ = try Base64.decode(text) }
}

@test
fn bitsTheBytesDoNotUseMayBeZero() {
    assertBytes(try! Base64.decode("Zg=="), [0x66])
}

// ---- Against the definition, a group at a time ---------------------------
// Every length from 0 to 130 and from several starts, so that each of the
// loops that take many at once, and what they leave, is held to it.

fn plainDigits(_ alphabet: Base64.Alphabet) -> U8[>..] {
    let same = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    return (same + (alphabet == .Standard ? "+/" : "-_")).utf8Bytes()
}

fn plainBase64(_ bytes: U8[:], _ alphabet: Base64.Alphabet, padding: Bool) -> U8[>..] {
    let digits = plainDigits(alphabet)
    var text: U8[>..] = []
    var bits = 0
    var held = 0
    for byte in bytes {
        bits = bits << 8 | Int(byte)
        held += 8
        while held >= 6 {
            held -= 6
            text.append(digits[bits >> held & 63])
        }
        bits = bits & 0xFF
    }
    if held > 0 {
        text.append(digits[bits << (6 - held) & 63])
    }
    while padding && text.count % 4 != 0 {
        text.append(0x3D)
    }
    return text
}

@test(arguments: [.Standard, .UrlSafe])
fn everyLengthAndStartEncodesAndDecodesAsTheDefinition(_ alphabet: Base64.Alphabet) {
    let all = sample(140)
    for start in 0..<4 {
        for n in 0...130 {
            let bytes = all[start..<(start + n)]
            for padding in [true, false] as Bool[>..] {
                let expected = plainBase64(bytes, alphabet, padding: padding)
                assertBytes(Base64.encode(bytes, alphabet: alphabet, padding: padding).utf8Bytes(), expected)
                // Digits outside the slice are not read: they would be decoded.
                var text: U8[>..] = [0x41, 0x42, 0x43]
                text.append(contentsOf: expected)
                let end = text.count
                text.append(contentsOf: [0x44, 0x45, 0x46, 0x47])
                assertBytes(try! Base64.decode(bytes: text[3..<end], alphabet: alphabet), bytes)
            }
            var buffer = ByteBuffer()
            buffer.write([0xAA])
            Base64.encode(bytes, into: &buffer, alphabet: alphabet)
            assertBytes(buffer.bytes[1...], plainBase64(bytes, alphabet, padding: true))
        }
    }
}

// A group's four digits each take each of their 64 values.
@test(arguments: [.Standard, .UrlSafe])
fn everyValueOfEverySixBitsAtEveryPosition(_ alphabet: Base64.Alphabet) {
    let digits = plainDigits(alphabet)
    var text = U8[>..](repeating: 0x41, count: 48)
    for at in 0..<48 {
        for value in 0..<64 {
            text[at] = digits[value]
            let bytes = try! Base64.decode(bytes: text, alphabet: alphabet)
            let group = Int(bytes[at / 4 * 3]) << 16 | Int(bytes[at / 4 * 3 + 1]) << 8 | Int(bytes[at / 4 * 3 + 2])
            assertEqual(group >> (18 - at % 4 * 6), value)
            assertBytes(Base64.encode(bytes, alphabet: alphabet).utf8Bytes(), text)
        }
        text[at] = 0x41
    }
}

@test(arguments: [.Standard, .UrlSafe])
fn everyByteThatIsNoDigitIsFoundAtEveryPositionOfALongText(_ alphabet: Base64.Alphabet) {
    let digits = plainDigits(alphabet)
    var text = plainBase64(sample(60), alphabet, padding: true)
    for at in 0..<(text.count - 1) {
        let held = text[at]
        for value in 0..<256 {
            let byte = U8(value)
            text[at] = byte
            var thrown: DecodeError? = none
            do {
                _ = try Base64.decode(bytes: text, alphabet: alphabet)
            } catch {
                thrown = error
            }
            if digits.contains(byte) {
                assertEqual(thrown, none)
            } else if byte == 0x3D {
                assertEqual(thrown, .InvalidPadding(at: at))
            } else {
                assertEqual(thrown, .InvalidCharacter(at: at, byte: byte))
            }
        }
        text[at] = held
    }
}
