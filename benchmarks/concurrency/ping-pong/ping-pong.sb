module PingPong

import Sable.Testing

// Ping-pong: two tasks hand a ball back and forth through an actor a
// hundred thousand times — each parked in a wait list until it is its turn,
// and, as stage 2's channels did, by yielding until it is.

actor Table {
    var ball = 0
    let turned = WaitList()

    fn hit(_ player: Int, _ rounds: Int) async {
        while ball < rounds {
            while ball % 2 != player && ball < rounds {
                await turned.park()
            }
            if ball < rounds {
                ball += 1
                turned.wakeAll()
            }
        }
    }

    fn turn() -> Int {
        return ball
    }

    fn take() {
        ball += 1
    }

    fn reset() {
        ball = 0
    }
}

fn yielding(_ table: Table, _ player: Int, _ rounds: Int) async -> Int {
    var hits = 0
    while true {
        let ball = await table.turn()
        if ball >= rounds {
            return hits
        }
        if ball % 2 == player {
            await table.take()
            hits += 1
        } else {
            await Task.yield()
        }
    }
}

let rounds = 100_000

// A hit's time.
@bench
fn parked(_ b: Bencher) async {
    let table = Table()
    b.operationsPerIteration = rounds
    await b.iterateAsync {
        await table.reset()
        let first = Task.spawn { await table.hit(0, rounds) }
        let second = Task.spawn { await table.hit(1, rounds) }
        await first.value
        await second.value
    }
    b.check("\(await table.turn())")
}

@bench
fn yielded(_ b: Bencher) async {
    let table = Table()
    b.operationsPerIteration = rounds
    let hits = await b.iterateAsync {
        await table.reset()
        let first = Task.spawn { await yielding(table, 0, rounds) }
        let second = Task.spawn { await yielding(table, 1, rounds) }
        return await first.value + await second.value
    }
    b.check("\(hits)")
}
