/// The bytes given in pieces of the sizes, over and over, and the hash's value
/// in hex after them.
public fn inPieces<H: NonCryptographicHash>(_ hash: H, _ bytes: U8[:], _ sizes: Int[:], _ value: (H) -> String) -> String {
    var hash = hash
    var at = 0
    var i = 0
    while at < bytes.count {
        let size = sizes[i % sizes.count]
        let end = at + size < bytes.count ? at + size : bytes.count
        hash.update(bytes[at..<end])
        at = end
        i += 1
    }
    return value(hash)
}

/// The piece sizes the incremental tests give bytes in.
public let pieceSizes: Int[>..][>..] = [[1], [7], [16, 1, 31], [64], [100, 3], [255, 1, 2], [1024]]
