module Sable.Diagnostics

/// What every span of one trace shares: 16 random bytes, written as 32
/// lowercase hex digits (W3C Trace Context). All zeros is no trace.
/// .NET's `ActivityTraceId`.
///
/// ```sable
/// let id = TraceId.parse(hex: "4bf92f3577b34da6a3ce929d0e0e4736")!
/// assert(id.hex == "4bf92f3577b34da6a3ce929d0e0e4736")
/// assert(TraceId.random().isValid)
/// assert(TraceId.parse(hex: "00000000000000000000000000000000")!.isValid == false)
/// ```
@derive(Equatable, Hashable, Debug)
public struct TraceId {
    /// The first 8 bytes, and the last, as numbers.
    public let high: U64
    public let low: U64

    public init(high: U64, low: U64) {
        self.high = high
        self.low = low
    }

    /// The id the 32 hex digits write, or none for anything else.
    public static fn parse(hex: String) -> TraceId? {
        let bytes = hex.utf8.toArray()
        if bytes.count != 32 {
            return none
        }
        guard let high = TraceId.number(bytes, 0, 16) else {
            return none
        }
        guard let low = TraceId.number(bytes, 16, 16) else {
            return none
        }
        return TraceId(high: high, low: low)
    }

    /// A new trace's: random, from the system's source.
    public static fn random() -> TraceId {
        var system = SystemRandomNumberGenerator()
        var id = TraceId(high: system.next(), low: system.next())
        while !id.isValid {
            id = TraceId(high: system.next(), low: system.next())
        }
        return id
    }

    /// Whether it is a trace's: not all zeros.
    public var isValid: Bool => high != 0 || low != 0

    /// The 32 lowercase hex digits.
    public var hex: String => TraceId.digits(high, 16) + TraceId.digits(low, 16)

    // A number of so many hex digits, lowercase or upper, at 'from'.
    static fn number(_ bytes: U8[>..], _ from: Int, _ count: Int) -> U64? {
        var value: U64 = 0
        var i = from
        while i < from + count {
            let b = Int(bytes[i])
            var digit = -1
            if b >= 0x30 && b <= 0x39 {
                digit = b - 0x30
            } else if b >= 0x61 && b <= 0x66 {
                digit = b - 0x61 + 10
            }
            if digit < 0 {
                return none
            }
            value = (value << 4) | U64(digit)
            i += 1
        }
        return value
    }

    // The number as so many lowercase hex digits, zeros first.
    static fn digits(_ value: U64, _ count: Int) -> String {
        let hex: U8[>..] = [0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x61, 0x62, 0x63, 0x64, 0x65, 0x66]
        var bytes: U8[>..] = []
        var shift = (count - 1) * 4
        while shift >= 0 {
            bytes.append(hex[Int((value >> U64(shift)) & 15)])
            shift -= 4
        }
        unsafe {
            return Runtime.stringFromValidUtf8(bytes)
        }
    }
}
