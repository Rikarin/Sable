module Sable.IO

/// A key pressed at a terminal, and the keys held with it (`Console.readKey`):
/// .NET's `ConsoleKeyInfo`, crossterm's `KeyEvent`. Read from what the
/// terminal sends, so it says only as much as that does: most terminals send
/// nothing for Shift with a letter but the capital letter, nor anything for
/// a modifier pressed alone.
///
/// ```sable
/// let keys = KeyEvent.decode([0x71, 0x1B, 0x5B, 0x31, 0x3B, 0x35, 0x41, 0x03])
/// assert(keys.count == 3)
/// assert(keys[0] == KeyEvent(.Character('q')))
/// assert(keys[1] == KeyEvent(.Up, modifiers: .control))
/// assert(keys[2].description() == "Ctrl+c")
/// ```
@derive(Equatable, Debug)
public struct KeyEvent {
    public let key: Key
    public let modifiers: KeyModifiers

    public init(_ key: Key, modifiers: KeyModifiers = KeyModifiers.empty) {
        self.key = key
        self.modifiers = modifiers
    }

    /// The character typed, if it is one.
    public var character: Char? {
        get {
            return match key {
                case .Character(let c) => c
                default                => none
            }
        }
    }

    /// As a key binding writes it: "Ctrl+Shift+Up", "q", "Alt+Enter".
    public fn description() -> String {
        let held = modifiers.description()
        return held.isEmpty ? key.description() : held + "+" + key.description()
    }

    /// The keys the bytes a terminal sent are: each sequence a key, an
    /// escape alone the Escape key. What is not UTF-8 is U+FFFD.
    public static fn decode(_ bytes: U8[>..]) -> KeyEvent[>..] {
        return KeyEvent.decode(bytes, complete: true).keys
    }

    /// The keys whole in the bytes, as they come from a terminal, and how
    /// many bytes they are: what is left after them may be a key cut short,
    /// whose rest is to come — unless the bytes are 'complete', and it is what
    /// came of it.
    ///
    /// ```sable
    /// let (keys, used) = KeyEvent.decode([0x61, 0x1B, 0x5B, 0x31], complete: false)
    /// assert(keys == [KeyEvent(.Character('a'))] && used == 1)
    /// ```
    public static fn decode(_ bytes: U8[>..], complete: Bool) -> (keys: KeyEvent[>..], used: Int) {
        var keys: KeyEvent[>..] = []
        var at = 0
        while at < bytes.count {
            guard let (key, length) = KeyEvent.decodeOne(bytes, at, complete: complete) else {
                break
            }
            keys.append(key)
            at += length
        }
        return (keys: keys, used: at)
    }

    // The key at 'at', and how many bytes it is; none where more of it may
    // be to come, which a 'complete' run of bytes says there is not.
    static fn decodeOne(_ bytes: U8[>..], _ at: Int, complete: Bool) -> (KeyEvent, Int)? {
        let first = Int(bytes[at])
        if first == 0x1B {
            return KeyEvent.escaped(bytes, at, complete: complete)
        }
        if first < 0x20 || first == 0x7F {
            return (KeyEvent.control(first), 1)
        }
        if first < 0x80 {
            return (KeyEvent(.Character(KeyEvent.scalar(first))), 1)
        }
        // UTF-8: the bytes after a lead, as many as it says.
        let length = first >= 0xF0 && first < 0xF8 ? 4 : first >= 0xE0 ? 3 : first >= 0xC0 ? 2 : 1
        if at + length > bytes.count {
            if !complete {
                return none
            }
            return (KeyEvent(.Character(KeyEvent.scalar(0xFFFD))), 1)
        }
        var value = length == 4 ? first & 0x07 : length == 3 ? first & 0x0F : first & 0x1F
        var i = 1
        while i < length {
            let next = Int(bytes[at + i])
            if (next & 0xC0) != 0x80 {
                return (KeyEvent(.Character(KeyEvent.scalar(0xFFFD))), i)
            }
            value = (value << 6) | (next & 0x3F)
            i += 1
        }
        if length == 1 {
            value = 0xFFFD
        }
        return (KeyEvent(.Character(KeyEvent.scalar(value))), length)
    }

    static fn scalar(_ value: Int) -> Char {
        return Char.fromCodePoint(value: value) ?? Char.fromCodePoint(value: 0xFFFD)!
    }

    // A byte below space, or DEL: Enter, Tab, Backspace, Escape, or Control
    // with a letter.
    static fn control(_ byte: Int) -> KeyEvent {
        if byte == 0x0D || byte == 0x0A {
            return KeyEvent(.Enter)
        }
        if byte == 0x09 {
            return KeyEvent(.Tab)
        }
        if byte == 0x7F {
            return KeyEvent(.Backspace)
        }
        if byte == 0x08 {
            return KeyEvent(.Backspace, modifiers: .control)
        }
        if byte == 0x00 {
            return KeyEvent(.Character(' '), modifiers: .control)
        }
        if byte <= 0x1A {
            return KeyEvent(.Character(KeyEvent.scalar(0x60 + byte)), modifiers: .control)
        }
        // Ctrl with \ ] ^ _ as most terminals send them: Ctrl+4 to Ctrl+7.
        return KeyEvent(.Character(KeyEvent.scalar(0x34 + byte - 0x1C)), modifiers: .control)
    }

    static fn escaped(_ bytes: U8[>..], _ at: Int, complete: Bool) -> (KeyEvent, Int)? {
        if at + 1 >= bytes.count {
            return complete ? (KeyEvent(.Escape), 1) : none
        }
        let second = Int(bytes[at + 1])
        if second == 0x5B {
            return KeyEvent.csi(bytes, at, complete: complete)
        }
        if second == 0x4F {
            if at + 2 >= bytes.count {
                return complete ? (KeyEvent(.Character('O'), modifiers: .alt), 2) : none
            }
            // The keypad's Enter, as some terminals send it.
            let last = Int(bytes[at + 2])
            let key = last == 0x4D ? Key.Enter : KeyEvent.keyEnding(last)
            return (KeyEvent(key ?? .Unrecognised(KeyEvent.text(bytes, at + 1, 2))), 3)
        }
        if second == 0x1B {
            return (KeyEvent(.Escape), 1)
        }
        // Alt with a key: the key after an escape.
        if let (key, length) = KeyEvent.decodeOne(bytes, at + 1, complete: complete) {
            return (KeyEvent(key.key, modifiers: key.modifiers | KeyModifiers.alt), length + 1)
        }
        return none
    }

    // The key a sequence's last byte says, where it says one: an arrow, Home
    // and End, F1 to F4.
    static fn keyEnding(_ byte: Int) -> Key? {
        return match byte {
            case 0x41 => Key.Up
            case 0x42 => Key.Down
            case 0x43 => Key.Right
            case 0x44 => Key.Left
            case 0x48 => Key.Home
            case 0x46 => Key.End
            case 0x50 => Key.Function(1)
            case 0x51 => Key.Function(2)
            case 0x52 => Key.Function(3)
            case 0x53 => Key.Function(4)
            default   => none
        }
    }

    static fn text(_ bytes: U8[>..], _ from: Int, _ count: Int) -> String {
        return String.fromUtf8Lossy(bytes[from..<(from + count)])
    }

    // ESC [, its parameters (digits, ';' and ':'), and a last byte.
    static fn csi(_ bytes: U8[>..], _ at: Int, complete: Bool) -> (KeyEvent, Int)? {
        var i = at + 2
        // The Linux console's F1 to F5: ESC [ [ A to E.
        if i < bytes.count && bytes[i] == 0x5B {
            if i + 1 >= bytes.count {
                return complete ? (KeyEvent(.Unrecognised("[[")), 3) : none
            }
            let letter = Int(bytes[i + 1])
            let key = letter >= 0x41 && letter <= 0x45 ? Key.Function(letter - 0x40) : Key.Unrecognised(KeyEvent.text(bytes, at + 1, 3))
            return (KeyEvent(key), 4)
        }
        var parameters: Int[>..] = [0]
        var sub = false
        while i < bytes.count {
            let b = Int(bytes[i])
            if b >= 0x40 && b <= 0x7E {
                break
            }
            if b >= 0x30 && b <= 0x39 {
                if !sub {
                    let last = parameters.count - 1
                    parameters[last] = parameters[last] * 10 + (b - 0x30)
                }
            } else if b == 0x3B {
                parameters.append(0)
                sub = false
            } else if b == 0x3A {
                sub = true
            } else if b < 0x20 || b > 0x3F {
                // Not a sequence after all: what came so far is unrecognised.
                return (KeyEvent(.Unrecognised(KeyEvent.text(bytes, at + 1, i - at - 1))), i - at)
            }
            i += 1
        }
        if i >= bytes.count {
            return complete ? (KeyEvent(.Unrecognised(KeyEvent.text(bytes, at + 1, i - at - 1))), i - at) : none
        }
        let length = i - at + 1
        let last = Int(bytes[i])
        let modifiers = KeyModifiers(bits: parameters.count > 1 && parameters[1] > 0 ? parameters[1] - 1 : 0)
        let whole = KeyEvent.text(bytes, at + 1, length - 1)
        if last == 0x7E {
            let key: Key? = match parameters[0] {
                case 1, 7 => Key.Home
                case 2    => Key.Insert
                case 3    => Key.Delete
                case 4, 8 => Key.End
                case 5    => Key.PageUp
                case 6    => Key.PageDown
                case 11   => Key.Function(1)
                case 12   => Key.Function(2)
                case 13   => Key.Function(3)
                case 14   => Key.Function(4)
                case 15   => Key.Function(5)
                case 17   => Key.Function(6)
                case 18   => Key.Function(7)
                case 19   => Key.Function(8)
                case 20   => Key.Function(9)
                case 21   => Key.Function(10)
                case 23   => Key.Function(11)
                case 24   => Key.Function(12)
                case 25   => Key.Function(13)
                case 26   => Key.Function(14)
                case 28   => Key.Function(15)
                case 29   => Key.Function(16)
                case 31   => Key.Function(17)
                case 32   => Key.Function(18)
                case 33   => Key.Function(19)
                case 34   => Key.Function(20)
                default   => none
            }
            return (KeyEvent(key ?? .Unrecognised(whole), modifiers: key == none ? .empty : modifiers), length)
        }
        if last == 0x5A {
            return (KeyEvent(.Tab, modifiers: modifiers | KeyModifiers.shift), length)
        }
        if last == 0x75 {
            // The kitty keyboard protocol's: the key's code point.
            let key: Key = match parameters[0] {
                case 13  => Key.Enter
                case 9   => Key.Tab
                case 27  => Key.Escape
                case 127 => Key.Backspace
                default  => Key.Character(KeyEvent.scalar(parameters[0]))
            }
            return (KeyEvent(key, modifiers: modifiers), length)
        }
        if let key = KeyEvent.keyEnding(last) {
            return (KeyEvent(key, modifiers: modifiers), length)
        }
        return (KeyEvent(.Unrecognised(whole)), length)
    }
}
