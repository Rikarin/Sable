module FormatSpecTests

// FormatSpec (Sable.Core): the text form a spec is read from, at run time as
// the compiler reads it after an interpolation's colon, and the padding it
// does. Run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing
import CoreTestSupport

@test
fn anEmptySpecSaysNothing() {
    assertEqual(spec(""), FormatSpec())
    assertEqual(FormatSpec().debugDescription(), "FormatSpec()")
}

@test
fn everyPartIsReadInOrder() {
    let read = spec("*^+#012_.3e")
    assertEqual(read.fill, '*')
    expect(read.alignment == .Center)
    expect(read.sign == .Always)
    expect(read.alternate)
    expect(read.zeroPadded)
    assertEqual(read.width, 12)
    expect(read.separator == '_')
    expect(read.precision == 3)
    expect(read.kind == .Exponent)
    assertEqual(read.debugDescription(), "FormatSpec(fill: '*', alignment: .Center, sign: .Always, alternate: true, zeroPadded: true, width: 12, separator: '_', precision: 3, kind: .Exponent)")
}

@test
fn anAlignmentAloneHasASpaceForFill() {
    let read = spec("<8")
    assertEqual(read.fill, ' ')
    expect(read.alignment == .Left)
    assertEqual(read.width, 8)
    expect(spec(">").alignment == .Right)
    expect(spec("^").alignment == .Center)
}

@test
fn aFillIsAnyScalarBeforeAnAlignment() {
    assertEqual(spec("é>3").fill, 'é')
    assertEqual(spec("0<5").fill, '0')
    expect(!spec("0<5").zeroPadded)
    assertEqual(spec("<<2").fill, '<')
}

@test(arguments: [("+", .Always), ("-", .Negative), (" ", .Space)])
fn eachSignIsRead(_ text: String, _ sign: FormatSign) {
    expect(spec(text).sign == sign)
}

@test
fn aCommaSeparatorIsRead() {
    expect(spec(",").separator == ',')
    expect(spec("").separator == none)
}

@test(arguments: [
    ("d", .Decimal), ("x", .Hex), ("X", .UpperHex), ("o", .Octal), ("b", .Binary), ("e", .Exponent),
    ("E", .UpperExponent), ("f", .Fixed), ("g", .General), ("G", .UpperGeneral), ("%", .Percent), ("?", .Debug)
])
fn eachKindLetterIsRead(_ text: String, _ kind: FormatKind) {
    expect(spec(text).kind == kind)
}

@test
fn aPrecisionOfZeroIsKept() {
    expect(spec(".0").precision == 0)
    assertEqual(spec(".0").debugDescription(), "FormatSpec(precision: 0)")
}

@test(arguments: [(".x", .InvalidDigit(at: 1)), ("8.", .InvalidDigit(at: 2))])
fn aPointWithoutDigitsIsRefused(_ text: String, _ error: ParseError) {
    expectThrows(error) { _ = try FormatSpec.parse(text) }
}

@test(arguments: [("08q", .Invalid(at: 2)), ("xx", .Invalid(at: 1)), (".2+", .Invalid(at: 2))])
fn aScalarOutOfPlaceIsRefusedWhereItIs(_ text: String, _ error: ParseError) {
    expectThrows(error) { _ = try FormatSpec.parse(text) }
}

@test
fn aWidthPastAnIntOverflows() {
    expectThrows(ParseError.Overflow) { _ = try FormatSpec.parse("99999999999999999999") }
    assertEqual(spec("9223372036854775807").width, 9223372036854775807)
}

@test
fn paddedPutsTextOnTheLeftUnlessTold() {
    var plain = FormatSpec()
    plain.width = 5
    assertEqual(plain.padded("ab"), "ab   ")
    assertEqual(spec(">5").padded("ab"), "   ab")
    assertEqual(spec("*^6").padded("ab"), "**ab**")
    assertEqual(spec("*^5").padded("ab"), "*ab**")
}

@test
fn paddedLeavesTextAsWideAsTheWidthAlone() {
    assertEqual(spec("3").padded("abc"), "abc")
    assertEqual(spec("2").padded("abc"), "abc")
    assertEqual(FormatSpec().padded(""), "")
}

@test
fn paddedCountsScalarsNotBytes() {
    assertEqual(spec(">4").padded("é😀"), "  é😀")
}

@test
fn specsAreEqualFieldByField() {
    assertEqual(spec(">8"), spec(" >8"))
    assertNotEqual(spec(">8"), spec("<8"))
    assertNotEqual(spec(".2"), spec(".3"))
    assertNotEqual(spec(","), spec("_"))
}
