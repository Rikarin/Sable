module Utf8DecoderTests

// Utf8Decoder (Sable.Text), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Testing
import Sable.Text

@test
fn aScalarSplitAcrossChunksIsKeptWhole() {
    var decoder = Utf8Decoder()
    assertEqual(decoder.decode([0x63, 0x61, 0x66, 0xC3]), "caf")
    assertEqual(decoder.decode([0xA9, 0x21]), "é!")
    assertEqual(decoder.finish(), "")
    expect(!decoder.sawInvalid, "nothing was replaced")
}

@test
fn aFourByteScalarSplitEachWay() {
    let all = "a😀b".utf8Bytes()
    for cut in 1..<all.count {
        var decoder = Utf8Decoder()
        let text = decoder.decode(all[..<cut]) + decoder.decode(all[cut...]) + decoder.finish()
        assertEqual(text, "a😀b")
    }
}

@test
fn aSequenceLeftUnfinishedIsReplacedAtTheEnd() {
    var decoder = Utf8Decoder()
    assertEqual(decoder.decode([0x61, 0xE2, 0x82]), "a")
    assertEqual(decoder.finish(), "\u{FFFD}")
    expect(decoder.sawInvalid, "the unfinished sequence was replaced")
}

@test
fn illFormedBytesAreReplacedAsTheyCome() {
    var decoder = Utf8Decoder()
    assertEqual(decoder.decode([0x61, 0xFF, 0x62]), "a\u{FFFD}b")
    expect(decoder.sawInvalid, "replaced")
    assertEqual(decoder.decode([0xC3, 0x28]), "\u{FFFD}(")
}

@test
fn aContinuationByteAtTheEndIsNotHeldBack() {
    var decoder = Utf8Decoder()
    assertEqual(decoder.decode([0x61, 0x80]), "a\u{FFFD}")
    assertEqual(decoder.decode([0xC3, 0xA9, 0x80, 0x80, 0x80]), "é\u{FFFD}\u{FFFD}\u{FFFD}")
    assertEqual(decoder.decode([0xF0, 0x80]), "\u{FFFD}\u{FFFD}")
    assertEqual(decoder.finish(), "")
}
