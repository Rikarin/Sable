module Sable.IO

/// Files and directories by path, as code that is to be tested without a
/// disk takes them: `DiskFileSystem` is the machine's, through `File` and
/// `Directory`; `InMemoryFileSystem` holds its files in memory, for a test.
/// .NET's `System.IO.Abstractions` `IFileSystem`.
///
/// Every member takes a path as a `String` or a `FilePath` (`PathLike`).
///
/// ```sable
/// fn count(_ files: any FileSystem, in directory: String) -> Int {
///     return (try? files.list(directory))?.count ?? 0
/// }
/// let files = InMemoryFileSystem()
/// try! files.createDirectory("logs")
/// try! files.write("logs/a.txt", "a")
/// assert(count(files, in: "logs") == 1)
/// ```
public protocol FileSystem: Sendable {
    /// Every byte of the file.
    fn readBytes(_ path: some PathLike) throws(IoError) -> U8[>..]

    /// The bytes written as the whole file, made if it is not there; its
    /// directory must be.
    fn writeBytes(_ path: some PathLike, _ bytes: U8[:]) throws(IoError)

    /// The bytes added at the end of the file, made if it is not there.
    fn appendBytes(_ path: some PathLike, _ bytes: U8[:]) throws(IoError)

    /// What is at the path: its kind, its length, when it was written.
    fn metadata(_ path: some PathLike) throws(IoError) -> FileMetadata

    /// Makes the directory; with 'recursive', every one of the path that is
    /// not there, and none is an error for being there.
    fn createDirectory(_ path: some PathLike, recursive: Bool) throws(IoError)

    /// The names of what the directory holds, sorted by their bytes.
    fn list(_ path: some PathLike) throws(IoError) -> String[>..]

    /// Removes the file.
    fn removeFile(_ path: some PathLike) throws(IoError)

    /// Removes the directory: an empty one, or, with 'recursive', with all
    /// in it.
    fn removeDirectory(_ path: some PathLike, recursive: Bool) throws(IoError)

    /// The file or directory renamed: what is at the new path is replaced,
    /// unless 'overwrite' is false, when it is an error.
    fn rename<Source: PathLike, Target: PathLike>(from source: Source, to target: Target, overwrite: Bool) throws(IoError)

    /// The file copied: what is at the new path is replaced, unless
    /// 'overwrite' is false, when it is an error.
    fn copy<Source: PathLike, Target: PathLike>(from source: Source, to target: Target, overwrite: Bool) throws(IoError)
}

extension FileSystem {
    /// The file's contents as UTF-8 text, each ill-formed sequence made U+FFFD.
    public fn read(_ path: some PathLike) throws(IoError) -> String {
        return String.fromUtf8Lossy(try readBytes(path))
    }

    /// Replaces the file's contents with the text, making it if it is not there.
    public fn write(_ path: some PathLike, _ text: String) throws(IoError) {
        try writeBytes(path, text.utf8Bytes())
    }

    /// Adds the text to the end of the file, making it if it is not there.
    public fn append(_ path: some PathLike, _ text: String) throws(IoError) {
        try appendBytes(path, text.utf8Bytes())
    }

    /// Whether something that is not a directory is at the path.
    public fn exists(_ path: some PathLike) -> Bool {
        guard let found = try? metadata(path) else {
            return false
        }
        return !found.isDirectory
    }

    /// Whether a directory is at the path.
    public fn directoryExists(_ path: some PathLike) -> Bool {
        return (try? metadata(path))?.isDirectory ?? false
    }

    /// Makes the directory, its parent there already.
    public fn createDirectory(_ path: some PathLike) throws(IoError) {
        try createDirectory(path, recursive: false)
    }

    /// Removes the directory, which must be empty.
    public fn removeDirectory(_ path: some PathLike) throws(IoError) {
        try removeDirectory(path, recursive: false)
    }

    /// The file or directory renamed, replacing what is at the new path.
    public fn rename<Source: PathLike, Target: PathLike>(from source: Source, to target: Target) throws(IoError) {
        try rename(from: source, to: target, overwrite: true)
    }

    /// The file copied, replacing what is at the new path.
    public fn copy<Source: PathLike, Target: PathLike>(from source: Source, to target: Target) throws(IoError) {
        try copy(from: source, to: target, overwrite: true)
    }
}
