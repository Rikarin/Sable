module KeyFormatTests

// Keys in PEM, DER and JWK (Sable.Crypto): OpenSSL's, read and written as they
// were, and what is refused. Run with tools/stdlib-coverage.sh Sable.Crypto.

import Sable.Crypto
import Sable.Testing
import Sable.Text

fn hex(_ text: String) -> U8[>..] {
    return try! Hex.decode(text)
}

fn text(_ text: String) -> U8[>..] {
    return text.utf8.toArray()
}
