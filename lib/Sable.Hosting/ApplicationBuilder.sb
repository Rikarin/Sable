module Sable.Hosting

import Sable.DependencyInjection
import Sable.Diagnostics
import Sable.IO
import Sable.Time

/// Where a program's host is put together: .NET's `Host.CreateApplicationBuilder`.
///
/// ```sable
/// let builder = ApplicationBuilder()
/// builder.environment.name = "Development"
/// builder.options.shutdownTimeout = Duration.seconds(5)
/// builder.options.handleSignals = false
/// builder.services.addWorker("once") { context, _cancellation in
///     context.lifetime.requestStop()
/// }
/// let host = try! builder.build()
/// try! await host.run()
/// ```
public final class ApplicationBuilder {
    /// The services to run.
    public let services: HostedServices
    /// What they are made from, for those that say what that is
    /// (`HostedServices.add(_:_:)` of a type). The host's environment,
    /// configuration, logging, lifetime and clock are registered as it is
    /// built, unless something else is, and a `Logger` of the logging's;
    /// it disposes the rest as it stops. It starts with `Logger.Of` of
    /// every type, made with that `Logger`, a new one each time.
    public var container: ServiceCollection
    /// What they are configured by: the environment's variables, if not set.
    public var configuration: any HostConfiguration
    /// How they log.
    public var logging: HostLogging
    /// Where they run.
    public var environment: HostEnvironment
    /// How the host starts and stops.
    public var options: HostOptions
    /// The time it goes by: the system's, if not set.
    public var clock: any HostClock
    var systemd: Bool = false

    /// A builder with the usual settings. SABLE_LOG's level is the logging's.
    public init() {
        services = HostedServices()
        container = ServiceCollection()
        container.addTransient(open: Logger.Of.self, Logger.Of.self)
        configuration = EnvironmentConfiguration()
        logging = HostLogging(minimumLevel: ApplicationBuilder.levelFromEnvironment())
        environment = HostEnvironment.current()
        options = HostOptions()
        clock = SystemHostClock()
    }

    static fn levelFromEnvironment() -> Level? {
        if let text = Environment.variable("SABLE_LOG") {
            if let level = parseLevel(text) {
                return level
            }
        }
        return Level.Info
    }

    /// Tells systemd when the host is ready, reloading and stopping, and
    /// that it is alive as often as its watchdog wants (`Systemd`). Where
    /// systemd did not start the program, nothing.
    public fn useSystemd() {
        systemd = true
    }

    /// The host, its services made, each from its closure in order. What a
    /// closure throws, this throws; and ServiceError where the container has
    /// something wrong, or must be waited for (`buildAsync`).
    public fn build() throws -> Host {
        let lifetime = ApplicationLifetime()
        return try host(lifetime, try registered(lifetime).build())
    }

    /// The host, as `build` makes it, with what in its container must be
    /// waited for.
    ///
    /// ```sable
    /// let builder = ApplicationBuilder()
    /// builder.container.addSingleton(Int.self) { _services in
    ///     await Task.yield()
    ///     return 8080
    /// }
    /// let host = try! await builder.buildAsync()
    /// assert(try! host.context.container.resolve(Int.self) == 8080)
    /// ```
    public async fn buildAsync() throws -> Host {
        let lifetime = ApplicationLifetime()
        return try host(lifetime, try await registered(lifetime).buildAsync())
    }

    // What the container has, with the host's own.
    fn registered(_ lifetime: ApplicationLifetime) -> ServiceCollection {
        var all = container
        all.tryAdd(ServiceDescriptor.of(HostEnvironment.self, none, environment))
        all.tryAdd(ServiceDescriptor.of((any HostConfiguration).self, none, configuration))
        all.tryAdd(ServiceDescriptor.of(HostLogging.self, none, logging))
        let logging = self.logging
        all.tryAdd(ServiceDescriptor.of(Logger.self, ServiceLifetime.Transient, none) { _services in logging.logger("app") })
        all.tryAdd(ServiceDescriptor.of(ApplicationLifetime.self, none, lifetime))
        all.tryAdd(ServiceDescriptor.of((any HostClock).self, none, clock))
        return all
    }

    fn host(_ lifetime: ApplicationLifetime, _ provider: ServiceProvider) throws -> Host {
        let context = HostContext {
            environment: environment,
            configuration: configuration,
            logging: logging,
            lifetime: lifetime,
            clock: clock,
            container: provider
        }
        var runs: ServiceRun[>..] = []
        for entry in services.entries {
            let service = try entry.make(context)
            runs.append(ServiceRun(name: entry.name, service: service, onFailure: entry.onFailure ?? options.onServiceFailure))
        }
        return Host(context: context, options: options, runs: runs, systemd: systemd && Systemd.isActive)
    }
}
