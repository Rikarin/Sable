module Sable.Math

// Integer and floating-point arithmetic beyond the operators: generic,
// over the core's Comparable and numeric protocols (BinaryInteger,
// FloatingPoint), and monomorphised for each type it is used with.

/// The greater of two values.
public fn max<T: Comparable>(_ a: T, _ b: T) -> T {
    return a < b ? b : a
}

/// The lesser of two values.
public fn min<T: Comparable>(_ a: T, _ b: T) -> T {
    return b < a ? b : a
}

/// The value, kept within [low, high].
public fn clamp<T: Comparable>(_ value: T, _ low: T, _ high: T) -> T {
    if value < low {
        return low
    }
    if high < value {
        return high
    }
    return value
}

/// The greatest common divisor, never negative; gcd(0, 0) is 0. It traps
/// where that does not fit, as a signed type's least value's does not.
///
/// ```sable
/// assert(gcd(1071, 462) == 21)
/// assert(gcd(-4 as I8, 6) == 2)
/// ```
public fn gcd<T: BinaryInteger>(_ a: T, _ b: T) -> T {
    var x = a < T.zero ? T.zero - a : a
    var y = b < T.zero ? T.zero - b : b
    while y != T.zero {
        let t = x % y
        x = y
        y = t
    }
    return x
}

/// The least common multiple, never negative; lcm with 0 is 0. It traps
/// where that does not fit the type.
///
/// ```sable
/// assert(lcm(4, 6) == 12)
/// assert(lcm(0 as U8, 9) == 0)
/// ```
public fn lcm<T: BinaryInteger>(_ a: T, _ b: T) -> T {
    if a == T.zero || b == T.zero {
        return T.zero
    }
    let product = a / gcd(a, b) * b
    return product < T.zero ? T.zero - product : product
}

/// base to the power exponent, by squaring: any number, an integer's
/// trapping on overflow as '*' does. A negative exponent gives 1, as no
/// factor is taken.
///
/// ```sable
/// assert(power(2, 40) == 1099511627776)
/// assert(power(1.5, 2) == 2.25)
/// ```
public fn power<T: Numeric>(_ base: T, _ exponent: Int) -> T {
    var result = T.one
    var b = base
    var e = exponent
    while e > 0 {
        if e % 2 == 1 {
            result = result * b
        }
        e = e / 2
        if e > 0 {
            b = b * b
        }
    }
    return result
}

/// Whether n is prime, by trial division.
///
/// ```sable
/// assert(isPrime(97))
/// assert(!isPrime(91 as U8))
/// ```
public fn isPrime<T: BinaryInteger>(_ n: T) -> Bool {
    let two = T.one + T.one
    let three = two + T.one
    if n < two {
        return false
    }
    if n <= three {
        return true
    }
    if n % two == T.zero {
        return false
    }
    var d = three
    while d <= n / d {
        if n % d == T.zero {
            return false
        }
        d = d + two
    }
    return true
}

/// The square root, correctly rounded: NaN for a negative value. The same
/// as 'x.squareRoot()'.
public fn squareRoot<T: FloatingPoint>(_ x: T) -> T {
    return x.squareRoot()
}

/// The greatest integer not above x, as a float: 'x.floor()'. 'Int(…)'
/// makes it an integer, trapping where it does not fit.
public fn floor<T: FloatingPoint>(_ x: T) -> T {
    return x.floor()
}

/// The least integer not below x, as a float: 'x.ceiling()'.
public fn ceiling<T: FloatingPoint>(_ x: T) -> T {
    return x.ceiling()
}

/// x rounded to the nearest integer, halves away from zero, as a float:
/// 'x.rounded()'.
public fn round<T: FloatingPoint>(_ x: T) -> T {
    return x.rounded()
}
