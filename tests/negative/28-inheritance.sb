module Negative.Inheritance

public open class Shape {
    public open fn area() -> F64 {
        return 0.0
    }

    public fn name() -> String {
        return "shape"
    }
}

public sealed class Circle: Shape {
    public override fn area() -> F64 {
        return 3.0
    }
}

public class Square: Circle { }         //! S3044 is sealed

public abstract class Abstract {
    public init() { }
}

fn instantiatingAnAbstractClass() -> Abstract {
    return Abstract()                   //! S3045 is abstract
}

public class Missing: Shape {
    public fn area() -> F64 {           //! S3042 needs 'override'
        return 1.0
    }
}

public class Spurious: Shape {
    public override fn missing() -> Int {   //! S3043 no base class declares it
        return 1
    }
}

public class Shadowing: Shape {
    public override fn name() -> String {
        return "shadow"
    }
}

public class DifferentSignature: Shape {
    public fn area(_ scale: F64) -> F64 {
        return scale
    }
}

public open class Base {
    public init() { }

    public open fn measure(_ x: Int) -> Int {
        return x
    }

    public final fn sealedAnswer() -> Int {
        return 1
    }

    public open fn load() throws(String) -> Int {
        return 1
    }

    public open fn quiet() -> Int {
        return 1
    }

    public open var size: Int { get => 1 }

    public open var label: String { get => "base" set { } }

    public final var fixed: Int { get => 1 }
}

public class ReturnsAnotherType: Base {
    public override init() { super.init() }

    public override fn measure(_ x: Int) -> String {    //! S3065 which returns 'Int', but returns 'String'
        return "s"
    }
}

public class OverridesAFinal: Base {
    public override init() { super.init() }

    public override fn sealedAnswer() -> Int {          //! S3044 is 'final'
        return 2
    }
}

public class ThrowsSomethingElse: Base {
    public override init() { super.init() }

    public override fn load() throws(Int) -> Int {      //! S3065 which throws 'String', but throws 'Int'
        return 2
    }

    public override fn quiet() throws(String) -> Int {  //! S3065 which throws nothing
        return 2
    }
}

public class PropertyOfAnotherType: Base {
    public override init() { super.init() }

    public override var size: String { get => "s" }     //! S3065 which is 'Int', but is 'String'

    public override var label: String { get => "x" }    //! S3065 which can be written

    public override var fixed: Int { get => 2 }         //! S3044 is 'final'

    public override var nothing: Int { get => 2 }       //! S3043 no base class declares it
}

public class KeepsTheSignatures: Base {
    public override init() { super.init() }

    public override fn measure(_ x: Int) -> Int {
        return x + 1
    }

    public override fn load() throws(String) -> Int {
        return 2
    }

    public override var size: Int { get => 2 }

    public override var label: String { get => "x" set { } }
}

public final class Leaf { }

public class UnderALeaf: Leaf { }       //! S3044 is final

// Found by the compiler fuzzer (SABLE_FUZZ_SEED=12345): an initialiser
// written without a body, which a subclass's implicit initialiser calls
// through 'super', has nothing to run.
public open class Node {
    var value: Int
    init(value: Int)                    //! S3112 needs a body
}

public class Branch: Node { }

// Found by the compiler fuzzer (seed 1906060343): a subclass's
// initialiser that never builds its superclass's part of the object, or
// builds it on only some paths, left the superclass's fields unset.
public open class Creature {
    var name: String
    init(name: String) { self.name = name }
}

public class Goblin: Creature {
    var rage: Int
    init(position: Int) {               //! S3143 never calls 'super.init'
        (name: "goblin", health: 8, position: position)
        self.rage = 0
    }

    init(angry: Bool) {                 //! S3143 not called on every path
        self.rage = 1
        if angry {
            super.init(name: "angry goblin")
        }
    }

    init(count: Int) {                  //! S3143 not called on every path
        self.rage = 2
        if count > 1 {
            super.init(name: "goblins")
        } else if count == 1 {
            super.init(name: "goblin")
        }
    }

    init(either: Bool) {
        self.rage = 3
        if either {
            super.init(name: "left")
        } else {
            super.init(name: "right")
        }
    }

    convenience init() {
        self.init(either: true)
    }
}

// A superclass made with the implicit 'init()' has it called for an
// initialiser that does not call it; one it declares itself does not.
public open class Defaults {
    var label: String = "default"
}

public class OnDefaults: Defaults {
    var count: Int
    init(count: Int) { self.count = count }
}

public open class Declared {
    var label: String
    init() { self.label = "declared" }
}

public class OnDeclared: Declared {
    var count: Int
    init(count: Int) { self.count = count }     //! S3143 never calls 'super.init'
}
