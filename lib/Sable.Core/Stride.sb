module Sable.Core

/// The values from 'start' towards 'end', 'step' apart, 'end' itself left
/// out: 'stride(from: 0, to: 10, by: 3)' gives 0, 3, 6 and 9. A negative step
/// counts down; a step of zero never gets anywhere, so gives nothing.
public fn stride(from start: Int, to end: Int, by step: Int) -> StrideTo {
    return StrideTo { start: start, end: end, step: step }
}

/// The values from 'start' towards 'end', 'step' apart, 'end' itself
/// included when a step lands on it: 'stride(from: 0, through: 9, by: 3)'
/// gives 0, 3, 6 and 9. A step of zero gives nothing.
public fn stride(from start: Int, through end: Int, by step: Int) -> StrideThrough {
    return StrideThrough { start: start, end: end, step: step }
}

/// What 'stride(from:to:by:)' makes.
public struct StrideTo: Sequence {
    public alias Iter = StrideIterator

    public let start: Int
    public let end: Int
    public let step: Int

    public fn makeIterator() -> StrideIterator {
        return StrideIterator { upcoming: start, end: end, step: step, through: false, done: step == 0 }
    }
}

/// What 'stride(from:through:by:)' makes.
public struct StrideThrough: Sequence {
    public alias Iter = StrideIterator

    public let start: Int
    public let end: Int
    public let step: Int

    public fn makeIterator() -> StrideIterator {
        return StrideIterator { upcoming: start, end: end, step: step, through: true, done: step == 0 }
    }
}

/// Gives a stride's values. It stops before a step would pass the end, so
/// a stride up to 'Int.max' does not overflow.
public struct StrideIterator: Iterator {
    public alias Element = Int

    var upcoming: Int
    let end: Int
    let step: Int
    let through: Bool
    var done: Bool

    public mutating fn next() -> Int? {
        if done {
            return none
        }

        let value = upcoming
        let inside = step > 0
            ? (through ? !(end < value) : value < end)
            : (through ? !(value < end) : end < value)
        if !inside {
            done = true
            return none
        }

        // A next value past Int's bounds is past the end too: the check is
        // made without the addition that would overflow.
        let canStep = step > 0 ? value <= 9223372036854775807 - step : value >= -9223372036854775807 - 1 - step
        if canStep {
            upcoming = value + step
        } else {
            done = true
        }
        return value
    }
}
