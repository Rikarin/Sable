module FloatComponentsTests

// Arrays of vectors as the floats and the bytes they are, and nearEqual.

import Sable.Math.Geometry
import Sable.Testing

/// Says it is three floats and is four.
struct Padded: FloatComponents {
    var x: F32
    var y: F32
    var z: F32
    var w: F32

    static var componentCount: Int => 3

    fn toArray() -> F32[>..] => [x, y, z]
}

@test
fn anArrayOfVectorsIsViewedAsItsFloats() {
    let points = [Vector3(1, 2, 3), Vector3(4, 5, 6)]
    points.withComponents { floats in
        assertEqual(floats.count, 6)
        assertEqual(floats.toArray(), [1, 2, 3, 4, 5, 6])
    }
    assertEqual(points[1..<2].withComponents { $0.toArray() }, [4, 5, 6])
    assertEqual(([] as Vector3[>..]).withComponents { $0.count }, 0)
    assertEqual([Matrix4x4.identity].withComponents { $0.count }, 16)
    assertEqual([Matrix3x2.identity, Matrix3x2.identity].withComponents { $0.count }, 12)
    assertEqual([Plane(Vector3.up, 4)].withComponents { $0.toArray() }, [0, 1, 0, 4])
}

@test
fn anArrayOfVectorsIsViewedAsItsBytes() {
    let bytes = [Vector2(1, -2)].withBytes { $0.toArray() }
    assertEqual(bytes, [0, 0, 0x80, 0x3F, 0, 0, 0, 0xC0])
}

@test
fn itsFloatsAreWrittenWhereTheyLie() {
    var points = [Vector3(1, 2, 3), Vector3(4, 5, 6)]
    let before = points
    points.withMutableComponents { floats in
        var view = floats
        view[4] = 50
    }
    assertEqual(points[1], Vector3(4, 50, 6))
    assertEqual(before[1], Vector3(4, 5, 6))
}

@test
fn aTypeThatIsNotWhatItSaysIsRefused() {
    expectPanic("a FloatComponents type of 3 components that takes 16 bytes") {
        _ = [Padded { x: 1, y: 2, z: 3, w: 4 }].withComponents { $0.count }
    }
}

@test
fn nearEqualIsAbsoluteNearZeroAndRelativeFurtherOut() {
    assert(nearEqual(0 as F32, 0.0000005 as F32))
    assert(!nearEqual(0 as F32, 0.000002 as F32))
    assert(nearEqual(1_000_000 as F32, 1_000_000.5 as F32))
    assert(!nearEqual(1_000_000 as F32, 1_000_002 as F32))
    assert(nearEqual(F32.infinity, F32.infinity) && !nearEqual(F32.infinity, -F32.infinity) && !nearEqual(F32.infinity, 1 as F32))
    assert(!nearEqual(F32.nan, F32.nan))
    assert(nearEqual(1 as F64, 1.0000000000005 as F64) && !nearEqual(1 as F64, 1.00001 as F64))
    assert(nearEqual(F64.infinity, F64.infinity) && !nearEqual(F64.infinity, 1 as F64) && !nearEqual(F64.nan, F64.nan))
}
