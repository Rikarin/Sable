module Sable.Serialize

import Sable.Collections

// Optional, the arrays, Set and Dictionary: an optional as its value or
// null (a missing field reads as none), an array or a set as a sequence, a
// dictionary with String keys as a map.

extension Optional: Serializable where Wrapped: Serializable {
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        if let value = self {
            try value.encode(to: encoder)
        } else {
            try encoder.encodeNull()
        }
    }
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Wrapped? {
        if decoder.isMissing || decoder.isNull {
            return none
        }
        return try Wrapped.decode(from: decoder)
    }
}

extension<Element: Serializable> Element[>..]: Serializable {
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        try encoder.beginSequence(count: self.count)
        for element in self {
            try element.encode(to: encoder)
        }
        try encoder.endSequence()
    }
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Element[>..] {
        var all: Element[>..] = []
        for element in try decoder.decodeSequence() {
            all.append(try Element.decode(from: element))
        }
        return all
    }
}

/// A set as a sequence of its elements, in the set's order; read back, an
/// element that repeats is kept once.
extension Set: Serializable where Element: Serializable {
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        try encoder.beginSequence(count: self.count)
        for element in self {
            try element.encode(to: encoder)
        }
        try encoder.endSequence()
    }
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Set<Element> {
        let elements = try decoder.decodeSequence()
        var all = Set<Element>(minimumCapacity: elements.count)
        for element in elements {
            let _ = all.insert(try Element.decode(from: element))
        }
        return all
    }
}

extension Dictionary: Serializable where Key == String, Value: Serializable {
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        try encoder.beginMap(count: self.count)
        for (key, value) in self {
            try encoder.encodeKey(key)
            try value.encode(to: encoder)
        }
        try encoder.endMap()
    }
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Dictionary<Key, Value> {
        var all = Dictionary<Key, Value>()
        for member in try decoder.decodeMap() {
            all[member.key] = try Value.decode(from: member.value)
        }
        return all
    }
}

extension JsonValue: Serializable {
    /// The value as the JSON it is: an object a map, an array a sequence.
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        match self {
            case .Null              => try encoder.encodeNull()
            case .Bool(let value)   => try encoder.encodeBool(value)
            case .Number(let value) => try encoder.encodeFloat(value)
            case .Text(let value)   => try encoder.encodeString(value)
            case .Array(let items) => {
                try encoder.beginSequence(count: items.count)
                for item in items {
                    try item.encode(to: encoder)
                }
                try encoder.endSequence()
            }
            case .Object(let members) => {
                try encoder.beginMap(count: members.count)
                for member in members {
                    try encoder.encodeKey(member.key)
                    try member.value.encode(to: encoder)
                }
                try encoder.endMap()
            }
        }
    }

    /// Whatever value is there, as a JsonValue: the typed world's way back
    /// to the document, from JSON or any other format.
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> JsonValue {
        let kind = decoder.kind
        if kind == .Missing {
            throw decoder.mismatch("a value")
        }
        if kind == .Null {
            return JsonValue.Null
        }
        if kind == .Bool {
            return JsonValue.Bool(value: try decoder.decodeBool())
        }
        if kind == .Number {
            return JsonValue.Number(value: try decoder.decodeFloat())
        }
        if kind == .String {
            return JsonValue.Text(value: try decoder.decodeString())
        }
        if kind == .Bytes {
            // As JSON has them: an array of numbers.
            var items: JsonValue[>..] = []
            for byte in try decoder.decodeBytes() {
                items.append(JsonValue.Number(value: F64(byte)))
            }
            return JsonValue.Array(items: items)
        }
        if kind == .Sequence {
            var items: JsonValue[>..] = []
            for element in try decoder.decodeSequence() {
                items.append(try JsonValue.decode(from: element))
            }
            return JsonValue.Array(items: items)
        }
        var members: Member[>..] = []
        for member in try decoder.decodeMap() {
            members.append(Member { key: member.key, value: try JsonValue.decode(from: member.value) })
        }
        return JsonValue.Object(members: members)
    }
}
