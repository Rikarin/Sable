module ParsableBytesTests

// Parsing from UTF-8 bytes, and hexadecimal floats through parse
// (Sable.Core).

import Sable.Testing
import Sable.Text

fn bytes(_ text: String) -> U8[>..] {
    return text.utf8Bytes()
}

@test
fn integersAreReadFromTheirBytes() {
    assertEqual(try! Int.parse(utf8: bytes("-42"), radix: 10), -42)
    assertEqual(try! U8.parse(utf8: bytes("0xff"), radix: 16, styles: [.Sign, .Prefix]), 255)
    assertEqual(try! I16.parse(utf8: bytes(" 1_000 "), radix: 10, styles: .Any), 1000)
    assertEqual(try! U64.parse(utf8: bytes("18446744073709551615"), radix: 10), 18446744073709551615)
    assertEqual(try! I8.parse(utf8: bytes("-128"), radix: 10), -128)
    assertEqual(try! I128.parse(utf8: bytes("-170141183460469231731687303715884105728"), radix: 10), I128.min)
    assertEqual(try! Int.parse(utf8: bytes("zz"), radix: 36), 1295)
}

@test(arguments: [
    ("", .Sign, .Empty), ("12a", .Sign, .InvalidDigit(at: 2)), ("é1", .Sign, .InvalidDigit(at: 0)),
    ("1_", .Any, .InvalidDigit(at: 1)), ("+5", .None, .InvalidDigit(at: 0)),
    ("9223372036854775808", .Sign, .Overflow), ("-9223372036854775809", .Sign, .Underflow)
])
fn aByteThatIsNotADigitIsReportedWhereItIs(_ text: String, _ styles: NumberStyles, _ error: ParseError) {
    expectThrows(error) { _ = try Int.parse(utf8: bytes(text), radix: 10, styles: styles) }
}

@test
fn anUnsignedIntegerRefusesANegative() {
    expectThrows(ParseError.Underflow) { _ = try U8.parse(utf8: bytes("-1"), radix: 10) }
    assertEqual(try! U8.parse(utf8: bytes("-0"), radix: 10), 0)
}

@test
fn anyParsableIsReadFromItsBytes() {
    expect(try! Bool.parse(utf8: bytes("true")))
    assertEqual(try! F64.parse(utf8: bytes("1.5")), 1.5)
    assertEqual(try! Int.parse(utf8: bytes("7")), 7)
    assertEqual(try! String.parse(utf8: bytes("héllo")), "héllo")
    let invalid: U8[>..] = [0xFF, 0x31]
    expectThrows(ParseError.Invalid(at: 0)) { _ = try Int.parse(utf8: invalid) }
}

@test
fn aHexadecimalFloatIsParsed() {
    assertEqual(try! F64.parse("0x1.8p1", styles: .HexFloat), 3.0)
    assertEqual(try! F64.parse("0x1p-1074", styles: .HexFloat), 4.9e-324)
    assertEqual(try! F32.parse(" -0x.8 ", styles: [.HexFloat, .Whitespace, .Sign]), -0.5)
    assertEqual(try! F16.parse("0x1p4", styles: .HexFloat), 16.0)
    let value = 0.1
    assertEqual(try! F64.parse(value.toHexString(), styles: [.HexFloat, .Sign]), value)
}

@test(arguments: [
    ("1.5", .HexFloat, .Invalid(at: 0)), ("-0x1p0", .HexFloat, .InvalidDigit(at: 0)), (" ", [.HexFloat, .Whitespace], .Empty)
])
fn whatIsNoHexadecimalFloatIsRefused(_ text: String, _ styles: NumberStyles, _ error: ParseError) {
    expectThrows(error) { _ = try F64.parse(text, styles: styles) }
}

@test
fn bytesAreTheNumberTheirTextIs() {
    forAll { (n: I64, f: F64) in
        expect(try I64.parse(utf8: bytes("\(n)"), radix: 10) == n)
        expect(try I64.parse(utf8: bytes("\(n:x)"), radix: 16) == n)
        if f.isFinite {
            expect((try F64.parse(utf8: bytes("\(f)"))).bits == f.bits)
            expect((try F64.parse(f.toHexString(), styles: [.HexFloat, .Sign])).bits == f.bits)
        }
    }
}
