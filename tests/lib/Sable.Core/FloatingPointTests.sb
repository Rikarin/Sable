module FloatingPointTests

// FloatingPoint (Sable.Core) and its extensions: the IEEE 754 operations,
// classification, rounding, and the edge cases each has at NaN, the
// zeros, the infinities and the subnormals. Each float type's own file
// has its constants. Run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Math
import Sable.Testing

/// Generic, so that each requirement is reached through the protocol.
fn hypotenuse<T: FloatingPoint>(_ a: T, _ b: T) -> T {
    return (a * a + b * b).squareRoot()
}

@test
fn genericCodeComputesAtEachWidth() {
    assertEqual(hypotenuse(3.0, 4.0), 5.0)
    assertEqual(hypotenuse(3.0 as F32, 4.0), 5.0)
    assertEqual(hypotenuse(3.0 as F16, 4.0), 5.0)
}

@test
fn theSquareRootIsCorrectlyRounded() {
    assertEqual((2.0).squareRoot(), 1.4142135623730951)
    assertEqual((2.0 as F32).squareRoot(), 1.4142135)
    expect((-1.0).squareRoot().isNaN, "-1 has no square root")
    assertEqual((-0.0).squareRoot().isSignMinus, true)
}

@test
fn divisionByZeroGivesAnInfinityOrNaN() {
    let zero = 0.0
    assertEqual(1.0 / zero, F64.infinity)
    assertEqual(-1.0 / zero, -F64.infinity)
    expect((zero / zero).isNaN, "0 / 0 is NaN")
}

@test
fn theTwoRemaindersRoundTheQuotientDifferently() {
    assertEqual((7.5).remainder(dividingBy: 2.0), -0.5)
    assertEqual((7.5).truncatingRemainder(dividingBy: 2.0), 1.5)
    assertEqual((-7.5).truncatingRemainder(dividingBy: 2.0), -1.5)
    assertEqual((5.0 as F16).remainder(dividingBy: 2.0), 1.0)
    assertEqual((7.0 as F32).remainder(dividingBy: 2.0), -1.0)
}

@test
fn aFusedMultiplyAddRoundsOnce() {
    assertEqual((2.0).fusedMultiplyAdd(3.0, 1.0), 7.0)
    // 0.1 × 10 - 1 is not 0 exactly, which only the fused form shows.
    expect((0.1).fusedMultiplyAdd(10.0, -1.0) != 0.0, "the product is kept exact")
    assertEqual((1.0).addingProduct(2.0, 3.0), 7.0)
    assertEqual((2.0 as F32).fusedMultiplyAdd(3.0, 1.0), 7.0)
}

@test
fn roundingToIntegersByEachRule() {
    assertEqual((3.7).floor(), 3.0)
    assertEqual((-3.2).floor(), -4.0)
    assertEqual((3.2).ceiling(), 4.0)
    assertEqual((-3.7).truncated(), -3.0)
    assertEqual((2.5).rounded(), 3.0)
    assertEqual((-2.5).rounded(), -3.0)
    assertEqual((2.5).roundedToNearestOrEven(), 2.0)
    assertEqual((3.5).roundedToNearestOrEven(), 4.0)
}

@test(arguments: [
    (2.5, .ToNearestOrAwayFromZero, 3.0), (2.5, .ToNearestOrEven, 2.0), (2.1, .Up, 3.0), (2.9, .Down, 2.0),
    (-2.9, .TowardZero, -2.0), (-2.1, .AwayFromZero, -3.0), (2.1, .AwayFromZero, 3.0)
])
fn roundedTakesARule(_ x: F64, _ rule: RoundingRule, _ rounded: F64) {
    expect(x.rounded(rule) == rounded)
}

@test
fn copySignTakesTheSignAlone() {
    assertEqual((3.0).copySign(-0.0), -3.0)
    assertEqual((-3.0).copySign(1.0), 3.0)
    expect(F64.nan.copySign(-1.0).isSignMinus, "a NaN takes a sign too")
}

@test
fn minimumAndMaximumPropagateNaN() {
    expect((2.0).minimum(F64.nan).isNaN, "NaN wins the minimum")
    expect(F64.nan.maximum(2.0).isNaN, "NaN wins the maximum")
    expect((0.0).minimum(-0.0).isSignMinus, "-0 is below +0")
    expect(!(0.0).maximum(-0.0).isSignMinus, "+0 is above -0")
    assertEqual((1.0).minimum(2.0), 1.0)
}

@test
fn minimumNumberAndMaximumNumberPreferANumber() {
    assertEqual((2.0).minimumNumber(F64.nan), 2.0)
    assertEqual(F64.nan.maximumNumber(2.0), 2.0)
    assertEqual((2.0).min(other: 3.0), 2.0)
    assertEqual((2.0).max(other: F64.nan), 2.0)
}

@test
fn nextUpAndNextDownStepOneValue() {
    assertEqual((1.0).nextUp, 1.0000000000000002)
    assertEqual((1.0).nextDown, 0.9999999999999999)
    assertEqual((0.0).nextUp, F64.leastNonzeroMagnitude)
    assertEqual((-0.0).nextUp, F64.leastNonzeroMagnitude)
    assertEqual((0.0).nextDown, -F64.leastNonzeroMagnitude)
    assertEqual(F64.infinity.nextUp, F64.infinity)
    assertEqual((-F64.infinity).nextUp, -F64.greatestFiniteMagnitude)
    assertEqual(F64.greatestFiniteMagnitude.nextUp, F64.infinity)
    expect(F64.nan.nextUp.isNaN, "NaN stays NaN")
    assertEqual((1.0 as F16).nextUp, 1.001)
}

@test
fn theUlpIsTheGapToTheNextValue() {
    assertEqual((1.0).ulp, F64.epsilon)
    assertEqual((0.0).ulp, F64.leastNonzeroMagnitude)
    assertEqual((-2.0).ulp, F64.epsilon * 2.0)
    assertEqual(F64.greatestFiniteMagnitude.ulp, F64.greatestFiniteMagnitude - F64.greatestFiniteMagnitude.nextDown)
    expect(F64.infinity.ulp.isNaN, "infinity has no ulp")
}

@test(arguments: [
    (12.0, 3), (-0.375, -2), (F64.leastNonzeroMagnitude, -1074), (0.0, Int.min), (F64.infinity, Int.max),
    (F64.nan, Int.max)
])
fn theExponentIsThePowerOfTwoBelowTheValue(_ x: F64, _ exponent: Int) {
    expect(x.exponent == exponent)
}

@test(arguments: [(12.0, 1.5), (-0.375, 1.5), (0.0, 0.0), (-F64.infinity, F64.infinity)])
fn theSignificandIsTheValueOverThatPower(_ x: F64, _ significand: F64) {
    expect(x.significand == significand)
}

@test(arguments: [
    (1.0, 10, 1024.0), (3.0, -1, 1.5), (1.0, 5000, F64.infinity), (1.0, -5000, 0.0),
    (1.0, -1074, F64.leastNonzeroMagnitude)
])
fn scalingByAPowerOfTwoRoundsOnce(_ x: F64, _ power: Int, _ scaled: F64) {
    expect(x.scaled(byPowerOfTwo: power) == scaled)
}

@test
fn anF16IsScaledByAPowerOfTwo() {
    assertEqual((1.0 as F16).scaled(byPowerOfTwo: 15), 32768.0)
}

@test
fn absClearsTheSign() {
    assertEqual((-2.5).abs(), 2.5)
    expect(!(-0.0).abs().isSignMinus, "-0's magnitude is +0")
    assertEqual((-2.5 as F32).abs(), 2.5)
}

@test
fn signumIsOneMinusOneOrTheZeroOrNaN() {
    assertEqual((3.0).signum(), 1.0)
    assertEqual((-3.0).signum(), -1.0)
    expect((-0.0).signum().isSignMinus, "-0 keeps its sign")
    expect(F64.nan.signum().isNaN, "NaN stays NaN")
}

@test
fn lerpGoesTheFractionOfTheWay() {
    assertEqual((10.0).lerp(to: 20.0, by: 0.25), 12.5)
    assertEqual((10.0).lerp(to: 20.0, by: 0.0), 10.0)
    assertEqual((10.0).lerp(to: 20.0, by: 1.0), 20.0)
}

@test
fn anglesConvertBetweenDegreesAndRadians() {
    assertEqual((180.0).toRadians(), F64.pi)
    assertEqual(F64.pi.toDegrees(), 180.0)
    assertEqual((90.0 as F32).toRadians(), F32.pi / 2.0)
}

@test
fn tauIsTwoPi() {
    assertEqual(F64.tau, 6.283185307179586)
    assertEqual(F32.tau, F32.pi * 2.0)
}

@test
fn convertingAnIntGivesTheNearestValue() {
    assertEqual(F64.converting(3), 3.0)
    assertEqual(F32.converting(16777217), 16777216.0)
    assertEqual(F16.converting(-2 as I8), -2.0)
    assertEqual(F16.converting(U64.max), F16.infinity)
    assertEqual(F64.converting(U128.max), 3.402823669209385e38)
    assertEqual(F32.converting(I128.min), -1.7014118e38)
}

@test
fn convertingAnIntegerOfAnySizeRoundsItOnce() {
    // Sable.Math's BigInt: up to 2^128 through its 128 bits, past it
    // through its top 128 with the rest folded into the lowest.
    let top = (1.0).scaled(byPowerOfTwo: 200)
    assertEqual(F64.converting(BigInt(2).pow(1000)), (1.0).scaled(byPowerOfTwo: 1000))
    assertEqual(F64.converting(BigInt(2).pow(200) + BigInt(2).pow(147)), top)
    assertEqual(F64.converting(-(BigInt(2).pow(200) + BigInt(2).pow(147) + BigInt(1))), -(top + (1.0).scaled(byPowerOfTwo: 148)))
    assertEqual(F64.converting(BigInt(2).pow(128) - BigInt(1)), (1.0).scaled(byPowerOfTwo: 128))
    assertEqual(F64.converting(-BigInt(2).pow(127)), -(1.0).scaled(byPowerOfTwo: 127))
    assertEqual(F32.converting(BigInt(2).pow(128)), F32.infinity)
    assertEqual(F64.converting(BigInt(2).pow(5000)), F64.infinity)
}

@test
fn anIntegerIsExactlyAFloatOnlyWhereTheTypeHoldsIt() {
    assertEqual(F32.exactly(16777216) ?? 0.0, 16777216.0)
    expect(F32.exactly(16777217) == none, "2^24 + 1 needs 25 bits")
    assertEqual(F64.exactly(-5 as I8) ?? 0.0, -5.0)
    expect(F16.exactly(U64.max) == none, "an F16 is infinite there")
    expect(F64.exactly(Int.max) == none, "2^63 - 1 needs 63 bits")
    assertEqual(F64.exactly(Int.min) ?? 0.0, -9223372036854775808.0)
}

@test
fn theWideValueIsTheFloatAsAnF64() {
    assertEqual((0.1 as F32).wideValue, 0.10000000149011612)
    assertEqual((1.5 as F16).wideValue, 1.5)
    assertEqual((0.1).wideValue, 0.1)
}

/// Generic, so that 'rounding(wideValue:)' is reached through the protocol.
fn third<T: FloatingPoint>(_ type: T.Type) -> T {
    return T.rounding(wideValue: 1.0 / 3.0)
}

@test
fn roundingAWideValueGivesTheNearestFloat() {
    assertEqual(F64.rounding(wideValue: 0.1), 0.1)
    assertEqual(F32.rounding(wideValue: 0.1), 0.1 as F32)
    assertEqual(F16.rounding(wideValue: 0.1), 0.1 as F16)
    assertEqual(third(F32.self), 0.33333334)
    assertEqual(third(F64.self), 0.3333333333333333)
    assertEqual(F32.rounding(wideValue: 1e300), F32.infinity)
    assertEqual(F16.rounding(wideValue: -1e10), -F16.infinity)
    expect(F32.rounding(wideValue: F64.nan).isNaN, "NaN stays NaN")
    assertEqual(F32.rounding(wideValue: -0.0).isSignMinus, true)
    assertEqual(F32.rounding(wideValue: (0.1 as F32).wideValue), 0.1 as F32)
}

// ---- classification -----------------------------------------------------

@test
fn nanIsTheOneValueNotEqualToItself() {
    expect(F64.nan.isNaN, "NaN is NaN")
    expect(!(1.0).isNaN, "1 is not NaN")
    expect(F16.nan.isNaN && F32.nan.isNaN, "every type has one")
}

@test
fn finiteAndInfiniteAreOpposites() {
    expect(F64.infinity.isInfinite && !F64.infinity.isFinite, "infinity is infinite")
    expect((-F64.infinity).isInfinite, "so is -infinity")
    expect((1.0).isFinite && !(1.0).isInfinite, "1 is finite")
    expect(!F64.nan.isFinite && !F64.nan.isInfinite, "NaN is neither")
}

@test
fn normalAndSubnormalSplitTheFiniteNonZeroValues() {
    expect(F64.leastNormalMagnitude.isNormal, "the least normal value is normal")
    expect(F64.leastNormalMagnitude.nextDown.isSubnormal, "the one below is subnormal")
    expect(!(0.0).isNormal && !(0.0).isSubnormal, "zero is neither")
    expect(!F64.infinity.isNormal, "infinity is not normal")
    expect((-1.0).isNormal, "-1 is normal")
}

@test
fn bothZerosAreZero() {
    expect((0.0).isZero && (-0.0).isZero, "both zeros are zero")
    expect(!F64.leastNonzeroMagnitude.isZero, "the least subnormal is not")
}

@test
fn theSignBitIsSeenOnZerosAndNaNs() {
    expect((-0.0).isSignMinus, "-0 is negative")
    expect(!(0.0).isSignMinus, "+0 is not")
    expect((-F64.nan).isSignMinus, "a negated NaN is negative")
    expect(!F64.nan.isSignMinus, "the quiet NaN is positive")
}

@test
fn integersAreFiniteWithNothingAfterThePoint() {
    expect((3.0).isInteger, "3 is an integer")
    expect((-0.0).isInteger, "-0 is an integer")
    expect(!(3.5).isInteger, "3.5 is not")
    expect(!F64.infinity.isInteger, "infinity is not")
    expect(!F64.nan.isInteger, "NaN is not")
}

@test(arguments: [
    (1.0, .Normal), (F64.leastNonzeroMagnitude, .Subnormal), (-0.0, .Zero), (-F64.infinity, .Infinite),
    (F64.nan, .NaN)
])
fn classificationNamesTheKind(_ x: F64, _ kind: FloatingPointClassification) {
    expect(x.classification == kind)
}

@test(arguments: [
    (-0.0, 0.0, true, "-0 comes before +0"), (0.0, -0.0, false, "+0 comes after -0"),
    (1.0, F64.nan, true, "a positive NaN comes last"),
    (F64.nan, F64.infinity, false, "nothing comes after a positive NaN"),
    (-F64.nan, -F64.infinity, true, "a negative NaN comes first"),
    (1.0, -F64.nan, false, "nothing comes before a negative NaN"), (1.0, 2.0, true, "1 before 2"),
    (2.0, 1.0, false, "2 after 1"), (2.0, 2.0, true, "2 with itself"), (-2.0, -2.0, true, "-2 with itself")
])
fn theTotalOrderOrdersEveryValue(_ a: F64, _ b: F64, _ ordered: Bool, _ why: String) {
    expect(a.isTotallyOrdered(belowOrEqualTo: b) == ordered, why)
}

// ---- text ---------------------------------------------------------------

@test(arguments: [
    (3.14159, 2, "3.14"), (0.125, 2, "0.12"), (0.375, 2, "0.38"), (2.5, 0, "2"),
    (0.1, 20, "0.10000000000000000555"), (-0.0, 1, "-0.0")
])
fn fixedDigitsAreRoundedFromTheExactValue(_ x: F64, _ digits: Int, _ text: String) {
    expect(x.toFixedString(digits) == text)
}

@test
fn anF16sFixedDigitsAreRoundedFromTheExactValue() {
    assertEqual((1.5 as F16).toFixedString(3), "1.500")
}

@test(arguments: [
    (1234.5, 2, "1.23e+03"), (0.125, 1, "1.2e-01"), (0.000125, 1, "1.3e-04"), (9.96, 1, "1.0e+01"),
    (0.0, 0, "0e+00"), (F64.leastNonzeroMagnitude, 3, "4.941e-324"), (1.0e300, 0, "1e+300")
])
fn scientificDigitsAreRoundedFromTheExactValue(_ x: F64, _ digits: Int, _ text: String) {
    expect(x.toScientificString(digits) == text)
}

@test(arguments: [
    (1234.5, 6, "1234.5"), (0.0001, 3, "0.0001"), (0.00001234, 3, "1.23e-05"), (1.0e20, 6, "1e+20"),
    (100.0, 1, "1e+02"), (0.0, 3, "0"), (-2.5, 1, "-2"), (123456789.0, 4, "1.235e+08"), (0.5, 0, "0.5"),
    (F64.nan, 3, "nan")
])
fn generalDigitsAreFixedOrScientificAsCsPercentGIs(_ x: F64, _ digits: Int, _ text: String) {
    expect(x.toGeneralString(digits) == text)
}

@test
fn aValueNotFiniteIsWrittenByName() {
    assertEqual(F64.nan.toFixedString(2), "nan")
    assertEqual(F64.infinity.toScientificString(2), "inf")
    assertEqual((-F32.infinity).toHexString(), "-inf")
}

@test(arguments: [
    (3.0, "0x1.8p+1"), (0.1, "0x1.999999999999ap-4"), (-1.0, "-0x1p+0"),
    (F64.leastNonzeroMagnitude, "0x1p-1074"), (0.0, "0x0p+0"), (-0.0, "-0x0p+0")
])
fn hexadecimalIsExact(_ x: F64, _ text: String) {
    expect(x.toHexString() == text)
}

@test
fn anF32sHexadecimalIsItsOwn() {
    assertEqual((0.1 as F32).toHexString(), "0x1.99999ap-4")
}

@test(arguments: [
    ("0x1.8p1", 3.0), ("0X1.8P+1", 3.0), ("-0x.8", -0.5), ("+0x10", 16.0), ("inf", F64.infinity),
    ("-infinity", -F64.infinity), ("0x0p0", 0.0)
])
fn hexadecimalIsReadAsTheValue(_ text: String, _ value: F64) {
    expect(F64.fromHexString(text) == value)
}

@test
fn hexadecimalReadsBackAsTheValue() {
    assertEqual(F64.fromHexString((0.1).toHexString()) ?? 0.0, 0.1)
    expect((F64.fromHexString("nan") ?? 0.0).isNaN, "nan is read")
}

@test
fn hexadecimalIsRoundedOnceToTheType() {
    assertEqual(F32.fromHexString("0x1.000001p0") ?? 0.0, 1.0)
    assertEqual(F32.fromHexString("0x1.000003p0") ?? 0.0, 1.0000002)
    assertEqual(F32.fromHexString("0x1.0000010000000000000000000000001p0") ?? 0.0, 1.0000001)
    assertEqual(F64.fromHexString("0x1.fffffffffffff8p1023") ?? 0.0, F64.infinity)
    assertEqual(F16.fromHexString("0x1.ffcp15") ?? 0.0, F16.greatestFiniteMagnitude)
}

@test(arguments: [
    ("0x1p-1074", F64.leastNonzeroMagnitude), ("0x1p-1075", 0.0), ("0x1.8p-1075", F64.leastNonzeroMagnitude),
    ("0x1.8p-1074", F64.leastNonzeroMagnitude * 2.0), ("0x1p-2000", 0.0), ("0x1p99999999", F64.infinity)
])
fn hexadecimalBelowTheNormalValuesRoundsToASubnormal(_ text: String, _ value: F64) {
    expect(F64.fromHexString(text) == value)
}

@test(arguments: [
    ("1.5", "no 0x"), ("0x", "no digits"), ("0x.", "a point is no digit"), ("0x1g", "g is no digit"),
    ("0x1p", "no power after p"), ("0x1pz", "z is no power"), ("", "nothing")
])
fn whatIsNotHexadecimalIsNone(_ text: String, _ why: String) {
    expect(F64.fromHexString(text) == none, why)
}
