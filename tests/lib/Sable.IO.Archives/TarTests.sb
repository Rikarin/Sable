module TarTests

// Tar archives: what is written is read, in every format and through the tar
// command; every kind of header; what is damaged; and what would leave the
// directory it is extracted to.

import ArchiveData
import Sable.IO
import Sable.IO.Archives
import Sable.IO.Compression
import Sable.Testing
import Sable.Time

fn archive(_ format: TarFormat = .Pax, _ fill: (TarWriter<MemoryStream>) throws(IoError) -> ()) -> U8[>..] {
    let writer = TarWriter(MemoryStream(), format: format)
    try! fill(writer)
    try! writer.finish()
    return writer.inner.bytes
}

fn entries(_ bytes: U8[>..]) throws(IoError) -> (TarEntry, U8[>..])[>..] {
    var reader = TarReader(MemoryStream(bytes))
    var all: (TarEntry, U8[>..])[>..] = []
    while let entry = try reader.next() {
        all.append((entry, try reader.readToEnd()))
    }
    return all
}

let formats: TarFormat[>..] = [.Pax, .Ustar, .Gnu]

@test(arguments: formats)
fn entriesAreWrittenAndRead(_ format: TarFormat) throws {
    let made = archive(format) { writer throws(IoError) in
        var file = TarEntry("a/b.txt")
        file.mode = 0o640
        file.userId = 501
        file.groupId = 20
        file.userName = "someone"
        file.groupName = "staff"
        file.modified = UtcDateTime.fromUnix(1_700_000_000)
        try writer.add(file, bytes(1000))
        try writer.add(TarEntry("d", kind: .Directory))
        var link = TarEntry("link", kind: .Symlink)
        link.linkTarget = "a/b.txt"
        try writer.add(link)
        var hard = TarEntry("hard", kind: .HardLink)
        hard.linkTarget = "a/b.txt"
        try writer.add(hard)
        var device = TarEntry("null", kind: .CharacterDevice)
        device.deviceMajor = 1
        device.deviceMinor = 3
        try writer.add(device)
        try writer.add(TarEntry("pipe", kind: .Fifo))
        try writer.begin(TarEntry("parts", size: 1500))
        try writer.write(bytes(1500)[..<700])
        try writer.write(bytes(1500)[700...])
        try writer.add(TarEntry("none"))
        try writer.add(TarEntry("whole"), bytes(512))
    }
    expect(made.count % 10240 == 0)
    let read = try entries(made)
    require(read.map { $0.0.name } == ["a/b.txt", "d/", "link", "hard", "null", "pipe", "parts", "none", "whole"])
    let file = read[0].0
    expect(file.kind == .File && file.size == 1000 && file.mode == 0o640 && file.userId == 501 && file.groupId == 20)
    expect(file.userName == "someone" && file.groupName == "staff" && file.modified == UtcDateTime.fromUnix(1_700_000_000))
    expect(read[0].1 == bytes(1000) && read[1].0.kind == .Directory && read[1].0.mode == 0o755)
    expect(read[2].0.kind == .Symlink && read[2].0.linkTarget == "a/b.txt")
    expect(read[3].0.kind == .HardLink && read[3].0.linkTarget == "a/b.txt")
    expect(read[4].0.kind == .CharacterDevice && read[4].0.deviceMajor == 1 && read[4].0.deviceMinor == 3)
    expect(read[5].0.kind == .Fifo && read[6].1 == bytes(1500) && read[7].1.isEmpty && read[8].1 == bytes(512))
}

@test
fn whatDoesNotFitUstarIsSaidOtherwise() throws {
    let long = "0123456789".repeated(30)
    var file = TarEntry("\(long)/\u{2603}")
    file.userId = 3_000_000
    file.groupId = 1 << 40
    file.userName = "\u{E9}"
    file.groupName = "g".repeated(40)
    file.modified = UtcDateTime { secondsSinceEpoch: 1_700_000_000, nanosecond: 123_456_789 }
    file.attributes = ["comment": "a note", "SCHILY.xattr.user.x": "y=z\n"]
    var link = TarEntry("link", kind: .Symlink)
    link.linkTarget = long
    link.modified = UtcDateTime { secondsSinceEpoch: -2, nanosecond: 500_000_000 }
    let pax = try entries(archive { writer throws(IoError) in
        try writer.add(file, [1, 2])
        try writer.add(link)
        try writer.add(TarEntry("after"), [3])
    })
    expect(pax[0].0.name == file.name && pax[0].0.userId == 3_000_000 && pax[0].0.groupId == 1 << 40)
    expect(pax[0].0.userName == "\u{E9}" && pax[0].0.groupName == file.groupName && pax[0].0.modified == file.modified)
    expect(pax[0].0.attributes["comment"] == "a note" && pax[0].0.attributes["SCHILY.xattr.user.x"] == "y=z\n")
    expect(pax[0].1 == [1, 2] && pax[1].0.linkTarget == long && pax[1].0.modified == link.modified)
    expect(pax[2].0.name == "after" && pax[2].0.attributes.isEmpty && pax[2].1 == [3])

    let gnu = try entries(archive(.Gnu) { writer throws(IoError) in
        try writer.add(file, [1, 2])
        try writer.add(link)
        try writer.add(TarEntry("after"), [3])
    })
    expect(gnu[0].0.name == file.name && gnu[0].0.userId == 3_000_000 && gnu[0].0.groupId == 1 << 40)
    expect(gnu[0].0.modified == UtcDateTime.fromUnix(1_700_000_000) && gnu[1].0.linkTarget == long)
    expect(gnu[1].0.modified == UtcDateTime.fromUnix(-2) && gnu[2].0.name == "after")

    let ustar = TarWriter(MemoryStream(), format: .Ustar)
    expect(problem { try ustar.add(file, [1]) }.hasSuffix("in a ustar archive, which has no room for it' is not supported here"))
    // A name that ustar has in two parts.
    let half = "\("d".repeated(120))/\("f".repeated(90))"
    try ustar.add(TarEntry(half), [7])
    try ustar.finish()
    let split = try entries(ustar.inner.bytes)
    expect(split[0].0.name == half && split[0].1 == [7])
    expect(problem { try ustar.add(TarEntry("")) }.hasSuffix("was given something the system does not take"))
}

/// A header's checksum put right.
fn summed(_ block: U8[>..], at start: Int = 0) -> U8[>..] {
    var fixed = block
    var sum = 0
    var i = 0
    while i < 512 {
        sum += i >= 148 && i < 156 ? 0x20 : Int(fixed[start + i])
        i += 1
    }
    i = 5
    while i >= 0 {
        fixed[start + 148 + i] = 0x30 + U8(sum & 7)
        sum = sum >> 3
        i -= 1
    }
    fixed[start + 154] = 0
    fixed[start + 155] = 0x20
    return fixed
}

@test
fn oldHeadersAreRead() throws {
    var old = archive(.Ustar) { writer throws(IoError) in try writer.add(TarEntry("d/x"), [1, 2, 3]) }
    // Before ustar: no magic, and no kind.
    var i = 156
    old[156] = 0
    i = 257
    while i < 512 {
        old[i] = 0
        i += 1
    }
    expect((try entries(summed(old)))[0].1 == [1, 2, 3])
    // A directory by its name alone, and spaces before a number.
    old[2] = 0
    old[124] = 0x20
    old[134] = 0x30
    old = summed(old)
    expect((try entries(old[..<512].toArray()))[0].0.kind == .Directory)
    // A sum as if bytes had signs.
    var signed = archive(.Ustar) { writer throws(IoError) in try writer.add(TarEntry("\u{E9}x"), [1]) }
    var sum = 0
    i = 0
    while i < 512 {
        let byte = i >= 148 && i < 156 ? 0x20 : Int(signed[i])
        sum += byte >= 128 ? byte - 256 : byte
        i += 1
    }
    i = 5
    while i >= 0 {
        signed[148 + i] = 0x30 + U8(sum & 7)
        sum = sum >> 3
        i -= 1
    }
    expect((try entries(signed))[0].0.name == "\u{E9}x")
    // The archive that ends with no zeros, and one with none but them.
    let bare = archive { writer throws(IoError) in try writer.add(TarEntry("x"), [1]) }
    expect((try entries(bare[..<1024].toArray())).count == 1)
    expect((try entries([])).isEmpty && (try entries(U8[>..](repeating: 0, count: 1024))).isEmpty)
    // A global record, which is of every entry after it.
    var global = archive { writer throws(IoError) in
        var entry = TarEntry("first")
        entry.attributes = ["comment": "all"]
        try writer.add(entry)
        try writer.add(TarEntry("second"))
    }
    global[156] = 0x67
    let both = try entries(summed(global))
    expect(both[0].0.attributes["comment"] == "all" && both[1].0.attributes["comment"] == "all")
}

@test
fn whatIsDamagedIsRefused() {
    let good = archive { writer throws(IoError) in try writer.add(TarEntry("x"), bytes(600)) }
    var changed = good
    changed[0] = 0x79
    expectThrows(saying: "the tar archive is corrupt: a header's checksum is wrong") { _ = try entries(changed) }
    expectThrows(saying: "the stream ended before what was needed") { _ = try entries(good[..<700].toArray()) }
    expectThrows(saying: "the stream ended before what was needed") { _ = try entries(good[..<300].toArray()) }
    expectThrows(saying: "the stream ended before what was needed") { _ = try entries(good[..<1300].toArray()) }
    changed = good
    changed[125] = 0x39
    expectThrows(saying: "the tar archive is corrupt: a number has something else in it") { _ = try entries(summed(changed)) }
    changed = good
    var i = 124
    while i < 136 {
        changed[i] = 0xFF
        i += 1
    }
    expectThrows(saying: "the tar archive is corrupt: an entry of less than no bytes") { _ = try entries(summed(changed)) }
    changed[124] = 0x8F
    expectThrows(saying: "the tar archive is corrupt: a number is larger than there are") { _ = try entries(summed(changed)) }
}

@test
fn sparseFilesAreRefused() {
    let good = archive { writer throws(IoError) in try writer.add(TarEntry("x"), bytes(600)) }
    var changed = good
    // Both ways.
    changed[156] = 0x53
    expectThrows(saying: "'a sparse file in a tar archive' is not supported here") { _ = try entries(summed(changed)) }
    let sparse = archive { writer throws(IoError) in
        var entry = TarEntry("x")
        entry.attributes = ["GNU.sparse.major": "1"]
        try writer.add(entry)
    }
    expectThrows(saying: "'a sparse file in a tar archive' is not supported here") { _ = try entries(sparse) }
}

@test
fn aHeaderOfMoreThanAMegabyteIsRefused() {
    let long = archive { writer throws(IoError) in
        var entry = TarEntry("x")
        entry.attributes = ["comment": "x".repeated(1 << 20)]
        try writer.add(entry)
    }
    expectThrows(saying: "the tar archive is corrupt: a header of more than a megabyte") { _ = try entries(long) }
}

@test(arguments: [("11 mtime=1", "99 mtime=1"), ("11 mtime=1", "x1 mtime=1"), ("mtime=1", "mtime+1"), ("11 mtime=1", "11 =time=1"), ("mtime=1", "mtime=x"), ("9 size=0", "9 size=-")])
fn whatIsNoRecordIsRefused(_ from: String, _ to: String) {
    let record = archive { writer throws(IoError) in
        var entry = TarEntry("x")
        entry.attributes = ["mtime": "1", "size": "0"]
        try writer.add(entry)
    }
    var changed = record
    let wanted = from.utf8Bytes()
    let made = to.utf8Bytes()
    for i in 0..<1024 {
        if changed[i..<i + wanted.count].toArray() == wanted {
            for j in 0..<made.count {
                changed[i + j] = made[j]
            }
        }
    }
    let said = problem { try entries(changed) }
    expect(said.hasPrefix("the tar archive is corrupt: "), said)
}

@test(arguments: [("1.5", 1, 500_000_000), ("-1.25", -2, 750_000_000), ("7", 7, 0), ("3.1234567891", 3, 123_456_789)])
fn aTimeMayHaveAnyFraction(_ text: String, _ seconds: Int, _ nanoseconds: Int) throws {
    let made = archive { writer throws(IoError) in
        var entry = TarEntry("x")
        entry.attributes = ["mtime": text]
        try writer.add(entry)
    }
    expect(try entries(made)[0].0.modified == UtcDateTime { secondsSinceEpoch: seconds, nanosecond: nanoseconds })
}

@test
fn zerosPadTheRecords() throws {
    var made = archive { writer throws(IoError) in
        try writer.add(TarEntry("n".repeated(150)), bytes(3))
        try writer.add(TarEntry("d", kind: .Directory))
    }
    // The records of the first entry, whose name is too long for its header.
    expect(try entries(made)[0].0.name == "n".repeated(150))
    made[512] = 0
    let read = try entries(made)
    expect(read.count == 2)
    expect(read[0].0.name != "n".repeated(150))
}

@test
fn damageIsNeverMoreThanAnError() {
    let good = archive { writer throws(IoError) in
        var entry = TarEntry("n".repeated(150))
        entry.attributes = ["comment": "x", "atime": "12.5"]
        entry.modified = UtcDateTime { secondsSinceEpoch: 5, nanosecond: 5 }
        try writer.add(entry, bytes(300))
        try writer.add(TarEntry("d", kind: .Directory))
    }
    let start = good[..<3584].toArray()
    forAll(byteChanges, cases: 3000) { (changes: (Int, U8)[>..]) in
        var changed = start
        for (at, byte) in changes {
            changed[at % 3584] = byte
        }
        // Each header's sum put right, so that what is past it is looked at.
        for at in [0, 1024, 2048] {
            changed = summed(changed, at: at)
        }
        _ = try? entries(changed)
    }
}

@test
fn directoriesAreArchivedAndExtracted(temp: TemporaryFiles) throws {
    try makeTree(temp.path.appending("in"))
    for name in ["a.tar", "a.tar.zst"] {
        try Tar.create(temp.path.appending(name), from: temp.path.appending("in"))
        try Tar.extract(temp.path.appending(name), to: temp.path.appending("out-\(name)"))
        expect(try isTree(temp.path.appending("out-\(name)")), name)
    }
    let before = (try File.metadata(temp.path.appending("in/sub"))).modified
    expect((try File.metadata(temp.path.appending("out-a.tar/sub"))).modified == before)
    let small = (try File.metadata(temp.path.appending("a.tar.zst"))).size
    expect(small < (try File.metadata(temp.path.appending("a.tar"))).size / 2)
    try Tar.create(temp.path.appending("g.tar"), from: temp.path.appending("in"), format: .Gnu)
    try Tar.extract(temp.path.appending("g.tar"), to: temp.path.appending("g"))
    expect(try isTree(temp.path.appending("g")))
}

@test
fn nothingIsWrittenOutside(temp: TemporaryFiles) throws {
    try Directory.create(temp.path.appending("secret"))
    try File.write(temp.path.appending("secret/file"), "secret")
    let here = temp.path.appending("out")
    fn extracting(_ fill: (TarWriter<MemoryStream>) throws(IoError) -> ()) -> String {
        let made = archive(.Pax, fill)
        return problem { try Tar.extract(reading: MemoryStream(made), to: here) }
    }
    for name in ["../up", "a/../../up", "/root", "a\\..\\..\\up", "C:x"] {
        let said = extracting { writer throws(IoError) in try writer.add(TarEntry(name), [1]) }
        require(said.contains("leads out of the directory"), "\(name): \(said)")
    }
    fn entry(_ name: String, _ kind: TarEntryKind, _ target: String) -> TarEntry {
        var made = TarEntry(name, kind: kind)
        made.linkTarget = target
        return made
    }
    // Links out, by a link or by a name; and a file through one.
    expect(extracting { writer throws(IoError) in try writer.add(entry("link", .Symlink, "../secret")) }.hasPrefix("a link, 'link', leads to"))
    expect(extracting { writer throws(IoError) in try writer.add(entry("hard", .HardLink, "../secret/file")) }.contains("leads out of the directory"))
    let through = extracting { writer throws(IoError) in
        try writer.add(TarEntry("real", kind: .Directory))
        try writer.add(entry("way", .Symlink, "real"))
        try writer.add(TarEntry("way/file"), [1])
    }
    expect(through == "'way' is in the way of an entry: it is no directory, or a link")
    // A hard link of a link, or of what is not there.
    let linked = extracting { writer throws(IoError) in
        try writer.add(entry("other", .Symlink, "real"))
        try writer.add(entry("hard", .HardLink, "other"))
    }
    expect(linked == "'hard' is another name for 'other', which is no file")
    // One of a file that is, which then has both names.
    let good = extracting { writer throws(IoError) in
        try writer.add(TarEntry("./"))
        try writer.add(TarEntry("one"), [1])
    }
    expect(good.contains("leads out of the directory"))
    let named = extracting { writer throws(IoError) in
        try writer.add(TarEntry(".", kind: .Directory))
        try writer.add(TarEntry("pipe", kind: .Fifo))
        try writer.add(TarEntry("one"), [1])
        try writer.add(entry("two", .HardLink, "one"))
    }
    expect(named == "nothing" && (try File.readBytes(here.appending("two"))) == [1] && !File.exists(here.appending("pipe")))
    expect((try Directory.list(temp.path)) == ["out", "secret"])
    expect((try File.read(temp.path.appending("secret/file"))) == "secret")
}

@test(arguments: ["a.tar.gz", "a.tgz", "a.tar.br"])
fn theNameSaysHowAnArchiveIsCompressed(_ name: String) throws {
    let temp = try Temp.directory()
    try makeTree(temp.path.appending("in"))
    try Tar.create(temp.path.appending(name), from: temp.path.appending("in"))
    try Tar.extract(temp.path.appending(name), to: temp.path.appending("out"))
    expect(try isTree(temp.path.appending("out")))
}

@test
fn limitsAreKept(temp: TemporaryFiles) throws {
    let made = archive { writer throws(IoError) in
        try writer.add(TarEntry("zeros"), U8[>..](repeating: 0, count: 5_000_000))
    }
    var options = ExtractOptions()
    options.limits.maximumTotal = 4_000_000
    expectThrows(saying: "the archive has more bytes than the limits allow") { _ = try Tar.extract(reading: MemoryStream(made), to: temp.path, options: options) }
    // Compressed, a decoder's limits hold too.
    let packed = Gzip.compress(made)
    let reader = GzipReader(MemoryStream(packed), decoder: GzipDecoder(limits: DecompressionLimits(maximumRatio: 100)))
    expectThrows(saying: "more would be decompressed than the limits allow") { _ = try Tar.extract(reading: reader, to: temp.path.appending("x")) }
}

@test
fn theAsyncOnesToo() async throws {
    let pipe = Pipe(pauseWriterThreshold: 1 << 20)
    let writer = AsyncTarWriter(pipe.writer)
    var entry = TarEntry("x".repeated(300))
    entry.attributes = ["comment": "y"]
    try await writer.add(entry, bytes(1000))
    try await writer.add(TarEntry("d", kind: .Directory))
    try await writer.begin(TarEntry("parts", size: 10))
    try await writer.write(bytes(10)[..<4])
    try await writer.write(bytes(10)[4...])
    try await writer.add(TarEntry("skipped"), bytes(3000))
    try await writer.add(TarEntry("last"), [1])
    try await writer.finish()
    await pipe.writer.complete()
    let reader = AsyncTarReader(pipe.reader)
    let first = try await reader.next()
    expect(first?.name == entry.name && first!.attributes["comment"] == "y")
    var all: U8[>..] = []
    while true {
        let part = try await reader.read(upTo: 100)
        if part.isEmpty {
            break
        }
        all.append(contentsOf: part)
    }
    expect(all == bytes(1000))
    expect((try await reader.next())?.kind == .Directory)
    expect((try await reader.next())?.size == 10)
    expect((try await reader.next())?.name == "skipped")
    expect((try await reader.next())?.name == "last")
    expect((try await reader.next()) == none)
    expect((try await reader.next()) == none)
}

@test
fn theAsyncOnesHaveGnusFormatToo() async throws {
    let other = Pipe(pauseWriterThreshold: 1 << 20)
    let gnu = AsyncTarWriter(other.writer, format: .Gnu)
    var link = TarEntry("x".repeated(300), kind: .Symlink)
    link.linkTarget = "y".repeated(300)
    try await gnu.add(link)
    await other.writer.complete()
    let back = try await AsyncTarReader(other.reader).next()
    expect(back?.name == link.name)
    expect(back?.linkTarget == link.linkTarget)
}

@test
fn theAsyncReaderSaysWhatIsWrong() async throws {
    let cut = Pipe()
    try await cut.writer.write(bytes(100))
    await cut.writer.complete()
    await expectThrows(saying: "the stream ended before what was needed") { _ = try await AsyncTarReader(cut.reader).next() }
}

@test
fn tarAgrees(temp: TemporaryFiles) async throws {
    try makeTree(temp.path.appending("in"))
    let has = await run("tar", ["--version"], in: temp.path) != none
    try skip(if: !has, "there is no tar command")
    for format in [TarFormat.Pax, TarFormat.Gnu] {
        try Tar.create(temp.path.appending("ours.tar"), from: temp.path.appending("in"), format: format)
        let directory = "theirs-\(format)"
        try Directory.create(temp.path.appending(directory))
        expect(await run("tar", ["-xf", "ours.tar", "-C", directory], in: temp.path) != none)
        expect(try isTree(temp.path.appending(directory)), "\(format)")
    }
    for format in ["pax", "gnutar"] {
        let made = await run("tar", ["-cf", "theirs.tar", "--format", format, "-C", "in", "."], in: temp.path)
        if made == none {
            continue
        }
        try Tar.extract(temp.path.appending("theirs.tar"), to: temp.path.appending("out-\(format)"))
        expect(try isTree(temp.path.appending("out-\(format)")), format)
    }
    expect(await run("tar", ["-czf", "theirs.tgz", "-C", "in", "."], in: temp.path) != none)
    try Tar.extract(temp.path.appending("theirs.tgz"), to: temp.path.appending("z"))
    expect(try isTree(temp.path.appending("z")))
}
