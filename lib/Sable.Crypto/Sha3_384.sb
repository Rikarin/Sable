module Sable.Crypto

/// SHA3-384, FIPS 202: a 48-byte digest, of Keccak, which shares nothing
/// with SHA-2. Worked out by the processor's own instructions where it has
/// them.
///
/// ```sable
/// assert("\(Sha3_384.hash(utf8: "abc"))" == "ec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b298d88cea927ac7f539f1edf228376d25")
/// ```
public struct Sha3_384: HashFunction {
    var sponge: Sponge

    public init() {
        sponge = Sponge(rate: 104, suffix: 0x06)
    }

    public static var digestByteCount: Int => 48

    public static var blockByteCount: Int => 104

    public mutating fn update(_ bytes: U8[:]) {
        sponge.update(bytes)
    }

    public fn finalize() -> Digest {
        return Digest(sponge.output(count: 48))
    }
}
