module Sable.Configuration

import Sable.IO
import Sable.Serialize

/// A developer's secrets for a program, kept outside its repository so that
/// none is committed: a JSON file of keys and values, `secrets.json`, in a
/// folder of the program's id under the user's settings —
/// `~/.config/Sable/UserSecrets/<id>` on Linux, `~/Library/Application
/// Support/Sable/UserSecrets/<id>` on macOS, `%APPDATA%\Sable\UserSecrets\<id>`
/// on Windows. .NET's user secrets. As a provider, every value it gives is a
/// secret (`isSecret`), and the file may be missing.
///
/// ```sable
/// let folder = try! Temp.directory()
/// let secrets = UserSecrets(id: "shop", folder: folder.path)
/// try! secrets.set("Database:Password", "hunter2")
/// var builder = ConfigurationBuilder()
/// builder.add(secrets)
/// let configuration = try! await builder.build()
/// assert(configuration.value("Database:Password") == "hunter2")
/// assert(configuration.debugView() == "Database:Password = [redacted] (user secrets shop)\n")
/// ```
public struct UserSecrets: ConfigurationProvider {
    /// The program's id: a folder's name.
    public let id: String
    /// The file they are kept in.
    public let path: FilePath

    /// The secrets of the id, in the folder given, else under the user's
    /// settings. An id is a folder's name, as .NET's `UserSecretsId` is: a
    /// GUID, or the program's name.
    public init(id: String, folder: FilePath? = none) {
        self.id = id
        path = (folder ?? UserSecrets.folder).appending(id).appending("secrets.json")
    }

    /// Where every program's secrets are kept, by the system's rules: in
    /// the temporary directory where the user has no home.
    public static var folder: FilePath {
        get {
            let settings = Environment.knownFolder(.Config) ?? Environment.temporaryDirectory
            return settings.appending("Sable").appending("UserSecrets")
        }
    }

    /// "user secrets", and the id.
    public var name: String => "user secrets \(id)"

    /// True: none of its values is to be printed.
    public var isSecret: Bool => true

    public fn load() async throws(ConfigurationError) -> ConfigurationValues {
        return try read()
    }

    fn read() throws(ConfigurationError) -> ConfigurationValues {
        return try FileConfigurationProvider(path, format: .Json, optional: true).readNow()
    }

    /// The key given the value in the file, which is made if it is not there.
    public fn set(_ key: String, _ value: String) throws(ConfigurationError) {
        var values = try read()
        values.set(key, value)
        try write(values)
    }

    /// The key taken out of the file.
    public fn remove(_ key: String) throws(ConfigurationError) {
        var values = try read()
        values.remove(key)
        try write(values)
    }

    fn write(_ values: ConfigurationValues) throws(ConfigurationError) {
        var json = JsonWriter(options: pretty(2))
        json.writeBeginObject()
        for (_, entry) in values.entries {
            json.writeKey(entry.0)
            json.writeString(entry.1)
        }
        json.writeEndObject()
        do {
            try Directory.create(path.removingLastComponent(), recursive: true)
            try File.write(path, json.toString() + "\n")
        } catch {
            throw ConfigurationError.Unreadable(source: name, reason: error.description())
        }
    }
}
