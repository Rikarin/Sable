module Negative.RangePlaces

// A range of an array's elements is a place, as an element is (#301), and
// either is one only where the array is: not a 'let' array's, nor one a
// call gives, whose change would be made to a copy and dropped.

fn sortAll(_ s: inout Int[:]) { s.sort() }

fn bump(_ x: inout Int) { x += 1 }

fn make() -> Int[>..] { return [1, 2, 3] }

fn notPlaces() {
    let kept: Int[>..] = [3, 2, 1]
    sortAll(&kept[0..<2]) //! S3010 an 'inout' argument is written by the call, so it must be a mutable binding
    sortAll(&kept[^2...]) //! S3010 an 'inout' argument is written by the call, so it must be a mutable binding
    bump(&kept[0]) //! S3010 an 'inout' argument is written by the call, so it must be a mutable binding
    kept[0] = 4 //! S3010 the left side of an assignment must be a mutable binding
    kept[0..<2] = [5, 6] //! S3010 the left side of an assignment must be a mutable binding
    kept[1...].sort() //! S3041 'sort' is mutating, so it needs a value it can change
    sortAll(&make()[0..<2]) //! S3010 an 'inout' argument is written by the call, so it must be a mutable binding
    bump(&make()[0]) //! S3010 an 'inout' argument is written by the call, so it must be a mutable binding
    let fixed: Int[] = [1, 2]
    fixed[0..<1] = [3] //! S3010 the left side of an assignment must be a mutable binding
}

fn places(_ slice: inout Int[:]) {
    var grow: Int[>..] = [3, 2, 1]
    sortAll(&grow[0..<2])
    sortAll(&grow[^2...])
    grow[1...].sort()
    var fixed: Int[] = [1, 2]
    fixed[0..<1] = [3]
    sortAll(&slice[1..<^1])
    slice[0..<1] = [4]
}
