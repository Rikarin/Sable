fn isGood(_ leaf: String, _ root: String, _ profile: CertificateProfile, host: String? = "a.example.com") -> Bool {
    var verifier = CertificateVerifier(roots: TrustStore([try! Certificate.parse(pem: root)]))
    verifier.profile = profile
    let time = UtcDateTime.of(year: 2026, month: 6, day: 1, hour: 0, minute: 0, second: 0)!
    return (try? verifier.verify(try! Certificate.parse(pem: leaf), host: host, at: time)) != none
}

// The least a path is refused by.
fn check(_ leaf: String, _ root: String, _ refused: CertificateProfile?, host: String? = "a.example.com") {
    expect(isGood(leaf, root, .Compatible, host: host))
    expect(isGood(leaf, root, .Rfc5280, host: host) == (refused != .Rfc5280))
    expect(isGood(leaf, root, .WebPki, host: host) == (refused == none))
}

@test
fn aGoodPathIsGoodByEveryProfile() {
    check(leafGood, rootGood, none)
}

/// A path that breaks a rule, and the least profile that refuses it: what a
/// test's case is called is the rule.
struct Broken: Debug {
    let rule: String
    let leaf: String
    let root: String
    let refused: CertificateProfile
    var host: String? = "a.example.com"

    fn debugDescription() -> String => rule
}

let brokenPaths: Broken[>..] = [
    Broken(rule: "a root's authority identifier has an issuer", leaf: leafAki, root: rootAki, refused: .WebPki),
    Broken(rule: "a root's constraints are not critical", leaf: leafSoft, root: rootSoft, refused: .Rfc5280),
    Broken(rule: "a root has no identifier", leaf: leafNoSki, root: rootNoSki, refused: .Rfc5280),
    Broken(rule: "an identifier is critical", leaf: leafSkiCrit, root: rootGood, refused: .Rfc5280),
    Broken(rule: "the names of no subject are not critical", leaf: leafSanSoft, root: rootGood, refused: .Rfc5280),
    Broken(rule: "there are no names", leaf: leafNoSan, root: rootGood, refused: .WebPki, host: none),
    Broken(rule: "the purposes are critical", leaf: leafEkuCrit, root: rootGood, refused: .WebPki),
    Broken(rule: "the names of a subject are critical", leaf: leafSanCrit, root: rootGood, refused: .WebPki),
]

@test(arguments: brokenPaths)
fn eachRuleIsItsProfiles(_ path: Broken) {
    check(path.leaf, path.root, path.refused, host: path.host)
}

// Policies that are constrained are not processed, so a critical
// extension that does is refused; one that is not critical is wrong.
@test
fn constrainedPoliciesAreRefused() {
    expect(!isGood(leafPc, rootGood, .Rfc5280))
}

@test
fn anAuthoritysIdentifierIsRead() {
    let root = try! Certificate.parse(pem: rootAki)
    let identifier = require(root.authorityKeyIdentifier)
    expect(identifier.keyIdentifier == root.subjectKeyIdentifier && identifier.serialNumber == root.serialNumber)
    expect(identifier.issuer! == [.Directory(root.subject)])
    expect(AuthorityKeyIdentifier(keyIdentifier: [1]) == AuthorityKeyIdentifier(keyIdentifier: [1]) && AuthorityKeyIdentifier(keyIdentifier: [1]) != identifier)
    expect(AuthorityKeyIdentifier(keyIdentifier: [1]).debugDescription().contains("keyIdentifier"))
}

@test
fn valuesAreComparedAndDescribed() {
    let one = RevokedCertificate(serialNumber: [1], date: UtcDateTime.fromUnix(0), reason: 1)
    expect(one == RevokedCertificate(serialNumber: [1], date: UtcDateTime.fromUnix(0), reason: 1) && one != RevokedCertificate(serialNumber: [1], date: UtcDateTime.fromUnix(0)))
    expect(one.debugDescription().contains("reason"))
    expect(BasicConstraints(isAuthority: true).debugDescription().contains("isAuthority"))
    expect(NameConstraints(permitted: [], excluded: [.Dns("a")]).debugDescription().contains("excluded"))
    expect(SignatureAlgorithm.Ed25519.debugDescription().contains("Ed25519"))
    expect(CertificateProfile.WebPki.debugDescription().contains("WebPki"))
}
