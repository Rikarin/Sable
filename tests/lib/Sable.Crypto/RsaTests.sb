static let key: RsaPrivateKey = try! RsaPrivateKey.parse(pem: opensslKey)

@test
fn opensslsSignaturesAreMadeAndValid() {
    let pkcs1 = hex("")
    expect(key.sign(text("a message"), padding: .Pkcs1(.Sha256)) == pkcs1)
    expect(key.publicKey.isValid(pkcs1, for: text("a message"), padding: .Pkcs1(.Sha256)))
    expect(!key.publicKey.isValid(pkcs1, for: text("another"), padding: .Pkcs1(.Sha256)))
    expect(!key.publicKey.isValid(pkcs1, for: text("a message"), padding: .Pkcs1(.Sha512)))
    expect(!key.publicKey.isValid(pkcs1, for: text("a message"), padding: .Pss(.Sha256)))
    let pss = hex("")
    expect(key.publicKey.isValid(pss, for: text("a message"), padding: .Pss(.Sha256)))
    expect(key.publicKey.isValid(pss, for: text("a message"), padding: .PssParameters(.Sha256, maskHash: .Sha256, saltByteCount: 32)))
    expect(!key.publicKey.isValid(pss, for: text("a message"), padding: .PssParameters(.Sha256, maskHash: .Sha256, saltByteCount: 31)))
    expect(!key.publicKey.isValid(pss, for: text("another"), padding: .Pss(.Sha256)))
    expect(!key.publicKey.isValid(pss, for: text("a message"), padding: .Pkcs1(.Sha256)))
    let mixed = hex("")
    expect(key.publicKey.isValid(mixed, for: text("a message"), padding: .PssParameters(.Sha512, maskHash: .Sha256, saltByteCount: 0)))
    expect(key.sign(text("a message"), padding: .PssParameters(.Sha512, maskHash: .Sha256, saltByteCount: 0)) == mixed)
}

@test
fn everyPaddingIsValid() {
    for hash in [HashAlgorithm.Sha1, HashAlgorithm.Sha256, HashAlgorithm.Sha384, HashAlgorithm.Sha512, HashAlgorithm.Sha3_256, HashAlgorithm.Sha3_384, HashAlgorithm.Sha3_512] {
        for padding in [RsaSignaturePadding.Pkcs1(hash), RsaSignaturePadding.Pss(hash)] {
            require(padding.hash == hash && padding == padding && padding.debugDescription().contains("Sha"))
            let signature = key.sign(text("a message"), padding: padding)
            require(key.publicKey.isValid(signature, for: text("a message"), padding: padding))
            require(!key.publicKey.isValid(signature, for: text("another"), padding: padding))
        }
    }
    // PSS has a salt, and a signature is never another.
    expect(key.sign([1], padding: .Pss(.Sha256)) != key.sign([1], padding: .Pss(.Sha256)))
    expect(key.sign([1], padding: .Pkcs1(.Sha256)) == key.sign([1], padding: .Pkcs1(.Sha256)))
}

@test
fn anythingElseIsNotValid() {
    let signature = key.sign([1], padding: .Pkcs1(.Sha256))
    var changed = signature
    changed[100] = changed[100] ^ 1
    expect(!key.publicKey.isValid(changed, for: [1], padding: .Pkcs1(.Sha256)))
    expect(!key.publicKey.isValid(signature[1...], for: [1], padding: .Pkcs1(.Sha256)))
    // The modulus and more.
    expect(!key.publicKey.isValid(U8[>..](repeating: 0xFF, count: 256), for: [1], padding: .Pkcs1(.Sha256)))
    expect(!key.publicKey.isValid(key.publicKey.modulus, for: [1], padding: .Pss(.Sha256)))
    expect(!key.publicKey.isValid(signature, digest: [1, 2], padding: .Pkcs1(.Sha256)))
    expect(!key.publicKey.isValid(signature, digest: [1, 2], padding: .Pss(.Sha256)))
    expect(!key.publicKey.isValid(signature, for: [1], padding: .PssParameters(.Sha256, maskHash: .Sha256, saltByteCount: -1)))
    expect(!key.publicKey.isValid(signature, for: [1], padding: .PssParameters(.Sha256, maskHash: .Sha256, saltByteCount: 1000)))
}

@test
fn aMadeKeySignsAndIsReadBack() {
    let made = RsaPrivateKey.generate(bits: 2048)
    expect(made.publicKey.bitCount == 2048 && made.publicKey.signatureByteCount == 256)
    let signature = made.sign([1], padding: .Pss(.Sha256))
    expect(made.publicKey.isValid(signature, for: [1], padding: .Pss(.Sha256)))
    let read = try! RsaPrivateKey(modulus: made.publicKey.modulus, exponent: 65537, privateExponent: made.privateExponent(), prime1: made.prime1(), prime2: made.prime2(), exponent1: made.exponent1(), exponent2: made.exponent2(), coefficient: made.coefficient())
    expect(read == made && read != key)
    assertEqual(made.debugDescription(), "RsaPrivateKey(2048 bits)")
    assertEqual(made.publicKey.debugDescription(), "RsaPublicKey(2048 bits, exponent 65537)")
    expect([made.publicKey: 1][read.publicKey] == 1)
}

// Each number of the key's changed, one at a time.
@test
fn numbersThatDoNotGoTogetherAreNoKey() {
    let numbers = [key.publicKey.modulus, key.privateExponent(), key.prime1(), key.prime2(), key.exponent1(), key.exponent2(), key.coefficient()]
    var i = 0
    while i < numbers.count {
        for place in [20, 60, 127] {
            var other = numbers
            other[i][place] = other[i][place] ^ 2
            assert((try? RsaPrivateKey(modulus: other[0], exponent: 65537, privateExponent: other[1], prime1: other[2], prime2: other[3], exponent1: other[4], exponent2: other[5], coefficient: other[6])) == none)
        }
        i += 1
    }
    expect((try? RsaPrivateKey(modulus: numbers[0], exponent: 3, privateExponent: numbers[1], prime1: numbers[2], prime2: numbers[3], exponent1: numbers[4], exponent2: numbers[5], coefficient: numbers[6])) == none)
    expect((try? RsaPrivateKey(modulus: numbers[0], exponent: 65537, privateExponent: numbers[1], prime1: [], prime2: numbers[3], exponent1: numbers[4], exponent2: numbers[5], coefficient: numbers[6])) == none)
    expect((try? RsaPrivateKey(modulus: numbers[0], exponent: 65537, privateExponent: numbers[1], prime1: numbers[0], prime2: numbers[3], exponent1: numbers[4], exponent2: numbers[5], coefficient: numbers[6])) == none)
    expect((try? RsaPrivateKey(modulus: numbers[0], exponent: 65537, privateExponent: numbers[1], prime1: numbers[2], prime2: numbers[3], exponent1: numbers[0], exponent2: numbers[5], coefficient: numbers[6])) == none)
}

@test
fn publicKeysAreOddAndOfALengthAllowed() {
    expect((try? RsaPublicKey(modulus: [], exponent: 3)) == none)
    expect((try? RsaPublicKey(modulus: U8[>..](repeating: 0xFF, count: 127), exponent: 3)) == none)
    expect((try? RsaPublicKey(modulus: U8[>..](repeating: 0xFF, count: 2049), exponent: 3)) == none)
    expect((try? RsaPublicKey(modulus: U8[>..](repeating: 0xFE, count: 256), exponent: 3)) == none)
    expect((try? RsaPublicKey(modulus: U8[>..](repeating: 0xFF, count: 256), exponent: 4)) == none)
    expect((try? RsaPublicKey(modulus: U8[>..](repeating: 0xFF, count: 256), exponent: 1)) == none)
    var padded: U8[>..] = [0, 0]
    padded.append(repeating: 0xFF, count: 256)
    expect(try! RsaPublicKey(modulus: padded, exponent: 3) == RsaPublicKey(modulus: padded[2...], exponent: 3))
    expect(try! RsaPublicKey(modulus: padded, exponent: 3) != RsaPublicKey(modulus: padded, exponent: 5))
}

// A modulus of 2041 bits: PSS's encoding is of a byte less than it.
@test
fn aModulusOfABitMoreThanBytesIsChecked() {
    var modulus = U8[>..](repeating: 0xFF, count: 256)
    modulus[0] = 1
    let odd = try! RsaPublicKey(modulus: modulus, exponent: 65537)
    assertEqual(odd.bitCount, 2041)
    expect(!odd.isValid(U8[>..](repeating: 0, count: 256), for: [1], padding: .Pss(.Sha256)))
    var one = U8[>..](repeating: 0, count: 256)
    one[255] = 2
    expect(!odd.isValid(one, for: [1], padding: .Pss(.Sha256)))
    expect(!odd.isValid(one, for: [1], padding: .Pkcs1(.Sha256)))
}
