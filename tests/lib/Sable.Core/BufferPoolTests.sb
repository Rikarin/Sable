module BufferPoolTests

// BufferPool (Sable.Core): byte buffers rented, given back and rented again,
// their room kept.

import Sable.Testing

@test
fn aRentedBufferIsEmptyWithTheRoomAskedFor() {
    let pool = BufferPool()
    let small = pool.rent(minimumCapacity: 10)
    assert(small.isEmpty)
    assert(small.capacity >= 256)
    let big = pool.rent(minimumCapacity: 5000)
    assert(big.capacity >= 8192)
    assertEqual(pool.count, 0)
}

@test
fn aBufferGivenBackIsRentedAgainEmpty() {
    let pool = BufferPool()
    var bytes = pool.rent(minimumCapacity: 1000)
    bytes.append(contentsOf: [1, 2, 3])
    pool.giveBack(move bytes)
    assertEqual(pool.count, 1)
    let again = pool.rent(minimumCapacity: 600)
    assert(again.isEmpty)
    assert(again.capacity >= 1024)
    assertEqual(pool.count, 0)
}

@test
fn aBufferStillHeldIsNotShared() {
    let pool = BufferPool()
    var bytes = pool.rent(minimumCapacity: 300)
    bytes.append(9)
    pool.giveBack(bytes)
    var other = pool.rent(minimumCapacity: 300)
    other.append(1)
    assertEqual(bytes[0], 9)
    assertEqual(other[0], 1)
}

@test
fn aPoolKeepsOnlyWhatItsLimitsAllow() {
    let pool = BufferPool(maximumPerSize: 2, maximumCapacity: 4096)
    var tiny: U8[>..] = []
    tiny.reserveCapacity(10)
    pool.giveBack(move tiny)
    assertEqual(pool.count, 0)
    pool.giveBack(pool.rent(minimumCapacity: 100_000))
    assertEqual(pool.count, 0)
    pool.giveBack(pool.rent(minimumCapacity: 256))
    pool.giveBack(pool.rent(minimumCapacity: 256))
    let first = pool.rent(minimumCapacity: 256)
    let second = pool.rent(minimumCapacity: 256)
    let third = pool.rent(minimumCapacity: 256)
    pool.giveBack(move first)
    pool.giveBack(move second)
    pool.giveBack(move third)
    assertEqual(pool.count, 2)
    pool.trim()
    assertEqual(pool.count, 0)
}

@test
fn aByteBufferWritesIntoAPooledBuffer() {
    let pool = BufferPool()
    var buffer = ByteBuffer(reusing: pool.rent(minimumCapacity: 512), endian: .Big)
    assert(buffer.capacity >= 512)
    buffer.writeU16(0xCAFE)
    let bytes = buffer.takeBytes()
    assert(buffer.isEmpty)
    assert(bytes == [0xCA, 0xFE])
    pool.giveBack(move bytes)
    assertEqual(pool.count, 1)
}
