module Rsa2048VerifyBench

// RSA of 2048 bits against .NET's RSA.VerifyData: a signature checked 3000
// times, every fourth of another message.

import Sable.Crypto

@main
fn main() {
    let key = RsaPrivateKey.generate(bits: 2048)
    let publicKey = key.publicKey
    let message = U8[>..](repeating: 7, count: 64)
    let other = U8[>..](repeating: 8, count: 64)
    let signature = key.sign(message, padding: .Pkcs1(.Sha256))
    var valid = 0
    var round = 0
    while round < 3000 {
        if publicKey.isValid(signature, for: round % 4 == 3 ? other : message, padding: .Pkcs1(.Sha256)) {
            valid += 1
        }
        round += 1
    }
    print("\(valid)")
}
