module Md5Tests

// Insecure.Md5 (Sable.Crypto): the standard's messages, every length around
// the blocks' ends, and every way of cutting a message in two. Run with
//     tools/stdlib-coverage.sh Sable.Crypto

import CryptoSupport
import Sable.Crypto
import Sable.Testing

let published: Published[>..] = [
    Published("", "d41d8cd98f00b204e9800998ecf8427e"),
    Published("a", "0cc175b9c0f1b6a831c399e269772661"),
    Published("abc", "900150983cd24fb0d6963f7d28e17f72"),
    Published("message digest", "f96b697d7cb7938d525a2f31aaf161d0"),
    Published("abcdefghijklmnopqrstuvwxyz", "c3fcd3d76192e4007dfb496cca67e13b"),
    Published("12345678901234567890123456789012345678901234567890123456789012345678901234567890", "57edf4a22be3c955ac49da2e2107b67a"),
]

@test(arguments: published)
fn thePublishedMessagesHaveTheirDigests(_ one: Published) {
    expect("\(Insecure.Md5.hash(one.message))" == one.digest)
}

// Every length to past three blocks, its digest among those hashed here;
// the digest of them all from Python's hashlib.
@test
fn everyLengthHasItsDigest() {
    var all = Insecure.Md5()
    var count = 0
    while count < 194 {
        all.update(Insecure.Md5.hash(message(count)).bytes)
        count += 1
    }
    assertEqual("\(all.finalize())", "08cd77e29618512ec504651ad1d7a62c")
}

@test
fn aMessageInTwoPartsIsTheWholeWhereverItIsCut() {
    let whole = message(133)
    let expected = Insecure.Md5.hash(whole)
    var cut = 0
    while cut <= whole.count {
        var hash = Insecure.Md5()
        hash.update(whole[..<cut])
        hash.update(whole[cut...])
        assertEqual(hash.finalize(), expected)
        cut += 1
    }
}

@test
fn aMessageAByteAtATimeIsTheWhole() {
    let whole = message(133)
    var hash = Insecure.Md5()
    for byte in whole {
        hash.update([byte])
        hash.update([])
    }
    expect(hash.finalize() == Insecure.Md5.hash(whole))
}

@test
fn finalizingLeavesTheFunctionToGoOn() {
    let whole = message(73)
    var hash = Insecure.Md5()
    hash.update(whole[..<64])
    expect(hash.finalize() == Insecure.Md5.hash(whole[..<64]))
    expect(hash.finalize() == Insecure.Md5.hash(whole[..<64]))
    hash.update(whole[64...])
    expect(hash.finalize() == Insecure.Md5.hash(whole))
}

@test
fn aCopyHashesOnByItself() {
    let whole = message(73)
    var first = Insecure.Md5()
    first.update(whole[..<7])
    var second = first
    first.update(whole[7...])
    second.update(whole[..<3])
    expect(first.finalize() == Insecure.Md5.hash(whole))
    expect(second.finalize() == Insecure.Md5.hash(joined(message(7), message(3))))
}

@test
fn itsSizesAreTheStandards() {
    assertEqual(Insecure.Md5.digestByteCount, 16)
    assertEqual(Insecure.Md5.blockByteCount, 64)
    assertEqual(Insecure.Md5.hash(message(3)).count, 16)
}
