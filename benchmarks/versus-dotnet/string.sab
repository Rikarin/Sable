module Strings

// String work against .NET's string: building lines by interpolation,
// splitting them into words, comparing and measuring the words, joining
// lines into blocks by concatenation, and slicing.

@main
fn main() {
    let names: String[>..] = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta"]
    var lines: String[>..] = []
    var i = 0
    while i < 300000 {
        lines.append("\(names[i % 8]) \(i) \(names[(i * 3) % 8]) end")
        i = i + 1
    }

    var characters = 0
    var matches = 0
    var words = 0
    for line in lines {
        for word in line.split(' ') {
            words = words + 1
            characters = characters + word.count
            if word == "gamma" {
                matches = matches + 1
            }
        }
    }

    var joinedLength = 0
    i = 0
    while i < lines.count {
        var block = ""
        var j = 0
        while j < 16 && i + j < lines.count {
            block = block + lines[i + j] + "\n"
            j = j + 1
        }
        joinedLength = joinedLength + block.count
        i = i + 16
    }

    var sliced = 0
    for line in lines {
        if line.slice(from: 0, to: 4) == "alph" {
            sliced = sliced + 1
        }
    }

    print("\(words) \(characters) \(matches) \(joinedLength) \(sliced)")
}
