module Mutex

import Sable.Concurrency
import Sable.Testing

// Mutex<Int> against .NET 11's Lock: four tasks on the pool, each taking
// the lock a quarter of a million times to add one to a shared count — the
// lock contended throughout. The .NET port does the same with four
// threads and 'lock', and prints the same line.

fn run() async -> String {
    let count = Mutex<Int>(0)
    await withTaskGroup(of: Int.self) { group in
        var task = 0
        while task < 4 {
            group.spawn {
                var i = 0
                while i < 250000 {
                    count.withLock { $0 += 1 }
                    i = i + 1
                }
                return 0
            }
            task = task + 1
        }
        await group.waitForAll()
    }
    return "\(count.withLock { $0 })"
}

@bench
fn measure(_ b: Bencher) async {
    b.check(await b.iterateAsync { await run() })
}
