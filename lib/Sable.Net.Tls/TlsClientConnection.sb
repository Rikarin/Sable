module Sable.Net.Tls

import Sable.Crypto
import Sable.Crypto.X509
import Sable.Time

/// The client's end of a TLS 1.3 connection (RFC 8446), with no I/O of its
/// own: bytes that came from the server go in through `receive`, and what
/// is to be sent back comes out of `takeOutgoing`. `TlsStream` drives one
/// over a stream; a test, or another transport, may drive it by hand.
///
/// The handshake is the full one, with an ephemeral key exchange: X25519 or
/// P-256, a certificate checked as the options say, and a signature by its
/// key. Every fault found sends the server its alert and throws.
///
/// ```sable
/// var client = TlsClientConnection(host: "example.com")
/// let hello = client.takeOutgoing()
/// assert(hello[0] == 22 && !client.isHandshakeComplete)
/// do {
///     try client.receive([21, 3, 3, 0, 2, 2, 40])
///     assert(false)
/// } catch {
///     assert(error.alert == .handshakeFailure)
/// }
/// ```
public struct TlsClientConnection: Sendable {
    /// The name the server's certificate must be for, and the one sent in
    /// server_name.
    public let host: String

    let options: TlsClientOptions
    let keyShares: TlsKeyShare[>..]
    let sessionId: U8[>..]
    var state: ClientState = .WaitServerHello
    var transcript: U8[>..]
    var incoming: U8[>..] = []
    var handshakeBytes: U8[>..] = []
    var outgoing: U8[>..] = []
    var received: U8[>..] = []
    var schedule: TlsKeySchedule? = none
    var reader: TlsRecordCipher? = none
    var writer: TlsRecordCipher? = none
    var clientSecret: SymmetricKey? = none
    var serverSecret: SymmetricKey? = none

    /// The suite the server chose; none before its ServerHello.
    public private(set) var cipherSuite: TlsCipherSuite? = none

    /// The application protocol the server chose; none if it chose none.
    public private(set) var applicationProtocol: String? = none

    /// The server's certificates as it sent them, its own first.
    public private(set) var peerCertificates: Certificate[>..] = []

    /// Whether the server has finished writing.
    public private(set) var isPeerClosed: Bool = false

    /// Whether this end has finished writing.
    public private(set) var isClosedForWriting: Bool = false

    /// A client of the host, its ClientHello ready to be taken: one key
    /// share of X25519 and one of P-256.
    public init(host: String, options: TlsClientOptions = TlsClientOptions()) {
        let shares: TlsKeyShare[>..] = [.X25519(X25519PrivateKey.generate()), .P256(EcdhPrivateKey<Sable.Crypto.P256>.generate())]
        let hello = TlsClientConnection.clientHello(host: host, options: options, keyShares: shares)
        self.init(host: host, options: options, clientHello: hello, keyShares: shares)
    }

    /// A client that sends a ClientHello of the caller's own — a handshake
    /// message, with the ephemeral keys of its key shares — as a recorded
    /// handshake is replayed. What the server answers is held to the
    /// options, not to the hello.
    public init(host: String, options: TlsClientOptions, clientHello: U8[:], keyShares: TlsKeyShare[:]) {
        self.host = host
        self.options = options
        self.keyShares = keyShares.toArray()
        self.transcript = clientHello.toArray()
        let at = 4 + 2 + 32
        let length = clientHello.count > at ? Int(clientHello[at]) : 0
        self.sessionId = clientHello.count > at + length ? clientHello[at + 1..<at + 1 + length].toArray() : []
        appendRecord(&outgoing, 22, clientHello)
    }

    /// Whether the handshake is over and application data may flow.
    public var isHandshakeComplete: Bool => match state {
        case .Connected => true
        default         => false
    }

    /// The bytes to send the server, taken: none are left.
    public mutating fn takeOutgoing() -> U8[>..] {
        let taken = outgoing
        outgoing = []
        return taken
    }

    /// The application data that has come, taken: none is left.
    public mutating fn takeReceived() -> U8[>..] {
        let taken = received
        received = []
        return taken
    }

    /// Bytes from the server: as many records as they complete are read, and
    /// what to answer is queued. A fault sends its alert and throws, and the
    /// connection is of no more use.
    public mutating fn receive(_ bytes: U8[:]) throws(TlsError) {
        if case .Failed = state {
            throw TlsError.Closed
        }
        incoming.append(contentsOf: bytes)
        do {
            try readRecords()
        } catch {
            fail(error)
            throw error
        }
    }

    /// Application data sealed into records to send.
    public mutating fn write(_ bytes: U8[:]) throws(TlsError) {
        if !isHandshakeComplete || isClosedForWriting {
            throw TlsError.Closed
        }
        var at = 0
        while at < bytes.count {
            let end = bytes.count - at > TlsRecordCipher.maximumContentByteCount ? at + TlsRecordCipher.maximumContentByteCount : bytes.count
            outgoing.append(contentsOf: try writer!.seal(bytes[at..<end], type: .ApplicationData))
            at = end
        }
    }

    /// close_notify queued to send: this end writes no more, though it may
    /// read on until the server closes too.
    public mutating fn close() {
        if !isClosedForWriting {
            sendAlert(.closeNotify)
            isClosedForWriting = true
        }
    }

    mutating fn fail(_ error: TlsError) {
        if case .PeerAlert(_) = error {
            state = .Failed
            return
        }
        if let alert = error.alert {
            sendAlert(alert)
        }
        state = .Failed
    }

    mutating fn sendAlert(_ alert: TlsAlert) {
        let body: U8[>..] = [alert.isClosure ? 1 : 2, U8(alert.code)]
        if writer != none {
            do {
                outgoing.append(contentsOf: try writer!.seal(body, type: .Alert))
            } catch {
                return
            }
        } else {
            appendRecord(&outgoing, 21, body)
        }
    }

    mutating fn readRecords() throws(TlsError) {
        while incoming.count >= 5 {
            let length = Int(incoming[3]) << 8 | Int(incoming[4])
            if length > TlsRecordCipher.maximumContentByteCount + 256 {
                throw TlsError.Failed(.recordOverflow, reason: "a record of \(length) bytes")
            }
            if incoming.count < 5 + length {
                return
            }
            let record = incoming[0..<5 + length].toArray()
            incoming = incoming[5 + length..<incoming.count].toArray()
            try readRecord(record)
            if case .Failed = state {
                return
            }
        }
    }

    mutating fn readRecord(_ record: U8[>..]) throws(TlsError) {
        let outer = Int(record[0])
        if outer == 20 && !isHandshakeComplete {
            if record.count != 6 || record[5] != 1 {
                throw TlsError.Failed(.unexpectedMessage, reason: "a change_cipher_spec that is not one")
            }
            return
        }
        var type = TlsContentType.Handshake
        var content: U8[>..] = []
        if reader != none {
            let (opened, bytes) = try reader!.open(record)
            type = opened
            content = bytes
        } else {
            guard let plain = TlsContentType.of(code: outer) else {
                throw TlsError.Failed(.unexpectedMessage, reason: "a record of type \(outer)")
            }
            if plain == .ApplicationData {
                throw TlsError.Failed(.unexpectedMessage, reason: "application data before the handshake's keys")
            }
            if record.count - 5 > TlsRecordCipher.maximumContentByteCount {
                throw TlsError.Failed(.recordOverflow, reason: "a plaintext record of \(record.count - 5) bytes")
            }
            type = plain
            content = record[5..<record.count].toArray()
        }
        match type {
            case .Alert => try readAlert(content)
            case .Handshake => {
                if content.isEmpty {
                    throw TlsError.Failed(.unexpectedMessage, reason: "an empty handshake record")
                }
                handshakeBytes.append(contentsOf: content)
                try readMessages()
            }
            case .ApplicationData => {
                if !isHandshakeComplete {
                    throw TlsError.Failed(.unexpectedMessage, reason: "application data before the handshake is over")
                }
                received.append(contentsOf: content)
            }
            case .ChangeCipherSpec => throw TlsError.Failed(.unexpectedMessage, reason: "a protected change_cipher_spec")
        }
    }

    mutating fn readAlert(_ content: U8[:]) throws(TlsError) {
        if content.count != 2 {
            throw TlsError.Failed(.decodeError, reason: "an alert of \(content.count) bytes")
        }
        let alert = TlsAlert(code: Int(content[1]))
        if alert == .closeNotify {
            isPeerClosed = true
            return
        }
        throw TlsError.PeerAlert(alert)
    }

    mutating fn readMessages() throws(TlsError) {
        while handshakeBytes.count >= 4 {
            let length = Int(handshakeBytes[1]) << 16 | Int(handshakeBytes[2]) << 8 | Int(handshakeBytes[3])
            if handshakeBytes.count < 4 + length {
                return
            }
            let message = handshakeBytes[0..<4 + length].toArray()
            handshakeBytes = handshakeBytes[4 + length..<handshakeBytes.count].toArray()
            let keysBefore = state
            try readMessage(Int(message[0]), message)
            if !handshakeBytes.isEmpty && keysChange(from: keysBefore) {
                throw TlsError.Failed(.unexpectedMessage, reason: "a handshake message across a change of keys")
            }
        }
    }

    fn keysChange(from before: ClientState) -> Bool {
        return match (before, state) {
            case (.WaitServerHello, _) => true
            case (.WaitFinished, _)    => true
            default                    => false
        }
    }

    mutating fn readMessage(_ type: Int, _ message: U8[>..]) throws(TlsError) {
        var body = TlsReader(message[4..<message.count], "a handshake message")
        match state {
            case .WaitServerHello => {
                try expect(type, 2, "ServerHello")
                try readServerHello(&body)
                transcript.append(contentsOf: message)
                try startHandshakeKeys()
                state = .WaitEncryptedExtensions
            }
            case .WaitEncryptedExtensions => {
                try expect(type, 8, "EncryptedExtensions")
                try readEncryptedExtensions(&body)
                transcript.append(contentsOf: message)
                state = .WaitCertificate
            }
            case .WaitCertificate => {
                try expect(type, 11, "Certificate")
                try readCertificate(&body)
                transcript.append(contentsOf: message)
                try checkTrust()
                state = .WaitCertificateVerify
            }
            case .WaitCertificateVerify => {
                try expect(type, 15, "CertificateVerify")
                try readCertificateVerify(&body)
                transcript.append(contentsOf: message)
                state = .WaitFinished
            }
            case .WaitFinished => {
                try expect(type, 20, "Finished")
                try readFinished(&body)
                transcript.append(contentsOf: message)
                try finishHandshake()
                state = .Connected
            }
            case .Connected => try readPostHandshake(type, &body)
            case .Failed    => throw TlsError.Closed
        }
    }

    fn expect(_ type: Int, _ wanted: Int, _ name: String) throws(TlsError) {
        if type != wanted {
            throw TlsError.Failed(.unexpectedMessage, reason: "a handshake message of type \(type) where a \(name) should be")
        }
    }

    fn transcriptHash() -> U8[>..] {
        return cipherSuite!.hashAlgorithm.digest(of: transcript).bytes
    }

    mutating fn readServerHello(_ body: inout TlsReader) throws(TlsError) {
        if try body.number(2) != 0x0303 {
            throw TlsError.Failed(.protocolVersion, reason: "a ServerHello of legacy version other than TLS 1.2's")
        }
        let random = try body.take(32)
        if random == TlsClientConnection.retryRandom {
            throw TlsError.Failed(.handshakeFailure, reason: "the server asked for another ClientHello, which this client does not send")
        }
        if try body.vector(1) != sessionId {
            throw TlsError.Failed(.illegalParameter, reason: "a ServerHello that does not echo the session id")
        }
        let code = try body.number(2)
        guard let suite = TlsCipherSuite.of(code: code) else {
            throw TlsError.Failed(.illegalParameter, reason: "a cipher suite \(code) that was not offered")
        }
        if !options.cipherSuites.contains(suite) {
            throw TlsError.Failed(.illegalParameter, reason: "a cipher suite \(suite) that was not offered")
        }
        if try body.number(1) != 0 {
            throw TlsError.Failed(.illegalParameter, reason: "a ServerHello with compression")
        }
        var extensions = TlsReader(try body.vector(2), "ServerHello's extensions")
        try body.finish()
        var version = 0
        var share: (Int, U8[>..])? = none
        while !extensions.isAtEnd {
            let type = try extensions.number(2)
            var data = TlsReader(try extensions.vector(2), "a ServerHello extension")
            match type {
                case 43 => {
                    version = try data.number(2)
                }
                case 51 => {
                    let group = try data.number(2)
                    share = (group, try data.vector(2))
                }
                default => throw TlsError.Failed(.unsupportedExtension, reason: "a ServerHello extension \(type) that was not asked for")
            }
            try data.finish()
        }
        if version != 0x0304 {
            throw TlsError.Failed(.protocolVersion, reason: "a server that does not speak TLS 1.3")
        }
        guard let (group, key) = share else {
            throw TlsError.Failed(.missingExtension, reason: "a ServerHello with no key share")
        }
        var secret: SymmetricKey? = none
        for each in keyShares {
            if each.group == group {
                secret = try each.sharedSecret(with: key)
            }
        }
        guard let shared = secret else {
            throw TlsError.Failed(.illegalParameter, reason: "a key share of group \(group), which was not offered")
        }
        cipherSuite = suite
        var keys = TlsKeySchedule(suite)
        keys.advance(sharedSecret: shared)
        schedule = keys
    }

    mutating fn startHandshakeKeys() throws(TlsError) {
        let hash = transcriptHash()
        let client = schedule!.deriveSecret("c hs traffic", transcriptHash: hash)
        let server = schedule!.deriveSecret("s hs traffic", transcriptHash: hash)
        clientSecret = client
        serverSecret = server
        reader = TlsRecordCipher(cipherSuite!, trafficSecret: server)
        writer = TlsRecordCipher(cipherSuite!, trafficSecret: client)
    }

    mutating fn readEncryptedExtensions(_ body: inout TlsReader) throws(TlsError) {
        var extensions = TlsReader(try body.vector(2), "EncryptedExtensions")
        try body.finish()
        while !extensions.isAtEnd {
            let type = try extensions.number(2)
            var data = TlsReader(try extensions.vector(2), "an EncryptedExtensions extension")
            if type == 16 {
                var names = TlsReader(try data.vector(2), "application_layer_protocol_negotiation")
                let name = try names.vector(1)
                try names.finish()
                guard let text = Runtime.decodeUtf8(bytes: name) else {
                    throw TlsError.Failed(.illegalParameter, reason: "an application protocol that is not UTF-8")
                }
                if !options.applicationProtocols.contains(text) {
                    throw TlsError.Failed(.illegalParameter, reason: "an application protocol \(text) that was not offered")
                }
                applicationProtocol = text
            } else if type == 43 || type == 51 {
                throw TlsError.Failed(.illegalParameter, reason: "an extension \(type) that belongs in the ServerHello")
            } else {
                _ = try data.take(data.bytes.count - data.at)
            }
            try data.finish()
        }
    }

    mutating fn readCertificate(_ body: inout TlsReader) throws(TlsError) {
        if !(try body.vector(1)).isEmpty {
            throw TlsError.Failed(.illegalParameter, reason: "a Certificate with a request context")
        }
        var list = TlsReader(try body.vector(3), "the certificate list")
        try body.finish()
        var certificates: Certificate[>..] = []
        while !list.isAtEnd {
            let der = try list.vector(3)
            _ = try list.vector(2)
            do {
                certificates.append(try Certificate.parse(der: der))
            } catch {
                throw TlsError.Failed(.badCertificate, reason: "a certificate that does not parse: \(error.description())")
            }
        }
        if certificates.isEmpty {
            throw TlsError.Failed(.decodeError, reason: "a server with no certificate")
        }
        peerCertificates = certificates
    }

    fn checkTrust() throws(TlsError) {
        let leaf = peerCertificates[0]
        match options.trust {
            case .Verified(let verifier) => {
                do {
                    _ = try verifier.verify(leaf, intermediates: peerCertificates[1..<peerCertificates.count], host: host, at: options.time ?? UtcDateTime.now())
                } catch {
                    throw TlsError.UntrustedCertificate(error)
                }
            }
            case .Pinned(let pinned) => {
                if !pinned.contains(leaf) {
                    throw TlsError.UntrustedCertificate(.UnknownIssuer(issuer: "\(leaf.issuer)"))
                }
            }
        }
    }

    mutating fn readCertificateVerify(_ body: inout TlsReader) throws(TlsError) {
        let scheme = try body.number(2)
        let signature = try body.vector(2)
        try body.finish()
        var content = U8[>..](repeating: 0x20, count: 64)
        content.append(contentsOf: "TLS 1.3, server CertificateVerify".utf8Bytes())
        content.append(0)
        content.append(contentsOf: transcriptHash())
        var key: PublicKey? = none
        do {
            key = try peerCertificates[0].publicKey()
        } catch {
            throw TlsError.UntrustedCertificate(error)
        }
        if !TlsClientConnection.isValid(signature, scheme: scheme, of: content, key: key!) {
            throw TlsError.Failed(.decryptError, reason: "the server's CertificateVerify is no signature of its certificate's key")
        }
    }

    /// Whether the signature is the key's of the content by the scheme
    /// (RFC 8446 §4.2.3); false for a scheme not offered.
    static fn isValid(_ signature: U8[:], scheme: Int, of content: U8[:], key: PublicKey) -> Bool {
        match (scheme, key) {
            case (0x0403, .P256(let own)) => {
                guard let read = try? EcdsaSignature<Sable.Crypto.P256>(der: signature) else {
                    return false
                }
                return own.isValid(read, for: content, hash: .Sha256)
            }
            case (0x0503, .P384(let own)) => {
                guard let read = try? EcdsaSignature<Sable.Crypto.P384>(der: signature) else {
                    return false
                }
                return own.isValid(read, for: content, hash: .Sha384)
            }
            case (0x0804, .Rsa(let own)) => {
                return own.isValid(signature, for: content, padding: .Pss(.Sha256))
            }
            case (0x0805, .Rsa(let own)) => {
                return own.isValid(signature, for: content, padding: .Pss(.Sha384))
            }
            case (0x0806, .Rsa(let own)) => {
                return own.isValid(signature, for: content, padding: .Pss(.Sha512))
            }
            case (0x0807, .Ed25519(let own)) => {
                return own.isValid(signature, for: content)
            }
            default => {
                return false
            }
        }
    }

    mutating fn readFinished(_ body: inout TlsReader) throws(TlsError) {
        let data = try body.take(body.bytes.count)
        let wanted = TlsKeySchedule.finishedData(cipherSuite!, trafficSecret: serverSecret!, transcriptHash: transcriptHash())
        if !constantTimeEquals(data, wanted) {
            throw TlsError.Failed(.decryptError, reason: "the server's Finished is not the handshake's")
        }
    }

    mutating fn finishHandshake() throws(TlsError) {
        let hash = transcriptHash()
        var keys = schedule!
        keys.advance()
        let clientApplication = keys.deriveSecret("c ap traffic", transcriptHash: hash)
        let serverApplication = keys.deriveSecret("s ap traffic", transcriptHash: hash)
        let finished = handshakeMessage(20, TlsKeySchedule.finishedData(cipherSuite!, trafficSecret: clientSecret!, transcriptHash: hash))
        outgoing.append(contentsOf: try writer!.seal(finished, type: .Handshake))
        transcript.append(contentsOf: finished)
        schedule = keys
        clientSecret = clientApplication
        serverSecret = serverApplication
        reader = TlsRecordCipher(cipherSuite!, trafficSecret: serverApplication)
        writer = TlsRecordCipher(cipherSuite!, trafficSecret: clientApplication)
    }

    mutating fn readPostHandshake(_ type: Int, _ body: inout TlsReader) throws(TlsError) {
        match type {
            case 4 => _ = try body.take(body.bytes.count)
            case 24 => {
                let requested = try body.number(1)
                try body.finish()
                if requested > 1 {
                    throw TlsError.Failed(.illegalParameter, reason: "a KeyUpdate of \(requested)")
                }
                serverSecret = TlsKeySchedule.nextTrafficSecret(cipherSuite!, serverSecret!)
                reader = TlsRecordCipher(cipherSuite!, trafficSecret: serverSecret!)
                if requested == 1 {
                    outgoing.append(contentsOf: try writer!.seal(handshakeMessage(24, [0]), type: .Handshake))
                    clientSecret = TlsKeySchedule.nextTrafficSecret(cipherSuite!, clientSecret!)
                    writer = TlsRecordCipher(cipherSuite!, trafficSecret: clientSecret!)
                }
            }
            default => throw TlsError.Failed(.unexpectedMessage, reason: "a handshake message of type \(type) after the handshake")
        }
    }

    /// The random of a HelloRetryRequest (RFC 8446 §4.1.3).
    static var retryRandom: U8[>..] => [
        0xCF, 0x21, 0xAD, 0x74, 0xE5, 0x9A, 0x61, 0x11, 0xBE, 0x1D, 0x8C, 0x02, 0x1E, 0x65, 0xB8, 0x91,
        0xC2, 0xA2, 0x11, 0x16, 0x7A, 0xBB, 0x8C, 0x5E, 0x07, 0x9E, 0x09, 0xE2, 0xC8, 0xA8, 0x33, 0x9C,
    ]

    /// The ClientHello this client sends: TLS 1.3 alone, the options'
    /// suites and protocols, the key shares, and the host's name unless it
    /// is an address.
    static fn clientHello(host: String, options: TlsClientOptions, keyShares: TlsKeyShare[:]) -> U8[>..] {
        var body: U8[>..] = [3, 3]
        body.append(contentsOf: SecureRandom.bytes(32))
        body.append(0)
        var suites: U8[>..] = []
        for suite in options.cipherSuites {
            appendNumber(&suites, suite.code, 2)
        }
        appendVector(&body, suites, 2)
        body.append(contentsOf: [1, 0])
        var extensions: U8[>..] = []
        if !TlsClientConnection.isAddress(host) {
            var name: U8[>..] = [0]
            appendVector(&name, host.utf8Bytes(), 2)
            var list: U8[>..] = []
            appendVector(&list, name, 2)
            appendExtension(&extensions, 0, list)
        }
        appendExtension(&extensions, 10, [0, 4, 0, 0x1D, 0, 0x17])
        appendExtension(&extensions, 13, [0, 12, 4, 3, 5, 3, 8, 4, 8, 5, 8, 6, 8, 7])
        var shares: U8[>..] = []
        for share in keyShares {
            appendNumber(&shares, share.group, 2)
            appendVector(&shares, share.publicBytes, 2)
        }
        var shareList: U8[>..] = []
        appendVector(&shareList, shares, 2)
        appendExtension(&extensions, 51, shareList)
        appendExtension(&extensions, 43, [2, 3, 4])
        if !options.applicationProtocols.isEmpty {
            var names: U8[>..] = []
            for name in options.applicationProtocols {
                appendVector(&names, name.utf8Bytes(), 1)
            }
            var list: U8[>..] = []
            appendVector(&list, names, 2)
            appendExtension(&extensions, 16, list)
        }
        appendVector(&body, extensions, 2)
        return handshakeMessage(1, body)
    }

    static fn isAddress(_ host: String) -> Bool {
        for c in host.utf8 {
            if c == 0x3A {
                return true
            }
            if !(c == 0x2E || (c >= 0x30 && c <= 0x39)) {
                return false
            }
        }
        return true
    }
}

fn appendExtension(_ bytes: inout U8[>..], _ type: Int, _ data: U8[:]) {
    appendNumber(&bytes, type, 2)
    appendVector(&bytes, data, 2)
}

/// A plaintext record of the type.
fn appendRecord(_ bytes: inout U8[>..], _ type: Int, _ content: U8[:]) {
    bytes.append(contentsOf: [U8(type), 3, type == 22 ? U8(1) : U8(3)])
    appendVector(&bytes, content, 2)
}

/// Where a client's handshake is.
enum ClientState: Sendable {
    WaitServerHello
    WaitEncryptedExtensions
    WaitCertificate
    WaitCertificateVerify
    WaitFinished
    Connected
    Failed
}
