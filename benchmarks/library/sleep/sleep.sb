module SleepBench

import Sable.Concurrency
import Sable.Testing
import Sable.Time

// Task.sleep: twenty thousand tasks at once, each sleeping one to twenty
// milliseconds, twice.

fn run() async -> String {
    var tasks: Task<Int>[>..] = []
    for i in 0..<20000 {
        tasks.append(
            Task.spawn {
                try? await Task.sleep(for: Duration.milliseconds(i % 20 + 1))
                try? await Task.sleep(for: Duration.milliseconds(i % 7 + 1))
                return i
            })
    }
    var total = 0
    for task in tasks {
        total += await task.value
    }
    return "\(total)"
}

@bench
fn measure(_ b: Bencher) async {
    b.check(await b.iterateAsync { await run() })
}
