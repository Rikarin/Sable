module FixedWidthIntegerTests

// FixedWidthInteger (Sable.Core) and its extensions: the arithmetic that
// does not trap, the bit operations, powers and roots, bytes, and the
// conversions between widths. The limits of each type are its own file's;
// these are the operations' behaviour away from and at them. Run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

/// Generic, so that each requirement is reached through the protocol.
fn leadingZeros<T: FixedWidthInteger>(_ value: T) -> Int {
    return value.leadingZeroCount
}

fn widen<T: FixedWidthInteger>(_ value: T) -> Int? {
    return Int.exactly(value)
}

@test
fn theBitCountsAreReachedThroughTheProtocol() {
    assertEqual(leadingZeros(1 as U8), 7)
    assertEqual(leadingZeros(1 as U128), 127)
    assertEqual(leadingZeros(-1), 0)
}

@test
fn bitWidthIsTheTypes() {
    assertEqual(I8.bitWidth, 8)
    assertEqual(U16.bitWidth, 16)
    assertEqual(Int.bitWidth, 64)
    assertEqual(I128.bitWidth, 128)
}

@test
fn onesAreCountedFromEitherEnd() {
    assertEqual((0b1110_0111 as U8).leadingOneCount, 3)
    assertEqual((0b1110_0111 as U8).trailingOneCount, 3)
    assertEqual((0b1011 as U8).popCount, 3)
}

@test
fn rotationTakesTheCountModuloTheWidth() {
    assertEqual((0b1000_0001 as U8).rotatedLeft(by: 1), 0b0000_0011)
    assertEqual((0b1000_0001 as U8).rotatedRight(by: 1), 0b1100_0000)
    assertEqual((0b1000_0001 as U8).rotatedLeft(by: 9), 0b0000_0011)
    assertEqual((0x12345678 as U32).rotatedLeft(by: 8), 0x34567812)
}

@test
fn swapsReverseBytesOrBits() {
    assertEqual((0x1234 as U16).byteSwapped, 0x3412)
    assertEqual((0x12345678 as U32).byteSwapped, 0x78563412)
    assertEqual((0x12 as U8).byteSwapped, 0x12)
    assertEqual((0b0000_0110 as U8).bitReversed, 0b0110_0000)
}

@test
fn theFullWidthProductKeepsTheHighHalf() {
    let (high, low) = (200 as U8).multipliedFullWidth(by: 3)
    assertEqual(high, 2)
    assertEqual(low, 88)
    let (signedHigh, signedLow) = (-100 as I8).multipliedFullWidth(by: 100)
    assertEqual(signedHigh, -40)
    assertEqual(signedLow, -16)
}

// ---- checked ------------------------------------------------------------

@test
fn checkedArithmeticGivesNoneWhereItDoesNotFit() {
    assertEqual((250 as U8).checkedAdd(5) ?? 0, 255)
    assert((250 as U8).checkedAdd(6) == none, "256 does not fit")
    assertEqual((5 as U8).checkedSub(5) ?? 1, 0)
    assert((5 as U8).checkedSub(6) == none, "-1 does not fit")
    assertEqual((16 as U8).checkedMul(15) ?? 0, 240)
    assert((16 as U8).checkedMul(16) == none, "256 does not fit")
}

@test
fn checkedDivisionGivesNoneForZeroOrOverflow() {
    assertEqual(7.checkedDiv(2) ?? 0, 3)
    assert(7.checkedDiv(0) == none, "no quotient by zero")
    assert(I8.min.checkedDiv(-1) == none, "128 does not fit")
    assertEqual(7.checkedRem(2) ?? 0, 1)
    assert(7.checkedRem(0) == none, "no remainder by zero")
    assert(I8.min.checkedRem(-1) == none, "the quotient does not fit")
}

@test
fn checkedNegationAndAbsGiveNoneWhereItDoesNotFit() {
    assertEqual(5.checkedNeg() ?? 0, -5)
    assert(I16.min.checkedNeg() == none, "32768 does not fit")
    assertEqual((-5).checkedAbs() ?? 0, 5)
    assertEqual(5.checkedAbs() ?? 0, 5)
}

@test
fn checkedShiftsGiveNoneForACountOutsideTheWidth() {
    assertEqual((1 as U8).checkedShl(7) ?? 0, 128)
    assert((1 as U8).checkedShl(8) == none, "8 is past the width")
    assert((1 as U8).checkedShl(-1) == none, "-1 is no count")
    assertEqual((128 as U8).checkedShr(7) ?? 0, 1)
    assert((128 as U8).checkedShr(8) == none, "8 is past the width")
}

@test
fn checkedPowGivesNoneWhereItDoesNotFit() {
    assertEqual(2.checkedPow(10) ?? 0, 1024)
    assert((2 as U8).checkedPow(8) == none, "256 does not fit")
    assert(2.checkedPow(-1) == none, "no integer power")
    assertEqual(7.checkedPow(0) ?? 0, 1)
}

// ---- wrapping -----------------------------------------------------------

@test
fn wrappingDivisionGivesTheLeastValueForMinusOne() {
    assertEqual(I8.min.wrappingDiv(-1), I8.min)
    assertEqual(7.wrappingDiv(2), 3)
    assertEqual(I8.min.wrappingRem(-1), 0)
    assertEqual(7.wrappingRem(2), 1)
}

@test
fn wrappingShiftsTakeTheCountModuloTheWidth() {
    assertEqual((1 as U8).wrappingShl(9), 2)
    assertEqual((128 as U8).wrappingShr(9), 64)
    assertEqual((1 as U8).wrappingShl(3), 8)
}

@test
fn wrappingPowKeepsTheLowBits() {
    assertEqual((3 as U8).wrappingPow(5), 243)
    assertEqual((3 as U8).wrappingPow(6), 217)
    assertEqual((2 as I8).wrappingPow(7), -128)
}

@test
fn wrappingAbsOfANegativeValueIsItsNegation() {
    assertEqual((-5).wrappingAbs(), 5)
    assertEqual(5.wrappingAbs(), 5)
}

// ---- saturating ---------------------------------------------------------

@test
fn saturatingProductsStopAtTheBoundTheirSignPasses() {
    assertEqual((100 as I8).saturatingMul(2), 127)
    assertEqual((-100 as I8).saturatingMul(2), -128)
    assertEqual((-100 as I8).saturatingMul(-2), 127)
    assertEqual((10 as I8).saturatingMul(3), 30)
}

@test
fn saturatingDivisionGivesTheGreatestForMinusOne() {
    assertEqual(I8.min.saturatingDiv(-1), 127)
    assertEqual(9.saturatingDiv(2), 4)
}

@test
fn saturatingPowStopsAtTheBoundItsSignPasses() {
    assertEqual((3 as I8).saturatingPow(5), 127)
    assertEqual((-3 as I8).saturatingPow(5), -128)
    assertEqual((-3 as I8).saturatingPow(4), 81)
    assertEqual((-3 as I8).saturatingPow(6), 127)
}

@test
fn saturatingNegationAndAbsStopAtTheGreatest() {
    assertEqual((-5).saturatingAbs(), 5)
    assertEqual(5.saturatingAbs(), 5)
    assertEqual(5.saturatingNeg(), -5)
}

// ---- overflowing --------------------------------------------------------

@test
fn overflowingDivisionReportsTheLeastValueByMinusOne() {
    let (quotient, overflowed) = I8.min.overflowingDiv(-1)
    assertEqual(quotient, I8.min)
    assert(overflowed, "the quotient overflowed")
    let (remainder, remainderOverflowed) = I8.min.overflowingRem(-1)
    assertEqual(remainder, 0)
    assert(remainderOverflowed, "the quotient overflowed")
    let (fine, fineOverflowed) = 7.overflowingDiv(2)
    assertEqual(fine, 3)
    assert(!fineOverflowed, "7 / 2 fits")
}

@test
fn overflowingNegationReportsTheLeastValue() {
    let (negated, overflowed) = I8.min.overflowingNeg()
    assertEqual(negated, I8.min)
    assert(overflowed, "128 does not fit")
    let (magnitude, absOverflowed) = 5.overflowingAbs()
    assertEqual(magnitude, 5)
    assert(!absOverflowed, "5 fits")
}

@test
fn overflowingPowReportsWhetherAnySquareOrProductOverflowed() {
    let (power, overflowed) = (2 as U8).overflowingPow(9)
    assertEqual(power, 0)
    assert(overflowed, "512 does not fit")
    let (fits, fitsOverflowed) = (2 as U8).overflowingPow(7)
    assertEqual(fits, 128)
    assert(!fitsOverflowed, "128 fits")
}

// ---- trapping -----------------------------------------------------------

@test
fn powMultipliesBySquaring() {
    assertEqual(3.pow(4), 81)
    assertEqual((-2 as I8).pow(7), -128)
    assertEqual(10.pow(0), 1)
    assertEqual((2 as U128).pow(127), U128.max / 2 + 1)
}

@test(traps: "integer overflow")
fn powTrapsWhereThePowerDoesNotFit() {
    assertEqual((2 as U8).pow(8), 0)
}

@test(traps: "does not fit")
fn powTrapsForANegativeExponent() {
    assertEqual(2.pow(-1), 0)
}

// ---- powers of two, logarithms, roots ------------------------------------

@test
fn powersOfTwoArePositiveWithOneBitSet() {
    assert(64.isPowerOfTwo, "64 is 2^6")
    assert(1.isPowerOfTwo, "1 is 2^0")
    assert(!0.isPowerOfTwo, "0 is not")
    assert(!(-8).isPowerOfTwo, "-8 is not")
    assert(!12.isPowerOfTwo, "12 is not")
}

@test
fn theNextPowerOfTwoIsNotBelowTheValue() {
    assertEqual(5.nextPowerOfTwo(), 8)
    assertEqual(8.nextPowerOfTwo(), 8)
    assertEqual(0.nextPowerOfTwo(), 1)
    assertEqual((-3).nextPowerOfTwo(), 1)
    assert((200 as U8).checkedNextPowerOfTwo() == none, "256 does not fit")
    assert((65 as I8).checkedNextPowerOfTwo() == none, "128 does not fit")
    assertEqual((64 as I8).checkedNextPowerOfTwo() ?? 0, 64)
}

@test(traps: "none")
fn theNextPowerOfTwoTrapsWhereItDoesNotFit() {
    assertEqual((129 as U8).nextPowerOfTwo(), 0)
}

@test
fn log2IsTheHighestSetBit() {
    assertEqual(1.log2() ?? -1, 0)
    assertEqual(1000.log2() ?? -1, 9)
    assertEqual(U64.max.log2() ?? -1, 63)
    assert(0.log2() == none, "0 has no logarithm")
    assert((-4).log2() == none, "-4 has no logarithm")
}

@test
fn log10CountsTheDigitsLessOne() {
    assertEqual(999.log10() ?? -1, 2)
    assertEqual(1000.log10() ?? -1, 3)
    assertEqual(1.log10() ?? -1, 0)
    assertEqual((255 as U8).log10() ?? -1, 2)
    assert(0.log10() == none, "0 has no logarithm")
}

@test
fn isqrtRoundsTheRootDown() {
    assertEqual(17.isqrt() ?? -1, 4)
    assertEqual(16.isqrt() ?? -1, 4)
    assertEqual(1.isqrt() ?? -1, 1)
    assertEqual(0.isqrt() ?? -1, 0)
    assertEqual((255 as U8).isqrt() ?? 0, 15)
    assertEqual((127 as I8).isqrt() ?? 0, 11)
    assertEqual(U64.max.isqrt() ?? 0, 4294967295)
    assertEqual(Int.max.isqrt() ?? 0, 3037000499)
    assert((-1).isqrt() == none, "-1 has no root")
}

@test
fn absDiffIsTheDistance() {
    assertEqual(3.absDiff(10), 7)
    assertEqual(10.absDiff(3), 7)
    assertEqual((10 as U8).absDiff(3), 7)
}

@test(traps: "integer overflow")
fn absDiffTrapsWhereTheDistanceDoesNotFit() {
    assertEqual(I8.min.absDiff(I8.max), 0)
}

@test
fn midpointRoundsTowardZeroWithoutOverflowing() {
    assertEqual(1.midpoint(4), 2)
    assertEqual((-1).midpoint(-4), -2)
    assertEqual((-1).midpoint(4), 1)
    assertEqual((255 as U8).midpoint(253), 254)
    assertEqual(I8.max.midpoint(I8.max), 127)
    assertEqual(I8.min.midpoint(I8.max), 0)
}

// ---- bytes --------------------------------------------------------------

@test
fn bytesComeInEitherOrder() {
    assert((0x1234 as U16).bigEndianBytes() == [0x12, 0x34], "big-endian is most significant first")
    assert((0x1234 as U16).littleEndianBytes() == [0x34, 0x12], "little-endian is least significant first")
    assert((-2 as I16).bigEndianBytes() == [0xFF, 0xFE], "a negative value's bytes are its two's complement")
}

@test
fn bytesReadBackAsTheValue() {
    assertEqual(U16.fromBigEndianBytes([0x12, 0x34]) ?? 0, 0x1234)
    assertEqual(U16.fromLittleEndianBytes([0x34, 0x12]) ?? 0, 0x1234)
    assertEqual(I32.fromBigEndianBytes([0xFF, 0xFF, 0xFF, 0xFE]) ?? 0, -2)
    assertEqual(U8.fromBigEndianBytes([0xAB]) ?? 0, 0xAB)
}

@test
fn bytesOfTheWrongCountAreNone() {
    assert(U16.fromBigEndianBytes([0x12]) == none, "one byte is not a U16")
    assert(U16.fromLittleEndianBytes([1, 2, 3]) == none, "three bytes are not a U16")
}

@test
fn theEndianRepresentationsAreTheBytesInPlace() {
    assertEqual((0x1234 as U16).bigEndian, 0x3412)
    assertEqual((0x1234 as U16).littleEndian, 0x1234)
    assertEqual(U16.fromBigEndian(0x3412), 0x1234)
    assertEqual(U16.fromLittleEndian(0x1234), 0x1234)
}

// ---- conversions --------------------------------------------------------

@test
fn truncatingKeepsTheLowBits() {
    assertEqual(U8.truncating(300), 44)
    assertEqual(I8.truncating(255 as U8), -1)
    assertEqual(U16.truncating(-1 as I8), 65535)
    assertEqual(I128.truncating(-5), -5)
}

@test
fn exactlyGivesNoneWhereTheValueDoesNotFit() {
    assertEqual(U8.exactly(255) ?? 0, 255)
    assert(U8.exactly(256) == none, "256 does not fit a U8")
    assert(U8.exactly(-1) == none, "-1 does not fit a U8")
    assert(I8.exactly(128 as U8) == none, "128 does not fit an I8")
    assert(U128.exactly(-1 as I128) == none, "-1 does not fit a U128")
    assertEqual(Int.exactly(-5 as I8) ?? 0, -5)
}

@test
fn exactlyWorksFromAGenericSource() {
    assertEqual(widen(200 as U8) ?? 0, 200)
    assert(widen(U64.max) == none, "U64's greatest value does not fit an Int")
}

@test
fn clampingStopsAtTheBoundTheValueIsPast() {
    assertEqual(U8.clamping(300), 255)
    assertEqual(U8.clamping(-5), 0)
    assertEqual(I8.clamping(100), 100)
    assertEqual(I8.clamping(-1000), -128)
}

/// Generic over the float, so that the conversion is reached through the protocol.
fn wholeBytes<F: FloatingPoint>(_ value: F) -> U8? {
    return U8.exactly(value)
}

@test
fn aFloatIsExactlyAnIntegerOnlyWithoutAFractionAndInRange() {
    assertEqual(I32.exactly(42.0) ?? 0, 42)
    assertEqual(I8.exactly(-128.0) ?? 0, -128)
    assertEqual(U64.exactly(-0.0) ?? 1, 0)
    assert(I32.exactly(2.5) == none, "2.5 has a fraction")
    assert(I8.exactly(128.0) == none, "128 does not fit an I8")
    assert(I8.exactly(-129.0) == none, "-129 does not fit an I8")
    assert(U8.exactly(-1.0) == none, "-1 does not fit a U8")
    assert(Int.exactly(9223372036854775808.0) == none, "2^63 does not fit an Int")
    assertEqual(Int.exactly(-9223372036854775808.0) ?? 0, Int.min)
    assert(Int.exactly(F64.nan) == none, "NaN is no integer")
    assert(Int.exactly(F64.infinity) == none, "infinity is no integer")
    assertEqual(wholeBytes(200.0 as F32) ?? 0, 200)
    assertEqual(wholeBytes(7.0 as F16) ?? 0, 7)
}

@test
fn aFloatClampsTowardZeroAndToTheBounds() {
    assertEqual(I8.clamping(-2.9), -2)
    assertEqual(I8.clamping(2.9 as F32), 2)
    assertEqual(U8.clamping(300.0), 255)
    assertEqual(U8.clamping(-5.0), 0)
    assertEqual(Int.clamping(F64.nan), 0)
    assertEqual(Int.clamping(F64.infinity), Int.max)
    assertEqual(U128.clamping(F64.greatestFiniteMagnitude), U128.max)
    assertEqual(I16.clamping(-F16.infinity), I16.min)
}
