module SymmetricKeyTests

// SymmetricKey (Sable.Crypto): equality, and that it does not print its
// bytes. Run with
//     tools/stdlib-coverage.sh Sable.Crypto

import CryptoSupport
import Sable.Crypto
import Sable.Testing

@test
fn aKeyKeepsItsBytes() {
    let key = SymmetricKey(message(37))
    assertEqual(key.byteCount, 37)
    expect(key.bytes() == message(37))
    assertEqual(SymmetricKey([]).byteCount, 0)
    assertEqual(SymmetricKey([]).bytes().count, 0)
}

@test
fn keysAreEqualWhenTheirBytesAre() {
    expect(SymmetricKey(message(20)) == SymmetricKey(message(20)))
    expect(SymmetricKey(message(20)) != SymmetricKey(message(21)))
    var i = 0
    while i < 20 {
        var other = message(20)
        other[i] = other[i] ^ 1
        expect(SymmetricKey(message(20)) != SymmetricKey(other), "byte \(i)")
        i += 1
    }
}

@test
fn printingAKeySaysOnlyHowLongItIs() {
    let key = SymmetricKey([0xDE, 0xAD])
    assertEqual("\(key)", "SymmetricKey(2 bytes)")
    assertEqual("\(key:>24)", "   SymmetricKey(2 bytes)")
    assertEqual(key.debugDescription(), "SymmetricKey(2 bytes)")
}

@test
fn randomKeysDiffer() {
    expect(SymmetricKey.random(byteCount: 32) != SymmetricKey.random(byteCount: 32))
    assertEqual(SymmetricKey.random(byteCount: 0).byteCount, 0)
}
