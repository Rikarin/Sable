module Sable.Net

import Sable.IO
import Sable.Time

/// A connection over a Unix domain socket: as `TcpStream`, but to a program
/// on this machine.
///
/// ```sable
/// fn ask(path: String) async throws(IoError) -> U8[>..] {
///     let connection = try await UnixStream.connect(path)
///     try await connection.write([1])
///     connection.finishWriting()
///     return try await connection.readAll()
/// }
/// ```
@immutable
public final class UnixStream: AsyncReader, AsyncWriter {
    let handle: Int

    init(handle: Int) {
        self.handle = handle
    }

    deinit {
        Runtime.closeSocket(handle)
    }

    /// A connection to whoever listens at the path, waiting until it is
    /// made: NotFound when nothing is there, ConnectionRefused when no
    /// program listens by it any more.
    public static async fn connect(_ path: String, timeout: Duration? = none) throws(IoError) -> UnixStream {
        let start = Instant.now()
        var times = 0
        while true {
            let handle = Runtime.connect(1, 0, 0, 0, 0, path)
            if handle != 0 {
                let stream = UnixStream(handle: handle)
                try await waitUntilConnected(handle, path, timeout: timeout)
                return stream
            }
            // Linux's queue of connections to be accepted is full.
            if !isOutOfRoom() {
                throw socketError(path)
            }
            if let timeout {
                if start.elapsed >= timeout {
                    throw IoError.TimedOut
                }
            }
            try await waitForRoom(times)
            times += 1
        }
    }

    /// Up to 'count' bytes, as soon as any have come; none once the other
    /// end has finished writing. A task cancelled while it waits throws
    /// Cancelled, and no byte is lost.
    public fn read(upTo count: Int) async throws(IoError) -> U8[>..] {
        return try await readFrom(handle, upTo: count)
    }

    /// Every byte until the other end finishes writing.
    public fn readAll() async throws(IoError) -> U8[>..] {
        return try await readAllFrom(handle)
    }

    /// Every one of the bytes written, waiting while the other end is slow
    /// to read them. Of a write that throws, some may have gone.
    public fn write(_ bytes: U8[:]) async throws(IoError) {
        try await writeTo(handle, bytes)
    }

    /// Nothing more is written: the other end reads to its end. Reading
    /// goes on.
    public fn finishWriting() {
        Runtime.shutdownSocket(handle, writing: true)
    }

    /// Closed, both ways: tasks waiting on it wake and throw Disconnected.
    /// Dropping the stream closes it too.
    public fn close() {
        Runtime.closeSocket(handle)
    }
}
