module SortTests

// 'sort' and 'sorted' (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections
// They are the arrays' own members, which Sable.Core's tests cover in full.

import Sable.Collections
import Sable.Testing

@test
fn sortOrdersInPlace() {
    var values: Int[>..] = [5, 3, 9, 1, 4, 1]
    sort(&values)
    assert(values == [1, 1, 3, 4, 5, 9])
}

@test
fn sortByOrdersInPlaceByTheOrderGiven() {
    var values: Int[>..] = [5, 3, 9, 1]
    sort(&values, by: (a: Int, b: Int) => b < a)
    assert(values == [9, 5, 3, 1])
}

@test
fn sortedLeavesTheValuesAsTheyWere() {
    let values: Int[>..] = [2, 3, 1]
    assert(sorted(values) == [1, 2, 3])
    assert(values == [2, 3, 1])
}

@test
fn sortedTakesAnOrder() {
    let words = sorted(["pear", "fig", "banana"], by: (a: String, b: String) => a.count < b.count)
    assertEqual(words[0], "fig")
    assertEqual(words[2], "banana")
}

@bench
fn sortSixtyFour() {
    var values: Int[>..] = []
    var i = 0
    while i < 64 {
        values.append((i * 7919) % 64)
        i = i + 1
    }
    sort(&values)
}
