module HeapTests

// Heap (Sable.Collections): a min-max heap, its least and greatest each a
// step away.

import Sable.Collections
import Sable.Testing

@test
fn theLeastAndTheGreatestComeOut() {
    let heap = Heap<Int>([5, 1, 9, 3, 7, 2, 8])
    assertEqual(heap.min, 1)
    assertEqual(heap.max, 9)
    var largestFirst: Int[>..] = []
    while let next = heap.popMax() {
        largestFirst.append(next)
    }
    assert(largestFirst == [9, 8, 7, 5, 3, 2, 1])
    assert(heap.popMin() == none && heap.min == none && heap.max == none)
    let words = Heap<String>(["pear", "apple", "fig"])
    assertEqual(words.popMin(), "apple")
    assertEqual(words.popMax(), "pear")
    assertEqual("\(words)", "Heap([\"fig\"])")
}

@test
fn aHeapAgreesWithASortedArrayUnderRandomChanges() {
    let heap = Heap<Int>()
    var model = List<Int>()
    var seed = 7
    var step = 0
    while step < 3000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let value = seed / 16 % 500
        let choice = seed % 4
        if choice <= 1 || model.isEmpty {
            heap.insert(value)
            model.append(value)
        } else if choice == 2 {
            model.sort()
            assertEqual(heap.popMin(), model.remove(at: 0))
        } else {
            model.sort()
            assertEqual(heap.popMax(), model.removeLast())
        }
        if !model.isEmpty {
            assertEqual(heap.min, model.min()!)
            assertEqual(heap.max, model.max()!)
        }
        assertEqual(heap.count, model.count)
        step += 1
    }
}
