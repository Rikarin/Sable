module LazySequenceTests

// '.lazy' and the views its methods make (LazySequence.sb and the Lazy*
// files of Sable.Core): run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

fn text(_ values: Int[:]) -> String {
    return values.map { "\($0)" }.joined(separator: ",")
}

@test
fn aLazyViewGivesTheSameElements() {
    let values: Int[>..] = [4, 5, 6]
    assertEqualText(text(values.lazy.toArray()), "4,5,6")
}

@test
fn lazyMapTransformsAsItGoes() {
    var calls = 0
    let doubled = [1, 2, 3].lazy.map { (value: Int) -> Int in
        calls += 1
        return value * 2
    }
    assertEqual(calls, 0)
    assertEqual(doubled.first(where: { $0 > 2 }) ?? -1, 4)
    assertEqual(calls, 2)
}

@test
fn lazyFilterTestsAsItGoes() {
    assertEqualText(text([1, 2, 3, 4, 5, 6].lazy.filter { $0 % 2 == 0 }.toArray()), "2,4,6")
    let nothing: Int[>..] = [1, 3].lazy.filter { $0 > 5 }.toArray()
    assertEqual(nothing.count, 0)
}

@test
fn aChainOfViewsGoesThroughTheSequenceOnce() {
    var read: Int[>..] = []
    let watched = [1, 2, 3, 4, 5, 6, 7, 8].lazy.inspect { read.append($0) }
    let result = watched
        .filter { $0 % 2 == 1 }
        .map { $0 * 10 }
        .prefix(while: { $0 < 50 })
        .toArray()
    assertEqualText(text(result), "10,30")

    // It read up to the five, whose fifty ended it, and no further.
    assertEqualText(text(read), "1,2,3,4,5")
}

@test
fn lazyCompactMapLeavesOutNone() {
    let kept = [1, 2, 3, 4].lazy.compactMap { (value: Int) -> Int? in value % 2 == 0 ? value * 100 : none }
    assertEqualText(text(kept.toArray()), "200,400")
}

@test
fn lazyFlatMapJoinsTheInnerSequences() {
    assertEqualText(text([1, 2, 3].lazy.flatMap { stride(from: 0, to: $0, by: 1) }.toArray()), "0,0,1,0,1,2")
    let values: Int[>..] = [0, 2, 0]
    assertEqualText(text(values.lazy.flatMap { stride(from: 5, to: 5 + $0, by: 1) }.toArray()), "5,6")
}

@test
fn lazyPrefixWhileStopsAtTheFirstFailure() {
    var view = [1, 2, 9, 3].lazy.prefix(while: { $0 < 5 }).makeIterator()
    assertEqual(view.next() ?? -1, 1)
    assertEqual(view.next() ?? -1, 2)
    assert(view.next() == none, "stops at nine")
    assert(view.next() == none, "and stays stopped")
}

@test
fn lazyDropWhileKeepsFromTheFirstFailure() {
    assertEqualText(text([1, 2, 9, 3, 1].lazy.drop(while: { $0 < 5 }).toArray()), "9,3,1")
    assertEqual([1, 2].lazy.drop(while: { $0 < 5 }).toArray().count, 0)
}

@test
fn lazyScanGivesEachRunningResult() {
    assertEqualText(text([1, 2, 3, 4].lazy.scan(0) { $0 + $1 }.toArray()), "1,3,6,10")
    assertEqualText(text([2, 3].lazy.scan(1) { $0 * $1 }.toArray()), "2,6")
}

@test
fn lazyStridingGivesEverySoMany() {
    let values: Int[>..] = [0, 1, 2, 3, 4, 5, 6]
    assertEqualText(text(values.lazy.striding(by: 3).toArray()), "0,3,6")
    assertEqualText(text(values.lazy.striding(by: 1).toArray()), "0,1,2,3,4,5,6")
    assertEqualText(text(values.lazy.striding(by: 0).toArray()), "0")
    let empty: Int[>..] = []
    assertEqual(empty.lazy.striding(by: 2).toArray().count, 0)
}

@test
fn lazyCycledStartsAgain() {
    assertEqualText(text([1, 2, 3].lazy.cycled().prefix(7)), "1,2,3,1,2,3,1")
    let empty: Int[>..] = []
    assertEqual(empty.lazy.cycled().toArray().count, 0)
}

@test
fn lazyInspectSeesEachElement() {
    var seen: Int[>..] = []
    let doubled = [1, 2].lazy.inspect { seen.append($0) }.map { $0 * 2 }.toArray()
    assertEqualText(text(seen), "1,2")
    assertEqualText(text(doubled), "2,4")
}

@test
fn aLazyViewIsASequenceGenericCodeTakes() {
    assertEqual(total([1, 2, 3].lazy.map { $0 * 3 }), 18)
    let collected: Int[>..] = [5, 6].lazy.map { $0 + 1 }.collect()
    assertEqualText(text(collected), "6,7")
}

fn total<S: Sequence>(_ values: S) -> Int where S.Element == Int {
    return values.reduce(0) { $0 + $1 }
}
