module Sable.Core

extension Int: Parsable {
    /// The number the text writes in decimal, with a sign if it likes: what
    /// `format` writes with nothing said. `.Overflow` past the greatest Int,
    /// `.Underflow` past the least.
    ///
    /// ```sable
    /// assert(try! Int.parse("-9223372036854775808") == -9223372036854775808)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S) throws(ParseError) -> Int {
        return try Int.parse(text, radix: 10, styles: .Sign)
    }

    /// The number the text writes in the radix — 2 to 36, with letters of
    /// either case past 9; another traps — with what else the styles allow:
    /// white space, a sign, the radix's prefix, separators.
    ///
    /// ```sable
    /// assert(try! Int.parse("0x7f", radix: 16, styles: .Prefix) == 127)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S, radix: Int, styles: NumberStyles = .Sign) throws(ParseError) -> Int {
        let text = text.asSubstring
        if let value = shortInteger(text, radix, styles) {
            return value
        }
        let (negative, magnitude) = try parseInteger(text, radix, styles)
        let value = try signedValue(negative, magnitude, 9223372036854775807)
        return Int(value)
    }
}
