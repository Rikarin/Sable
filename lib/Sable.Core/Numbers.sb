    /// The number in decimal.
    @builtin("string_from_F32")
    public fn toString() -> String

    /// The number's distance from zero.
    @builtin("abs_F32")
    public fn abs() -> F32

    /// The smaller of the two.
    @builtin("min_F32")
    public fn min(other: F32) -> F32

    /// The larger of the two.
    @builtin("max_F32")
    public fn max(other: F32) -> F32
}

extension Bool {
    /// 'true' or 'false'.
    @builtin("string_from_Bool")
    public fn toString() -> String
}
