module Sable.Generators

// Source generators (docs/08). A generator is a function in a package's
// `generators/` directory, run for each declaration that carries its
// attribute:
//
//     @generator("json")
//     fn json(_ declaration: Declaration, into output: inout Output) { ... }
//
// or once for each package, with all of them:
//
//     @generator("route")
//     fn routes(_ pkg: Package, into output: inout Output) { ... }
//
// The compiler runs it in the interpreter. It is given the declarations as
// data and adds files to `output`, which are compiled with the package.

// ---- What a generator is given --------------------------------------------

/// A declaration that carries a generator's attribute: a type, a function
/// or a method.
public struct Declaration {
    /// How it is declared: "struct", "class", "actor", "union", "enum" or "fn".
    public var keyword: String
    /// Its name, as declared.
    public var name: String
    /// For a nested type or a method, the type it is in, as `Outer.Inner`;
    /// otherwise "".
    public var container: String = ""
    /// The module of the file it is in.
    public var moduleName: String
    /// Whether it is declared `public`.
    public var isPublic: Bool
    /// Whether it is declared `static`.
    public var isStatic: Bool = false
    /// Its generic parameters' names, in order.
    public var typeParameters: String[>..] = []
    /// Its base list, each entry as written.
    public var conformances: String[>..] = []
    /// Every protocol a type conforms to, by name: its base list's and
    /// those an extension declares.
    public var allConformances: String[>..] = []
    /// A class's superclass, by name.
    public var superclass: String? = none
    /// The attribute that started this run.
    public var trigger: Attribute = Attribute { name: "", arguments: [] }
    /// Every attribute on the declaration, the one that started this run among them.
    public var attributes: Attribute[>..] = []
    /// A type's stored fields, in order: a struct's, a class's or an actor's.
    public var fields: Field[>..] = []
    /// A type's cases, in order: a union's or an enum's.
    public var cases: Case[>..] = []
    /// A function's parameters, in order.
    public var parameters: Parameter[>..] = []
    /// A function's return type, as written; "" for none.
    public var returnType: String = ""
    /// A function's return type, resolved; none when it returns nothing.
    public var returned: TypeRef? = none
    /// Whether a function is `async`.
    public var isAsync: Bool = false
    /// Whether a function `throws`.
    public var isThrowing: Bool = false
    /// The imports of the file it is in, each as written after `import`.
    public var imports: String[>..] = []
    /// The name of the file it is in, for messages.
    public var file: String = ""
    /// Where it is: what a message that is about it is reported at.
    public var location: Location = Location { id: "" }

    /// The attribute named, if the declaration has it.
    public fn attribute(named name: String) -> Attribute? {
        for attribute in attributes {
            if attribute.name == name {
                return attribute
            }
        }
        return none
    }

    /// Whether the type conforms to the protocol named: in its base list,
    /// or by an extension.
    public fn conforms(to name: String) -> Bool {
        for conformance in allConformances {
            if conformance == name {
                return true
            }
        }
        for conformance in conformances {
            if conformance == name {
                return true
            }
        }
        return false
    }

    /// The name with its generic parameters, as a type is written:
    /// `Pair<A, B>`, or `User`.
    public var typeName: String => Declaration.written(name, typeParameters)

    /// The name as code outside the type writes it: `Outer.Inner`, or `User`.
    public var qualifiedName: String => Declaration.qualified(container, name)

    static fn written(_ name: String, _ parameters: String[>..]) -> String {
        if parameters.isEmpty {
            return name
        }
        var text = name + "<"
        var first = true
        for parameter in parameters {
            if !first {
                text = text + ", "
            }
            text = text + parameter
            first = false
        }
        return text + ">"
    }

    static fn qualified(_ container: String, _ name: String) -> String {
        if container.isEmpty {
            return name
        }
        return container + "." + name
    }
}

/// Where something a generator is given is in the source. A message
/// reported `at:` it points there.
public struct Location {
    var id: String
}

/// A type as the compiler resolved it.
public struct TypeRef {
    /// "struct", "class", "actor", "union", "enum", "protocol", "optional",
    /// "array", "dictionary", "tuple", "function", "parameter" for a generic
    /// parameter, or "unresolved".
    public var kind: String
    /// The type's name, without its module or arguments.
    public var name: String
    /// The module that declares it, or "".
    public var moduleName: String
    /// The whole type, as the compiler writes it.
    public var text: String
    /// Its generic arguments; an optional's or an array's element; a
    /// dictionary's key and value; a tuple's elements.
    public var arguments: TypeRef[>..] = []
    /// Every protocol it conforms to, by name.
    public var conformances: String[>..] = []
    /// The attributes on its declaration, by name.
    public var attributes: String[>..] = []

    /// Whether it conforms to the protocol named.
    public fn conforms(to name: String) -> Bool {
        for conformance in conformances {
            if conformance == name {
                return true
            }
        }
        return false
    }

    /// Whether its declaration carries the attribute named.
    public fn has(attribute name: String) -> Bool {
        for attribute in attributes {
            if attribute == name {
                return true
            }
        }
        return false
    }
}

/// An attribute as written: `@json(rename: "id")`.
public struct Attribute {
    /// Its name, without the `@`.
    public var name: String
    /// Its arguments, in order.
    public var arguments: Argument[>..]

    /// The source text of the argument with the label, if there is one.
    public fn argument(named label: String) -> String? {
        for argument in arguments {
            if argument.label == label {
                return argument.text
            }
        }
        return none
    }

    /// The value of the string literal given for the label, if it is one.
    public fn string(named label: String) -> String? {
        for argument in arguments {
            if argument.label == label {
                return argument.string
            }
        }
        return none
    }

    /// Whether the attribute has an argument with the label.
    public fn has(_ label: String) -> Bool {
        for argument in arguments {
            if argument.label == label {
                return true
            }
        }
        return false
    }
}

/// One argument of an attribute.
public struct Argument {
    /// Its label, or "" when it has none.
    public var label: String
    /// Its expression, as written.
    public var text: String
    /// The value, when the expression is a string literal without interpolation.
    public var string: String?
}

/// A stored field, or a union case's payload.
public struct Field {
    public var name: String
    /// Its type, as written.
    public var type: String
    /// Its type, resolved.
    public var resolved: TypeRef = TypeRef { kind: "unresolved", name: "", moduleName: "", text: "" }
    /// Whether it is a `var`, not a `let`.
    public var isMutable: Bool
    /// Whether it is given a value where it is declared.
    public var hasDefault: Bool
    /// Whether it is declared `public`.
    public var isPublic: Bool
    public var attributes: Attribute[>..] = []
    public var location: Location = Location { id: "" }

    /// The attribute named, if the field has it.
    public fn attribute(named name: String) -> Attribute? {
        for attribute in attributes {
            if attribute.name == name {
                return attribute
            }
        }
        return none
    }
}

/// A union's case and its payload, or an enum's case and its raw value.
public struct Case {
    public var name: String
    /// A union case's payload: each with its label, or "" for none.
    public var payload: Field[>..] = []
    /// An enum case's raw value, as written.
    public var rawValue: String? = none
    public var attributes: Attribute[>..] = []
    public var location: Location = Location { id: "" }

    /// The attribute named, if the case has it.
    public fn attribute(named name: String) -> Attribute? {
        for attribute in attributes {
            if attribute.name == name {
                return attribute
            }
        }
        return none
    }
}

/// A function's parameter.
public struct Parameter {
    /// Its argument label: "" for none (`_`), or its name when it has no other.
    public var label: String
    public var name: String
    /// Its type, as written.
    public var type: String
    /// Its type, resolved.
    public var resolved: TypeRef = TypeRef { kind: "unresolved", name: "", moduleName: "", text: "" }
    /// Whether it has a default value.
    public var hasDefault: Bool
    public var attributes: Attribute[>..] = []
    public var location: Location = Location { id: "" }

    /// The attribute named, if the parameter has it.
    public fn attribute(named name: String) -> Attribute? {
        for attribute in attributes {
            if attribute.name == name {
                return attribute
            }
        }
        return none
    }
}

/// What a package generator is given: the package, every declaration in it
/// that carries the generator's attribute, and the files its manifest lists
/// for its generators.
public struct Package {
    public var name: String
    public var declarations: Declaration[>..] = []
    public var inputs: InputFile[>..] = []

    /// The input at the path, relative to the package, if it is listed.
    public fn input(_ path: String) -> InputFile? {
        for file in inputs {
            if file.path == path {
                return file
            }
        }
        return none
    }
}

/// A file a package lists for its generators.
public struct InputFile {
    /// Its path, relative to the package, with '/' between the parts.
    public var path: String
    public var text: String
}

// ---- What a generator gives back ------------------------------------------

/// The files and messages a generator's run produces.
public struct Output {
    var names: String[>..] = []
    var texts: String[>..] = []
    var modules: String[>..] = []
    var messages: String[>..] = []

    public init() { }

    /// A new source file: declarations, and any imports they need beyond
    /// those of the declaration's file. The compiler adds the module line:
    /// the declaration's module, or the one named, which must be one the
    /// package declares.
    public mutating fn add(file name: String, _ text: String, inModule moduleName: String = "") {
        names.append(name)
        texts.append(text)
        modules.append(moduleName)
    }

    /// Fails the build, at the attribute that started this run.
    public mutating fn error(_ message: String) {
        messages.append("error\u{1f}\u{1f}" + message)
    }

    /// Fails the build, at the place given.
    public mutating fn error(_ message: String, at location: Location) {
        messages.append("error\u{1f}" + location.id + "\u{1f}" + message)
    }

    /// Warns, at the attribute that started this run.
    public mutating fn warning(_ message: String) {
        messages.append("warning\u{1f}\u{1f}" + message)
    }

    /// Warns, at the place given.
    public mutating fn warning(_ message: String, at location: Location) {
        messages.append("warning\u{1f}" + location.id + "\u{1f}" + message)
    }
}

// ---- Talking to the compiler ----------------------------------------------
// The compiler writes each request as lines of fields on standard input
// and reads the output as records on standard output. These are what the
// main it writes for a generator program calls; a generator never does.

/// One run: a declaration for a declaration generator, or a package for a
/// package generator.
public struct GeneratorRequest {
    public var generator: String
    public var index: String
    /// "d" for a declaration generator's run, "p" for a package generator's.
    public var kind: String
    public var pkg: Package
    /// The declaration, for a declaration generator's run.
    public var declaration: Declaration
}

/// The next request, or none at the end of the input.
public fn readGeneratorRequest() -> GeneratorRequest? {
    var reader = RequestReader()
    while let line = Runtime.readLine() {
        if reader.read(line.split(separator: '\u{1f}')) {
            return reader.request()
        }
    }
    return none
}

// A request as it is read: a type, a field, a case, a parameter or an
// attribute is kept here until it is whole, then added where it belongs.
struct RequestReader {
    var generator: String = ""
    var index: String = ""
    var kind: String = "d"
    var pkg: Package = Package { name: "" }
    var declaration: Declaration = RequestReader.empty()
    var types: TypeRef[>..] = []
    var type: TypeRef = TypeRef { kind: "", name: "", moduleName: "", text: "" }
    var hasType: Bool = false
    var field: Field = Field { name: "", type: "", isMutable: false, hasDefault: false, isPublic: false }
    var hasField: Bool = false
    var kase: Case = Case { name: "" }
    var hasCase: Bool = false
    var parameter: Parameter = Parameter { label: "", name: "", type: "", hasDefault: false }
    var hasParameter: Bool = false
    var attribute: Attribute = Attribute { name: "", arguments: [] }
    var hasAttribute: Bool = false
    // Where the attribute goes: "d" the declaration, "f" the field, "c" the
    // case, "q" the parameter.
    var target: String = "d"

    init() { }

    static fn empty() -> Declaration {
        return Declaration { keyword: "", name: "", moduleName: "", isPublic: false }
    }

    // Whether the line ends the request.
    mutating fn read(_ fields: String[>..]) -> Bool {
        let tag = fields[0]
        if tag != "YC" && tag != "YA" && tag != "YG" {
            finishType()
        }
        if tag == "R" {
            generator = fields[1]
            index = fields[2]
            kind = fields[3]
            pkg.name = fields[4]
        } else if tag == "N" {
            pkg.inputs.append(InputFile { path: restored(fields[1]), text: restored(fields[2]) })
        } else if tag == "Y" {
            type = TypeRef { kind: fields[2], name: fields[3], moduleName: fields[4], text: restored(fields[5]) }
            hasType = true
        } else if tag == "YC" {
            type.conformances.append(fields[1])
        } else if tag == "YA" {
            type.attributes.append(fields[1])
        } else if tag == "YG" {
            type.arguments.append(types[fields[1].toInt() ?? 0])
        } else if tag == "D" {
            declaration.keyword = fields[1]
            declaration.name = fields[2]
            declaration.container = fields[3]
            declaration.moduleName = fields[4]
            declaration.isPublic = fields[5] == "1"
            declaration.isStatic = fields[6] == "1"
            declaration.file = restored(fields[7])
            declaration.location = Location { id: fields[8] }
        } else if tag == "V" {
            declaration.isAsync = fields[1] == "1"
            declaration.isThrowing = fields[2] == "1"
            declaration.returnType = restored(fields[3])
            if fields[4] != "-1" {
                declaration.returned = resolvedType(fields[4])
            }
        } else if tag == "S" {
            declaration.superclass = fields[1]
        } else if tag == "I" {
            declaration.imports.append(restored(fields[1]))
        } else if tag == "T" {
            declaration.typeParameters.append(fields[1])
        } else if tag == "C" {
            declaration.conformances.append(restored(fields[1]))
        } else if tag == "X" {
            declaration.allConformances.append(fields[1])
        } else if tag == "A" {
            finishAttribute()
            target = fields[1]
            attribute = Attribute { name: fields[2], arguments: [] }
            hasAttribute = true
        } else if tag == "G" {
            var string: String? = none
            if fields[3] == "1" {
                string = restored(fields[4])
            }
            attribute.arguments.append(Argument { label: fields[1], text: restored(fields[2]), string: string })
        } else if tag == "F" {
            finishMember()
            field = Field {
                name: fields[1],
                type: restored(fields[2]),
                resolved: resolvedType(fields[7]),
                isMutable: fields[3] == "1",
                hasDefault: fields[4] == "1",
                isPublic: fields[5] == "1",
                location: Location { id: fields[6] }
            }
            hasField = true
        } else if tag == "K" {
            finishMember()
            var rawValue: String? = none
            if fields[2] == "1" {
                rawValue = restored(fields[3])
            }
            kase = Case { name: fields[1], rawValue: rawValue, location: Location { id: fields[4] } }
            hasCase = true
        } else if tag == "P" {
            kase.payload.append(Field {
                name: fields[1],
                type: restored(fields[2]),
                resolved: resolvedType(fields[3]),
                isMutable: false,
                hasDefault: false,
                isPublic: false
            })
        } else if tag == "Q" {
            finishMember()
            parameter = Parameter {
                label: fields[1],
                name: fields[2],
                type: restored(fields[3]),
                resolved: resolvedType(fields[6]),
                hasDefault: fields[4] == "1",
                location: Location { id: fields[5] }
            }
            hasParameter = true
        } else if tag == "E" {
            finishMember()
            pkg.declarations.append(declaration)
            declaration = RequestReader.empty()
            types = []
        } else if tag == "Z" {
            return true
        }
        return false
    }

    fn resolvedType(_ id: String) -> TypeRef {
        if let i = id.toInt() {
            if i >= 0 && i < types.count {
                return types[i]
            }
        }
        return TypeRef { kind: "unresolved", name: "", moduleName: "", text: "" }
    }

    mutating fn finishType() {
        if hasType {
            types.append(type)
            hasType = false
        }
    }

    mutating fn finishAttribute() {
        if !hasAttribute {
            return
        }
        if target == "f" {
            field.attributes.append(attribute)
        } else if target == "c" {
            kase.attributes.append(attribute)
        } else if target == "q" {
            parameter.attributes.append(attribute)
        } else {
            declaration.attributes.append(attribute)
            if attribute.name == generator {
                declaration.trigger = attribute
            }
        }
        hasAttribute = false
    }

    mutating fn finishMember() {
        finishAttribute()
        if hasField {
            declaration.fields.append(field)
            hasField = false
        }
        if hasCase {
            declaration.cases.append(kase)
            hasCase = false
        }
        if hasParameter {
            declaration.parameters.append(parameter)
            hasParameter = false
        }
    }

    fn request() -> GeneratorRequest {
        var first = RequestReader.empty()
        if !pkg.declarations.isEmpty {
            first = pkg.declarations[0]
        }
        return GeneratorRequest { generator: generator, index: index, kind: kind, pkg: pkg, declaration: first }
    }
}

/// Writes what a run produced, for the request with the index.
public fn writeGeneratorOutput(_ output: Output, for index: String) {
    print("\u{1e}run\u{1f}\(index)")
    for message in output.messages {
        print("\u{1e}\(flattened(message))")
    }
    var i = 0
    while i < output.names.count {
        print("\u{1e}file\u{1f}\(flattened(output.names[i]))\u{1f}\(flattened(output.modules[i]))")
        print(output.texts[i])
        i = i + 1
    }
}

// A value with a line break in it comes with each break as U+001D.
fn restored(_ text: String) -> String {
    if !text.contains('\u{1d}') {
        return text
    }
    return Runtime.joinStrings(text.split(separator: '\u{1d}'), "\n")
}

// A message or a file name is one line of the output.
fn flattened(_ text: String) -> String {
    if !text.contains('\n') {
        return text
    }
    return Runtime.joinStrings(text.split(separator: '\n'), " ")
}
