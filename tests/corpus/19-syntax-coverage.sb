/// Syntax the other programs don't use, so that the compiler fuzzer, which
/// mutates the repository's programs, has every node kind to work from.
module Corpus.SyntaxCoverage

import Sable.Core.{ Platform, Reflect as Reflection }

comptime {
    let width = 8
}

fn both(_ ok: () -> Int, onFail: () -> Int) -> Int => ok() + onFail()

fn classify(_ n: Int) -> String {
    switch n {
        case 0:
            return "zero"
        case 1, 2:
            return "small"
        default:
            return "large"
    }
}

fn sign(_ n: Int) -> Int {
    match n {
        case 0:
            return 0
        case let m where m > 0:
            return 1
        default:
            return -1
    }
}

fn describe(_ value: Int | String) -> String {
    return match value {
        case is Int     => "a number"
        case (let text) => "the text \(text)"
    }
}

fn first(_ values: Int?) -> Int {
    return match values {
        case let v? => v
        case none   => 0
    }
}

// A value generic parameter, given a number as a type argument.
struct Ring<T, N: Int> where N > 0 {
    var slots: T[N]
}

fn ringSize<T, N: Int>(_ ring: Ring<T, N>) -> Int {
    return N
}

// Every operator the other programs leave out.
fn operators(_ a: Int, _ b: Int, _ maybe: Int?) -> Int {
    var n = (a >> 1) &+ b &- 2 &* a
    n &= 255
    n |= 1
    n ^= 3
    n <<= 2
    n >>= 1
    n &+= b
    n &-= 1
    n &*= 3
    var other = maybe
    other ??= n
    let one = Box()
    return one !== Box() ? other! : 0
}

class Box {
    var watched: Int = 0 {
        willSet { print("to \(newValue)") }
        didSet { print("from \(oldValue)") }
    }
}

struct Bits {
    var all: Int

    package nonmutating fn taken() -> Bits {
        let copy = self
        return move copy
    }

    postfix operator ~ (m: Bits) -> Bits {
        return Bits { all: ~m.all }
    }
}

fn main() {
    let ring = Ring<Int, 2> { slots: [1, 2] }
    print(ringSize(ring))
    let small = Platform.pointerWidth / 4 + Reflection.typeName(1).count
    let size = if small > 10 { "big" } else { "small" }
    let total = both { 1 } onFail: { 2 }
    let forced: Int! = 3
    let kind: Int.Type = Int.self
    let list = Int[>..].self
    let optional = Int?.self
    print("\(size) \(total) \(classify(2)) \(describe(1)) \(first(4)) \(forced + 1) \(sign(-3))")
    print("\(Reflection.typeName(kind)) \(Reflection.typeName(list)) \(Reflection.typeName(optional))")
}

fn required(_ n: Int?) throws(String) -> Int {
    return n ?? throw "none given"
}
