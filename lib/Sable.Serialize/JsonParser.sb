module Sable.Serialize

// Makes a JsonDocument of a JsonReader's tokens, in one pass: a struct, so
// its arrays are its own and not checked for exclusive access as a class's
// stored properties are at each use.
struct JsonParser {
    var kinds: Int[>..] = []
    var starts: Int[>..] = []
    var ends: Int[>..] = []
    var firsts: Int[>..] = []
    var nexts: Int[>..] = []
    var counts: Int[>..] = []
    var escaped: Bool[>..] = []
    // The arrays and objects that are open, and the last node in each (a
    // value, or a key with none yet), the innermost's kept apart: -1 for
    // the first of either.
    var parents: Int[>..] = []
    var parent: Int = -1
    var last: Int = -1

    init() { }

    /// The document the bytes are, or why they are not JSON.
    static fn parse(_ bytes: U8[:], _ options: ParseOptions) throws(SerializeError) -> JsonDocument {
        return try parse(JsonReader(bytes, options: options), bytes)
    }

    /// The document the text is, or why it is not JSON.
    static fn parse(_ text: String, _ options: ParseOptions) throws(SerializeError) -> JsonDocument {
        let reader = JsonReader(text, options: options)
        return try parse(reader, reader.bytes)
    }

    static fn parse(_ reader: JsonReader, _ bytes: U8[:]) throws(SerializeError) -> JsonDocument {
        var parser = JsonParser()
        var reader = reader
        do {
            while let token = try reader.next() {
                if token == .Comment {
                    continue
                }
                if parser.last == 0 && parser.parent < 0 {
                    // A second value, where the options let there be one.
                    throw ParseError.TrailingText(at: reader.position)
                }
                parser.add(token, reader.valueStart, reader.valueEnd, reader.isEscaped)
            }
            if parser.last < 0 {
                throw reader.unexpected(reader.at, "a value")
            }
        } catch {
            throw SerializeError.Syntax(reason: "not JSON: \(describeError(error))")
        }
        return JsonDocument(
            bytes: bytes,
            kinds: parser.kinds,
            starts: parser.starts,
            ends: parser.ends,
            firsts: parser.firsts,
            nexts: parser.nexts,
            counts: parser.counts,
            escaped: parser.escaped
        )
    }

    mutating fn add(_ token: JsonToken, _ start: Int, _ end: Int, _ isEscaped: Bool) {
        match token {
            case .Key         => add(jsonString, start, end, isEscaped, isKey: true)
            case .String      => add(jsonString, start, end, isEscaped, isKey: false)
            case .Number      => add(jsonNumber, start, end, false, isKey: false)
            case .True        => add(jsonTrue, start, end, false, isKey: false)
            case .False       => add(jsonFalse, start, end, false, isKey: false)
            case .Null        => add(jsonNull, start, end, false, isKey: false)
            case .BeginObject => begin(jsonObject, start)
            case .BeginArray  => begin(jsonArray, start)
            default           => close(end)
        }
    }

    // A node after the last one; a member counts once, by its key, so an
    // object's value counts for nothing.
    @inline(always)
    mutating fn add(_ kind: Int, _ start: Int, _ end: Int, _ isEscaped: Bool, isKey: Bool) {
        let node = kinds.count
        if last >= 0 {
            nexts[last] = node
        } else if parent >= 0 {
            firsts[parent] = node
        }
        if parent >= 0 && (isKey || kinds[parent] == jsonArray) {
            counts[parent] += 1
        }
        last = node
        kinds.append(kind)
        starts.append(start)
        ends.append(end)
        firsts.append(-1)
        nexts.append(-1)
        counts.append(0)
        escaped.append(isEscaped)
    }

    mutating fn begin(_ kind: Int, _ start: Int) {
        add(kind, start, start, false, isKey: false)
        parents.append(parent)
        parent = last
        last = -1
    }

    mutating fn close(_ end: Int) {
        ends[parent] = end
        last = parent
        parent = parents.removeLast()
    }
}
