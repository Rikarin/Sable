module Sable.IO.Compression

import Sable.IO.Hashing

/// Zstandard (RFC 8878) decompressed as it comes: every frame of it, each
/// one's checksum checked where it has one, skippable frames passed over.
/// .NET's `ZstandardDecoder`.
///
/// ```sable
/// let decoder = ZstdDecoder()
/// var bytes = ByteBuffer()
/// let step = try! decoder.decompress(Zstd.compress([1, 2, 3]), into: &bytes)
/// assert(step.status == .Finished && bytes.bytes == [1, 2, 3])
/// ```
public final class ZstdDecoder: Decompressor {
    @derive(Equatable)
    enum Stage {
        /// Before a frame.
        Start
        /// Before a block's header.
        BlockHeader
        /// In a block of 'blockSize' bytes, of 'blockKind'.
        Block
        Checksum
        /// In a skippable frame, of which 'blockSize' bytes are left.
        Skipping
        /// After bytes that start no frame.
        Finished
    }

    let limits: DecompressionLimits
    let maximumWindow: Int
    let dictionary: ZstdDictionary?
    var input: InputBuffer
    var window: OutputWindow
    let blocks: ZstdBlocks
    var stage: Stage
    var blockKind: Int
    var blockSize: Int
    var isLast: Bool
    /// How many bytes this frame's blocks may have, how many it should have
    /// (or -1) and has, whether it has a checksum, and that.
    var maximumBlock: Int
    var contentSize: Int
    var frameLength: Int
    var hasChecksum: Bool
    var hash: XxHash64
    var hadFrame: Bool
    var totalRead: Int
    var totalWritten: Int

    /// Of frames of any length, windows of up to 128 MiB, and no dictionary.
    public init() {
        limits = DecompressionLimits()
        maximumWindow = 1 << 27
        dictionary = none
        input = InputBuffer(capacity: 2 * 131072)
        window = OutputWindow(history: 0, room: 131072)
        blocks = ZstdBlocks()
        stage = .Start
        blockKind = 0
        blockSize = 0
        isLast = false
        maximumBlock = 0
        contentSize = -1
        frameLength = 0
        hasChecksum = false
        hash = XxHash64()
        hadFrame = false
        totalRead = 0
        totalWritten = 0
    }

    /// Decompressing no more than the limits, of frames that need a window of
    /// no more than so many bytes, with a dictionary, if with one.
    public init(limits: DecompressionLimits, maximumWindow: Int = 1 << 27, dictionary: ZstdDictionary? = none) {
        precondition(maximumWindow >= 1024, "a window of \(maximumWindow) bytes")
        self.limits = limits
        self.maximumWindow = maximumWindow
        self.dictionary = dictionary
        input = InputBuffer(capacity: 2 * 131072)
        window = OutputWindow(history: 0, room: 131072)
        blocks = ZstdBlocks()
        stage = .Start
        blockKind = 0
        blockSize = 0
        isLast = false
        maximumBlock = 0
        contentSize = -1
        frameLength = 0
        hasChecksum = false
        hash = XxHash64()
        hadFrame = false
        totalRead = 0
        totalWritten = 0
    }

    public static var isConcatenable: Bool => true

    public var isFinished: Bool => (stage == .Start && hadFrame && input.count == 0 || stage == .Finished) && window.pending == 0

    public fn decompress(_ source: U8[:], into output: inout ByteBuffer, limit: Int) throws(CompressionError) -> CompressionProgress {
        precondition(limit >= 0, "a limit of \(limit) bytes")
        var consumed = 0
        var produced = 0
        while true {
            produced += window.drain(into: &output, limit: limit - produced)
            if window.pending > 0 {
                let back = input.giveBack()
                totalRead -= back
                return CompressionProgress(consumed: consumed - back, produced: produced, status: .NeedsOutput)
            }
            if try self.step() {
                if stage == .Finished {
                    let back = input.giveBack()
                    totalRead -= back
                    return CompressionProgress(consumed: consumed - back, produced: produced, status: .Finished)
                }
                continue
            }
            let taken = consumed < source.count ? input.fill(source, from: consumed) : 0
            if taken == 0 {
                let status = isFinished ? CompressionStatus.Finished : CompressionStatus.NeedsInput
                return CompressionProgress(consumed: consumed, produced: produced, status: status)
            }
            consumed += taken
            totalRead += taken
        }
    }

    /// One thing done, with nothing pending: false where it needs input.
    fn step() throws(CompressionError) -> Bool {
        match stage {
            case .Start       => { return try self.startFrame() }
            case .BlockHeader => { return try self.startBlock() }
            case .Block       => { return try self.decodeBlock() }
            case .Checksum => {
                if input.count < 4 {
                    return false
                }
                unsafe {
                    if load32(input.position) != hash.value unchecked as U32 {
                        throw .Corrupt("the checksum is wrong")
                    }
                }
                input.position += 4
                stage = .Start
                return true
            }
            case .Skipping => {
                let skipped = blockSize < input.count ? blockSize : input.count
                input.position += skipped
                blockSize -= skipped
                if blockSize > 0 {
                    return false
                }
                stage = .Start
                return true
            }
            case .Finished => { return true }
        }
    }

    fn startFrame() throws(CompressionError) -> Bool {
        let at = input.position
        let count = input.count
        if count == 0 {
            return false
        }
        unsafe {
            // As much of a magic number as there is, and more than that only
            // where it is one.
            let have = count < 4 ? count : 4
            let mask = have == 4 ? 0xFFFF_FFFF : (1 << (8 * have)) - 1
            let word = (load32(at) unchecked as Int) & mask
            let isFrame = word == (0xFD2F_B528 & mask)
            let isSkippable = (word & ~0xF) == (0x184D_2A50 & mask & ~0xF)
            if !isFrame && !isSkippable {
                if hadFrame {
                    stage = .Finished
                    return true
                }
                throw .Corrupt("no zstd frame")
            }
            if count < 4 {
                return false
            }
            if !isFrame {
                if count < 8 {
                    return false
                }
                blockSize = load32(at + 4) unchecked as Int
                input.position = at + 8
                stage = .Skipping
                hadFrame = true
                return true
            }
            if count < 5 {
                return false
            }
            let descriptor = load8(at + 4)
            let isSingle = (descriptor & 0x20) != 0
            let idSize = (descriptor & 3) == 3 ? 4 : descriptor & 3
            let sizeFlag = descriptor >> 6
            let sizeSize = sizeFlag == 0 ? (isSingle ? 1 : 0) : 1 << sizeFlag
            let header = 5 + (isSingle ? 0 : 1) + idSize + sizeSize
            if count < header {
                return false
            }
            if (descriptor & 8) != 0 {
                throw .Corrupt("a frame header of no known kind")
            }
            var from = at + 5
            var windowSize = 0
            if !isSingle {
                let code = load8(from)
                from += 1
                let base = 1 << (10 + (code >> 3))
                windowSize = base + base / 8 * (code & 7)
            }
            let id = idSize == 0 ? 0 : (idSize == 1 ? load8(from) : (idSize == 2 ? load16(from) : load32(from) unchecked as Int))
            from += idSize
            contentSize = match sizeSize {
                case 0 => -1
                case 1 => load8(from)
                case 2 => load16(from) + 256
                case 4 => load32(from) unchecked as Int
                case _ => load64(from) unchecked as Int
            }
            from += sizeSize
            if sizeSize == 8 && contentSize < 0 {
                throw .Corrupt("a frame of more bytes than there are")
            }
            if isSingle {
                windowSize = contentSize
            }
            if id != 0 && id != (dictionary?.id ?? 0) unchecked as Int {
                throw .DictionaryNeeded(id: id unchecked as U32)
            }
            if windowSize > maximumWindow {
                throw .WindowTooLarge(bytes: windowSize)
            }
            if contentSize > limits.maximumLength - totalWritten {
                throw .LimitExceeded
            }
            maximumBlock = windowSize < ZstdBlocks.maxBlock ? windowSize : ZstdBlocks.maxBlock
            hasChecksum = (descriptor & 4) != 0
            frameLength = 0
            hash = XxHash64()
            hadFrame = true
            input.position = from
            window.forget()
            let known = dictionary == none ? 0 : dictionary!.content.count
            let reach = contentSize >= 0 && contentSize < windowSize ? contentSize : windowSize
            window.setHistory(reach + known, total: contentSize >= 0 ? contentSize + known : Int.max)
            if known > 0 {
                window.makeRoom(for: known)
                window.addDictionary(dictionary!.content)
            }
            blocks.entropy.reset(dictionary)
            stage = .BlockHeader
        }
        return true
    }

    fn startBlock() throws(CompressionError) -> Bool {
        if input.count < 3 {
            return false
        }
        unsafe {
            let header = load16(input.position) | load8(input.position + 2) << 16
            isLast = (header & 1) != 0
            blockKind = header >> 1 & 3
            blockSize = header >> 3
        }
        input.position += 3
        if blockKind == 3 {
            throw .Corrupt("a block of no known type")
        }
        if blockSize > maximumBlock {
            throw .Corrupt("a block larger than the window")
        }
        stage = .Block
        return true
    }

    fn decodeBlock() throws(CompressionError) -> Bool {
        let size = blockKind == 1 ? 1 : blockSize
        if input.count < size {
            return false
        }
        window.makeRoom(for: ZstdBlocks.maxBlock)
        let before = window.end
        unsafe {
            if blockKind == 0 {
                copyBytes(from: input.position, to: before, size)
                window.end = before + size
            } else if blockKind == 1 {
                fillBytes(before, with: load8(input.position) unchecked as U8, blockSize)
                window.end = before + blockSize
            } else if let problem = blocks.decode(input.position, count: size, into: &window, most: maximumBlock) {
                throw .Corrupt(problem)
            }
            let written = window.end - before
            if hasChecksum {
                hash.update(at: before, count: written)
            }
            frameLength += written
            totalWritten += written
        }
        input.position += size
        if !limits.allows(written: totalWritten, read: totalRead - input.count) {
            throw .LimitExceeded
        }
        if contentSize >= 0 && frameLength > contentSize {
            throw .Corrupt("a frame longer than it says")
        }
        stage = .BlockHeader
        if isLast {
            if contentSize >= 0 && frameLength != contentSize {
                throw .Corrupt("a frame shorter than it says")
            }
            stage = hasChecksum ? .Checksum : .Start
        }
        return true
    }
}
