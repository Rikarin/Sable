module Sable.IO

/// Paths as text: FilePath's calls for a String, read by the system's own
/// rules ('/' between the parts, and on Windows '\' as well).
public struct Path {
    /// The two paths, one inside the other; one that stands alone (an
    /// absolute one) replaces the first.
    public static fn join(_ first: String, _ second: String) -> String {
        return text(FilePath(first).appending(second))
    }

    /// The last part when it is a name; "" when there is none.
    public static fn fileName(_ path: String) -> String {
        return FilePath(path).fileName ?? ""
    }

    /// Everything before the last part; "." for a bare name, the root
    /// itself at the root.
    public static fn directory(_ path: String) -> String {
        if let parent = FilePath(path).parent {
            return parent.isEmpty ? "." : text(parent)
        }
        return FilePath(path).isEmpty ? "." : path
    }

    /// What follows the name's last '.', when it has one not at its start.
    public static fn extension(_ path: String) -> String? {
        return FilePath(path).pathExtension
    }

    /// The path without its name's extension.
    public static fn withoutExtension(_ path: String) -> String {
        return text(FilePath(path).withExtension(""))
    }

    /// The path with '.' and each '..' with the name before it taken out.
    public static fn normalized(_ path: String) -> String {
        return text(FilePath(path).lexicallyNormalized())
    }

    /// The path from the base to the path, or none when there is none.
    public static fn relative(_ path: String, to base: String) -> String? {
        if let relative = FilePath(path).relative(to: FilePath(base)) {
            return text(relative)
        }
        return none
    }

    /// Whether the path names one place whatever the working directory.
    public static fn isAbsolute(_ path: String) -> Bool {
        return FilePath(path).isAbsolute
    }

    static fn text(_ path: FilePath) -> String {
        return "\(path)"
    }
}
