module Sable.DependencyInjection

/// What a scope, or a provider, is to dispose, in the order it was made: what
/// the code `@container` writes keeps them in.
///
/// ```sable
/// class Connection: Disposable {
///     fn dispose() { print("closed") }
/// }
///
/// var made = Disposals()
/// made.note(Connection())
/// made.disposeAll()
/// assert(made.isEmpty)
/// ```
public struct Disposals {
    var made: Disposal[>..] = []

    public init() { }

    /// Whether there is nothing to dispose.
    public var isEmpty: Bool => made.isEmpty

    /// Something made: kept, when it is Disposable or AsyncDisposable.
    public mutating fn note(_ value: any Any) {
        if let waits = value as? any AsyncDisposable {
            made.append(Disposal.Waits(service: waits))
        } else if let ends = value as? any Disposable {
            made.append(Disposal.Ends(service: ends))
        }
    }

    /// Disposes it all, the last made first. What is only AsyncDisposable, and
    /// cannot be waited for here, is a trap.
    // Taken out one at a time, since one may be released
    // by being disposed, and what it held before anything made earlier is.
    public mutating fn disposeAll() {
        while !made.isEmpty {
            match made.removeLast() {
                case .Ends(let service) => {
                    service.dispose()
                }
                case .Waits(let service) => {
                    if let ends = service as? any Disposable {
                        ends.dispose()
                    } else {
                        fatalError("\(type(of: service).name) is only AsyncDisposable: its scope must be a withAsyncScope's, or its provider's disposeAsync be awaited")
                    }
                }
            }
        }
    }

    /// Disposes it all, the last made first, waiting for each AsyncDisposable.
    public mutating async fn disposeAllAsync() {
        while !made.isEmpty {
            match made.removeLast() {
                case .Ends(let service) => {
                    service.dispose()
                }
                case .Waits(let service) => {
                    await service.disposeAsync()
                }
            }
        }
    }
}
