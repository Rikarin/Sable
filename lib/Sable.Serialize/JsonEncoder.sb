module Sable.Serialize

/// The Encoder that writes JSON, as it goes — no tree is built — compact,
/// or indented when asked: a struct or a map as an object, a sequence as an
/// array, bytes as a base64 string, a case that carries nothing as its name
/// and one that does as `{"Name": payload}`. What `Json.encode` uses.
///
/// ```sable
/// let encoder = JsonEncoder()
/// try! encoder.beginMap(count: 1)
/// try! encoder.encodeKey("tags")
/// try! encoder.beginSequence(count: 2)
/// try! encoder.encodeString("a\"b")
/// try! encoder.encodeInt(-3)
/// try! encoder.endSequence()
/// try! encoder.endMap()
/// assert(encoder.text() == "{\"tags\":[\"a\\\"b\",-3]}")
/// ```
public final class JsonEncoder: Encoder {
    var writer: JsonWriter
    // Whether the object written next is to be part of the one open.
    var flattening: Bool = false
    // For each object open: whether it is part of the one around it.
    var flattened: Bool[>..] = []

    /// An encoder writing compact JSON, or JSON indented by that many spaces.
    public init(indent: Int = 0) {
        self.writer = JsonWriter(options: indent > 0 ? pretty(indent) : compact())
    }

    /// The JSON written.
    public fn text() -> String {
        return writer.toString()
    }

    /// The JSON written, as UTF-8.
    public fn bytes() -> U8[>..] {
        return writer.pending.toArray()
    }

    fn beforeValue() throws(SerializeError) {
        if flattening {
            throw SerializeError.InvalidValue(path: "$", reason: "only a struct or a map can be flattened")
        }
    }

    public fn encodeNull() throws(SerializeError) {
        try beforeValue()
        writer.writeNull()
    }

    public fn encodeBool(_ value: Bool) throws(SerializeError) {
        try beforeValue()
        writer.writeBool(value)
    }

    public fn encodeInt(_ value: Int) throws(SerializeError) {
        try beforeValue()
        writer.writeInt(value)
    }

    public fn encodeUInt(_ value: U64) throws(SerializeError) {
        try beforeValue()
        writer.writeUInt(value)
    }

    /// A number; JSON has no NaN or infinity, which are refused.
    public fn encodeFloat(_ value: F64) throws(SerializeError) {
        try beforeValue()
        try writer.writeFloat(value)
    }

    public fn encodeString(_ value: String) throws(SerializeError) {
        try beforeValue()
        writer.writeString(value)
    }

    /// Bytes, as a string of their base64 (RFC 4648, padded).
    public fn encodeBytes(_ value: U8[>..]) throws(SerializeError) {
        try beforeValue()
        writer.writeBase64(value)
    }

    fn openObject() throws(SerializeError) {
        flattened.append(flattening)
        if flattening {
            flattening = false
            return
        }
        writer.writeBeginObject()
    }

    fn closeObject() {
        if !flattened.removeLast() {
            writer.writeEndObject()
        }
    }

    /// An array.
    public fn beginSequence(count: Int?) throws(SerializeError) {
        try beforeValue()
        writer.writeBeginArray()
    }

    public fn endSequence() throws(SerializeError) {
        writer.writeEndArray()
    }

    /// An object.
    public fn beginMap(count: Int?) throws(SerializeError) {
        try openObject()
    }

    public fn encodeKey(_ key: String) throws(SerializeError) {
        try beforeValue()
        writer.writeKey(key)
    }

    public fn endMap() throws(SerializeError) {
        closeObject()
    }

    /// An object, as a map is.
    public fn beginStruct(_ name: String, count: Int?) throws(SerializeError) {
        try openObject()
    }

    public fn encodeField(_ key: String) throws(SerializeError) {
        try beforeValue()
        writer.writeKey(key)
    }

    public fn endStruct() throws(SerializeError) {
        closeObject()
    }

    public fn flattenNext() throws(SerializeError) {
        flattening = true
    }

    /// The case's name, as a string.
    public fn encodeUnitCase(_ name: String, of type: String) throws(SerializeError) {
        try encodeString(name)
    }

    /// An object of one member, the case's name, whose value is the payload.
    public fn beginCase(_ name: String, of type: String) throws(SerializeError) {
        try openObject()
        try encodeKey(name)
    }

    public fn endCase() throws(SerializeError) {
        closeObject()
    }
}
