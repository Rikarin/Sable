module Utf8Tests

// Utf8 and Utf8Error (Sable.Text), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Testing
import Sable.Text
import TextSupport

fn errorOf(_ bytes: U8[>..]) -> String {
    if let error = Utf8.error(in: bytes) {
        return error.debugDescription()
    }
    return "valid"
}

@test(arguments: [
    ([], "nothing"),
    ([0x61, 0x7F], "ASCII"),
    ([0xC2, 0x80, 0xDF, 0xBF], "two-byte sequences at both ends of their range"),
    ([0xE0, 0xA0, 0x80, 0xED, 0x9F, 0xBF, 0xEE, 0x80, 0x80, 0xEF, 0xBF, 0xBF], "three-byte sequences"),
    ([0xF0, 0x90, 0x80, 0x80, 0xF4, 0x8F, 0xBF, 0xBF], "four-byte sequences, up to U+10FFFF"),
])
fn wellFormedTextIsValid(_ bytes: U8[>..], _ what: String) {
    expect(Utf8.isValid(bytes), what)
}

@test
fn validTextHasNoError() {
    expect(Utf8.validate([0x68, 0x69]) == none, "no error")
}

@test(arguments: [
    ([0x80], "invalid UTF-8 at byte 0 (1 byte)"),
    ([0x61, 0xC0, 0xAF], "invalid UTF-8 at byte 1 (1 byte)"),
    ([0xC1, 0xBF], "invalid UTF-8 at byte 0 (1 byte)"),
    ([0xE0, 0x80, 0x80], "invalid UTF-8 at byte 0 (1 byte)"),
    ([0xED, 0xA0, 0x80], "invalid UTF-8 at byte 0 (1 byte)"),
    ([0xF0, 0x80, 0x80, 0x80], "invalid UTF-8 at byte 0 (1 byte)"),
    ([0xF4, 0x90, 0x80, 0x80], "invalid UTF-8 at byte 0 (1 byte)"),
    ([0xF5, 0x80], "invalid UTF-8 at byte 0 (1 byte)"),
    ([0xFF], "invalid UTF-8 at byte 0 (1 byte)"),
    ([0x61, 0xE2, 0x82, 0x28], "invalid UTF-8 at byte 1 (2 bytes)"),
    ([0xF0, 0x9F, 0x98, 0x41], "invalid UTF-8 at byte 0 (3 bytes)"),
    ([0xC3, 0x28], "invalid UTF-8 at byte 0 (1 byte)"),
])
fn eachKindOfIllFormedSequenceIsFound(_ bytes: U8[>..], _ error: String) {
    assertEqual(errorOf(bytes), error)
}

@test(arguments: [
    ([0x61, 0xC3], "incomplete UTF-8 at byte 1"),
    ([0xE2, 0x82], "incomplete UTF-8 at byte 0"),
    ([0xF0, 0x9F, 0x98], "incomplete UTF-8 at byte 0"),
])
fn aSequenceCutShortIsIncomplete(_ bytes: U8[>..], _ error: String) {
    assertEqual(errorOf(bytes), error)
}

@test
fn anIncompleteSequenceHasNoLength() {
    let error = Utf8.error(in: [0x61, 0xF0, 0x9F])!
    assertEqual(error.validUpTo, 1)
    expect(error.errorLength == none, "no length for an incomplete sequence")
}

@test
fn validatingAfterLongAsciiRuns() {
    // Past the sixteen-byte blocks the runtime checks at once, and at each
    // place in one.
    var position = 0
    while position < 40 {
        var values: U8[>..] = []
        var i = 0
        while i < 40 {
            values.append(i == position ? 0xFF as U8 : 0x41)
            i = i + 1
        }
        assertEqual(Utf8.validate(values) ?? -1, position)
        position = position + 1
    }
}

@test
fn validatingAcrossBlocksOfMixedText() {
    // Text of two-, three- and four-byte scalars, checked natively sixteen
    // bytes a block: a stray byte at each place, and a sequence cut short
    // at each length, is found where it starts.
    let scalars: U8[>..] = [0x61, 0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80, 0xED, 0x9F, 0xBF]
    var text: U8[>..] = []
    while text.count < 60 {
        text.append(contentsOf: scalars)
    }
    expect(Utf8.isValid(text), "well-formed")

    var position = 0
    while position < 60 {
        // A continuation byte where a scalar starts, or a lead byte where
        // a continuation belongs: either way the scalar there is wrong.
        var values = text
        values[position] = values[position] >= 0x80 && values[position] < 0xC0 ? 0x41 : 0x80
        let at = Utf8.validate(values) ?? -1
        var start = position
        while start > 0 && text[start] >= 0x80 && text[start] < 0xC0 {
            start = start - 1
        }
        assert(at == start || at == position, "a broken scalar at \(position) is found at \(at)")

        // The bytes up to here, which may end inside a scalar.
        var head: U8[>..] = []
        var i = 0
        while i < position {
            head.append(text[i])
            i = i + 1
        }
        let cut = position < text.count && text[position] >= 0x80 && text[position] < 0xC0
        assertEqual(Utf8.validate(head) ?? -1, cut ? start : -1)
        position = position + 1
    }
}

@test(arguments: [(0x41, 1), (0xC3, 2), (0xE2, 3), (0xF0, 4)])
fn sequenceLengthsByLeadByte(_ lead: U8, _ length: Int) {
    assertEqual(Utf8.sequenceLength(lead: lead), length)
}

@test(arguments: [
    (0x80, "a continuation byte leads nothing"),
    (0xC0, "0xC0 only leads overlong forms"),
    (0xF5, "0xF5 leads past U+10FFFF"),
])
fn whatLeadsNoSequenceHasNoLength(_ lead: U8, _ why: String) {
    expect(Utf8.sequenceLength(lead: lead) == none, why)
}

@test
fn errorsCompare() {
    expect(Utf8Error(validUpTo: 1, errorLength: 2) == Utf8Error(validUpTo: 1, errorLength: 2), "equal")
    expect(Utf8Error(validUpTo: 1, errorLength: 2) != Utf8Error(validUpTo: 1, errorLength: none), "lengths differ")
    expect(Utf8Error(validUpTo: 1, errorLength: 2) != Utf8Error(validUpTo: 2, errorLength: 2), "places differ")
}

// Each string of bytes: validation, strict and lossy decoding, and the
// decoder fed in chunks must tell the same story.
@test
fn fuzzingAgreesWithDecodingScalarByScalar() {
    forAll(nearlyUtf8.array(count: 0...23), Gen.number(in: 1...5).array(count: 0...23), cases: 400) { (values: U8[>..], cuts: Int[>..]) in
        let lossy = String.fromUtf8Lossy(values)
        if let at = Utf8.validate(values) {
            expect(Utf8.error(in: values)?.validUpTo == at)
            expect(lossy.contains('\u{FFFD}'), "an error is replaced")
            expectNoThrow("the bytes before the error are valid") { try String.fromUtf8(values[..<at]) }
        } else {
            expect(try String.fromUtf8(values) == lossy)
            expect(lossy.utf8Count == values.count)
        }
        expect(Utf8.isValid(lossy.utf8Bytes()), "lossy decoding gives valid UTF-8")
        var decoder = Utf8Decoder()
        var streamed = ""
        for chunk in chunks(values.count, cuts) {
            streamed = streamed + decoder.decode(values[chunk])
        }
        streamed = streamed + decoder.finish()
        expect(streamed == lossy)
    }
}
