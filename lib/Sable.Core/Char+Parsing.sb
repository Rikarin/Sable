module Sable.Core

extension Char: Parsable {
    /// The one scalar the text is, as `format` writes it: `.Empty` for no
    /// scalar, `.Invalid(at: 1)` for more than one.
    ///
    /// ```sable
    /// assert(try! Char.parse("é") == 'é')
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S) throws(ParseError) -> Char {
        let piece = text.asSubstring
        if piece.isEmpty {
            throw .Empty
        }
        if piece.index(after: piece.startIndex) != piece.endIndex {
            throw .Invalid(at: 1)
        }
        return piece[piece.startIndex]
    }
}
