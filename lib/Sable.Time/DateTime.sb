module Sable.Time

/// A moment in UTC: seconds since 1970-01-01T00:00:00Z, and the nanoseconds
/// into that second.
public struct DateTime: Comparable, Hashable {
    public var secondsSinceEpoch: Int
    public var nanosecond: Int

    public static fn now() -> DateTime {
        let n = Runtime.wallClockNanoseconds()
        return DateTime { secondsSinceEpoch: floorDivide(n, 1000000000), nanosecond: floorModulo(n, 1000000000) }
    }

    public static fn fromUnix(_ seconds: Int) -> DateTime {
        return DateTime { secondsSinceEpoch: seconds, nanosecond: 0 }
    }

    /// The moment the fields name; none when one is out of range (a 30th of February, an hour of 24).
    public static fn of(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int) -> DateTime? {
        if month < 1 || month > 12 || day < 1 || day > daysInMonth(year, month) {
            return none
        }
        if hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59 {
            return none
        }
        let days = daysFromCivil(year, month, day)
        return DateTime { secondsSinceEpoch: days * 86400 + hour * 3600 + minute * 60 + second, nanosecond: 0 }
    }

    var days: Int => floorDivide(secondsSinceEpoch, 86400)
    var secondOfDay: Int => floorModulo(secondsSinceEpoch, 86400)

    public var year: Int => civilYear(days)
    public var month: Int => civilMonth(days)
    public var day: Int => civilDay(days)
    public var hour: Int => secondOfDay / 3600
    public var minute: Int => secondOfDay / 60 % 60
    public var second: Int => secondOfDay % 60

    /// ISO 8601's: 1 for Monday through 7 for Sunday.
    public var weekday: Int => floorModulo(days + 3, 7) + 1

    /// 1 for the first of January.
    public var dayOfYear: Int => days - daysFromCivil(year, 1, 1) + 1

    public fn adding(_ duration: Duration) -> DateTime {
        let total = nanosecond + floorModulo(duration.totalNanoseconds, 1000000000)
        return DateTime {
            secondsSinceEpoch: secondsSinceEpoch + floorDivide(duration.totalNanoseconds, 1000000000) + total / 1000000000,
            nanosecond: total % 1000000000,
        }
    }

    public fn durationSince(_ earlier: DateTime) -> Duration {
        return Duration {
            totalNanoseconds: (secondsSinceEpoch - earlier.secondsSinceEpoch) * 1000000000 + nanosecond - earlier.nanosecond
        }
    }

    /// "2026-11-17T09:05:03Z": to the second.
    public fn iso8601() -> String {
        return isoDate() + "T" + two(hour) + ":" + two(minute) + ":" + two(second) + "Z"
    }

    /// "2026-11-17".
    public fn isoDate() -> String {
        var y = year.toString()
        while y.count < 4 {
            y = "0" + y
        }
        return y + "-" + two(month) + "-" + two(day)
    }

    public operator == (a: DateTime, b: DateTime) -> Bool {
        return a.secondsSinceEpoch == b.secondsSinceEpoch && a.nanosecond == b.nanosecond
    }

    public operator < (a: DateTime, b: DateTime) -> Bool {
        if a.secondsSinceEpoch != b.secondsSinceEpoch {
            return a.secondsSinceEpoch < b.secondsSinceEpoch
        }
        return a.nanosecond < b.nanosecond
    }

    public fn hash(into hasher: inout Hasher) {
        hasher.combine(secondsSinceEpoch)
        hasher.combine(nanosecond)
    }
}

public fn isLeapYear(_ year: Int) -> Bool {
    return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

public fn daysInMonth(_ year: Int, _ month: Int) -> Int {
    if month == 2 {
        if isLeapYear(year) {
            return 29
        }
        return 28
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30
    }
    return 31
}

// Days since 1970-01-01 to a civil date and back: Howard Hinnant's
// algorithms, over 400-year eras so that every year works.

fn daysFromCivil(_ year: Int, _ month: Int, _ day: Int) -> Int {
    var y = year
    if month <= 2 {
        y -= 1
    }
    let era = floorDivide(y, 400)
    let yearOfEra = y - era * 400
    var shifted = month - 3
    if month <= 2 {
        shifted = month + 9
    }
    let dayOfYear = (153 * shifted + 2) / 5 + day - 1
    let dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear
    return era * 146097 + dayOfEra - 719468
}

fn civilDayOfEra(_ days: Int) -> Int {
    return floorModulo(days + 719468, 146097)
}

fn civilYearOfEra(_ days: Int) -> Int {
    let dayOfEra = civilDayOfEra(days)
    return (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
}

fn civilShiftedDayOfYear(_ days: Int) -> Int {
    let yearOfEra = civilYearOfEra(days)
    return civilDayOfEra(days) - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
}

fn civilShiftedMonth(_ days: Int) -> Int {
    return (5 * civilShiftedDayOfYear(days) + 2) / 153
}

fn civilMonth(_ days: Int) -> Int {
    let shifted = civilShiftedMonth(days)
    if shifted < 10 {
        return shifted + 3
    }
    return shifted - 9
}

fn civilDay(_ days: Int) -> Int {
    return civilShiftedDayOfYear(days) - (153 * civilShiftedMonth(days) + 2) / 5 + 1
}

fn civilYear(_ days: Int) -> Int {
    let year = civilYearOfEra(days) + floorDivide(days + 719468, 146097) * 400
    if civilMonth(days) <= 2 {
        return year + 1
    }
    return year
}

fn floorDivide(_ a: Int, _ b: Int) -> Int {
    let q = a / b
    if a % b != 0 && (a < 0) != (b < 0) {
        return q - 1
    }
    return q
}

fn floorModulo(_ a: Int, _ b: Int) -> Int {
    return a - floorDivide(a, b) * b
}

fn two(_ n: Int) -> String {
    if n < 10 {
        return "0" + n.toString()
    }
    return n.toString()
}

extension DateTime: Parsable {
    /// The moment an ISO 8601 text names, as `iso8601()` and `isoDate()`
    /// write it: a date, `2026-11-17`, midnight UTC; or a date and a time,
    /// `2026-11-17T09:05:03`, with a fraction of a second if it likes
    /// (`.250`, to the nanosecond), and `Z` or an offset from UTC
    /// (`+02:00`, `-0530`) after — none at all is taken as UTC. A field out
    /// of range, a 30th of February, is `.Invalid` where it is.
    ///
    /// ```sable
    /// let moment = try! DateTime.parse("2024-02-29T23:59:59.5+01:00")
    /// assert(moment.iso8601() == "2024-02-29T22:59:59Z" && moment.nanosecond == 500000000)
    /// assert(try! DateTime.parse("2026-11-17").isoDate() == "2026-11-17")
    /// assert((try? DateTime.parse("2023-02-29")) == none)
    /// ```
    public static fn parse<S: StringProtocol>(_ source: S) throws(ParseError) -> DateTime {
        let text = source.toString()
        let count = text.count
        if count == 0 {
            throw .Empty
        }
        let year = try field(text, 0, 4)
        try expect(text, 4, '-')
        let month = try field(text, 5, 7)
        try expect(text, 7, '-')
        let day = try field(text, 8, 10)
        if month < 1 || month > 12 {
            throw .Invalid(at: 5)
        }
        if day < 1 || day > daysInMonth(year, month) {
            throw .Invalid(at: 8)
        }
        let date = daysFromCivil(year, month, day) * 86400
        if count == 10 {
            return DateTime { secondsSinceEpoch: date, nanosecond: 0 }
        }
        if text.at(10) != 'T' && text.at(10) != 't' && text.at(10) != ' ' {
            throw .Invalid(at: 10)
        }
        let hour = try field(text, 11, 13)
        try expect(text, 13, ':')
        let minute = try field(text, 14, 16)
        try expect(text, 16, ':')
        let second = try field(text, 17, 19)
        if hour > 23 {
            throw .Invalid(at: 11)
        }
        if minute > 59 {
            throw .Invalid(at: 14)
        }
        if second > 59 {
            throw .Invalid(at: 17)
        }
        var i = 19
        var nanosecond = 0
        if i < count && (text.at(i) == '.' || text.at(i) == ',') {
            i += 1
            var digits = 0
            while i < count && text.at(i).isDigit {
                if digits < 9 {
                    nanosecond = nanosecond * 10 + (text.at(i).codePoint - 48)
                    digits += 1
                }
                i += 1
            }
            if digits == 0 {
                throw .InvalidDigit(at: i)
            }
            while digits < 9 {
                nanosecond *= 10
                digits += 1
            }
        }
        var offset = 0
        if i < count {
            let mark = text.at(i)
            if mark == 'Z' || mark == 'z' {
                i += 1
            } else if mark == '+' || mark == '-' {
                let hours = try field(text, i + 1, i + 3)
                var after = i + 3
                if after < count && text.at(after) == ':' {
                    after += 1
                }
                let minutes = try field(text, after, after + 2)
                if hours > 23 || minutes > 59 {
                    throw .Invalid(at: i + 1)
                }
                offset = (hours * 3600 + minutes * 60) * (mark == '-' ? -1 : 1)
                i = after + 2
            } else {
                throw .Invalid(at: i)
            }
        }
        if i != count {
            throw .Invalid(at: i)
        }
        let seconds = date + hour * 3600 + minute * 60 + second - offset
        return DateTime { secondsSinceEpoch: seconds, nanosecond: nanosecond }
    }
}

/// The two- or four-digit field between the scalar positions.
fn field(_ text: String, _ from: Int, _ to: Int) throws(ParseError) -> Int {
    if to > text.count {
        throw from >= text.count ? ParseError.Invalid(at: text.count) : ParseError.InvalidDigit(at: text.count)
    }
    var value = 0
    var i = from
    while i < to {
        let c = text.at(i)
        if !c.isDigit {
            throw .InvalidDigit(at: i)
        }
        value = value * 10 + (c.codePoint - 48)
        i += 1
    }
    return value
}

/// The separator the format puts at the position.
fn expect(_ text: String, _ at: Int, _ separator: Char) throws(ParseError) {
    if at >= text.count || text.at(at) != separator {
        throw .Invalid(at: at)
    }
}

extension DateTime: Debug {
    /// The moment as ISO 8601 writes it, to the nanosecond where it has
    /// any: `2026-11-17T09:05:03Z`, `2026-11-17T09:05:03.250000000Z`.
    public fn debugDescription() -> String {
        if nanosecond == 0 {
            return iso8601()
        }
        var digits = nanosecond.toString()
        while digits.count < 9 {
            digits = "0" + digits
        }
        return isoDate() + "T" + two(hour) + ":" + two(minute) + ":" + two(second) + "." + digits + "Z"
    }
}
