module Sable.Time

public struct Clock {
    /// Waits at least this long, and every task with it: it does not await,
    /// so no other task may run. In a task, 'await sleep(duration)'
    /// (Sable.Concurrency) waits while the others run.
    public static fn sleep(_ duration: Duration) {
        Runtime.sleep(duration.totalNanoseconds)
    }

    /// How long the body took to run.
    public static fn measure(_ body: () -> Void) -> Duration {
        let start = Instant.now()
        body()
        return start.elapsed
    }
}
