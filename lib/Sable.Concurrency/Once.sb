module Sable.Concurrency

/// Work done once, however many threads ask: Rust's `Once`, C's
/// `pthread_once`.
///
/// ```sable
/// let setup = Once()
/// var runs = 0
/// setup.run { runs += 1 }
/// setup.run { runs += 1 }
/// assert(runs == 1 && setup.hasRun)
/// ```
@immutable
public final class Once {
    let done: OnceCell<Bool>

    public init() {
        done = OnceCell<Bool>()
    }

    /// Runs the closure, unless this or another closure given has run
    /// already; another thread asking meanwhile waits until it has.
    public fn run(_ body: () -> Void) {
        let _ = done.getOrInit {
            body()
            return true
        }
    }

    /// Whether a closure has run.
    public var hasRun: Bool => done.get() != none
}
