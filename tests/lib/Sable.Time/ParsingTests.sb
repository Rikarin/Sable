module TimeParsingTests

// UtcDateTime and Duration are Parsable (Sable.Time): what their formatters
// write reads back as the same value.

import Sable.Testing
import Sable.Time

@test
fn aDateTimeReadsWhatISO8601Writes() {
    let moment = try! UtcDateTime.parse("2024-02-29T23:59:59Z")
    assertEqual(moment.iso8601(), "2024-02-29T23:59:59Z")
    assertEqual(moment.nanosecond, 0)
    assertEqual(try! UtcDateTime.parse("1970-01-01").secondsSinceEpoch, 0)
    assertEqual(try! UtcDateTime.parse("1970-01-01T00:00:01").secondsSinceEpoch, 1)
    let fractional = try! UtcDateTime.parse("2026-11-17T09:05:03.25Z")
    assertEqual(fractional.nanosecond, 250000000)
    assertEqual(try! UtcDateTime.parse("2026-11-17T09:05:03.123456789123Z").nanosecond, 123456789)
}

@test(arguments: [
    ("2026-11-17T10:00:00+01:00", "2026-11-17T09:00:00Z"),
    ("2026-11-17T03:30:00-0530", "2026-11-17T09:00:00Z"),
    ("2026-01-01T00:30:00+01:00", "2025-12-31T23:30:00Z"),
])
fn anOffsetIsTakenOff(_ text: String, _ utc: String) throws {
    expect(try UtcDateTime.parse(text).iso8601() == utc)
}

@test(arguments: [
    ("", ParseError.Empty),
    ("2026-13-01", ParseError.Invalid(at: 5)),
    ("2026-01-01T25:00:00Z", ParseError.Invalid(at: 11)),
    ("20x6-01-01", ParseError.InvalidDigit(at: 2)),
    ("2026/01/01", ParseError.Invalid(at: 4)),
    ("2026-01-01T00:00:00Q", ParseError.Invalid(at: 19)),
])
fn aDateTimeOutOfRangeSaysWhere(_ text: String, _ error: ParseError) {
    expectThrows(error) { _ = try UtcDateTime.parse(text) }
}

@test
fn aDayThatIsNotOneIsNone() {
    expect((try? UtcDateTime.parse("2023-02-29")) == none)
}

@test
fn aDateTimeRoundTrips() throws {
    forAll(Gen.number(in: -5000000000...5000000000), cases: 100) { (seconds: Int) in
        let moment = UtcDateTime.fromUnix(seconds)
        expect(try UtcDateTime.parse(moment.iso8601()) == moment)
    }
}

@test(arguments: [
    ("1.5s", Duration.milliseconds(1500)),
    ("1h 2m 3.000s", Duration.seconds(3723)),
    ("-250us", Duration.microseconds(-250)),
    ("3.250µs", Duration.nanoseconds(3250)),
    ("17ns", Duration.nanoseconds(17)),
    ("2h30m", Duration.minutes(150)),
    (" 90s ", Duration.seconds(90)),
])
fn aDurationReadsWhatToStringWrites(_ text: String, _ expected: Duration) throws {
    expect(try Duration.parse(text) == expected)
}

@test
fn aDurationRoundTrips() throws {
    forAll(Gen.number(in: -7000000000000...7000000000000), cases: 120) { (n: Int) in
        let duration = Duration.nanoseconds(n)
        expect(try Duration.parse(duration.toString()) == duration)
    }
}

@test(arguments: [
    ("  ", ParseError.Empty),
    ("5x", ParseError.Invalid(at: 1)),
    ("s", ParseError.InvalidDigit(at: 0)),
    ("999999999999h", ParseError.Overflow),
])
fn aDurationThatIsNotOneSaysWhere(_ text: String, _ error: ParseError) {
    expectThrows(error) { _ = try Duration.parse(text) }
}
