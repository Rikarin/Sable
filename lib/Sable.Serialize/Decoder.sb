module Sable.Serialize

/// Where a Serializable value reads itself from: a value of a document, in
/// the data model Encoder writes, at a path (`$.items[3].name`) that every
/// error names. A decoder can be asked for a part of its value — a field, an
/// element, a case's payload — as another decoder, and asked again, so a
/// conformance can try one reading and then another (an untagged union
/// does). A field that is not there is a decoder too, a missing one:
/// reading a value from it throws MissingField, and an Optional reads none.
/// JsonDecoder reads JSON.
///
/// ```sable
/// struct Celsius: Serializable {
///     var degrees: F64
///     fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
///         try encoder.encodeFloat(degrees)
///     }
///     static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Celsius {
///         let degrees = try decoder.decodeFloat()
///         if degrees < -273.15 {
///             throw decoder.invalid("colder than absolute zero")
///         }
///         return Celsius { degrees: degrees }
///     }
/// }
/// assert(try! Json.decode(Celsius.self, from: "21.5").degrees == 21.5)
/// assert((try? Json.decode(Celsius.self, from: "-300")) == none)
/// ```
public protocol Decoder {
    /// Where the value is, from the document's root: `$.items[3].name`.
    var path: String { get }

    /// Whether there is no value here: a field the struct does not have.
    var isMissing: Bool { get }

    /// Whether the value here is null.
    var isNull: Bool { get }

    /// What kind of value is here, for a type that takes more than one.
    var kind: DecodedKind { get }

    fn decodeBool() throws(SerializeError) -> Bool
    fn decodeInt() throws(SerializeError) -> Int
    fn decodeUInt() throws(SerializeError) -> U64
    fn decodeFloat() throws(SerializeError) -> F64
    fn decodeString() throws(SerializeError) -> String
    fn decodeBytes() throws(SerializeError) -> U8[>..]

    /// A sequence's elements, in order.
    fn decodeSequence() throws(SerializeError) -> Self[>..]

    /// The sequence's element at the position, or a missing decoder past
    /// the end (or when this is not a sequence): a tuple-like payload's parts.
    fn element(_ index: Int) -> Self

    /// A map's entries, in order.
    fn decodeMap() throws(SerializeError) -> DecodedMember<Self>[>..]

    /// Throws unless the value here is a struct (or a map): what a struct's
    /// decoding asks first, naming the type it wants.
    fn beginStruct(_ name: String) throws(SerializeError)

    /// The struct's field of that key, or a missing decoder when it has none.
    fn field(_ key: String) -> Self

    /// Whether the struct has a field of that key (null counts).
    fn hasField(_ key: String) -> Bool

    /// The same value with those fields or entries left out, and any left
    /// out already: what a flattened field reads, which is the rest of the
    /// struct it is in.
    fn excluding(_ keys: String[>..]) -> Self

    /// A union's case's name, as `encodeUnitCase` or `beginCase` wrote it.
    fn caseName() throws(SerializeError) -> String

    /// The payload of the case `beginCase` wrote; missing for a case
    /// written by `encodeUnitCase`.
    fn casePayload() -> Self

    /// The error for a value of another kind than 'expected' here, or for
    /// none at all.
    fn mismatch(_ expected: String) -> SerializeError

    /// The error for a value here the type does not take.
    fn invalid(_ reason: String) -> SerializeError

    /// The error for a case the type has none of.
    fn unknownCase(_ name: String) -> SerializeError
}
