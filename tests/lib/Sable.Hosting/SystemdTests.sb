module SystemdTests

// Sable.Hosting, tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Hosting

import Sable.Hosting
import Sable.IO
import Sable.Process
import Sable.Testing
import Sable.Time

@test
fn withNoSocketNoOneIsTold() {
    unsafe {
        Environment.remove("NOTIFY_SOCKET")
    }
    expect(!Systemd.isActive)
    expect(!Systemd.notify("READY=1"))
}

@test(arguments: [
    "/nowhere/to/be/found", "vsock:2:1234", "", "@sable-nowhere-to-be-found", "/" + "x".repeated(200),
])
fn aSocketThatIsNotThereIsNotTold(_ socket: String) {
    expect(!Systemd.notify("READY=1", socket: socket))
}

@test
fn theWatchdogIsThisProcesss() {
    unsafe {
        Environment.remove("WATCHDOG_PID")
        Environment.remove("WATCHDOG_USEC")
    }
    expect(Systemd.watchdogInterval == none)
    unsafe {
        Environment.set("WATCHDOG_USEC", "30000000")
    }
    expect(Systemd.watchdogInterval! == Duration.seconds(30))
    unsafe {
        Environment.set("WATCHDOG_PID", "1")
    }
    expect(Systemd.watchdogInterval == none)
    unsafe {
        Environment.set("WATCHDOG_PID", Process.id().toString())
    }
    expect(Systemd.watchdogInterval! == Duration.seconds(30))
    unsafe {
        Environment.set("WATCHDOG_USEC", "soon")
    }
    expect(Systemd.watchdogInterval == none)
    unsafe {
        Environment.set("WATCHDOG_USEC", "0")
    }
    expect(Systemd.watchdogInterval == none)
}
