module ArrayComparisonTests

// Arrays as Equatable, Hashable and Comparable (Sable.Core,
// Array+Comparison.sb), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

fn same<T: Equatable>(_ a: T, _ b: T) -> Bool {
    return a == b
}

fn before<T: Comparable>(_ a: T, _ b: T) -> Bool {
    return a < b
}

fn hashOf<T: Hashable>(_ value: T) -> Int {
    return value.hashValue
}

@test
fn assertEqualComparesArraysOfEveryKind() {
    let words: String[>..] = ["a", "b"]
    assertEqual(words, ["a", "b"])
    let fixed: Int[3] = [1, 2, 3]
    assertEqual(fixed, [1, 2, 3])
    let shrinking: Int[>..<] = [1, 2]
    assertEqual(shrinking, [1, 2])
    let inline: Int[..4] = [1, 2]
    assertEqual(inline, [1, 2])
    assertEqual(words[0..<1], ["a"])
}

@test
fn arraysAreEqualWhenTheirElementsAreInOrder() {
    let xs: Int[>..] = [1, 2, 3]
    assert(same(xs, [1, 2, 3]))
    assert(!same(xs, [1, 2]))
    assert(!same(xs, [1, 2, 4]))
    assert(same(xs[1...], [2, 3]))
    let nested: Int[>..][>..] = [[1], [2, 3]]
    let other: Int[>..][>..] = [[1], [2, 3]]
    assert(same(nested, other))
}

@test
fn arraysOrderLexicographically() {
    let xs: Int[>..] = [1, 2]
    assert(xs < [1, 3])
    assert(xs < [1, 2, 0])
    assert(!(xs < xs))
    assert(xs <= xs)
    assert(xs > [1])
    assert(xs >= [0, 9, 9])
    assert(before(xs, [2]))
    assert(!before([2] as Int[>..], xs))
    let empty: Int[>..] = []
    assert(empty < xs)
    let words: String[>..] = ["b", "a"]
    assert(before(words, ["b", "b"]))
}

@test
fn equalArraysHashEqual() {
    let a: Int[>..] = [1, 2]
    let b: Int[] = [1, 2]
    assertEqual(a.hashValue, b.hashValue)
    assertEqual(hashOf(a), hashOf(a[0...]))
    let left: Int[>..][>..] = [[1], []]
    let right: Int[>..][>..] = [[], [1]]
    assert(hashOf(left) != hashOf(right))
}

@test
fn anArrayIsADictionaryKey() {
    var counts: [String[>..]: Int] = [:]
    counts[["a", "b"]] = 1
    counts[["a"]] = 2
    assertEqual(counts[["a", "b"]] ?? 0, 1)
    assertEqual(counts[["a"]] ?? 0, 2)
    assert(counts[["b"]] == none)
}
