module Sable.Text

/// Base64 encoded a chunk at a time, as bytes come from a file or a socket:
/// the one or two bytes a chunk ends with that make no whole group wait for
/// the next, so the text is what encoding all the bytes at once would give.
/// `finish()` writes the last group, padded as the encoder says.
///
/// ```sable
/// var encoder = Base64Encoder()
/// let first: U8[>..] = [0x48, 0x65, 0x6C, 0x6C]
/// let second: U8[>..] = [0x6F]
/// var text = encoder.encode(first)
/// text = text + encoder.encode(second) + encoder.finish()
/// assert(text == "SGVsbG8=")
/// ```
public struct Base64Encoder {
    // The bytes of a group the last chunk ended partway through.
    var pending: U8[>..]
    let digits: U8[:]

    /// Whether the last group is padded with '='.
    public let padding: Bool

    /// An encoder to that alphabet, padding the last group or not.
    public init(alphabet: Base64.Alphabet = .Standard, padding: Bool = true) {
        self.pending = []
        self.digits = Base64.digits(alphabet)
        self.padding = padding
    }

    /// The digits of the whole groups the chunk completes.
    ///
    /// ```sable
    /// var encoder = Base64Encoder(alphabet: .UrlSafe, padding: false)
    /// let bytes: U8[>..] = [0xFB, 0xFF, 0xBF, 0xFF]
    /// assert(encoder.encode(bytes) == "-_-_")
    /// assert(encoder.finish() == "_w")
    /// ```
    public mutating fn encode(_ chunk: U8[:]) -> String {
        var text: U8[>..] = []
        var start = 0
        if pending.count > 0 {
            while pending.count < 3 && start < chunk.count {
                pending.append(chunk[start])
                start += 1
            }
            if pending.count < 3 {
                return ""
            }
            Base64.appendEncoded(pending, to: &text, digits: digits, padding: padding)
            pending.removeAll(keepingCapacity: true)
        }
        let end = chunk.count - (chunk.count - start) % 3
        Base64.appendEncoded(chunk[start..<end], to: &text, digits: digits, padding: padding)
        pending.append(contentsOf: chunk[end...])
        return asciiText(text)
    }

    /// The end of the bytes: the digits of the group left, padded or not,
    /// or nothing when none is. The encoder is then empty, to begin again.
    public mutating fn finish() -> String {
        var text: U8[>..] = []
        Base64.appendEncoded(pending, to: &text, digits: digits, padding: padding)
        pending.removeAll(keepingCapacity: true)
        return asciiText(text)
    }

    /// The digits of the whole groups the chunk completes, written at the
    /// end of the buffer as ASCII bytes, with no String made.
    ///
    /// ```sable
    /// var buffer = ByteBuffer()
    /// var encoder = Base64Encoder()
    /// let bytes: U8[>..] = [0x4D, 0x61, 0x6E, 0x4D]
    /// encoder.encode(bytes, into: &buffer)
    /// encoder.finish(into: &buffer)
    /// assert(buffer.count == 8 && buffer.bytes[7] == 0x3D)
    /// ```
    public mutating fn encode(_ chunk: U8[:], into buffer: inout ByteBuffer) {
        let length = (pending.count + chunk.count) / 3 * 4
        buffer.write(reserving: length) { text, start in
            var at = start
            var taken = 0
            if pending.count > 0 {
                while pending.count < 3 && taken < chunk.count {
                    pending.append(chunk[taken])
                    taken += 1
                }
                if pending.count < 3 {
                    return 0
                }
                Base64.writeEncoded(pending, to: &text, at: at, digits: digits, padding: padding)
                pending.removeAll(keepingCapacity: true)
                at += 4
            }
            let end = chunk.count - (chunk.count - taken) % 3
            Base64.writeEncoded(chunk[taken..<end], to: &text, at: at, digits: digits, padding: padding)
            pending.append(contentsOf: chunk[end...])
            return length
        }
    }

    /// The end of the bytes, as `finish()` gives it, written at the end of
    /// the buffer. The encoder is then empty, to begin again.
    public mutating fn finish(into buffer: inout ByteBuffer) {
        let length = Base64.encodedLength(pending.count, padding: padding)
        buffer.write(reserving: length) { text, start in
            Base64.writeEncoded(pending, to: &text, at: start, digits: digits, padding: padding)
            pending.removeAll(keepingCapacity: true)
            return length
        }
    }
}
