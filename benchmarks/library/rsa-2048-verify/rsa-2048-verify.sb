fn run(_ publicKey: RsaPublicKey, _ message: U8[>..], _ other: U8[>..], _ signature: U8[>..]) -> String {
    var valid = 0
    var round = 0
    while round < 3000 {
        if publicKey.isValid(signature, for: round % 4 == 3 ? other : message, padding: .Pkcs1(.Sha256)) {
            valid += 1
        }
        round += 1
    }
    return "\(valid)"
}

@bench
fn measure(_ b: Bencher) {
    let key = try! RsaPrivateKey.parse(pem: pem)
    let publicKey = key.publicKey
    let message = U8[>..](repeating: 7, count: 64)
    let other = U8[>..](repeating: 8, count: 64)
    let signature = key.sign(message, padding: .Pkcs1(.Sha256))
    b.check(b.iterate { run(publicKey, message, other, signature) })
}
