module BF16Tests

// BF16 (Sable.Core): bfloat16, an F32's range at seven fraction bits.

import Sable.Testing

@test
fn arithmeticRoundsToTheNearestBFloat() {
    let x: BF16 = 1.5
    let y: BF16 = 3.0078125
    // 3.0078125 is halfway between 3.0 and 3.015625: to even, 3.0.
    assertEqual(y, 3.0)
    assertEqual(x + y, 4.5)
    assertEqual(x * x, 2.25)
    assertEqual(BF16(1.0) / BF16(3.0), BF16(0.333984375))
    assertEqual(BF16(1.0) + BF16.epsilon / 2.0, 1.0)
    expect(BF16(1.0) + BF16.epsilon > 1.0)
    assertEqual((BF16(4.5) as BF16).squareRoot(), BF16(2.125))
    assertEqual(-x, -1.5)
    assertEqual(BF16(7.0).truncatingRemainder(dividingBy: 2.0), 1.0)
}

@test
fn itHasAnF32sRange() {
    assertEqual(F32(BF16.greatestFiniteMagnitude), 3.3895314e38)
    assertEqual(BF16.greatestFiniteMagnitude * 2.0, BF16.infinity)
    assertEqual(F32(BF16.leastNormalMagnitude), 1.1754944e-38)
    expect(BF16.leastNonzeroMagnitude > 0.0)
    assertEqual(BF16.leastNonzeroMagnitude / 2.0, 0.0)
    expect(BF16.nan.isNaN && BF16.nan != BF16.nan)
    assertEqual(BF16.significandBitCount, 7)
    assertEqual(BF16.exponentBitCount, 8)
}

@test
fn conversionsRoundOnce() {
    assertEqual(BF16(257), 256.0)
    assertEqual(BF16(259), 260.0)
    assertEqual(Int(BF16(1000.7)), 1000)
    assertEqual(BF16(F32(3.14159)), BF16.pi)
    assertEqual(F64(BF16.pi), 3.140625)
    assertEqual(BF16(F16(0.5)), 0.5)
    assertEqual(F16(BF16(65536.0)), F16.infinity)
    assertEqual(BF16(1e39), BF16.infinity)
    assertEqual(BF16(0.1).bits, 0x3DCD)
    assertEqual(BF16.fromBits(0x3F80), 1.0)
    assertEqual(BF16(I128.max), BF16(1.7014118e38))
    assertEqual(BF16(U8.max), 255.0)
    assertEqual(BF16(U16(511)), 512.0)
}

@test
fn itIsWrittenInItsShortestDigits() {
    assertEqual("\(BF16(0.1))", "0.1")
    assertEqual("\(BF16.pi)", "3.14")
    assertEqual(BF16(257).toString(), "256.0")
    assertEqual("\(BF16(0.5):.3)", "0.500")
    assertEqual("\(BF16.infinity)", "inf")
    assertEqual("\(BF16(1.5):?)", "1.5")
}

@test(arguments: [
    ("3.14159", BF16.pi), ("1e39", BF16.infinity), ("-0.1", -BF16(0.1)),
    // 3.0078125 is a tie, to even; a hair above it rounds up.
    ("3.0078125", 3.0), ("3.00781250001", 3.015625)
])
fn itIsParsedToTheNearest(_ text: String, _ value: BF16) throws {
    expect(try BF16.parse(text) == value)
}

@test
fn aHexadecimalOneIsParsed() throws {
    expect(try BF16.parse("0x1.8p1", styles: .HexFloat) == 3.0)
}

@test
fn itsShortestDigitsAreReadBack() throws {
    for n in 0..<400 {
        let value = BF16.fromBits(U16(n * 97 % 0x7F80))
        assertEqual(try BF16.parse(value.toString()), value)
    }
}

@test
fn itComparesHashesAndSorts() {
    var values: BF16[>..] = [3.0, -1.0, 0.5]
    values.sort()
    expect(values == [-1.0, 0.5, 3.0])
    assertEqual(BF16(0.5).hashValue, BF16(0.5).hashValue)
    assertEqual(BF16(2.5).rounded(), 3.0)
    assertEqual(BF16(1.0).nextUp, BF16(1.0078125))
    assertEqual(BF16.leastNormalMagnitude.exponent, -126)
    assertEqual(BF16(3.0).totalCompare(BF16.nan), .Less)
}

@test
fn itsConstantsAreRoundedToTheNearest() {
    assertEqual(BF16.e, BF16(2.718281828459045))
    assertEqual(BF16.ln2, BF16(0.6931471805599453))
    assertEqual(BF16.ln10, BF16(2.302585092994046))
    assertEqual(BF16.sqrt2, BF16(1.4142135623730951))
    assertEqual(BF16.pi, BF16(3.141592653589793))
    assertEqual(BF16.zero + BF16.one, 1.0)
}

@test(arguments: [
    ("inf", BF16.infinity), ("-Infinity", -BF16.infinity), ("1e400", BF16.infinity), ("-1e400", -BF16.infinity),
    ("1e-400", 0.0)
])
fn itParsesWhatIsNotFinite(_ text: String, _ value: BF16) throws {
    expect(try BF16.parse(text) == value)
}

@test
fn itParsesANaN() throws {
    expect((try BF16.parse("nan")).isNaN)
}

@test(arguments: [("1.5x", .InvalidDigit(at: 3)), ("", .Empty)])
fn itRefusesWhatIsNoNumber(_ text: String, _ error: ParseError) {
    expectThrows(error) { _ = try BF16.parse(text) }
}

@test(arguments: [
    // Nearer to the halfway point than an F64 can tell, on either side of
    // it. 3.0078125 lies between 3.0, the even one, and 3.015625.
    ("3.00781250000000000000001", 3.015625), ("3.00781249999999999999999", 3.0), ("-3.0078125", -3.0),
    ("-3.00781250000000000000001", -3.015625), ("-3.00781249999999999999999", -3.0),
    // 3.0234375 lies between 3.015625 and 3.03125, the even one.
    ("3.0234375", 3.03125), ("3.02343750000000000000001", 3.03125), ("3.02343749999999999999999", 3.015625),
    ("-3.02343749999999999999999", -3.015625)
])
fn aTextBesideATieIsRoundedItsOwnWay(_ text: String, _ value: BF16) throws {
    expect(try BF16.parse(text) == value)
}

@test(arguments: [
    // 1.99609375 × 2^128 / 2, halfway from the greatest to 2^128: a tie is
    // to the even one, infinity.
    ("339617752923046005526922703901628039168", BF16.infinity),
    ("339617752923046005526922703901628039169", BF16.infinity),
    ("339617752923046005526922703901628039167", BF16.greatestFiniteMagnitude),
    ("-339617752923046005526922703901628039168", -BF16.infinity),
    ("-339617752923046005526922703901628039167", -BF16.greatestFiniteMagnitude)
])
fn aTextBesideTheGreatestIsFiniteOrNot(_ text: String, _ value: BF16) throws {
    expect(try BF16.parse(text) == value)
}
