module Sable.Serialize.Yaml

import Sable.Serialize

/// Reads a YAML 1.2 stream as events, a document at a time as they are
/// asked for: every block and flow style of the specification, its
/// directives, tags, anchors and aliases, and errors at their exact
/// positions. It is linear in the text, whatever the text: no part of it is
/// read more than a few times.
///
/// It builds no values, and an alias is only its name: `Yaml.parse` makes a
/// tree of the events, and checks what the tree is for.
///
/// ```sable
/// let parser = YamlParser("a: [1, 2]\n")
/// var seen: String[>..] = []
/// while let event = try! parser.next() {
///     seen.append(event.description())
/// }
/// assert(seen.joined(separator: " ") == "+STR +DOC +MAP =VAL :a +SEQ [] =VAL :1 =VAL :2 -SEQ -MAP -DOC -STR")
/// ```
public final class YamlParser {
    let bytes: U8[>..]
    let count: Int
    let options: YamlOptions

    // The cursor; where its line starts, and how many spaces that line
    // starts with.
    var at: Int = 0
    var lineStart: Int = 0
    var lineIndent: Int = 0
    // Whether nothing but white space comes before the cursor on its line,
    // and whether a tab was in the white space before it.
    var fresh: Bool = true
    var tabbed: Bool = false

    // The events of the document read last, and how many were given out.
    var events: YamlEvent[>..] = []
    var read: Int = 0
    var failure: YamlError? = none
    var started: Bool = false
    var ended: Bool = false
    var tags: [String: String] = [:]
    // Characters only a quoted scalar may hold, and how many of them are past.
    var unprintable: Int[>..] = []
    var printed: Int = 0

    /// A parser of the text.
    public init(_ text: String, _ options: YamlOptions = YamlOptions()) {
        var bytes: U8[>..] = []
        bytes.append(utf8: text)
        self.bytes = bytes
        self.count = bytes.count
        self.options = options
    }

    /// A parser of the bytes: UTF-8, UTF-16 or UTF-32, with a byte order
    /// mark or without, as YAML 1.2.2 §5.2 tells them apart.
    public init(bytes: U8[>..], _ options: YamlOptions = YamlOptions()) throws(YamlError) {
        let text = try yamlUtf8(bytes)
        self.bytes = text
        self.count = text.count
        self.options = options
    }

    /// The next event, or none after the stream's end. The events before an
    /// error are given before it is thrown, and it is thrown again after.
    public fn next() throws(YamlError) -> YamlEvent? {
        while true {
            while read < events.count {
                let event = events[read]
                read += 1
                if !event.isPlaceholder {
                    return event
                }
            }
            if let failure = failure {
                throw failure
            }
            if ended {
                return none
            }
            events.removeAll(keepingCapacity: true)
            read = 0
            do {
                try fill()
            } catch {
                failure = error
            }
        }
    }

    /// The line and column of a byte of the text: an event's start or end.
    public fn position(at byte: Int) -> Position {
        let stop = byte < count ? byte : count
        var offset = 0
        var line = 1
        var column = 1
        var i = 0
        while i < stop {
            let b = bytes[i]
            if b == 0x0A || b == 0x0D {
                if b == 0x0D && i + 1 < stop && bytes[i + 1] == 0x0A {
                    i += 1
                    offset += 1
                }
                line += 1
                column = 1
                offset += 1
            } else if (b & 0xC0) != 0x80 {
                column += 1
                offset += 1
            }
            i += 1
        }
        return Position { offset: offset, line: line, column: column }
    }

    fn error(_ at: Int, _ reason: String, kind: YamlErrorKind = .Syntax) -> YamlError {
        let place = position(at: at)
        return YamlError { kind: kind, offset: place.offset, line: place.line, column: place.column, reason: reason }
    }

    // ---- Characters ----------------------------------------------------------

    // The whole text's characters are checked once, before anything is read:
    // those YAML allows nowhere are an error, and those it allows only in a
    // quoted scalar are kept to be checked as the scalars are read.
    fn begin() throws(YamlError) {
        var i = 0
        while i < count {
            let b = bytes[i]
            if b >= 0x20 && b < 0x7F || b == 0x0A || b == 0x09 || b == 0x0D {
                i += 1
            } else if b < 0x20 {
                throw error(i, "the control character U+\(yamlHex(Int(b), 4)) must be written as an escape", kind: .Character)
            } else if b == 0x7F {
                unprintable.append(i)
                i += 1
            } else if b == 0xC2 {
                if bytes[i + 1] < 0xA0 && bytes[i + 1] != 0x85 {
                    unprintable.append(i)
                }
                i += 2
            } else if b == 0xEF {
                // U+FEFF, U+FFFE and U+FFFF.
                if bytes[i + 1] == 0xBB && bytes[i + 2] == 0xBF || bytes[i + 1] == 0xBF && bytes[i + 2] >= 0xBE {
                    unprintable.append(i)
                }
                i += 3
            } else {
                i += b < 0xE0 ? 2 : b < 0xF0 ? 3 : 4
            }
        }
        startLine()
    }

    // Those before 'start' were in no quoted scalar, and those before 'end'
    // are in the one just read, or are a byte order mark.
    fn printable(from start: Int, to end: Int) throws(YamlError) {
        if printed < unprintable.count && unprintable[printed] < start {
            throw error(unprintable[printed], "a character that is not printable must be written as an escape", kind: .Character)
        }
        while printed < unprintable.count && unprintable[printed] < end {
            printed += 1
        }
    }

    // The byte, or 0 past the end: no text has one of its own.
    fn byte(_ i: Int) -> U8 {
        return i < count ? bytes[i] : 0
    }

    fn isBreak(_ i: Int) -> Bool {
        let b = byte(i)
        return b == 0x0A || b == 0x0D
    }

    fn isWhite(_ i: Int) -> Bool {
        let b = byte(i)
        return b == 0x20 || b == 0x09
    }

    // White space, a line's end or the text's: what must follow an indicator.
    fn isBlank(_ i: Int) -> Bool {
        let b = byte(i)
        return b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0D || b == 0
    }

    fn isFlowIndicator(_ i: Int) -> Bool {
        let b = byte(i)
        return b == 0x2C || b == 0x5B || b == 0x5D || b == 0x7B || b == 0x7D
    }

    fn isPlainSafe(_ i: Int, _ flow: Bool) -> Bool {
        return !isBlank(i) && !(flow && isFlowIndicator(i))
    }

    fn startsPlain(_ i: Int, _ flow: Bool) -> Bool {
        let b = byte(i)
        if b == 0x2D || b == 0x3F || b == 0x3A {
            return isPlainSafe(i + 1, flow)
        }
        return b != 0 && !yamlIsIndicator(b)
    }

    fn isMark(_ i: Int) -> Bool {
        return byte(i) == 0xEF && byte(i + 1) == 0xBB && byte(i + 2) == 0xBF
    }

    fn describe(_ i: Int) -> String {
        if i >= count {
            return "the end of the text"
        }
        if isBreak(i) {
            return "the end of the line"
        }
        let b = bytes[i]
        if b == 0x09 {
            return "a tab"
        }
        let width = b < 0x80 ? 1 : b < 0xE0 ? 2 : b < 0xF0 ? 3 : 4
        return "'" + text(i, i + width) + "'"
    }

    fn text(_ start: Int, _ end: Int) -> String {
        unsafe {
            return String.fromUtf8Unchecked(bytes[start..<end])
        }
    }

    // ---- Lines ---------------------------------------------------------------

    fn afterBreak(_ i: Int) -> Int {
        return byte(i) == 0x0D && byte(i + 1) == 0x0A ? i + 2 : i + 1
    }

    fn newLine() {
        at = afterBreak(at)
        startLine()
    }

    fn startLine() {
        lineStart = at
        var i = at
        while byte(i) == 0x20 {
            i += 1
        }
        lineIndent = i - at
        fresh = true
        tabbed = false
    }

    fn take(_ length: Int) {
        at += length
        fresh = false
        tabbed = false
    }

    fn skipLine() {
        while at < count && !isBreak(at) {
            at += 1
        }
    }

    // Over white space, comments and line breaks, to content or the end.
    fn skip() {
        while true {
            let b = byte(at)
            if b == 0x20 {
                at += 1
            } else if b == 0x09 {
                tabbed = true
                at += 1
            } else if b == 0x0A || b == 0x0D {
                newLine()
            } else if b == 0x23 && (at == lineStart || isWhite(at - 1)) {
                skipLine()
            } else {
                return
            }
        }
    }

    fn skipWhite() {
        while isWhite(at) {
            at += 1
        }
    }

    // The rest of a line, which holds nothing more but a comment.
    fn endLine() throws(YamlError) {
        skipWhite()
        if byte(at) == 0x23 && at > lineStart && isWhite(at - 1) {
            skipLine()
        }
        if at < count && !isBreak(at) {
            if byte(at) == 0x3A && isBlank(at + 1) {
                throw error(at, "a mapping's key may not be here: a key is on one line, and a mapping in another starts on a line of its own")
            }
            if byte(at) == 0x23 {
                throw error(at, "a comment needs white space before its '#'")
            }
            throw error(at, "\(describe(at)) after a value")
        }
    }

    // Whether '---' or '...' is here, at the start of a line.
    fn isMarker(_ i: Int) -> Bool {
        if i != lineStart && !(i > 0 && (bytes[i - 1] == 0x0A || bytes[i - 1] == 0x0D)) {
            return false
        }
        let b = byte(i)
        return (b == 0x2D || b == 0x2E) && byte(i + 1) == b && byte(i + 2) == b && isBlank(i + 3)
    }

    // ---- Documents -----------------------------------------------------------

    fn emit(_ event: YamlEvent, _ start: Int, _ end: Int, content: Int = -1) {
        var placed = event
        placed.start = start
        placed.end = end
        placed.content = content < 0 ? start : content
        events.append(placed)
    }

    fn fill() throws(YamlError) {
        if !started {
            started = true
            emit(YamlEvent(.StreamStart), 0, 0)
            try begin()
            return
        }
        tags = [:]
        var directives = false
        var versioned = false
        while true {
            if at == lineStart && isMark(at) {
                try printable(from: at, to: at + 3)
                at += 3
                startLine()
            }
            skip()
            if at == lineStart && isMark(at) {
                continue
            }
            if at >= count {
                if directives {
                    throw error(at, "the text ends where '---' should follow the directives")
                }
                try printable(from: count, to: count)
                emit(YamlEvent(.StreamEnd), count, count)
                ended = true
                return
            }
            if at == lineStart && byte(at) == 0x25 {
                if try directive(versioned) {
                    versioned = true
                }
                directives = true
                continue
            }
            if isMarker(at) && byte(at) == 0x2E {
                if directives {
                    throw error(at, "'...' where '---' should follow the directives")
                }
                take(3)
                try endLine()
                continue
            }
            break
        }
        let explicit = isMarker(at)
        if directives && !explicit {
            throw error(at, "\(describe(at)) where '---' should follow the directives")
        }
        emit(YamlEvent(.DocumentStart, isExplicit: explicit), at, explicit ? at + 3 : at)
        if explicit {
            take(3)
        }
        try node(-1, zero: false, compact: false, 0)
        skip()
        try printable(from: at, to: at)
        if at < count && !isMarker(at) {
            if tabbed && fresh {
                throw error(at, "indented with a tab: indentation is spaces")
            }
            throw error(at, "\(describe(at)) after the document's value: another document starts with '---'")
        }
        if at < count && byte(at) == 0x2E {
            emit(YamlEvent(.DocumentEnd, isExplicit: true), at, at + 3)
            take(3)
            try endLine()
        } else {
            emit(YamlEvent(.DocumentEnd), at, at)
        }
    }

    // A directive's line; whether it was %YAML.
    fn directive(_ versioned: Bool) throws(YamlError) -> Bool {
        let start = at
        var i = at + 1
        while !isBlank(i) {
            i += 1
        }
        let name = text(start + 1, i)
        var words: String[>..] = []
        var starts: Int[>..] = []
        while true {
            while isWhite(i) {
                i += 1
            }
            if i >= count || isBreak(i) || byte(i) == 0x23 {
                break
            }
            let word = i
            while !isBlank(i) {
                i += 1
            }
            words.append(text(word, i))
            starts.append(word)
        }
        at = i
        skipLine()
        if name.isEmpty {
            throw error(start, "a directive with no name")
        }
        if name == "YAML" {
            if versioned {
                throw error(start, "a second %YAML directive for one document")
            }
            if words.count != 1 {
                throw error(words.count > 1 ? starts[1] : i, "%YAML takes one version, as in '%YAML 1.2'")
            }
            let version = words[0]
            let digits = version.utf8
            var dot = -1
            var ok = true
            var j = 0
            while j < digits.count {
                if digits[j] == 0x2E && dot < 0 {
                    dot = j
                } else if digits[j] < 0x30 || digits[j] > 0x39 {
                    ok = false
                }
                j += 1
            }
            if !ok || dot < 1 || dot == digits.count - 1 {
                throw error(starts[0], "'\(version)' is not a YAML version")
            }
            if dot != 1 || digits[0] != 0x31 {
                throw error(starts[0], "YAML \(version) is not a version this reads: 1.x")
            }
            return true
        }
        if name == "TAG" {
            if words.count != 2 {
                throw error(words.count > 2 ? starts[2] : i, "%TAG takes a handle and a prefix, as in '%TAG !e! tag:example.com,2000:'")
            }
            let handle = words[0].utf8
            var ok = handle[0] == 0x21 && handle[handle.count - 1] == 0x21
            var j = 1
            while j < handle.count - 1 {
                ok = ok && yamlIsWord(handle[j])
                j += 1
            }
            if !ok {
                throw error(starts[0], "'\(words[0])' is not a tag handle: '!', '!!' or '!name!'")
            }
            if tags[words[0]] != none {
                throw error(starts[0], "a second %TAG directive for '\(words[0])'")
            }
            let lead = words[1].utf8
            ok = lead[0] == 0x21 || yamlIsTagChar(lead[0])
            j = 1
            while j < lead.count {
                ok = ok && yamlIsUriChar(lead[j])
                j += 1
            }
            if !ok {
                throw error(starts[1], "'\(words[1])' is not a tag prefix")
            }
            tags[words[0]] = words[1]
        }
        return false
    }

    // ---- Block nodes ---------------------------------------------------------

    fn enter(_ depth: Int) throws(YamlError) {
        if depth > options.maxDepth {
            throw error(at, "nested more than \(options.maxDepth) deep", kind: .TooDeep)
        }
    }

    // A node whose parent is at column 'n', after the parent's indicator.
    // 'zero': a sequence may be at the parent's own column, as a mapping's
    // value may. 'compact': a collection may start on the indicator's line.
    fn node(_ n: Int, zero: Bool, compact: Bool, _ depth: Int) throws(YamlError) {
        let empty = at
        // The properties on lines before the content's are the node's; those
        // on its line are a first key's, when it turns out to have one.
        var outer = YamlProperties()
        var inner = YamlProperties()
        // Whether a block collection may start here.
        var mayStart = false
        var afterTab = false
        while true {
            skip()
            if fresh && inner.isPresent {
                try merge(&outer, inner)
                inner = YamlProperties()
            }
            let dash = byte(at) == 0x2D && isBlank(at + 1)
            if at >= count || isMarker(at) || fresh && lineIndent <= n && !(zero && lineIndent == n && dash && !tabbed) {
                try merge(&outer, inner)
                let place = outer.isPresent ? outer.end : empty
                emit(YamlEvent(.Scalar, anchor: outer.anchor, tag: outer.tag), outer.isPresent ? outer.start : place, place, content: place)
                return
            }
            if !inner.isPresent {
                afterTab = tabbed
                mayStart = !tabbed && (fresh || compact && !outer.isPresent)
            }
            if byte(at) != 0x26 && byte(at) != 0x21 {
                break
            }
            try property(&inner, flow: false)
        }

        let start = inner.isPresent ? inner.start : at
        let column = start - lineStart
        let b = byte(at)

        if b == 0x2D && isBlank(at + 1) {
            if inner.isPresent || !mayStart {
                throw blockRefused(at, "a sequence", afterTab: afterTab)
            }
            try sequence(column, outer, depth + 1)
            return
        }
        if (b == 0x3F || b == 0x3A) && isBlank(at + 1) {
            if b == 0x3F && inner.isPresent || !mayStart {
                throw blockRefused(at, "a mapping", afterTab: afterTab)
            }
            try enter(depth + 1)
            emit(YamlEvent(.MappingStart, anchor: outer.anchor, tag: outer.tag), outer.isPresent ? outer.start : start, at, content: start)
            if b == 0x3F {
                try entry(column, depth + 1)
            } else {
                emit(YamlEvent(.Scalar, anchor: inner.anchor, tag: inner.tag), start, inner.isPresent ? inner.end : at, content: inner.isPresent ? inner.end : at)
                take(1)
                try node(column, zero: true, compact: false, depth + 1)
            }
            try entries(column, depth + 1)
            return
        }
        if b == 0x7C || b == 0x3E {
            try merge(&outer, inner)
            try blockScalar(n, outer)
            return
        }

        // A flow node: a value, or the first key of a block mapping, which
        // is known only past it.
        let line = lineStart
        let slot = events.count
        var place = YamlEvent(.MappingStart)
        place.isPlaceholder = true
        events.append(place)
        _ = try flowContent(n + 1, flow: false, YamlProperties(), depth)
        let end = at
        if lineStart == line {
            skipWhite()
            if byte(at) == 0x3A && isBlank(at + 1) {
                if !mayStart {
                    throw blockRefused(at, "a mapping", afterTab: afterTab)
                }
                try checkKey(start, end)
                try enter(depth + 1)
                place.isPlaceholder = false
                place.anchor = outer.anchor
                place.tag = outer.tag
                place.start = outer.isPresent ? outer.start : start
                place.content = start
                events[slot] = place
                try apply(inner, slot + 1)
                take(1)
                try node(column, zero: true, compact: false, depth + 1)
                try entries(column, depth + 1)
                return
            }
        }
        try merge(&outer, inner)
        try apply(outer, slot + 1)
        try endLine()
    }

    fn blockRefused(_ place: Int, _ what: String, afterTab: Bool) -> YamlError {
        if afterTab {
            return error(place, "\(what) after a tab: indentation is spaces")
        }
        return error(place, "\(what) may not start here: in a mapping, or after '---', an anchor or a tag, it starts on a line of its own")
    }

    // The properties of a node whose event is already there.
    fn apply(_ properties: YamlProperties, _ index: Int) throws(YamlError) {
        if !properties.isPresent {
            return
        }
        if events[index].kind == .Alias {
            throw aliasProperties(properties)
        }
        events[index].anchor = properties.anchor
        events[index].tag = properties.tag
        events[index].start = properties.start
    }

    fn aliasProperties(_ properties: YamlProperties) -> YamlError {
        return error(properties.start, "an alias has the anchor and the tag of its node, and none of its own")
    }

    fn merge(_ outer: inout YamlProperties, _ inner: YamlProperties) throws(YamlError) {
        if !inner.isPresent {
            return
        }
        if inner.anchor != none && outer.anchor != none {
            throw error(inner.start, "a second anchor for one node")
        }
        if inner.tag != none && outer.tag != none {
            throw error(inner.start, "a second tag for one node")
        }
        if !outer.isPresent {
            outer.start = inner.start
        }
        if inner.anchor != none {
            outer.anchor = inner.anchor
        }
        if inner.tag != none {
            outer.tag = inner.tag
        }
        outer.end = inner.end
        outer.isPresent = true
    }

    fn checkKey(_ start: Int, _ end: Int) throws(YamlError) {
        if end - start > 1024 {
            var characters = 0
            var i = start
            while i < end {
                if (bytes[i] & 0xC0) != 0x80 {
                    characters += 1
                }
                i += 1
            }
            if characters > 1024 {
                throw error(start, "a key longer than 1024 characters, which needs a '?' before it")
            }
        }
    }

    // A block sequence, whose dashes are at the column.
    fn sequence(_ column: Int, _ properties: YamlProperties, _ depth: Int) throws(YamlError) {
        try enter(depth)
        emit(YamlEvent(.SequenceStart, anchor: properties.anchor, tag: properties.tag), properties.isPresent ? properties.start : at, at, content: at)
        while true {
            take(1)
            try node(column, zero: false, compact: true, depth)
            let end = lastEnd()
            skip()
            let more = try continues(column)
            if !more || byte(at) != 0x2D || !isBlank(at + 1) {
                emit(YamlEvent(.SequenceEnd), end, end)
                return
            }
        }
    }

    fn lastEnd() -> Int {
        return events[events.count - 1].end
    }

    // Whether another entry of a block collection at the column may be here.
    fn continues(_ column: Int) throws(YamlError) -> Bool {
        if at >= count || isMarker(at) {
            return false
        }
        if tabbed {
            throw error(at, "indented with a tab: indentation is spaces")
        }
        if lineIndent > column {
            throw error(at, "indented \(lineIndent) where the collection is indented \(column)")
        }
        return lineIndent == column
    }

    // The rest of a block mapping's entries, after one.
    fn entries(_ column: Int, _ depth: Int) throws(YamlError) {
        while true {
            let end = lastEnd()
            skip()
            let more = try continues(column)
            if !more {
                emit(YamlEvent(.MappingEnd), end, end)
                return
            }
            try entry(column, depth)
        }
    }

    // One entry of a block mapping.
    fn entry(_ column: Int, _ depth: Int) throws(YamlError) {
        if byte(at) == 0x3F && isBlank(at + 1) {
            take(1)
            try node(column, zero: true, compact: true, depth)
            let end = lastEnd()
            skip()
            if at < count && fresh && !tabbed && lineIndent == column && byte(at) == 0x3A && isBlank(at + 1) {
                take(1)
                try node(column, zero: true, compact: true, depth)
            } else {
                emit(YamlEvent(.Scalar), end, end)
            }
            return
        }
        let start = at
        let line = lineStart
        var properties = YamlProperties()
        while byte(at) == 0x26 || byte(at) == 0x21 {
            try property(&properties, flow: false)
            skipWhite()
        }
        if at >= count || isBreak(at) {
            throw error(at, "\(describe(at)) where a mapping's key should be")
        }
        if byte(at) == 0x3A && isBlank(at + 1) {
            let place = properties.isPresent ? properties.end : at
            emit(YamlEvent(.Scalar, anchor: properties.anchor, tag: properties.tag), start, place, content: place)
        } else {
            if byte(at) == 0x2D && isBlank(at + 1) {
                throw error(at, "a sequence's entry where a mapping's key should be")
            }
            _ = try flowContent(column + 1, flow: false, properties, depth)
            let end = at
            if lineStart != line {
                throw error(start, "a key must be on one line, or have a '?' before it")
            }
            skipWhite()
            if byte(at) != 0x3A || !isBlank(at + 1) {
                if byte(at) == 0x3A {
                    throw error(at + 1, "white space must follow the ':' of a mapping")
                }
                throw error(at, "\(describe(at)) where the ':' after a mapping's key should be")
            }
            try checkKey(start, end)
        }
        take(1)
        try node(column, zero: true, compact: false, depth)
    }

    // ---- Anchors, tags and aliases -------------------------------------------

    fn nameEnd(_ start: Int) -> Int {
        var i = start
        while !isBlank(i) && !isFlowIndicator(i) {
            i += 1
        }
        return i
    }

    // An anchor or a tag, added to the properties.
    fn property(_ properties: inout YamlProperties, flow: Bool) throws(YamlError) {
        let start = at
        if byte(at) == 0x26 {
            if properties.anchor != none {
                throw error(at, "a second anchor for one node")
            }
            let end = nameEnd(at + 1)
            if end == at + 1 {
                throw error(at, "an anchor with no name")
            }
            properties.anchor = text(at + 1, end)
            take(end - at)
        } else {
            if properties.tag != none {
                throw error(at, "a second tag for one node")
            }
            properties.tag = try tag()
        }
        if !isBlank(at) && !(flow && (byte(at) == 0x2C || byte(at) == 0x5D || byte(at) == 0x7D)) {
            throw error(at, "\(describe(at)) where white space should follow \(byte(start) == 0x26 ? "an anchor" : "a tag")")
        }
        if !properties.isPresent {
            properties.isPresent = true
            properties.start = start
        }
        properties.end = at
    }

    fn tag() throws(YamlError) -> String {
        let start = at
        if byte(start + 1) == 0x3C {
            var i = start + 2
            while yamlIsUriChar(byte(i)) {
                i += 1
            }
            if byte(i) != 0x3E {
                throw error(i, "\(describe(i)) in a verbatim tag")
            }
            let whole = text(start + 2, i)
            let local = byte(start + 2) == 0x21
            if local ? whole == "!" : !yamlIsWord(byte(start + 2)) || !whole.contains(':') {
                throw error(start, "'\(whole)' is no tag: one is a URI, or starts with '!'")
            }
            take(i + 1 - at)
            return whole
        }
        // A handle — '!', '!!' or '!name!' — and the rest.
        var i = start + 1
        while yamlIsWord(byte(i)) {
            i += 1
        }
        var handle = "!"
        var suffix = start + 1
        if byte(i) == 0x21 {
            handle = text(start, i + 1)
            suffix = i + 1
        }
        i = suffix
        var written: U8[>..] = []
        while yamlIsTagChar(byte(i)) {
            if byte(i) == 0x25 {
                let high = yamlHexValue(byte(i + 1))
                let low = yamlHexValue(byte(i + 2))
                if high < 0 || low < 0 {
                    throw error(i, "'%' in a tag is followed by two hex digits")
                }
                written.append(U8.truncating(high * 16 + low))
                i += 3
            } else {
                written.append(byte(i))
                i += 1
            }
        }
        if written.isEmpty {
            if handle != "!" {
                throw error(start, "the tag '\(handle)' is a handle with nothing after it")
            }
            take(i - at)
            return "!"
        }
        if Runtime.validateUtf8(bytes: written) >= 0 {
            throw error(start, "a tag that is not UTF-8")
        }
        var lead = ""
        if let known = tags[handle] {
            lead = known
        } else if handle == "!" {
            lead = "!"
        } else if handle == "!!" {
            lead = "tag:yaml.org,2002:"
        } else {
            throw error(start, "the tag handle '\(handle)' is not declared: '%TAG \(handle) …' before '---' does")
        }
        take(i - at)
        unsafe {
            return lead + String.fromUtf8Unchecked(written)
        }
    }

    fn aliasNode() throws(YamlError) {
        let start = at
        let end = nameEnd(at + 1)
        if end == at + 1 {
            throw error(at, "an alias with no name")
        }
        take(end - at)
        emit(YamlEvent(.Alias, anchor: text(start + 1, end)), start, end)
    }

    // ---- Flow nodes ----------------------------------------------------------

    // The content of a flow node, in a flow collection or a block one,
    // whose further lines are indented at least 'm'. Whether it is written
    // as JSON would, so that a ':' may follow it at once.
    fn flowContent(_ m: Int, flow: Bool, _ properties: YamlProperties, _ depth: Int) throws(YamlError) -> Bool {
        let b = byte(at)
        if b == 0x2A {
            if properties.isPresent {
                throw aliasProperties(properties)
            }
            try aliasNode()
            return false
        }
        if b == 0x22 || b == 0x27 {
            try quoted(m, properties)
            return true
        }
        if b == 0x5B {
            try flowSequence(m, properties, depth + 1)
            return true
        }
        if b == 0x7B {
            try flowMapping(m, properties, depth + 1)
            return true
        }
        if !startsPlain(at, flow) {
            if b == 0x23 {
                throw error(at, "a comment needs white space before its '#'")
            }
            if flow && b == 0x2D {
                throw error(at, "a block sequence in a flow collection")
            }
            throw error(at, "\(describe(at)) cannot start a value")
        }
        plain(m, flow: flow, properties)
        return false
    }

    // To the next content of a flow collection that started at 'opener'.
    fn flowSkip(_ m: Int, _ opener: Int) throws(YamlError) {
        skip()
        if at >= count {
            let place = position(at: opener)
            throw error(at, "the text ends inside \(describe(opener)) of line \(place.line), column \(place.column)")
        }
        if fresh {
            if isMarker(at) {
                throw error(at, "a document's marker inside \(describe(opener))")
            }
            if lineIndent < m {
                throw error(at, "indented \(lineIndent) inside \(describe(opener)), which is indented at least \(m)")
            }
        }
    }

    // Whether a ':' here separates a key from its value.
    fn isValueIndicator(_ i: Int, afterJson: Bool) -> Bool {
        return byte(i) == 0x3A && (afterJson || !isPlainSafe(i + 1, true))
    }

    fn flowNode(_ m: Int, _ opener: Int, _ depth: Int) throws(YamlError) -> Bool {
        var properties = YamlProperties()
        while byte(at) == 0x26 || byte(at) == 0x21 {
            try property(&properties, flow: true)
            try flowSkip(m, opener)
        }
        if properties.isPresent && (byte(at) == 0x2C || byte(at) == 0x5D || byte(at) == 0x7D || isValueIndicator(at, afterJson: false)) {
            emit(YamlEvent(.Scalar, anchor: properties.anchor, tag: properties.tag), properties.start, properties.end, content: properties.end)
            return false
        }
        return try flowContent(m, flow: true, properties, depth)
    }

    fn flowSequence(_ m: Int, _ properties: YamlProperties, _ depth: Int) throws(YamlError) {
        try enter(depth)
        let opener = at
        emit(YamlEvent(.SequenceStart, anchor: properties.anchor, tag: properties.tag, collectionStyle: .Flow), properties.isPresent ? properties.start : at, at + 1, content: at)
        take(1)
        while true {
            try flowSkip(m, opener)
            if byte(at) == 0x5D {
                break
            }
            if byte(at) == 0x2C {
                throw error(at, "',' with no value before it")
            }
            try flowElement(m, opener, depth)
            try flowSkip(m, opener)
            if byte(at) == 0x2C {
                take(1)
            } else if byte(at) != 0x5D {
                throw error(at, "\(describe(at)) where ',' or ']' should be")
            }
        }
        take(1)
        emit(YamlEvent(.SequenceEnd), at, at)
    }

    // A flow sequence's element: a node, or a mapping of one pair.
    fn flowElement(_ m: Int, _ opener: Int, _ depth: Int) throws(YamlError) {
        let start = at
        if byte(at) == 0x3F && isBlank(at + 1) {
            try enter(depth + 1)
            emit(YamlEvent(.MappingStart, collectionStyle: .Flow), at, at)
            let json = try flowExplicitKey(m, opener, depth + 1)
            try flowPairValue(m, opener, json, depth + 1)
            let end = lastEnd()
            emit(YamlEvent(.MappingEnd), end, end)
            return
        }
        let slot = events.count
        var place = YamlEvent(.MappingStart, collectionStyle: .Flow)
        place.isPlaceholder = true
        events.append(place)
        let line = lineStart
        var json = false
        if isValueIndicator(at, afterJson: false) {
            emit(YamlEvent(.Scalar), at, at)
        } else {
            json = try flowNode(m, opener, depth)
        }
        let end = at
        if lineStart != line {
            return
        }
        skipWhite()
        if isValueIndicator(at, afterJson: json) {
            try checkKey(start, end)
            try enter(depth + 1)
            place.isPlaceholder = false
            place.start = start
            place.content = start
            events[slot] = place
            try flowPairValue(m, opener, json, depth + 1)
            let last = lastEnd()
            emit(YamlEvent(.MappingEnd), last, last)
        }
    }

    // The key after a '?', perhaps none; whether it is written as JSON's.
    fn flowExplicitKey(_ m: Int, _ opener: Int, _ depth: Int) throws(YamlError) -> Bool {
        take(1)
        let empty = at
        try flowSkip(m, opener)
        if byte(at) == 0x2C || byte(at) == 0x5D || byte(at) == 0x7D || isValueIndicator(at, afterJson: false) {
            emit(YamlEvent(.Scalar), empty, empty)
            return false
        }
        return try flowNode(m, opener, depth)
    }

    // A ':' and the value after it, or an empty one.
    fn flowPairValue(_ m: Int, _ opener: Int, _ json: Bool, _ depth: Int) throws(YamlError) {
        var empty = lastEnd()
        try flowSkip(m, opener)
        if isValueIndicator(at, afterJson: json) {
            take(1)
            empty = at
            try flowSkip(m, opener)
            if byte(at) != 0x2C && byte(at) != 0x5D && byte(at) != 0x7D {
                _ = try flowNode(m, opener, depth)
                return
            }
        }
        emit(YamlEvent(.Scalar), empty, empty)
    }

    fn flowMapping(_ m: Int, _ properties: YamlProperties, _ depth: Int) throws(YamlError) {
        try enter(depth)
        let opener = at
        emit(YamlEvent(.MappingStart, anchor: properties.anchor, tag: properties.tag, collectionStyle: .Flow), properties.isPresent ? properties.start : at, at + 1, content: at)
        take(1)
        while true {
            try flowSkip(m, opener)
            if byte(at) == 0x7D {
                break
            }
            if byte(at) == 0x2C {
                throw error(at, "',' with no entry before it")
            }
            var json = false
            if byte(at) == 0x3F && isBlank(at + 1) {
                json = try flowExplicitKey(m, opener, depth)
            } else if isValueIndicator(at, afterJson: false) {
                emit(YamlEvent(.Scalar), at, at)
            } else {
                json = try flowNode(m, opener, depth)
            }
            try flowPairValue(m, opener, json, depth)
            try flowSkip(m, opener)
            if byte(at) == 0x2C {
                take(1)
            } else if byte(at) != 0x7D {
                throw error(at, "\(describe(at)) where ',' or '}' should be")
            }
        }
        take(1)
        emit(YamlEvent(.MappingEnd), at, at)
    }

    // ---- Plain scalars -------------------------------------------------------

    // Over a plain scalar's text on one line: where it ends, the white
    // space after it left out. 'at' is left at what stopped it.
    fn plainLine(_ flow: Bool) -> Int {
        var end = at
        var i = at
        while i < count {
            let b = bytes[i]
            if b == 0x20 || b == 0x09 {
                i += 1
                continue
            }
            if b == 0x0A || b == 0x0D {
                break
            }
            if b == 0x3A && !isPlainSafe(i + 1, flow) {
                break
            }
            if b == 0x23 && i > at && isWhite(i - 1) {
                break
            }
            if flow && isFlowIndicator(i) {
                break
            }
            i += 1
            end = i
        }
        at = i
        return end
    }

    fn plain(_ m: Int, flow: Bool, _ properties: YamlProperties) {
        let start = at
        var end = plainLine(flow)
        var written: U8[>..] = []
        var folded = false
        while at < count && isBreak(at) {
            // The next line with anything on it, if it goes on from here.
            var i = at
            var line = i
            var spaces = 0
            var blank = -1
            while i < count && isBreak(i) {
                line = afterBreak(i)
                i = line
                while byte(i) == 0x20 {
                    i += 1
                }
                spaces = i - line
                while isWhite(i) {
                    i += 1
                }
                blank += 1
            }
            if i >= count || spaces < m || byte(i) == 0x23 || isMarker(line) || byte(i) == 0x3A && !isPlainSafe(i + 1, flow) || flow && isFlowIndicator(i) {
                break
            }
            if !folded {
                folded = true
                written.append(contentsOf: bytes[start..<end])
            }
            if blank == 0 {
                written.append(0x20)
            } else {
                written.append(repeating: 0x0A, count: blank)
            }
            lineStart = line
            lineIndent = spaces
            at = i
            end = plainLine(flow)
            written.append(contentsOf: bytes[i..<end])
        }
        // The white space after it is no part of it, but tells a comment.
        at = end
        take(0)
        var value = ""
        if folded {
            unsafe {
                value = String.fromUtf8Unchecked(written)
            }
        } else {
            value = text(start, end)
        }
        emit(YamlEvent(.Scalar, anchor: properties.anchor, tag: properties.tag, value: value), properties.isPresent ? properties.start : start, end, content: start)
    }

    // ---- Quoted scalars ------------------------------------------------------

    fn quoted(_ m: Int, _ properties: YamlProperties) throws(YamlError) {
        let start = at
        let quote = byte(at)
        let double = quote == 0x22
        var written: U8[>..] = []
        // How much of what is written no line break may trim.
        var floor = 0
        take(1)
        while true {
            let run = at
            while at < count {
                let b = bytes[at]
                if b == quote || b == 0x0A || b == 0x0D || double && b == 0x5C {
                    break
                }
                at += 1
            }
            if at >= count {
                throw unterminated(start)
            }
            written.append(contentsOf: bytes[run..<at])
            let b = bytes[at]
            if b == quote {
                if double || byte(at + 1) != quote {
                    break
                }
                written.append(quote)
                at += 2
            } else if b == 0x5C && at + 1 < count && isBreak(at + 1) {
                at += 1
                let blank = try foldedBreaks(m, start)
                written.append(repeating: 0x0A, count: blank)
                floor = written.count
            } else if b == 0x5C {
                try escape(&written)
                floor = written.count
            } else {
                while written.count > floor && (written[written.count - 1] == 0x20 || written[written.count - 1] == 0x09) {
                    _ = written.removeLast()
                }
                let blank = try foldedBreaks(m, start)
                if blank == 0 {
                    written.append(0x20)
                } else {
                    written.append(repeating: 0x0A, count: blank)
                }
                floor = written.count
            }
        }
        take(1)
        try printable(from: start, to: at)
        var value = ""
        unsafe {
            value = String.fromUtf8Unchecked(written)
        }
        emit(YamlEvent(.Scalar, anchor: properties.anchor, tag: properties.tag, value: value, style: double ? .DoubleQuoted : .SingleQuoted), properties.isPresent ? properties.start : start, at, content: start)
    }

    fn unterminated(_ start: Int) -> YamlError {
        let place = position(at: start)
        return error(count, "the text ends inside the quoted scalar of line \(place.line), column \(place.column)")
    }

    // Over a line break in a quoted scalar, and the blank lines after it, to
    // the next line's text: how many lines were blank.
    fn foldedBreaks(_ m: Int, _ start: Int) throws(YamlError) -> Int {
        var blank = -1
        while at < count && isBreak(at) {
            newLine()
            if isMarker(at) {
                throw error(at, "a document's marker inside a quoted scalar")
            }
            skipWhite()
            blank += 1
        }
        if at >= count {
            throw unterminated(start)
        }
        if lineIndent < m {
            throw error(at, "indented \(lineIndent) inside a quoted scalar, which is indented at least \(m)")
        }
        return blank
    }

    fn escape(_ written: inout U8[>..]) throws(YamlError) {
        let start = at
        let b = byte(at + 1)
        at += 2
        var code = -1
        if b == 0x30 {
            code = 0
        } else if b == 0x61 {
            code = 7
        } else if b == 0x62 {
            code = 8
        } else if b == 0x74 || b == 0x09 {
            code = 9
        } else if b == 0x6E {
            code = 10
        } else if b == 0x76 {
            code = 11
        } else if b == 0x66 {
            code = 12
        } else if b == 0x72 {
            code = 13
        } else if b == 0x65 {
            code = 27
        } else if b == 0x20 || b == 0x22 || b == 0x2F || b == 0x5C {
            code = Int(b)
        } else if b == 0x4E {
            code = 0x85
        } else if b == 0x5F {
            code = 0xA0
        } else if b == 0x4C {
            code = 0x2028
        } else if b == 0x50 {
            code = 0x2029
        } else if b == 0x78 {
            code = try hex(start, 2)
        } else if b == 0x55 {
            code = try hex(start, 8)
        } else if b == 0x75 {
            code = try hex(start, 4)
            // JSON's pair of surrogates, for a character past U+FFFF.
            if code >= 0xD800 && code <= 0xDBFF && byte(at) == 0x5C && byte(at + 1) == 0x75 {
                let pair = at
                at += 2
                let low = try hex(pair, 4)
                if low >= 0xDC00 && low <= 0xDFFF {
                    code = 0x10000 + (code - 0xD800) * 1024 + (low - 0xDC00)
                }
            }
        } else {
            throw error(start, "'\\' before \(describe(start + 1)) is no escape")
        }
        guard let character = Char.fromCodePoint(value: code) else {
            throw error(start, "U+\(yamlHex(code, 4)) is not a character", kind: .Character)
        }
        character.encodeUtf8(into: &written)
    }

    fn hex(_ start: Int, _ digits: Int) throws(YamlError) -> Int {
        var value = 0
        var i = 0
        while i < digits {
            let digit = yamlHexValue(byte(at))
            if digit < 0 {
                throw error(start, "an escape of \(digits) hex digits has \(describe(at)) among them")
            }
            value = value * 16 + digit
            at += 1
            i += 1
        }
        return value
    }

    // ---- Block scalars -------------------------------------------------------

    fn blockScalar(_ n: Int, _ properties: YamlProperties) throws(YamlError) {
        let start = at
        let literal = byte(at) == 0x7C
        take(1)
        // The header: an indentation digit and a chomping sign, either first.
        var explicit = 0
        var chomp: U8 = 0
        while true {
            let b = byte(at)
            if b >= 0x31 && b <= 0x39 && explicit == 0 {
                explicit = Int(b) - 0x30
            } else if (b == 0x2B || b == 0x2D) && chomp == 0 {
                chomp = b
            } else {
                break
            }
            at += 1
        }
        if !isBlank(at) {
            throw error(at, "\(describe(at)) in a block scalar's header")
        }
        let header = at
        try endLine()
        if at < count {
            newLine()
        }
        var indent = (n < 0 ? 0 : n) + explicit
        if explicit == 0 {
            indent = try detectIndent(n)
        }

        var written: U8[>..] = []
        // Whether the last line of text had a break, not yet written, and
        // how many blank lines came after it.
        var broken = false
        var blank = 0
        var moreIndented = false
        var end = header
        while at < count {
            var i = at
            while i - at < indent && byte(i) == 0x20 {
                i += 1
            }
            if i < count && isBreak(i) {
                blank += 1
                at = i
                newLine()
                if chomp == 0x2B {
                    end = at
                }
                continue
            }
            if i >= count {
                // A last line of nothing but spaces, with no break.
                if i > at && chomp == 0x2B {
                    blank += 1
                    end = i
                }
                at = i
                break
            }
            if i - at < indent {
                if bytes[i] == 0x09 {
                    throw error(i, "a tab where a block scalar's indentation, or its end, should be")
                }
                break
            }
            if isMarker(at) {
                break
            }
            let leading = isWhite(i)
            if broken {
                if literal || moreIndented || leading {
                    written.append(0x0A)
                } else if blank == 0 {
                    written.append(0x20)
                }
            }
            written.append(repeating: 0x0A, count: blank)
            blank = 0
            moreIndented = leading
            at = i
            skipLine()
            written.append(contentsOf: bytes[i..<at])
            broken = at < count
            if broken {
                newLine()
            }
            end = at
        }
        if chomp != 0x2D && broken {
            written.append(0x0A)
        }
        if chomp == 0x2B {
            written.append(repeating: 0x0A, count: blank)
        }
        fresh = true
        var value = ""
        unsafe {
            value = String.fromUtf8Unchecked(written)
        }
        emit(YamlEvent(.Scalar, anchor: properties.anchor, tag: properties.tag, value: value, style: literal ? .Literal : .Folded), properties.isPresent ? properties.start : start, end, content: start)
    }

    // A block scalar's indentation, from its first line with anything on it.
    fn detectIndent(_ n: Int) throws(YamlError) -> Int {
        var i = at
        var widest = n + 1
        var widestAt = -1
        while true {
            let line = i
            while byte(i) == 0x20 {
                i += 1
            }
            let spaces = i - line
            if i < count && isBreak(i) {
                if spaces > widest {
                    widest = spaces
                    widestAt = i
                }
                i = afterBreak(i)
                continue
            }
            if i >= count {
                return spaces > widest ? spaces : widest
            }
            if spaces <= n || isMarker(line) {
                return widest
            }
            if widestAt >= 0 && widest > spaces {
                throw error(widestAt, "a blank line indented more than the block scalar's first line of text")
            }
            return spaces
        }
    }
}

// A node's anchor and tag, and where they are written.
struct YamlProperties {
    var anchor: String? = none
    var tag: String? = none
    var start: Int = 0
    var end: Int = 0
    var isPresent: Bool = false
}
