module Sable.Globalization

// The CLDR's number patterns (UTS #35 part 3, §3): "#,##,##0.00" between a
// leading and a trailing, and the same for negative numbers where they are not
// the positive one's with a minus sign before it.

/// A piece of a leading or trailing: text, or a sign put in where it is.
enum AffixKind {
    Text
    Minus
    Plus
    Percent
    Currency
}

struct AffixPiece {
    let kind: AffixKind
    let text: String
}

struct NumberPattern {
    var leading: AffixPiece[>..] = []
    var trailing: AffixPiece[>..] = []
    /// Whether negative numbers have affixes of their own, and those.
    var hasNegative = false
    var negativeLeading: AffixPiece[>..] = []
    var negativeTrailing: AffixPiece[>..] = []
    /// Digits to a group: the one before the point, then the others; 0 for
    /// none.
    var primaryGroup = 0
    var secondaryGroup = 0
    var minimumFraction = 0
    var maximumFraction = 0

    init(_ text: String) {
        let halves: String[>..] = text.split(';')
        let (before, digits, after) = patternParts(halves[0])
        self.leading = affix(before)
        self.trailing = affix(after)
        if halves.count > 1 {
            let (minusBefore, _, minusAfter) = patternParts(halves[1])
            self.hasNegative = true
            self.negativeLeading = affix(minusBefore)
            self.negativeTrailing = affix(minusAfter)
        }
        var sinceComma = -1
        var inFraction = false
        for c in digits {
            if c == ',' {
                self.secondaryGroup = sinceComma < 0 ? 0 : sinceComma
                sinceComma = 0
            } else if c == '.' {
                inFraction = true
            } else if inFraction {
                self.maximumFraction += 1
                if c == '0' {
                    self.minimumFraction += 1
                }
            } else if sinceComma >= 0 {
                sinceComma += 1
            }
        }
        if sinceComma > 0 {
            self.primaryGroup = sinceComma
            if self.secondaryGroup == 0 {
                self.secondaryGroup = sinceComma
            }
        }
    }
}

/// A pattern's leading, its digits and its trailing.
fn patternParts(_ text: String) -> (String, String, String) {
    var start = -1
    var end = 0
    var i = 0
    var quoted = false
    for c in text {
        if c == '\'' {
            quoted = !quoted
        } else if !quoted && (c == '#' || c == '0' || c == ',' || c == '.') {
            if start < 0 {
                start = i
            }
            end = i + 1
        }
        i += 1
    }
    if start < 0 {
        return (text, "", "")
    }
    return (text.slice(from: 0, to: start), text.slice(from: start, to: end), text.slice(from: end, to: text.count))
}

/// A leading's or trailing's pieces.
fn affix(_ text: String) -> AffixPiece[>..] {
    var pieces: AffixPiece[>..] = []
    var literal = ""
    var quoted = false
    for c in text {
        let kind: AffixKind = match c {
            case '-' => .Minus
            case '+' => .Plus
            case '%' => .Percent
            case '¤' => .Currency
            case _   => .Text
        }
        if c == '\'' {
            quoted = !quoted
        } else if quoted || kind == .Text {
            literal += String.fromChar(c)
        } else {
            if !literal.isEmpty {
                pieces.append(AffixPiece { kind: .Text, text: literal })
                literal = ""
            }
            pieces.append(AffixPiece { kind: kind, text: "" })
        }
    }
    if !literal.isEmpty {
        pieces.append(AffixPiece { kind: .Text, text: literal })
    }
    return pieces
}
