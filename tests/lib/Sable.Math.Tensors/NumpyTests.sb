@test
fn broadcast3Plus() {
    expectTensor(arange([1]) + arange([5], from: 10), [5], [10, 11, 12, 13, 14])
    expectTensor(arange([5], from: 10) + arange([1]), [5], [10, 11, 12, 13, 14])
}

@test
fn broadcast3Minus() {
    expectTensor(arange([1]) - arange([5], from: 10), [5], [-10, -11, -12, -13, -14])
    expectTensor(arange([5], from: 10) - arange([1]), [5], [10, 11, 12, 13, 14])
}

@test
fn broadcast3Times() {
    expectTensor(arange([1]) * arange([5], from: 10), [5], [0, 0, 0, 0, 0])
    expectTensor(arange([5], from: 10) * arange([1]), [5], [0, 0, 0, 0, 0])
}

@test
fn broadcast4Plus() {
    expectTensor(arange([2, 1, 3]) + arange([4, 1], from: 10), [2, 4, 3], [10, 11, 12, 11, 12, 13, 12, 13, 14, 13, 14, 15, 13, 14, 15, 14, 15, 16, 15, 16, 17, 16, 17, 18])
