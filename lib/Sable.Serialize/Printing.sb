module Sable.Serialize

/// The value as JSON, on one line.
///
/// ```sable
/// assert(render(array([integer(1), text("é")])) == "[1,\"é\"]")
/// ```
public fn render(_ value: JsonValue) -> String {
    return renderWith(value, compact())
}

/// The value as JSON, as the options say.
///
/// ```sable
/// let value = object([member("b", null()), member("a", array([]))])
/// assert(renderWith(value, canonical()) == "{\"a\":[],\"b\":null}")
/// ```
public fn renderWith(_ value: JsonValue, _ options: PrintOptions) -> String {
    var writer = JsonWriter(options: options)
    write(value, options, &writer)
    return writer.toString()
}

fn write(_ value: JsonValue, _ options: PrintOptions, _ writer: inout JsonWriter) {
    match value {
        case .Null          => writer.writeNull()
        case .Bool(let b)   => writer.writeBool(b)
        case .Number(let n) => writeNumber(n, &writer)
        case .Text(let t)   => writer.writeString(t)
        case .Array(let items) => {
            writer.writeBeginArray()
            for item in items {
                write(item, options, &writer)
            }
            writer.writeEndArray()
        }
        case .Object(let members) => {
            writer.writeBeginObject()
            for m in options.sortKeys ? sortedMembers(members) : members {
                writer.writeKey(m.key)
                write(m.value, options, &writer)
            }
            writer.writeEndObject()
        }
    }
}

// As formatNumber has it, with no String made of a whole number.
fn writeNumber(_ n: F64, _ writer: inout JsonWriter) {
    if n.abs() < 9007199254740992.0 && n != 0.0 {
        let whole = n as Int
        if whole as F64 == n {
            writer.writeInt(whole)
            return
        }
    }
    writer.writeRaw(formatNumber(n))
}

public fn sortedMembers(_ members: Member[>..]) -> Member[>..] {
    return sorted(members, (a: Member, b: Member) => compareText(a.key, b.key) < 0)
}

// A string as JSON writes it: quoted, with what must be escaped escaped, and
// with everything past ASCII escaped too when asked — as a surrogate pair
// above U+FFFF.
public fn quote(_ s: String, _ asciiOnly: Bool) -> String {
    var writer = JsonWriter(options: PrintOptions(asciiOnly: asciiOnly))
    writer.writeString(s)
    return writer.toString()
}

public fn escape(_ c: Char) -> String {
    let code = c.codePoint
    if code == 34 {
        return "\\\""
    }
    if code == 92 {
        return "\\\\"
    }
    if code == 10 {
        return "\\n"
    }
    if code == 13 {
        return "\\r"
    }
    if code == 9 {
        return "\\t"
    }
    if code == 8 {
        return "\\b"
    }
    if code == 12 {
        return "\\f"
    }
    if code < 0x10000 {
        return "\\u" + hex4(code)
    }
    let shifted = code - 0x10000
    return "\\u" + hex4(0xD800 + shifted / 1024) + "\\u" + hex4(0xDC00 + shifted % 1024)
}

// Numbers as JSON writes them: whole numbers that an F64 holds exactly
// without a point, the rest in the shortest form that reads back the same.
// JSON has no NaN or infinity; they are written as null.
public fn formatNumber(_ n: F64) -> String {
    if n != n {
        return "null"
    }
    if n > 1.7976931348623157e308 || n < -1.7976931348623157e308 {
        return "null"
    }
    if n == n.abs() * 0.0 + n && n.abs() < 9007199254740992.0 {
        let whole = n as Int
        if whole as F64 == n {
            if whole == 0 && 1.0 / n < 0.0 {
                return "-0"
            }
            return whole.toString()
        }
    }
    return n.toString()
}
