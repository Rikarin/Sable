module OrderedSetTests

// OrderedSet (Sable.Collections): distinct values in an order that can be
// read and changed by position.

import Sable.Collections
import Sable.Testing

@test
fn anOrderedSetKeepsTheFirstOfEachInOrder() {
    let seen = OrderedSet<String>(["b", "a", "b"])
    assert(seen.toArray() == ["b", "a"])
    assert(seen.append("c"))
    assert(!seen.append("a"))
    assertEqual(seen.index(of: "c"), 2)
    assertEqual(seen[1], "a")
    assert(seen.insert("z", at: 0))
    assert(!seen.insert("b", at: 0))
    assert(seen.toArray() == ["z", "b", "a", "c"])
    assertEqual(seen.index(of: "a"), 2)
    assert(seen.remove("b"))
    assert(!seen.remove("b"))
    assertEqual(seen.index(of: "c"), 2)
    assertEqual(seen.remove(at: 0), "z")
    seen.swapAt(0, 1)
    assert(seen.toArray() == ["c", "a"])
    seen.sort(by: { $0 < $1 })
    assert(seen.toArray() == ["a", "c"])
    assertEqual(seen.index(of: "c"), 1)
    assertEqual("\(seen)", "OrderedSet([\"a\", \"c\"])")
}

@test
fn orderedSetsCombineInOrder() {
    let a = OrderedSet<Int>([3, 1, 2])
    let b = OrderedSet<Int>([2, 5, 3])
    assert(a.union(b).toArray() == [3, 1, 2, 5])
    assert(a.intersection(b).toArray() == [3, 2])
    assert(a.subtracting(b).toArray() == [1])
    assert(OrderedSet<Int>([1, 3]).isSubset(of: a))
    assert(!b.isSubset(of: a))
    a.sort(using: Comparator<Int>.natural().reversed())
    assert(a.toArray() == [3, 2, 1])
    assert(a.reversed().toArray() == [1, 2, 3])
}

@test
fn anOrderedSetIsACollection() {
    let letters = OrderedSet<String>(["b", "a", "c"])
    assertEqual(letters.count, 3)
    assert(!letters.isEmpty)
    var joined = ""
    for letter in letters {
        joined = joined + letter
    }
    assertEqual(joined, "bac")
    assertEqual(letters.index(letters.startIndex, offsetBy: 2), 2)
    assertEqual(letters.distance(from: 1, to: letters.endIndex), 2)
    letters.removeAll()
    assert(letters.isEmpty)
    assert(!letters.contains("a"))
    assert(letters.append("a"))
    assertEqual(letters.index(of: "a"), 0)
}
