module Sable.Collections

/// A double-ended queue: adding and removing at either end in constant
/// time, and reading by position. A ring buffer of a power of two of slots:
/// the elements are in those numbered from 'head' up to 'tail', which only
/// go up as elements go through it, and a slot's place is the low bits of
/// its number. Each end changes its own number alone, so that neither waits
/// for the other's. The slots with no element are holes (Array.sb): a
/// removed element is moved out of its slot, so that it is let go of when it
/// is removed rather than when the slot is next written.
public class Deque<Element> {
    var slots: Element[>..] = []
    var head: Int = 0
    var tail: Int = 0

    public init() { }

    /// A deque of the sequence's values, in their order. What going
    /// through them throws, it throws.
    public init<S: Sequence>(_ values: S) throws(S.Failure) where S.Element == Element {
        for try value in values {
            slots.append(value)
        }
        tail = slots.count
        slots.append(holes: Deque.size(for: tail) - tail)
    }

    var used: Int => tail &- head

    public var count: Int => used
    public var isEmpty: Bool => used == 0

    // The slots for so many elements: a power of two, or none.
    static fn size(for count: Int) -> Int {
        if count == 0 {
            return 0
        }
        var size = 8
        while size < count {
            size = size * 2
        }
        return size
    }

    /// The slot of the element at 'index' from the front.
    fn slot(_ index: Int) -> Int => (head &+ index) & (slots.count &- 1)

    /// Twice the slots, the elements moved to the start of them in order. A
    /// call, as it is hardly ever made: 'append' is then short enough to be
    /// part of what calls it.
    @inline(never)
    fn grow() {
        resize(slots.count + 1)
    }

    /// Adds the value at the back.
    public fn append(_ value: Element) {
        if used == slots.count {
            grow()
        }
        let at = tail
        slots[at & (slots.count &- 1)] = value
        tail = at &+ 1
    }

    /// Adds the value at the front.
    public fn prepend(_ value: Element) {
        if used == slots.count {
            grow()
        }
        head = head &- 1
        slots[slot(0)] = value
    }

    /// Removes the front element and gives it back, or none when empty.
    public fn removeFirst() -> Element? {
        let at = head
        if at == tail {
            return none
        }
        head = at &+ 1
        return slots.take(at: at & (slots.count &- 1))
    }

    /// Removes the back element and gives it back, or none when empty.
    public fn removeLast() -> Element? {
        if used == 0 {
            return none
        }
        tail = tail &- 1
        return slots.take(at: tail & (slots.count &- 1))
    }

    /// The front element, or none.
    public var first: Element? {
        get {
            if used == 0 {
                return none
            }
            return slots[slot(0)]
        }
    }

    /// The back element, or none.
    public var last: Element? {
        get {
            if used == 0 {
                return none
            }
            return slots[slot(used - 1)]
        }
    }

    /// The slot of the element at 'index', which must be one: outside
    /// 0..<count it traps, as indexing an array does — by indexing one.
    fn checked(_ index: Int) -> Int {
        if index < 0 || index >= used {
            let nothing: Int[>..] = []
            return nothing[index]
        }
        return slot(index)
    }

    /// The element 'position' places from the front, to read or to
    /// replace; traps outside 0..<count.
    ///
    /// ```sable
    /// let deque = Deque<Int>([1, 2, 3])
    /// deque.prepend(0)
    /// deque[3] = 30
    /// assert(deque[0] == 0 && deque[3] == 30)
    /// ```
    public subscript(position: Int) -> Element {
        get {
            return slots[checked(position)]
        }
        set {
            slots[checked(position)] = newValue
        }
    }

    /// The elements in the range, front to back, copied into an array of
    /// their own: they may run round the end of the slots, so there is no
    /// one stretch of them to view. Any range of positions slices a deque,
    /// one counted from the end among them; outside 0...count traps.
    ///
    /// ```sable
    /// let deque = Deque<Int>([1, 2, 3])
    /// deque.prepend(0)
    /// assert(deque[1..<3] == [1, 2])
    /// assert(deque[^2...] == [2, 3])
    /// ```
    public subscript(range: some RangeExpression) -> Element[>..] {
        get {
            let positions = range.relative(to: self)
            if positions.lowerBound < 0 || positions.upperBound > used || positions.upperBound < positions.lowerBound {
                // Out of range: the trap an array's slice gives.
                let nothing: Int[>..] = []
                _ = nothing[positions.lowerBound..<positions.upperBound]
            }
            var elements: Element[>..] = []
            elements.reserveCapacity(positions.upperBound - positions.lowerBound)
            for position in positions.lowerBound..<positions.upperBound {
                elements.append(slots[slot(position)])
            }
            return elements
        }
    }

    /// Removes every element.
    public fn removeAll() {
        slots = []
        head = 0
        tail = 0
    }

    /// How many elements it has room for before it must grow.
    public var capacity: Int => slots.count

    /// Room for at least so many elements, so that adding up to that many
    /// grows nothing.
    public fn reserveCapacity(_ minimumCapacity: Int) {
        if minimumCapacity > slots.count {
            resize(minimumCapacity)
        }
    }

    /// The elements moved to the front of the storage, in order, with room
    /// for 'count' in all.
    fn resize(_ count: Int) {
        straighten()
        slots.append(holes: Deque.size(for: count) - slots.count)
    }

    // The elements moved to the start of the slots.
    fn straighten() {
        let count = used
        slots.rotate(from: 0, to: slots.count, left: slot(0))
        head = 0
        tail = count
    }

    /// The elements laid out in one run from the start of the storage, as
    /// Rust's 'make_contiguous': what 'asSlices' then gives as one.
    public fn makeContiguous() {
        if slot(0) + used > slots.count {
            straighten()
        }
    }

    /// The elements as the two runs they lie in: from the front to the end
    /// of the storage, then what wrapped round to its start — the second
    /// empty when they lie in one. Copies of them, in order.
    ///
    /// ```sable
    /// let deque = Deque<Int>([1, 2, 3])
    /// deque.prepend(0)
    /// var (front, back) = deque.asSlices()
    /// front.append(contentsOf: back)
    /// assert(front == [0, 1, 2, 3])
    /// ```
    public fn asSlices() -> (Element[>..], Element[>..]) {
        var front: Element[>..] = []
        var back: Element[>..] = []
        var i = 0
        while i < used {
            let at = slot(0) + i
            if at < slots.count {
                front.append(slots[at])
            } else {
                back.append(slots[at - slots.count])
            }
            i += 1
        }
        return (front, back)
    }

    /// The value put at the position, the elements from there on moved one
    /// along — those on the shorter side, so at most half of them. A
    /// position of 'count' adds it at the back.
    ///
    /// ```sable
    /// let deque = Deque<Int>([1, 3])
    /// deque.insert(2, at: 1)
    /// assert(deque.toArray() == [1, 2, 3])
    /// ```
    public fn insert(_ value: Element, at position: Int) {
        if position < 0 || position > used {
            let nothing: Int[>..] = []
            _ = nothing[position]
        }
        if position == used {
            append(value)
            return
        }
        if position == 0 {
            prepend(value)
            return
        }
        if used == slots.count {
            grow()
        }
        if position < used - position {
            // The front moves back a place.
            head = head &- 1
            tail = tail &- 1
            var i = 0
            while i < position {
                slots[slot(i)] = slots.take(at: slot(i + 1))
                i += 1
            }
        } else {
            var i = used
            while i > position {
                slots[slot(i)] = slots.take(at: slot(i - 1))
                i -= 1
            }
        }
        slots[slot(position)] = value
        tail = tail &+ 1
    }

    /// The element at the position, taken out, those on the shorter side
    /// moved to close the gap.
    ///
    /// ```sable
    /// let deque = Deque<Int>([1, 2, 3])
    /// assert(deque.remove(at: 1) == 2)
    /// assert(deque.toArray() == [1, 3])
    /// ```
    public fn remove(at position: Int) -> Element {
        let removed = slots.take(at: checked(position))
        if position < used - 1 - position {
            var i = position
            while i > 0 {
                slots[slot(i)] = slots.take(at: slot(i - 1))
                i -= 1
            }
            head = head &+ 1
            tail = tail &+ 1
        } else {
            var i = position
            while i < used - 1 {
                slots[slot(i)] = slots.take(at: slot(i + 1))
                i += 1
            }
        }
        tail = tail &- 1
        return removed
    }

    /// The elements turned round by so many places: a positive count moves
    /// that many from the front to the back, as Rust's 'rotate_left'; a
    /// negative one from the back to the front. The shorter way round is
    /// taken.
    ///
    /// ```sable
    /// let deque = Deque<Int>([1, 2, 3, 4])
    /// deque.rotate(by: 1)
    /// assert(deque.toArray() == [2, 3, 4, 1])
    /// deque.rotate(by: -2)
    /// assert(deque.toArray() == [4, 1, 2, 3])
    /// ```
    public fn rotate(by places: Int) {
        if used < 2 {
            return
        }
        var left = places % used
        if left < 0 {
            left += used
        }
        if left <= used - left {
            var i = 0
            while i < left {
                append(removeFirst()!)
                i += 1
            }
        } else {
            var i = 0
            while i < used - left {
                prepend(removeLast()!)
                i += 1
            }
        }
    }
}

// A deque is a random-access collection whose elements can be replaced
// where they are: its positions are its offsets from the front, 0 up to
// the count, whichever slots they are in.
extension Deque: RandomAccessCollection, MutableCollection, FromSequence<Element> {
    /// An iterator over the elements, front to back.
    public fn makeIterator() -> DequeIterator<Element> {
        return DequeIterator<Element> { slots: slots, position: head, end: tail }
    }

    /// The front element's position: 0.
    public var startIndex: Int => 0

    /// The position past the back element: the count.
    public var endIndex: Int => used

    /// The next position.
    public fn index(after position: Int) -> Int => position + 1

    /// The position before.
    public fn index(before position: Int) -> Int => position - 1

    /// The position 'distance' on.
    public fn index(_ position: Int, offsetBy distance: Int) -> Int => position + distance

    /// How far on 'end' is from 'start'.
    public fn distance(from start: Int, to end: Int) -> Int => end - start
}

/// Gives a deque's elements, front to back. It holds the deque's slots as
/// they were when it was made, sharing them until either changes, so a
/// change to the deque after is not seen.
public struct DequeIterator<Element>: Iterator {
    let slots: Element[>..]
    var position: Int
    let end: Int

    /// The next element, or none past the back.
    public mutating fn next() -> Element? {
        if position == end {
            return none
        }
        let element = slots[position & (slots.count &- 1)]
        position = position &+ 1
        return element
    }
}
