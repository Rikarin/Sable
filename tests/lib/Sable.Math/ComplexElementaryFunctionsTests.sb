}

@test
fn sqrtIsWithinAFewUlpsOfTheTrueValue() {
    let cases: (F64, F64, F64, F64)[>..] = [
        (0.5, 0.25, 0.7276733451126774, 0.17178037486125622),
        (-1.5, 2.0, 0.7071067811865476, 1.4142135623730951),
        (3.0, -0.7, 1.743643363785994, -0.20072912114323696),
        (-0.2, -0.9, 0.6008138004944996, -0.7489841272447931),
        (1e-05, 1e-06, 0.003166218219036781, 0.00015791710027873842),
        (20.0, 3.0, 4.484626429043822, 0.3344760201843208),
        (0.6, 0.8, 0.8944271909999159, 0.447213595499958),
        (1e+308, 1e+308, 1.09868411346781e+154, 4.5508986056222734e+153),
        (-1e-320, 1e-320, 4.5508732733903664e-161, 1.0986779977260263e-160),
        (4.0, 1e-300, 2.0, 2.5e-301),
        (-4.0, 1e-300, 2.5e-301, 2.0),
    ]
    for (x, y, re, im) in cases {
        assertNear(sqrt(Complex(x, y)), re, im)
    }
}

@test
fn sqrtOfF32IsWithinAFewUlpsOfTheTrueValue() {
    let cases: (F32, F32, F32, F32)[>..] = [
        (0.5, 0.25, 0.727673351764679, 0.17178037762641907),
        (-1.5, 2.0, 0.7071067690849304, 1.4142135381698608),
        (3.0, -0.699999988079071, 1.7436434030532837, -0.2007291167974472),
        (-0.20000000298023224, -0.8999999761581421, 0.6008138060569763, -0.7489840984344482),
        (9.999999747378752e-06, 9.999999974752427e-07, 0.003166218288242817, 0.00015791710757184774),
        (20.0, 3.0, 4.484626293182373, 0.3344760239124298),
        (0.6000000238418579, 0.800000011920929, 0.8944271802902222, 0.4472135901451111),
        (9.999999680285692e+37, 9.999999680285692e+37, 1.0986841353249358e+19, 4.550898418574164e+18),
