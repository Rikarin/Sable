module Sable.Net.Tls

import Sable.Crypto

/// One direction's record protection (RFC 8446 §5.2–5.3): records sealed
/// with the suite's AEAD under the key and IV of a traffic secret, each
/// with its own nonce, the IV and the record's sequence number together.
/// The content's type is sealed with it, and so are any padding zeros.
///
/// ```sable
/// let secret = SymmetricKey(U8[>..](repeating: 9, count: 32))
/// var writer = TlsRecordCipher(.ChaCha20Poly1305Sha256, trafficSecret: secret)
/// var reader = TlsRecordCipher(.ChaCha20Poly1305Sha256, trafficSecret: secret)
/// let record = try! writer.seal([1, 2, 3], type: .ApplicationData, padding: 4)
/// assert(record.count == 5 + 3 + 1 + 4 + 16 && record[0] == 23)
/// let (type, content) = try! reader.open(record)
/// assert(type == .ApplicationData && content == [1, 2, 3] && reader.sequenceNumber == 1)
/// ```
public struct TlsRecordCipher: Sendable {
    /// The longest content a record may carry.
    public static var maximumContentByteCount: Int => 1 << 14

    /// The suite it seals with.
    public let suite: TlsCipherSuite

    /// The write IV.
    public let iv: U8[>..]

    /// The number of the next record.
    public private(set) var sequenceNumber: Int = 0

    let aead: RecordAead

    /// The cipher of a traffic secret: its key and IV derived as §7.3 says.
    public init(_ suite: TlsCipherSuite, trafficSecret: SymmetricKey) {
        self.suite = suite
        let key = TlsKeySchedule.expandLabel(suite, trafficSecret, "key", context: [], byteCount: suite.keyByteCount)
        let iv = TlsKeySchedule.expandLabel(suite, trafficSecret, "iv", context: [], byteCount: 12)
        self.iv = iv.bytes()
        self.aead = match suite {
            case .ChaCha20Poly1305Sha256 => RecordAead.ChaCha(try! ChaCha20Poly1305(key: key))
            default                      => RecordAead.Gcm(try! AesGcm(key: key))
        }
    }

    /// A whole record of the content, header and all, with so many zeros of
    /// padding sealed after it.
    public mutating fn seal(_ content: U8[:], type: TlsContentType, padding: Int = 0) throws(TlsError) -> U8[>..] {
        if content.count > TlsRecordCipher.maximumContentByteCount || padding < 0 || content.count + 1 + padding > TlsRecordCipher.maximumContentByteCount + 1 {
            throw TlsError.Failed(.internalError, reason: "a record of \(content.count) bytes and \(padding) of padding is too long")
        }
        var text = content.toArray()
        text.append(U8(type.code))
        for _ in 0..<padding {
            text.append(0)
        }
        let length = text.count + 16
        let header: U8[>..] = [23, 3, 3, U8(length >> 8), U8(length & 0xFF)]
        let box = try aead.seal(text, nonce: nextNonce(), associatedData: header)
        var record = header
        record.append(contentsOf: box.ciphertext)
        record.append(contentsOf: box.tag)
        secureZero(&text)
        return record
    }

    /// The type and content of a whole record, header and all; bad_record_mac
    /// if it is not one sealed under this key, in this place.
    public mutating fn open(_ record: U8[:]) throws(TlsError) -> (TlsContentType, U8[>..]) {
        if record.count < 5 + 17 {
            throw TlsError.Failed(.decodeError, reason: "a protected record of \(record.count) bytes")
        }
        if record.count - 5 > TlsRecordCipher.maximumContentByteCount + 256 {
            throw TlsError.Failed(.recordOverflow, reason: "a protected record of \(record.count - 5) bytes")
        }
        if record[0] != 23 {
            throw TlsError.Failed(.unexpectedMessage, reason: "a record of type \(record[0]) where a protected one should be")
        }
        let body = record[5..<record.count - 16]
        let tag = record[record.count - 16..<record.count]
        var text: U8[>..] = []
        do {
            text = try aead.open(body, nonce: nextNonce(), tag: tag, associatedData: record[0..<5])
        } catch {
            throw TlsError.Failed(.badRecordMac, reason: "a record that does not open")
        }
        var end = text.count
        while end > 0 && text[end - 1] == 0 {
            end -= 1
        }
        if end == 0 {
            throw TlsError.Failed(.unexpectedMessage, reason: "a record with no content type")
        }
        if end - 1 > TlsRecordCipher.maximumContentByteCount {
            throw TlsError.Failed(.recordOverflow, reason: "a record of \(end - 1) bytes")
        }
        guard let type = TlsContentType.of(code: Int(text[end - 1])) else {
            throw TlsError.Failed(.unexpectedMessage, reason: "a record of content type \(text[end - 1])")
        }
        let content = text[0..<end - 1].toArray()
        secureZero(&text)
        return (type, content)
    }

    mutating fn nextNonce() -> U8[>..] {
        var nonce = iv
        var number = sequenceNumber
        var i = 11
        while i >= 4 {
            nonce[i] = nonce[i] ^ U8(number & 0xFF)
            number = number >> 8
            i -= 1
        }
        sequenceNumber += 1
        return nonce
    }
}

/// The AEAD of a suite.
union RecordAead: Sendable {
    Gcm(AesGcm)
    ChaCha(ChaCha20Poly1305)

    fn seal(_ text: U8[:], nonce: U8[:], associatedData: U8[:]) throws(TlsError) -> SealedBox {
        do {
            return match self {
                case .Gcm(let cipher)    => try cipher.seal(text, nonce: nonce, associatedData: associatedData)
                case .ChaCha(let cipher) => try cipher.seal(text, nonce: nonce, associatedData: associatedData)
            }
        } catch {
            throw TlsError.Failed(.internalError, reason: "a record that would not seal: \(error.description())")
        }
    }

    fn open(_ text: U8[:], nonce: U8[:], tag: U8[:], associatedData: U8[:]) throws(CryptoError) -> U8[>..] {
        return match self {
            case .Gcm(let cipher)    => try cipher.open(text, nonce: nonce, tag: tag, associatedData: associatedData)
            case .ChaCha(let cipher) => try cipher.open(text, nonce: nonce, tag: tag, associatedData: associatedData)
        }
    }
}
