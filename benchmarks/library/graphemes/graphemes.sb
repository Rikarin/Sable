module GraphemesBench

import Sable.Testing
import Sable.Text

// Grapheme clusters: the user-perceived characters of a megabyte of text,
// some of them several scalars.

fn run(_ text: String) -> String {
    var total = 0
    for _ in 0..<3 {
        // Each round reads the input anew: nothing is kept from the last.
        _ = blackBox(total)
        total += text.graphemeCount
    }
    return "\(total)"
}

@bench
fn measure(_ b: Bencher) {
    let text = "Plain words, e\u{301}te\u{301}, мир, 世界 and \u{1F600}\r\n".repeated(20000)
    b.check(b.iterate { run(text) })
}
