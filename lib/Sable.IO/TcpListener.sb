module Sable.IO

/// A TCP socket listening for connections. Waiting for one suspends the
/// task, not its thread: the runtime's I/O reactor (kqueue, epoll, an I/O
/// completion port) wakes it as one comes, and other tasks run meanwhile.
/// Deeply immutable, so Sendable: a listener may be handed to another task.
///
/// ```sable
/// fn serve() async throws(IoError) {
///     let listener = try TcpListener.bind(host: "127.0.0.1", port: 0)
///     let connection = try await listener.accept()
///     try await connection.write([1, 2, 3])
/// }
/// ```
@immutable
public class TcpListener {
    let handle: Int

    /// The port it listens on: the one asked for, or the one the system
    /// chose when asked for 0.
    public let port: Int

    init(handle: Int) {
        self.handle = handle
        port = Runtime.socketPort(handle)
    }

    deinit {
        Runtime.closeSocket(handle)
    }

    /// Listens on the host's address — a name, or a numeric address — and
    /// port; port 0 has the system choose a free one.
    public static fn bind(host: String, port: Int) throws(IoError) -> TcpListener {
        let handle = Runtime.listen(host: host, port: port)
        if handle == 0 {
            throw IoError.Unreachable(address: "\(host):\(port)")
        }
        return TcpListener(handle: handle)
    }

    /// The next connection, waiting until one comes. A task cancelled while
    /// it waits throws Cancelled.
    public fn accept() async throws(IoError) -> TcpStream {
        while true {
            let accepted = Runtime.accept(handle)
            if accepted != 0 {
                return TcpStream(handle: accepted)
            }
            try await waitFor(handle, writable: false)
        }
    }

    /// Stops listening: a task waiting in 'accept' wakes and throws.
    /// Dropping the listener closes it too.
    public fn close() {
        Runtime.closeSocket(handle)
    }
}

/// Waits for the socket, once a call on it has found it would block; or
/// throws, if the call failed, or the task is cancelled.
fn waitFor(_ handle: Int, writable: Bool) async throws(IoError) {
    if Runtime.socketStatus() != 1 {
        throw IoError.Disconnected
    }
    if Task.isCancelled {
        throw IoError.Cancelled
    }
    await Runtime.waitForSocket(handle, writable: writable)
    if Task.isCancelled {
        throw IoError.Cancelled
    }
}
