module DnsTests

// Dns (Sable.Net): nothing is asked but for localhost's addresses, which
// every system has in its hosts file. Run with
//     tools/stdlib-coverage.sh Sable.Net

import NetSupport
import Sable.IO
import Sable.Net
import Sable.Testing
import Sable.Time

@test
fn localhostIsLookedUp() async throws {
    let all = try await Dns.resolve("localhost")
    expect(!all.isEmpty)
    expect(all.allSatisfy { $0.isLoopback }, "\(all:?)")
    let four = try await Dns.resolve("localhost", family: .V4, timeout: Duration.seconds(20))
    assertEqual(four, [IpAddress.v4Loopback])
}

@test
fn anAddressIsItself() async throws {
    assertEqual(try await Dns.resolve("192.0.2.1"), [IpAddress(192, 0, 2, 1)])
    assertEqual(try await Dns.resolve("2001:db8::1", family: .V6), [try! IpAddress.parse("2001:db8::1")])
    await expectThrows(saying: "'192.0.2.1' has no address") {
        _ = try await Dns.resolve("192.0.2.1", family: .V6)
    }
}

/// None of these reaches the resolver, which might read it as an address.
@test(arguments: ["", "127.1", "0x7f.1", "0177.0.0.1", "2130706433", "0x7f000001", "127.0.0.01", "127.0.0.1.", "１２７.0.0.1", "a b", "a/b", "a:b", "[::1]", "::g",
    "a\0.b", "a@b", "a%b"])
fn textThatIsNoNameIsRefused(_ host: String) async {
    let error = await expectThrows(IoError.self) { _ = try await Dns.resolve(host) }
    expect(error?.description()?.hasSuffix("was given something the system does not take") == true, "\(error:?)")
}

@test
fn aCancelledLookupThrows() async {
    let task = Task.spawn { await thrown {
        while true {
            _ = try await Dns.resolve("localhost")
            if Task.isCancelled {
                throw IoError.Cancelled
            }
        }
    } }
    try? await Task.sleep(nanoseconds: 5_000_000)
    task.cancel()
    assertEqual(await task.value, "the task was cancelled while it waited")
}

@test
fn aLookupWithNoTimeTimesOutOrIsDone() async {
    let said = await thrown {
        _ = try await Dns.resolve("localhost", timeout: Duration.zero)
    }
    expect(said == "" || said == "it took too long", said)
}

@test
fn manyLookupsRunAtOnce() async {
    var lookups: Task<Bool>[>..] = []
    for _ in 0..<100 {
        lookups.append(Task.spawn { ((try? await Dns.resolve("localhost", family: .V4)) ?? []) == [IpAddress.v4Loopback] })
    }
    var right = 0
    for lookup in lookups {
        right += await lookup.value ? 1 : 0
    }
    assertEqual(right, 100)
}
