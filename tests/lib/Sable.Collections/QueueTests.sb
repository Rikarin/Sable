module QueueTests

// Queue (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn aQueueIsGoneThroughFromTheFront() {
    let queue = Queue<Int>()
    queue.enqueue(1)
    queue.enqueue(2)
    queue.enqueue(3)
    let _ = queue.dequeue()
    queue.enqueue(4)
    queue.enqueue(5)

    // Some of them have moved to be dequeued, some have not.
    var seen: String[>..] = []
    for value in queue {
        seen.append("\(value)")
    }
    assertEqualText(seen.joined(separator: ","), "2,3,4,5")
    assertEqual(queue.count, 4)
    assertEqual(Queue<Int>().toArray().count, 0)
}

@test
fn queueIsFirstInFirstOut() {
    let queue = Queue<String>()
    queue.enqueue("a")
    queue.enqueue("b")
    assertEqual(queue.dequeue() ?? "", "a")
    queue.enqueue("c")
    assertEqual(queue.dequeue() ?? "", "b")
    assertEqual(queue.dequeue() ?? "", "c")
    assert(queue.dequeue() == none)
}

@test
fn countCoversBothHalves() {
    let queue = Queue<Int>()
    assert(queue.isEmpty)
    assertEqual(queue.count, 0)
    queue.enqueue(1)
    queue.enqueue(2)
    queue.enqueue(3)
    assertEqual(queue.dequeue() ?? 0, 1)
    queue.enqueue(4)
    assertEqual(queue.count, 3)
    assert(!queue.isEmpty)
}

@test
fn aQueueIsMadeFromAnySequenceFirstAtTheFront() {
    let queue = Queue(1...3)
    assertEqual(queue.dequeue(), 1)
    assertEqual(queue.count, 2)
    let collected: Queue<String> = ["x", "y"].collect()
    assertEqual(collected.dequeue(), "x")
}
