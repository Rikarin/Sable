module TensorPrimitivesBench

// Sable.Math's vector kernels against .NET's TensorPrimitives
// (System.Numerics.Tensors): sum, dot, cosine similarity, add, multiply
// and softmax over 4096 F32s — a size that stays in the first-level cache,
// so that the arithmetic is what is measured — twenty thousand times each
// (softmax, which is an exponential an element, two thousand). One
// element changes each round, so that no round's work is the last's. The
// values are small integers, so that the sums and products are exact
// whatever order each side adds them in; what is not exact is rounded:
// the cosine to three places, and the softmax, whose exponential each
// side computes its own way, to four.

import Sable.Math

@main
fn main() {
    let n = 4096
    var x: F32[>..] = []
    var y: F32[>..] = []
    for i in 0..<n {
        x.append(F32(i % 7 - 3))
        y.append(F32(i % 5 - 2))
    }
    var sums: F32[>..] = y
    var products: F32[>..] = y
    var probabilities: F32[>..] = y

    var total = 0.0
    var cosine = 0.0
    var round = 0
    while round < 20000 {
        x[round % n] = F32(round % 7 - 3)
        total = total + F64(TensorPrimitives.sum(x)) + F64(TensorPrimitives.dot(x, y))
        cosine = cosine + F64(TensorPrimitives.cosineSimilarity(x, y))
        TensorPrimitives.add(x, y, into: &sums)
        TensorPrimitives.multiply(sums, y, into: &products)
        total = total + F64(products[round % n])
        round = round + 1
    }

    var spread = 0.0
    round = 0
    while round < 2000 {
        y[round % n] = F32(round % 5 - 2)
        TensorPrimitives.softmax(y, into: &probabilities)
        spread = spread + F64(probabilities[round % n])
        round = round + 1
    }

    print("\(total:.1f) \(cosine:.3f) \(F64(TensorPrimitives.sum(products)):.1f) \(spread:.4f)")
}
