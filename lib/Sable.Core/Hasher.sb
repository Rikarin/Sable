module Sable.Core

/// Hashes values into one Int: what a Dictionary and a Set place their keys
/// by, and what a type's `hash(into:)` feeds its fields to.
///
/// A hasher starts from a seed that is random for each run of the program,
/// so a hash is not the same from one run to the next, and keys chosen to
/// collide in one run (to make a dictionary's every lookup its slowest, as
/// in hash flooding) collide in no other. Set `SABLE_DETERMINISTIC_HASHING=1`
/// to fix the seed when runs must repeat, as tests' sometimes must, or give
/// a seed of your own with `init(seed:)`.
///
/// A word is mixed in with one 64-by-64-bit multiply whose two halves are
/// folded together, under the seed — fast for the integers most keys are,
/// and unpredictable without the seed. A string's bytes are hashed under
/// the seed the same way, sixteen to a multiply, in the runtime, and the
/// result mixed in.
///
/// ```sable
/// var a = Hasher(seed: 7)
/// a.combine(1)
/// a.combine("one")
/// var b = Hasher(seed: 7)
/// b.combine(1)
/// b.combine("one")
/// assert(a.finalize() == b.finalize())
/// ```
public struct Hasher {
    var state: U64
    var key: U64

    /// A hasher seeded for this run of the program.
    public init() {
        key = Runtime.hashSeed() unchecked as U64
        state = key
    }

    /// A hasher with the seed given: the same values give the same hash in
    /// every run, with every seed alike.
    public init(seed: U64) {
        key = seed
        state = seed
    }

    /// Mixes in a value, by its own `hash(into:)`.
    public mutating fn combine<T: Hashable>(_ value: T) {
        value.hash(into: &self)
    }

    /// Mixes in a 64-bit word.
    public mutating fn write(_ word: U64) {
        let multiplier: U64 = 0x9E3779B97F4A7C15
        state = Hasher.fold(state ^ word, multiplier)
    }

    /// Mixes in the bytes, eight to a word, then how many there were — so
    /// that `[1]` then `[2, 3]` hashes differently from `[1, 2]` then `[3]`.
    public mutating fn write(_ bytes: U8[:]) {
        var word: U64 = 0
        var shift: U64 = 0
        for byte in bytes {
            word = word | (U64(byte) << shift)
            shift = shift + 8
            if shift == 64 {
                write(word)
                word = 0
                shift = 0
            }
        }
        if shift > 0 {
            write(word)
        }
        write(U64(bytes.count))
    }

    /// Mixes in a string's UTF-8 bytes, hashed under this hasher's seed.
    mutating fn write(text: String) {
        write(Runtime.hashString(text: text, key: key unchecked as Int) unchecked as U64)
    }

    /// Mixes in a range of a string's bytes as the string of just those
    /// bytes would be: what a Substring hashes as.
    mutating fn write(text: String, from: Int, to: Int) {
        write(Runtime.hashString(text, from, to, key: key unchecked as Int) unchecked as U64)
    }

    /// The hash of everything mixed in so far. The hasher is left as it
    /// was: more can be mixed in, and a later `finalize` covers it all.
    public fn finalize() -> Int {
        let rotated = (key << 23) | (key >> 41)
        let multiplier: U64 = 0xD6E8FEB86659FD93
        return Hasher.fold(state ^ rotated, multiplier) unchecked as Int
    }

    /// The 128-bit product's high half folded onto its low half: every bit
    /// of each operand reaches every bit of the result.
    static fn fold(_ a: U64, _ b: U64) -> U64 {
        let product = U128(a) * U128(b)
        return (product unchecked as U64) ^ ((product >> 64) unchecked as U64)
    }
}
