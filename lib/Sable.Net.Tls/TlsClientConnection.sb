module Sable.Net.Tls

import Sable.Crypto
import Sable.Crypto.X509
import Sable.Time

/// The client's end of a TLS 1.3 connection (RFC 8446), with no I/O of its
/// own: bytes that came from the server go in through `receive`, and what
/// is to be sent back comes out of `takeOutgoing`. `TlsStream` drives one
/// over a stream; a test, or another transport, may drive it by hand.
///
/// The handshake has an ephemeral key exchange: a share of X25519 offered,
/// and one of P-256 sent again if the server asks for it with a
/// HelloRetryRequest; a certificate checked as the options say, and a
/// signature by its key. A session of the host in the options' cache is
/// offered too (RFC 8446 §4.2.11), and if the server takes it, it sends no
/// certificate; the tickets the server sends after the handshake go into
/// the cache. Every fault found sends the server its alert and throws.
///
/// ```sable
/// var client = TlsClientConnection(host: "example.com")
/// let hello = client.takeOutgoing()
/// assert(hello[0] == 22 && !client.isHandshakeComplete)
/// do {
///     try client.receive([21, 3, 3, 0, 2, 2, 40])
///     assert(false)
/// } catch {
///     assert(error.alert == .handshakeFailure)
/// }
/// ```
public struct TlsClientConnection: Sendable {
    /// The name the server's certificate must be for, and the one sent in
    /// server_name.
    public let host: String

    let options: TlsClientOptions
    var keyShares: TlsKeyShare[>..]
    let sessionId: U8[>..]
    var state: ClientState = .WaitServerHello
    var transcript: U8[>..]
    var records = TlsRecords()
    var schedule: TlsKeySchedule? = none

    /// The session offered, if any.
    var offeredSession: TlsSession?

    /// The secret tickets' keys are derived from, once the handshake is
    /// over.
    var resumptionSecret: SymmetricKey? = none

    /// When the tickets that come are had.
    let time: UtcDateTime

    /// The suite of the HelloRetryRequest, once one has come.
    var retriedSuite: TlsCipherSuite? = none
    var retriedGroup: Int = 0
    var retriedCookie: U8[>..]? = none

    /// The suite the server chose; none before its ServerHello.
    public private(set) var cipherSuite: TlsCipherSuite? = none

    /// The application protocol the server chose; none if it chose none.
    public private(set) var applicationProtocol: String? = none

    /// The server's certificates as it sent them, its own first; none if
    /// a session was resumed.
    public private(set) var peerCertificates: Certificate[>..] = []

    /// Whether the server took the session offered: the handshake was a
    /// resumption, and the server's certificate was trusted when the session
    /// was made.
    public private(set) var isResumed = false

    /// Whether the server has finished writing.
    public var isPeerClosed: Bool => records.isPeerClosed

    /// Whether this end has finished writing.
    public var isClosedForWriting: Bool => records.isClosedForWriting

    /// A client of the host, its ClientHello ready to be taken: a key share
    /// of X25519, P-256 named as the other group it takes, and a session of
    /// the host from the options' cache, if it has one.
    public init(host: String, options: TlsClientOptions = TlsClientOptions()) {
        let shares: TlsKeyShare[>..] = [.X25519(X25519PrivateKey.generate())]
        let time = options.time ?? UtcDateTime.now()
        let session = options.sessionCache?.take(host: host, at: time)
        let hello = TlsClientConnection.clientHello(host: host, options: options, keyShares: shares, session: session, at: time)
        self.init(host: host, options: options, clientHello: hello, keyShares: shares, session: session)
    }

    /// A client that sends a ClientHello of the caller's own — a handshake
    /// message, with the ephemeral keys of its key shares, and the session
    /// its pre_shared_key offers, if it offers one — as a recorded handshake
    /// is replayed. What the server answers is held to the options, not to
    /// the hello.
    public init(host: String, options: TlsClientOptions, clientHello: U8[:], keyShares: TlsKeyShare[:], session: TlsSession? = none) {
        self.host = host
        self.options = options
        self.offeredSession = session
        self.time = options.time ?? UtcDateTime.now()
        self.keyShares = keyShares.toArray()
        self.transcript = clientHello.toArray()
        let at = 4 + 2 + 32
        let length = clientHello.count > at ? Int(clientHello[at]) : 0
        self.sessionId = clientHello.count > at + length ? clientHello[at + 1..<at + 1 + length].toArray() : []
        appendRecord(&records.outgoing, 22, clientHello, legacyVersion: true)
    }

    /// Whether the handshake is over and application data may flow.
    public var isHandshakeComplete: Bool => records.isConnected

    /// The bytes to send the server, taken: none are left.
    public mutating fn takeOutgoing() -> U8[>..] {
        return records.takeOutgoing()
    }

    /// The application data that has come, taken: none is left.
    public mutating fn takeReceived() -> U8[>..] {
        return records.takeReceived()
    }

    /// Bytes from the server: as many records as they complete are read, and
    /// what to answer is queued. A fault sends its alert and throws, and the
    /// connection is of no more use.
    public mutating fn receive(_ bytes: U8[:]) throws(TlsError) {
        if records.isFailed {
            throw TlsError.Closed
        }
        records.incoming.append(contentsOf: bytes)
        do {
            while true {
                guard let message = try records.nextMessage() else {
                    break
                }
                let keysBefore = state
                try readMessage(Int(message[0]), message)
                if !records.handshakeBytes.isEmpty && keysChange(from: keysBefore) {
                    throw TlsError.Failed(.unexpectedMessage, reason: "a handshake message across a change of keys")
                }
            }
        } catch {
            records.fail(error)
            throw error
        }
    }

    /// Application data sealed into records to send.
    public mutating fn write(_ bytes: U8[:]) throws(TlsError) {
        try records.write(bytes)
    }

    /// close_notify queued to send: this end writes no more, though it may
    /// read on until the server closes too.
    public mutating fn close() {
        records.close()
    }

    fn keysChange(from before: ClientState) -> Bool {
        return match (before, state) {
            case (.WaitServerHello, _) => true
            case (.WaitFinished, _)    => true
            default                    => false
        }
    }

    mutating fn readMessage(_ type: Int, _ message: U8[>..]) throws(TlsError) {
        var body = TlsReader(message[4..<message.count], "a handshake message")
        match state {
            case .WaitServerHello => {
                try expect(type, 2, "ServerHello")
                if try readServerHello(&body) {
                    try retry(message)
                } else {
                    transcript.append(contentsOf: message)
                    try startHandshakeKeys()
                    state = .WaitEncryptedExtensions
                }
            }
            case .WaitEncryptedExtensions => {
                try expect(type, 8, "EncryptedExtensions")
                try readEncryptedExtensions(&body)
                transcript.append(contentsOf: message)
                state = isResumed ? .WaitFinished : .WaitCertificate
            }
            case .WaitCertificate => {
                try expect(type, 11, "Certificate")
                try readCertificate(&body)
                transcript.append(contentsOf: message)
                try checkTrust()
                state = .WaitCertificateVerify
            }
            case .WaitCertificateVerify => {
                try expect(type, 15, "CertificateVerify")
                try readCertificateVerify(&body)
                transcript.append(contentsOf: message)
                state = .WaitFinished
            }
            case .WaitFinished => {
                try expect(type, 20, "Finished")
                try readFinished(&body)
                transcript.append(contentsOf: message)
                try finishHandshake()
                state = .Connected
            }
            case .Connected => {
                if type == 4 {
                    try readNewSessionTicket(&body)
                } else {
                    try records.readPostHandshake(type, &body)
                }
            }
        }
    }

    fn expect(_ type: Int, _ wanted: Int, _ name: String) throws(TlsError) {
        if type != wanted {
            throw TlsError.Failed(.unexpectedMessage, reason: "a handshake message of type \(type) where a \(name) should be")
        }
    }

    fn transcriptHash() -> U8[>..] {
        return cipherSuite!.hashAlgorithm.digest(of: transcript).bytes
    }

    /// Whether it was a HelloRetryRequest: true with the group asked for
    /// and any cookie kept; false with the handshake's secret found.
    mutating fn readServerHello(_ body: inout TlsReader) throws(TlsError) -> Bool {
        if try body.number(2) != 0x0303 {
            throw TlsError.Failed(.protocolVersion, reason: "a ServerHello of legacy version other than TLS 1.2's")
        }
        let isRetry = try body.take(32) == TlsClientConnection.retryRandom
        if isRetry && retriedSuite != none {
            throw TlsError.Failed(.unexpectedMessage, reason: "a second HelloRetryRequest")
        }
        if try body.vector(1) != sessionId {
            throw TlsError.Failed(.illegalParameter, reason: "a ServerHello that does not echo the session id")
        }
        let code = try body.number(2)
        guard let suite = TlsCipherSuite.of(code: code) else {
            throw TlsError.Failed(.illegalParameter, reason: "a cipher suite \(code) that was not offered")
        }
        if !options.cipherSuites.contains(suite) {
            throw TlsError.Failed(.illegalParameter, reason: "a cipher suite \(suite) that was not offered")
        }
        if retriedSuite != none && retriedSuite != suite {
            throw TlsError.Failed(.illegalParameter, reason: "a ServerHello of another suite than its HelloRetryRequest's")
        }
        if try body.number(1) != 0 {
            throw TlsError.Failed(.illegalParameter, reason: "a ServerHello with compression")
        }
        var extensions = TlsReader(try body.vector(2), "ServerHello's extensions")
        try body.finish()
        var version = 0
        var share: (Int, U8[>..])? = none
        var cookie: U8[>..]? = none
        var tookSession = false
        while !extensions.isAtEnd {
            let type = try extensions.number(2)
            var data = TlsReader(try extensions.vector(2), "a ServerHello extension")
            match type {
                case 43 => {
                    version = try data.number(2)
                }
                case 51 => {
                    let group = try data.number(2)
                    share = (group, isRetry ? [] : try data.vector(2))
                }
                case 44 => {
                    if !isRetry {
                        throw TlsError.Failed(.unsupportedExtension, reason: "a cookie in a ServerHello")
                    }
                    cookie = try data.take(data.bytes.count)
                }
                case 41 => {
                    let selected = try data.number(2)
                    if isRetry || offeredSession == none || selected != 0 {
                        throw TlsError.Failed(.illegalParameter, reason: "a pre_shared_key that was not offered")
                    }
                    tookSession = true
                }
                default => throw TlsError.Failed(.unsupportedExtension, reason: "a ServerHello extension \(type) that was not asked for")
            }
            try data.finish()
        }
        if version != 0x0304 {
            throw TlsError.Failed(.protocolVersion, reason: "a server that does not speak TLS 1.3")
        }
        guard let (group, key) = share else {
            throw TlsError.Failed(.missingExtension, reason: "a ServerHello with no key share")
        }
        if isRetry {
            if group != 0x001D && group != 0x0017 {
                throw TlsError.Failed(.illegalParameter, reason: "a HelloRetryRequest for group \(group), which was not offered")
            }
            for each in keyShares {
                if each.group == group {
                    throw TlsError.Failed(.illegalParameter, reason: "a HelloRetryRequest for group \(group), of which a share was sent")
                }
            }
            retriedSuite = suite
            retriedGroup = group
            retriedCookie = cookie
            if let session = offeredSession, session.cipherSuite.hashAlgorithm != suite.hashAlgorithm {
                offeredSession = none
            }
            return true
        }
        var secret: SymmetricKey? = none
        for each in keyShares {
            if each.group == group {
                secret = try each.sharedSecret(with: key)
            }
        }
        guard let shared = secret else {
            throw TlsError.Failed(.illegalParameter, reason: "a key share of group \(group), which was not offered")
        }
        var preSharedKey: SymmetricKey? = none
        if tookSession {
            let session = offeredSession!
            if session.cipherSuite.hashAlgorithm != suite.hashAlgorithm {
                throw TlsError.Failed(.illegalParameter, reason: "a session resumed with a suite of another hash")
            }
            preSharedKey = session.resumptionKey
            isResumed = true
        }
        cipherSuite = suite
        records.suite = suite
        var keys = TlsKeySchedule(suite, preSharedKey: preSharedKey)
        keys.advance(sharedSecret: shared)
        schedule = keys
        return false
    }

    /// The second ClientHello, for the HelloRetryRequest's group (RFC 8446
    /// §4.1.4): the first one with a share of that group alone and the
    /// server's cookie, after a transcript whose first ClientHello is its
    /// hash.
    mutating fn retry(_ request: U8[>..]) throws(TlsError) {
        let share: TlsKeyShare = retriedGroup == 0x001D ? .X25519(X25519PrivateKey.generate()) : .P256(EcdhPrivateKey<Sable.Crypto.P256>.generate())
        keyShares = [share]
        let hash = retriedSuite!.hashAlgorithm.digest(of: transcript).bytes
        var first = TlsReader(transcript[4..<transcript.count], "the first ClientHello")
        var body = try first.take(2 + 32)
        appendVector(&body, try first.vector(1), 1)
        appendVector(&body, try first.vector(2), 2)
        appendVector(&body, try first.vector(1), 1)
        var extensions = TlsReader(try first.vector(2), "the first ClientHello's extensions")
        var written: U8[>..] = []
        while !extensions.isAtEnd {
            let type = try extensions.number(2)
            let data = try extensions.vector(2)
            if type == 41 || type == 45 {
                continue
            }
            if type == 51 {
                var shares: U8[>..] = []
                appendNumber(&shares, share.group, 2)
                appendVector(&shares, share.publicBytes, 2)
                var list: U8[>..] = []
                appendVector(&list, shares, 2)
                appendExtension(&written, 51, list)
            } else {
                appendExtension(&written, type, data)
            }
        }
        if let cookie = retriedCookie {
            appendExtension(&written, 44, cookie)
        }
        if let session = offeredSession {
            appendPreSharedKey(&written, session, at: time)
        }
        appendVector(&body, written, 2)
        var hello = handshakeMessage(1, body)
        var earlier: U8[>..] = [254, 0, 0, U8(hash.count)]
        earlier.append(contentsOf: hash)
        earlier.append(contentsOf: request)
        if let session = offeredSession {
            TlsClientConnection.bind(&hello, session, after: earlier)
        }
        transcript = earlier
        transcript.append(contentsOf: hello)
        try records.send(hello)
    }

    /// The binder of the session (RFC 8446 §4.2.11.2) written over the
    /// placeholder at the end of the hello: the HMAC, under the finished key
    /// of its binder key, of the transcript's hash up to the binders.
    static fn bind(_ hello: inout U8[>..], _ session: TlsSession, after earlier: U8[:]) {
        let length = session.cipherSuite.hashAlgorithm.digestByteCount
        var partial = earlier.toArray()
        partial.append(contentsOf: hello[0..<hello.count - 3 - length])
        let binder = TlsClientConnection.binder(session.cipherSuite, session.resumptionKey, partial)
        for i in 0..<length {
            hello[hello.count - length + i] = binder[i]
        }
    }

    /// The binder of the pre-shared key for the transcript up to the
    /// binders.
    static fn binder(_ suite: TlsCipherSuite, _ preSharedKey: SymmetricKey, _ partial: U8[:]) -> U8[>..] {
        let early = TlsKeySchedule(suite, preSharedKey: preSharedKey)
        let key = early.deriveSecret("res binder", transcriptHash: suite.hashAlgorithm.digest(of: []).bytes)
        return TlsKeySchedule.finishedData(suite, trafficSecret: key, transcriptHash: suite.hashAlgorithm.digest(of: partial).bytes)
    }

    /// A ticket that came after the handshake: kept in the options' cache
    /// for the host, with the key derived from its nonce (RFC 8446 §4.6.1).
    mutating fn readNewSessionTicket(_ body: inout TlsReader) throws(TlsError) {
        let lifetime = try body.number(4)
        let ageAdd = try body.number(4)
        let nonce = try body.vector(1)
        let ticket = try body.vector(2)
        _ = try body.vector(2)
        try body.finish()
        if lifetime > 604800 {
            throw TlsError.Failed(.illegalParameter, reason: "a ticket of a lifetime longer than seven days")
        }
        if ticket.isEmpty {
            throw TlsError.Failed(.decodeError, reason: "an empty ticket")
        }
        guard let cache = options.sessionCache else {
            return
        }
        let suite = cipherSuite!
        let key = TlsKeySchedule.expandLabel(suite, resumptionSecret!, "resumption", context: nonce, byteCount: suite.hashAlgorithm.digestByteCount)
        cache.add(TlsSession(ticket: ticket, resumptionKey: key, cipherSuite: suite, received: time, lifetime: Duration.seconds(lifetime), ageAdd: ageAdd), host: host)
    }

    mutating fn startHandshakeKeys() throws(TlsError) {
        let hash = transcriptHash()
        records.useKeys(own: schedule!.deriveSecret("c hs traffic", transcriptHash: hash), peer: schedule!.deriveSecret("s hs traffic", transcriptHash: hash))
    }

    mutating fn readEncryptedExtensions(_ body: inout TlsReader) throws(TlsError) {
        var extensions = TlsReader(try body.vector(2), "EncryptedExtensions")
        try body.finish()
        while !extensions.isAtEnd {
            let type = try extensions.number(2)
            var data = TlsReader(try extensions.vector(2), "an EncryptedExtensions extension")
            if type == 16 {
                var names = TlsReader(try data.vector(2), "application_layer_protocol_negotiation")
                let name = try names.vector(1)
                try names.finish()
                guard let text = Runtime.decodeUtf8(bytes: name) else {
                    throw TlsError.Failed(.illegalParameter, reason: "an application protocol that is not UTF-8")
                }
                if !options.applicationProtocols.contains(text) {
                    throw TlsError.Failed(.illegalParameter, reason: "an application protocol \(text) that was not offered")
                }
                applicationProtocol = text
            } else if type == 43 || type == 51 {
                throw TlsError.Failed(.illegalParameter, reason: "an extension \(type) that belongs in the ServerHello")
            } else {
                _ = try data.take(data.bytes.count - data.at)
            }
            try data.finish()
        }
    }

    mutating fn readCertificate(_ body: inout TlsReader) throws(TlsError) {
        if !(try body.vector(1)).isEmpty {
            throw TlsError.Failed(.illegalParameter, reason: "a Certificate with a request context")
        }
        var list = TlsReader(try body.vector(3), "the certificate list")
        try body.finish()
        var certificates: Certificate[>..] = []
        while !list.isAtEnd {
            let der = try list.vector(3)
            _ = try list.vector(2)
            do {
                certificates.append(try Certificate.parse(der: der))
            } catch {
                throw TlsError.Failed(.badCertificate, reason: "a certificate that does not parse: \(error.description())")
            }
        }
        if certificates.isEmpty {
            throw TlsError.Failed(.decodeError, reason: "a server with no certificate")
        }
        peerCertificates = certificates
    }

    fn checkTrust() throws(TlsError) {
        let leaf = peerCertificates[0]
        match options.trust {
            case .Verified(let verifier) => {
                do {
                    _ = try verifier.verify(leaf, intermediates: peerCertificates[1..<peerCertificates.count], host: host, at: options.time ?? UtcDateTime.now())
                } catch {
                    throw TlsError.UntrustedCertificate(error)
                }
            }
            case .Pinned(let pinned) => {
                if !pinned.contains(leaf) {
                    throw TlsError.UntrustedCertificate(.UnknownIssuer(issuer: "\(leaf.issuer)"))
                }
            }
        }
    }

    mutating fn readCertificateVerify(_ body: inout TlsReader) throws(TlsError) {
        let scheme = try body.number(2)
        let signature = try body.vector(2)
        try body.finish()
        let content = certificateVerifyContent(server: true, transcriptHash: transcriptHash())
        var key: PublicKey? = none
        do {
            key = try peerCertificates[0].publicKey()
        } catch {
            throw TlsError.UntrustedCertificate(error)
        }
        if !TlsClientConnection.isValid(signature, scheme: scheme, of: content, key: key!) {
            throw TlsError.Failed(.decryptError, reason: "the server's CertificateVerify is no signature of its certificate's key")
        }
    }

    /// Whether the signature is the key's of the content by the scheme
    /// (RFC 8446 §4.2.3); false for a scheme not offered.
    static fn isValid(_ signature: U8[:], scheme: Int, of content: U8[:], key: PublicKey) -> Bool {
        match (scheme, key) {
            case (0x0403, .P256(let own)) => {
                guard let read = try? EcdsaSignature<Sable.Crypto.P256>(der: signature) else {
                    return false
                }
                return own.isValid(read, for: content, hash: .Sha256)
            }
            case (0x0503, .P384(let own)) => {
                guard let read = try? EcdsaSignature<Sable.Crypto.P384>(der: signature) else {
                    return false
                }
                return own.isValid(read, for: content, hash: .Sha384)
            }
            case (0x0804, .Rsa(let own)) => {
                return own.isValid(signature, for: content, padding: .Pss(.Sha256))
            }
            case (0x0805, .Rsa(let own)) => {
                return own.isValid(signature, for: content, padding: .Pss(.Sha384))
            }
            case (0x0806, .Rsa(let own)) => {
                return own.isValid(signature, for: content, padding: .Pss(.Sha512))
            }
            case (0x0807, .Ed25519(let own)) => {
                return own.isValid(signature, for: content)
            }
            default => {
                return false
            }
        }
    }

    mutating fn readFinished(_ body: inout TlsReader) throws(TlsError) {
        let data = try body.take(body.bytes.count)
        let wanted = TlsKeySchedule.finishedData(cipherSuite!, trafficSecret: records.peerSecret!, transcriptHash: transcriptHash())
        if !constantTimeEquals(data, wanted) {
            throw TlsError.Failed(.decryptError, reason: "the server's Finished is not the handshake's")
        }
    }

    mutating fn finishHandshake() throws(TlsError) {
        let hash = transcriptHash()
        var keys = schedule!
        keys.advance()
        let finished = handshakeMessage(20, TlsKeySchedule.finishedData(cipherSuite!, trafficSecret: records.ownSecret!, transcriptHash: hash))
        try records.send(finished)
        transcript.append(contentsOf: finished)
        records.useKeys(own: keys.deriveSecret("c ap traffic", transcriptHash: hash), peer: keys.deriveSecret("s ap traffic", transcriptHash: hash))
        resumptionSecret = keys.deriveSecret("res master", transcriptHash: transcriptHash())
        schedule = keys
        records.isConnected = true
    }

    /// The random of a HelloRetryRequest (RFC 8446 §4.1.3).
    static var retryRandom: U8[>..] => [
        0xCF, 0x21, 0xAD, 0x74, 0xE5, 0x9A, 0x61, 0x11, 0xBE, 0x1D, 0x8C, 0x02, 0x1E, 0x65, 0xB8, 0x91,
        0xC2, 0xA2, 0x11, 0x16, 0x7A, 0xBB, 0x8C, 0x5E, 0x07, 0x9E, 0x09, 0xE2, 0xC8, 0xA8, 0x33, 0x9C,
    ]

    /// The ClientHello this client sends: TLS 1.3 alone, the options'
    /// suites and protocols, the key shares, the host's name unless it is
    /// an address, and the session, if any, with its binder.
    static fn clientHello(host: String, options: TlsClientOptions, keyShares: TlsKeyShare[:], session: TlsSession?, at time: UtcDateTime) -> U8[>..] {
        var body: U8[>..] = [3, 3]
        body.append(contentsOf: SecureRandom.bytes(32))
        body.append(0)
        var suites: U8[>..] = []
        for suite in options.cipherSuites {
            appendNumber(&suites, suite.code, 2)
        }
        appendVector(&body, suites, 2)
        body.append(contentsOf: [1, 0])
        var extensions: U8[>..] = []
        if !TlsClientConnection.isAddress(host) {
            var name: U8[>..] = [0]
            appendVector(&name, host.utf8Bytes(), 2)
            var list: U8[>..] = []
            appendVector(&list, name, 2)
            appendExtension(&extensions, 0, list)
        }
        appendExtension(&extensions, 10, [0, 4, 0, 0x1D, 0, 0x17])
        appendExtension(&extensions, 13, [0, 12, 4, 3, 5, 3, 8, 4, 8, 5, 8, 6, 8, 7])
        var shares: U8[>..] = []
        for share in keyShares {
            appendNumber(&shares, share.group, 2)
            appendVector(&shares, share.publicBytes, 2)
        }
        var shareList: U8[>..] = []
        appendVector(&shareList, shares, 2)
        appendExtension(&extensions, 51, shareList)
        appendExtension(&extensions, 43, [2, 3, 4])
        if !options.applicationProtocols.isEmpty {
            var names: U8[>..] = []
            for name in options.applicationProtocols {
                appendVector(&names, name.utf8Bytes(), 1)
            }
            var list: U8[>..] = []
            appendVector(&list, names, 2)
            appendExtension(&extensions, 16, list)
        }
        if let session {
            appendPreSharedKey(&extensions, session, at: time)
        }
        appendVector(&body, extensions, 2)
        var hello = handshakeMessage(1, body)
        if let session {
            TlsClientConnection.bind(&hello, session, after: [])
        }
        return hello
    }

    static fn isAddress(_ host: String) -> Bool {
        for c in host.utf8 {
            if c == 0x3A {
                return true
            }
            if !(c == 0x2E || (c >= 0x30 && c <= 0x39)) {
                return false
            }
        }
        return true
    }
}

fn appendExtension(_ bytes: inout U8[>..], _ type: Int, _ data: U8[:]) {
    appendNumber(&bytes, type, 2)
    appendVector(&bytes, data, 2)
}

/// psk_key_exchange_modes of psk_dhe_ke, and pre_shared_key — the last
/// extension — offering the session, its binder zeros to be written over.
fn appendPreSharedKey(_ extensions: inout U8[>..], _ session: TlsSession, at time: UtcDateTime) {
    appendExtension(&extensions, 45, [1, 1])
    var identity: U8[>..] = []
    appendVector(&identity, session.ticket, 2)
    appendNumber(&identity, session.obfuscatedAge(at: time), 4)
    var data: U8[>..] = []
    appendVector(&data, identity, 2)
    var binder: U8[>..] = []
    appendVector(&binder, U8[>..](repeating: 0, count: session.cipherSuite.hashAlgorithm.digestByteCount), 1)
    appendVector(&data, binder, 2)
    appendExtension(&extensions, 41, data)
}

/// A plaintext record of the type, of TLS 1.2's version on the wire, or of
/// TLS 1.0's, as a client's first ClientHello may be (RFC 8446 §5.1).
fn appendRecord(_ bytes: inout U8[>..], _ type: Int, _ content: U8[:], legacyVersion: Bool = false) {
    bytes.append(contentsOf: [U8(type), 3, legacyVersion ? U8(1) : U8(3)])
    appendVector(&bytes, content, 2)
}

/// Where a client's handshake is.
enum ClientState: Sendable {
    WaitServerHello
    WaitEncryptedExtensions
    WaitCertificate
    WaitCertificateVerify
    WaitFinished
    Connected
}
