module PlatformTests

// Platform's run-time answers (Sable.Core), against the compile-time
// constants and the machine's own sense; OperatingSystemVersion's reading
// of each system's version text; and MemoryStatistics.

import Sable.Testing

@test
fn theRunTimeAnswersAgreeWithTheConstants() {
    assertEqual(Platform.operatingSystem.name, Platform.os)
    assertEqual(Platform.architecture.name, Platform.arch)
    expect(Platform.operatingSystem == .MacOS || Platform.operatingSystem == .Linux || Platform.operatingSystem == .Windows || Platform.operatingSystem == .Wasi)
    expect(Platform.is64Bit == (Platform.pointerWidth == 64))
    assertEqual(Platform.newline, Platform.operatingSystem == .Windows ? "\r\n" : "\n")
}

@test
fn theMachineIsDescribed() {
    expect(Platform.processorCount >= 1)
    let page = Platform.pageSize
    expect(page >= 4096 && (page & (page - 1)) == 0, "page size \(page)")
    expect(Platform.physicalMemory > 1 << 20)
    expect(!Platform.hostName.isEmpty)
    expect(!Platform.userName.isEmpty)
    let version = Platform.osVersion
    expect(version.major > 0, "version \(version.text)")
    expect(!version.text.isEmpty)
}

@test
fn versionsAreAtLeastOnTheirOwnSystemAlone() {
    let here = Platform.operatingSystem
    let version = Platform.osVersion
    expect(Platform.isAtLeast(here, version.major, version.minor, version.patch))
    expect(Platform.isAtLeast(here, version.major))
    expect(!Platform.isAtLeast(here, version.major + 1))
    let elsewhere: OperatingSystem = here == .Linux ? .Windows : .Linux
    expect(!Platform.isAtLeast(elsewhere, 0))
    expect(Platform.isAtLeast(macOS: 1) == (here == .MacOS))
    expect(!Platform.isAtLeast(macOS: 999))
    expect(Platform.isAtLeast(windows: 1) == (here == .Windows))
    expect(!Platform.isAtLeast(windows: 10, 0, build: 999999))
}

@test(arguments: [
    ("15.2", 15, 2, 0), ("6.8.0-45-generic", 6, 8, 0), ("10.0.22631", 10, 0, 22631), ("", 0, 0, 0), ("7", 7, 0, 0),
    ("1.2.3.4", 1, 2, 3)
])
fn eachSystemsVersionTextIsRead(_ text: String, _ major: Int, _ minor: Int, _ patch: Int) {
    let version = OperatingSystemVersion.parse(text)
    expect(version.major == major && version.minor == minor && version.patch == patch)
    expect(version.text == text)
    expect(version.debugDescription() == "\(major).\(minor).\(patch)")
}

@test
fn versionsCompareByTheirNumbers() {
    expect(OperatingSystemVersion.parse("15.2") > OperatingSystemVersion.parse("14.7.1"))
    expect(OperatingSystemVersion.parse("15.2") < OperatingSystemVersion.parse("15.10"))
    expect(OperatingSystemVersion.parse("15.2.1") > OperatingSystemVersion.parse("15.2"))
    expect(OperatingSystemVersion.parse("15.2") == OperatingSystemVersion.parse("15.2.0"))
}

@test(arguments: [(.MacOS, "macos"), (.Linux, "linux"), (.Windows, "windows"), (.Wasi, "wasi")])
fn systemsHaveTheirIfNames(_ system: OperatingSystem, _ name: String) {
    expect(system.name == name)
}

@test(arguments: [(.Arm64, "arm64"), (.X86_64, "x86_64"), (.Wasm32, "wasm32")])
fn architecturesHaveTheirIfNames(_ architecture: Architecture, _ name: String) {
    expect(architecture.name == name)
}

@test
fn systemsAndArchitecturesAreEqualAndHashAsThemselves() {
    expect(OperatingSystem.MacOS != OperatingSystem.Linux)
    assertEqual(Architecture.Arm64.hashValue, Architecture.Arm64.hashValue)
}

@test
fn memoryStatisticsCountWhatIsMade() {
    let before = MemoryStatistics.current()
    var made: String[>..] = []
    var i = 0
    while i < 10 {
        made.append("item \(i)")
        i += 1
    }
    let after = MemoryStatistics.current()
    expect(after.allocations >= before.allocations + 10, "\(before.allocations) then \(after.allocations)")
    expect(after.liveObjects > 0)
    expect(after.retains >= 0 && after.releases >= 0)
    expect(after.slabsHeld >= 0 && after.slabsMost >= after.slabsHeld && after.slabsReturned >= 0)
    assertEqual(made.count, 10)
}
