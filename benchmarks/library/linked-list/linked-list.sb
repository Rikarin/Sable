module LinkedListBench

import Sable.Collections
import Sable.Testing

// LinkedList<Int>: half a million appended, gone through ten times, and
// two million moved from the front to the back.

fn run() -> String {
    var list = LinkedList<Int>()
    for i in 0..<500000 {
        list.append(i)
    }
    var total = 0
    for _ in 0..<10 {
        for value in list {
            total += value
        }
    }
    for _ in 0..<2000000 {
        let value = list.removeFirst()!
        total += value
        list.append(value)
    }
    return "\(list.count) \(total)"
}

@bench
fn measure(_ b: Bencher) {
    b.check(b.iterate { run() })
}
