module Sha3_256Tests

// Sha3_256 (Sable.Crypto): the standard's messages, every length around
// the blocks' ends, and every way of cutting a message in two. Run with
//     tools/stdlib-coverage.sh Sable.Crypto

import CryptoSupport
import Sable.Crypto
import Sable.Testing

let published: Published[>..] = [
    Published("", "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a"),
    Published("abc", "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"),
    Published("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", "41c0dba2a9d6240849100376a8235e2c82e1b9998a999e21db32dd97496d3376"),
    Published(millionTimesADigest: "5c8875ae474a3634ba4fd55ec85bffd661f32aca75c6d699d0cdcb6c115891c1"),
]

@test(arguments: published)
fn thePublishedMessagesHaveTheirDigests(_ one: Published) {
    expect("\(Sha3_256.hash(one.message))" == one.digest)
    if let text = one.text {
        expect("\(Sha3_256.hash(utf8: text))" == one.digest)
    }
}

// Every length to past three blocks, its digest among those hashed here;
// the digest of them all from Python's hashlib.
@test
fn everyLengthHasItsDigest() {
    var all = Sha3_256()
    var count = 0
    while count < 410 {
        all.update(Sha3_256.hash(message(count)).bytes)
        count += 1
    }
    assertEqual("\(all.finalize())", "7ad98b641bb94598f1425250a8dee32762b88943c26a6fc2b1058aa3794a7087")
}

@test
fn aMessageInTwoPartsIsTheWholeWhereverItIsCut() {
    let whole = message(277)
    let expected = Sha3_256.hash(whole)
    var cut = 0
    while cut <= whole.count {
        var hash = Sha3_256()
        hash.update(whole[..<cut])
        hash.update(whole[cut...])
        assertEqual(hash.finalize(), expected)
        cut += 1
    }
}

@test
fn aMessageAByteAtATimeIsTheWhole() {
    let whole = message(277)
    var hash = Sha3_256()
    for byte in whole {
        hash.update([byte])
        hash.update([])
    }
    expect(hash.finalize() == Sha3_256.hash(whole))
}

@test
fn finalizingLeavesTheFunctionToGoOn() {
    let whole = message(145)
    var hash = Sha3_256()
    hash.update(whole[..<136])
    expect(hash.finalize() == Sha3_256.hash(whole[..<136]))
    expect(hash.finalize() == Sha3_256.hash(whole[..<136]))
    hash.update(whole[136...])
    expect(hash.finalize() == Sha3_256.hash(whole))
}

@test
fn aCopyHashesOnByItself() {
    let whole = message(145)
    var first = Sha3_256()
    first.update(whole[..<7])
    var second = first
    first.update(whole[7...])
    second.update(whole[..<3])
    expect(first.finalize() == Sha3_256.hash(whole))
    expect(second.finalize() == Sha3_256.hash(joined(message(7), message(3))))
}

@test
fn itsSizesAreTheStandards() {
    assertEqual(Sha3_256.digestByteCount, 32)
    assertEqual(Sha3_256.blockByteCount, 136)
    assertEqual(Sha3_256.hash(message(3)).count, 32)
}
