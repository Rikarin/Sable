module StringReplaceBench

import Sable.Testing

// Replacing text in text: a word by a longer one and a shorter one,
// throughout a megabyte, twenty times.

fn run(_ text: String) -> String {
    var total = 0
    for _ in 0..<20 {
        total += text.replacing("the", with: "every").count
        total += text.replacing(" on ", with: " ").count
    }
    return "\(total)"
}

@bench
fn measure(_ b: Bencher) {
    let text = "the cat sat on the mat and the dog lay on the rug; ".repeated(20000)
    b.check(b.iterate { run(text) })
}
