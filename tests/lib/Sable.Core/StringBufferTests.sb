module StringBufferTests

// StringBuffer and StringWriter (Sable.Core): strings written in place.

import Sable.Testing

@test
fn aBufferBecomesTheBytesWrittenToIt() {
    unsafe {
        let buffer = StringBuffer.allocate(capacity: 16)
        buffer.store(word: 0x216F_6C6C_6568, at: 0)
        buffer.store(utf8: "héllo", from: 1, to: 3, at: 6)
        buffer.store(byte: 0x2E, at: 8)
        assertEqual(buffer.load(at: 0), 0x68)
        let text = buffer.finish(count: 9)
        assertEqual(text, "hello!é.")
        assertEqual(text.count, 8)
    }
}

@test
fn aBufferMostlyUnusedIsTheSameText() {
    unsafe {
        let buffer = StringBuffer.allocate(capacity: 1000)
        buffer.store(utf8: "abc", from: 0, to: 3, at: 0)
        assertEqual(buffer.finish(count: 3), "abc")
        StringBuffer.allocate(capacity: 10).discard()
        assertEqual(StringBuffer.allocate(capacity: 0).finish(count: 0), "")
        let ascii = StringBuffer.allocate(capacity: 4)
        ascii.store(utf8: "wxyz", from: 0, to: 4, at: 0)
        assertEqual(ascii.finish(asciiCount: 4), "wxyz")
    }
}

@test
fn onlyWellFormedBytesFinishIfValid() {
    unsafe {
        let good = StringBuffer.allocate(capacity: 8)
        good.store(utf8: "é!", from: 0, to: 3, at: 0)
        assertEqual(good.finishIfValid(count: 3), "é!")
        let bad = StringBuffer.allocate(capacity: 8)
        bad.store(byte: 0xC3, at: 0)
        bad.store(byte: 0x21, at: 1)
        assert(bad.finishIfValid(count: 2) == none)
    }
}

@test
fn aWriterGrowsAsItMust() {
    unsafe {
        var writer = StringWriter.allocate(capacity: 0)
        var expected = ""
        for i in 0..<300 {
            writer.append(byte: 0x61)
            writer.append(codePoint: 0xE9)
            writer.append(codePoint: 0x4E16)
            writer.append(codePoint: 0x1F600)
            writer.append(word: 0x6463_62, length: 3)
            writer.append(utf8: "xyzé", from: 0, to: 5)
            writer.append(utf8: "a long text that is not a word", from: 2, to: 11)
            expected = expected + "aé世😀bcdxyzé" + "long text"
            assertEqual(writer.count, expected.utf8Count)
            if i == 0 {
                assertEqual(writer.byte(at: 0), 0x61)
            }
        }
        assertEqual(writer.finish(), expected)
    }
}

@test
fn aWritersLastScalarsAreTakenBack() {
    unsafe {
        var writer = StringWriter.allocate(capacity: 4)
        writer.reserveCapacity(100)
        assert(writer.capacity >= 100)
        for code in [0x41, 0xE9, 0x4E16, 0x1F600] {
            writer.append(codePoint: code)
        }
        assertEqual(writer.removeLastScalar(), 0x1F600)
        assertEqual(writer.removeLastScalar(), 0x4E16)
        assertEqual(writer.removeLastScalar(), 0xE9)
        assertEqual(writer.removeLastScalar(), 0x41)
        assert(writer.removeLastScalar() == none)
        writer.append(utf8: "abc", from: 0, to: 3)
        writer.truncate(to: 1)
        assertEqual(writer.finish(), "a")
    }
}

