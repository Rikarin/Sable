module Sable.Testing

import Sable.Text
import Sable.Collections

// '@test' and '@bench' (docs/05 §5.1): the assertions a test is written
// with, and the harnesses 'sable test' and 'sable bench' build around the
// functions so marked. The compiler writes the entry point — a table of the
// marked functions handed to 'runTests' or 'runBenchmarks' — and the rest is
// here, in Sable.
//
// A failed assertion ends its test with a trap. The test harness runs tests
// in processes of their own (the harness binary again, 'TestHarness.sb'), so
// a trap — an assertion's, or an index out of range — fails that test and
// no other.

/// One '@test' function, as the compiler's entry point lists it; or one
/// case of a '@test(arguments:)' function, which it makes a test each of.
public struct TestCase {
    /// Qualified: 'Module.function'.
    public var name: String
    /// Where it is declared, 'file:line'.
    public var location: String
    /// Runs it, awaiting it if it is async; what it throws fails it, but for
    /// a TestSkip, which skips it.
    public var run: async (FixtureScope) throws -> Void
    /// '@test(traps)': none for a test that must not trap; for one that
    /// must, what the trap's message must contain ("" for any trap).
    public var traps: String?
    /// '@test(tags:)' and its suite's: what a filter may ask for it by.
    public var tags: String[>..]
    /// '@test(timeout:)': how long it may run, in nanoseconds; 0 for as
    /// long as it takes.
    public var timeLimit: Int
    /// '@test(arguments:)': its cases, worked out when asked; none for a
    /// test that is one.
    public var cases: (() -> TestArguments[>..])?
    /// The type it is a test of, or its module: what shares a PerSuite fixture.
    public var suite: String
    /// '@suite(collection:)' or '@test(collection:)': tests of one are not
    /// run at once. Empty for none.
    public var collection: String
    /// '@suite(serialized)': not run while another test of the suite so
    /// marked is.
    public var isSerialized: Bool
    /// '@test(explicit)': run only when it is asked for.
    public var isExplicit: Bool
    /// '@test(retry:)': how many more times it is tried while it fails.
    public var retries: Int
    /// '@test(skip:)': why it is not to be run, or none when it is.
    public var skips: (() -> String?)?
    /// How long each fixture it is made with lives, worked out when asked.
    public var fixtures: (() -> FixtureLifetime[>..])?

    public init(name: String, location: String, run: @escaping async (FixtureScope) throws -> Void, traps: String? = none, tags: String[>..] = [], timeLimit: Int = 0,
        cases: (() -> TestArguments[>..])? = none, suite: String = "", collection: String = "", isSerialized: Bool = false, isExplicit: Bool = false, retries: Int = 0,
        skips: (() -> String?)? = none, fixtures: (() -> FixtureLifetime[>..])? = none) {
        self.name = name
        self.location = location
        self.run = run
        self.traps = traps
        self.tags = tags
        self.timeLimit = timeLimit
        self.cases = cases
        self.suite = suite
        self.collection = collection
        self.isSerialized = isSerialized
        self.isExplicit = isExplicit
        self.retries = retries
        self.skips = skips
        self.fixtures = fixtures
    }
}

/// One case of a '@test(arguments:)' test: the arguments, written out, and
/// the test run with them.
public struct TestArguments {
    public var description: String
    public var run: async (FixtureScope) throws -> Void

    public init(_ description: String, _ run: @escaping async (FixtureScope) throws -> Void) {
        self.description = description
        self.run = run
    }
}

/// What a test's argument is called in its case's name.
public fn describeArgument<T>(_ value: T) -> String {
    return "\(value:?)"
}

extension TestCase {
    /// The test's cases, each a test named after it and its arguments —
    /// 'Suite.parses("1.5", 1.5)' — or the test itself, when it takes none.
    /// Two cases of the same name are told apart by a number.
    ///
    /// ```sable
    /// let cases: () -> TestArguments[>..] = () => [
    ///     TestArguments("1", { scope in }),
    ///     TestArguments("1", { scope in }),
    ///     TestArguments("a\nb", { scope in }),
    /// ]
    /// let test = TestCase(name: "S.t", location: "s.sb:1", run: { scope in }, cases: cases)
    /// assert(test.expanded().map({ $0.name }) == ["S.t(1)", "S.t(1)#2", "S.t(a b)"])
    /// ```
    public fn expanded() -> TestCase[>..] {
        guard let cases = cases else {
            return [self]
        }
        let test = name
        Runtime.setTrapHook({ message, site, frames in
            Runtime.writeError("fatal error: \(message)\n\(site.isEmpty ? "" : "  at \(site)\n")  working out the arguments of \(test)\n")
        })
        let all = cases()
        _ = Runtime.takeTrapHook(otherwise: { message, site, frames in })
        var seen = Dictionary<String, Int>()
        var expanded: TestCase[>..] = []
        for arguments in all {
            var one = self
            one.cases = none
            one.run = arguments.run
            one.name = "\(name)(\(nameable(arguments.description)))"
            let times = (seen[one.name] ?? 0) + 1
            seen[one.name] = times
            if times > 1 {
                one.name = "\(one.name)#\(times)"
            }
            expanded.append(one)
        }
        return expanded
    }

    /// The '@test' function's name, of it or of one of its cases.
    var function: String {
        get {
            if let parenthesis = name.firstIndex(of: '(') {
                return name[..<parenthesis].toString()
            }
            return name
        }
    }

    /// The tests it is run in one process with, one after another: those it
    /// shares a fixture with, and the cases of its suite's functions, which
    /// are many and short. None for a test that has a process to itself, as one that
    /// must trap has to.
    ///
    /// ```sable
    /// let test = TestCase(name: "S.t", location: "s.sb:1", run: { scope in }, suite: "S", fixtures: { [.PerTest, .PerSuite] })
    /// assert(test.group == "suite S")
    /// ```
    public var group: String? {
        get {
            if traps != none {
                return none
            }
            var longest = FixtureLifetime.PerTest
            if let fixtures = fixtures {
                for lifetime in fixtures() {
                    if lifetime.outlives(longest) {
                        longest = lifetime
                    }
                }
            }
            return match longest {
                case .PerPackage    => "package"
                case .PerCollection => "collection \(fixtureCollection)"
                case .PerSuite      => "suite \(suite)"
                case .PerTest       => name == function ? none : "cases \(suite)"
            }
        }
    }

    /// The tests it is not run at the same time as: none for a test run
    /// whenever there is room.
    public var serial: String? {
        get {
            if !collection.isEmpty {
                return "collection \(collection)"
            }
            return isSerialized ? "suite \(suite)" : none
        }
    }

    // What shares its PerCollection fixtures: its suite, in no collection.
    var fixtureCollection: String => collection.isEmpty ? suite : collection
}

// A name on one line, and not a long one: an argument's description is its
// value's, which may be neither.
fn nameable(_ description: String) -> String {
    let name = TextBuilder()
    var count = 0
    for c in description {
        if count == 120 {
            name.append("…")
            break
        }
        name.append(String.fromChar(c < ' ' || c == '\u{7F}' ? ' ' : c))
        count += 1
    }
    return name.build()
}
