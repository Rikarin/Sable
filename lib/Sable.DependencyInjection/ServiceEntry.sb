module Sable.DependencyInjection

import Sable.Concurrency

// A registration as a provider has it. A service is kept as an 'any Any',
// and given as the type it is asked for, which may be one that only the
// running program knows: a generic type's, closed as it is asked for.
@immutable
final class ServiceEntry {
    let key: ServiceKey
    let lifetime: ServiceLifetime
    let dependencies: ServiceDependency[>..]
    // Which it is of the provider's.
    let slot: Int
    // Where a scope keeps its own, for a scoped one.
    let place: Int
    // Where its links start, of the provider's, and how many places it has there.
    let firstLink: Int
    let linkCount: Int
    // Whether what it makes is the provider's to dispose.
    let owned: Bool
    let maker: ServiceMaker
    // Whether it is made as the provider is built.
    let eager: Bool
    // A singleton's, once made.
    let cell: OnceCell<any Any>
    let making: Mutex<Bool>
    // The type of what it made first, when there is nothing to dispose of one.
    let plain: OnceCell<Type>

    init(key: ServiceKey, lifetime: ServiceLifetime, dependencies: ServiceDependency[>..], slot: Int, place: Int, firstLink: Int, owned: Bool, maker: ServiceMaker, eager: Bool = false) {
        self.key = key
        self.lifetime = lifetime
        self.dependencies = dependencies
        self.slot = slot
        self.place = place
        self.firstLink = firstLink
        linkCount = firstLink < 0 ? 0 : dependencies.count
        self.owned = owned
        self.maker = maker
        self.eager = eager
        cell = OnceCell<any Any>()
        making = Mutex(false)
        plain = OnceCell<Type>()
    }

    fn value(in scope: ServiceScope) throws(ServiceError) -> any Any {
        match lifetime {
            case .Singleton => {
                if let made = cell.get() {
                    return made
                }
                return try single(scope)
            }
            case .Scoped => {
                if scope.isRoot {
                    throw scope.scopedFromRoot(self)
                }
                if place < scope.kept.count {
                    if let held = scope.kept[place] {
                        return held
                    }
                }
                let made = try build(scope)
                scope.keep(made, at: place)
                return made
            }
            case .Transient => {
                return try build(scope)
            }
        }
    }

    // Made once, whoever asks: the others wait. What it is made from is the
    // provider's, not the scope's that asked first.
    fn single(_ scope: ServiceScope) throws(ServiceError) -> any Any {
        if maker.start != none {
            throw ServiceError.NotStarted(service: key)
        }
        // Being made by whom this one is made for: to wait would be for ever.
        if scope.isMaking(self) {
            throw ServiceError.Circular(path: scope.path(to: key))
        }
        let root = ServiceScope(root: scope)
        return try making.withLock { (_done: inout Bool) throws(ServiceError) -> any Any in
            if let made = cell.get() {
                return made
            }
            let made = try build(root)
            return cell.getOrInit { made }
        }
    }

    fn isPlain(_ type: Type) -> Bool {
        if let known = plain.get() {
            if known == type {
                return true
            }
        }
        if type.isSubtype(of: (any Disposable).self) || type.isSubtype(of: (any AsyncDisposable).self) {
            return false
        }
        _ = plain.getOrInit { type }
        return true
    }

    fn build(_ scope: ServiceScope) throws(ServiceError) -> any Any {
        try scope.begin(self)
        do {
            let made = try maker.make(scope)
            scope.finish()
            if owned && !isPlain(type(of: made)) {
                scope.note(made)
            }
            return made
        } catch {
            scope.finish()
            throw error as? ServiceError ?? ServiceError.Failed(service: key, error: error)
        }
    }

    // Made as its provider is built, by a closure that waits.
    async fn begin(_ start: async (ServiceScope) throws -> any Any, in scope: ServiceScope) throws(ServiceError) {
        try scope.begin(self)
        do {
            let made = try await start(scope)
            scope.finish()
            if owned && !isPlain(type(of: made)) {
                scope.note(made)
            }
            _ = cell.getOrInit { made }
        } catch {
            scope.finish()
            throw error as? ServiceError ?? ServiceError.Failed(service: key, error: error)
        }
    }
}
