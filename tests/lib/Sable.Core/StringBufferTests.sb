@test(traps: "string index out of range")
fn eightBytesOfAShorterStringStop() {
    let word = "short".utf8.readU64(at: 0, endian: .Little)
    print(word)
}

@test(traps: "string index out of range")
fn eightBytesFromBeforeAStringStop() {
    let word = "long enough".utf8.readU64(at: -1, endian: .Little)
    print(word)
}

@test
fn aStringsBytesAreReadEightAtATime() {
    let text = "0123456789"
    assertEqual(text.utf8.readU64(at: 0, endian: .Big), 0x3031_3233_3435_3637)
    assertEqual(text.utf8.readU64(at: 2, endian: .Little), 0x3938_3736_3534_3332)
}

// Each scalar's own mapping, joined: what a string's, made another way, must be.
fn mapped(_ text: String, _ map: (Char) -> String) -> String {
    var parts: String[>..] = []
    for c in text {
        parts.append(map(c))
    }
    return parts.joined()
}

@test
fn aStringsCaseIsItsScalars() {
    var run = ""
    var code = 1
    while code < 0x1F000 {
        guard let c = Char.fromCodePoint(code) else {
            code += 1
            continue
        }
        // A capital sigma's is where it is in its word.
        if code != 0x3A3 && (c.simpleUppercase != c || c.simpleLowercase != c || c.uppercased() != "\(c)" || code % 61 == 0) {
            let alone = "\(c)"
            assertEqual(alone.uppercased(), c.uppercased())
            assertEqual(alone.lowercased(), c.lowercased())
            run = run + alone + (code % 3 == 0 ? "aB" : "")
            if run.utf8Count > 40 {
                assertEqual(run.uppercased(), mapped(run) { $0.uppercased() })
                assertEqual(run.lowercased(), mapped(run) { $0.lowercased() })
                let folded = mapped(run) { "\($0)".caseFolded() }
                assertEqual(run.caseFolded(), folded)
                run = ""
            }
        }
        code += 1
    }
}

@test
fn asciiCaseIsTheSameAtEveryLength() {
    for n in 0..<200 {
        var lower = ""
        var upper = ""
        for i in 0..<n {
            let letter = 0x40 + (i * 7 + n) % 0x40
            let c = Char.fromCodePoint(letter)!
            let isLetter = c.asciiUppercased() != c || c.asciiLowercased() != c
            lower = lower + (isLetter ? "\(c.asciiLowercased())" : "\(c)")
            upper = upper + (isLetter ? "\(c.asciiUppercased())" : "\(c)")
        }
        assertEqual(upper.asciiLowercased(), lower)
        assertEqual(lower.uppercased(), upper)
        assertEqual(lower.lowercased(), lower)
        assertEqual((lower + "é").uppercased(), upper + "É")
        assertEqual(("ß" + lower).uppercased(), "SS" + upper)
    }
}

