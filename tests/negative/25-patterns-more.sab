    match s {
        case 1..<5 => { }               //! S6000 //! S6000
        default => { }
    }
}

fn aTuplePatternArityIsChecked(_ pair: (Int, Int)) {
    match pair {
        case (let a, let b, let c) => { }   //! S6000
        default => { }                  //! S6006
    }
}

fn aRecordPatternFieldMustExist(_ p: Point) {
    match p {
        case Point { z: let n } => { }  //! S2002 has no field named 'z'
        default => { }
    }
}

fn aRecordPatternFieldTypeIsChecked(_ p: Point) {
    match p {
        case Point { x: "text" } => { } //! S6000
        default => { }
    }
