module TaskSpawnBench

import Sable.Testing

// Tasks: a hundred batches of two thousand spawned, each awaited.

fn run() async -> String {
    var total = 0
    for batch in 0..<100 {
        var tasks: Task<Int>[>..] = []
        for i in 0..<2000 {
            tasks.append(Task.spawn { i + batch })
        }
        for task in tasks {
            total += await task.value
        }
    }
    return "\(total)"
}

@bench
fn measure(_ b: Bencher) async {
    b.check(await b.iterateAsync { await run() })
}
