module Sable.Crypto

// What Sable.Crypto keeps keys and hash states in, and what it asks of the
// compiler and the runtime: raw memory, so that a compression function of
// the runtime's can be given its address and so that nothing copies it
// unasked, zeroed before it is freed.

/// The runtime's part (runtime/crypto.c).
struct Native {
    /// SHA-256's blocks, of 64 bytes, and a state of eight U32s.
    static var sha256: Int => 1

    /// SHA-512's blocks, of 128 bytes, and a state of eight U64s.
    static var sha512: Int => 2

    /// A sponge's blocks, of its rate in bytes, each absorbed into a state
    /// of 25 U64s and permuted.
    static fn keccak(rate: Int) -> Int => 3 | rate << 8

    /// SHA-1's blocks, of 64 bytes, and a state of five U32s.
    static var sha1: Int => 4

    /// Whole blocks worked into the state at an address by the processor's
    /// own instructions; false, with nothing done, when it has none for it
    /// (or this is the interpreter), and the portable code is to be run.
    @builtin("crypto_blocks")
    unsafe static fn blocks(_ kind: Int, _ state: Int, _ bytes: U8[:]) -> Bool

    /// The same for so many bytes at an address.
    @builtin("crypto_blocks_raw")
    unsafe static fn blocks(_ kind: Int, _ state: Int, at address: Int, count: Int) -> Bool

    /// The value, unchanged, through a register the optimiser cannot see
    /// into: what keeps a mask made of a secret bit from becoming a branch.
    @builtin("value_barrier")
    static fn barrier(_ value: U64) -> U64

    /// Bytes at an address set to zero whether or not anything reads them after.
    @builtin("raw_secure_zero")
    unsafe static fn zero(_ address: Int, _ count: Int)

    /// Bytes at an address filled from the system's random source.
    @builtin("raw_random")
    unsafe static fn random(_ address: Int, _ count: Int)
}

extension U8[:] {
    @builtin("bytes_secure_zero")
    mutating fn zeroSlice()

    @builtin("bytes_random")
    mutating fn randomiseSlice()

    /// Every byte set to zero, whether or not anything reads them after. On
    /// an array it is the array's own bytes, in place.
    mutating fn zeroSecurely() {
        self.zeroSlice()
    }

    /// Every byte one from the system's random source.
    mutating fn fillRandomly() {
        self.randomiseSlice()
    }
}

/// Secret memory as a value: what copies the memory before it is changed,
/// when something else holds it too.
struct SecretBox: Sendable {
    var memory: SecretMemory

    /// Whether this holds the only reference to the memory.
    @builtin("ref_is_unique")
    mutating fn isUnique() -> Bool

    /// The memory's address, to change it at: this then holds the only
    /// reference to it.
    mutating fn mutableAddress() -> Int {
        if !self.isUnique() {
            memory = memory.copy()
        }
        return memory.address
    }
}

/// Bytes in memory of their own, zero at first, and zeroed again before they
/// are freed. Whoever holds one changes it only when nothing else does
/// (SecretBox), so a struct that holds one is a value; and shared,
/// nothing changes it, which is what '@immutable' says of it.
@immutable
final class SecretMemory {
    let address: Int
    let count: Int

    init(count: Int) {
        self.count = count
        unsafe {
            address = NativeMemory.allocate(byteCount: count, alignment: 16, zeroed: true).address
        }
    }

    /// The bytes, copied.
    init(_ bytes: U8[:]) {
        count = bytes.count
        unsafe {
            address = NativeMemory.allocate(byteCount: bytes.count, alignment: 16).address
            store(bytes, at: address)
        }
    }

    /// The same bytes, in memory of its own.
    init(copying other: SecretMemory) {
        count = other.count
        unsafe {
            address = NativeMemory.allocate(byteCount: other.count, alignment: 16).address
            NativeMemory.copy(from: RawPtr<U8>(address: other.address), to: RawPtr<U8>(address: address), byteCount: other.count)
        }
    }

    deinit {
        unsafe {
            Native.zero(address, count)
            NativeMemory.deallocate(RawPtr<U8>(address: address))
        }
    }

    /// Other memory holding the same bytes.
    fn copy() -> SecretMemory {
        return SecretMemory(copying: self)
    }

    /// So many bytes from an offset on, as an array, which nothing zeroes.
    fn bytes(from start: Int, count: Int) -> U8[>..] {
        precondition(start >= 0 && count >= 0 && start <= self.count - count, "\(count) bytes from \(start) of \(self.count)")
        var bytes: U8[>..] = []
        unsafe {
            appendBytes(to: &bytes, from: address + start, count: count)
        }
        return bytes
    }
}

/// The U32 at an address, aligned or not, as the machine orders it.
@inline(always)
unsafe fn load32(_ address: Int) -> U32 {
    return RawPtr<U8>(address: address).load(as: U32.self)
}

/// The U64 at an address, aligned or not, as the machine orders it.
@inline(always)
unsafe fn load64(_ address: Int) -> U64 {
    return RawPtr<U8>(address: address).load(as: U64.self)
}

@inline(always)
unsafe fn store32(_ value: U32, _ address: Int) {
    RawPtr<U8>(address: address).storeBytes(of: value)
}

@inline(always)
unsafe fn store64(_ value: U64, _ address: Int) {
    RawPtr<U8>(address: address).storeBytes(of: value)
}

@inline(always)
unsafe fn store8(_ value: U8, _ address: Int) {
    RawPtr<U8>(address: address).storeBytes(of: value)
}

/// The bytes written at an address, eight at a time.
unsafe fn store(_ bytes: U8[:], at address: Int) {
    let count = bytes.count
    var i = 0
    while i + 8 <= count {
        store64(bytes.readU64(at: i, endian: .native), address &+ i)
        i += 8
    }
    while i < count {
        store8(bytes[i], address &+ i)
        i += 1
    }
}

/// So many bytes at an address added at the end of the array.
unsafe fn appendBytes(to bytes: inout U8[>..], from address: Int, count: Int) {
    let start = bytes.count
    bytes.append(repeating: 0, count: count)
    var i = 0
    while i + 8 <= count {
        bytes.writeU64(load64(address &+ i), at: start + i, endian: .native)
        i += 8
    }
    while i < count {
        bytes[start + i] = RawPtr<U8>(address: address).load(at: i)
        i += 1
    }
}

/// Constants in memory of their own, which is never freed, for a compression
/// function to read unchecked: their address.
fn constantTable(_ values: U32[:]) -> Int {
    unsafe {
        let table = NativeMemory.allocate(byteCount: 4 * values.count).address
        var i = 0
        while i < values.count {
            store32(values[i], table &+ 4 &* i)
            i += 1
        }
        return table
    }
}

fn constantTable(_ values: U64[:]) -> Int {
    unsafe {
        let table = NativeMemory.allocate(byteCount: 8 * values.count).address
        var i = 0
        while i < values.count {
            store64(values[i], table &+ 8 &* i)
            i += 1
        }
        return table
    }
}
