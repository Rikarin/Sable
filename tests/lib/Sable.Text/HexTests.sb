module HexTests

// Hex (Sable.Text), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Testing
import Sable.Text

// The bytes are the ones expected; when not, both are shown in hexadecimal.
fn assertBytes(_ actual: U8[:], _ expected: U8[:]) {
    assert(actual == expected, "\(Hex.encode(actual)) is not \(Hex.encode(expected))")
}

fn decodeError(_ text: String) -> DecodeError? {
    do {
        let _ = try Hex.decode(text)
    } catch {
        return error
    }
    return none
}

@test
fn theRfc4648Base16TestVectors() {
    assertEqual(Hex.encode("".utf8Bytes(), uppercase: true), "")
    assertEqual(Hex.encode("f".utf8Bytes(), uppercase: true), "66")
    assertEqual(Hex.encode("fo".utf8Bytes(), uppercase: true), "666F")
    assertEqual(Hex.encode("foo".utf8Bytes(), uppercase: true), "666F6F")
    assertEqual(Hex.encode("foob".utf8Bytes(), uppercase: true), "666F6F62")
    assertEqual(Hex.encode("fooba".utf8Bytes(), uppercase: true), "666F6F6261")
    assertEqual(Hex.encode("foobar".utf8Bytes(), uppercase: true), "666F6F626172")
    assertBytes(try! Hex.decode("666F6F626172"), "foobar".utf8Bytes())
    assertBytes(try! Hex.decode(""), [])
}

@test
fn everyByteValueRoundTripsInEitherCase() {
    var bytes: U8[>..] = []
    var value = 0
    while value < 256 {
        bytes.append(U8(value))
        value += 1
    }
    let lower = Hex.encode(bytes)
    let upper = Hex.encode(bytes, uppercase: true)
    assertEqual(lower.utf8Count, 512)
    assert(lower.hasPrefix("000102") && lower.hasSuffix("fdfeff"), "two lower-case digits a byte, high first")
    assertEqual(upper, lower.uppercased())
    assertBytes(try! Hex.decode(lower), bytes)
    assertBytes(try! Hex.decode(upper), bytes)
}

@test
fn encodingIntoABufferAppendsTheDigits() {
    var buffer = ByteBuffer()
    let bytes: U8[>..] = [0x0A, 0xBC]
    Hex.encode(bytes, into: &buffer)
    Hex.encode(bytes, into: &buffer, uppercase: true)
    assertBytes(buffer.bytes, "0abc0ABC".utf8Bytes())
}

@test
fn decodingBytesAndSubstrings() {
    assertBytes(try! Hex.decode(bytes: "c0ffee".utf8Bytes()), [0xC0, 0xFF, 0xEE])
    let text = "0x7f"
    assertBytes(try! Hex.decode(text[text.index(text.startIndex, offsetBy: 2)...]), [0x7F])
}

@test
fn aNonDigitIsNamedWithItsOffset() {
    assertEqual(decodeError("0g"), .InvalidCharacter(at: 1, byte: 0x67))
    assertEqual(decodeError("g0"), .InvalidCharacter(at: 0, byte: 0x67))
    assertEqual(decodeError("0x7f"), .InvalidCharacter(at: 1, byte: 0x78))
    assertEqual(decodeError("00 11"), .InvalidCharacter(at: 2, byte: 0x20))
    assertEqual(decodeError("00="), .InvalidCharacter(at: 2, byte: 0x3D))
    assertEqual(decodeError("0="), .InvalidCharacter(at: 1, byte: 0x3D))
}

@test
fn anOddNumberOfDigitsIsTheWrongLength() {
    assertEqual(decodeError("a"), .InvalidLength(at: 0))
    assertEqual(decodeError("abc"), .InvalidLength(at: 2))
}

// ---- Against the definition, a digit at a time ---------------------------
// Every length from 0 to 130 and from several starts, so that each of the
// loops that take many at once, and what they leave, is held to it.

fn randomBytes(_ count: Int, _ seed: U64) -> U8[>..] {
    var random = SeededRandomNumberGenerator(seed: seed)
    var bytes: U8[>..] = []
    for _ in 0..<count {
        bytes.append(U8.random(in: 0...255, using: &random))
    }
    return bytes
}

fn plainHex(_ bytes: U8[:], _ digits: String) -> U8[>..] {
    let table = digits.utf8Bytes()
    var text: U8[>..] = []
    for byte in bytes {
        text.append(table[Int(byte) / 16])
        text.append(table[Int(byte) % 16])
    }
    return text
}

@test
fn everyLengthAndStartEncodesAsEachByteDoes() {
    let all = randomBytes(140, 229)
    for start in 0..<4 {
        for n in 0...130 {
            let bytes = all[start..<(start + n)]
            assertBytes(Hex.encode(bytes).utf8Bytes(), plainHex(bytes, "0123456789abcdef"))
            assertBytes(Hex.encode(bytes, uppercase: true).utf8Bytes(), plainHex(bytes, "0123456789ABCDEF"))
            // Digits outside the slice are not read: they would be decoded.
            var text: U8[>..] = [0x30, 0x31, 0x32]
            text.append(contentsOf: plainHex(bytes, n % 2 == 0 ? "0123456789abcdef" : "0123456789ABCDEF"))
            let end = text.count
            text.append(contentsOf: [0x66, 0x67, 0x68])
            assertBytes(try! Hex.decode(bytes: text[3..<end]), bytes)
            var buffer = ByteBuffer()
            buffer.write([0xAA])
            Hex.encode(bytes, into: &buffer)
            assertEqual(buffer.count, 2 * n + 1)
            assertBytes(buffer.bytes[1...], plainHex(bytes, "0123456789abcdef"))
        }
    }
}

@test
fn everyByteThatIsNoDigitIsFoundAtEveryPosition() {
    let digits = "0123456789abcdefABCDEF".utf8Bytes()
    for n in [2, 30, 32, 34, 64, 70, 96] as Int[>..] {
        var text = plainHex(randomBytes(n / 2, 7), "0123456789abcdef")
        for at in 0..<n {
            let held = text[at]
            for value in 0..<256 {
                text[at] = U8(value)
                var thrown: DecodeError? = none
                do {
                    let _ = try Hex.decode(bytes: text)
                } catch {
                    thrown = error
                }
                if digits.contains(U8(value)) {
                    assert(thrown == none)
                } else {
                    assert(thrown == .InvalidCharacter(at: at, byte: U8(value)))
                }
            }
            text[at] = held
        }
    }
}
