module Sable.Build

/// A package this one uses, and where it comes from.
public struct Dependency {
    var name: String
    var version: String?
    var path: String?
    var git: String?
    var tag: String?
    var branch: String?
    var rev: String?
    var optional: Bool
    var defaultFeatures: Bool
    var features: String[>..]
    var condition: Condition?

    /// A version from the registry: `"1.2"` means any 1.x from 1.2.
    public static fn registry(_ name: String, _ version: String, features: String[>..] = [], defaultFeatures: Bool = true,
        optional: Bool = false, when: Condition? = none) -> Dependency {
        return Dependency {
            name: name, version: version, path: none, git: none, tag: none, branch: none, rev: none,
            optional: optional, defaultFeatures: defaultFeatures, features: features, condition: when,
        }
    }

    /// A package in a directory, relative to this one; with a version, the
    /// one the registry has when this package is published.
    public static fn path(_ name: String, _ path: String, version: String? = none, features: String[>..] = [], defaultFeatures: Bool = true,
        optional: Bool = false, when: Condition? = none) -> Dependency {
        return Dependency {
            name: name, version: version, path: path, git: none, tag: none, branch: none, rev: none,
            optional: optional, defaultFeatures: defaultFeatures, features: features, condition: when,
        }
    }

    /// A package in a git repository: at a `tag`, the tip of a `branch`, or
    /// a `rev` (a commit) — one of them — else the default branch's tip. The
    /// lock file pins the commit; `sable update` moves it. With a version,
    /// the one the registry has when this package is published.
    public static fn git(_ name: String, _ url: String, tag: String? = none, branch: String? = none, rev: String? = none,
        version: String? = none, features: String[>..] = [], defaultFeatures: Bool = true,
        optional: Bool = false, when: Condition? = none) -> Dependency {
        return Dependency {
            name: name, version: version, path: none, git: url, tag: tag, branch: branch, rev: rev,
            optional: optional, defaultFeatures: defaultFeatures, features: features, condition: when,
        }
    }
}
