module Sable.Text

// The loops UTF-8 and UTF-16 are converted by: sixteen units at once while
// they are ASCII, which are one unit either way, and the scalars of a run of
// sixteen that is not one at a time. A destination is given its room first,
// the most the source could take, and what was not taken is let go after.

// The UTF-16 of the bytes, which are well-formed UTF-8, added at the end.
fn appendUtf16(ofValid bytes: U8[:], to units: inout U16[>..]) {
    let count = bytes.count
    var j = units.count
    // A byte is never more than one unit: a pair's sequence is four.
    units.append(repeating: 0, count: count)
    var i = 0
    while i < count {
        if count - i >= 16 {
            let v = SIMD<U8, 16>.load(from: bytes, at: i)
            if v.reduceMax() < 0x80 {
                units.store(SIMD<U16, 16>.converting(v), at: j)
                i += 16
                j += 16
                continue
            }
        }
        // The scalars that start in the next sixteen bytes.
        let end = count - i >= 16 ? i + 16 : count
        while i < end {
            let lead = U32(bytes[i])
            if lead < 0x80 {
                units[j] = lead unchecked as U16
                i += 1
                j += 1
            } else if lead < 0xE0 {
                units[j] = ((lead & 0x1F) << 6 | U32(bytes[i + 1]) & 0x3F) unchecked as U16
                i += 2
                j += 1
            } else if lead < 0xF0 {
                units[j] = ((lead & 0x0F) << 12 | (U32(bytes[i + 1]) & 0x3F) << 6 | U32(bytes[i + 2]) & 0x3F) unchecked as U16
                i += 3
                j += 1
            } else {
                let code = (lead & 0x07) << 18 | (U32(bytes[i + 1]) & 0x3F) << 12 | (U32(bytes[i + 2]) & 0x3F) << 6 | U32(bytes[i + 3]) & 0x3F
                let above = code &- 0x10000
                units[j + 1] = (0xDC00 | above & 0x3FF) unchecked as U16
                units[j] = (0xD800 | above >> 10) unchecked as U16
                i += 4
                j += 2
            }
        }
    }
    units.removeLast(units.count - j)
}

// The UTF-8 of the units from 'start', added at the end, as far as they are
// well-formed: where the first unit is that is not part of a scalar — a
// surrogate that begins or ends no pair, or begins one the units end in —
// or how many there are.
fn appendUtf8(ofUtf16 units: U16[:], from start: Int, to bytes: inout U8[>..]) -> Int {
    let count = units.count
    var i = start
    var block = 64
    while i < count {
        // Room for a run of the units at a time: at most three bytes a unit,
        // a pair's four being two's. The runs grow, so that a caller that
        // begins again after each of many ill-formed units asks for little.
        let blockEnd = count - i > block ? i + block : count
        block = block < 4096 ? block * 2 : block
        var j = bytes.count
        bytes.append(repeating: 0, count: 3 * (blockEnd - i) + 3)
        var stopped = false
        while i < blockEnd && !stopped {
            if blockEnd - i >= 16 {
                let v = SIMD<U16, 16>.load(from: units, at: i)
                if v.reduceMax() < 0x80 {
                    bytes.store(SIMD<U8, 16>.converting(v), at: j)
                    i += 16
                    j += 16
                    continue
                }
            }
            let end = blockEnd - i >= 16 ? i + 16 : blockEnd
            while i < end {
                let unit = U32(units[i])
                if unit < 0x80 {
                    bytes[j] = unit unchecked as U8
                    i += 1
                    j += 1
                } else if unit < 0x800 {
                    bytes[j + 1] = (0x80 | unit & 0x3F) unchecked as U8
                    bytes[j] = (0xC0 | unit >> 6) unchecked as U8
                    i += 1
                    j += 2
                } else if unit &- 0xD800 >= 0x800 {
                    bytes[j + 2] = (0x80 | unit & 0x3F) unchecked as U8
                    bytes[j + 1] = (0x80 | unit >> 6 & 0x3F) unchecked as U8
                    bytes[j] = (0xE0 | unit >> 12) unchecked as U8
                    i += 1
                    j += 3
                } else {
                    if unit >= 0xDC00 || i + 1 >= count || !Utf16.isTrailing(units[i + 1]) {
                        stopped = true
                        break
                    }
                    let code = 0x10000 + ((unit &- 0xD800) << 10 | (U32(units[i + 1]) &- 0xDC00))
                    bytes[j + 3] = (0x80 | code & 0x3F) unchecked as U8
                    bytes[j + 2] = (0x80 | code >> 6 & 0x3F) unchecked as U8
                    bytes[j + 1] = (0x80 | code >> 12 & 0x3F) unchecked as U8
                    bytes[j] = (0xF0 | code >> 18) unchecked as U8
                    i += 2
                    j += 4
                }
            }
        }
        bytes.removeLast(bytes.count - j)
        if stopped {
            return i
        }
    }
    return i
}
