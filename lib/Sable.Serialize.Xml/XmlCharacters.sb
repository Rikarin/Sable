module Sable.Serialize.Xml

// The characters of XML 1.0 (fifth edition): which a name may start with
// and hold, which a document may hold at all, and the text of bytes.

let xmlNamespaceXml = "http://www.w3.org/XML/1998/namespace"
let xmlNamespaceXmlns = "http://www.w3.org/2000/xmlns/"

// The code point of the UTF-8 sequence that starts there, and its length.
fn xmlWidth(_ lead: U8) -> Int {
    if lead < 0x80 {
        return 1
    }
    if lead < 0xE0 {
        return 2
    }
    return lead < 0xF0 ? 3 : 4
}

fn xmlCode(_ bytes: U8[>..], _ at: Int) -> Int {
    let lead = Int(bytes[at])
    if lead < 0x80 {
        return lead
    }
    if lead < 0xE0 {
        return (lead & 0x1F) << 6 | Int(bytes[at + 1]) & 0x3F
    }
    if lead < 0xF0 {
        return (lead & 0x0F) << 12 | (Int(bytes[at + 1]) & 0x3F) << 6 | Int(bytes[at + 2]) & 0x3F
    }
    return (lead & 0x07) << 18 | (Int(bytes[at + 1]) & 0x3F) << 12 | (Int(bytes[at + 2]) & 0x3F) << 6 | Int(bytes[at + 3]) & 0x3F
}

// Char (§2.2).
fn xmlIsChar(_ c: Int) -> Bool {
    if c < 0x20 {
        return c == 0x09 || c == 0x0A || c == 0x0D
    }
    return c <= 0xD7FF || c >= 0xE000 && c <= 0xFFFD || c >= 0x10000 && c <= 0x10FFFF
}

// NameStartChar and NameChar (§2.3), the colon among them.
fn xmlIsNameStart(_ c: Int) -> Bool {
    if c < 0x80 {
        return c >= 0x61 && c <= 0x7A || c >= 0x41 && c <= 0x5A || c == 0x5F || c == 0x3A
    }
    return c >= 0xC0 && c <= 0xD6 || c >= 0xD8 && c <= 0xF6 || c >= 0xF8 && c <= 0x2FF
        || c >= 0x370 && c <= 0x37D || c >= 0x37F && c <= 0x1FFF || c == 0x200C || c == 0x200D
        || c >= 0x2070 && c <= 0x218F || c >= 0x2C00 && c <= 0x2FEF || c >= 0x3001 && c <= 0xD7FF
        || c >= 0xF900 && c <= 0xFDCF || c >= 0xFDF0 && c <= 0xFFFD || c >= 0x10000 && c <= 0xEFFFF
}

fn xmlIsNameChar(_ c: Int) -> Bool {
    if c < 0x80 {
        return c >= 0x61 && c <= 0x7A || c >= 0x41 && c <= 0x5A || c >= 0x30 && c <= 0x39
            || c == 0x5F || c == 0x3A || c == 0x2D || c == 0x2E
    }
    return c == 0xB7 || c >= 0x300 && c <= 0x36F || c == 0x203F || c == 0x2040 || xmlIsNameStart(c)
}

fn xmlIsSpace(_ b: U8) -> Bool {
    return b == 0x20 || b == 0x0A || b == 0x09 || b == 0x0D
}

// Whether the text is a Name, and whether it is an NCName (one with no colon).
fn xmlIsName(_ text: String, colons: Bool) -> Bool {
    var bytes: U8[>..] = []
    bytes.append(utf8: text)
    if bytes.isEmpty {
        return false
    }
    var at = 0
    while at < bytes.count {
        let c = xmlCode(bytes, at)
        if at == 0 ? !xmlIsNameStart(c) : !xmlIsNameChar(c) {
            return false
        }
        if c == 0x3A && !colons {
            return false
        }
        at += xmlWidth(bytes[at])
    }
    return true
}

// Whether the name is a QName: NCName, or NCName ':' NCName.
fn xmlIsQName(_ name: String) -> Bool {
    let p = xmlPrefix(name)
    let local = xmlLocalName(name)
    return xmlIsName(local, colons: false) && (p.isEmpty ? !name.hasPrefix(":") : xmlIsName(p, colons: false))
}

fn xmlColon(_ name: String) -> Int {
    var i = 0
    for byte in name.utf8 {
        if byte == 0x3A {
            return i
        }
        i += 1
    }
    return -1
}

fn xmlSlice(_ text: String, _ from: Int, _ to: Int) -> String {
    var bytes: U8[>..] = []
    var i = 0
    for byte in text.utf8 {
        if i >= from && i < to {
            bytes.append(byte)
        }
        i += 1
    }
    return xmlString(bytes)
}

// The part of a name before its colon, or "".
fn xmlPrefix(_ name: String) -> String {
    let colon = xmlColon(name)
    return colon <= 0 ? "" : xmlSlice(name, 0, colon)
}

// The part of a name after its colon, or all of it.
fn xmlLocalName(_ name: String) -> String {
    let colon = xmlColon(name)
    return colon <= 0 ? name : xmlSlice(name, colon + 1, name.utf8Count)
}

fn xmlString(_ bytes: U8[:]) -> String {
    unsafe {
        return Runtime.stringFromValidUtf8(bytes)
    }
}

fn xmlAppend(_ code: Int, to bytes: inout U8[>..]) {
    if code < 0x80 {
        bytes.append(U8(code))
    } else if code < 0x800 {
        bytes.append(U8(0xC0 | code >> 6))
        bytes.append(U8(0x80 | code & 0x3F))
    } else if code < 0x10000 {
        bytes.append(U8(0xE0 | code >> 12))
        bytes.append(U8(0x80 | code >> 6 & 0x3F))
        bytes.append(U8(0x80 | code & 0x3F))
    } else {
        bytes.append(U8(0xF0 | code >> 18))
        bytes.append(U8(0x80 | code >> 12 & 0x3F))
        bytes.append(U8(0x80 | code >> 6 & 0x3F))
        bytes.append(U8(0x80 | code & 0x3F))
    }
}

fn xmlLower(_ text: String) -> String {
    var bytes: U8[>..] = []
    for byte in text.utf8 {
        bytes.append(byte >= 0x41 && byte <= 0x5A ? byte + 0x20 : byte)
    }
    return xmlString(bytes)
}

// Whether the bytes there are the word's.
fn xmlMatches(_ bytes: U8[>..], _ at: Int, _ word: U8[>..]) -> Bool {
    if at + word.count > bytes.count {
        return false
    }
    var i = 0
    while i < word.count {
        if bytes[at + i] != word[i] {
            return false
        }
        i += 1
    }
    return true
}

// The text without the white space at either end.
fn xmlTrimmed(_ text: String) -> String {
    var bytes: U8[>..] = []
    bytes.append(utf8: text)
    var start = 0
    var end = bytes.count
    while start < end && xmlIsSpace(bytes[start]) {
        start += 1
    }
    while end > start && xmlIsSpace(bytes[end - 1]) {
        end -= 1
    }
    return xmlString(bytes[start..<end])
}
