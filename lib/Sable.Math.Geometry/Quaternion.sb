module Sable.Math.Geometry

import Sable.Math

/// A rotation, as the four `F32`s of a quaternion: x, y, z, and last the
/// scalar part w. 16 bytes, aligned to 4, as a `Vector4`.
///
/// A positive angle turns counter-clockwise seen with the axis pointing at
/// one, and `a * b` turns by a and then by b, as matrices compose. (.NET's `*` is
/// Hamilton's product, which turns by the right first; its `Concatenate` is
/// this `*`.)
///
/// ```sable
/// let quarter = Quaternion(axis: Vector3.unitZ, angle: F32.pi / 2)
/// assert(quarter.transform(Vector3.unitX).nearEqual(Vector3.unitY))
/// let half = quarter * quarter
/// assert(half.transform(Vector3.unitX).nearEqual(-Vector3.unitX))
/// ```
public struct Quaternion: Hashable, Sendable {
    /// The x of the vector part.
    public var x: F32

    /// The y of the vector part.
    public var y: F32

    /// The z of the vector part.
    public var z: F32

    /// The scalar part.
    public var w: F32

    /// The quaternion of the components.
    public init(_ x: F32, _ y: F32, _ z: F32, _ w: F32) {
        self.x = x
        self.y = y
        self.z = z
        self.w = w
    }

    /// The quaternion of the vector part and the scalar part.
    public init(_ vector: Vector3, _ scalar: F32) {
        x = vector.x
        y = vector.y
        z = vector.z
        w = scalar
    }

    /// The quaternion of the components, w last.
    public init(_ components: Vector4) {
        x = components.x
        y = components.y
        z = components.z
        w = components.w
    }

    /// The rotation by the angle, in radians, about the axis, which is made
    /// unit; none about an axis that is zero.
    public init(axis direction: Vector3, angle radians: F32) {
        let unit = direction.normalized()
        if unit.isZero {
            self = Quaternion.identity
        } else {
            let half = radians * 0.5
            self = Quaternion(unit * F32.sin(half), F32.cos(half))
        }
    }

    /// The rotation by angles, in radians, about the body's own axes: the
    /// yaw about y, then the pitch about the x the yaw has turned, then the
    /// roll about the z both have (as .NET's CreateFromYawPitchRoll).
    public init(yaw aboutY: F32, pitch aboutX: F32, roll aboutZ: F32) {
        // In fixed axes, which is how '*' composes, the roll comes first.
        self = Quaternion(axis: Vector3.unitZ, angle: aboutZ) * Quaternion(axis: Vector3.unitX, angle: aboutX) * Quaternion(axis: Vector3.unitY, angle: aboutY)
    }

    /// The shortest rotation from one direction to another; of opposite
    /// ones, half a turn about some axis across them.
    ///
    /// ```sable
    /// let turn = Quaternion(from: Vector3.unitX, to: Vector3.unitY)
    /// assert(turn.transform(Vector3.unitX).nearEqual(Vector3.unitY))
    /// ```
    public init(from start: Vector3, to end: Vector3) {
        let one = start.normalized()
        let other = end.normalized()
        let cosine = one.dot(other)
        if cosine >= 1 - zeroTolerance {
            self = Quaternion.identity
        } else if cosine <= -1 + zeroTolerance {
            var axis = Vector3.unitX.cross(one)
            if axis.lengthSquared < zeroTolerance {
                axis = Vector3.unitY.cross(one)
            }
            self = Quaternion(axis: axis, angle: F32.pi)
        } else {
            self = Quaternion(one.cross(other), 1 + cosine).normalized()
        }
    }

    /// The rotation of a matrix that has no scale.
    public init(rotation m: Matrix4x4) {
        // The component that is greatest is found by its square root and the
        // rest by dividing by it, so the division is never by nearly zero.
        let trace = m.m11 + m.m22 + m.m33
        if trace > 0 {
            let s = (trace + 1).squareRoot() * 2
            self = Quaternion((m.m23 - m.m32) / s, (m.m31 - m.m13) / s, (m.m12 - m.m21) / s, 0.25 * s)
        } else if m.m11 > m.m22 && m.m11 > m.m33 {
            let s = (1 + m.m11 - m.m22 - m.m33).squareRoot() * 2
            self = Quaternion(0.25 * s, (m.m12 + m.m21) / s, (m.m31 + m.m13) / s, (m.m23 - m.m32) / s)
        } else if m.m22 > m.m33 {
            let s = (1 + m.m22 - m.m11 - m.m33).squareRoot() * 2
            self = Quaternion((m.m12 + m.m21) / s, 0.25 * s, (m.m23 + m.m32) / s, (m.m31 - m.m13) / s)
        } else {
            let s = (1 + m.m33 - m.m11 - m.m22).squareRoot() * 2
            self = Quaternion((m.m31 + m.m13) / s, (m.m23 + m.m32) / s, 0.25 * s, (m.m12 - m.m21) / s)
        }
    }

    /// The rotation that turns nothing.
    public static var identity: Quaternion => Quaternion(0, 0, 0, 1)

    /// How many components there are: 4.
    public static var componentCount: Int => 4

    /// The vector part.
    public var xyz: Vector3 => Vector3(x, y, z)

    /// The four components, w last.
    public var components: Vector4 => Vector4(x, y, z, w)

    /// Whether this is the identity, each component within a millionth.
    public var isIdentity: Bool => nearEqual(Quaternion.identity)

    /// The length: 1 for a rotation, which drifts as they are composed.
    public var length: F32 => lengthSquared.squareRoot()

    /// The square of the length.
    public var lengthSquared: F32 => x * x + y * y + z * z + w * w

    /// The angle of the rotation, in radians, in 0...pi.
    ///
    /// ```sable
    /// assert(nearEqual(Quaternion(axis: Vector3.up, angle: 1).angle, 1))
    /// ```
    public var angle: F32 => 2 * F32.acos(normalized().w.abs().minimum(1))

    /// The axis of the rotation, of length 1; y where nothing is turned.
    public var axis: Vector3 {
        get {
            let vector = xyz
            let squared = vector.lengthSquared
            return squared < 0.000000000001 ? Vector3.unitY : vector * (1 / squared.squareRoot())
        }
    }

    /// The rotation of length 1; the identity for one too short to have it.
    public fn normalized() -> Quaternion {
        let squared = lengthSquared
        if squared < 0.000000000001 {
            return Quaternion.identity
        }
        return self * (1 / squared.squareRoot())
    }

    /// The vector part negated: of a rotation, the rotation back.
    public var conjugate: Quaternion => Quaternion(-x, -y, -z, w)

    /// The rotation back, of any length; the identity for one too short.
    public fn inverted() -> Quaternion {
        let squared = lengthSquared
        if squared < 0.000000000001 {
            return Quaternion.identity
        }
        return conjugate * (1 / squared)
    }

    /// The dot product: below 0 where the two take the opposite ways to what
    /// is a near rotation.
    public fn dot(_ other: Quaternion) -> F32 => x * other.x + y * other.y + z * other.z + w * other.w

    /// The vector turned by this rotation, which is of length 1.
    public fn transform(_ value: Vector3) -> Vector3 {
        // v + 2w(q × v) + 2q × (q × v): q v q* with half the products.
        let axis = xyz
        let twice = axis.cross(value) * 2
        return value + twice * w + axis.cross(twice)
    }

    /// Each of the vectors turned by this rotation, written to the
    /// destination. Traps unless it has room for them.
    ///
    /// ```sable
    /// let half = Quaternion(axis: Vector3.up, angle: F32.pi)
    /// var turned = [Vector3.zero, Vector3.zero]
    /// half.transform([Vector3.unitX, Vector3.up], into: &turned)
    /// assert(turned[1] == Vector3.up && turned[0].nearEqual(-Vector3.unitX))
    /// ```
    public fn transform(_ source: Vector3[:], into destination: inout Vector3[:]) {
        precondition(destination.count >= source.count, "the destination is shorter than the source")
        for i in 0..<source.count {
            destination[i] = transform(source[i])
        }
    }

    /// The rotation so far from this one to the other, at a steady speed by
    /// the shorter way; the amount is held to 0...1.
    ///
    /// ```sable
    /// let to = Quaternion(axis: Vector3.up, angle: 1)
    /// assert(nearEqual(Quaternion.identity.slerp(to: to, 0.25).angle, 0.25, tolerance: 0.00001))
    /// ```
    public fn slerp(to other: Quaternion, _ amount: F32) -> Quaternion {
        let t = saturated(amount)
        let product = dot(other)
        // q and -q are the same rotation, and one of them is the nearer.
        let sign: F32 = product < 0 ? -1 : 1
        let cosine = product * sign
        // So near that the arc is a line, and its sine nothing to divide by.
        if cosine > 0.9999 {
            return (self * (1 - t) + other * (t * sign)).normalized()
        }
        // By arithmetic alone, not the platform's libm: the same bits everywhere.
        let theta = quarterArc(cosine)
        var angles = SIMD<F32, 4>(repeating: theta)
        angles[1] = (1 - t) * theta
        angles[2] = t * theta
        let sines = quarterSines(angles)
        let inverse = 1 / sines[0]
        return self * (sines[1] * inverse) + other * (sines[2] * inverse * sign)
    }

    /// The rotation so far from this one to the other, in a line by the
    /// shorter way and made unit: near `slerp` for the small steps of a
    /// blend, and cheaper; the amount is held to 0...1.
    public fn nlerp(to other: Quaternion, _ amount: F32) -> Quaternion {
        let sign: F32 = dot(other) < 0 ? -1 : 1
        return lerp(to: other * sign, saturated(amount)).normalized()
    }

    /// The components so far from these to the other's, as they are: neither
    /// by the shorter way nor made unit.
    public fn lerp(to other: Quaternion, _ amount: F32) -> Quaternion => self + (other - self) * amount

    /// Whether the two turn alike, q and -q among them: the dot product of
    /// the two made unit within the tolerance of 1.
    public fn sameRotation(as other: Quaternion, tolerance: F32 = 0.000001) -> Bool {
        return normalized().dot(other.normalized()).abs() >= 1 - tolerance
    }

    /// Whether each component is near the other's: q is not near -q, though
    /// they turn alike (`sameRotation`).
    public fn nearEqual(_ other: Quaternion, tolerance: F32 = 0.000001) -> Bool => components.nearEqual(other.components, tolerance: tolerance)

    /// The left rotation and then the right.
    public operator * (lhs: Quaternion, rhs: Quaternion) -> Quaternion {
        // Hamilton's product of the two the other way about.
        return Quaternion(
            rhs.w * lhs.x + rhs.x * lhs.w + rhs.y * lhs.z - rhs.z * lhs.y,
            rhs.w * lhs.y - rhs.x * lhs.z + rhs.y * lhs.w + rhs.z * lhs.x,
            rhs.w * lhs.z + rhs.x * lhs.y - rhs.y * lhs.x + rhs.z * lhs.w,
            rhs.w * lhs.w - rhs.x * lhs.x - rhs.y * lhs.y - rhs.z * lhs.z
        )
    }

    /// The sum, component by component.
    public operator + (lhs: Quaternion, rhs: Quaternion) -> Quaternion => Quaternion(lhs.x + rhs.x, lhs.y + rhs.y, lhs.z + rhs.z, lhs.w + rhs.w)

    /// The difference, component by component.
    public operator - (lhs: Quaternion, rhs: Quaternion) -> Quaternion => Quaternion(lhs.x - rhs.x, lhs.y - rhs.y, lhs.z - rhs.z, lhs.w - rhs.w)

    /// Every component times the number.
    public operator * (lhs: Quaternion, rhs: F32) -> Quaternion => Quaternion(lhs.x * rhs, lhs.y * rhs, lhs.z * rhs, lhs.w * rhs)

    /// Every component negated: the same rotation.
    public prefix operator - (operand: Quaternion) -> Quaternion => Quaternion(-operand.x, -operand.y, -operand.z, -operand.w)

    /// Whether the components are exactly equal, as IEEE has it.
    public operator == (lhs: Quaternion, rhs: Quaternion) -> Bool => lhs.x == rhs.x && lhs.y == rhs.y && lhs.z == rhs.z && lhs.w == rhs.w

    /// The components' hashes.
    public fn hash(into hasher: inout Hasher) {
        hasher.combine(x)
        hasher.combine(y)
        hasher.combine(z)
        hasher.combine(w)
    }
}

// The angle in 0...pi/2 of the cosine in 0...1, within 2e-8 and the rounding:
// Hastings' approximation (Abramowitz and Stegun, 4.4.46).
fn quarterArc(_ x: F32) -> F32 {
    let y = x * x
    let low = (1.570796305 - 0.2145988016 * x) + (0.0889789874 - 0.0501743046 * x) * y
    let high = (0.030891881 - 0.0170881256 * x) + (0.0066700901 - 0.0012624911 * x) * y
    return (1 - x).squareRoot() * (low + high * (y * y))
}

// The sines of angles in 0...pi/2, by their series to the thirteenth power,
// the rest of which is below 1e-9.
fn quarterSines(_ x: SIMD<F32, 4>) -> SIMD<F32, 4> {
    let y = x * x
    let z = y * y
    let low = (y * 0.008333333 - 0.16666667) + (y * 0.0000027557319 - 0.0001984127) * z
    return x + x * y * (low + (y * 0.00000000016059044 - 0.000000025052108) * (z * z))
}

extension Quaternion: Formattable {
    /// The components in parentheses, w last.
    ///
    /// ```sable
    /// assert("\(Quaternion.identity)" == "(0.0, 0.0, 0.0, 1.0)")
    /// ```
    public fn format(_ spec: FormatSpec) -> String => formatComponents([x, y, z, w], spec, named: "Quaternion")
}

extension Quaternion: Debug {
    /// As source writes it: `Quaternion(0.0, 0.0, 0.0, 1.0)`.
    public fn debugDescription() -> String => "Quaternion(\(x.debugDescription()), \(y.debugDescription()), \(z.debugDescription()), \(w.debugDescription()))"
}
