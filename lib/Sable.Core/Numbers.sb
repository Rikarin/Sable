extension F64 {
    /// The ratio of a circle's circumference to its diameter, as near as an F64 holds it.
    public static var pi: F64 => 3.141592653589793

    /// The number in decimal.
    @builtin("string_from_F64")
    public fn toString() -> String

    /// The number's distance from zero.
    @builtin("abs_F64")
    public fn abs() -> F64

    /// The smaller of the two.
    @builtin("min_F64")
    public fn min(other: F64) -> F64

    /// The larger of the two.
    @builtin("max_F64")
    public fn max(other: F64) -> F64
}

