extension Matrix3x2: Serializable {
    /// A struct of `m11`, `m12`, `m21`, `m22`, `m31`, `m32`.
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        try encoder.beginStruct("Matrix3x2", count: 6)
        try encoder.encodeField("m11")
        try m11.encode(to: encoder)
        try encoder.encodeField("m12")
        try m12.encode(to: encoder)
        try encoder.encodeField("m21")
        try m21.encode(to: encoder)
        try encoder.encodeField("m22")
        try m22.encode(to: encoder)
        try encoder.encodeField("m31")
        try m31.encode(to: encoder)
        try encoder.encodeField("m32")
        try m32.encode(to: encoder)
        try encoder.endStruct()
    }
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Matrix3x2 {
        try decoder.beginStruct("Matrix3x2")
        let m11 = try F32.decode(from: decoder.field("m11"))
        let m12 = try F32.decode(from: decoder.field("m12"))
        let m21 = try F32.decode(from: decoder.field("m21"))
        let m22 = try F32.decode(from: decoder.field("m22"))
        let m31 = try F32.decode(from: decoder.field("m31"))
        let m32 = try F32.decode(from: decoder.field("m32"))
        return Matrix3x2(m11, m12, m21, m22, m31, m32)
    }
}

extension Matrix3x3: Serializable {
    /// A struct of `m11` to `m33`, row by row.
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        try encoder.beginStruct("Matrix3x3", count: 9)
        try encoder.encodeField("m11")
        try m11.encode(to: encoder)
        try encoder.encodeField("m12")
        try m12.encode(to: encoder)
        try encoder.encodeField("m13")
        try m13.encode(to: encoder)
        try encoder.encodeField("m21")
        try m21.encode(to: encoder)
        try encoder.encodeField("m22")
        try m22.encode(to: encoder)
        try encoder.encodeField("m23")
        try m23.encode(to: encoder)
        try encoder.encodeField("m31")
        try m31.encode(to: encoder)
        try encoder.encodeField("m32")
        try m32.encode(to: encoder)
        try encoder.encodeField("m33")
        try m33.encode(to: encoder)
        try encoder.endStruct()
    }
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Matrix3x3 {
        try decoder.beginStruct("Matrix3x3")
        let m11 = try F32.decode(from: decoder.field("m11"))
        let m12 = try F32.decode(from: decoder.field("m12"))
        let m13 = try F32.decode(from: decoder.field("m13"))
        let m21 = try F32.decode(from: decoder.field("m21"))
        let m22 = try F32.decode(from: decoder.field("m22"))
        let m23 = try F32.decode(from: decoder.field("m23"))
        let m31 = try F32.decode(from: decoder.field("m31"))
        let m32 = try F32.decode(from: decoder.field("m32"))
        let m33 = try F32.decode(from: decoder.field("m33"))
        return Matrix3x3(m11, m12, m13, m21, m22, m23, m31, m32, m33)
    }
}

extension Matrix4x4: Serializable {
    /// A struct of `m11` to `m44`, row by row.
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        try encoder.beginStruct("Matrix4x4", count: 16)
        try encoder.encodeField("m11")
        try m11.encode(to: encoder)
        try encoder.encodeField("m12")
        try m12.encode(to: encoder)
        try encoder.encodeField("m13")
        try m13.encode(to: encoder)
        try encoder.encodeField("m14")
        try m14.encode(to: encoder)
        try encoder.encodeField("m21")
        try m21.encode(to: encoder)
        try encoder.encodeField("m22")
        try m22.encode(to: encoder)
        try encoder.encodeField("m23")
        try m23.encode(to: encoder)
        try encoder.encodeField("m24")
        try m24.encode(to: encoder)
        try encoder.encodeField("m31")
        try m31.encode(to: encoder)
        try encoder.encodeField("m32")
        try m32.encode(to: encoder)
        try encoder.encodeField("m33")
        try m33.encode(to: encoder)
        try encoder.encodeField("m34")
        try m34.encode(to: encoder)
        try encoder.encodeField("m41")
        try m41.encode(to: encoder)
        try encoder.encodeField("m42")
        try m42.encode(to: encoder)
        try encoder.encodeField("m43")
        try m43.encode(to: encoder)
        try encoder.encodeField("m44")
        try m44.encode(to: encoder)
        try encoder.endStruct()
    }
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Matrix4x4 {
        try decoder.beginStruct("Matrix4x4")
        let m11 = try F32.decode(from: decoder.field("m11"))
        let m12 = try F32.decode(from: decoder.field("m12"))
        let m13 = try F32.decode(from: decoder.field("m13"))
        let m14 = try F32.decode(from: decoder.field("m14"))
        let m21 = try F32.decode(from: decoder.field("m21"))
        let m22 = try F32.decode(from: decoder.field("m22"))
        let m23 = try F32.decode(from: decoder.field("m23"))
        let m24 = try F32.decode(from: decoder.field("m24"))
        let m31 = try F32.decode(from: decoder.field("m31"))
        let m32 = try F32.decode(from: decoder.field("m32"))
        let m33 = try F32.decode(from: decoder.field("m33"))
        let m34 = try F32.decode(from: decoder.field("m34"))
        let m41 = try F32.decode(from: decoder.field("m41"))
        let m42 = try F32.decode(from: decoder.field("m42"))
        let m43 = try F32.decode(from: decoder.field("m43"))
        let m44 = try F32.decode(from: decoder.field("m44"))
        return Matrix4x4(m11, m12, m13, m14, m21, m22, m23, m24, m31, m32, m33, m34, m41, m42, m43, m44)
    }
}

extension Plane: Serializable {
    /// A struct of `normal`, `d`.
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        try encoder.beginStruct("Plane", count: 2)
        try encoder.encodeField("normal")
        try normal.encode(to: encoder)
        try encoder.encodeField("d")
        try d.encode(to: encoder)
        try encoder.endStruct()
    }
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Plane {
        try decoder.beginStruct("Plane")
        let normal = try Vector3.decode(from: decoder.field("normal"))
        let d = try F32.decode(from: decoder.field("d"))
        return Plane(normal, d)
    }
}

extension Transform: Serializable {
    /// A struct of `translation`, `rotation`, `scale`.
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        try encoder.beginStruct("Transform", count: 3)
        try encoder.encodeField("translation")
        try translation.encode(to: encoder)
        try encoder.encodeField("rotation")
        try rotation.encode(to: encoder)
        try encoder.encodeField("scale")
        try scale.encode(to: encoder)
        try encoder.endStruct()
    }
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Transform {
        try decoder.beginStruct("Transform")
        let translation = try Vector3.decode(from: decoder.field("translation"))
        let rotation = try Quaternion.decode(from: decoder.field("rotation"))
        let scale = try Vector3.decode(from: decoder.field("scale"))
        return Transform(translation: translation, rotation: rotation, scale: scale)
    }
}

extension Ray: Serializable {
    /// A struct of `origin`, `direction`.
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        try encoder.beginStruct("Ray", count: 2)
        try encoder.encodeField("origin")
        try origin.encode(to: encoder)
        try encoder.encodeField("direction")
        try direction.encode(to: encoder)
        try encoder.endStruct()
    }
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Ray {
        try decoder.beginStruct("Ray")
        var value = Ray(Vector3.zero, Vector3.zero)
        value.origin = try Vector3.decode(from: decoder.field("origin"))
        value.direction = try Vector3.decode(from: decoder.field("direction"))
        return value
    }
}

