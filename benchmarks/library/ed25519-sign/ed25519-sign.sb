module Ed25519SignBench

// Ed25519: 5000 signatures of a message of 64 bytes, the last of which is
// checked. .NET has no Ed25519.

import Sable.Crypto
import Sable.Testing

fn run(_ key: Ed25519PrivateKey) -> String {
    var message = U8[>..](repeating: 7, count: 64)
    var signature = key.sign(message)
    var round = 1
    while round < 5000 {
        message[round % 64] = U8(round % 256)
        signature = key.sign(message)
        round += 1
    }
    return "\(key.publicKey.isValid(signature, for: message) ? 1 : 0)"
}

@bench
fn measure(_ b: Bencher) {
    let key = Ed25519PrivateKey.generate()
    b.check(b.iterate { run(key) })
}
