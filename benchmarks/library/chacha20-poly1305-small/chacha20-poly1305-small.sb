module Chacha20Poly1305SmallBench

// ChaCha20-Poly1305 of 64 bytes, 100_000 times: sealed in place with a nonce that counts,
// and opened again. Prints the sum of the tags' first bytes.

import Sable.Crypto

@main
fn main() {
    let cipher = try! ChaCha20Poly1305(key: SymmetricKey(U8[>..](repeating: 7, count: 32)))
    var text = U8[>..](repeating: 1, count: 64)
    var nonce = U8[>..](repeating: 0, count: 12)
    var tag = U8[>..](repeating: 0, count: 16)
    var total = 0
    for i in 0..<100_000 {
        nonce.writeU64(U64(i), at: 0, endian: .Little)
        try! cipher.seal(inPlace: &text, nonce: nonce, associatedData: [], tag: &tag)
        total += Int(tag[0])
        try! cipher.open(inPlace: &text, nonce: nonce, associatedData: [], tag: tag)
    }
    print(total + Int(text[63]))
}
