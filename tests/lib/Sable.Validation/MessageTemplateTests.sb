module ValidationTests

import Sable.Testing
import Sable.Validation

@test(arguments: [
    ("", ""),
    ("plain", "plain"),
    ("{A}{B}{A}", "11"),
    ("{C}", "{C}"),
    ("{{A}}", "{A}"),
    ("{", "{"),
    ("}", "}"),
    ("a{A", "a{A"),
    ("{A}}}", "1}"),
    ("é{A}ž", "é1ž"),
    ("{{{A}}}", "{1}"),
])
fn aTemplateFillsWhatItKnows(_ text: String, _ filled: String) {
    expect(MessageTemplate(text).fill(["A": "1", "B": ""]) == filled)
}
