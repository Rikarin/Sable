module Sable.Core

/// Writes the value and a line break to standard output: what hello world
/// needs, without importing Sable.IO.
@builtin("print_String")
public fn print(_ value: String)
@builtin("print_Int")
public fn print(_ value: Int)
@builtin("print_F64")
public fn print(_ value: F64)
@builtin("print_Bool")
public fn print(_ value: Bool)
@builtin("print_I8")
public fn print(_ value: I8)
@builtin("print_I16")
public fn print(_ value: I16)
@builtin("print_I32")
public fn print(_ value: I32)
@builtin("print_I64")
public fn print(_ value: I64)
@builtin("print_U8")
public fn print(_ value: U8)
@builtin("print_U16")
public fn print(_ value: U16)
@builtin("print_U32")
public fn print(_ value: U32)
@builtin("print_U64")
public fn print(_ value: U64)
@builtin("print_UInt")
public fn print(_ value: UInt)
@builtin("print_F32")
public fn print(_ value: F32)
@builtin("print_I128")
public fn print(_ value: I128)
@builtin("print_U128")
public fn print(_ value: U128)
@builtin("print_F16")
public fn print(_ value: F16)
@builtin("print_BF16")
public fn print(_ value: BF16)
@builtin("print_Char")
public fn print(_ value: Char)

/// Writes the value as an interpolation would, '"\(value)"', and a line
/// break, to standard output: any value, where the overloads above take
/// the built-in ones.
///
/// ```sable
/// print([1, 2, 3])
/// print((1, "one"))
/// ```
public fn print<T>(_ value: T) {
    Runtime.write(text: "\(value)\n")
}

/// Writes the text and a line break to the writer, rather than to standard
/// output: a String being built, a TextBuilder, StandardError.
///
/// ```sable
/// var text = ""
/// print("one", to: &text)
/// print("two", to: &text)
/// assert(text == "one\ntwo\n")
/// ```
public fn print<W: TextWriter>(_ text: String, to output: inout W) {
    output.write(text)
    output.write("\n")
}

/// Writes the value as an interpolation would, and a line break, to the
/// writer.
///
/// ```sable
/// var text = ""
/// print(42, to: &text)
/// assert(text == "42\n")
/// ```
public fn print<T, W: TextWriter>(_ value: T, to output: inout W) {
    output.write("\(value)")
    output.write("\n")
}
