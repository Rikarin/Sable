module UUIDTests

// UUID (Sable.Core), against RFC 9562's test vectors.

import Sable.Testing
import CoreTestSupport

@test
fn version4IsRfc9562sExample() {
    // RFC 9562, Appendix A.3: random bits 0x919108f752d1?320, 0x?bacf847db4148a8.
    let words: U64[>..] = [0x919108F752D1F320, 0x1BACF847DB4148A8]
    var bits = Scripted(words)
    let id = UUID.random(using: &bits)
    assertEqual(id.toString(), "919108f7-52d1-4320-9bac-f847db4148a8")
    assertEqual(bits.drawn, 2)
    assertEqual(id.version, 4)
    assertEqual(id.variant, 2)
    expect(id.timestamp == none)
}

@test
fn version7IsRfc9562sExample() {
    // RFC 9562, Appendix A.6: 2022-02-22T19:22:22Z, rand_a 0xCC3, rand_b 0x18C4DC0C0C07398F.
    let words: U64[>..] = [0xCC3, 0x18C4DC0C0C07398F]
    var bits = Scripted(words)
    let id = UUID.timeOrdered(milliseconds: 0x017F22E279B0, using: &bits)
    assertEqual(id.toString(), "017f22e2-79b0-7cc3-98c4-dc0c0c07398f")
    assertEqual(bits.drawn, 2)
    assertEqual(id.version, 7)
    assertEqual(id.variant, 2)
    assertEqual(id.timestamp, 1645557742000)
}

// RFC 9562, Appendix A: versions 1, 3, 5 and 6, and the DNS namespace.
@test(arguments: [
    ("c232ab00-9414-11ec-b3c8-9f6bdeced846", 1), ("5df41881-3aed-3515-88a7-2f4a814cf09e", 3),
    ("2ed6657d-e927-568b-95e1-2665a8aea6a2", 5), ("1ec9414c-232a-6b00-b3c8-9f6bdeced846", 6),
    ("6ba7b810-9dad-11d1-80b4-00c04fd430c8", 1)
])
fn theExamplesOfOtherVersionsParse(_ text: String, _ version: Int) throws {
    let id = try UUID.parse(text)
    expect(id.version == version)
    expect(id.variant == 2)
    expect(id.toString() == text)
}

@test
fn theLeastAndTheGreatestAreAllZerosAndAllOnes() {
    expect(UUID.nil.toString() == "00000000-0000-0000-0000-000000000000")
    expect(UUID.max.toString() == "ffffffff-ffff-ffff-ffff-ffffffffffff")
}

@test(arguments: [
    "6ba7b810-9dad-11d1-80b4-00c04fd430c8", "6BA7B810-9DAD-11D1-80B4-00C04FD430C8", "{6ba7b810-9dad-11d1-80b4-00c04fd430c8}",
    "6ba7b8109dad11d180b400c04fd430c8", "urn:uuid:6ba7b810-9dad-11d1-80b4-00c04fd430c8"
])
fn everyFormParses(_ text: String) throws {
    expect(try UUID.parse(text) == UUID.parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8"))
}

@test
fn everyFormIsWritten() throws {
    let id = try UUID.parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8")
    expect(id.compactString() == "6ba7b8109dad11d180b400c04fd430c8")
    expect(id.bracedString() == "{6ba7b810-9dad-11d1-80b4-00c04fd430c8}")
    expect("\(id:X)" == "6BA7B810-9DAD-11D1-80B4-00C04FD430C8")
    expect("\(id:?)" == "6ba7b810-9dad-11d1-80b4-00c04fd430c8")
}

@test
fn anyOneIsReadBackFromEveryForm() {
    forAll(Gen.arbitrary(U8.self).array(count: 16...16)) { (bytes: U8[>..]) in
        let id = require(UUID.fromBytes(bytes))
        expect(try UUID.parse(id.toString()) == id)
        expect(try UUID.parse(id.compactString()) == id)
        expect(try UUID.parse(id.bracedString()) == id)
        expect(UUID(bytes: id.bytes) == id)
    }
}

@test(arguments: [
    ("", .Empty), ("6ba7b810-9dad-11d1-80b4", .Invalid(at: 0)),
    ("6ba7b810x9dad-11d1-80b4-00c04fd430c8", .Invalid(at: 8)),
    ("6ba7b810-9dad-11d1-80b4-00c04fd430cg", .InvalidDigit(at: 35)),
    ("[6ba7b810-9dad-11d1-80b4-00c04fd430c8}", .Invalid(at: 0))
])
fn aMalformedOneSaysWhere(_ text: String, _ error: ParseError) {
    expectThrows(error) { _ = try UUID.parse(text) }
}

@test
fn bytesGoInOrder() {
    let id = try! UUID.parse("00112233-4455-6677-8899-aabbccddeeff")
    let bytes = id.bytes
    assertEqual(bytes[0], 0x00)
    assertEqual(bytes[3], 0x33)
    assertEqual(bytes[15], 0xFF)
    assertEqual(UUID(bytes: bytes), id)
    let slice: U8[>..] = [0, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF]
    assertEqual(UUID.fromBytes(slice), id)
    let short: U8[>..] = [1, 2]
    expect(UUID.fromBytes(short) == none)
}

@test
fn randomOnesDifferAndTimeOrderedOnesSort() {
    var seen: [UUID: Bool] = [:]
    var i = 0
    while i < 1000 {
        let id = UUID.random()
        assertEqual(id.version, 4)
        assertEqual(id.variant, 2)
        expect(seen[id] == none)
        seen[id] = true
        i += 1
    }
    var generator = SeededRandomNumberGenerator(seed: 9)
    let earlier = UUID.timeOrdered(milliseconds: 1000, using: &generator)
    let later = UUID.timeOrdered(milliseconds: 1001, using: &generator)
    expect(earlier < later)
    expect(UUID.nil < earlier && later < UUID.max)
    let now = UUID.timeOrdered()
    expect(now.timestamp! > 1700000000000)
}
