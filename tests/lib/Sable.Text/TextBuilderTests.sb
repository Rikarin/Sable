module TextBuilderTests

// TextBuilder (Sable.Text): against a String as a model, with appends,
// inserts, removals, replacements and truncations at random, in text with
// characters of every UTF-8 width; and each call on its own.

import Sable.Text
import Sable.Testing

// Characters of one, two, three and four UTF-8 bytes.
let characters: Gen<Char> = Gen.element(of: ['a', 'b', 'é', 'ж', '語', '😀', '\n'])
let pieces: Gen<String> = Gen.string(of: characters, count: 0...5)

// Where an edit is: so many thousandths of the text's length, whatever that
// has become.
@derive(Debug)
union Edit {
    Append(text: String)
    Insert(text: String, at: Int)
    Remove(from: Int, to: Int)
    Replace(from: Int, to: Int, text: String)
    Set(character: Char, at: Int)
    Truncate(to: Int)
    ReplaceAll(character: Char, text: String)
}

let places: Gen<Int> = Gen.number(in: 0...1000)
let edits: Gen<Edit> = Gen<Edit>((choices) => match choices.below(12) {
    case 6  => .Insert(text: pieces.value(from: choices), at: places.value(from: choices))
    case 7  => .Remove(from: places.value(from: choices), to: places.value(from: choices))
    case 8  => .Replace(from: places.value(from: choices), to: places.value(from: choices), text: pieces.value(from: choices))
    case 9  => .Set(character: characters.value(from: choices), at: places.value(from: choices))
    case 10 => .Truncate(to: places.value(from: choices))
    case 11 => .ReplaceAll(character: characters.value(from: choices), text: pieces.value(from: choices))
    case _  => .Append(text: pieces.value(from: choices))
})

fn range(_ from: Int, _ to: Int, in text: String) -> Range<Int> {
    let a = from * text.count / 1000
    let b = to * text.count / 1000
    return a < b ? a..<b : b..<a
}

@test
fn randomEditsAgreeWithAString() {
    forAll(edits.array(count: 0...150), cases: 60) { (edits: Edit[>..]) in
        let builder = TextBuilder()
        var model = ""
        fn splice(_ range: Range<Int>, _ text: String) {
            model = model.slice(from: 0, to: range.lowerBound) + text + model.slice(from: range.upperBound, to: model.count)
        }
        for edit in edits {
            match edit {
                case .Append(let text) => {
                    builder.append(text)
                    model = model + text
                }
                case .Insert(let text, let place) => {
                    let at = range(place, place, in: model)
                    builder.insert(text, at: at.lowerBound)
                    splice(at, text)
                }
                case .Remove(let from, let to) => {
                    let gone = range(from, to, in: model)
                    builder.remove(gone)
                    splice(gone, "")
                }
                case .Replace(let from, let to, let text) => {
                    let gone = range(from, to, in: model)
                    builder.replace(gone, with: text)
                    splice(gone, text)
                }
                case .Set(let character, let place) => {
                    let at = place * model.count / 1000
                    if at < model.count {
                        expect(builder[at] == model.at(index: at))
                        builder[at] = character
                        splice(at..<at + 1, String.fromChar(character))
                    }
                }
                case .Truncate(let place) => {
                    // Seldom, or the text would never be long.
                    if model.count > 100 {
                        let keep = place * model.count / 1000
                        builder.truncate(to: keep)
                        model = model.slice(from: 0, to: keep)
                    }
                }
                case .ReplaceAll(let character, let text) => {
                    let target = String.fromChar(character)
                    expect(builder.replace(target, with: text) == model.count(of: target))
                    model = model.replacing(target, with: text)
                }
            }
            expect(builder.count == model.count)
            expect(builder.utf8Count == model.utf8Count)
        }
        expect(builder.build() == model)
    }
}

@test
fn manyPiecesAreGatheredIntoFewChunks() {
    let builder = TextBuilder(capacity: 16)
    expect(builder.capacity >= 16)
    var expected = 0
    var i = 0
    while i < 10000 {
        builder.append("piece \(i);")
        expected += "piece \(i);".count
        i += 1
    }
    assertEqual(builder.count, expected)
    let chunks = builder.chunks
    expect(chunks.count < 50, "\(chunks.count) chunks")
    var joined = 0
    for chunk in chunks {
        joined += chunk.count
    }
    assertEqual(joined, expected)
    expect(builder.build().hasPrefix("piece 0;piece 1;"))
    expect(builder.build().hasSuffix("piece 9999;"))
    builder.reserveCapacity(100)
    expect(builder.capacity >= 100)
}

@test
fn eachWayOfAppending() {
    let builder = TextBuilder("start")
    builder.append(' ')
    builder.append(contentsOf: ['ж', '😀'])
    builder.append(contentsOf: "xy")
    builder.append("")
    builder.append(3.14159, spec: try! FormatSpec.parse(".2"))
    builder.append(255, spec: try! FormatSpec.parse("x"))
    builder.append(describing: [1, 2])
    builder.append(0)
    builder.append(-42)
    builder.append(Int.min)
    builder.append(U64.max)
    builder.append(-7 as I8)
    builder.appendLine()
    builder.appendLine("next")
    builder.appendJoined(["a", "b", "c"], separator: ", ")
    let nothing: String[>..] = []
    builder.appendJoined(nothing, separator: ", ")
    var writer = builder
    print(7, to: &writer)
    let n = 42
    writer.write("n=\(n)")
    assertEqualText(builder.build(), "start ж😀xy3.14ff[1, 2]0-42-922337203685477580818446744073709551615-7\nnext\na, b, c7\nn=42")
    assertEqual("[\(TextBuilder("hi"):>4)]", "[  hi]")
}

// Integers written two digits at a time: each count of digits, odd and
// even, and the eight-digit words' edges.
@test(arguments: [0, 7, 9, 10, 42, 99, 100, 101, 999, 1000, 12345, 99999, 100000, 1234567, 9999999, 10000000, 99999999, 100000000, 100000001, 1234567890123, 9007199254740993, Int.max, -1, -10, -100, -99999999, -100000000, Int.min])
fn integersAsInterpolationWritesThem(_ value: Int) {
    let builder = TextBuilder(capacity: 4)
    builder.append(value)
    assertEqual(builder.build(), "\(value)")
    assertEqual(builder.utf8Count, "\(value)".utf8Count)
}

// Text appended in short runs, of each length to past two words, read as
// windows of the text, after an odd start so that the writes are unaligned;
// and the scalars a build reports, counted as they went.
@test
fn shortRunsOfEachLength() {
    let text = "abcdefghijklmnopqrstuvwxyz"
    var expected = "é"
    let builder = TextBuilder("é")
    for length in 1...18 {
        let run = text.slice(from: 0, to: length)
        builder.append(run)
        expected += run
    }
    builder.append("ж😀")
    expected += "ж😀"
    let built = builder.build()
    assertEqual(built, expected)
    assertEqual(built.count, expected.count)
    assertEqual(built.utf8Count, expected.utf8Count)
}

@test
fn editsAtTheEdgesAndEmptiness() {
    let builder = TextBuilder()
    expect(builder.isEmpty && builder.count == 0 && builder.build() == "")
    expect(builder.chunks.isEmpty)
    builder.insert("bc", at: 0)
    builder.insert("a", at: 0)
    builder.insert("d", at: 3)
    assertEqual(builder.build(), "abcd")
    builder.remove(1..<1)
    builder.remove(0..<1)
    assertEqual(builder.build(), "bcd")
    builder.replace(0..<3, with: "")
    expect(builder.isEmpty)
    builder.append("x-y-x")
    assertEqual(builder.replace("x", with: "zz"), 2)
    assertEqual(builder.replace("q", with: "zz"), 0)
    assertEqual(builder.build(), "zz-y-zz")
    builder.truncate(to: 100)
    assertEqual(builder.count, 7)
    builder.truncate(to: 2)
    assertEqual(builder.build(), "zz")
    builder[1] = 'é'
    assertEqual(builder.build(), "zé")
    assertEqual(builder.utf8Count, 3)
    builder.clear()
    expect(builder.isEmpty && builder.utf8Count == 0 && builder.build() == "")
}

@test
fn multiLineTextComparesByLine() {
    let builder = TextBuilder()
    builder.appendLine("alpha")
    builder.appendLine("beta")
    assertEqualText(builder.build(), "alpha\nbeta\n")
}

@test
fn aTextBuilderIsATextWriter() {
    let builder = TextBuilder()
    builder.append("a")
    var writer = builder
    writer.write("b")
    print(3, to: &writer)
    writer.write(describing: [4])
    assertEqual(builder.build(), "ab3\n[4]")
}

@bench
fn buildingText(_ b: Bencher) {
    b.iterate(() => {
        let builder = TextBuilder()
        var i = 0
        while i < 32 {
            builder.append("piece")
            i = i + 1
        }
        return builder.build()
    })
}

@test
fn aShortBuildKeepsTheBufferForTheNextUse() {
    let builder = TextBuilder(capacity: 64)
    builder.append("first")
    expect(builder.build() == "first")
    let room = builder.capacity
    builder.append(" and more")
    expect(builder.build() == "first and more")
    builder.reset()
    expect(builder.isEmpty && builder.capacity == room)
    builder.append("again")
    expect(builder.build() == "again")
}
