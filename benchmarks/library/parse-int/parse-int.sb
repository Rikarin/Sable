module ParseIntBench

// Int.parse: 200,000 numbers as text, parsed five times.

@main
fn main() {
    var texts: String[>..] = []
    var x = 12345
    for i in 0..<200000 {
        x = (x * 1103515245 + 12345) % 2147483648
        texts.append("\(i % 2 == 0 ? x : -x)")
    }
    var total = 0
    for _ in 0..<5 {
        for text in texts {
            total += try! Int.parse(text)
        }
    }
    print(total)
}
