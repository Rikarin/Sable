module MutexTests

// Mutex (Sable.Concurrency).

import Sable.Concurrency
import Sable.Testing

@test
fn aMutexHandsItsValueToOneHolder() {
    let names: Mutex<String[>..]> = Mutex([])
    names.withLock { $0.append("a") }
    assertEqual(names.withLock { $0.count }, 1)
    assertEqual(names.withLockIfAvailable { $0[0] }, "a")
    let doubled = names.withLock { value -> Int in
        value.append("b")
        return value.count * 2
    }
    assertEqual(doubled, 4)
}

struct Failure: Error {
    fn debugDescription() -> String { return "Failure" }
}

@test
fn aMutexKeepsWhatAThrowingClosureLeft() {
    let n = Mutex<Int>(1)
    do {
        try n.withLock { value in
            value = 7
            throw Failure()
        }
        fail("it did not throw")
    } catch { }
    assertEqual(n.withLock { $0 }, 7)
}

@test
fn manyTasksCountUnderAMutex() async {
    let total = Mutex<Int>(0)
    await withTaskGroup(of: Int.self) { group in
        var task = 0
        while task < 8 {
            group.spawn {
                var i = 0
                while i < 5000 {
                    total.withLock { $0 += 1 }
                    i += 1
                }
                return 0
            }
            task += 1
        }
        await group.waitForAll()
    }
    assertEqual(total.withLock { $0 }, 40000)
}

@test
fn aHeldMutexIsNotAvailable() {
    let n = Mutex<Int>(1)
    let refused = n.withLock { value -> Bool in
        value += 1
        return n.withLockIfAvailable { $0 } == none
    }
    assert(refused)
    assertEqual(n.withLockIfAvailable { $0 }, 2)
}

// Counts down as it goes.
final class Held {
    let live: Atomic<Int>

    init(_ live: Atomic<Int>) {
        self.live = live
        live.add(1)
    }

    deinit {
        live.subtract(1)
    }
}

@test
fn whatIsPutInALockedArrayIsCountedOnEveryThread() async {
    // Made inside the lock, stored in an array that is shared already, and
    // held by several threads outside it: in place, appended, in an array
    // of arrays, and in a field of an object.
    let live = Atomic<Int>(0)
    if true {
        let slots: Mutex<Held?[>..]> = Mutex([none, none, none, none])
        let lists: Mutex<Held[>..][>..]> = Mutex([[], []])
        await withTaskGroup(of: Int.self) { group in
            for task in 0..<4 {
                group.spawn {
                    var kept: Held[>..] = []
                    for i in 0..<3000 {
                        let at = (i + task) % 4
                        if i % 5 == 0 {
                            slots.withLock { $0[at] = Held(live) }
                        }
                        if let held = slots.withLock({ $0[at] }) {
                            kept.append(held)
                        }
                        lists.withLock { lists in
                            if lists[at % 2].count > 20 {
                                lists[at % 2] = []
                            }
                            lists[at % 2].append(Held(live))
                        }
                        kept.append(contentsOf: lists.withLock { $0[(at + 1) % 2] })
                        if kept.count > 50 {
                            kept = []
                        }
                    }
                    return kept.count
                }
            }
            await group.waitForAll()
        }
        assert(live.load() > 0)
    }
    assertEqual(live.load(), 0)
}
