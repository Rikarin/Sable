module Sable.Testing

import Sable.Diagnostics

/// A logger for a test to give the code it tests, and then to ask what was
/// logged: each line as a record of its level, its logger's name, its
/// message and its fields, kept and not written. .NET's `FakeLogger`.
///
/// It logs at every level. The loggers made `with` it keep their lines in
/// it too, and so does a `Logger.Of<Category>` made with it, under the
/// category's name.
///
/// ```sable
/// struct Checkout {}
///
/// let log = FakeLogger("orders")
/// log.warning("low stock", [field("sku", "a-1"), field("left", 2)])
/// log.with([field("order", "o-7")]).info("paid")
/// Logger.Of<Checkout>(log).error("declined")
/// let record = log.records[0]
/// assert(record.level == .Warning && record.message == "low stock")
/// assert(record.field("left") == "2")
/// assert(log.records[1].field("order") == "o-7")
/// assert(log.records[2].name.hasSuffix("Checkout"))
/// assert(log.messages(at: .Info) == ["paid"])
/// ```
public final class FakeLogger: Logger {
    // What it and the loggers made with it have logged.
    let store: FakeLogRecords

    public init(_ name: String = "test") {
        store = FakeLogRecords()
        super.init(name)
        threshold = Level.Trace
    }

    init(_ name: String, into store: FakeLogRecords) {
        self.store = store
        super.init(name)
    }

    /// What was logged, in order, since it was made or cleared, by it and
    /// the loggers made with it.
    public var records: LogRecord[>..] {
        get { return store.records }
    }

    /// The messages logged at the level.
    public fn messages(at level: Level) -> String[>..] {
        return store.records.filter({ $0.level == level }).map({ $0.message }).toArray()
    }

    /// Forgets what was logged so far.
    public fn clear() {
        store.records = []
    }

    /// Keeps the record, unless the level is below the threshold.
    public override fn log(_ level: Level, _ message: String, _ fields: Field[>..]) {
        if isEnabled(level) {
            store.records.append(LogRecord(level: level, name: name, message: message, fields: self.fields(of: fields)))
        }
    }

    /// A logger that adds the fields, of another category where it is given
    /// one, whose records this keeps.
    public override fn with(_ fields: Field[>..] = [], name: String? = none) -> Logger {
        let child = FakeLogger(name ?? self.name, into: store)
        child.threshold = threshold
        child.timestamps = timestamps
        child.context = context
        child.context.append(contentsOf: fields)
        return child
    }
}

// The records a FakeLogger and its children share.
final class FakeLogRecords {
    var records: LogRecord[>..] = []
}

/// What a logger was asked to log.
public struct LogRecord {
    public let level: Level
    /// The logger's name: its category.
    public let name: String
    public let message: String
    /// Each field, in order: the logger's own first, then the call's, then
    /// the trace's and span's it was logged in.
    public let fields: Field[>..]

    /// A field's value; none where it has none of the key.
    public fn field(_ key: String) -> String? {
        for each in fields {
            if each.key == key {
                return each.value
            }
        }
        return none
    }
}
