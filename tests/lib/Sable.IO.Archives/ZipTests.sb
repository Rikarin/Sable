module ZipTests

// Zip archives: what is written is read, whole, in parts and through the zip
// and unzip commands; Zip64; what is damaged; and what would leave the
// directory it is extracted to.

import ArchiveData
import Sable.IO
import Sable.IO.Archives
import Sable.Testing
import Sable.Time

fn archive(_ fill: (ZipWriter<MemoryStream>) throws(IoError) -> ()) -> U8[>..] {
    let writer = ZipWriter(MemoryStream())
    try! fill(writer)
    try! writer.finish()
    return writer.inner.bytes
}

@test
fn entriesAreWrittenAndRead() throws {
    let writer = ZipWriter(MemoryStream())
    var options = ZipOptions()
    options.modified = UtcDateTime.of(year: 2024, month: 5, day: 6, hour: 7, minute: 8, second: 9)
    options.comment = "a note \u{2603}"
    options.mode = 0o600
    try writer.add("a.txt", "hello".utf8Bytes(), options: options)
    for method in [ZipMethod.Store, ZipMethod.Deflate, ZipMethod.Zstd] {
        options.method = method
        try writer.add("whole \(method)", bytes(50_000), options: options)
        try writer.begin("parts \(method)", options: options)
        try writer.write(bytes(50_000)[..<20_000])
        try writer.write(bytes(50_000)[20_000...])
        try writer.end()
        var reader = MemoryStream(bytes(300_000))
        try writer.add("read \(method)", reading: &reader, options: options)
    }
    options.isLarge = true
    try writer.begin("large \u{2603}", options: options)
    try writer.write([1, 2, 3])
    try writer.end()
    try writer.addDirectory("d")
    try writer.addSymlink("link", to: "a.txt")
    try writer.finish(comment: "all of it")

    let read = try ZipArchive(writer.inner.bytes)
    expect(read.comment == "all of it" && read.entries.count == 13)
    let first = read.entry(named: "a.txt")!
    expect(first.modified == options.modified && first.comment == "a note \u{2603}" && first.mode == 0o100600)
    expect(first.method == .Store && first.size == 5 && first.compressedSize == 5 && !first.isDirectory)
    for method in [ZipMethod.Store, ZipMethod.Deflate, ZipMethod.Zstd] {
        let whole = read.entry(named: "whole \(method)")!
        expect(whole.method == method && (method == .Store) == (whole.compressedSize == 50_000))
        expect((try read.read(whole)) == bytes(50_000))
        expect((try read.read(read.entry(named: "parts \(method)")!)) == bytes(50_000))
        expect((try read.read(read.entry(named: "read \(method)")!)) == bytes(300_000))
    }
    expect((try read.read(read.entry(named: "large \u{2603}")!)) == [1, 2, 3])
    expect(read.entry(named: "d/")!.isDirectory && read.entry(named: "d/")!.mode == 0o040755)
    expect(read.entry(named: "link")!.isSymlink && (try read.read(read.entry(named: "link")!)) == "a.txt".utf8Bytes())
    expect(read.entry(named: "nowhere") == none)
    expectThrows(saying: "'a.txt' has more than 4 bytes") { _ = try read.read(first, limit: 4) }
}

@test
fn emptyAndPrefixedArchivesAreRead() throws {
    let empty = archive { writer throws(IoError) in _ = writer }
    expect(empty.count == 22 && (try ZipArchive(empty)).entries.isEmpty)
    var prefixed = bytes(1000)
    prefixed.append(contentsOf: archive { writer throws(IoError) in try writer.add("a", [1]) })
    let read = try ZipArchive(prefixed)
    expect((try read.read(read.entries[0])) == [1])
}

@test
fn oldTimesAndNamesAreRead() throws {
    var options = ZipOptions()
    options.modified = UtcDateTime.of(year: 1970, month: 1, day: 1, hour: 0, minute: 0, second: 1)
    let one = archive { writer throws(IoError) in try writer.add("abcd", [1, 2, 3], options: options) }
    expect((try ZipArchive(one)).entries[0].modified == options.modified)
    // Without the flag of UTF-8, in code page 437; and without the field of
    // the time, as MS-DOS has it.
    var changed = one
    var i = 0
    while i + 4 < changed.count {
        if changed[i] == 0x61 && changed[i + 1] == 0x62 {
            changed[i] = 0x81
            changed[i + 1] = 0xE1
        }
        if changed[i] == 0x55 && changed[i + 1] == 0x54 {
            changed[i] = 0x56
        }
        i += 1
    }
    for at in [7, one.count - 22 - 46 - 4 - 9 + 9] {
        changed[at] = 0
    }
    let read = try ZipArchive(changed)
    expect(read.entries[0].name == "\u{FC}\u{DF}cd", read.entries[0].name)
    expect(read.entries[0].modified == UtcDateTime.of(year: 1980, month: 1, day: 1, hour: 0, minute: 0, second: 0))
    expect((try read.read(read.entries[0])) == [1, 2, 3])
    options.modified = UtcDateTime.of(year: 2200, month: 1, day: 1, hour: 0, minute: 0, second: 0)
    let late = archive { writer throws(IoError) in try writer.add("a", [1], options: options) }
    expect((try ZipArchive(late)).entries[0].modified.year == 2107)
}

@test(tags: ["slow"], timeout: .minutes(5))
fn zip64IsWrittenAndRead() throws {
    // More entries than the end record can count.
    let many = archive { writer throws(IoError) in
        var i = 0
        while i < 66_000 {
            try writer.add("\(i)", [])
            i += 1
        }
    }
    let read = try ZipArchive(many)
    expect(read.entries.count == 66_000 && read.entry(named: "65999") != none)
    // The same with something before it.
    var prefixed = bytes(100)
    prefixed.append(contentsOf: many)
    expect((try ZipArchive(prefixed)).entries.count == 66_000)
}

@test(tags: ["slow"], timeout: .minutes(5))
fn anEntryOfFourGibibytesIsWrittenAndRead() throws {
    // Four gibibytes of zeros, most of them never written anywhere.
    var options = ZipOptions()
    options.isLarge = true
    options.level = 1
    let writer = ZipWriter(MemoryStream())
    try writer.begin("zeros", options: options)
    let zeros = U8[>..](repeating: 0, count: 1 << 24)
    var i = 0
    while i < 257 {
        try writer.write(zeros)
        i += 1
    }
    try writer.end()
    try writer.add("after", [1])
    try writer.finish()
    let large = try ZipArchive(writer.inner.bytes)
    expect(large.entries[0].size == 257 << 24)
    expect((try large.read(large.entry(named: "after")!)) == [1])
}

@test(tags: ["slow"], timeout: .minutes(5))
fn anEntryNotSaidToBeLargeIsNot() throws {
    var options = ZipOptions()
    options.level = 1
    let zeros = U8[>..](repeating: 0, count: 1 << 24)
    let small = ZipWriter(MemoryStream())
    try small.begin("zeros", options: options)
    var i = 0
    while i < 255 {
        try small.write(zeros)
        i += 1
    }
    expectThrows(saying: "a zip entry of 4 GiB or more, which was not said to be large") { _ = try small.write(zeros) }
}

/// Two entries, for a test to damage.
fn twoEntries() -> U8[>..] {
    return archive { writer throws(IoError) in
        try writer.add("first", bytes(3000))
        try writer.add("second", bytes(100, seed: 2))
    }
}

/// Where the central directory of the two is.
fn directoryStart(_ archive: U8[>..]) -> Int => archive.count - 22 - 2 * (46 + 9) - 5 - 6

@test
fn whatIsDamagedIsRefused() throws {
    expectThrows(saying: "the zip archive is corrupt: it has no end record") { _ = try ZipArchive([]) }
    expectThrows(saying: "the zip archive is corrupt: it has no end record") { _ = try ZipArchive(bytes(70_000)) }
}

@test
fn aWrongChecksumIsRefused() throws {
    // The checksum, in the central directory.
    let good = twoEntries()
    let directory = directoryStart(good)
    var changed = good
    changed[directory + 16] = changed[directory + 16] ^ 1
    let bad = try ZipArchive(changed)
    expectThrows(saying: "'first' has another checksum than the archive says") { _ = try bad.read(bad.entries[0]) }
}

@test
fn aWrongSizeIsRefused() throws {
    // Longer, and shorter, than it says.
    let good = twoEntries()
    let directory = directoryStart(good)
    var changed = good
    changed[directory + 24] = changed[directory + 24] - 1
    let longer = try ZipArchive(changed)
    expectThrows(saying: "more would be decompressed than the limits allow") { _ = try longer.read(longer.entries[0]) }
    changed[directory + 24] = changed[directory + 24] + 2
    let shorter = try ZipArchive(changed)
    expectThrows(saying: "'first' is shorter than the archive says") { _ = try shorter.read(shorter.entries[0]) }
}

@test
fn aMethodThatIsNotReadIsRefused() throws {
    // A method that is not read, and an encrypted entry.
    let good = twoEntries()
    let directory = directoryStart(good)
    var changed = good
    changed[directory + 10] = 14
    let other = try ZipArchive(changed)
    expect(other.entries[0].method == .Other(number: 14))
    expectThrows(saying: "'a zip entry, 'first', compressed by method 14' is not supported here") { _ = try other.read(other.entries[0]) }
    changed = good
    changed[directory + 8] = changed[directory + 8] | 1
    let secret = try ZipArchive(changed)
    expect(secret.entries[0].isEncrypted)
    expectThrows(saying: "'an encrypted zip entry, 'first'' is not supported here") { _ = try secret.read(secret.entries[0]) }
}

@test
fn anEntrysHeaderIsItsOwn() throws {
    // Another name, or no header, where the entry is.
    let good = twoEntries()
    var changed = good
    changed[30] = 0x46
    let named = try ZipArchive(changed)
    expectThrows(saying: "the zip archive is corrupt: 'first' is another in its header") { _ = try named.read(named.entries[0]) }
    changed = good
    changed[0] = 0
    let bare = try ZipArchive(changed)
    expectThrows(saying: "the zip archive is corrupt: 'first' has no header") { _ = try bare.read(bare.entries[0]) }
}

@test
fn overlappingEntriesAreRefused() throws {
    // Two entries with the same bytes.
    let good = twoEntries()
    let directory = directoryStart(good)
    var changed = good
    let second = directory + 46 + 9 + 5
    var i = 0
    while i < 4 {
        changed[second + 42 + i] = 0
        i += 1
    }
    expectThrows(saying: "the zip archive is corrupt: its entries overlap") { _ = try ZipArchive(changed) }
    changed[second + 45] = 0x70
    expectThrows(saying: "the zip archive is corrupt: 'second' is not in it") { _ = try ZipArchive(changed) }
}

@test
fn aDamagedDirectoryIsRefused() throws {
    // The directory.
    let good = twoEntries()
    let directory = directoryStart(good)
    var changed = good
    changed[good.count - 22 + 10] = 3
    expectThrows(saying: "the zip archive is corrupt: its central directory is not where it says") { _ = try ZipArchive(changed) }
    changed = good
    changed[directory + 29] = 1
    expectThrows(saying: "the zip archive is corrupt: its central directory ends early") { _ = try ZipArchive(changed) }
    changed = good
    changed[good.count - 22 + 16] = 0xF0
    changed[good.count - 22 + 17] = 0xFF
    expectThrows(saying: "the zip archive is corrupt: its central directory is not where it says") { _ = try ZipArchive(changed) }
    changed = good
    changed[good.count - 22 + 4] = 1
    expectThrows(saying: "'a zip archive in several parts' is not supported here") { _ = try ZipArchive(changed) }
}

// Those that write names in UTF-8, by the number of the system an entry was
// made on, whatever its flags say.
@test(arguments: [3, 19])
fn aNameOfUnixsIsUtf8(_ host: U8) throws {
    var made = archive { writer throws(IoError) in try writer.add("é", [1]) }
    let central = require((0..<made.count - 4).first(where: { made[$0] == 0x50 && made[$0 + 1] == 0x4B && made[$0 + 2] == 1 && made[$0 + 3] == 2 }))
    made[central + 5] = host
    made[central + 9] = 0
    expect(try ZipArchive(made).entries[0].name == "é")
}

@test
fn damageIsNeverMoreThanAnError() {
    let good = archive { writer throws(IoError) in
        try writer.add("first", bytes(300))
        try writer.begin("second")
        try writer.write(bytes(200))
        try writer.end()
        try writer.addSymlink("link", to: "first")
    }
    forAll(byteChanges, Gen<Int>.number(in: 0...9), Gen<Int>.number(in: 0...Int.max), cases: 3000) { (changes: (Int, U8)[>..], cutting: Int, cut: Int) in
        var changed = good
        for (at, byte) in changes {
            changed[at % good.count] = byte
        }
        // One in ten is cut short.
        if cutting == 9 {
            changed.removeLast(cut % good.count)
        }
        if let read = try? ZipArchive(changed) {
            for entry in read.entries {
                _ = try? read.read(entry, limit: 1 << 20)
            }
        }
    }
}

@test
fn directoriesAreArchivedAndExtracted(temp: TemporaryFiles) throws {
    try makeTree(temp.path.appending("in"))
    let path = temp.path.appending("a.zip")
    try Zip.create(path, from: temp.path.appending("in"))
    try Zip.extract(path, to: temp.path.appending("out"))
    expect(try isTree(temp.path.appending("out")))
    let before = (try File.metadata(temp.path.appending("in/a.txt"))).modified
    expect((try File.metadata(temp.path.appending("out/a.txt"))).modified.secondsSinceEpoch == before.secondsSinceEpoch)
    // A second time, nothing is there already.
    expect(problem { try Zip.extract(path, to: temp.path.appending("out")) }.hasSuffix("already"))
    var options = ExtractOptions()
    options.overwrite = true
    try Zip.extract(path, to: temp.path.appending("out"), options: options)
    expect(try isTree(temp.path.appending("out")))
    // Without the times, the permissions and the links.
    options = ExtractOptions()
    options.keepTimes = false
    options.keepPermissions = false
    options.links = .Skipped
    try Zip.extract(path, to: temp.path.appending("plain"), options: options)
    expect(((try File.metadata(temp.path.appending("plain/a.txt"))).permissions.mode & 0o111) == 0)
    expect(!File.exists(temp.path.appending("plain/sub/link")))
    options.links = .Refused
    expectThrows(saying: "a link, 'sub/link', leads to '../a.txt'") { _ = try Zip.extract(path, to: temp.path.appending("none"), options: options) }
}

@test(arguments: ["../up", "a/../../up", "/root", "..", "a/..", "..\\up", "a\\..\\..\\up", "C:\\x", "c:x", "\\x", "a\0b"])
fn nothingIsWrittenOutside(_ name: String) throws {
    let temp = try Temp.directory()
    // Written with another name, and then changed, as the writer refuses
    // some of them.
    let raw = name.utf8Bytes()
    var made = archive { writer throws(IoError) in try writer.add("\u{7E}".repeated(raw.count), [1]) }
    for i in 0...made.count - raw.count {
        // The whole of it: a byte of the time it was written may be the same.
        if made[i..<i + raw.count].allSatisfy({ $0 == 0x7E }) {
            for j in 0..<raw.count {
                made[i + j] = raw[j]
            }
        }
    }
    let read = try ZipArchive(made)
    let said = problem { try read.extract(to: temp.path.appending("out")) }
    expect(said.contains("leads out of the directory"), said)
    expect(try Directory.list(temp.path) == ["out"])
    expect(try Directory.list(temp.path.appending("out")).isEmpty)
}

@test(arguments: ["CON", "a/nul.txt", "com1", "LPT9.x", "a:b", "x?", "x*", "\"x", "a<b", "a>b", "a|b", "dot.", "space ", "a\u{7}", "a\\prn"])
fn aNameWindowsHasNotIsRefused(_ name: String) throws {
    let temp = try Temp.directory()
    var options = ExtractOptions()
    options.portableNames = true
    let made = archive { writer throws(IoError) in try writer.add(name, [1]) }
    let said = problem { try ZipArchive(made).extract(to: temp.path, options: options) }
    expect(said.contains("is none a file may have"), said)
}

@test
fn portableNamesAreWindowsToo(temp: TemporaryFiles) throws {
    var options = ExtractOptions()
    options.portableNames = true
    let good = archive { writer throws(IoError) in
        try writer.add("com0/console/com10.txt", [1])
        try writer.add("a\\b", [2])
        try writer.add("lpt", [3])
    }
    try ZipArchive(good).extract(to: temp.path, options: options)
    expect((try File.readBytes(temp.path.appending("a/b"))) == [2])
    expect((try File.readBytes(temp.path.appending("com0/console/com10.txt"))) == [1])
}

@test
fn anArchiveCutMeanwhileIsAnError(temp: TemporaryFiles) throws {
    let path = temp.path.appending("a.zip")
    var options = ZipOptions()
    options.method = .Store
    try File.writeBytes(path, archive { writer throws(IoError) in try writer.add("a", bytes(100_000), options: options) })
    let read = try ZipArchive.open(path)
    var reader = try read.reader(for: read.entries[0])
    expect(reader.entry.name == "a" && (try reader.read(upTo: 0)).isEmpty && (try reader.read(upTo: 10)).count == 10)
    let file = try File.open(path, options: .appending)
    try file.setLength(5000)
    expectThrows(saying: "the stream ended before what was needed") { _ = try reader.readToEnd() }
}

@test(arguments: ["../secret", "/etc", "a/../../secret", "..", "", "C:\\x", "x/../.."])
fn aLinkOutIsRefused(_ target: String) throws {
    let temp = try Temp.directory()
    try Directory.create(temp.path.appending("secret"))
    let made = archive { writer throws(IoError) in try writer.addSymlink("link", to: target.isEmpty ? "\0" : target) }
    let said = problem { try ZipArchive(made).extract(to: temp.path.appending("out")) }
    expect(said.hasPrefix("a link, 'link', leads to"), said)
}

@test
fn linksAreNoWayOut(temp: TemporaryFiles) throws {
    try Directory.create(temp.path.appending("secret"))
    let here = temp.path.appending("out")
    // A link in the directory, through which nothing is written; and one that
    // was there before.
    let through = archive { writer throws(IoError) in
        try writer.addDirectory("real")
        try writer.addSymlink("link", to: "real")
        try writer.add("link/file", [1])
    }
    expectThrows(saying: "'link' is in the way of an entry: it is no directory, or a link") { _ = try ZipArchive(through).extract(to: here) }
    let there = temp.path.appending("out2")
    try Directory.create(there)
    try File.createSymlink(at: there.appending("link"), to: "../secret")
    let file = archive { writer throws(IoError) in try writer.add("link/file", [1]) }
    expectThrows(saying: "'link' is in the way of an entry: it is no directory, or a link") { _ = try ZipArchive(file).extract(to: there) }
    // In its place, where that is allowed, and not through it.
    let same = archive { writer throws(IoError) in try writer.add("link", [1]) }
    expect(problem { try ZipArchive(same).extract(to: there) }.hasSuffix("already"))
    var options = ExtractOptions()
    options.overwrite = true
    try ZipArchive(same).extract(to: there, options: options)
    expect((try File.metadata(there.appending("link"), followLinks: false)).isFile)
    expect((try Directory.list(temp.path.appending("secret"))).isEmpty)
}

@test
fn aNewFileIsGivenNoOthersRights(temp: TemporaryFiles) throws {
    var bold = ZipOptions()
    bold.mode = 0o6777
    let setuid = archive { writer throws(IoError) in try writer.add("setuid", [1], options: bold) }
    try ZipArchive(setuid).extract(to: temp.path)
    expect(((try File.metadata(temp.path.appending("setuid"))).permissions.mode & 0o7777) == 0o777)
}

@test
fn limitsAreKept(temp: TemporaryFiles) throws {
    let made = archive { writer throws(IoError) in
        try writer.add("zeros", U8[>..](repeating: 0, count: 5_000_000))
        try writer.add("more", U8[>..](repeating: 0, count: 5_000_000))
    }
    let read = try ZipArchive(made)
    var options = ExtractOptions()
    options.overwrite = true
    options.limits.maximumTotal = 9_000_000
    expectThrows(saying: "the archive has more bytes than the limits allow") { _ = try read.extract(to: temp.path, options: options) }
    options.limits.maximumTotal = 10_000_000
    options.limits.maximumEntry = 4_999_999
    expectThrows(saying: "the archive has more bytes than the limits allow") { _ = try read.extract(to: temp.path, options: options) }
    options.limits.maximumEntry = 5_000_000
    options.limits.maximumEntries = 1
    expectThrows(saying: "the archive has more than 1 entries") { _ = try read.extract(to: temp.path, options: options) }
    options.limits.maximumEntries = 2
    try read.extract(to: temp.path, options: options)
}

@test
fn archivesAreChanged(temp: TemporaryFiles) throws {
    let path = temp.path.appending("a.zip")
    try Zip.update(path) { changes in
        changes.set("a", bytes(1000))
        changes.set("b", bytes(2000))
        changes.set("b", bytes(3000))
        changes.set("c", [1])
    }
    try Zip.update(path) { changes in
        changes.remove("a")
        changes.set("c", [2])
        changes.set("d", [3])
    }
    let read = try ZipArchive.open(path)
    expect(read.entries.map { $0.name } == ["b", "c", "d"])
    expect((try read.read(read.entry(named: "b")!)) == bytes(3000))
    expect((try read.read(read.entry(named: "c")!)) == [2])
    expect((try Directory.list(temp.path)) == ["a.zip"])
    // One with descriptors is copied with its sizes before it.
    var streamed = ZipWriter(MemoryStream())
    try streamed.begin("s")
    try streamed.write(bytes(500))
    try streamed.end()
    try streamed.finish(comment: "kept")
    try File.writeBytes(path, streamed.inner.bytes)
    try Zip.update(path) { changes in changes.set("t", [9]) }
    let copied = try ZipArchive.open(path)
    expect(copied.comment == "kept" && (try copied.read(copied.entries[0])) == bytes(500))
}

@test
fn namesAndOptionsAreChecked() {
    let writer = ZipWriter(MemoryStream())
    expect(problem { try writer.add("", []) }.hasSuffix("was given something the system does not take"))
    expect(problem { try writer.add("/a", []) }.hasSuffix("was given something the system does not take"))
    var options = ZipOptions()
    options.method = .Other(number: 5)
    expectThrows(saying: "'a zip entry compressed by another method' is not supported here") { _ = try writer.add("a", [], options: options) }
    expect(problem { try writer.finish(comment: "x".repeated(65_536)) }.hasSuffix("was given something the system does not take"))
}

@test
fn theAsyncWriterToo() async throws {
    let pipe = Pipe(pauseWriterThreshold: 1 << 20)
    let writer = AsyncZipWriter(pipe.writer)
    try await writer.addDirectory("d")
    var options = ZipOptions()
    options.mode = 0o700
    try await writer.addDirectory("e/", options: options)
    try await writer.add("d/a", bytes(1000))
    try await writer.begin("b")
    try await writer.write(bytes(100))
    try await writer.end()
    let source = Pipe()
    try await source.writer.write([1, 2, 3])
    await source.writer.complete()
    try await writer.add("c", reading: source.reader)
    try await writer.finish()
    await pipe.writer.complete()
    var all: U8[>..] = []
    while true {
        let part = try await pipe.reader.read(upTo: 10_000)
        if part.isEmpty {
            break
        }
        all.append(contentsOf: part)
    }
    let read = try ZipArchive(all)
    expect(read.entries.map { $0.name } == ["d/", "e/", "d/a", "b", "c"])
    expect((try read.read(read.entries[2])) == bytes(1000) && (try read.read(read.entries[4])) == [1, 2, 3])
}

@test
fn unzipReadsOurs(temp: TemporaryFiles) async throws {
    let has = await run("unzip", ["-v"], in: temp.path) != none
    try skip(if: !has, "there is no unzip command")
    try makeTree(temp.path.appending("in"))
    try Zip.create(temp.path.appending("ours.zip"), from: temp.path.appending("in"))
    expect(await run("unzip", ["-tq", "ours.zip"], in: temp.path) != none)
    expect(await run("unzip", ["-q", "ours.zip", "-d", "theirs"], in: temp.path) != none)
    expect(try isTree(temp.path.appending("theirs")))
}

@test
fn zipsAreRead(temp: TemporaryFiles) async throws {
    try makeTree(temp.path.appending("in"))
    let made = await run("zip", ["-q", "-r", "-y", "../theirs.zip", "."], in: temp.path.appending("in")) != none
    try skip(if: !made, "there is no zip command")
    try Zip.extract(temp.path.appending("theirs.zip"), to: temp.path.appending("out"))
    expect(try isTree(temp.path.appending("out")))
}
