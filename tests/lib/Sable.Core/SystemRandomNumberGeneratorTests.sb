module SystemRandomNumberGeneratorTests

// SystemRandomNumberGenerator (Sable.Core): the operating system's random
// bits. What they are cannot be tested; that they vary, and are spread
// over all 64 bits, can.

import Sable.Testing

@test
fn drawsDiffer() {
    var system = SystemRandomNumberGenerator()
    let first = system.next()
    var differed = false
    var i = 0
    while i < 8 {
        if system.next() != first {
            differed = true
        }
        i += 1
    }
    assert(differed)
}

@test
fn everyBitIsSometimesSetAndSometimesClear() {
    var system = SystemRandomNumberGenerator()
    var everSet: U64 = 0
    var everClear: U64 = 0
    var i = 0
    while i < 200 {
        let bits = system.next()
        everSet = everSet | bits
        everClear = everClear | ~bits
        i += 1
    }
    assert(everSet == U64.max)
    assert(everClear == U64.max)
}

@test
fn twoGeneratorsDoNotRepeatEachOther() {
    var a = SystemRandomNumberGenerator()
    var b = SystemRandomNumberGenerator()
    assert(a.next() != b.next() || a.next() != b.next())
}

@test
fn fillGivesEveryByteRandomBits() {
    var system = SystemRandomNumberGenerator()
    // Past the 256 bytes getentropy gives at once.
    var bytes = U8[>..](repeating: 0, count: 1000)
    var everSet = bytes
    for _ in 0..<64 {
        system.fill(bytes: &bytes)
        for i in 0..<1000 {
            everSet[i] = everSet[i] | bytes[i]
        }
    }
    assert(everSet == U8[>..](repeating: 0xFF, count: 1000))
}

@test
fn fillOfASliceChangesThatRangeAlone() {
    var system = SystemRandomNumberGenerator()
    var bytes = U8[>..](repeating: 0, count: 48)
    let before = bytes
    system.fill(bytes: &bytes[16..<32])
    assert(bytes[..<16] == before[..<16] && bytes[32...] == before[32...])
    assert(bytes != before && before == U8[>..](repeating: 0, count: 48))
    var nothing: U8[>..] = []
    system.fill(bytes: &nothing)
    assert(nothing.isEmpty)
}
