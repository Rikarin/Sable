module RegexPathological

// Regex against .NET 11's System.Text.RegularExpressions: (a|aa)+ on lines
// of twenty 'a's and a '!', which no line matches — time exponential in a
// line's length for a backtracker, .NET's RegexOptions.Compiled among them
// (regex-pathological), and linear for an automaton, as Sable's is and as
// .NET's NonBacktracking is (regex-pathological/nonbacktracking).

import Sable.Text

@main
fn main() {
    var lines: String[>..] = []
    var i = 0
    while i < 100 {
        lines.append("aaaaaaaaaaaaaaaaaaaa!\n")
        i = i + 1
    }
    let text = lines.joined()
    let regex = try! Regex("(?m)^(a|aa)+$")
    var count = 0
    var round = 0
    while round < 10 {
        count = count + regex.count(in: text)
        round = round + 1
    }
    print("\(count) \(text.utf8Count)")
}
