module WaitListTests

// WaitList (Sable.Core), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

actor Gate {
    var isOpen = false
    var passed = 0
    let opened = WaitList()

    fn pass() async -> Int {
        while !isOpen {
            await opened.park()
        }
        passed += 1
        return passed
    }

    fn openUp() {
        isOpen = true
        opened.wakeAll()
    }

    fn nudge() {
        opened.wakeAll()
    }
}

@test
fn aParkedTaskGoesOnOnceWoken() async {
    let gate = Gate()
    let waiting = Task.spawn { await gate.pass() }
    await Task.yield()
    await gate.openUp()
    assertEqual(await waiting.value, 1)
}

@test
fn everyParkedTaskIsWoken() async {
    let gate = Gate()
    var waiting: Task<Int>[>..] = []
    for _ in 0..<5 {
        waiting.append(Task.spawn { await gate.pass() })
    }
    await gate.openUp()
    var total = 0
    for task in waiting {
        total += await task.value
    }
    assertEqual(total, 15)
}

@test
fn aTaskWokenTooSoonParksAgain() async {
    let gate = Gate()
    let waiting = Task.spawn { await gate.pass() }
    await Task.yield()
    await gate.nudge()
    await Task.yield()
    await gate.openUp()
    assertEqual(await waiting.value, 1)
}

@test
fn wakingAListNoTaskIsParkedInDoesNothing() async {
    let gate = Gate()
    await gate.nudge()
    await gate.openUp()
    assertEqual(await gate.pass(), 1)
}

actor Mailbox {
    var letters: Int[>..] = []
    let arrived = WaitList()

    fn take() async -> Int? {
        while letters.isEmpty {
            if Task.isCancelled {
                return none
            }
            await arrived.parkCancellably()
        }
        return letters.removeLast()
    }

    fn post(_ letter: Int) {
        letters.append(letter)
        arrived.wakeAll()
    }
}

@test
fn aCancellableParkEndsWithAWake() async {
    let mailbox = Mailbox()
    let reader = Task.spawn { await mailbox.take() }
    await Task.yield()
    await mailbox.post(3)
    assert(await reader.value == 3)
}

@test
fn aCancellableParkEndsWithTheTasksCancellation() async {
    let mailbox = Mailbox()
    let reader = Task.spawn { await mailbox.take() }
    for _ in 0..<10 {
        await Task.yield()
    }
    reader.cancel()
    assert(await reader.value == none)
}

@test
fn aCancelledTaskDoesNotParkCancellably() async {
    let list = WaitList()
    let task = Task.spawn {
        while !Task.isCancelled {
            await Task.yield()
        }
        await list.parkCancellably()
        await list.parkCancellably(since: list.ticket)
        return true
    }
    task.cancel()
    assert(await task.value)
}

@test
fn eachWakeMovesTheTicketOn() {
    let list = WaitList()
    let first = list.ticket
    list.wakeAll()
    assertEqual(list.ticket, first + 1)
    list.wakeAll()
    assertEqual(list.ticket, first + 2)
}

@test
fn aParkSinceAnOldTicketGoesOnAtOnce() async {
    let list = WaitList()
    let ticket = list.ticket
    list.wakeAll()
    // Woken since the ticket: no park, so nothing need wake it.
    await list.parkCancellably(since: ticket)
}

@test
fn aParkSinceTheCurrentTicketWaitsForTheNextWake() async {
    let list = WaitList()
    let woken = Atomic(false)
    let ticket = list.ticket
    let waiter = Task.spawn {
        await list.parkCancellably(since: ticket)
        woken.store(true)
    }
    for _ in 0..<10 {
        await Task.yield()
    }
    // One wake is enough: the waiter may not have parked yet, and a wake
    // before its park is one it sees by its ticket.
    list.wakeAll()
    await waiter.value
    assert(woken.load())
}

@test
fn aParkSinceAnOldTicketGoesOnAtOnceAfterOneIsWoken() async {
    let list = WaitList()
    let ticket = list.ticket
    list.wakeOne()
    await list.park(since: ticket)
}

@test
fn wakingOneWakesTheFirstParked() async {
    let list = WaitList()
    let woken = Atomic(0)
    let first = Task.spawn {
        await list.park()
        let _ = woken.add(1)
    }
    await Task.settle()
    let second = Task.spawn {
        await list.park()
        let _ = woken.add(1)
    }
    await Task.settle()
    list.wakeOne()
    await first.value
    await Task.settle()
    assertEqual(woken.load(), 1)
    list.wakeOne()
    await second.value
    assertEqual(woken.load(), 2)
}
