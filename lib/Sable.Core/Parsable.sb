module Sable.Core

/// Values that can be read back from text: Rust's `FromStr`, .NET's
/// `IParsable`. What `parse` takes is what the type's `Formattable` writes
/// with nothing said, so `T.parse("\(x)")` is `x` again. The text is a
/// String or a Substring of one, read where it lies: a piece of a larger
/// text parses without being copied out of it.
///
/// ```sable
/// let n = try! Int.parse("-42")
/// assert(n == -42)
/// let b: Bool = try! "true".parse()
/// assert(b)
/// let line = "x=17"
/// assert(try! Int.parse(line[line.index(atScalar: 2)...]) == 17)
/// ```
public protocol Parsable {
    /// The value the whole text writes, or why it is not one.
    static fn parse<S: StringProtocol>(_ text: S) throws(ParseError) -> Self
}
