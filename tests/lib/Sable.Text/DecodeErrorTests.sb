module DecodeErrorTests

// DecodeError and Padding (Sable.Text), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Testing
import Sable.Text

@test(arguments: [
    (.InvalidCharacter(at: 1, byte: 0x2A), 1),
    (.InvalidLength(at: 2), 2),
    (.InvalidPadding(at: 3), 3),
    (.TrailingBits(at: 4), 4),
])
fn eachCaseNamesItsOffset(_ error: DecodeError, _ offset: Int) {
    assertEqual(error.offset, offset)
}

@test(arguments: [
    (.InvalidCharacter(at: 3, byte: 0x2A), "invalid character 0x2A at 3"),
    (.InvalidLength(at: 4), "the text ends partway through the group at 4"),
    (.InvalidPadding(at: 5), "invalid padding at 5"),
    (.TrailingBits(at: 6), "the digit at 6 has bits the bytes do not use"),
])
fn eachCaseDescribesWhatIsWrongAndWhere(_ error: DecodeError, _ text: String) {
    assertEqual(error.description(), text)
}

@test(arguments: [
    (.InvalidCharacter(at: 3, byte: 42), "DecodeError.InvalidCharacter(at: 3, byte: 42)"),
    (.InvalidLength(at: 4), "DecodeError.InvalidLength(at: 4)"),
    (.InvalidPadding(at: 5), "DecodeError.InvalidPadding(at: 5)"),
    (.TrailingBits(at: 6), "DecodeError.TrailingBits(at: 6)"),
])
fn debugWritesTheCaseAsSourceDoes(_ error: DecodeError, _ text: String) {
    assertEqual(error.debugDescription(), text)
}

@test
fn errorsAreEqualByCaseAndFields() {
    expect(DecodeError.InvalidCharacter(at: 1, byte: 2) == .InvalidCharacter(at: 1, byte: 2))
    expect(DecodeError.InvalidCharacter(at: 1, byte: 2) != .InvalidCharacter(at: 1, byte: 3))
    expect(DecodeError.InvalidLength(at: 1) == .InvalidLength(at: 1))
    expect(DecodeError.InvalidLength(at: 1) != .InvalidPadding(at: 1))
    expect(DecodeError.InvalidPadding(at: 1) == .InvalidPadding(at: 1))
    expect(DecodeError.TrailingBits(at: 1) == .TrailingBits(at: 1))
    expect(DecodeError.TrailingBits(at: 1) != .TrailingBits(at: 2))
}

@test
fn paddingRulesAreDistinct() {
    expect(Padding.Required != Padding.Either && Padding.Either != Padding.Forbidden)
}
