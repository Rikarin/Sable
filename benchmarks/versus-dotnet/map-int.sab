module MapInt

// HashMap<Int, Int> against .NET's Dictionary<long, long>: a million
// pseudo-random keys inserted, looked up three times over, missed, half
// removed and looked up again. ../dotnet/Program.cs does the same, step for
// step, and prints the same line.

import Sable.Collections

@main
fn main() {
    let n = 1000000
    var keys: Int[>..] = []
    var x = 12345
    var i = 0
    while i < n {
        x = (x * 1103515245 + 12345) % 2147483648
        keys.append(x)
        i = i + 1
    }

    let map = HashMap<Int, Int>()
    i = 0
    while i < n {
        map.set(keys[i], i)
        i = i + 1
    }

    var sum = 0
    var round = 0
    while round < 3 {
        for key in keys {
            sum = sum + (map.get(key) ?? 0)
        }
        round = round + 1
    }

    var misses = 0
    i = 0
    while i < n {
        if !map.contains(keys[i] + 2147483648) {
            misses = misses + 1
        }
        i = i + 1
    }

    i = 0
    while i < n {
        map.remove(keys[i])
        i = i + 2
    }

    var hits = 0
    for key in keys {
        if map.contains(key) {
            hits = hits + 1
        }
    }

    print("\(map.count) \(sum) \(misses) \(hits)")
}
