module StreamTests

// Reader, Writer, BufferedReader, BufferedWriter, MemoryStream, TextReader
// and TextWriter (Sable.IO), over memory: against models, with reads that
// give a few bytes at a time so that every boundary is crossed.

import IoSupport
import Sable.IO
import Sable.Testing

/// A reader that gives at most a few bytes a read: what a pipe or a socket
/// may do.
struct Trickle: Reader {
    var bytes: U8[>..]
    var position: Int
    var sizes: Int[>..]
    var reads: Int

    mutating fn read(upTo count: Int) throws(IoError) -> U8[>..] {
        if position >= bytes.count {
            return []
        }
        let most = sizes[reads % sizes.count]
        reads += 1
        let take = most < count ? most : count
        let end = position + take < bytes.count ? position + take : bytes.count
        let got = bytes[position..<end].toArray()
        position = end
        return got
    }
}

fn trickle(_ bytes: U8[>..], _ sizes: Int[>..] = [3, 1, 5, 2, 4, 1, 1]) -> Trickle {
    return Trickle { bytes: bytes, position: 0, sizes: sizes, reads: 0 }
}

/// How many bytes each read gives.
let readSizes: Gen<Int[>..]> = Gen<Int>.number(in: 1...5).array(count: 1...8)

/// Text's lines, each with its ending; the last may have none.
let endedLines: Gen<(String, String)[>..]> = Gen<String>.string(of: Gen.element(of: ['a', 'b', 'z', 'é']), count: 0...19)
    .zip(Gen.element(of: ["\n", "\r\n"]))
    .array(count: 0...11)

@test
fn bufferedLinesAgreeWithSplittingTheText() {
    forAll(endedLines.zip(Gen<Bool>.arbitrary(Bool.self)), readSizes, Gen<Int>.number(in: 1...8), cases: 200) { (lines: ((String, String)[>..], Bool), sizes: Int[>..], capacity: Int) in
        var text = ""
        var expected: String[>..] = []
        for (line, ending) in lines.0 {
            text += line + ending
            expected.append(line)
        }
        if lines.1, let last = lines.0.last {
            // Its ending left out; and an empty line with no ending is none.
            text = text.trimmingSuffix(last.1)
            if last.0.isEmpty {
                expected.removeLast()
            }
        }
        var reader = BufferedReader(trickle(text.utf8Bytes(), sizes), capacity: capacity)
        var got: String[>..] = []
        while let line = try reader.readLine() {
            got.append(line)
        }
        expect(got == expected)
    }
}

@test
fn bufferedReadsAndRunsGiveEveryByteInOrder() {
    forAll(Gen<U8>.arbitrary(U8.self).array(count: 0...800), readSizes, Gen<Int>.number(in: 1...200).array(count: 1...10), cases: 30) { (bytes: U8[>..], sizes: Int[>..], asked: Int[>..]) in
        var reader = BufferedReader(trickle(bytes, sizes), capacity: 64)
        var got: U8[>..] = []
        var reads = 0
        while true {
            let chunk = try reader.read(upTo: asked[reads % asked.count])
            if chunk.isEmpty {
                break
            }
            got.append(contentsOf: chunk)
            reads += 1
        }
        expect(got == bytes)
        var whole = trickle(bytes, sizes)
        expect(try whole.readToEnd() == bytes)
    }
}

@test
fn readingUntilAByteGivesItToo() throws {
    var runs = BufferedReader(MemoryStream([1, 0, 2, 3, 0, 4]), capacity: 2)
    assertEqual(try runs.readUntil(0), [1, 0])
    assertEqual(try runs.readUntil(0), [2, 3, 0])
    assertEqual(try runs.readUntil(0), [4])
    expect(try runs.readUntil(0).isEmpty)
    expect(try runs.readLine() == none)
}

@test
fn readingExactlyIsAllOrAnError() throws {
    var exact = trickle(pattern(5000))
    assertEqual(try exact.readExactly(1000), pattern(1000))
    expectIoError("UnexpectedEof") { _ = try exact.readExactly(10000) }
}

@test
fn aReadLargerThanTheBufferIsGivenWhole() throws {
    var big = BufferedReader(MemoryStream(pattern(5000)), capacity: 16)
    assertEqual(try big.read(upTo: 4096), pattern(4096))
}

@test
fn linesAreASequence() throws {
    var seen: String[>..] = []
    for try line in BufferedReader(MemoryStream("x\ny\n".utf8Bytes())).lines() {
        seen.append("\(line)")
    }
    expect(seen == ["x", "y"])
}

@test
fn aBufferedWriterWritesEverythingInOrder() {
    forAll(Gen<U8>.arbitrary(U8.self).array(count: 0...120).array(count: 0...20), cases: 50) { (chunks: U8[>..][>..]) in
        let writer = BufferedWriter(MemoryStream(), capacity: 50)
        var expected: U8[>..] = []
        for chunk in chunks {
            try writer.write(chunk)
            expected.append(contentsOf: chunk)
        }
        try writer.flush()
        expect(writer.inner.bytes == expected)
    }
}

@test
fn aMemoryStreamReadsWritesAndSeeks() throws {
    var stream = MemoryStream([1, 2, 3])
    assertEqual(try stream.read(upTo: 2), [1, 2])
    try stream.write([9, 9])
    assertEqual(stream.bytes, [1, 2, 9, 9])
    try stream.seek(6, from: .Start)
    try stream.write([7])
    assertEqual(stream.bytes, [1, 2, 9, 9, 0, 0, 7])
    assertEqual(try stream.seek(-1, from: .End), 6)
    assertEqual(try stream.seek(-6, from: .Current), 0)
    expectIoError("InvalidInput", "seeked before the start") {
        try stream.seek(-1, from: .Start)
    }
    expect(try stream.read(upTo: 0).isEmpty)
    try stream.flush()
    assertEqual(try stream.readExactly(3), [1, 2, 9])
    expectIoError("UnexpectedEof", "read past the end") {
        _ = try stream.readExactly(10)
    }

    var source = MemoryStream([5, 6, 7])
    var target = MemoryStream()
    assertEqual(try copy(from: &source, to: &target), 3)
    assertEqual(target.bytes, [5, 6, 7])
}

let encodings: TextEncoding[>..] = [.Utf8, .Utf16LittleEndian, .Utf16BigEndian]

@test(arguments: encodings)
fn textRoundTripsThroughEveryEncoding(_ encoding: TextEncoding) throws {
    var writer = TextWriter(MemoryStream(), encoding: encoding)
    try writer.write("Grüße, мир 😀\r\n")
    try writer.writeLine("second line")
    try writer.write("third")
    try writer.flush()
    var whole = TextReader(trickle(writer.inner.bytes), encoding: encoding)
    assertEqual(try whole.readToEnd(), "Grüße, мир 😀\r\nsecond line\nthird")
    var lines = TextReader(trickle(writer.inner.bytes, [1, 4, 2]), encoding: encoding)
    assertEqual(try lines.readLine(), "Grüße, мир 😀")
    assertEqual(try lines.readLine(), "second line")
    assertEqual(try lines.readLine(), "third")
    expect(try lines.readLine() == none)
}

@test
fn latin1HasAQuestionMarkForWhatItHasNot() throws {
    var latin = TextWriter(MemoryStream(), encoding: .Latin1)
    try latin.write("café 😀")
    assertEqual(latin.inner.bytes, [99, 97, 102, 233, 32, 63])
    var back = TextReader(MemoryStream(latin.inner.bytes), encoding: .Latin1)
    assertEqual(try back.readToEnd(), "café ?")
}

@test
fn whatIsIllFormedIsReadAsAReplacement() throws {
    // Half a UTF-16 code unit at the end, and ill-formed UTF-8, read as U+FFFD.
    var odd = TextReader(MemoryStream([0x68, 0x00, 0x69]), encoding: .Utf16LittleEndian)
    assertEqual(try odd.readToEnd(), "h\u{FFFD}")
    var bad = TextReader(MemoryStream([0x61, 0xFF]))
    assertEqual(try bad.readToEnd(), "a\u{FFFD}")
}

@test
fn anEmptyStreamHasNoText() throws {
    var empty = TextReader(MemoryStream())
    expect(try empty.readLine() == none)
    assertEqual(try empty.read(), "")
}
