module TextTests

// Sable.Text's functions on strings, tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Text
import Sable.Testing

@test
fn parsingIntegers() {
    assertEqual(parseInt("-42") ?? 0, -42)
    assertEqual(parseInt("ff", radix: 16) ?? 0, 255)
    assert(parseInt("4x") == none)
}

@test
fn escapingHtml() {
    assertEqual(escapedHtml("<a href=\"x\">&</a>"), "&lt;a href=&quot;x&quot;&gt;&amp;&lt;/a&gt;")
}

@test
fn escapingEachCharacter() {
    assertEqual(escapedHtml("plain"), "plain")
    assertEqual(escapedHtml("'"), "&#39;")
    assertEqual(escapedHtml(">"), "&gt;")
    assertEqual(escapedHtml("\"x\""), "&quot;x&quot;")
}

@test
fn integersInEveryRadixAndSign() {
    assertEqual(parseInt("+7") ?? 0, 7)
    assertEqual(parseInt("Zz", radix: 36) ?? 0, 1295)
    assertEqual(parseInt("10", radix: 99) ?? 0, 10)
    assert(parseInt("") == none && parseInt("-") == none, "no digits")
    assert(parseInt("9223372036854775808") == none, "too big")
    assertEqual(parseInt("-9223372036854775808") ?? 0, -9223372036854775807 - 1)
    assert(parseInt("99999999999999999999") == none, "far too big")
    assert(parseInt("1!") == none, "not a digit")
}
