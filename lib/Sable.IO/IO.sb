module Sable.IO

// Files, directories, paths and the standard streams (docs/04 §4.3), written
// in Sable over the runtime's calls (Sable.Core's Runtime).

/// Why a file or directory could not be read, written or changed.
public union IoError {
    NotFound(path: String),
    Failed(path: String),
}

/// Whole files, read and written at once.
public struct File {
    /// The file's contents.
    public static fn read(_ path: String) throws(IoError) -> String {
        if let text = Runtime.readFile(path) {
            return text
        }
        if !Runtime.fileExists(path) {
            throw IoError.NotFound(path: path)
        }
        throw IoError.Failed(path: path)
    }

    /// The file's lines, without their endings; a last empty line is not one.
    public static fn readLines(_ path: String) throws(IoError) -> String[>..] {
        let text = try File.read(path)
        var lines: String[>..] = []
        if text.count == 0 {
            return lines
        }
        for line in text.split('\n') {
            lines.append(withoutReturn(line))
        }
        if lines.count > 0 && lines[lines.count - 1].count == 0 {
            lines.removeLast()
        }
        return lines
    }

    /// Replaces the file's contents, making it if it is not there.
    public static fn write(_ path: String, _ text: String) throws(IoError) {
        if !Runtime.writeFile(path, text, false) {
            throw IoError.Failed(path: path)
        }
    }

    /// Adds to the end of the file, making it if it is not there.
    public static fn append(_ path: String, _ text: String) throws(IoError) {
        if !Runtime.writeFile(path, text, true) {
            throw IoError.Failed(path: path)
        }
    }

    public static fn exists(_ path: String) -> Bool {
        return Runtime.fileExists(path) && !Runtime.isDirectory(path)
    }

    public static fn remove(_ path: String) throws(IoError) {
        if !File.exists(path) {
            throw IoError.NotFound(path: path)
        }
        if !Runtime.removeFile(path) {
            throw IoError.Failed(path: path)
        }
    }
}

public struct Directory {
    public static fn exists(_ path: String) -> Bool {
        return Runtime.isDirectory(path)
    }

    /// Makes the directory; its parent must be there already.
    public static fn create(_ path: String) throws(IoError) {
        if !Runtime.makeDirectory(path) {
            throw IoError.Failed(path: path)
        }
    }

    /// The names of what the directory holds, sorted.
    public static fn list(_ path: String) throws(IoError) -> String[>..] {
        if let names = Runtime.listDirectory(path) {
            return names
        }
        if !Runtime.fileExists(path) {
            throw IoError.NotFound(path: path)
        }
        throw IoError.Failed(path: path)
    }

    /// Removes the directory, which must be empty.
    public static fn remove(_ path: String) throws(IoError) {
        if !Runtime.isDirectory(path) {
            throw IoError.NotFound(path: path)
        }
        if !Runtime.removeFile(path) {
            throw IoError.Failed(path: path)
        }
    }
}

/// Paths as text, with '/' between their parts — on Windows, '\' too.
public struct Path {
    /// The two paths, one inside the other; an absolute second one stands alone.
    public static fn join(_ first: String, _ second: String) -> String {
        if first.count == 0 || isAbsolute(second) {
            return second
        }
        if isSeparator(first.at(first.count - 1)) {
            return first + second
        }
        return first + "/" + second
    }

    /// The last part: what follows the last '/'.
    public static fn fileName(_ path: String) -> String {
        let slash = lastSeparator(path)
        if slash < 0 {
            return path
        }
        return path.slice(slash + 1, path.count)
    }

    /// Everything before the last part; "." for a bare name, "/" at the root.
    public static fn directory(_ path: String) -> String {
        let slash = lastSeparator(path)
        if slash < 0 {
            return "."
        }
        if slash == 0 {
            return "/"
        }
        return path.slice(0, slash)
    }

    /// What follows the last part's last '.', when it has one not at its start.
    public static fn extension(_ path: String) -> String? {
        let name = Path.fileName(path)
        let dot = lastIndex(name, '.')
        if dot <= 0 {
            return none
        }
        return name.slice(dot + 1, name.count)
    }

    /// The path without its extension.
    public static fn withoutExtension(_ path: String) -> String {
        let name = Path.fileName(path)
        let dot = lastIndex(name, '.')
        if dot <= 0 {
            return path
        }
        return path.slice(0, path.count - (name.count - dot))
    }
}

/// Standard input, output and error.
public struct Console {
    public static fn write(_ text: String) {
        Runtime.write(text)
    }

    public static fn writeLine(_ text: String) {
        Runtime.write(text + "\n")
    }

    public static fn writeError(_ text: String) {
        Runtime.writeError(text)
    }

    public static fn writeErrorLine(_ text: String) {
        Runtime.writeError(text + "\n")
    }

    /// The next line of input, without its ending; none once input ends.
    public static fn readLine() -> String? {
        return Runtime.readLine()
    }

    /// Every line left in the input.
    public static fn readLines() -> String[>..] {
        var lines: String[>..] = []
        while let line = Runtime.readLine() {
            lines.append(line)
        }
        return lines
    }
}

/// What the program was started with.
public struct Environment {
    /// The value of an environment variable, when it is set.
    public static fn variable(_ name: String) -> String? {
        return Runtime.environment(name)
    }

    /// The program's arguments, after its own name.
    public static fn arguments() -> String[>..] {
        var all: String[>..] = []
        var i = 0
        while i < Runtime.argumentCount() {
            all.append(Runtime.argument(i))
            i += 1
        }
        return all
    }
}

/// What separates a path's parts: '/', and on Windows '\' as well.
fn isSeparator(_ c: Char) -> Bool {
    #if os(windows)
    return c == '/' || c == '\\'
    #else
    return c == '/'
    #endif
}

/// A path from the root: '/…', and on Windows 'C:…' or '\…' as well.
fn isAbsolute(_ path: String) -> Bool {
    if path.count == 0 {
        return false
    }
    #if os(windows)
    return isSeparator(path.at(0)) || path.count > 1 && path.at(1) == ':'
    #else
    return path.at(0) == '/'
    #endif
}

fn lastSeparator(_ text: String) -> Int {
    var i = text.count - 1
    while i >= 0 {
        if isSeparator(text.at(i)) {
            return i
        }
        i -= 1
    }
    return -1
}

fn lastIndex(_ text: String, _ wanted: Char) -> Int {
    var i = text.count - 1
    while i >= 0 {
        if text.at(i) == wanted {
            return i
        }
        i -= 1
    }
    return -1
}

fn withoutReturn(_ line: String) -> String {
    if line.count > 0 && line.at(line.count - 1) == '\r' {
        return line.slice(0, line.count - 1)
    }
    return line
}
