module Sable.Core

/// A string made by appending to its end, written where it will be: a
/// StringBuffer, with how much of it is used, that grows as it must. Appends
/// are safe. Making one and finishing it are not: it has one owner, which
/// finishes it once and uses no copy of it, and what is appended must come
/// to well-formed UTF-8.
///
/// ```sable
/// unsafe {
///     var writer = StringWriter.allocate(capacity: 4)
///     writer.append(utf8: "caf", from: 0, to: 3)
///     writer.append(codePoint: 0xE9)
///     assert(writer.finish() == "café")
/// }
/// ```
public struct StringWriter {
    var buffer: StringBuffer

    /// How many bytes have been appended.
    public internal(set) var count: Int

    /// Nothing yet, with room for 'capacity' bytes before it grows.
    public unsafe static fn allocate(capacity: Int) -> StringWriter {
        return StringWriter { buffer: StringBuffer.allocate(capacity: capacity + 8), count: 0 }
    }

    /// Room made for 'more' bytes past those appended, and eight.
    @inline(always)
    mutating fn makeRoom(_ more: Int) {
        if count + more > buffer.capacity - 8 {
            buffer = StringWriter.grown(buffer, count, more)
        }
    }

    // Out of line and by value, so that a writer stays in registers.
    @inline(never)
    static fn grown(_ buffer: StringBuffer, _ count: Int, _ more: Int) -> StringBuffer {
        unsafe {
            return buffer.growing(used: count, capacity: count + more + 8)
        }
    }

    /// One byte.
    @inline(always)
    public mutating fn append(byte: U8) {
        self.makeRoom(1)
        buffer.store(byte, at: count)
        count += 1
    }

    /// The word's lowest 'length' bytes, at most eight, the lowest first.
    @inline(always)
    public mutating fn append(word: U64, length: Int) {
        if !(length >= 0 && length <= 8) {
            stringIndexOutOfRange()
        }
        self.makeRoom(length)
        buffer.store(word, at: count)
        count += length
    }

    /// The UTF-8 of a code point, which must be a scalar's.
    @inline(always)
    public mutating fn append(codePoint code: Int) {
        self.makeRoom(4)
        if code < 0x80 {
            buffer.store(code unchecked as U64, at: count)
            count += 1
        } else if code < 0x800 {
            buffer.store((0x80C0 | code >> 6 | (code & 0x3F) << 8) unchecked as U64, at: count)
            count += 2
        } else if code < 0x10000 {
            buffer.store((0x8080E0 | code >> 12 | (code >> 6 & 0x3F) << 8 | (code & 0x3F) << 16) unchecked as U64, at: count)
            count += 3
        } else {
            buffer.store((0x808080F0 | code >> 18 | (code >> 12 & 0x3F) << 8 | (code >> 6 & 0x3F) << 16 | (code & 0x3F) << 24) unchecked as U64, at: count)
            count += 4
        }
    }

    /// The text's bytes from one offset up to another.
    @inline(always)
    public mutating fn append(utf8 text: String, from start: Int, to end: Int) {
        let length = end - start
        self.makeRoom(length)
        // A short run, of a text with eight bytes to read, as a word.
        if length >= 0 && length <= 8 && start >= 0 && start <= text.utf8Count - 8 {
            buffer.store(text.utf8Word(start), at: count)
        } else {
            buffer.store(utf8: text, from: start, to: end, at: count)
        }
        count += length
    }

    /// A byte that has been appended.
    public fn byte(at offset: Int) -> U8 {
        if !(offset >= 0 && offset < count) {
            stringIndexOutOfRange()
        }
        unsafe {
            return buffer.load(at: offset)
        }
    }

    /// What was appended after the first 'length' bytes taken back; they
    /// must end between scalars.
    public mutating fn truncate(to length: Int) {
        if !(length >= 0 && length <= count) {
            stringIndexOutOfRange()
        }
        count = length
    }

    /// The last scalar appended, taken back: its code point, or none when
    /// nothing has been.
    public mutating fn removeLastScalar() -> Int? {
        if count == 0 {
            return none
        }
        var code = 0
        var shift = 0
        while true {
            count -= 1
            var byte = 0
            unsafe {
                byte = Int(buffer.load(at: count))
            }
            if byte < 0x80 {
                return byte
            }
            if byte >= 0xC0 {
                // A lead byte's own bits: five, four or three of them.
                return code | (byte & (0x3F >> (shift / 6))) << shift
            }
            code |= (byte & 0x3F) << shift
            shift += 6
        }
        return none
    }

    /// What has been appended, as a string: the writer is done with.
    public unsafe fn finish() -> String {
        return buffer.finish(count: count)
    }

    /// What has been appended, as a string, if it is well-formed UTF-8, or
    /// none: the writer is done with either way.
    public unsafe fn finishIfValid() -> String? {
        return buffer.finishIfValid(count: count)
    }

    /// The room given back, nothing made of it: the writer is done with.
    public unsafe fn discard() {
        buffer.discard()
    }
}
