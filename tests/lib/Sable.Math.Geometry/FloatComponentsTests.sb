module FloatComponentsTests

// Arrays of vectors as the floats and the bytes they are, and nearEqual.

import Sable.Math.Geometry
import Sable.Testing

/// Says it is three floats and is four.
struct Padded: FloatComponents {
    var x: F32
    var y: F32
    var z: F32
    var w: F32

    static var componentCount: Int => 3

    fn toArray() -> F32[>..] => [x, y, z]
}

@test
fn anArrayOfVectorsIsViewedAsItsFloats() {
    let points = [Vector3(1, 2, 3), Vector3(4, 5, 6)]
    let floats = points.components
    expect(floats.count == 6)
    expect(floats.toArray() == [1, 2, 3, 4, 5, 6])
    expect(points[1..<2].components.toArray() == [4, 5, 6])
    expect(([] as Vector3[>..]).components.count == 0)
    expect([Matrix4x4.identity].components.count == 16)
    expect([Matrix3x2.identity, Matrix3x2.identity].components.count == 12)
    expect([Plane(Vector3.up, 4)].components.toArray() == [0, 1, 0, 4])
}

@test
fn theViewIsTheSameBufferAndBack() {
    let points = [Vector3(1, 2, 3), Vector3(4, 5, 6)]
    let before = Runtime.allocationCount()
    let again = points.components.reinterpreted(as: Vector3.self)
    let made = Runtime.allocationCount() - before
    expect(made == 0)
    expect(again == points[0...])
}

@test
fn anArrayOfVectorsIsViewedAsItsBytes() {
    expect([Vector2(1, -2)].bytes.toArray() == [0, 0, 0x80, 0x3F, 0, 0, 0, 0xC0])
}

@test
fn itsFloatsAreWrittenWhereTheyLie() {
    var points = [Vector3(1, 2, 3), Vector3(4, 5, 6)]
    let before = points
    points.withMutableComponents { floats in
        floats[4] = 50
    }
    expect(points[1] == Vector3(4, 50, 6))
    expect(before[1] == Vector3(4, 5, 6))
    points.reinterpreted(as: F32.self)[0] = -1
    expect(points[0] == Vector3(-1, 2, 3))
}

@test
fn aTypeThatIsNotWhatItSaysIsRefused() {
    expectPanic("a FloatComponents type of 3 components that takes 16 bytes") {
        _ = [Padded { x: 1, y: 2, z: 3, w: 4 }].components.count
    }
}

@test
fn nearEqualIsAbsoluteNearZeroAndRelativeFurtherOut() {
    expect(nearEqual(0 as F32, 0.0000005 as F32))
    expect(!nearEqual(0 as F32, 0.000002 as F32))
    expect(nearEqual(1_000_000 as F32, 1_000_000.5 as F32))
    expect(!nearEqual(1_000_000 as F32, 1_000_002 as F32))
    expect(nearEqual(F32.infinity, F32.infinity) && !nearEqual(F32.infinity, -F32.infinity) && !nearEqual(F32.infinity, 1 as F32))
    expect(!nearEqual(F32.nan, F32.nan))
    expect(nearEqual(1 as F64, 1.0000000000005 as F64) && !nearEqual(1 as F64, 1.00001 as F64))
    expect(nearEqual(F64.infinity, F64.infinity) && !nearEqual(F64.infinity, 1 as F64) && !nearEqual(F64.nan, F64.nan))
}
