module ArraySearchTests

// Finding elements in an array (Sable.Core, Array+Search.sb), tested with
// '@test': run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

fn isEven(_ x: Int) -> Bool {
    return x % 2 == 0
}

@test
fn firstIndexWhereFindsTheFirstThatPasses() {
    let xs: Int[>..] = [3, 8, 5, 10]
    assertEqual(xs.firstIndex(where: isEven) ?? -1, 1)
    expect(xs.firstIndex(where: (x: Int) => x > 10) == none)
    let empty: Int[>..] = []
    expect(empty.firstIndex(where: isEven) == none)
}

@test
fn lastIndexWhereFindsTheLastThatPasses() {
    let xs: Int[>..] = [3, 8, 5, 10, 7]
    assertEqual(xs.lastIndex(where: isEven) ?? -1, 3)
    expect(xs.lastIndex(where: (x: Int) => x > 10) == none)
}

@test
fn isSortedByComparesNeighbours() {
    let descending: Int[>..] = [9, 5, 5, 1]
    expect(descending.isSorted(by: (a: Int, b: Int) => b < a))
    expect(!descending.isSorted(by: (a: Int, b: Int) => a < b))
    let one: Int[>..] = [4]
    expect(one.isSorted(by: (a: Int, b: Int) => a < b))
}

@test
fn partitionPointIsWhereTheFailingElementsBegin() {
    let xs: Int[>..] = [1, 3, 3, 7, 9]
    assertEqual(xs.partitionPoint(where: (x: Int) => x < 3), 1)
    assertEqual(xs.partitionPoint(where: (x: Int) => x <= 3), 3)
    assertEqual(xs.partitionPoint(where: (x: Int) => x < 0), 0)
    assertEqual(xs.partitionPoint(where: (x: Int) => x < 100), 5)
    let empty: Int[>..] = []
    assertEqual(empty.partitionPoint(where: (x: Int) => x < 3), 0)
}

@test
fn partitionPointFindsTheInsertionPlaceInALargeArray() {
    var xs: Int[>..] = []
    var i = 0
    while i < 1000 {
        xs.append(i * 2)
        i = i + 1
    }
    assertEqual(xs.partitionPoint(where: (x: Int) => x < 777), 389)
    assertEqual(xs.partitionPoint(where: (x: Int) => x < 778), 389)
    assertEqual(xs.partitionPoint(where: (x: Int) => x <= 778), 390)
}

@test(arguments: [(1, .Ok(0)), (9, .Ok(4)), (5, .Ok(2)), (0, .Err(0)), (6, .Err(3)), (10, .Err(5))])
fn binarySearchForAValueFindsItOrWhereItWouldGo(_ value: Int, _ found: Outcome<Int, Int>) {
    let xs: Int[>..] = [1, 3, 5, 7, 9]
    expect(xs.binarySearch(for: value) == found)
}

@test
fn binarySearchOfNothingFindsThePlaceForTheFirst() {
    let empty: Int[>..] = []
    expect(empty.binarySearch(for: 4) == .Err(0))
}

@test
fn binarySearchByAComparisonUsesItsSign() {
    let words: String[>..] = ["a", "bee", "cats", "dingo"]
    expect(words.binarySearch(by: (w: String) => w.count.compare(3)) == .Ok(1))
    expect(words.binarySearch(by: (w: String) => w.count.compare(2)) == .Err(1))
    expect(words.binarySearch(by: (w: String) => w.compare("cow")) == .Err(3))
}

@test
fn binarySearchForAKeyComparesTheKeysElementsGive() {
    let pairs: (Int, String)[>..] = [(1, "one"), (4, "four"), (9, "nine")]
    expect(pairs.binarySearch(forKey: 4, by: (p: (Int, String)) => p.0) == .Ok(1))
    expect(pairs.binarySearch(forKey: 5, by: (p: (Int, String)) => p.0) == .Err(2))
}

@test
fn binarySearchFindsEveryElementOfALargeArray() {
    var xs: Int[>..] = []
    var i = 0
    while i < 1000 {
        xs.append(i * 2)
        i = i + 1
    }
    i = 0
    while i < 1000 {
        assertEqual(xs.binarySearch(for: i * 2), .Ok(i))
        assertEqual(xs.binarySearch(for: i * 2 + 1), .Err(i + 1))
        i = i + 1
    }
}

@test
fn firstAndLastIndexOfFindEqualElements() {
    let xs: String[>..] = ["a", "b", "a", "c"]
    assertEqual(xs.firstIndex(of: "a") ?? -1, 0)
    assertEqual(xs.lastIndex(of: "a") ?? -1, 2)
    assertEqual(xs.firstIndex(of: "c") ?? -1, 3)
    expect(xs.firstIndex(of: "z") == none)
    expect(xs.lastIndex(of: "z") == none)
}

@test
fn firstIndexOfAnyFindsTheFirstOfSeveral() {
    let xs: Char[>..] = ['h', 'e', 'l', 'l', 'o']
    assertEqual(xs.firstIndex(ofAny: ['o', 'l']) ?? -1, 2)
    expect(xs.firstIndex(ofAny: ['z']) == none)
    expect(xs.firstIndex(ofAny: []) == none)
}

@test
fn startsWithComparesTheFirstElements() {
    let xs: Int[>..] = [1, 2, 3]
    expect(xs.starts(with: [1, 2]))
    expect(xs.starts(with: []))
    expect(xs.starts(with: xs))
    expect(!xs.starts(with: [2]))
    expect(!xs.starts(with: [1, 2, 3, 4]))
}

@test
fn endsWithComparesTheLastElements() {
    let xs: Int[>..] = [1, 2, 3]
    expect(xs.ends(with: [2, 3]))
    expect(xs.ends(with: []))
    expect(!xs.ends(with: [1, 3]))
    expect(!xs.ends(with: [0, 1, 2, 3]))
}

@test
fn countOfCountsTheEqualElementsBesideTheCountOfAll() {
    let xs: Int[>..] = [3, 8, 3]
    assertEqual(xs.count(of: 3), 2)
    assertEqual(xs.count(of: 5), 0)
    assertEqual(xs.count, 3)
    let words: String[>..] = ["a", "b", "a", "a"]
    assertEqual(words.count(of: "a"), 3)
}

@test
fn commonPrefixLengthCountsTheEqualStart() {
    let xs: String[>..] = ["a", "b", "c"]
    assertEqual(xs.commonPrefixLength(with: ["a", "b", "x"]), 2)
    assertEqual(xs.commonPrefixLength(with: ["a"]), 1)
    assertEqual(xs.commonPrefixLength(with: ["x"]), 0)
    assertEqual(xs.commonPrefixLength(with: xs), 3)
}

@test
fn minAndMaxAreTheExtremes() {
    let xs: Int[>..] = [4, -2, 9, 9, 0]
    assertEqual(xs.min() ?? 0, -2)
    assertEqual(xs.max() ?? 0, 9)
    let words: String[>..] = ["pear", "apple", "fig"]
    assertEqual(words.min() ?? "", "apple")
    assertEqual(words.max() ?? "", "pear")
}

@test
fn minAndMaxOfNothingAreNone() {
    let empty: F64[>..] = []
    expect(empty.min() == none)
    expect(empty.max() == none)
}

@test
fn isSortedIsAscendingOrder() {
    let ascending: Int[>..] = [1, 1, 2, 5]
    let unsorted: Int[>..] = [1, 3, 2]
    let empty: Int[>..] = []
    expect(ascending.isSorted())
    expect(!unsorted.isSorted())
    expect(empty.isSorted())
}

@test
fn everyKindOfArrayCanBeSearched() {
    let fixed: Int[] = [5, 6, 7]
    var shrink: Int[>..<] = [5, 6]
    shrink.append(7)
    assertEqual(fixed.firstIndex(of: 7) ?? -1, 2)
    assertEqual(shrink.lastIndex(where: isEven) ?? -1, 1)
    assertEqual(fixed[1...].firstIndex(of: 7) ?? -1, 1)
}

@test
fn halvingFindsWhatLookingAtEachDoes() {
    // Every size, with runs of equal elements: where 'binarySearch' says one
    // is, it is, and where it says one could go keeps the array sorted.
    for size in 0..<50 {
        var xs: Int[>..] = []
        for i in 0..<size {
            xs.append(i * 2 / 3 * 2)
        }
        for wanted in -1..<size * 2 + 2 {
            match xs.binarySearch(for: wanted) {
                case .Ok(let at) => assertEqual(xs[at], wanted)
                case .Err(let at) => {
                    expect(!xs.contains(element: wanted))
                    expect((at == 0 || xs[at - 1] < wanted) && (at == size || wanted < xs[at]), "\(wanted) of \(size) at \(at)")
                }
                default => fail("neither found nor a place for it")
            }
            let below = xs.firstIndex(where: (x: Int) => !(x < wanted)) ?? size
            assertEqual(xs.partitionPoint(where: (x: Int) => x < wanted), below)
        }
    }
}
