module Sable.Net

/// Which code points percent-encoding writes as %XX, by the WHATWG URL
/// standard's sets: each a superset of the one before.
@derive(Equatable, Hashable, Debug)
public enum PercentEncodeSet {
    /// C0 controls and everything above '~'.
    C0Control
    /// And space, '"', '<', '>' and '`': a fragment's.
    Fragment
    /// And space, '"', '#', '<' and '>' (not '`'): a query's.
    Query
    /// The query set and '\'': a special URL's query.
    SpecialQuery
    /// The query set and '?', '^', '`', '{' and '}': a path segment's.
    Path
    /// The path set and '/', ':', ';', '=', '@', '[' to '^' and '|': a
    /// username's or password's.
    Userinfo
    /// The userinfo set and '$' to '&', '+' and ',': JavaScript's
    /// encodeURIComponent.
    Component
    /// The component set and '!', '\'' to ')' and '~':
    /// application/x-www-form-urlencoded.
    FormUrlencoded

    /// Whether the set holds the byte (or ASCII code point).
    public fn contains(_ code: Int) -> Bool {
        return code < 0 || code > 0x7F || self.bytes.contains(U8(code))
    }

    /// The bytes the set holds.
    var bytes: ByteSet {
        get {
            return match self {
                case .C0Control      => ByteSet(low: 0x0000_0000_FFFF_FFFF, high: 0x8000_0000_0000_0000)
                case .Fragment       => ByteSet(low: 0x5000_0005_FFFF_FFFF, high: 0x8000_0001_0000_0000)
                case .Query          => ByteSet(low: 0x5000_000D_FFFF_FFFF, high: 0x8000_0000_0000_0000)
                case .SpecialQuery   => ByteSet(low: 0x5000_008D_FFFF_FFFF, high: 0x8000_0000_0000_0000)
                case .Path           => ByteSet(low: 0xD000_000D_FFFF_FFFF, high: 0xA800_0001_4000_0000)
                case .Userinfo       => ByteSet(low: 0xFC00_800D_FFFF_FFFF, high: 0xB800_0001_7800_0001)
                case .Component      => ByteSet(low: 0xFC00_987D_FFFF_FFFF, high: 0xB800_0001_7800_0001)
                case .FormUrlencoded => ByteSet(low: 0xFC00_9BFF_FFFF_FFFF, high: 0xF800_0001_7800_0001)
            }
        }
    }
}

/// Some of the ASCII bytes, a bit each, and every byte above them.
struct ByteSet {
    let low: U64
    let high: U64

    init(low: U64, high: U64) {
        self.low = low
        self.high = high
    }

    @inline(always)
    fn contains(_ byte: U8) -> Bool {
        return byte >= 0x80 || ((byte < 0x40 ? low : high) >> U64(byte & 0x3F) & 1) != 0
    }

    /// The set with an ASCII byte too.
    fn with(_ byte: U8) -> ByteSet {
        let bit: U64 = 1 << U64(byte & 0x3F)
        return byte < 0x40 ? ByteSet(low: low | bit, high: high) : ByteSet(low: low, high: high | bit)
    }

    /// The set without an ASCII byte.
    fn without(_ byte: U8) -> ByteSet {
        let bit: U64 = 1 << U64(byte & 0x3F)
        return byte < 0x40 ? ByteSet(low: low & ~bit, high: high) : ByteSet(low: low, high: high & ~bit)
    }
}
