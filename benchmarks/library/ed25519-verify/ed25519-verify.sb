module Ed25519VerifyBench

// Ed25519: a signature checked 2000 times, every fourth of another message.
// .NET has no Ed25519.

import Sable.Crypto

@main
fn main() {
    let key = Ed25519PrivateKey.generate()
    let publicKey = key.publicKey
    let message = U8[>..](repeating: 7, count: 64)
    let other = U8[>..](repeating: 8, count: 64)
    let signature = key.sign(message)
    var valid = 0
    var round = 0
    while round < 2000 {
        if publicKey.isValid(signature, for: round % 4 == 3 ? other : message) {
            valid += 1
        }
        round += 1
    }
    print("\(valid)")
}
