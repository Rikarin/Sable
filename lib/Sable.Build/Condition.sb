module Sable.Build

/// When a dependency applies. A manifest may not ask which machine evaluates
/// it — that would make the package different on each one — so the choice
/// is data, applied to each target as it is built.
public struct Condition {
    var text: String

    /// Only when building for the operating system.
    public static fn os(_ os: OperatingSystem) -> Condition {
        return Condition { text: "os(\(osName(os)))" }
    }

    /// Only when building for the architecture.
    public static fn arch(_ arch: Architecture) -> Condition {
        return Condition { text: "arch(\(archName(arch)))" }
    }
}

// The operating system and architecture are Sable.Core's: the manifest
// writes them as '#if' does, but an x86-64 machine as 'x64'.

fn osName(_ os: OperatingSystem) -> String {
    return os.name
}

fn archName(_ arch: Architecture) -> String {
    return match arch {
        case .Arm64  => "arm64"
        case .X86_64 => "x64"
        case .Wasm32 => "wasm32"
    }
}
