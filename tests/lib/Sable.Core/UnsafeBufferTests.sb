module UnsafeBufferTests

// UnsafeBuffer (Sable.Core): a run of values in raw memory, a mutable
// random-access collection once made.

import Sable.Testing

@test
fn aBufferIsACollectionOfItsValues() {
    unsafe {
        let buffer = UnsafeBuffer<Int>.allocate(count: 4)
        defer {
            buffer.deallocate()
        }
        buffer.initialize(repeating: 0)
        var view = buffer
        view[0] = 3
        view[2] = 7
        assertEqual(view.count, 4)
        assert(view.toArray() == [3, 0, 7, 0])
        assertEqual(view.reduce(0) { $0 + $1 }, 10)
        assert(view.reversed().toArray() == [0, 7, 0, 3])
        assertEqual(view.firstIndex(of: 7), 2)
        view.swapAt(0, 3)
        assert(buffer.toArray() == [0, 0, 7, 3])
    }
}

@test
fn aBufferViewsMemoryItDoesNotOwn() {
    unsafe {
        let start = RawPtr<String>.allocate(count: 3)
        defer {
            start.deallocate()
        }
        start.initialize(to: "x")
        start.initialize(to: "y", at: 1)
        start.initialize(to: "z", at: 2)
        let view = UnsafeBuffer<String>.viewing(start + 1, count: 2)
        assert(view.toArray() == ["y", "z"])
        assertEqual(view.start, start + 1)
        start.deinitialize(count: 3)
    }
}

@test
fn anEmptyBufferHasNothing() {
    unsafe {
        let view = UnsafeBuffer<Int>.viewing(RawPtr<Int>.null, count: 0)
        assert(view.isEmpty)
        assert(view.toArray() == [] as Int[>..])
    }
}

class Counted {
    let gone: Atomic<Int>

    init(_ gone: Atomic<Int>) {
        self.gone = gone
    }

    deinit {
        gone.add(1)
    }
}

@test
fn aBuffersValuesAreDestroyedOnce() {
    let gone = Atomic<Int>(0)
    unsafe {
        let buffer = UnsafeBuffer<Counted>.allocate(count: 3)
        buffer.initialize(repeating: Counted(gone))
        assertEqual(gone.load(), 0)
        var view = buffer
        view[1] = Counted(gone)
        buffer.deinitialize()
        buffer.deallocate()
    }
    assertEqual(gone.load(), 2)
}

fn middle<C: RandomAccessCollection>(_ values: C) -> C.Element {
    let half = values.distance(from: values.startIndex, to: values.endIndex) / 2
    return values[values.index(values.startIndex, offsetBy: half)]
}

@test
fn aBufferIsReadAtRandom() {
    unsafe {
        var buffer = UnsafeBuffer<Int>.allocate(count: 5)
        defer {
            buffer.deallocate()
        }
        buffer.initialize(repeating: 0)
        for i in 0..<5 {
            buffer[i] = i * i
        }
        assertEqual(middle(buffer), 4)
        assertEqual(buffer.index(after: 1), 2)
        assertEqual(buffer.index(before: 1), 0)
    }
}

// Two values, which the tests of what traps ask past.
fn pair() -> UnsafeBuffer<Int> {
    unsafe {
        let buffer = UnsafeBuffer<Int>.allocate(count: 2)
        buffer.initialize(repeating: 1)
        return buffer
    }
}

@test(traps: "index 2 is out of range for count 2")
fn readingPastTheBufferTraps() {
    let _ = pair()[2]
}

@test(traps: "index -1 is out of range for count 2")
fn readingBeforeTheBufferTraps() {
    let _ = pair()[-1]
}

@test(traps: "index 2 is out of range for count 2")
fn writingPastTheBufferTraps() {
    var buffer = pair()
    buffer[2] = 5
}

@test(traps: "index -1 is out of range for count 2")
fn writingBeforeTheBufferTraps() {
    var buffer = pair()
    buffer[-1] = 5
}

@test(traps: "a buffer of -1 values")
fn aBufferOfANegativeCountTraps() {
    unsafe {
        let _ = UnsafeBuffer<Int>.viewing(RawPtr<Int>.null, count: -1)
    }
}
