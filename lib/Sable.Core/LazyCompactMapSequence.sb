module Sable.Core

/// A sequence's elements, transformed, leaving out those the closure makes
/// none of: what '.lazy.compactMap' makes.
public struct LazyCompactMapSequence<Base: Sequence, T>: LazySequenceProtocol {
    let base: Base
    let transform: (Base.Element) -> T?

    /// An iterator from the first element the closure keeps.
    public fn makeIterator() -> LazyCompactMapIterator<Base.Iter, T> {
        return LazyCompactMapIterator<Base.Iter, T> { base: base.makeIterator(), transform: transform }
    }
}

/// Gives an iterator's elements, transformed, leaving out none.
public struct LazyCompactMapIterator<Base: Iterator, T>: Iterator {
    var base: Base
    let transform: (Base.Element) -> T?

    /// The next transformed element that is not none, or none past the last.
    public mutating fn next() -> T? {
        while let element = base.next() {
            if let value = transform(element) {
                return value
            }
        }
        return none
    }
}
