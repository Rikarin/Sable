module ComplexElementaryFunctionsTests

// The elementary functions of Complex (Sable.Math), tested with '@test':
// run with
//     tools/stdlib-coverage.sh Sable.Math
// Reference values are mpmath's at 3000 bits, rounded once to the type;
// each result is held to four units of the type's epsilon relative to the
// true value's magnitude, and each part that is a normal float to 16 ulps
// of its own. The special values are C99's (Annex G): on a branch cut the
// sign of a zero part picks the side.

import Sable.Math
import Sable.Testing
import FloatAssertions

/// Fails unless the value is near the reference: as a whole within four
/// epsilons of the reference's magnitude, and each normal part within 16
/// ulps of its own reference.
fn assertNear(_ actual: Complex<F64>, _ re: F64, _ im: F64) {
    let expected = Complex(re, im)
    let error = (actual - expected).magnitude
    assert(error <= 4.0 * F64.epsilon * expected.magnitude, "expected \(expected), got \(actual)")
    if re.isNormal {
        assertWithin(actual.real, re, ulps: 16)
    }
    if im.isNormal {
        assertWithin(actual.imaginary, im, ulps: 16)
    }
}

/// Fails unless the value is near the reference, as an F32.
fn assertNear(_ actual: Complex<F32>, _ re: F32, _ im: F32) {
    let expected = Complex(re, im)
    let error = (actual - expected).magnitude
    assert(error <= 4.0 * F32.epsilon * expected.magnitude, "expected \(expected), got \(actual)")
    if re.isNormal {
        assertWithin(actual.real, re, ulps: 16)
    }
    if im.isNormal {
        assertWithin(actual.imaginary, im, ulps: 16)
    }
}

/// Fails unless both parts are exactly these: a zero's sign, and NaN as NaN.
fn assertParts(_ actual: Complex<F64>, _ re: F64, _ im: F64) {
    assertSame(actual.real, re)
    assertSame(actual.imaginary, im)
}

/// Fails unless both parts are exactly these, as F32s.
fn assertParts(_ actual: Complex<F32>, _ re: F32, _ im: F32) {
    assertSame(actual.real, re)
    assertSame(actual.imaginary, im)
}

let halfPi: F64 = F64.pi / 2.0

// Identities.

@test
fn expUndoesLog() {
    // exp magnifies log's error in its real part, log|z|, by that much.
    let points = [Complex(0.5, 0.25), Complex(-3.0, 4.0), Complex(1e-200, -1e-200), Complex(1e200, 1e100), Complex(-0.6, -0.8)]
    for z in points {
        let back = exp(log(z))
        let tolerance = 4.0 * F64.epsilon * (1.0 + log(z.magnitude).abs())
        assert((back - z).magnitude <= tolerance * z.magnitude, "exp(log(\(z))) is \(back)")
    }
}

@test
fn theSquareOfTheSquareRootIsTheNumber() {
    let points = [Complex(2.0, 0.0), Complex(-2.0, 0.0), Complex(-3.0, -4.0), Complex(1e300, -1e300), Complex(1e-300, 3e-300)]
    for z in points {
        let root = sqrt(z)
        assert(root.real >= 0.0)
        assert((root * root - z).magnitude <= 4.0 * F64.epsilon * z.magnitude, "sqrt(\(z))² is \(root * root)")
    }
    let narrow = Complex(-3.0 as F32, 4.0)
    assertParts(sqrt(narrow), 1.0, 2.0)
}

@test
fn sineSquaredPlusCosineSquaredIsOne() {
    let points = [Complex(0.5, 0.25), Complex(-1.5, 2.0), Complex(3.0, -0.7)]
    for z in points {
        let s = sin(z)
        let c = cos(z)
        assert((s * s + c * c - Complex<F64>.one).magnitude < 1e-13)
    }
}

@test
fn theTangentIsTheSineOverTheCosineAndTanhLikewise() {
    let z = Complex(0.7, -1.2)
    assert((tan(z) - sin(z) / cos(z)).magnitude <= 4.0 * F64.epsilon * tan(z).magnitude)
    assert((tanh(z) - sinh(z) / cosh(z)).magnitude <= 4.0 * F64.epsilon * tanh(z).magnitude)
}

@test
fn eachInverseUndoesItsFunctionNearZero() {
    let z = Complex(0.3, -0.4)
    let tolerance = 8.0 * F64.epsilon
    assert((sin(asin(z)) - z).magnitude <= tolerance)
    assert((cos(acos(z)) - z).magnitude <= tolerance)
    assert((tan(atan(z)) - z).magnitude <= tolerance)
    assert((sinh(asinh(z)) - z).magnitude <= tolerance)
    assert((cosh(acosh(z)) - z).magnitude <= tolerance)
    assert((tanh(atanh(z)) - z).magnitude <= tolerance)
}

@test
fn theFunctionsAreSymmetricInTheRealAxis() {
    // f(conj z) = conj f(z) for each of them, to the bit.
    let z = Complex(0.8, 1.7)
    let w = z.conjugate
    assert(exp(w) == exp(z).conjugate && log(w) == log(z).conjugate && sqrt(w) == sqrt(z).conjugate)
    assert(sin(w) == sin(z).conjugate && cos(w) == cos(z).conjugate && tan(w) == tan(z).conjugate)
    assert(sinh(w) == sinh(z).conjugate && cosh(w) == cosh(z).conjugate && tanh(w) == tanh(z).conjugate)
    assert(asin(w) == asin(z).conjugate && acos(w) == acos(z).conjugate && atan(w) == atan(z).conjugate)
    assert(asinh(w) == asinh(z).conjugate && acosh(w) == acosh(z).conjugate && atanh(w) == atanh(z).conjugate)
}

@test
fn theOddFunctionsAreOdd() {
    let z = Complex(0.8, -1.7)
    assert(sin(-z) == -sin(z) && tan(-z) == -tan(z) && sinh(-z) == -sinh(z) && tanh(-z) == -tanh(z))
    assert(asin(-z) == -asin(z) && atan(-z) == -atan(z) && asinh(-z) == -asinh(z) && atanh(-z) == -atanh(z))
    assert(cos(-z) == cos(z) && cosh(-z) == cosh(z))
}

// Branch cuts: the sign of the zero part picks the side.

@test
fn logAndSqrtCutAlongTheNegativeRealAxis() {
    assertParts(log(Complex(-1.0, 0.0)), 0.0, F64.pi)
    assertParts(log(Complex(-1.0, -0.0)), 0.0, -F64.pi)
    assertParts(sqrt(Complex(-4.0, 0.0)), 0.0, 2.0)
    assertParts(sqrt(Complex(-4.0, -0.0)), 0.0, -2.0)
    assertParts(sqrt(Complex(4.0, -0.0)), 2.0, -0.0)
    let above = pow(Complex(-8.0, 0.0), Complex(1.0 / 3.0, 0.0))
    let below = pow(Complex(-8.0, -0.0), Complex(1.0 / 3.0, 0.0))
    assertNear(above, 1.0, 1.7320508075688772)
    assertNear(below, 1.0, -1.7320508075688772)
    // F32's atan2(-0, -1) is -pi or, in some libms, the F32 above it.
    let narrow = log(Complex(-1.0 as F32, -0.0))
    assertSame(narrow.real, 0.0)
    assertWithin(narrow.imaginary, -F32.pi, ulps: 1)
}

@test
fn asinAcosAndAtanhCutAlongTheRealAxisOutsideOne() {
    assertNear(asin(Complex(2.0, 0.0)), halfPi, 1.3169578969248166)
    assertNear(asin(Complex(2.0, -0.0)), halfPi, -1.3169578969248166)
    assertNear(asin(Complex(-2.0, 0.0)), -halfPi, 1.3169578969248166)
    assertNear(acos(Complex(2.0, 0.0)), 0.0, -1.3169578969248166)
    assertNear(acos(Complex(2.0, -0.0)), 0.0, 1.3169578969248166)
    assertNear(acos(Complex(-2.0, 0.0)), F64.pi, -1.3169578969248166)
    assertNear(atanh(Complex(2.0, 0.0)), 0.5493061443340549, halfPi)
    assertNear(atanh(Complex(2.0, -0.0)), 0.5493061443340549, -halfPi)
    assertNear(atanh(Complex(-2.0, 0.0)), -0.5493061443340549, halfPi)
    // Inside [-1, 1] the parts are real, the zero keeping its side.
    assertParts(asin(Complex(0.5, -0.0)), 0.5235987755982989, -0.0)
    assertParts(acos(Complex(0.5, 0.0)), 1.0471975511965979, -0.0)
    assertParts(atanh(Complex(0.5, -0.0)), 0.5493061443340549, -0.0)
}

@test
fn acoshCutsAlongTheRealAxisBelowOne() {
    assertNear(acosh(Complex(-2.0, 0.0)), 1.3169578969248166, F64.pi)
    assertNear(acosh(Complex(-2.0, -0.0)), 1.3169578969248166, -F64.pi)
    assertParts(acosh(Complex(0.5, 0.0)), 0.0, 1.0471975511965979)
    assertParts(acosh(Complex(0.5, -0.0)), 0.0, -1.0471975511965979)
    assertParts(acosh(Complex(2.0, -0.0)), 1.3169578969248166, -0.0)
}

@test
fn asinhAndAtanCutAlongTheImaginaryAxisOutsideI() {
    assertNear(asinh(Complex(0.0, 2.0)), 1.3169578969248166, halfPi)
    assertNear(asinh(Complex(-0.0, 2.0)), -1.3169578969248166, halfPi)
    assertNear(atan(Complex(0.0, 2.0)), halfPi, 0.5493061443340549)
    assertNear(atan(Complex(-0.0, 2.0)), -halfPi, 0.5493061443340549)
    assertNear(atan(Complex(-0.0, -2.0)), -halfPi, -0.5493061443340549)
    assertParts(atan(Complex(-0.0, 0.5)), -0.0, 0.5493061443340549)
}

// Special values.

@test
fn zerosKeepTheirSigns() {
    assertParts(exp(Complex(-0.0, -0.0)), 1.0, -0.0)
    assertParts(sin(Complex(-0.0, 0.0)), -0.0, 0.0)
    assertParts(sin(Complex(0.0, -0.0)), 0.0, -0.0)
    assertParts(cos(Complex(-0.0, 0.0)), 1.0, 0.0)
    assertParts(tan(Complex(-0.0, -0.0)), -0.0, -0.0)
    assertParts(sinh(Complex(-0.0, 0.0)), -0.0, 0.0)
    assertParts(cosh(Complex(0.0, -0.0)), 1.0, -0.0)
    assertParts(tanh(Complex(0.0, -0.0)), 0.0, -0.0)
    assertParts(sqrt(Complex(0.0, -0.0)), 0.0, -0.0)
    assertParts(sqrt(Complex(-0.0, 0.0)), 0.0, 0.0)
    assertParts(asin(Complex(-0.0, 0.0)), -0.0, 0.0)
    assertParts(asinh(Complex(0.0, -0.0)), 0.0, -0.0)
    assertParts(atan(Complex(-0.0, -0.0)), -0.0, -0.0)
    assertParts(atanh(Complex(-0.0, 0.0)), -0.0, 0.0)
    assertParts(acos(Complex(0.0, -0.0)), halfPi, 0.0)
    assertParts(acosh(Complex(0.0, -0.0)), 0.0, -halfPi)
    assertParts(sin(Complex(-0.0 as F32, 0.0)), -0.0, 0.0)
}

@test
fn theFunctionsAreExactWhereTheValueIs() {
    assertParts(exp(Complex(0.0, 0.0)), 1.0, 0.0)
    assertParts(exp(Complex(1.0, 0.0)), exp(1.0), 0.0)
    assertParts(log(Complex(1.0, 0.0)), 0.0, 0.0)
    assertParts(log(Complex(0.0, 1.0)), 0.0, halfPi)
    assertParts(sqrt(Complex(9.0, 0.0)), 3.0, 0.0)
    assertParts(sqrt(Complex(0.0, 2.0)), 1.0, 1.0)
    assertParts(asin(Complex(1.0, 0.0)), halfPi, 0.0)
    assertParts(acos(Complex(1.0, 0.0)), 0.0, -0.0)
    assertParts(acosh(Complex(1.0, 0.0)), 0.0, 0.0)
    assertParts(sinh(Complex(0.0, halfPi)), 0.0, 1.0)
}

@test
fn logOfZeroIsMinusInfinityWithTheZerosPhase() {
    assertParts(log(Complex(0.0, 0.0)), -inf, 0.0)
    assertParts(log(Complex(-0.0, 0.0)), -inf, F64.pi)
    assertParts(log(Complex(-0.0, -0.0)), -inf, -F64.pi)
}

@test
fn atanhHasPolesAtOneAndMinusOne() {
    assertParts(atanh(Complex(1.0, 0.0)), inf, 0.0)
    assertParts(atanh(Complex(-1.0, -0.0)), -inf, -0.0)
    assertParts(atan(Complex(0.0, 1.0)), 0.0, inf)
    assert(!atanh(Complex(1.0, 0.0)).isFinite)
}

@test
fn theFunctionsOfThePointAtInfinityAreThePointAtInfinity() {
    let infinite = Complex(inf, 1.0)
    let notANumber = Complex(nan, 0.0)
    for z in [infinite, notANumber] {
        assert(!exp(z).isFinite && !log(z).isFinite && !sqrt(z).isFinite)
        assert(!sin(z).isFinite && !cos(z).isFinite && !tan(z).isFinite)
        assert(!sinh(z).isFinite && !cosh(z).isFinite && !tanh(z).isFinite)
        assert(!asin(z).isFinite && !acos(z).isFinite && !atan(z).isFinite)
        assert(!asinh(z).isFinite && !acosh(z).isFinite && !atanh(z).isFinite)
        assert(!pow(z, Complex(2.0, 0.0)).isFinite)
    }
}

@test
fn expAndTheHyperbolicFunctionsReachPastTheOverflowOfTheirScale() {
    // e^710 overflows; e^710 cos(pi/4) does not, nor sinh's or cosh's half.
    let z = Complex(710.0, F64.pi / 4.0)
    assert(exp(z).isFinite && cosh(z).isFinite && sinh(z).isFinite)
    assert(sinh(Complex(-710.0, 1.0)).real < 0.0)
    let narrow = Complex(89.0 as F32, F32.pi / 4.0)
    assert(exp(narrow).isFinite)
    assert(!exp(Complex(720.0, 0.5)).isFinite)
}

@test
fn tanhIsOneWithATinyImaginaryPartFarFromTheAxis() {
    assertParts(tanh(Complex(1000.0, 1.0)), 1.0, 0.0)
    assertParts(tanh(Complex(-1000.0, -1.0)), -1.0, -0.0)
    assertParts(tanh(Complex(30.0 as F32, 0.0)), 1.0, 0.0)
}

// Powers.

@test
fn anIntegerPowerIsExactWhereItsProductsAre() {
    let i = Complex<F64>.i
    assert(pow(i, 0) == Complex(1.0, 0.0))
    assertParts(pow(i, 2), -1.0, 0.0)
    assert(pow(i, 3) == Complex(0.0, -1.0))
    assert(pow(i, 4) == Complex(1.0, 0.0))
    assert(pow(Complex(1.0, 1.0), 8) == Complex(16.0, 0.0))
    assertParts(pow(Complex(2.0, 0.0), -3), 0.125, 0.0)
    assert(pow(Complex(1.0, 0.0), Int.min) == Complex<F64>.one)
    assert(pow(Complex(0.0, 0.0), -1) == Complex<F64>.infinity)
    assert(pow(Complex(1.0 as F32, -1.0), 2) == Complex(0.0, -2.0))
}

@test
fn aComplexPowerIsExpOfTheProductWithTheLog() {
    assertNear(pow(Complex<F64>.i, Complex<F64>.i), 0.20787957635076193, 0.0)
    assertNear(pow(Complex(1.0, 2.0), Complex(0.5, -1.5)), 6.248604836334075, -4.784858580631062)
    assertNear(pow(Complex(2.0, 0.0), Complex(10.0, 0.0)), 1024.0, 0.0)
}

@test
fn zeroToAPowerIsZeroOneOrInfinite() {
    let zero = Complex<F64>.zero
    assertParts(pow(zero, Complex(2.0, 1.0)), 0.0, 0.0)
    assertParts(pow(zero, zero), 1.0, 0.0)
    assert(pow(zero, Complex(-1.0, 0.0)) == Complex<F64>.infinity)
}

// Against high-precision references.

@test
fn expIsWithinAFewUlpsOfTheTrueValue() {
    let cases: (F64, F64, F64, F64)[>..] = [
        (0.5, 0.25, 1.5974665191199127, 0.40790017007835977),
        (-1.5, 2.0, -0.09285491028402633, 0.2028916804701695),
        (3.0, -0.7, 15.36226599311421, -12.939458143583208),
        (-0.2, -0.9, 0.5089311974430215, -0.6413338306255577),
        (1e-05, 1e-06, 1.0000100000495002, 1.0000100000498335e-06),
        (20.0, 3.0, -480309903.06738126, 68466516.28659666),
        (0.6, 0.8, 1.269482393459676, 1.3071080198026634),
        (710.0, 0.7853981633974483, 1.5796728482882015e+308, 1.5796728482882013e+308),
        (-700.0, 1.0, 5.327205971707415e-305, 8.296631731164852e-305),
        (1e-300, 2.0, -0.4161468365471424, 0.9092974268256817),
    ]
    for (x, y, re, im) in cases {
        assertNear(exp(Complex(x, y)), re, im)
    }
}

@test
fn expOfF32IsWithinAFewUlpsOfTheTrueValue() {
    let cases: (F32, F32, F32, F32)[>..] = [
        (0.5, 0.25, 1.5974664688110352, 0.4079001843929291),
        (-1.5, 2.0, -0.09285490959882736, 0.20289167761802673),
        (3.0, -0.699999988079071, 15.362266540527344, -12.939457893371582),
        (-0.20000000298023224, -0.8999999761581421, 0.5089312195777893, -0.641333818435669),
        (9.999999747378752e-06, 9.999999974752427e-07, 1.0000100135803223, 1.0000100019169622e-06),
        (20.0, 3.0, -480309888.0, 68466520.0),
        (0.6000000238418579, 0.800000011920929, 1.2694823741912842, 1.3071080446243286),
        (89.0, 0.7853981852531433, 3.1746356086671174e+38, 3.1746358114912134e+38),
        (-85.0, 1.0, 6.570612829101994e-38, 1.023312328661718e-37),
        (9.999999350456404e-39, 2.0, -0.416146844625473, 0.9092974066734314),
    ]
    for (x, y, re, im) in cases {
        assertNear(exp(Complex(x, y)), re, im)
    }
}

@test
fn logIsWithinAFewUlpsOfTheTrueValue() {
    let cases: (F64, F64, F64, F64)[>..] = [
        (0.5, 0.25, -0.5815754049028404, 0.4636476090008061),
        (-1.5, 2.0, 0.9162907318741551, 2.214297435588181),
        (3.0, -0.7, 1.1251193063109182, -0.22923193327699531),
        (-0.2, -0.9, -0.08125946474888743, -1.7894652726688385),
        (1e-05, 1e-06, -11.507950299543644, 0.09966865249116201),
        (20.0, 3.0, 3.006857578021401, 0.14888994760949725),
        (0.6, 0.8, 2.2204460492503132e-17, 0.9272952180016123),
        (1.0, 1e-10, 5.0000000000000005e-21, 1e-10),
        (0.28, 0.96, -2.6645352591003756e-17, 1.2870022175865687),
        (1e-310, 1e-310, -713.4548052378742, 0.7853981633974483),
        (1e+308, 1e+308, 709.542782232446, 0.7853981633974483),
        (-3.0, 1e-300, 1.0986122886681098, 3.141592653589793),
    ]
    for (x, y, re, im) in cases {
        assertNear(log(Complex(x, y)), re, im)
    }
}

@test
fn logOfF32IsWithinAFewUlpsOfTheTrueValue() {
    let cases: (F32, F32, F32, F32)[>..] = [
        (0.5, 0.25, -0.5815753936767578, 0.46364760398864746),
        (-1.5, 2.0, 0.9162907600402832, 2.2142975330352783),
        (3.0, -0.699999988079071, 1.1251193284988403, -0.22923192381858826),
