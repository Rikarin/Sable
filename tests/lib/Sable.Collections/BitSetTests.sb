module BitSetTests

// BitSet (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn aBitSetIsGoneThroughAscending() {
    let members = BitSet()
    let _ = members.insert(130)
    let _ = members.insert(3)
    let _ = members.insert(64)
    let _ = members.insert(0)
    let _ = members.insert(63)
    var seen: String[>..] = []
    for member in members {
        seen.append("\(member)")
    }
    assertEqualText(seen.joined(separator: ","), "0,3,63,64,130")
    assertEqual(BitSet().toArray().count, 0)
}

@test
fn bitSetAlgebra() {
    let a = BitSet([1, 2, 3, 64, 200])
    let b = BitSet([2, 3, 4])
    assertEqual(a.count, 5)
    assertEqual(a.union(b).count, 6)
    assertEqual(a.intersection(b).count, 2)
    assertEqual(a.subtracting(b).count, 3)
    assert(BitSet([2, 3]).isSubset(of: a))
    assert(!b.isSubset(of: a), "4 is not in a")
}

@test
fn insertAddsEachValueOnce() {
    let members = BitSet()
    assert(members.isEmpty)
    assert(members.insert(70))
    assert(!members.insert(70))
    assert(members.insert(0))
    assertEqual(members.count, 2)
    assert(!members.isEmpty)
    assert(members.contains(70))
    assert(!members.contains(71))
    assert(!members.contains(1000))
    assert(!members.contains(-1))
}

@test(traps: "array index out of range")
fn insertingANegativeValueTraps() {
    let members = BitSet()
    let _ = members.insert(-1)
}

@test
fn removeTakesOutAValue() {
    let members = BitSet([3, 130])
    assert(members.remove(130))
    assert(!members.remove(130))
    assert(!members.remove(5))
    assertEqual(members.count, 1)
    assert(members.toArray() == [3])
}

@test
fn elementsAreAscending() {
    let members = BitSet([200, 1, 64, 63, 0])
    assert(members.toArray() == [0, 1, 63, 64, 200])
    members.removeAll()
    assertEqual(members.count, 0)
    assertEqual(members.toArray().count, 0)
}

@test
fn algebraWithSetsOfDifferentLengths() {
    let short = BitSet([1, 2])
    let long = BitSet([2, 300])
    assert(short.union(long).toArray() == [1, 2, 300])
    assert(long.union(short).toArray() == [1, 2, 300])
    assert(short.intersection(long).toArray() == [2])
    assert(long.subtracting(short).toArray() == [300])
    assert(short.subtracting(long).toArray() == [1])
    assert(!long.isSubset(of: short))
    assert(BitSet([2]).isSubset(of: long))
    assert(BitSet().isSubset(of: short))
}

@test
fn aBitSetIsMadeFromAnySequenceOfInts() {
    let small = BitSet(1...3)
    assertEqual(small.count, 3)
    assert(small.contains(2))
    let collected: BitSet = [5, 5, 64].collect()
    assertEqual(collected.count, 2)
    assert(collected.contains(64))
}

@test
fn bitSetsCombineAndCompare() {
    let a = BitSet([1, 2, 3, 100])
    let b = BitSet([3, 4, 100])
    assert(a.symmetricDifference(b).toArray() == [1, 2, 4])
    assert(BitSet([1, 2]).isDisjoint(with: BitSet([3, 64])))
    assert(!a.isDisjoint(with: b))
    assert(a.isSuperset(of: BitSet([1, 100])))
    assert(BitSet([1]).isStrictSubset(of: a))
    assert(!a.isStrictSubset(of: a))
    assert(a.isStrictSuperset(of: BitSet([2])))
    let c = BitSet([1, 2])
    c.formUnion(BitSet([200]))
    assert(c.toArray() == [1, 2, 200])
    c.formIntersection(BitSet([2, 200, 300]))
    assert(c.toArray() == [2, 200])
    c.subtract(BitSet([2]))
    assert(c.toArray() == [200])
    c.formSymmetricDifference(BitSet([200, 7]))
    assert(c.toArray() == [7])
    assertEqual(c.count, 1)
}

@test
fn aBitSetKnowsItsLeastGreatestAndARange() {
    let bits = BitSet([70, 3, 9, 128])
    assertEqual(bits.min, 3)
    assertEqual(bits.max, 128)
    assert(BitSet().min == none && BitSet().max == none)
    assert(bits.members(in: 4..<129) == [9, 70, 128])
    assert(bits.members(in: 0..<3) == [] as Int[>..])
    assert(bits.members(in: -5..<1000) == [3, 9, 70, 128])
    assert(bits.members(in: 64..<128) == [70])
}
