module BinaryFloatingPointRandomTests

// Random floating-point values in a range (BinaryFloatingPoint+Random.sb,
// Sable.Core).

import Sable.Testing
import CoreTestSupport
import RandomStatistics

@test
fn aHalfOpenRangeStaysBelowItsUpperBound() {
    var generator = SeededRandomNumberGenerator(seed: 20)
    var sum = 0.0
    var i = 0
    while i < 1000 {
        let x = F64.random(in: 2.0..<4.0, using: &generator)
        assert(x >= 2.0 && x < 4.0, "\(x)")
        sum += x
        i += 1
    }
    // Spread evenly: the mean is near the middle.
    expect(sum / 1000.0 > 2.9 && sum / 1000.0 < 3.1)
}

@test
fn aClosedRangeStaysWithinItsBounds() {
    var generator = SeededRandomNumberGenerator(seed: 21)
    var i = 0
    while i < 200 {
        let x = F32.random(in: -1.0...1.0, using: &generator)
        assert(x >= -1.0 && x <= 1.0, "\(x)")
        let h = F16.random(in: 0.0..<1.0, using: &generator)
        assert(h >= 0.0 && h < 1.0, "\(h)")
        i += 1
    }
}

@test
fn aRangeOfOneValueGivesIt() {
    var generator = SeededRandomNumberGenerator(seed: 22)
    assertEqual(F64.random(in: 1.5...1.5, using: &generator), 1.5)
}

@test
fn theSystemsGeneratorIsTheDefault() {
    let x = F64.random(in: 0.0..<1.0)
    expect(x >= 0.0 && x < 1.0)
    let y = F32.random(in: 5.0...6.0)
    expect(y >= 5.0 && y <= 6.0)
}

@test(traps: "a random value of an empty range")
fn anEmptyRangeTraps() {
    _ = F64.random(in: 1.0..<1.0)
}

@test(traps: "a random value of a range that is not finite")
fn anInfiniteRangeTraps() {
    _ = F64.random(in: 0.0..<F64.infinity)
}

@test(traps: "a random value of a range that is not finite")
fn anInfiniteClosedRangeTraps() {
    _ = F32.random(in: -F32.infinity...0.0)
}

@test(traps: "a random value of an empty range")
fn anUpsideDownClosedRangeTraps() {
    _ = F64.random(in: ClosedRange(lowerBound: 2.0, upperBound: 1.0))
}

// The least and the greatest of many draws, of a range of few values.
fn extremes<T: BinaryFloatingPoint>(_ range: Range<T>) -> (T, T) {
    var generator = SeededRandomNumberGenerator(seed: 23)
    var least = range.upperBound
    var greatest = range.lowerBound
    for _ in 0..<2000 {
        let x = T.random(in: range, using: &generator)
        assert(x >= range.lowerBound && x < range.upperBound, "\(x)")
        least = x < least ? x : least
        greatest = x > greatest ? x : greatest
    }
    return (least, greatest)
}

fn extremes<T: BinaryFloatingPoint>(closed range: ClosedRange<T>) -> (T, T) {
    var generator = SeededRandomNumberGenerator(seed: 24)
    var least = range.upperBound
    var greatest = range.lowerBound
    for _ in 0..<2000 {
        let x = T.random(in: range, using: &generator)
        assert(x >= range.lowerBound && x <= range.upperBound, "\(x)")
        least = x < least ? x : least
        greatest = x > greatest ? x : greatest
    }
    return (least, greatest)
}

@test
fn aHalfOpenRangeReachesItsLowerBoundAndTheValueBelowItsUpper() {
    let x = 1.0
    let up = x.nextUp.nextUp.nextUp
    let (least, greatest) = extremes(x..<up)
    assertEqual(least, x)
    assertEqual(greatest, x.nextUp.nextUp)
    let (low, high) = extremes(-up..<(-x))
    assertEqual(low, -up)
    assertEqual(high, (-x).nextDown)
}

@test
fn aClosedRangeReachesBothItsBounds() {
    let x = 1.0
    let up = x.nextUp.nextUp.nextUp
    let (least, greatest) = extremes(closed: x...up)
    assertEqual(least, x)
    assertEqual(greatest, up)
    let (low, high) = extremes(closed: -up...(-x))
    assertEqual(low, -up)
    assertEqual(high, -x)

    // A bound that is no multiple of the spacing is reached all the same.
    let tiny = F64.leastNonzeroMagnitude
    let (first, second) = extremes(closed: tiny...(tiny + tiny))
    assertEqual(first, tiny)
    assertEqual(second, tiny + tiny)
}

@test
fn theLastStepOfAClosedRangeIsExactlyItsBound() {
    // Scaling a fraction gives the lower bound plus the width, which rounds
    // short of or past an upper bound as far below it as these.
    var top = Scripted([U64.max, 0])
    assertEqual(F64.random(in: -489861948521.1566...(-7.312715117751976e-16), using: &top), -7.312715117751976e-16)
    var bottom = Scripted([0x8000000000000000, 0])
    let x = F64.random(in: -489861948521.1566...(-7.312715117751976e-16), using: &bottom)
    expect(x < -2e11 && x > -3e11)
}

@test
fn theValuesOfANarrowRangeAreAsLikelyAsEachOther() {
    // Rounding to the nearest would give the ends half the share of the rest.
    var generator = SeededRandomNumberGenerator(seed: 25)
    var halfOpen = zeroCounts(5)
    var closed = zeroCounts(6)
    let x = 1.0
    let ulp = x.ulp
    let upper = x + 5.0 * ulp
    for _ in 0..<10000 {
        halfOpen[Int.fromWideValue((F64.random(in: x..<upper, using: &generator) - x) / ulp)] += 1
        closed[Int.fromWideValue((F64.random(in: x...upper, using: &generator) - x) / ulp)] += 1
    }
    assertEven(halfOpen)
    assertEven(closed)
}

@test
fn everyStepOfAUnitRangeIsAsLikely() {
    // F16's are the multiples of 2^-11, 2048 of them, and BF16's of 2^-8.
    var generator = SeededRandomNumberGenerator(seed: 26)
    var halves = zeroCounts(2048)
    var brains = zeroCounts(256)
    var signed = zeroCounts(4096)
    for _ in 0..<100000 {
        let h = F16.random(in: 0.0..<1.0, using: &generator).wideValue * 2048.0
        assertEqual(h, h.floor())
        halves[Int.fromWideValue(h)] += 1
        let b = BF16.random(in: 0.0..<1.0, using: &generator).wideValue * 256.0
        assertEqual(b, b.floor())
        brains[Int.fromWideValue(b)] += 1
        signed[Int.fromWideValue(F16.random(in: -1.0..<1.0, using: &generator).wideValue * 2048.0) + 2048] += 1
    }
    assertEven(halves)
    assertEven(brains)
    assertEven(signed)
}

@test
fn anF64OfTheUnitRangeIsAMultipleOfTwoToTheMinus53() {
    var generator = SeededRandomNumberGenerator(seed: 27)
    var counts = zeroCounts(256)
    var lowBits = zeroCounts(256)
    for _ in 0..<50000 {
        let scaled = F64.random(in: 0.0..<1.0, using: &generator) * 9007199254740992.0
        assertEqual(scaled, scaled.floor())
        let k = U64.fromWideValue(scaled)
        counts[Int(k >> 45)] += 1
        lowBits[Int(k & 255)] += 1
    }
    assertEven(counts)
    assertEven(lowBits)
}

@test
fn aRangeAsWideAsTheTypeIsEven() {
    // Its width overflows, its values and their spacing do not.
    var generator = SeededRandomNumberGenerator(seed: 28)
    let greatest = F64.greatestFiniteMagnitude
    var counts = zeroCounts(16)
    var narrow = zeroCounts(16)
    for _ in 0..<8000 {
        let x = F64.random(in: -greatest...greatest, using: &generator)
        assert(x.isFinite, "\(x)")
        counts[Int.fromWideValue((x / greatest + 1.0) * 7.999999)] += 1
        let h = F16.random(in: -F16.greatestFiniteMagnitude..<F16.greatestFiniteMagnitude, using: &generator)
        assert(h.isFinite, "\(h)")
        narrow[Int.fromWideValue((h.wideValue / 65504.0 + 1.0) * 7.999999)] += 1
    }
    assertEven(counts)
    assertEven(narrow)
}

@test
fn aRangeOfSubnormalsIsEven() {
    var generator = SeededRandomNumberGenerator(seed: 29)
    let tiny = F64.leastNonzeroMagnitude
    var counts = zeroCounts(10)
    for _ in 0..<5000 {
        counts[Int.fromWideValue(F64.random(in: 0.0..<(10.0 * tiny), using: &generator) / tiny)] += 1
    }
    assertEven(counts)
}
