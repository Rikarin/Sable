    (#"(?<x>ab)\k<x>"#, "abab", "0-4 0-2"),
    (#"(?<x>ab)\k'x'\k{x}"#, "ababab", "0-6 0-2"),
    (#"(\w+) \1"#, "hello hello world", "0-11 0-5"),
    (#"(a)|\1b"#, "b", "none"),
    ("foo(?=bar)", "foobar", "0-3"),
    ("foo(?!bar)", "foobar", "none"),
    ("foo(?!bar)", "foobaz", "0-3"),
    (#"(?<=\$)\d+"#, "cost $42", "6-8"),
    (#"(?<!\$)\b\d+"#, "$1 2", "3-4"),
    ("(?<=ab|b)c", "abc", "2-3"),
    ("(?<=é)x", "éx", "2-3"),
    ("(?=(a+))a*b", "aaab", "0-4 0-3"),
    ("(?!(a))b", "b", "0-1 -"),
    ("(?>a+)b", "aaab", "0-4"),
    ("(?>a+)ab", "aaab", "none"),
    ("(?>(a+))b", "aab", "0-3 0-2"),
    ("a++b", "aab", "0-3"),
    ("a++a", "aaa", "none"),
    ("a?+a", "a", "none"),
    ("(x)*+y", "xxy", "0-3 1-2"),
    ("(a*)*b", "aab", "0-3 0-2"),
])
fn backtrackingAddsBackReferencesAndLookaround(_ pattern: String, _ text: String, _ expected: String) throws(RegexError) {
    try checkBacktracking(pattern, text, expected)
}

@test(arguments: [
    ("(", .UnclosedGroup, 0),
    ("a(b|c", .UnclosedGroup, 1),
    ("(?i", .UnclosedGroup, 0),
    ("(?#abc", .UnclosedGroup, 0),
    ("a)", .UnopenedGroup, 1),
    ("[a", .UnclosedClass, 0),
    ("[a\\", .UnclosedClass, 0),
    ("[a-\\", .UnclosedClass, 0),
    ("[z-a]", .InvalidRange, 1),
    ("[a-\\d]", .InvalidRange, 1),
    ("[\\d-z]", .InvalidRange, 1),
    ("[a-[b]]", .InvalidRange, 1),
    ("\\", .InvalidEscape, 0),
    ("ab\\q", .InvalidEscape, 2),
    ("\\x{110000}", .InvalidEscape, 0),
    ("\\x{D800}", .InvalidEscape, 0),
    ("\\xZZ", .InvalidEscape, 0),
    ("\\x{}", .InvalidEscape, 0),
    ("\\x{12", .InvalidEscape, 0),
    ("\\é", .InvalidEscape, 0),
    ("*a", .NothingToRepeat, 0),
    ("a**", .NothingToRepeat, 2),
    ("x{2}{3}", .NothingToRepeat, 4),
    ("a|?", .NothingToRepeat, 2),
    ("a{3,2}", .InvalidRepetition, 1),
    ("a{2", .InvalidRepetition, 1),
    ("a{100001}", .InvalidRepetition, 1),
    ("\\p{Greek}", .UnknownProperty, 0),
    ("\\p{L", .UnknownProperty, 2),
    ("\\p", .UnknownProperty, 0),
    ("[[:nope:]]", .UnknownProperty, 1),
    ("(?<1a>x)", .InvalidGroupName, 3),
    ("(?<>x)", .InvalidGroupName, 3),
    ("(?<a", .InvalidGroupName, 0),
    ("(?<a>x)(?<a>y)", .InvalidGroupName, 7),
    ("(?z)", .InvalidFlag, 2),
    ("(?i-)", .InvalidFlag, 4),
    ("(?i--m)", .InvalidFlag, 4),
    ("(a)\\1", .NeedsBacktracking, 3),
    ("\\k<a>", .NeedsBacktracking, 0),
    ("(?=a)", .NeedsBacktracking, 0),
    ("(?<!a)", .NeedsBacktracking, 0),
    ("(?>a)", .NeedsBacktracking, 0),
    ("a*+", .NeedsBacktracking, 1),
    ("(a{1000}){1000}", .TooLarge, 0),
])
fn errorsSayWhatAndWhere(_ pattern: String, _ kind: RegexErrorKind, _ offset: Int) {
    let error = expectThrows(RegexError.self) { _ = try Regex(pattern) }
    expect(error?.kind == kind && error?.offset == offset, error?.message ?? "")
}

@test(arguments: [
    ("(a)\\2", .UnknownGroup, 3),
    ("\\k<nope>", .UnknownGroup, 0),
    ("\\kx", .InvalidEscape, 0),
])
fn errorsOfBacktrackingSayWhatAndWhere(_ pattern: String, _ kind: RegexErrorKind, _ offset: Int) {
    let error = expectThrows(RegexError.self) { _ = try Regex(pattern, options: .Backtracking) }
    expect(error?.kind == kind && error?.offset == offset, error?.message ?? "")
}

@test
fn anErrorDescribesItself() {
    expectThrows(RegexError(.UnclosedClass, at: 2, "unclosed character class")) { _ = try Regex("ab[c") }
    let thrown = require(expectThrows(RegexError.self) { _ = try Regex("ab[c") })
    expect(thrown.description() == "regex error at 2: unclosed character class")
    expect("\(thrown:?)" == "regex error at 2: unclosed character class")
    expect(thrown != RegexError(.UnclosedGroup, at: 2, "unclosed character class"))
    expect(thrown != RegexError(.UnclosedClass, at: 3, "unclosed character class"))
    expect(thrown != RegexError(.UnclosedClass, at: 2, "unclosed class"))
}

@test
fn anErrorsOffsetCountsBytes() {
    let error = expectThrows(RegexError.self) { _ = try Regex("é(") }
    expect(error?.offset == 2)
}

/// The spans of every match, as text.
fn allSpans(_ regex: Regex, _ text: String) -> String {
    var parts: String[>..] = []
    for found in regex.matches(in: text) {
        parts.append("\(found.range.lowerBound.utf8Offset)-\(found.range.upperBound.utf8Offset)")
    }
    return parts.joined(separator: " ")
}

@test(arguments: [
    ("a*", "baaab", "0-0 1-4 5-5"),
    ("", "aé", "0-0 1-1 3-3"),
    (#"\d+"#, "1 22 333", "0-1 2-4 5-8"),
    ("a|", "aba", "0-1 2-3"),
    (#"\b"#, "ab cd", "0-0 2-2 3-3 5-5"),
    ("^", "abc", "0-0"),
    ("(?m)^", "a\nb\n", "0-0 2-2 4-4"),
])
fn matchesSkipAnEmptyMatchRightAfterAnother(_ pattern: String, _ text: String, _ expected: String) throws(RegexError) {
    expect(allSpans(try Regex(pattern), text) == expected)
    expect(allSpans(try Regex(pattern, options: .Backtracking), text) == expected)
}

@test
fn matchesAreIteratedCountedAndCompared() {
    let words = try! Regex(#"\w+"#)
    assertEqual(words.count(in: "the quick brown fox"), 4)
    assertEqual(words.count(in: ""), 0)
    var texts: String[>..] = []
    for found in words.matches(in: "one two") {
        texts.append(found.toString())
        expect(!found.isEmpty)
        assertEqual(found.base, "one two")
    }
    expect(texts == ["one", "two"])
    let first = words.firstMatch(in: "one two")!
    assertEqual(first, words.firstMatch(in: "one two")!)
    assertEqual("\(first:?)", #"0..<3 "one""#)
    assertNotEqual(first, words.firstMatch(in: "one, two")!)
    assertNotEqual(first, words.firstMatch(in: " one two")!)
    assertNotEqual(first, words.firstMatch(in: "o two")!)
    var keys: String[>..] = []
    for pair in (try! Regex(#"(\w)=(\d)"#)).allCaptures(in: "a=1, b=2, c=x") {
        keys.append(pair[1]!.toString() + pair[2]!.toString())
    }
    expect(keys == ["a1", "b2"])
}

@test
fn literalsAreSearchedForDirectly() {
    let regex = try! Regex("needle")
    let text = "hay hay hay needle hay needle"
    assertEqual(allSpans(regex, text), "12-18 23-29")
    expect(regex.isMatch(text))
    expect(!regex.isMatch("haystack"))
    assertEqual(spans(regex, text), "12-18")
    assertEqual(text.firstIndex(of: regex)!.utf8Offset, 12)
    assertEqual(text.trimmingSuffix(regex), "hay hay hay needle hay ")
    assertEqual("needles".trimmingPrefix(regex), "s")
    assertEqual("xneedles".trimmingPrefix(regex), "xneedles")
    assertEqual("ne".trimmingSuffix(regex), "ne")
    // A literal prefix narrows where the automaton starts.
    let prefixed = try! Regex(#"needle\d+"#)
    assertEqual(allSpans(prefixed, "needle needle12 needle3x"), "7-15 16-23")
    assertEqual(allSpans(try! Regex(#"needle\d+"#, options: .Backtracking), "needle needle12 needle3x"), "7-15 16-23")
}

@test(arguments: [RegexOptions.None, RegexOptions.Backtracking])
fn aSubstringIsSearchedAsATextOfItsOwn(_ options: RegexOptions) {
    let text = "ab cd ef"
    let middle = text[text.index(text.startIndex, offsetBy: 3)..<text.index(text.startIndex, offsetBy: 5)]
    let regex = try! Regex(#"^\w+$"#, options: options)
    let found = regex.firstMatch(in: middle)!
    assertEqual(found.range.lowerBound.utf8Offset, 3)
    assertEqual(found.text.toString(), "cd")
    expect(regex.isMatch(middle))
    expect(!regex.isMatch(text))
    assertEqual(regex.captures(in: middle)!.range.upperBound.utf8Offset, 5)
    assertEqual(regex.count(in: middle), 1)
}

@test
fn stringSearchesTakeARegex() {
    let digits = try! Regex(#"\d+"#)
    let spaces = try! Regex(#"\s+"#)
    let text = "a1 b22  c333"
    assertEqual(text.firstIndex(of: digits)!.utf8Offset, 1)
    assertEqual(text.lastIndex(of: digits)!.utf8Offset, 9)
    assertEqual(text.lastRange(of: digits)!.upperBound.utf8Offset, 12)
    assertEqual(text.ranges(of: digits).count, 3)
    assertEqual(text.count(of: digits), 3)
    expect(text.contains(digits))
    expect(!"abc".contains(digits))
    expect(text.split(spaces) == ["a1", "b22", "c333"])
    expect(text.split(digits, omittingEmpty: true) == ["a", " b", "  c"])
    assertEqual("  x  ".trimmingPrefix(spaces), "x  ")
    assertEqual("x123".trimmingSuffix(digits), "x")
    assertEqual("123".trimmingSuffix(digits), "")
    expect("123abc".hasPrefix(digits) && !"abc123".hasPrefix(digits))
    expect("abc123".hasSuffix(digits) && !"123abc".hasSuffix(digits))
    assertEqual(text.replacing(digits, with: "#"), "a# b#  c#")
    assertEqual(text.replacing(digits, with: "<$0>", maxCount: 2), "a<1> b<22>  c333")
    assertEqual("abc".replacing(digits, with: "#"), "abc")
    let piece = Substring("x=1;y=22")
    assertEqual(piece.split(try! Regex("[;=]")).count, 4)
    // The automata's matchStart is a reverse search from the end; the
    // backtracker's tries each start.
    let backtracking = try! Regex(#"(\d)\1"#, options: .Backtracking)
    assertEqual("ab11".trimmingSuffix(backtracking), "ab")
    assertEqual("ab12".trimmingSuffix(backtracking), "ab12")
    assertEqual("11ab".trimmingPrefix(backtracking), "ab")
    let boundary = try! Regex(#"\b\w"#)
    assertEqual("ab cd".trimmingSuffix(boundary), "ab cd")
    assertEqual("ab c".trimmingSuffix(boundary), "ab ")
}

@test
fn templatesNameGroups() {
    let swap = try! Regex(#"(?<first>\w+) (?<second>\w+)"#)
    assertEqual("hello world".replacing(swap, with: "$2 $1"), "world hello")
    assertEqual("hello world".replacing(swap, with: "${second}_${first}"), "world_hello")
    assertEqual("hello world".replacing(swap, with: "$second$$"), "world$")
    assertEqual("hello world".replacing(swap, with: "[$3][$nope]"), "[][]")
    assertEqual("hello world".replacing(swap, with: "$ ${ $"), "$ ${ $")
    assertEqual("hello world".replacing(swap, with: "${}x"), "$x")
    assertEqual("hello world".replacing(swap, with: "${1}0"), "hello0")
    let found = swap.captures(in: "a b")!
    assertEqual(found.expand("$first-$second"), "a-b")
    let doubled = "3 apples and 12 pears".replacing(try! Regex(#"\d+"#), with: { found in
        return "\(try! Int.parse(found.text) * 2)"
    })
    assertEqual(doubled, "6 apples and 24 pears")
    let once = "a1b2".replacing(try! Regex(#"\d"#), maxCount: 1, with: { (unused: RegexCaptures) in
        return "!"
    })
    assertEqual(once, "a!b2")
}

@test(arguments: [RegexOptions.None, RegexOptions.Backtracking])
fn wholeMatchMatchesTheWholeText(_ options: RegexOptions) {
    let regex = try! Regex("a|ab", options: options)
    assertEqual(regex.wholeMatch("ab")!.range.upperBound.utf8Offset, 2)
    expect(regex.wholeMatch("abc") == none)
    expect(regex.wholeMatch("xab") == none)
    let groups = try! Regex(#"(\d+)-(\d+)"#, options: options)
    let found = groups.wholeMatch("12-345")!
    assertEqual(found[2]!.toString(), "345")
}

@test
fn escapeMakesAPatternOfAText() {
    let text = #"a.b*c+d?e(f)g[h]i{j}k|l^m$n\o#p-q&r~s t"#
    let regex = try! Regex(Regex.escape(text))
    expect(regex.wholeMatch(text) != none)
    assertEqual(Regex.escape("é1"), "é1")
    assertEqual(Regex.escape("1.5"), #"1\.5"#)
}

@test
fn optionsAndPatternAreKept() {
    let regex = try! Regex("a", options: [.IgnoreCase, .Multiline])
    assertEqual(regex.pattern, "a")
    expect(regex.options.contains(.IgnoreCase) && !regex.options.contains(.DotAll))
}

@test
fn matchesAllocateNothingOnceTheCacheIsWarm() {
    let words = try! Regex(#"\w+"#)
    let text = "the quick brown fox jumps over the lazy dog"
    assertEqual(words.count(in: text), 9)
    var total = 0
    assertNoAllocations {
        for found in words.matches(in: text) {
            total += found.range.upperBound.utf8Offset
        }
    }
    expect(total > 0)
    assertNoAllocations {
        assert(words.isMatch(text))
    }
}

// ---- The linear-time guarantee --------------------------------------------

@test(tags: ["slow"], timeout: .seconds(60))
fn pathologicalPatternsTakeLinearTime() {
    // Each of these takes a backtracker time exponential in the text.
    let manyA = "a".repeated(20000)
    expect(!(try! Regex("(a*)*b")).isMatch(manyA))
    expect(!(try! Regex("(a|aa)+b")).isMatch(manyA))
    expect(!(try! Regex("(a|a)*c")).isMatch(manyA))
    expect((try! Regex("(a|aa)+$")).isMatch(manyA))
    assertEqual((try! Regex("(x+x+)+y")).count(in: "x".repeated(20000)), 0)
    let words = "word ".repeated(4000) + "!"
    expect((try! Regex(#"^(\w+\s?)*$"#)).firstMatch(in: words) == none)
    // Every place a match may start, and every '@' it may have in it, read
    // past to the end for nothing.
    assertEqual((try! Regex("a[^z]*z")).count(in: manyA), 0)
    assertEqual((try! Regex("a+@[^z]*z")).count(in: "a@".repeated(20000)), 0)
    assertEqual((try! Regex("(?m)^a[^z]*z")).count(in: "a\n".repeated(20000)), 0)
    // The PikeVM, which finds the groups, is linear too.
    expect((try! Regex("(a|aa)*c")).wholeMatch("a".repeated(3000)) == none)
    let nested = try! Regex("((a+)+)+b")
    expect(nested.captures(in: "a".repeated(3000) + "b") != none)
    // A DFA that needs more states than its cache holds clears it and goes on.
    var random = SeededRandomNumberGenerator(seed: 229)
    var bytes: U8[>..] = []
    for _ in 0..<60000 {
        bytes.append(U8.random(in: 97...122, using: &random))
    }
    let letters = try! String.fromUtf8(bytes)
    let wide = try! Regex("[a-y]*a[a-y]{12}z")
    let backtracking = try! Regex("[a-y]*a[a-y]{12}z", options: .Backtracking)
    assertEqual(allSpans(wide, letters), allSpans(backtracking, letters))
}

// ---- The engines against each other --------------------------------------

/// A random pattern, and whether it can match the empty string. A loop of
/// such a pattern, as (a*?)+, is left out: where its iterations could match
/// nothing, the automata choose as RE2 and Rust do, and the backtracker as
/// Perl and .NET do, which are not always the same.
fn randomPattern(_ choices: Choices, _ depth: Int) -> (String, Bool) {
    let choice = choices.below(depth > 3 ? 6 : 14)
    if choice < 3 {
        return (["a", "b", "c"][choice], false)
    }
    if choice == 3 {
        return (["[ab]", ".", "[^a]", #"\w"#, "é"][choices.below(5)], false)
    }
    if choice == 4 {
        return (["^", "$", #"\b"#, #"\B"#, "(?m)^", "(?m)$", ""][choices.below(7)], true)
    }
    if choice == 5 {
        return ("(?i)" + ["a", "B", "é"][choices.below(3)], false)
    }
    let (first, firstEmpty) = randomPattern(choices, depth + 1)
    if choice < 9 {
        let (second, secondEmpty) = randomPattern(choices, depth + 1)
        return (first + second, firstEmpty && secondEmpty)
    }
    if choice < 11 {
        let (second, secondEmpty) = randomPattern(choices, depth + 1)
        return ("(" + first + "|" + second + ")", firstEmpty || secondEmpty)
    }
    if choice < 13 {
        let quantifiers: String[>..] = firstEmpty ? ["?", "{1,2}", "??", "{2}"] : ["*", "+", "?", "{1,2}", "*?", "+?", "??", "{2}"]
        let quantifier = quantifiers[choices.below(quantifiers.count)]
        let empty = firstEmpty || quantifier.hasPrefix("*") || quantifier.hasPrefix("?")
        return ("(?:" + first + ")" + quantifier, empty)
    }
    return ("(" + first + ")", firstEmpty)
}

/// What the automata and the backtracker must agree on, of a search.
fn expectTheSame(_ pattern: String, _ text: String) throws {
    let linear = try Regex(pattern)
    let backtracking = try Regex(pattern, options: .Backtracking)
    let expected = allSpans(backtracking, text)
    expect(allSpans(linear, text) == expected)
    expect(linear.isMatch(text) == !expected.isEmpty)
    expect(backtracking.isMatch(text) == !expected.isEmpty)
    expect(linear.count(in: text) == backtracking.count(in: text))
}

@test
fn theAutomataAndTheBacktrackerAgreeOnRandomPatterns() {
    let patterns = Gen<String>((choices) => randomPattern(choices, 0).0)
    let texts = Gen.string(of: Gen.element(of: ['a', 'b', 'c', 'A', 'é', ' ', '\n']), count: 0...11)
    forAll(patterns, texts, cases: 400) { (pattern: String, text: String) in
        try expectTheSame(pattern, text)
        let linear = try Regex(pattern)
        let backtracking = try Regex(pattern, options: .Backtracking)
        expect(linear.captures(in: text)?.range == backtracking.captures(in: text)?.range)
        expect(text.trimmingSuffix(linear) == text.trimmingSuffix(backtracking))
    }
}

// Texts long enough to be searched in by how a match starts, or by a
// character it has in it, and to have that given up.
@test
fn searchesByWhatAMatchHasAgreeWithTheBacktracker() {
    let patterns = Gen<String>((choices) => {
        let (pattern, isEmpty) = randomPattern(choices, 1)
        let kind = choices.below(4)
        if kind < 2 {
            let (after, _) = randomPattern(choices, 2)
            return (kind == 0 ? pattern.replacing(".", with: "b").replacing("[^a]", with: "é") : pattern) + "@" + after
        }
        if kind == 2 {
            return "(?m)^" + pattern
        }
        return isEmpty ? ["b", "ab", "[ac]", "é"][choices.below(4)] + pattern : pattern
    })
    let texts = Gen.string(of: Gen.element(of: ['a', 'b', 'c', 'A', 'é', ' ', '\n', '@', 'x', 'x']), count: 0...149)
    forAll(patterns, texts, cases: 300) { (pattern: String, text: String) in
        try expectTheSame(pattern, text)
        let piece = text[text.startIndex..<(text.firstIndex(of: "@") ?? text.endIndex)]
        expect(try Regex(pattern).count(in: piece) == Regex(pattern, options: .Backtracking).count(in: piece))
    }
}
