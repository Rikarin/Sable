module Examples.MemoryTiers

import Sable.IO

// ===========================================================================
// Tier 0 — inline, contiguous, no header, no refcount.
// @inline_layout makes the whole nested structure one pointer-free block.
// ===========================================================================

@inline_layout
public struct OrderLine {
    public var sku: U8[..16] // inline, bounded
    public var qty: U16
    public var price: U32 // cents
}

@inline_layout
public struct Order {
    public var id: U64
    public var customer: U8[..32]
    public var lines: OrderLine[>..] // grow-only, stored inline
    public var parent: Order&<u32>? // 4-byte relative ref, 0 == null

    public var total: U64 {
        get {
            var t: U64 = 0
            for line in lines {
                t += U64(line.qty) * U64(line.price)
            }
            return t
        }
    }
}

/// Zero-copy persistence: the value is already bytes.
fn save(_ order: Order) -> U8[>..] {
    return Bytes.of(order)
}

fn load(_ bytes: U8[>..]) -> Order? {
    // fromBytes validates framing, tags, lengths and every relative link
    // before returning. Corrupt input yields .Invalid, never a bad reference.
    match Order.fromBytes(bytes) {
        case .Ok(let o)        => { return o }
        case .Invalid(let why) => { print("rejected order: \(why)") }
    }
    return none
}

// ===========================================================================
// Tier 1 — regions. Bump-allocated, freed in one store at scope exit.
// References into a region have an inferred root; nothing escapes.
// ===========================================================================

public struct Expr {
    public var op: Char // '+', '*', or '#' for a number
    public var value: F64
    public var left: Expr&?
    public var right: Expr&?
}

/// A recursive-descent parser for sums of products of digits, building its
/// tree in the region it is given. Every node's root is inferred as 'r'.
fn parseSum(_ text: String, _ at: inout Int, in r: region) -> Expr& {
    var left = parseProduct(text, &at, in: r)
    while at < text.count && text.at(index: at) == '+' {
        at += 1
        let right = parseProduct(text, &at, in: r)
        left = r.alloc(Expr { op: '+', value: 0, left: left, right: right })
    }
    return left
}

fn parseProduct(_ text: String, _ at: inout Int, in r: region) -> Expr& {
    var left = parseNumber(text, &at, in: r)
    while at < text.count && text.at(index: at) == '*' {
        at += 1
        let right = parseNumber(text, &at, in: r)
        left = r.alloc(Expr { op: '*', value: 0, left: left, right: right })
    }
    return left
}

fn parseNumber(_ text: String, _ at: inout Int, in r: region) -> Expr& {
    var value = 0.0
    while at < text.count && text.at(index: at).isDigit {
        value = value * 10 + F64(text.at(index: at).codePoint - 48)
        at += 1
    }
    return r.alloc(Expr { op: '#', value: value, left: none, right: none })
}

fn evaluate(_ e: Expr&) -> F64 {
    if e.op == '+' {
        return evaluate(e.left!) + evaluate(e.right!)
    }
    if e.op == '*' {
        return evaluate(e.left!) * evaluate(e.right!)
    }
    return e.value
}

fn calculate(_ source: String) -> F64 {
    region arena {
        var at = 0
        let root = parseSum(source, &at, in: arena) // root inferred as 'arena'
        return evaluate(root) // an owned F64 leaves
    } // entire arena freed: one store
}

// This would be rejected — the compiler infers that the returned reference is
// rooted in a region that dies at the end of the function:
//
//   fn bad(_ source: String) -> Expr& {
//       region r {
//           var at = 0
//           return parseSum(source, &at, in: r)
//       }
//   }
//
//   error[S3061]: cannot return a reference rooted in region 'r': it dies
//   when the function returns. To fix it: return a copy of the value, out of
//   the region; or allocate it in a region the caller passes

// ===========================================================================
// Tier 2 — classes. Identity, ARC, weak references, reflection.
// ===========================================================================

public struct DrawCall {
    public var path: String
    public var frame: Int
}

@reflectable
public class Workspace {
    public private(set) var documents: Document[>..] = []
    private var frames: Int = 0

    public init() { }

    public fn open(_ path: String) -> Document {
        let doc = Document(path: path, owner: self)
        documents.append(doc)
        return doc
    }

    /// Per-frame work: its scratch lives in a region, released in one store.
    public fn render() -> Int {
        frames += 1
        var drawn = 0
        region frame {
            for d in documents {
                if d.isVisible {
                    let call = frame.alloc(DrawCall { path: d.path, frame: frames })
                    d.draw(call) // borrowed — zero ARC traffic
                    drawn += 1
                }
            }
        }
        return drawn
    }
}

public class Document {
    public var path: String
    public weak var owner: Workspace? // breaks the reference cycle
    public var isVisible = true

    public init(path: String, owner: Workspace) {
        self.path = path
        self.owner = owner
    }

    deinit { print("closing \(path)") }

    fn draw(_ call: DrawCall&) {
        print("frame \(call.frame): \(call.path)")
    }
}

// ===========================================================================
// Move-only resources: use-after-move is a compile error.
// ===========================================================================

/// A scratch file that exists exactly as long as its handle.
@noncopy
public struct ScratchFile {
    public let path: String

    public static fn create(_ path: String, _ text: String) throws(IoError) -> ScratchFile {
        try File.write(path, text)
        return ScratchFile { path: path }
    }

    public fn read() throws(IoError) -> String {
        return try File.read(path)
    }

    deinit {
        try? File.remove(path)
        print("removed \(Path.fileName(path))")
    }
}

fn copyThrough(_ text: String, inside directory: String) throws(IoError) -> String {
    using let input = try ScratchFile.create(Path.join(directory, "tiers-input.txt"), text)
    using let output = try ScratchFile.create(Path.join(directory, "tiers-output.txt"), try input.read())
    return try output.read()
    // both files removed here, in reverse order
}

// A handle is moved, never copied, so it is removed exactly once:
//
//   let kept = input
//   print(try input.read())
//
//   error[S3057]: 'input' is used after its value was moved out of it, at
//   line 1; 'Examples.MemoryTiers.ScratchFile' is @noncopy, so using it moves it

// ===========================================================================

@main
fn main() {
    var order = Order { id: 7, customer: "Ann", lines: [], parent: none }
    order.lines.append(OrderLine { sku: "A-1", qty: 2, price: 1999 })
    order.lines.append(OrderLine { sku: "B-22", qty: 1, price: 500 })
    let bytes = save(order)
    print("order \(order.id) is \(bytes.count) bytes, total \(order.total)")
    if let copy = load(bytes) {
        print("loaded order \(copy.id) for \(copy.customer.toString()), total \(copy.total)")
    }
    var corrupt = bytes
    corrupt.append(0)
    if load(corrupt) == none {
        print("the corrupt copy was refused")
    }

    print("1+2*3+4*5 = \(calculate("1+2*3+4*5"))")

    let workspace = Workspace()
    let notes = workspace.open("notes.md")
    let plan = workspace.open("plan.md")
    plan.isVisible = false
    print("drew \(workspace.render())")
    print("\(notes.path) belongs to a workspace: \(notes.owner != none)")

    let directory = Environment.variable("TMPDIR") ?? Environment.variable("TEMP") ?? "/tmp"
    do {
        let copied = try copyThrough("tiers", inside: directory)
        print("copied: \(copied)")
    } catch .NotFound(let path) {
        print("not found: \(path)")
    } catch .Failed(let path) {
        print("could not write \(path)")
    } catch {
        print(error.description())
    }
}
