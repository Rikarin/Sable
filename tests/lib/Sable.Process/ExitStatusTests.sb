module ExitStatusTests

// ExitStatus (Sable.Process), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Process

import Sable.Process
import Sable.Testing

@test
fn aStatusOfZeroIsASuccess() {
    let status = ExitStatus(code: 0)
    expect(status.success)
    expect(status.code == 0)
    expect(status.signal == none)
    assertEqual(status.shellStatus, 0)
    assertEqual(status.description(), "exit status 0")
}

@test
fn anyOtherStatusIsNot() {
    let status = ExitStatus(code: 3)
    expect(!status.success)
    assertEqual(status.shellStatus, 3)
}

@test
fn oneASignalEndedHasNoCode() {
    let status = ExitStatus(signal: .Terminate)
    expect(!status.success)
    expect(status.code == none)
    expect(status.signal! == Signal.Terminate)
    assertEqual(status.shellStatus, 143)
    assertEqual(status.description(), "signal TERM")
}

@test
fn endingWithTheShellsStatusIsNotEndingByTheSignal() {
    expect(ExitStatus(code: 143) != ExitStatus(signal: .Terminate))
    expect(ExitStatus(signal: .Kill) == ExitStatus(signal: .Kill))
    expect(ExitStatus(code: 1) == ExitStatus(code: 1))
    expect(ExitStatus(code: 1) != ExitStatus(code: 2))
}
