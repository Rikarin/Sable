module HexTests

// Hex (Sable.Text), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Testing
import Sable.Text
import TextSupport

@test(arguments: [
    ("", ""),
    ("f", "66"),
    ("fo", "666F"),
    ("foo", "666F6F"),
    ("foob", "666F6F62"),
    ("fooba", "666F6F6261"),
    ("foobar", "666F6F626172"),
])
fn theRfc4648Base16TestVectors(_ text: String, _ encoded: String) throws(DecodeError) {
    assertEqual(Hex.encode(text.utf8Bytes(), uppercase: true), encoded)
    assertBytes(try Hex.decode(encoded), text.utf8Bytes())
}

@test
fn everyByteValueRoundTripsInEitherCase() {
    var bytes: U8[>..] = []
    var value = 0
    while value < 256 {
        bytes.append(U8(value))
        value += 1
    }
    let lower = Hex.encode(bytes)
    let upper = Hex.encode(bytes, uppercase: true)
    assertEqual(lower.utf8Count, 512)
    expect(lower.hasPrefix("000102") && lower.hasSuffix("fdfeff"), "two lower-case digits a byte, high first")
    assertEqual(upper, lower.uppercased())
    assertBytes(try! Hex.decode(lower), bytes)
    assertBytes(try! Hex.decode(upper), bytes)
}

@test
fn encodingIntoABufferAppendsTheDigits() {
    var buffer = ByteBuffer()
    let bytes: U8[>..] = [0x0A, 0xBC]
    Hex.encode(bytes, into: &buffer)
    Hex.encode(bytes, into: &buffer, uppercase: true)
    assertBytes(buffer.bytes, "0abc0ABC".utf8Bytes())
}

@test
fn decodingBytesAndSubstrings() {
    assertBytes(try! Hex.decode(bytes: "c0ffee".utf8Bytes()), [0xC0, 0xFF, 0xEE])
    let text = "0x7f"
    assertBytes(try! Hex.decode(text[text.index(text.startIndex, offsetBy: 2)...]), [0x7F])
}

@test(arguments: [
    ("0g", .InvalidCharacter(at: 1, byte: 0x67)),
    ("g0", .InvalidCharacter(at: 0, byte: 0x67)),
    ("0x7f", .InvalidCharacter(at: 1, byte: 0x78)),
    ("00 11", .InvalidCharacter(at: 2, byte: 0x20)),
    ("00=", .InvalidCharacter(at: 2, byte: 0x3D)),
    ("0=", .InvalidCharacter(at: 1, byte: 0x3D)),
])
fn aNonDigitIsNamedWithItsOffset(_ text: String, _ error: DecodeError) {
    expectThrows(error) { _ = try Hex.decode(text) }
}

@test(arguments: [("a", .InvalidLength(at: 0)), ("abc", .InvalidLength(at: 2))])
fn anOddNumberOfDigitsIsTheWrongLength(_ text: String, _ error: DecodeError) {
    expectThrows(error) { _ = try Hex.decode(text) }
}

// ---- Against the definition, a digit at a time ---------------------------
// Every length from 0 to 130 and from several starts, so that each of the
// loops that take many at once, and what they leave, is held to it.

fn plainHex(_ bytes: U8[:], _ digits: String) -> U8[>..] {
    let table = digits.utf8Bytes()
    var text: U8[>..] = []
    for byte in bytes {
        text.append(table[Int(byte) / 16])
        text.append(table[Int(byte) % 16])
    }
    return text
}

@test
fn everyLengthAndStartEncodesAsEachByteDoes() {
    let all = sample(140)
    for start in 0..<4 {
        for n in 0...130 {
            let bytes = all[start..<(start + n)]
            assertBytes(Hex.encode(bytes).utf8Bytes(), plainHex(bytes, "0123456789abcdef"))
            assertBytes(Hex.encode(bytes, uppercase: true).utf8Bytes(), plainHex(bytes, "0123456789ABCDEF"))
            // Digits outside the slice are not read: they would be decoded.
            var text: U8[>..] = [0x30, 0x31, 0x32]
            text.append(contentsOf: plainHex(bytes, n % 2 == 0 ? "0123456789abcdef" : "0123456789ABCDEF"))
            let end = text.count
            text.append(contentsOf: [0x66, 0x67, 0x68])
            assertBytes(try! Hex.decode(bytes: text[3..<end]), bytes)
            var buffer = ByteBuffer()
            buffer.write([0xAA])
            Hex.encode(bytes, into: &buffer)
            assertEqual(buffer.count, 2 * n + 1)
            assertBytes(buffer.bytes[1...], plainHex(bytes, "0123456789abcdef"))
        }
    }
}

@test(arguments: [2, 30, 32, 34, 64, 70, 96])
fn everyByteThatIsNoDigitIsFoundAtEveryPosition(_ n: Int) {
    let digits = "0123456789abcdefABCDEF".utf8Bytes()
    var text = plainHex(sample(n / 2, seed: 7), "0123456789abcdef")
    for at in 0..<n {
        let held = text[at]
        for value in 0..<256 {
            text[at] = U8(value)
            var thrown: DecodeError? = none
            do {
                _ = try Hex.decode(bytes: text)
            } catch {
                thrown = error
            }
            if digits.contains(U8(value)) {
                assertEqual(thrown, none)
            } else {
                assertEqual(thrown, .InvalidCharacter(at: at, byte: U8(value)))
            }
        }
        text[at] = held
    }
}

@test
fn anyBytesRoundTrip() {
    forAll { (bytes: U8[>..]) in
        let text = Hex.encode(bytes)
        expect(text.count == bytes.count * 2)
        expect(try Hex.decode(text) == bytes)
        expect(try Hex.decode(text.uppercased()) == bytes)
    }
}

// What decoding says of text that is not hexadecimal is of a digit in it,
// whatever the text is.
@test
fn anyTextDecodesOrSaysWhereNot() {
    forAll(Gen.ascii()) { (text: String) in
        do {
            let bytes = try Hex.decode(text)
            expect(Hex.encode(bytes) == text.lowercased())
        } catch {
            expect(text.count % 2 == 1 || text.contains(where: { !$0.isHexDigit }))
        }
    }
}
