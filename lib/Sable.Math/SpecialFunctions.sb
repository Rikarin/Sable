module Sable.Math

// The gamma and error functions, of any float with the elementary
// functions (ElementaryFunctions.sb): C99's tgamma, lgamma, erf and erfc,
// from libm.

/// The gamma function, which extends the factorial: gamma(n) is (n - 1)!
/// at a positive integer n. A pole (±inf) at 0, NaN at a negative integer
/// and at -inf, and +inf past where it overflows (a little above 171 for
/// an F64).
///
/// ```sable
/// assert(gamma(5.0) == 24.0)
/// ```
public fn gamma<T: ElementaryFunctions>(_ x: T) -> T => T.gamma(x)

/// The natural logarithm of |gamma(x)|, which stays finite far past where
/// gamma overflows: +inf at 0 and at every negative integer.
public fn logGamma<T: ElementaryFunctions>(_ x: T) -> T => T.logGamma(x)

/// The error function, 2/sqrt(pi) times the integral of e^(-t²) from 0 to
/// x: odd, in [-1, 1], ±1 at the infinities.
public fn erf<T: ElementaryFunctions>(_ x: T) -> T => T.erf(x)

/// The complementary error function, 1 - erf(x), without the loss of
/// that difference where erf(x) is near 1: in [0, 2].
public fn erfc<T: ElementaryFunctions>(_ x: T) -> T => T.erfc(x)
