module Sable.Core

/// A sequence's elements up to the first for which a closure is false:
/// what '.lazy.prefix(while:)' makes.
public struct LazyPrefixWhileSequence<Base: Sequence>: LazySequenceProtocol {
    let base: Base
    let predicate: (Base.Element) -> Bool

    /// An iterator from the first element.
    public fn makeIterator() -> LazyPrefixWhileIterator<Base.Iter> {
        return LazyPrefixWhileIterator<Base.Iter> { base: base.makeIterator(), predicate: predicate, done: false }
    }
}

/// Gives an iterator's elements until a closure is false for one.
public struct LazyPrefixWhileIterator<Base: Iterator>: Iterator {
    var base: Base
    let predicate: (Base.Element) -> Bool
    var done: Bool

    /// The next element, or none from the first the closure is false for.
    public mutating fn next() throws(Base.Failure) -> Base.Element? {
        if done {
            return none
        }
        if let element = try base.next() {
            if predicate(element) {
                return element
            }
        }
        done = true
        return none
    }
}
