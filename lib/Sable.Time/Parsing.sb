module Sable.Time

// Reading dates and times: ISO 8601 (calendar, ordinal and week dates,
// extended and basic, reduced times with a fraction on the last part,
// 24:00, offsets), RFC 3339 and RFC 2822, RFC 9557's zone in brackets, and
// .NET's custom patterns as ParseExact reads them. Positions in errors
// count Unicode scalars from 0, as ParseError's do.

/// An ISO 8601 time: the time of day, or the end of the day (24:00).
struct IsoTime {
    let time: TimeOfDay
    let endOfDay: Bool
}

/// A date and time, and the offset after it where there was one.
struct IsoDateTime {
    let local: LocalDateTime
    let offset: UtcOffset?
    /// Where the offset began, or the text's end.
    let offsetAt: Int
}

/// Steps over a text's bytes: everything a date or a time is written in is
/// ASCII, but for the minus sign an offset may have.
struct IsoScanner {
    let text: String
    let bytes: Utf8View
    let count: Int
    /// The byte it is at.
    var at: Int

    init(_ text: String) {
        self.text = text
        self.bytes = text.utf8
        self.count = text.utf8.count
        self.at = 0
    }

    var atEnd: Bool => at >= count

    /// Whether the ASCII character is next.
    fn isAt(_ c: Char) -> Bool {
        return at < count && Int(bytes[at]) == c.codePoint
    }

    /// Whether U+2212 is next: E2 88 92.
    var isAtMinusSign: Bool => at + 2 < count && bytes[at] == 0xE2 && bytes[at + 1] == 0x88 && bytes[at + 2] == 0x92

    /// Where a byte is in scalars, as an error says it.
    fn position(_ byte: Int) -> Int {
        return Runtime.countScalars(text, 0, byte)
    }

    /// Steps over the character if it is next.
    mutating fn skip(_ c: Char) {
        if isAt(c) {
            at += 1
        }
    }

    /// Nothing may follow.
    fn end() throws(ParseError) {
        if at < count {
            throw .Invalid(at: position(at))
        }
    }

    fn isDigit(_ offset: Int) -> Bool {
        return at + offset < count && bytes[at + offset] >= 48 && bytes[at + offset] <= 57
    }

    /// The digits from here on, at most 'most'.
    fn digitRun(_ most: Int) -> Int {
        var n = 0
        while n < most && isDigit(n) {
            n += 1
        }
        return n
    }

    /// Exactly 'wanted' digits.
    mutating fn digits(_ wanted: Int) throws(ParseError) -> Int {
        if count == 0 {
            throw .Empty
        }
        var value = 0
        var i = 0
        while i < wanted {
            if at >= count {
                throw i == 0 ? ParseError.Invalid(at: position(at)) : ParseError.InvalidDigit(at: position(at))
            }
            let byte = bytes[at]
            if byte < 48 || byte > 57 {
                throw .InvalidDigit(at: position(at))
            }
            value = value * 10 + Int(byte) - 48
            at += 1
            i += 1
        }
        return value
    }

    mutating fn expect(_ c: Char) throws(ParseError) {
        if !isAt(c) {
            throw .Invalid(at: position(at))
        }
        at += 1
    }

    /// A date: calendar, ordinal or week, extended or basic.
    mutating fn date() throws(ParseError) -> Date {
        if count == 0 {
            throw .Empty
        }
        var year = 0
        if isAt('+') || isAt('-') {
            // An expanded year: its sign, and more than four digits.
            let negative = isAt('-')
            at += 1
            let count = digitRun(9)
            if count < 4 {
                _ = try digits(4)
            }
            year = try digits(count)
            year = negative ? 0 - year : year
        } else {
            year = try digits(4)
        }
        var extended = false
        if isAt('-') {
            extended = true
            at += 1
        }
        if isAt('W') {
            at += 1
            let weekAt = at
            let week = try digits(2)
            var weekday = 1
            if extended && isAt('-') || !extended && isDigit(0) {
                if extended {
                    at += 1
                }
                let weekdayAt = at
                weekday = try digits(1)
                if weekday < 1 || weekday > 7 {
                    throw .Invalid(at: position(weekdayAt))
                }
            }
            if let date = Date.of(isoWeekYear: year, week: week, weekday: Weekday.ofChecked(weekday)) {
                return date
            }
            throw .Invalid(at: position(weekAt))
        }
        let run = digitRun(5)
        if run == 3 && !(extended && isAt('-')) && !isDigit(3) {
            let dayAt = at
            let day = try digits(3)
            if let date = Date.of(year: year, dayOfYear: day) {
                return date
            }
            throw .Invalid(at: position(dayAt))
        }
        if !extended && run != 4 {
            throw run == 0 ? ParseError.Invalid(at: position(at)) : ParseError.InvalidDigit(at: position(at + run))
        }
        let monthAt = at
        let month = try digits(2)
        if extended {
            try expect('-')
        }
        let dayAt = at
        let day = try digits(2)
        if month < 1 || month > 12 {
            throw .Invalid(at: position(monthAt))
        }
        if day < 1 || day > daysInMonth(year, month) {
            throw .Invalid(at: position(dayAt))
        }
        return Date(checkedYear: year, month: month, day: day)
    }

    /// A time: hh, hh:mm or hh:mm:ss (hhmm, hhmmss), with a fraction of
    /// the last part.
    mutating fn time() throws(ParseError) -> IsoTime {
        let hourAt = at
        let hour = try digits(2)
        var minute = 0
        var second = 0
        var nanos = 0
        let extended = isAt(':')
        var minuteAt = at
        var secondAt = at
        // The unit the last part is in, in nanoseconds, for its fraction.
        var unit = 3600000000000
        if extended && isDigit(1) || !extended && isDigit(0) {
            if extended {
                at += 1
            }
            minuteAt = at
            minute = try digits(2)
            unit = 60000000000
            if extended && isAt(':') && isDigit(1) || !extended && isDigit(0) {
                if extended {
                    at += 1
                }
                secondAt = at
                second = try digits(2)
                unit = 1000000000
            }
        }
        if isAt('.') || isAt(',') {
            at += 1
            // Each digit a tenth of the one before, down to the nanosecond;
            // the digits past it dropped.
            var places = 0
            var step = unit
            while isDigit(0) {
                if step % 10 == 0 {
                    step /= 10
                    nanos += (Int(bytes[at]) - 48) * step
                }
                places += 1
                at += 1
            }
            if places == 0 {
                throw .InvalidDigit(at: position(at))
            }
        }
        if hour == 24 && minute == 0 && second == 0 && nanos == 0 {
            return IsoTime { time: TimeOfDay.midnight, endOfDay: true }
        }
        if hour > 23 {
            throw .Invalid(at: position(hourAt))
        }
        if minute > 59 {
            throw .Invalid(at: position(minuteAt))
        }
        if second > 59 {
            throw .Invalid(at: position(secondAt))
        }
        let total = ((hour * 60 + minute) * 60 + second) * 1000000000 + nanos
        if total >= nanosecondsPerDay {
            throw .Invalid(at: position(hourAt))
        }
        return IsoTime { time: TimeOfDay(nanosecondOfDay: total), endOfDay: false }
    }

    /// An offset: Z, or a sign and hh, hh:mm, hhmm, hh:mm:ss.
    mutating fn offset() throws(ParseError) -> UtcOffset {
        if isAt('Z') || isAt('z') {
            at += 1
            return UtcOffset.utc
        }
        if !isAt('+') && !isAt('-') && !isAtMinusSign {
            throw .Invalid(at: position(at))
        }
        let sign = isAt('+') ? 1 : -1
        // The minus sign is three bytes.
        at += isAtMinusSign ? 3 : 1
        let hoursAt = at
        let hours = try digits(2)
        var minutes = 0
        var seconds = 0
        let extended = isAt(':')
        if extended && isDigit(1) || !extended && isDigit(0) {
            if extended {
                at += 1
            }
            minutes = try digits(2)
            if extended && isAt(':') && isDigit(1) || !extended && isDigit(0) {
                if extended {
                    at += 1
                }
                seconds = try digits(2)
            }
        }
        if hours > 25 || minutes > 59 || seconds > 59 {
            throw .Invalid(at: position(hoursAt))
        }
        return UtcOffset(seconds: sign * (hours * 3600 + minutes * 60 + seconds))
    }

    /// A date, then 'T' (or a space) and a time; a date alone its midnight.
    mutating fn localDateTime() throws(ParseError) -> LocalDateTime {
        let date = try self.date()
        if atEnd {
            return LocalDateTime(date: date, time: TimeOfDay.midnight)
        }
        if !isAt('T') && !isAt('t') && !isAt(' ') {
            throw .Invalid(at: position(at))
        }
        at += 1
        let time = try self.time()
        if time.endOfDay {
            return LocalDateTime(date: date.adding(days: 1), time: TimeOfDay.midnight)
        }
        return LocalDateTime(date: date, time: time.time)
    }

    /// A date and time, and an offset if one follows.
    mutating fn dateTime() throws(ParseError) -> IsoDateTime {
        let local = try localDateTime()
        let offsetAt = at
        if isAt('Z') || isAt('z') || isAt('+') || isAt('-') || isAtMinusSign {
            return IsoDateTime { local: local, offset: try offset(), offsetAt: position(offsetAt) }
        }
        return IsoDateTime { local: local, offset: none, offsetAt: position(offsetAt) }
    }
}

/// The fields a pattern read: those it has not, 1 (year, month, day) or 0.
struct PatternFields {
    let date: Date
    let time: TimeOfDay
    let offset: UtcOffset?
}

/// The text read by the pattern, as .NET's DateTime.ParseExact reads it.
fn parsePattern(_ text: String, _ pattern: String) throws(ParseError) -> PatternFields {
    let chars = text.toArray()
    if chars.count == 0 {
        throw .Empty
    }
    let (custom, _) = expandStandardPattern(pattern)
    var at = 0
    var year = 1
    var month = 1
    var day = 1
    var dayAt = 0
    var weekday = 0
    var weekdayAt = 0
    var hour = 0
    var hourAt = 0
    var twelveHour = false
    var afternoon = -1
    var minute = 0
    var second = 0
    var nanos = 0
    var offset: UtcOffset? = none
    for token in tokenizePattern(custom) {
        let n = token.count
        let start = at
        match token.letter {
            case 'd' => {
                if n <= 2 {
                    dayAt = at
                    day = try readNumber(chars, &at, n == 1 ? 1 : 2, 2)
                } else {
                    weekdayAt = at
                    weekday = try readName(chars, &at, Weekday.names, n == 3) + 1
                }
            }
            case 'M' => {
                if n <= 2 {
                    month = try readNumber(chars, &at, n == 1 ? 1 : 2, 2)
                } else {
                    month = try readName(chars, &at, Month.names, n == 3) + 1
                }
                if month < 1 || month > 12 {
                    throw .Invalid(at: start)
                }
            }
            case 'y' => {
                if n <= 2 {
                    let short = try readNumber(chars, &at, n, 2)
                    year = short + (short < 50 ? 2000 : 1900)
                } else {
                    year = try readNumber(chars, &at, n, n > 4 ? n : 4)
                }
            }
            case 'h' => {
                hourAt = at
                twelveHour = true
                hour = try readNumber(chars, &at, n == 1 ? 1 : 2, 2)
                if hour < 1 || hour > 12 {
                    throw .Invalid(at: start)
                }
            }
            case 'H' => {
                hourAt = at
                hour = try readNumber(chars, &at, n == 1 ? 1 : 2, 2)
                if hour > 23 {
                    throw .Invalid(at: start)
                }
            }
            case 'm' => {
                minute = try readNumber(chars, &at, n == 1 ? 1 : 2, 2)
                if minute > 59 {
                    throw .Invalid(at: start)
                }
            }
            case 's' => {
                second = try readNumber(chars, &at, n == 1 ? 1 : 2, 2)
                if second > 59 {
                    throw .Invalid(at: start)
                }
            }
            case 'f', 'F' => {
                let places = n > 9 ? 9 : n
                let read = token.letter == 'f' ? places : 0
                let before = at
                let digits = try readNumber(chars, &at, read, places)
                var scale = 1
                var i = at - before
                while i < 9 {
                    scale *= 10
                    i += 1
                }
                nanos = digits * scale
            }
            case 't' => {
                afternoon = try readName(chars, &at, ["AM", "PM"], n == 1)
            }
            case 'g' => {
                _ = try readName(chars, &at, ["A.D.", "AD"], false)
            }
            case 'K', 'z' => {
                if at < chars.count && (chars[at] == 'Z' || chars[at] == 'z') && token.letter == 'K' {
                    at += 1
                    offset = UtcOffset.utc
                } else if at < chars.count && (chars[at] == '+' || chars[at] == '-') {
                    offset = try readOffset(chars, &at, token.letter == 'K' ? 3 : n)
                } else if token.letter == 'z' {
                    throw .Invalid(at: at)
                }
            }
            case _ => {
                for c in token.text.toArray() {
                    if at >= chars.count || chars[at] != c {
                        throw .Invalid(at: at)
                    }
                    at += 1
                }
            }
        }
    }
    if at != chars.count {
        throw .Invalid(at: at)
    }
    if twelveHour {
        hour = hour % 12
        if afternoon == 1 {
            hour += 12
        }
    } else if afternoon >= 0 && (afternoon == 1) != (hour >= 12) {
        throw .Invalid(at: hourAt)
    }
    if day < 1 || day > daysInMonth(year, month) {
        throw .Invalid(at: dayAt)
    }
    let date = Date(checkedYear: year, month: month, day: day)
    if weekday != 0 && date.weekday.number != weekday {
        throw .Invalid(at: weekdayAt)
    }
    return PatternFields {
        date: date,
        time: TimeOfDay(nanosecondOfDay: ((hour * 60 + minute) * 60 + second) * 1000000000 + nanos),
        offset: offset,
    }
}

/// From 'least' to 'most' digits.
fn readNumber(_ chars: Char[:], _ at: inout Int, _ least: Int, _ most: Int) throws(ParseError) -> Int {
    var value = 0
    var count = 0
    while count < most && at < chars.count && chars[at].isDigit {
        value = value * 10 + (chars[at].codePoint - 48)
        count += 1
        at += 1
    }
    if count < least {
        throw .InvalidDigit(at: at)
    }
    return value
}

/// The index of the name (or its first three letters, or for "AM" and
/// "PM" its first letter) that is next, in any case.
fn readName(_ chars: Char[:], _ at: inout Int, _ names: String[:], _ short: Bool) throws(ParseError) -> Int {
    var index = 0
    for name in names {
        let full = name.toArray()
        let length = short ? (full.count == 2 ? 1 : 3) : full.count
        var i = 0
        while i < length && at + i < chars.count && chars[at + i].lowercased() == full[i].lowercased() {
            i += 1
        }
        if i == length {
            at += length
            return index
        }
        index += 1
    }
    throw .Invalid(at: at)
}

/// .NET's 'z' (±h or ±hh), 'zz' (±hh) or 'zzz' (±hh:mm).
fn readOffset(_ chars: Char[:], _ at: inout Int, _ count: Int) throws(ParseError) -> UtcOffset {
    let signAt = at
    let sign = chars[at] == '-' ? -1 : 1
    at += 1
    let hours = try readNumber(chars, &at, count == 1 ? 1 : 2, 2)
    var minutes = 0
    if count >= 3 {
        if at >= chars.count || chars[at] != ':' {
            throw .Invalid(at: at)
        }
        at += 1
        minutes = try readNumber(chars, &at, 2, 2)
    }
    if hours > 14 || minutes > 59 {
        throw .Invalid(at: signAt)
    }
    return UtcOffset(seconds: sign * (hours * 3600 + minutes * 60))
}

/// RFC 3339's date-time: a full date, 'T' (or 't', or a space), a full
/// time with seconds and perhaps a fraction, and 'Z' or an offset.
fn readRfc3339(_ text: String) throws(ParseError) -> OffsetDateTime {
    var scanner = IsoScanner(text)
    let date = try scanner.date()
    if scanner.at != 10 {
        throw .Invalid(at: 4)
    }
    if !scanner.isAt('T') && !scanner.isAt('t') && !scanner.isAt(' ') {
        throw .Invalid(at: scanner.position(scanner.at))
    }
    scanner.at += 1
    let timeAt = scanner.at
    let time = try scanner.time()
    if scanner.at < timeAt + 8 || scanner.bytes[timeAt + 2] != 58 || time.endOfDay {
        throw .Invalid(at: scanner.position(timeAt))
    }
    if !scanner.isAt('Z') && !scanner.isAt('z') && !scanner.isAt('+') && !scanner.isAt('-') {
        throw .Invalid(at: scanner.position(scanner.at))
    }
    let offsetAt = scanner.at
    let offset = try scanner.offset()
    if scanner.at != offsetAt + 1 && scanner.at != offsetAt + 6 {
        throw .Invalid(at: scanner.position(offsetAt))
    }
    try scanner.end()
    return OffsetDateTime(local: LocalDateTime(date: date, time: time.time), offset: offset)
}

/// RFC 2822's (and RFC 5322's) date-time: "Tue, 17 Nov 2026 09:05:03
/// +0100"; the weekday optional and checked, the seconds optional, two-
/// and three-digit years and the zone names of the obsolete syntax read
/// as RFC 5322 §4.3 says, comments in parentheses skipped.
fn readRfc2822(_ text: String) throws(ParseError) -> OffsetDateTime {
    let chars = text.toArray()
    if chars.count == 0 {
        throw .Empty
    }
    var at = 0
    skipFoldingSpace(chars, &at)
    var weekday = 0
    var weekdayAt = 0
    if at < chars.count && chars[at].isLetter {
        weekdayAt = at
        weekday = try readName(chars, &at, Weekday.names, true) + 1
        skipFoldingSpace(chars, &at)
        if at >= chars.count || chars[at] != ',' {
            throw .Invalid(at: at)
        }
        at += 1
        skipFoldingSpace(chars, &at)
    }
    let dayAt = at
    let day = try readNumber(chars, &at, 1, 2)
    try requireSpace(chars, &at)
    let month = try readName(chars, &at, Month.names, true) + 1
    try requireSpace(chars, &at)
    let yearAt = at
    var year = try readNumber(chars, &at, 2, 9)
    let yearDigits = at - yearAt
    if yearDigits == 2 {
        year += year < 50 ? 2000 : 1900
    } else if yearDigits == 3 {
        year += 1900
    }
    try requireSpace(chars, &at)
    let hourAt = at
    let hour = try readNumber(chars, &at, 2, 2)
    skipFoldingSpace(chars, &at)
    if at >= chars.count || chars[at] != ':' {
        throw .Invalid(at: at)
    }
    at += 1
    skipFoldingSpace(chars, &at)
    let minute = try readNumber(chars, &at, 2, 2)
    var second = 0
    skipFoldingSpace(chars, &at)
    if at < chars.count && chars[at] == ':' {
        at += 1
        skipFoldingSpace(chars, &at)
        second = try readNumber(chars, &at, 2, 2)
    }
    skipFoldingSpace(chars, &at)
    let zoneAt = at
    var offset = 0
    if at < chars.count && (chars[at] == '+' || chars[at] == '-') {
        let sign = chars[at] == '-' ? -1 : 1
        at += 1
        let digits = try readNumber(chars, &at, 4, 4)
        if digits % 100 > 59 {
            throw .Invalid(at: zoneAt)
        }
        offset = sign * (digits / 100 * 3600 + digits % 100 * 60)
    } else {
        var name = ""
        while at < chars.count && chars[at].isAsciiLetter {
            name += chars[at].uppercased()
            at += 1
        }
        offset = match name {
            case "UT", "GMT", "Z" => 0
            case "EDT"            => -4 * 3600
            case "EST", "CDT"     => -5 * 3600
            case "CST", "MDT"     => -6 * 3600
            case "MST", "PDT"     => -7 * 3600
            case "PST"            => -8 * 3600
            case _                => name.count == 1 ? 0 : 1
        }
        if offset == 1 {
            throw .Invalid(at: zoneAt)
        }
    }
    skipFoldingSpace(chars, &at)
    if at != chars.count {
        throw .Invalid(at: at)
    }
    if hour > 23 || minute > 59 || second > 60 {
        throw .Invalid(at: hourAt)
    }
    if day < 1 || day > daysInMonth(year, month) {
        throw .Invalid(at: dayAt)
    }
    let date = Date(checkedYear: year, month: month, day: day)
    if weekday != 0 && date.weekday.number != weekday {
        throw .Invalid(at: weekdayAt)
    }
    // A leap second, 60, is the last second of its minute.
    let time = TimeOfDay(nanosecondOfDay: ((hour * 60 + minute) * 60 + (second == 60 ? 59 : second)) * 1000000000)
    return OffsetDateTime(local: LocalDateTime(date: date, time: time), offset: UtcOffset(seconds: offset))
}

/// White space and comments in parentheses, which may nest.
fn skipFoldingSpace(_ chars: Char[:], _ at: inout Int) {
    var depth = 0
    while at < chars.count {
        let c = chars[at]
        if c == '(' {
            depth += 1
        } else if c == ')' && depth > 0 {
            depth -= 1
        } else if depth == 0 && c != ' ' && c != '\t' && c != '\r' && c != '\n' {
            return
        }
        at += 1
    }
}

/// At least one space, or a comment.
fn requireSpace(_ chars: Char[:], _ at: inout Int) throws(ParseError) {
    let before = at
    skipFoldingSpace(chars, &at)
    if at == before {
        throw .Invalid(at: at)
    }
}
