module ParseErrorTests

// ParseError (Sable.Serialize), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Serialize

import Sable.Serialize
import Sable.Testing

fn isAnError<T>(_ value: T) -> Bool where T: Error {
    return true
}

let start = Position(offset: 0, line: 1, column: 1)

@test
fn aParseErrorIsAnError() {
    expect(isAnError(ParseError.TrailingText(at: start)))
}

@test
fn aParseErrorSaysWhereItIs() {
    let error = ParseError.UnexpectedEnd(at: Position(offset: 4, line: 2, column: 3), expected: "a value")
    assertEqual(errorLine(error), 2)
    assertEqual(describeError(error), "line 2, column 3: the text ends where a value was expected")
}

fn at(_ line: Int) -> Position {
    return Position(offset: 0, line: line, column: 5)
}

let errors: (ParseError, Int, String)[>..] = [
    (.UnexpectedCharacter(at: at(1), found: 'x', expected: "a digit"), 1, "line 1, column 5: found 'x' where a digit was expected"),
    (.InvalidNumber(at: at(2), reason: "no digits"), 2, "line 2, column 5: invalid number: no digits"),
    (.InvalidEscape(at: at(3), found: 'q'), 3, "line 3, column 5: \\q is not an escape"),
    (.InvalidUnicode(at: at(4), reason: "a lone surrogate"), 4, "line 4, column 5: invalid \\u escape: a lone surrogate"),
    (.ControlCharacter(at: at(5), code: 10), 5, "line 5, column 5: control character U+000a must be escaped"),
    (.TooDeep(at: at(6), limit: 64), 6, "line 6, column 5: nested more than 64 deep"),
    (.TrailingText(at: at(7)), 7, "line 7, column 5: text after the value"),
    (.DuplicateKey(at: at(8), key: "id"), 8, "line 8, column 5: the key \"id\" appears twice"),
]

@test(arguments: errors)
fn eachErrorIsDescribedWithItsPlace(_ error: ParseError, _ line: Int, _ description: String) {
    expect(describeError(error) == description)
    expect(errorLine(error) == line)
}

@test
fn controlCharactersAreDescribedByCode() {
    assertEqual(describeChar('\t'), "U+0009")
    assertEqual(describeChar('a'), "'a'")
}
