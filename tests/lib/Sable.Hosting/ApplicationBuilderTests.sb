module ApplicationBuilderTests

// Sable.Hosting, tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Hosting

import Sable.Concurrency
import Sable.Configuration
import Sable.Diagnostics
import Sable.Hosting
import Sable.IO
import Sable.Testing
import Sable.Time

import HostingSupport

@test
async fn servicesAreMadeInOrderFromTheContext() {
    let made = Record()
    let builder = quietBuilder(FakeHostClock())
    builder.environment = HostEnvironment(name: "Development", applicationName: "app")
    builder.services.add("a", make: { context in
        made.add("a:\(context.environment.applicationName)")
        return Recorded("a", made)
    })
    builder.services.add("b", make: { _context in
        made.add("b")
        return Recorded("b", made)
    })
    expect(builder.services.names == ["a", "b"])
    assertEqual(made.all, "")
    _ = try! await builder.build()
    assertEqual(made.all, "a:app b")
}

@test
async fn whatMakingAServiceThrowsBuildThrows() {
    let builder = quietBuilder(FakeHostClock())
    builder.services.add("bad", make: { _context in
        throw TestError("not made")
    })
    await expectThrows(saying: "not made") { _ = try await builder.build() }
}

@test
fn aWorkerIsGivenTheContext() async {
    let record = Record()
    let builder = quietBuilder(FakeHostClock())
    builder.services.addWorker("w") { context, cancellation in
        record.add(context.environment.isProduction || true ? "ran" : "")
        context.lifetime.requestStop()
        _ = await cancellation.cancellationRequested()
    }
    assertEqual(await outcome(try! await builder.build()), "")
    assertEqual(record.all, "ran")
}

@test
fn theContextSleepsByTheHostsClock() async {
    let clock = FakeHostClock()
    let record = Record()
    let builder = quietBuilder(clock)
    builder.services.addWorker("w") { context, cancellation in
        try await context.sleep(for: Duration.hours(1), cancellation: cancellation)
        record.add("slept")
        try await context.sleep(for: Duration.hours(1), cancellation: cancellation)
        record.add("not cancelled")
    }
    let host = try! await builder.build()
    let running = Task.spawn { await outcome(host) }
    await clock.pass(Duration.hours(1))
    await record.awaitLine("slept")
    await clock.awaitSleep(Duration.hours(1))
    host.lifetime.requestStop()
    assertEqual(await running.value, "")
    assertEqual(record.all, "slept")
}

@test
fn theSystemsClockIsTheUsualOne() async {
    let builder = ApplicationBuilder()
    let before = builder.clock.now()
    try! await builder.clock.sleep(until: before.adding(Duration.milliseconds(5)))
    expect(builder.clock.now().durationSince(before) >= Duration.milliseconds(5))
    let clock = builder.clock
    let sleeping = Task.spawn {
        await expectThrows(CancellationError.self) { try await clock.sleep(until: before.adding(Duration.hours(1))) }
    }
    sleeping.cancel()
    _ = await sleeping.value
}

@test
fn theLevelIsTheEnvironments() {
    expect(rank(ApplicationBuilder().logging.minimumLevel!) == rank(Level.Info))
    unsafe {
        Environment.set("SABLE_LOG", "debug")
    }
    expect(rank(ApplicationBuilder().logging.minimumLevel!) == rank(Level.Debug))
    unsafe {
        Environment.set("SABLE_LOG", "nonsense")
    }
    expect(rank(ApplicationBuilder().logging.minimumLevel!) == rank(Level.Info))
}

@test
fn theEnvironmentIsNamedByItsVariable() {
    unsafe {
        Environment.remove("SABLE_ENVIRONMENT")
    }
    expect(HostEnvironment.current().isProduction)
    unsafe {
        Environment.set("SABLE_ENVIRONMENT", "development")
    }
    let environment = HostEnvironment.current()
    expect(environment.isDevelopment && !environment.isProduction && !environment.isStaging)
    assertEqual(environment.name, "development")
    expect(environment.isEnvironment("DEVELOPMENT"))
    expect(!environment.applicationName.isEmpty)
}

@test
fn configurationIsTheSettingsFilesTheEnvironmentAndTheArguments() {
    let builder = ApplicationBuilder(arguments: ["--Http:Port=8080"])
    let names = builder.configuration.providers.map { $0.name }.toArray()
    assertEqual(names, ["appsettings.toml", "appsettings.\(builder.environment.name).toml", "environment", "command line"])
    assertEqual(ApplicationBuilder().configuration.providers.count, 3)
}

@test
async fn theHostIsConfiguredAsTheBuilderSays() {
    unsafe {
        Environment.set("HostingTests__Level", "Debug")
    }
    let builder = ApplicationBuilder(arguments: ["--HostingTests:Port=8080", "--hostingtests:level=Trace"])
    builder.logging.minimumLevel = none
    builder.configuration.addValues(["HostingTests:Name": "shop"])
    let host = try! await builder.build()
    expect(host.configuration.value("HostingTests:Port") == "8080")
    expect(host.configuration.value("HostingTests:Level") == "Trace")
    expect(host.configuration.value("hostingtests:name") == "shop")
}

@test
async fn configurationThatCannotBeLoadedIsNotBuilt() {
    let builder = quietBuilder(FakeHostClock())
    builder.configuration.addFile(FilePath("no/such/settings.toml"))
    await expectThrows(saying: "no/such/settings.toml: not found") { _ = try await builder.build() }
}

@test
fn loggersAreSetAsTheLoggingIs() {
    let logging = HostLogging(minimumLevel: Level.Warning, timestamps: true)
    let logger = logging.logger("a")
    assertEqual(logger.name, "a")
    expect(logger.timestamps && logger.isEnabled(.Warning) && !logger.isEnabled(.Info))
    expect(!HostLogging(minimumLevel: none).logger("b").isEnabled(.Warning))
}

@test
fn everyErrorSaysWhatWentWrong() {
    assertEqual(HostError.ShutdownTimedOut(services: ["a", "b"]).description(), "not stopped in time: a, b")
    assertEqual(HostError.StartTimedOut(service: "a").description(), "the service 'a' did not start in time")
}
