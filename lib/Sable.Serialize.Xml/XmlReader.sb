module Sable.Serialize.Xml

// The text an XmlReader reads next, and what it goes back to at its end:
// the document's, or an entity's where it is referred to.
struct XmlFrame {
    var bytes: U8[>..]
    var at: Int
    // How many elements were open where the entity was referred to.
    var depth: Int
}

// An entity the internal subset declares: its replacement text, or that it
// is external (never fetched) or unparsed.
let xmlPublicIdCharacters: U8[>..] = [0x2D, 0x27, 0x28, 0x29, 0x2B, 0x2C, 0x2E, 0x2F, 0x3A, 0x3D, 0x3F, 0x3B, 0x21, 0x2A, 0x23, 0x40, 0x24, 0x5F, 0x25]

struct XmlEntity {
    var text: U8[>..]
    var isExternal: Bool
    var isUnparsed: Bool
}

// What a name of the name table is: with a colon; a QName; `xmlns`; and
// `xmlns:p`.
let xmlNameColon = 1
let xmlNameQName = 2
let xmlNameXmlns = 4
let xmlNameXmlnsPrefixed = 8

/// Reads an XML 1.0 document a node at a time, as it is asked: .NET's
/// `XmlReader`, Java's StAX. It checks that the document is well-formed —
/// every error has its line and column — and, by default, reads names with
/// their namespaces.
///
/// References are replaced: the five predefined entities, characters, and
/// the entities the DOCTYPE's internal subset declares, whose text may hold
/// markup. Entities' references may nest only so deep and stand for only so
/// much text (XmlOptions), which stops a "billion laughs"; an external
/// entity is never fetched, but read as an `EntityReference`. An empty
/// element is a StartElement, with `isEmptyElement`, and an EndElement.
///
/// Each name is made a string once, the first time it is read, and is the
/// same string after (.NET's XmlNameTable); a node's value and an
/// attribute's are made only when they are asked for.
///
/// ```sable
/// let reader = XmlReader("<list xmlns='urn:l'><item n='1'>a &amp; b</item><item n='2'/></list>")
/// var seen: String[>..] = []
/// while let kind = try! reader.next() {
///     if kind == .StartElement && reader.localName == "item" {
///         seen.append(reader.attribute("n")!)
///         assert(reader.namespace == "urn:l")
///     } else if kind == .Text {
///         seen.append(reader.value)
///     }
/// }
/// assert(seen == ["1", "a & b", "2"])
/// ```
public final class XmlReader {
    let options: XmlOptions
    // The text being read, and where; the texts it is in, outermost first.
    // The document's text is the bytes when no entity is being read, and
    // the first frame's when one is.
    var bytes: U8[>..]
    var at: Int = 0
    var frames: XmlFrame[>..] = []
    // Where the document's text starts (past a byte order mark); of a
    // streaming reader, how many of its bytes were let go of, whether no
    // more will come, and whether the node asked for is not all there.
    var origin: Int = 0
    var dropped: Int = 0
    var isFinal: Bool = true
    var wantsMore: Bool = false
    var input: XmlInput = XmlInput()
    var tookEncoding: Bool = false
    // The entities being read, by name (a parameter entity's with '%').
    var expanding: String[>..] = []
    var expanded: Int = 0
    var entities: [String: XmlEntity] = [:]
    var parameters: [String: XmlEntity] = [:]
    // Whether declarations may be missing that the reader does not read:
    // an external subset, or an external parameter entity's.
    var hasExternalSubset: Bool = false
    var skippedDeclarations: Bool = false
    var sawParameterReference: Bool = false
    // What the bytes' byte order mark or zeros say they are, if anything.
    var detected: String = ""
    // The attribute list declarations: for each element, its attributes'
    // names, whether each is tokenized, and each default, if it has one.
    var declaredNames: [String: String[>..]] = [:]
    var declaredTokenized: [String: Bool[>..]] = [:]
    var declaredDefaults: [String: String?[>..]] = [:]
    // 0 before the root element, 1 in it, 2 after it.
    var state: Int = 0
    var sawDocumentType: Bool = false
    // The names read, each made a string once: by number, its text, prefix
    // and local name, what it is (xmlNameColon and the rest), its hash and
    // where its bytes are in the pool. The slots find a number by bytes.
    var nameText: String[>..] = []
    var namePrefix: String[>..] = []
    var nameLocal: String[>..] = []
    var nameFlags: Int[>..] = []
    var nameHash: Int[>..] = []
    var nameStart: Int[>..] = []
    var namePool: U8[>..] = []
    var nameSlots: Int[>..] = Int[>..](repeating: -1, count: 64)
    // The open elements' names, by number.
    var openNames: Int[>..] = []
    var scopePrefixes: String[>..] = []
    var scopeUris: String[>..] = []
    var scopeCounts: Int[>..] = []
    var pendingEnd: Bool = false
    // A start tag's attributes: each one's name by number, its namespace,
    // and where its value starts in their bytes, references replaced (it
    // ends where the next starts); a value is made a string when asked for.
    var attributeNames: Int[>..] = []
    var attributeNamespaces: String[>..] = []
    var attributeStarts: Int[>..] = []
    var attributeBytes: U8[>..] = []
    // The node's text, made a string when `value` is first asked for.
    var buffer: U8[>..] = []
    var made: String? = none
    var isBuffered: Bool = false
    var isWhite: Bool = false
    var nodeStart: Int = 0
    var placeOffset: Int = 0
    var placeLine: Int = 1
    var placeColumn: Int = 1
    var originLine: Int = 1
    var originColumn: Int = 1

    /// What the reader read last.
    public internal(set) var kind: XmlNodeKind = .Declaration
    /// An element's name as written (`p:item`), a processing
    /// instruction's target, the DOCTYPE's name, or an entity's.
    public internal(set) var name: String = ""
    /// An element's name after its prefix, and the prefix ("" for none).
    public internal(set) var localName: String = ""
    public internal(set) var `prefix`: String = ""
    /// The namespace an element is in; "" for none.
    public internal(set) var namespace: String = ""
    /// Whether the start tag was of an empty element: `<a/>`.
    public internal(set) var isEmptyElement: Bool = false
    /// How many elements are around the node: 0 for the root element.
    public internal(set) var depth: Int = 0
    /// The declaration's version, encoding and standalone; the encoding the
    /// bytes were read in, if the declaration says none.
    public internal(set) var version: String = "1.0"
    public internal(set) var encoding: String = "UTF-8"
    public internal(set) var standalone: Bool? = none
    /// The DOCTYPE's public and system identifiers; "" for none.
    public internal(set) var publicId: String = ""
    public internal(set) var systemId: String = ""

    /// A reader of the text.
    public init(_ text: String, _ options: XmlOptions = XmlOptions()) {
        var bytes: U8[>..] = []
        bytes.append(utf8: text)
        let origin = text.hasPrefix("\u{FEFF}") ? 3 : 0
        self.options = options
        self.bytes = bytes
        self.origin = origin
        self.at = origin
        self.placeOffset = origin
        self.detected = "text"
    }

    /// A reader of the bytes: UTF-8 or UTF-16, told apart by a byte order
    /// mark or the zeros of the first '<', or US-ASCII or ISO-8859-1 as the
    /// declaration says. UTF-8 is read where it is, not copied.
    ///
    /// ```sable
    /// let utf16: U8[>..] = [0xFF, 0xFE, 0x3C, 0, 0x61, 0, 0x3E, 0, 0xE9, 0, 0x3C, 0, 0x2F, 0, 0x61, 0, 0x3E, 0]
    /// let reader = try! XmlReader(bytes: utf16)
    /// _ = try! reader.next()
    /// _ = try! reader.next()
    /// assert(reader.value == "é" && reader.encoding == "UTF-16LE")
    /// ```
    public init(bytes: U8[>..], _ options: XmlOptions = XmlOptions()) throws(XmlError) {
        var encoding = ""
        var origin = 0
        let text = try xmlUtf8(bytes, &encoding, &origin)
        self.options = options
        self.bytes = text
        self.origin = origin
        self.at = origin
        self.placeOffset = origin
        self.encoding = encoding
        let b0 = bytes.count > 0 ? bytes[0] : 0
        self.detected = encoding.hasPrefix("UTF-16") ? encoding : b0 == 0xEF ? "UTF-8" : ""
    }

    /// A reader given the document's bytes as they come: by `append` and
    /// `finish`, or by `next(from:)` from a Reader or an AsyncReader. They
    /// may be in any encoding `init(bytes:)` reads, told apart the same
    /// way. It keeps the bytes of the node it is reading and no more, and
    /// `next()` is none while that node is not all there and more may come.
    ///
    /// ```sable
    /// let reader = XmlReader.streaming()
    /// try! reader.append([0x3C, 0x61, 0x3E, 0x68, 0x69])
    /// assert(try! reader.next() == .StartElement)
    /// assert(try! reader.next() == none && reader.needsMore)
    /// try! reader.append([0x3C, 0x2F, 0x61, 0x3E])
    /// try! reader.finish()
    /// assert(try! reader.next() == .Text && reader.value == "hi")
    /// assert(try! reader.next() == .EndElement && try! reader.next() == none)
    /// ```
    public static fn streaming(_ options: XmlOptions = XmlOptions()) -> XmlReader {
        let reader = XmlReader("", options)
        reader.isFinal = false
        reader.detected = ""
        return reader
    }

    /// Whether the last `next()` was none only as the node it came to is
    /// not all there, and more bytes may come.
    public var needsMore: Bool => wantsMore

    /// More of the document's bytes, for a streaming reader; an error if
    /// they are not of the encoding.
    public fn append(_ chunk: U8[:]) throws(XmlError) {
        if frames.isEmpty {
            try input.decode(chunk, atEnd: false, into: &bytes)
        } else {
            try input.decode(chunk, atEnd: false, into: &frames[0].bytes)
        }
        takeEncoding()
    }

    /// That no more bytes will come: an error if those there are end in
    /// the middle of a character.
    public fn finish() throws(XmlError) {
        isFinal = true
        if frames.isEmpty {
            try input.decode([], atEnd: true, into: &bytes)
        } else {
            try input.decode([], atEnd: true, into: &frames[0].bytes)
        }
        takeEncoding()
    }

    // What the first bytes told of their encoding, once there are enough.
    fn takeEncoding() {
        if !tookEncoding && input.isDecided {
            tookEncoding = true
            encoding = input.encoding
            detected = input.detected
        }
    }

    // The document's text.
    var document: U8[>..] => frames.isEmpty ? bytes : frames[0].bytes

    // ---- Where -----------------------------------------------------------

    /// The line, from 1, of the node's first character.
    public var line: Int {
        get {
            locate(nodeStart)
            return placeLine
        }
    }

    /// The column, from 1 and in characters, of the node's first character.
    public var column: Int {
        get {
            locate(nodeStart)
            return placeColumn
        }
    }

    fn locate(_ offset: Int) {
        if offset < placeOffset {
            placeOffset = origin
            placeLine = originLine
            placeColumn = originColumn
        }
        let text = document
        while placeOffset < offset && placeOffset < text.count {
            let b = text[placeOffset]
            if b == 0x0A || b == 0x0D && (placeOffset + 1 >= text.count || text[placeOffset + 1] != 0x0A) {
                placeLine += 1
                placeColumn = 1
            } else if b != 0x0D && (b & 0xC0) != 0x80 {
                placeColumn += 1
            }
            placeOffset += 1
        }
    }

    // The error there: at the offset in the document, or where the reader
    // is (in an entity: at the outermost reference).
    fn fail(_ reason: String, at offset: Int = -1) -> XmlError {
        let place = offset >= 0 ? offset : frames.isEmpty ? at : frames[0].at
        locate(place)
        return XmlError { line: placeLine, column: placeColumn, reason: reason }
    }

    // ---- Names -----------------------------------------------------------

    // The number of the name of those bytes, made one if it is new.
    fn intern(_ source: U8[>..], _ start: Int, _ end: Int) -> Int {
        var hash = 5381
        var i = start
        while i < end {
            hash = (hash &* 33) ^ Int(source[i])
            i += 1
        }
        let count = end - start
        var mask = nameSlots.count - 1
        var slot = hash & mask
        while true {
            let id = nameSlots[slot]
            if id < 0 {
                break
            }
            if nameHash[id] == hash {
                let from = nameStart[id]
                if nameStart[id + 1] - from == count {
                    var same = true
                    var j = 0
                    while j < count {
                        if namePool[from + j] != source[start + j] {
                            same = false
                            break
                        }
                        j += 1
                    }
                    if same {
                        return id
                    }
                }
            }
            slot = (slot + 1) & mask
        }
        let id = nameText.count
        let text = xmlString(source[start..<end])
        var flags = 0
        if xmlColon(text) >= 0 {
            flags |= xmlNameColon
            if xmlIsQName(text) {
                flags |= xmlNameQName
            }
        }
        if text == "xmlns" {
            flags |= xmlNameXmlns
        } else if text.hasPrefix("xmlns:") {
            flags |= xmlNameXmlnsPrefixed
        }
        if nameStart.isEmpty {
            nameStart.append(0)
        }
        namePool.append(contentsOf: source[start..<end])
        nameStart.append(namePool.count)
        nameText.append(text)
        namePrefix.append(xmlPrefix(text))
        nameLocal.append(xmlLocalName(text))
        nameFlags.append(flags)
        nameHash.append(hash)
        if nameText.count * 2 > nameSlots.count {
            nameSlots = Int[>..](repeating: -1, count: nameSlots.count * 2)
            mask = nameSlots.count - 1
            for other in 0..<nameText.count {
                var at = nameHash[other] & mask
                while nameSlots[at] >= 0 {
                    at = (at + 1) & mask
                }
                nameSlots[at] = other
            }
        } else {
            nameSlots[slot] = id
        }
        return id
    }

    // ---- Attributes ------------------------------------------------------

    /// The value of the start tag's attribute of that name as written, or
    /// of that local name in that namespace.
    public fn attribute(_ name: String, namespace: String? = none) -> String? {
        for i in 0..<attributeNames.count {
            let id = attributeNames[i]
            if let namespace = namespace {
                if nameLocal[id] == name && attributeNamespaces[i] == namespace {
                    return attributeValue(at: i)
                }
            } else if nameText[id] == name {
                return attributeValue(at: i)
            }
        }
        return none
    }

    /// A start tag's attributes, namespace declarations among them, made
    /// when they are asked for.
    public var attributes: XmlAttribute[>..] {
        get {
            var all: XmlAttribute[>..] = []
            for i in 0..<attributeNames.count {
                let id = attributeNames[i]
                all.append(XmlAttribute(name: nameText[id], bound: namePrefix[id], local: nameLocal[id], namespace: attributeNamespaces[i], value: attributeValue(at: i)))
            }
            return all
        }
    }

    fn attributeValue(at i: Int) -> String {
        let end = i + 1 < attributeStarts.count ? attributeStarts[i + 1] : attributeBytes.count
        return xmlString(attributeBytes[attributeStarts[i]..<end])
    }

    /// Text, CDATA's or a comment's content, a processing instruction's
    /// data, or the DOCTYPE's internal subset as written: made a string the
    /// first time it is asked for.
    public var value: String {
        get {
            if let made = made {
                return made
            }
            var text = ""
            if isWhite && buffer.count <= 64 {
                // An indented document's white space is a few strings,
                // kept in the name table and made once.
                let id = intern(buffer, 0, buffer.count)
                text = nameText[id]
            } else if isBuffered {
                text = xmlString(buffer[0..<buffer.count])
            }
            made = text
            return text
        }
    }

    // ---- Reading ---------------------------------------------------------

    /// The kind of the next node, or none at the end of the document (or,
    /// of a streaming reader, where `needsMore`).
    public fn next() throws(XmlError) -> XmlNodeKind? {
        wantsMore = false
        if isFinal {
            return try step()
        }
        if frames.isEmpty && at >= 4096 && at * 2 >= bytes.count {
            drop()
        }
        // What a node that is not all there is read again from.
        let start = at
        let total = expanded
        let inside = !frames.isEmpty
        var savedFrames: XmlFrame[>..] = []
        var savedBytes: U8[>..] = []
        var savedExpanding: String[>..] = []
        if inside {
            savedFrames = frames
            savedBytes = bytes
            savedExpanding = expanding
        }
        do {
            let kind = try step()
            if !wantsMore {
                return kind
            }
        } catch {
            if !frames.isEmpty || at + 16 < bytes.count {
                throw error
            }
            wantsMore = true
        }
        at = start
        expanded = total
        if inside {
            frames = savedFrames
            bytes = savedBytes
            expanding = savedExpanding
        }
        return none
    }

    // The document's bytes before where the reader is let go of.
    fn drop() {
        locate(at)
        var kept: U8[>..] = []
        kept.reserveCapacity(bytes.count - at + 65536)
        kept.append(contentsOf: bytes[at..<bytes.count])
        bytes = kept
        dropped += at
        placeOffset = 0
        origin = 0
        originLine = placeLine
        originColumn = placeColumn
        nodeStart = 0
        at = 0
    }

    fn step() throws(XmlError) -> XmlNodeKind? {
        if pendingEnd {
            pendingEnd = false
            endElement()
            return kind
        }
        while true {
            if at >= bytes.count {
                if !frames.isEmpty {
                    try popFrame()
                    continue
                }
                if !isFinal {
                    wantsMore = true
                    return none
                }
                if state != 2 {
                    throw fail(state == 0 ? "no root element" : "the text ends inside <\(nameText[openNames[openNames.count - 1]])>")
                }
                return none
            }
            nodeStart = frames.isEmpty ? at : frames[0].at
            let b = bytes[at]
            if b == 0x3C {
                if try markup() {
                    return kind
                }
                continue
            }
            if state == 1 {
                if try text() {
                    return kind
                }
                continue
            }
            if xmlIsSpace(b) {
                at += 1
                continue
            }
            throw fail(state == 0 ? "text before the root element" : "text after the root element")
        }
    }

    /// Goes past the element the reader is at the start of, to its end;
    /// past the node, for any other. A streaming reader's element must be
    /// all there: `skip(from:)` reads on as it needs.
    public fn skip() throws(XmlError) {
        if kind != .StartElement {
            return
        }
        let at = depth
        while let next = try next() {
            if next == .EndElement && depth == at {
                return
            }
        }
    }

    fn peek(_ ahead: Int) -> Int {
        return at + ahead < bytes.count ? Int(bytes[at + ahead]) : -1
    }

    fn starts(_ word: String) -> Bool {
        var i = 0
        for byte in word.utf8 {
            if at + i >= bytes.count || bytes[at + i] != byte {
                return false
            }
            i += 1
        }
        return true
    }

    fn expect(_ byte: Int, _ what: String) throws(XmlError) {
        if peek(0) != byte {
            throw fail(peek(0) < 0 ? "the text ends where \(what) is wanted" : "\(what) is wanted here")
        }
        at += 1
    }

    fn space() -> Bool {
        let start = at
        while at < bytes.count && xmlIsSpace(bytes[at]) {
            at += 1
        }
        return at > start
    }

    fn requireSpace(_ what: String) throws(XmlError) {
        if !space() {
            throw fail("white space is wanted \(what)")
        }
    }

    // A Name (§2.3), by its number in the name table.
    fn readName() throws(XmlError) -> Int {
        let start = at
        while at < bytes.count {
            let b = bytes[at]
            if b < 0x80 {
                if !xmlIsNameChar(Int(b)) || at == start && !xmlIsNameStart(Int(b)) {
                    break
                }
                at += 1
            } else {
                let c = xmlCode(bytes, at)
                if !xmlIsNameChar(c) || at == start && !xmlIsNameStart(c) {
                    break
                }
                at += xmlWidth(b)
            }
        }
        if at == start {
            throw fail(peek(0) < 0 ? "the text ends where a name is wanted" : "a name is wanted here")
        }
        return intern(bytes, start, at)
    }

    fn readNameText() throws(XmlError) -> String {
        let id = try readName()
        return nameText[id]
    }

    // One character the document may hold at all, appended; '\r' and
    // "\r\n" as '\n' in the document's text.
    fn character(_ into: inout U8[>..]) throws(XmlError) {
        let b = bytes[at]
        if b < 0x20 {
            if b == 0x0D && frames.isEmpty {
                into.append(0x0A)
                at += at + 1 < bytes.count && bytes[at + 1] == 0x0A ? 2 : 1
                return
            }
            if b != 0x09 && b != 0x0A && b != 0x0D {
                throw fail("the control character \(b), which XML does not have")
            }
        } else if b == 0xEF && at + 2 < bytes.count && bytes[at + 1] == 0xBF && bytes[at + 2] >= 0xBE {
            throw fail("a noncharacter, which XML does not have")
        }
        into.append(b)
        at += 1
    }

    // The text up to the terminator, '?>' or ']]>', which is gone past, in
    // the buffer.
    fn until(_ question: Bool, _ what: String) throws(XmlError) {
        buffer.removeAll(keepingCapacity: true)
        while true {
            if at >= bytes.count {
                throw fail("the text ends inside \(what)")
            }
            let b = bytes[at]
            if question {
                if b == 0x3F && peek(1) == 0x3E {
                    at += 2
                    return
                }
            } else if b == 0x5D && peek(1) == 0x5D && peek(2) == 0x3E {
                at += 3
                return
            }
            try character(&buffer)
        }
    }

    // ---- Entities --------------------------------------------------------

    fn push(_ name: String, _ text: U8[>..]) throws(XmlError) {
        if expanding.contains(name) {
            throw fail("the entity \(name) refers to itself")
        }
        if expanding.count >= options.maxEntityDepth {
            throw fail("entities nested deeper than \(options.maxEntityDepth)")
        }
        expanded += text.count
        if expanded > options.maxEntityExpansion {
            throw fail("entities that stand for more than \(options.maxEntityExpansion) bytes")
        }
        frames.append(XmlFrame { bytes: bytes, at: at, depth: openNames.count })
        expanding.append(name)
        bytes = text
        at = 0
    }

    fn popFrame() throws(XmlError) {
        let frame = frames[frames.count - 1]
        if frame.depth != openNames.count {
            throw fail("the entity \(expanding[expanding.count - 1])'s text ends inside an element it starts")
        }
        _ = frames.removeLast()
        _ = expanding.removeLast()
        bytes = frame.bytes
        at = frame.at
    }

    // A character reference's character, after '&#'.
    fn characterReference() throws(XmlError) -> Int {
        at += 2
        let hex = peek(0) == 0x78
        if hex {
            at += 1
        }
        var value = 0
        var digits = 0
        while true {
            let b = peek(0)
            var digit = -1
            if b >= 0x30 && b <= 0x39 {
                digit = b - 0x30
            } else if hex && b >= 0x61 && b <= 0x66 {
                digit = b - 0x61 + 10
            } else if hex && b >= 0x41 && b <= 0x46 {
                digit = b - 0x41 + 10
            }
            if digit < 0 {
                break
            }
            if value <= 0x10FFFF {
                value = value * (hex ? 16 : 10) + digit
            }
            digits += 1
            at += 1
        }
        if digits == 0 || peek(0) != 0x3B {
            throw fail("a character reference is not &#digits; or &#xdigits;")
        }
        at += 1
        if !xmlIsChar(value) {
            throw fail("a reference to a character XML does not have")
        }
        return value
    }

    fn predefined(_ name: String) -> Int {
        return match name {
            case "lt"   => 0x3C
            case "gt"   => 0x3E
            case "amp"  => 0x26
            case "apos" => 0x27
            case "quot" => 0x22
            default     => -1
        }
    }

    // Whether a reference to an entity not declared is only one the reader
    // did not read the declaration of, not an error.
    var mayLackDeclarations: Bool => (hasExternalSubset || skippedDeclarations || sawParameterReference) && standalone != true

    // ---- Character data --------------------------------------------------

    // Text up to markup, or an entity's reference the reader does not read.
    fn text() throws(XmlError) -> Bool {
        buffer.removeAll(keepingCapacity: true)
        var white = true
        while true {
            if at >= bytes.count {
                if frames.isEmpty {
                    if !isFinal {
                        wantsMore = true
                        return true
                    }
                    break
                }
                try popFrame()
                continue
            }
            let b = bytes[at]
            if b == 0x3C {
                break
            }
            if b == 0x26 {
                if peek(1) == 0x23 {
                    xmlAppend(try characterReference(), to: &buffer)
                    white = false
                    continue
                }
                let start = at
                at += 1
                let name = try readNameText()
                try expect(0x3B, "';' after the entity's name")
                let code = predefined(name)
                if code >= 0 {
                    buffer.append(U8(code))
                    white = false
                    continue
                }
                guard let entity = entities[name] else {
                    if !mayLackDeclarations {
                        throw fail("the entity \(name), which is not declared", at: frames.isEmpty ? start : -1)
                    }
                    if !buffer.isEmpty {
                        at = start
                        break
                    }
                    return reference(name)
                }
                if entity.isUnparsed {
                    throw fail("a reference to the unparsed entity \(name)")
                }
                if entity.isExternal {
                    if !buffer.isEmpty {
                        at = start
                        break
                    }
                    return reference(name)
                }
                try push(name, entity.text)
                continue
            }
            if b == 0x5D && peek(1) == 0x5D && peek(2) == 0x3E {
                throw fail("']]>' in text")
            }
            if white && !xmlIsSpace(b) {
                white = false
            }
            if b >= 0x20 && b != 0xEF {
                // A run of plain bytes at once.
                let run = at
                at += 1
                while at < bytes.count {
                    let c = bytes[at]
                    if c < 0x20 || c == 0x3C || c == 0x26 || c == 0x5D || c == 0xEF {
                        break
                    }
                    if white && c != 0x20 {
                        white = false
                    }
                    at += 1
                }
                buffer.append(contentsOf: bytes[run..<at])
                continue
            }
            try character(&buffer)
        }
        if buffer.isEmpty || white && options.ignoresWhitespace {
            return false
        }
        markBuffered(.Text)
        isWhite = white
        return true
    }

    fn reference(_ name: String) -> Bool {
        mark(.EntityReference, value: "")
        self.name = name
        return true
    }

    fn mark(_ kind: XmlNodeKind, value: String) {
        dropAttributes()
        clear(kind)
        made = value
        isBuffered = false
    }

    // A node whose value is the buffer's text.
    fn markBuffered(_ kind: XmlNodeKind) {
        dropAttributes()
        clear(kind)
        made = none
        isBuffered = true
        isWhite = false
    }

    fn clear(_ kind: XmlNodeKind) {
        self.kind = kind
        self.name = ""
        self.localName = ""
        self.prefix = ""
        self.namespace = ""
        self.isEmptyElement = false
        self.depth = openNames.count
    }

    fn dropAttributes() {
        if !attributeNames.isEmpty {
            attributeNames.removeAll(keepingCapacity: true)
            attributeNamespaces.removeAll(keepingCapacity: true)
            attributeStarts.removeAll(keepingCapacity: true)
        }
    }

    // ---- Markup ----------------------------------------------------------

    fn markup() throws(XmlError) -> Bool {
        let c = peek(1)
        if c == 0x2F {
            try endTag()
            return true
        }
        if c == 0x3F {
            return try instruction()
        }
        if c == 0x21 {
            if starts("<!--") {
                try comment()
                markBuffered(.Comment)
                return true
            }
            if starts("<![CDATA[") {
                if state != 1 {
                    throw fail("a CDATA section outside the root element")
                }
                at += 9
                try until(false, "a CDATA section")
                markBuffered(.CData)
                return true
            }
            if starts("<!DOCTYPE") {
                try documentType()
                return true
            }
            throw fail("'<!' that starts nothing XML has here")
        }
        try startTag()
        return true
    }

    // A comment, its content in the buffer.
    fn comment() throws(XmlError) {
        at += 4
        buffer.removeAll(keepingCapacity: true)
        while true {
            if at >= bytes.count {
                throw fail("the text ends inside a comment")
            }
            if bytes[at] == 0x2D && peek(1) == 0x2D {
                if peek(2) != 0x3E {
                    throw fail("'--' inside a comment")
                }
                at += 3
                return
            }
            try character(&buffer)
        }
    }

    fn instruction() throws(XmlError) -> Bool {
        let start = at
        at += 2
        let target = try readNameText()
        if xmlLower(target) == "xml" {
            if target == "xml" && start == origin && dropped == 0 && frames.isEmpty {
                try declaration()
                return true
            }
            throw fail(target == "xml" ? "an XML declaration that is not at the start" : "the target \(target), which is reserved", at: frames.isEmpty ? start : -1)
        }
        if options.namespaces && xmlColon(target) >= 0 {
            throw fail("a colon in the target \(target)")
        }
        if starts("?>") {
            at += 2
            buffer.removeAll(keepingCapacity: true)
        } else {
            try requireSpace("after the target")
            try until(true, "a processing instruction")
        }
        markBuffered(.ProcessingInstruction)
        name = target
        return true
    }

    fn quoted(_ what: String) throws(XmlError) -> String {
        let quote = peek(0)
        if quote != 0x22 && quote != 0x27 {
            throw fail("a quoted \(what) is wanted here")
        }
        at += 1
        let start = at
        while at < bytes.count && Int(bytes[at]) != quote {
            at += 1
        }
        if at >= bytes.count {
            throw fail("the text ends inside \(what)")
        }
        at += 1
        return xmlString(bytes[start..<at - 1])
    }

    fn pseudo(_ name: String) throws(XmlError) -> String {
        at += name.utf8Count
        _ = space()
        try expect(0x3D, "'=' after \(name)")
        _ = space()
        return try quoted(name)
    }

    fn declaration() throws(XmlError) {
        try requireSpace("after '<?xml'")
        if !starts("version") {
            throw fail("the declaration's version is wanted")
        }
        let version = try pseudo("version")
        var digits = 0
        for byte in version.utf8 {
            digits += byte >= 0x30 && byte <= 0x39 ? 1 : 0
        }
        if !version.hasPrefix("1.") || digits != version.utf8Count - 1 || digits < 2 {
            throw fail("the version \(version), where 1.0 is wanted")
        }
        self.version = version
        var spaced = space()
        if starts("encoding") {
            if !spaced {
                throw fail("white space is wanted before encoding")
            }
            let encoding = try pseudo("encoding")
            var valid = !encoding.isEmpty
            var first = true
            for byte in encoding.utf8 {
                let letter = byte >= 0x61 && byte <= 0x7A || byte >= 0x41 && byte <= 0x5A
                valid = valid && (letter || !first && (byte >= 0x30 && byte <= 0x39 || byte == 0x2E || byte == 0x5F || byte == 0x2D))
                first = false
            }
            if !valid {
                throw fail("the encoding name '\(encoding)'")
            }
            let lower = xmlLower(encoding)
            let sixteen = lower.hasPrefix("utf-16") || lower == "iso-10646-ucs-2"
            if detected.hasPrefix("UTF-16") && !sixteen || detected == "UTF-8" && lower != "utf-8" || detected == "" && sixteen {
                throw fail("the encoding \(encoding), where the text is \(detected == "" ? "not UTF-16" : detected)")
            }
            self.encoding = encoding
            spaced = space()
        }
        if starts("standalone") {
            if !spaced {
                throw fail("white space is wanted before standalone")
            }
            let value = try pseudo("standalone")
            if value != "yes" && value != "no" {
                throw fail("standalone is yes or no, not '\(value)'")
            }
            standalone = value == "yes"
            _ = space()
        }
        if !starts("?>") {
            throw fail("'?>' is wanted to end the declaration")
        }
        at += 2
        mark(.Declaration, value: "")
    }

    fn startTag() throws(XmlError) {
        if state == 2 {
            throw fail("a second root element")
        }
        at += 1
        let qualified = try readName()
        dropAttributes()
        attributeBytes.removeAll(keepingCapacity: true)
        var empty = false
        while true {
            let spaced = space()
            let b = peek(0)
            if b == 0x3E {
                at += 1
                break
            }
            if b == 0x2F && peek(1) == 0x3E {
                at += 2
                empty = true
                break
            }
            if b < 0 {
                throw fail("the text ends inside the tag <\(nameText[qualified])>")
            }
            if !spaced {
                throw fail("white space is wanted before an attribute")
            }
            let name = try readName()
            _ = space()
            if peek(0) != 0x3D {
                // The message is made only when it is wanted.
                try expect(0x3D, "'=' after the attribute \(nameText[name])")
            }
            at += 1
            _ = space()
            let start = attributeBytes.count
            try attributeValue(&attributeBytes)
            if attributeNames.contains(name) {
                throw fail("the attribute \(nameText[name]) twice")
            }
            attributeNames.append(name)
            attributeStarts.append(start)
        }
        if !declaredNames.isEmpty {
            try declaredAttributes(nameText[qualified])
        }
        if openNames.count >= options.maxDepth {
            throw fail("elements nested deeper than \(options.maxDepth)")
        }
        let count = attributeNames.count
        // The attributes are the tag's, past this mark.
        clear(.StartElement)
        made = ""
        isBuffered = false
        state = 1
        openNames.append(qualified)
        try resolve(qualified, count)
        isEmptyElement = empty
        pendingEnd = empty
    }

    // The defaults of the attributes the element's list declares and the
    // tag does not have, and tokenized values collapsed.
    fn declaredAttributes(_ element: String) throws(XmlError) {
        guard let declared = declaredNames[element] else {
            return
        }
        let tokenized = declaredTokenized[element]!
        let defaults = declaredDefaults[element]!
        let given = attributeNames.count
        for i in 0..<declared.count {
            var found = -1
            for j in 0..<given {
                if nameText[attributeNames[j]] == declared[i] {
                    found = j
                }
            }
            if found >= 0 {
                if tokenized[i] {
                    collapse(found)
                }
            } else if let value = defaults[i] {
                var bytes: U8[>..] = []
                bytes.append(utf8: declared[i])
                let id = intern(bytes, 0, bytes.count)
                attributeNames.append(id)
                attributeStarts.append(attributeBytes.count)
                attributeBytes.append(utf8: value)
            }
        }
    }

    // A tokenized attribute's value: no space at either end, and one
    // between, in place.
    fn collapse(_ i: Int) {
        let start = attributeStarts[i]
        let end = i + 1 < attributeStarts.count ? attributeStarts[i + 1] : attributeBytes.count
        var collapsed: U8[>..] = []
        var pending = false
        var j = start
        while j < end {
            let byte = attributeBytes[j]
            if byte == 0x20 {
                pending = !collapsed.isEmpty
            } else {
                if pending {
                    collapsed.append(0x20)
                    pending = false
                }
                collapsed.append(byte)
            }
            j += 1
        }
        // The values after it move back by what it lost.
        var rest: U8[>..] = []
        rest.append(contentsOf: attributeBytes[end..<attributeBytes.count])
        attributeBytes.removeLast(attributeBytes.count - start)
        attributeBytes.append(contentsOf: collapsed[0..<collapsed.count])
        attributeBytes.append(contentsOf: rest[0..<rest.count])
        let lost = end - start - collapsed.count
        var k = i + 1
        while k < attributeStarts.count {
            attributeStarts[k] -= lost
            k += 1
        }
    }

    fn lookup(_ p: String) -> String? {
        if p == "xml" {
            return xmlNamespaceXml
        }
        if p == "xmlns" {
            return xmlNamespaceXmlns
        }
        var i = scopePrefixes.count - 1
        while i >= 0 {
            if scopePrefixes[i] == p {
                return scopeUris[i]
            }
            i -= 1
        }
        return p.isEmpty ? "" : none
    }

    // The element's and its attributes' namespaces, the declarations among
    // them in scope from here.
    fn resolve(_ qualified: Int, _ count: Int) throws(XmlError) {
        name = nameText[qualified]
        if !options.namespaces {
            localName = name
            for _ in 0..<count {
                attributeNamespaces.append("")
            }
            scopeCounts.append(0)
            return
        }
        var declared = 0
        for i in 0..<count {
            let flags = nameFlags[attributeNames[i]]
            if (flags & (xmlNameXmlns | xmlNameXmlnsPrefixed)) == 0 {
                continue
            }
            let bound = (flags & xmlNameXmlns) != 0 ? "" : nameLocal[attributeNames[i]]
            let uri = attributeValue(at: i)
            if bound == "xmlns" {
                throw fail("the prefix xmlns declared")
            }
            if bound == "xml" ? uri != xmlNamespaceXml : uri == xmlNamespaceXml {
                throw fail("the prefix xml is bound to \(xmlNamespaceXml), and only it is")
            }
            if uri == xmlNamespaceXmlns {
                throw fail("a prefix bound to \(xmlNamespaceXmlns)")
            }
            if !bound.isEmpty && (uri.isEmpty || !xmlIsName(bound, colons: false)) {
                throw fail(uri.isEmpty ? "the prefix \(bound) bound to no namespace" : "the prefix \(bound), which is not a name without a colon")
            }
            scopePrefixes.append(bound)
            scopeUris.append(uri)
            declared += 1
        }
        scopeCounts.append(declared)
        let flags = nameFlags[qualified]
        if (flags & xmlNameColon) != 0 && (flags & xmlNameQName) == 0 {
            throw fail("the name \(name), which is not a name with at most one colon", at: nodeStart)
        }
        self.prefix = namePrefix[qualified]
        localName = nameLocal[qualified]
        guard let uri = lookup(self.prefix) else {
            throw fail("the prefix \(self.prefix), which is not bound to a namespace", at: nodeStart)
        }
        namespace = uri
        for i in 0..<count {
            let id = attributeNames[i]
            let flags = nameFlags[id]
            if (flags & xmlNameColon) != 0 && (flags & xmlNameQName) == 0 {
                throw fail("the attribute name \(nameText[id]), which is not a name with at most one colon")
            }
            let attributePrefix = namePrefix[id]
            var attributeNamespace = ""
            if (flags & xmlNameXmlns) != 0 {
                attributeNamespace = xmlNamespaceXmlns
            } else if !attributePrefix.isEmpty {
                guard let bound = lookup(attributePrefix) else {
                    throw fail("the prefix \(attributePrefix), which is not bound to a namespace")
                }
                attributeNamespace = bound
            }
            if !attributeNamespace.isEmpty {
                let local = nameLocal[id]
                for j in 0..<i {
                    if nameLocal[attributeNames[j]] == local && attributeNamespaces[j] == attributeNamespace {
                        throw fail("the attribute {\(attributeNamespace)}\(local) twice")
                    }
                }
            }
            attributeNamespaces.append(attributeNamespace)
        }
    }

    // An attribute's value, references replaced and white space made
    // spaces, appended.
    fn attributeValue(_ into: inout U8[>..]) throws(XmlError) {
        let quote = peek(0)
        if quote != 0x22 && quote != 0x27 {
            throw fail("a quoted value is wanted here")
        }
        at += 1
        let base = frames.count
        while true {
            if at >= bytes.count {
                if frames.count > base {
                    try popFrame()
                    continue
                }
                throw fail("the text ends inside an attribute's value")
            }
            let b = bytes[at]
            if Int(b) == quote && frames.count == base {
                at += 1
                return
            }
            if b == 0x3C {
                throw fail("'<' in an attribute's value")
            }
            if b == 0x26 {
                if peek(1) == 0x23 {
                    xmlAppend(try characterReference(), to: &into)
                    continue
                }
                at += 1
                let name = try readNameText()
                try expect(0x3B, "';' after the entity's name")
                let code = predefined(name)
                if code >= 0 {
                    into.append(U8(code))
                    continue
                }
                guard let entity = entities[name] else {
                    throw fail("the entity \(name), which is not declared")
                }
                if entity.isExternal || entity.isUnparsed {
                    throw fail("a reference to the external entity \(name) in an attribute's value")
                }
                try push(name, entity.text)
                continue
            }
            if xmlIsSpace(b) {
                into.append(0x20)
                at += b == 0x0D && frames.isEmpty && peek(1) == 0x0A ? 2 : 1
                continue
            }
            if b >= 0x20 && b < 0x80 && Int(b) != quote && b != 0x26 {
                // A run of plain ASCII at once.
                let run = at
                at += 1
                while at < bytes.count {
                    let c = bytes[at]
                    if c < 0x21 || c >= 0x80 || Int(c) == quote || c == 0x26 || c == 0x3C {
                        break
                    }
                    at += 1
                }
                into.append(contentsOf: bytes[run..<at])
                continue
            }
            try character(&into)
        }
    }

    fn endTag() throws(XmlError) {
        at += 2
        let name = try readName()
        _ = space()
        try expect(0x3E, "'>' to end the end tag")
        if openNames.isEmpty {
            throw fail("the end tag </\(nameText[name])> after the root element", at: nodeStart)
        }
        let innermost = openNames[openNames.count - 1]
        if name != innermost {
            throw fail("</\(nameText[name])> where </\(nameText[innermost])> is wanted", at: nodeStart)
        }
        if !frames.isEmpty && openNames.count <= frames[frames.count - 1].depth {
            throw fail("an entity's end tag for an element it does not start")
        }
        endElement()
    }

    fn endElement() {
        let qualified = openNames.removeLast()
        mark(.EndElement, value: "")
        name = nameText[qualified]
        if options.namespaces {
            self.prefix = namePrefix[qualified]
            localName = nameLocal[qualified]
            namespace = lookup(self.prefix) ?? ""
        } else {
            localName = name
        }
        var declared = scopeCounts.removeLast()
        while declared > 0 {
            _ = scopePrefixes.removeLast()
            _ = scopeUris.removeLast()
            declared -= 1
        }
        if openNames.isEmpty {
            state = 2
        }
    }

    // ---- The DOCTYPE -----------------------------------------------------

    fn documentType() throws(XmlError) {
        if !options.allowsDocumentType {
            throw fail("a DOCTYPE, which these options do not allow")
        }
        if sawDocumentType || state != 0 {
            throw fail("a DOCTYPE after the root element or another DOCTYPE")
        }
        // What the declarations change, as it was, should the DOCTYPE not
        // be all there and be read again.
        let entities = self.entities
        let parameters = self.parameters
        let declaredNames = self.declaredNames
        let declaredTokenized = self.declaredTokenized
        let declaredDefaults = self.declaredDefaults
        do {
            try readDocumentType()
        } catch {
            sawDocumentType = false
            hasExternalSubset = false
            skippedDeclarations = false
            sawParameterReference = false
            self.entities = entities
            self.parameters = parameters
            self.declaredNames = declaredNames
            self.declaredTokenized = declaredTokenized
            self.declaredDefaults = declaredDefaults
            throw error
        }
    }

    fn readDocumentType() throws(XmlError) {
        sawDocumentType = true
        at += 9
        try requireSpace("after DOCTYPE")
        let name = try readNameText()
        let spaced = space()
        if starts("SYSTEM") || starts("PUBLIC") {
            if !spaced {
                throw fail("white space is wanted before the external identifier")
            }
            let ids = try externalIdentifier(systemOptional: false)
            publicId = ids[0]
            systemId = ids[1]
            hasExternalSubset = true
            _ = space()
        }
        var subset = ""
        if peek(0) == 0x5B {
            at += 1
            let start = at
            try internalSubset()
            subset = xmlString(bytes[start..<at - 1])
            _ = space()
        }
        try expect(0x3E, "'>' to end the DOCTYPE")
        mark(.DocumentType, value: subset)
        self.name = name
    }

    // The public and system identifiers, "" for one not there.
    fn externalIdentifier(systemOptional: Bool) throws(XmlError) -> String[>..] {
        if starts("SYSTEM") {
            at += 6
            try requireSpace("after SYSTEM")
            return ["", try quoted("a system literal")]
        }
        if !starts("PUBLIC") {
            throw fail("SYSTEM or PUBLIC is wanted here")
        }
        at += 6
        try requireSpace("after PUBLIC")
        let id = try quoted("a public identifier")
        for byte in id.utf8 {
            let ok = byte >= 0x61 && byte <= 0x7A || byte >= 0x41 && byte <= 0x5A || byte >= 0x30 && byte <= 0x39
                || byte == 0x20 || byte == 0x0D || byte == 0x0A
                || xmlPublicIdCharacters.contains(byte)
            if !ok {
                throw fail("a public identifier with the character \(byte)")
            }
        }
        let spaced = space()
        if systemOptional && (peek(0) != 0x22 && peek(0) != 0x27) {
            return [id, ""]
        }
        if !spaced {
            throw fail("white space is wanted before the system literal")
        }
        return [id, try quoted("a system literal")]
    }

    fn internalSubset() throws(XmlError) {
        while true {
            _ = space()
            if at >= bytes.count {
                if !frames.isEmpty {
                    try popFrame()
                    continue
                }
                throw fail("the text ends inside the DOCTYPE")
            }
            let b = bytes[at]
            if b == 0x5D {
                if !frames.isEmpty {
                    throw fail("']' inside a parameter entity")
                }
                at += 1
                return
            }
            if b == 0x25 {
                at += 1
                let name = try readNameText()
                try expect(0x3B, "';' after the parameter entity's name")
                sawParameterReference = true
                if let entity = parameters[name] {
                    if entity.isExternal {
                        skippedDeclarations = true
                    } else {
                        var padded: U8[>..] = [0x20]
                        padded.append(contentsOf: entity.text[0..<entity.text.count])
                        padded.append(0x20)
                        try push("%" + name, padded)
                    }
                } else {
                    if !mayLackDeclarations {
                        throw fail("the parameter entity %\(name), which is not declared")
                    }
                    skippedDeclarations = true
                }
                continue
            }
            if starts("<!--") {
                try comment()
            } else if starts("<?") {
                _ = try instruction()
            } else if starts("<!ENTITY") {
                try entityDeclaration()
            } else if starts("<!ELEMENT") {
                try elementDeclaration()
            } else if starts("<!ATTLIST") {
                try attributeListDeclaration()
            } else if starts("<!NOTATION") {
                try notationDeclaration()
            } else {
                throw fail("a markup declaration is wanted here")
            }
        }
    }

    fn endDeclaration() throws(XmlError) {
        _ = space()
        try expect(0x3E, "'>' to end the declaration")
    }

    fn entityDeclaration() throws(XmlError) {
        at += 8
        try requireSpace("after <!ENTITY")
        var parameter = false
        if peek(0) == 0x25 {
            at += 1
            try requireSpace("after '%'")
            parameter = true
        }
        let name = try readNameText()
        if options.namespaces && xmlColon(name) >= 0 {
            throw fail("a colon in the entity name \(name)")
        }
        try requireSpace("after the entity's name")
        var entity = XmlEntity { text: [], isExternal: false, isUnparsed: false }
        if peek(0) == 0x22 || peek(0) == 0x27 {
            entity.text = try entityValue()
        } else {
            _ = try externalIdentifier(systemOptional: false)
            entity.isExternal = true
            let spaced = space()
            if starts("NDATA") {
                if parameter || !spaced {
                    throw fail(parameter ? "NDATA of a parameter entity" : "white space is wanted before NDATA")
                }
                at += 5
                try requireSpace("after NDATA")
                _ = try readName()
                entity.isUnparsed = true
            }
        }
        try endDeclaration()
        if skippedDeclarations && standalone != true {
            return
        }
        if parameter {
            if parameters[name] == none {
                parameters[name] = entity
            }
        } else if entities[name] == none {
            entities[name] = entity
        }
    }

    // An entity's literal value: character references replaced, others kept.
    fn entityValue() throws(XmlError) -> U8[>..] {
        let quote = peek(0)
        at += 1
        var made: U8[>..] = []
        while true {
            if at >= bytes.count {
                throw fail("the text ends inside an entity's value")
            }
            let b = bytes[at]
            if Int(b) == quote {
                at += 1
                return made
            }
            if b == 0x25 {
                throw fail("a parameter entity's reference inside a declaration of the internal subset")
            }
            if b == 0x26 {
                if peek(1) == 0x23 {
                    xmlAppend(try characterReference(), to: &made)
                    continue
                }
                let start = at
                at += 1
                _ = try readName()
                try expect(0x3B, "';' after the entity's name")
                made.append(contentsOf: bytes[start..<at])
                continue
            }
            try character(&made)
        }
    }

    fn elementDeclaration() throws(XmlError) {
        at += 9
        try requireSpace("after <!ELEMENT")
        _ = try readName()
        try requireSpace("after the element's name")
        if starts("EMPTY") {
            at += 5
        } else if starts("ANY") {
            at += 3
        } else {
            try expect(0x28, "a content model")
            _ = space()
            if starts("#PCDATA") {
                at += 7
                _ = space()
                var names = 0
                while peek(0) == 0x7C {
                    at += 1
                    _ = space()
                    _ = try readName()
                    _ = space()
                    names += 1
                }
                try expect(0x29, "')' to end the mixed content")
                if names > 0 {
                    try expect(0x2A, "'*' after mixed content of names")
                } else if peek(0) == 0x2A {
                    at += 1
                }
            } else {
                try group()
                quantifier()
            }
        }
        try endDeclaration()
    }

    fn quantifier() {
        let b = peek(0)
        if b == 0x3F || b == 0x2A || b == 0x2B {
            at += 1
        }
    }

    // A choice or a sequence, after its '('.
    fn group() throws(XmlError) {
        _ = space()
        try contentParticle()
        _ = space()
        var separator = 0
        while peek(0) == 0x7C || peek(0) == 0x2C {
            if separator != 0 && separator != peek(0) {
                throw fail("'|' and ',' in one group")
            }
            separator = peek(0)
            at += 1
            _ = space()
            try contentParticle()
            _ = space()
        }
        try expect(0x29, "')' to end the group")
    }

    fn contentParticle() throws(XmlError) {
        if peek(0) == 0x28 {
            at += 1
            try group()
        } else {
            _ = try readName()
        }
        quantifier()
    }

    fn attributeListDeclaration() throws(XmlError) {
        at += 9
        try requireSpace("after <!ATTLIST")
        let element = try readNameText()
        let keep = !(skippedDeclarations && standalone != true)
        var names = declaredNames[element] ?? []
        var tokenized = declaredTokenized[element] ?? []
        var defaults = declaredDefaults[element] ?? []
        while true {
            let spaced = space()
            if peek(0) == 0x3E {
                at += 1
                if keep {
                    declaredNames[element] = names
                    declaredTokenized[element] = tokenized
                    declaredDefaults[element] = defaults
                }
                return
            }
            if !spaced {
                throw fail("white space is wanted before an attribute's definition")
            }
            let name = try readNameText()
            try requireSpace("after the attribute's name")
            let isTokenized = !starts("CDATA")
            try attributeType()
            try requireSpace("after the attribute's type")
            var value: String? = none
            if starts("#REQUIRED") {
                at += 9
            } else if starts("#IMPLIED") {
                at += 8
            } else {
                if starts("#FIXED") {
                    at += 6
                    try requireSpace("after #FIXED")
                }
                var literal: U8[>..] = []
                try attributeValue(&literal)
                value = xmlString(literal)
            }
            if !names.contains(name) {
                names.append(name)
                tokenized.append(isTokenized)
                if let given = value {
                    defaults.append(isTokenized ? xmlCollapsed(given) : given)
                } else {
                    defaults.append(none)
                }
            }
        }
    }

    fn attributeType() throws(XmlError) {
        for keyword in ["CDATA", "IDREFS", "IDREF", "ID", "ENTITIES", "ENTITY", "NMTOKENS", "NMTOKEN"] {
            if starts(keyword) {
                at += keyword.utf8Count
                return
            }
        }
        let notation = starts("NOTATION")
        if notation {
            at += 8
            try requireSpace("after NOTATION")
        }
        try expect(0x28, "an attribute's type")
        while true {
            _ = space()
            if notation {
                _ = try readName()
            } else {
                let start = at
                while at < bytes.count && xmlIsNameChar(xmlCode(bytes, at)) {
                    at += xmlWidth(bytes[at])
                }
                if at == start {
                    throw fail("a name token is wanted here")
                }
            }
            _ = space()
            if peek(0) != 0x7C {
                break
            }
            at += 1
        }
        try expect(0x29, "')' to end the enumeration")
    }

    fn notationDeclaration() throws(XmlError) {
        at += 10
        try requireSpace("after <!NOTATION")
        let name = try readNameText()
        if options.namespaces && xmlColon(name) >= 0 {
            throw fail("a colon in the notation name \(name)")
        }
        try requireSpace("after the notation's name")
        _ = try externalIdentifier(systemOptional: true)
        try endDeclaration()
    }
}

// A tokenized attribute's value: no space at either end, and one between.
fn xmlCollapsed(_ value: String) -> String {
    var made: U8[>..] = []
    var pending = false
    for byte in value.utf8 {
        if byte == 0x20 {
            pending = !made.isEmpty
        } else {
            if pending {
                made.append(0x20)
                pending = false
            }
            made.append(byte)
        }
    }
    return xmlString(made)
}
