module Negative.AttributeValidation

// What an attribute is checked for (spec/SYNTAX.md §22): written once, where
// it applies, with the arguments it takes; '@main' a place a program can
// start; '@intrinsic' Sable.Core's alone.

@inline(always)
@inline(never)                          //! S3513 '@inline' is written twice
fn twice() { }

@frozen                                 //! S3093 '@frozen' applies to a union, not to a struct
struct Settled { var n: Int }

fn hold(_ n: @escaping Int) -> Int {    //! S3093 'n' is of type 'Int'
    return n
}

@available(macos: "14.0")               //! S3094 '@available' names the platforms it is for
fn versioned() { }

@available(beos)                        //! S3094 'beos' is no platform
fn elsewhere() { }

@reflectable(true)                      //! S3094 '@reflectable' takes nothing, or 'callable'
struct Shown { }

@main                                   //! S3514 'start' takes no parameters
fn start(_ arguments: String[>..]) { }

@main
fn begin() { }

@main                                   //! S3514 a module has one, and 'begin' is it
fn again() { }

struct Holder {
    @main                               //! S3514 'run' is a function of the module, not a method
    fn run() { }

    @intrinsic                          //! S3081 only Sable.Core and Sable.Interop may declare an '@intrinsic'
    static fn name() -> String
}
