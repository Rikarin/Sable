module Sable.Core

// The numbers' own members: each written, abs'd and compared with its own
// kind. A signed integer's abs traps where it does not fit (the smallest
// value has no positive twin); an unsigned one's is itself. A float's min
// and max prefer a number to a NaN.

extension Int {
    /// The number in decimal.
    @builtin("string_from_Int")
    public fn toString() -> String

    /// The number's distance from zero.
    @builtin("abs_Int")
    public fn abs() -> Int

    /// The smaller of the two.
    @builtin("min_Int")
    public fn min(other: Int) -> Int

    /// The larger of the two.
    @builtin("max_Int")
    public fn max(other: Int) -> Int
}

extension I8 {
    /// The number in decimal.
    @builtin("string_from_I8")
    public fn toString() -> String

    /// The number's distance from zero.
    @builtin("abs_I8")
    public fn abs() -> I8

    /// The smaller of the two.
    @builtin("min_I8")
    public fn min(other: I8) -> I8

    /// The larger of the two.
    @builtin("max_I8")
    public fn max(other: I8) -> I8
}

