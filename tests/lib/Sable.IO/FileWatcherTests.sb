module FileWatcherTests

// FileWatcher, FileEvent and FileEventKind (Sable.IO).

import Sable.Concurrency
import Sable.IO
import Sable.Testing
import Sable.Time

// The next event of the kind at the path, what comes before it passed over;
// none in ten seconds.
fn comes(_ watcher: FileWatcher, _ kind: FileEventKind, _ path: FilePath) async -> Bool {
    let found = try? await withTimeout(Duration.seconds(10)) {
        for await event in watcher {
            if event.kind == kind && event.path == path {
                return true
            }
        }
        return false
    }
    return found ?? false
}

@test
fn whatHappensInADirectoryComes() async throws {
    let temp = try Temp.directory()
    let watcher = try FileWatcher.watch(temp.path)
    expect(watcher.path == temp.path)
    let path = temp.path.appending("file")
    try File.write(path, "one")
    expect(await comes(watcher, .Created, path))
    try await Task.sleep(for: Duration.milliseconds(100))
    try File.append(path, "two")
    expect(await comes(watcher, .Modified, path))
    try File.rename(from: path, to: temp.path.appending("other"))
    expect(await comes(watcher, .Removed, path))
}

@test
fn aRenameIsARemovalAndAMaking() async throws {
    let temp = try Temp.directory()
    let path = temp.path.appending("file")
    try File.write(path, "one")
    let watcher = try FileWatcher.watch(temp.path)
    try File.rename(from: path, to: temp.path.appending("other"))
    expect(await comes(watcher, .Created, temp.path.appending("other")))
    try File.remove(temp.path.appending("other"))
    expect(await comes(watcher, .Removed, temp.path.appending("other")))
}

@test
fn directoriesMadeLaterAreWatchedToo() async throws {
    let temp = try Temp.directory()
    try Directory.create(temp.path.appending("there"))
    let watcher = try FileWatcher.watch(temp.path)
    try File.write(temp.path.appending("there/a"), "a")
    expect(await comes(watcher, .Created, temp.path.appending("there/a")))
    try Directory.create(temp.path.appending("new/deep"), recursive: true)
    try File.write(temp.path.appending("new/deep/b"), "b")
    expect(await comes(watcher, .Created, temp.path.appending("new/deep/b")))
    try Directory.remove(temp.path.appending("new"), recursive: true)
    expect(await comes(watcher, .Removed, temp.path.appending("new")))
}

@test
fn aDirectoryAloneIsWatchedAlone() async throws {
    let temp = try Temp.directory()
    try Directory.create(temp.path.appending("inside"))
    let watcher = try FileWatcher.watch(temp.path, recursive: false)
    try File.write(temp.path.appending("inside/a"), "a")
    try File.write(temp.path.appending("b"), "b")
    var iterator = watcher.makeAsyncIterator()
    while true {
        let event = (await iterator.next())!
        assert(event.path != temp.path.appending("inside/a"))
        if event.path == temp.path.appending("b") {
            break
        }
    }
}

@test
fn aFileIsWatched() async throws {
    let temp = try Temp.directory()
    let path = temp.path.appending("file")
    try File.write(path, "one")
    let watcher = try FileWatcher.watch(path)
    try File.write(temp.path.appending("another"), "x")
    try File.append(path, "two")
    expect(await comes(watcher, .Modified, path))
    try File.remove(path)
    expect(await comes(watcher, .Removed, path))
}

@test
fn aTaskWaitingIsCancelled() async throws {
    let temp = try Temp.directory()
    let watcher = try FileWatcher.watch(temp.path)
    let waiting = Task.spawn { () -> Bool in
        for await event in watcher {
            if event.path.fileName == "never" {
                return false
            }
        }
        return true
    }
    try? await Task.sleep(for: Duration.milliseconds(30))
    waiting.cancel()
    expect(await waiting.value)
}

@test
fn nothingIsNotWatched() throws {
    let temp = try Temp.directory()
    do {
        _ = try FileWatcher.watch(temp.path.appending("missing"))
        fail("it is not there")
    } catch IoError.NotFound(_) { }
}

@test
fn twoWatchersBothHear() async throws {
    let temp = try Temp.directory()
    let one = try FileWatcher.watch(temp.path)
    let two = try FileWatcher.watch(temp.path)
    let path = temp.path.appending("file")
    try File.write(path, "x")
    expect(await comes(one, .Created, path))
    expect(await comes(two, .Created, path))
    let event = FileEvent { kind: .Created, path: path }
    expect(event == FileEvent { kind: .Created, path: path } && event != FileEvent { kind: .Rescan, path: path })
}

@test
fn aFileReplacedIsStillWatched() async throws {
    let temp = try Temp.directory()
    let path = temp.path.appending("file")
    try File.write(path, "one")
    let watcher = try FileWatcher.watch(path)
    // As an editor saves it, twice: what is watched is the path.
    for text in ["two", "three"] {
        try? await Task.sleep(for: Duration.milliseconds(100))
        let beside = try Temp.file(in: temp.path)
        try beside.file.write(text.utf8Bytes())
        try beside.persist(to: path)
        let heard = try? await withTimeout(Duration.seconds(10)) {
            for await event in watcher {
                assertEqual(event.path, path)
                if event.kind != .Removed {
                    return true
                }
            }
            return false
        }
        require(heard ?? false, text)
    }
    try File.remove(path)
    expect(await comes(watcher, .Removed, path))
    try File.write(path, "four")
    expect(await comes(watcher, .Created, path))
}

@test
fn whatIsMovedIsWatchedByItsNewName() async throws {
    let temp = try Temp.directory()
    let inside = temp.path.appending("inside")
    try Directory.create(inside.appending("a"), recursive: true)
    let watcher = try FileWatcher.watch(inside)

    // Within it, with a directory in it.
    try Directory.create(inside.appending("a/deep"))
    expect(await comes(watcher, .Created, inside.appending("a/deep")))
    try File.rename(from: inside.appending("a"), to: inside.appending("b"))
    expect(await comes(watcher, .Created, inside.appending("b")))
    try File.write(inside.appending("b/deep/x"), "x")
    expect(await comes(watcher, .Created, inside.appending("b/deep/x")))

    // Out of it: removed, and no longer watched.
    let outside = temp.path.appending("outside")
    try File.rename(from: inside.appending("b"), to: outside)
    expect(await comes(watcher, .Removed, inside.appending("b")))
    try File.write(outside.appending("deep/y"), "y")
    try File.write(inside.appending("after"), "z")
    var iterator = watcher.makeAsyncIterator()
    while true {
        let event = (await iterator.next())!
        assert(event.path.fileName != "y", "\(event.path)")
        if event.path.fileName == "after" {
            break
        }
    }

    // And in again.
    try File.rename(from: outside, to: inside.appending("c"))
    expect(await comes(watcher, .Created, inside.appending("c")))
    try File.write(inside.appending("c/deep/z"), "z")
    expect(await comes(watcher, .Created, inside.appending("c/deep/z")))
}

@test
fn theRemovalOfWhatIsWatchedComes() async throws {
    let temp = try Temp.directory()
    let path = temp.path.appending("d")
    try Directory.create(path)
    let watcher = try FileWatcher.watch(path)
    try Directory.remove(path)
    expect(await comes(watcher, .Removed, path))
}

// More happens than is kept: it is said that what is there must be looked
// at again, and what happens after is told as before.
@test
fn whatIsNotTakenInTimeIsARescan() async throws {
    let temp = try Temp.directory()
    let watcher = try FileWatcher.watch(temp.path)
    var i = 0
    while i < 10000 {
        let path = temp.path.appending("\(i)")
        try File.write(path, "")
        try File.remove(path)
        i += 1
    }
    try Directory.create(temp.path.appending("late"))
    try await Task.sleep(for: Duration.seconds(1))
    expect(await comes(watcher, .Rescan, temp.path))
    try File.write(temp.path.appending("late/x"), "x")
    expect(await comes(watcher, .Created, temp.path.appending("late/x")))
}
