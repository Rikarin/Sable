module Sable.Crypto

/// MD5's compression function, RFC 1321.
struct Md5Blocks: BlockHash {
    static var blockBytes: Int => 64

    static var stateBytes: Int => 16

    static var lengthBytes: Int => 8

    static var bigEndianLength: Bool => false

    static var kernel: Int => 0

    unsafe static fn compress(state: Int, block: Int) {
        var a = load32(state)
        var b = load32(state + 4)
        var c = load32(state + 8)
        var d = load32(state + 12)
        let k = md5Constants
        var i = 0
        while i < 16 {
            a = b &+ (a &+ (d ^ (b & (c ^ d))) &+ load32(k + 4 * i) &+ load32(block + 4 * i)).rotatedLeft(by: 7)
            d = a &+ (d &+ (c ^ (a & (b ^ c))) &+ load32(k + 4 * (i + 1)) &+ load32(block + 4 * (i + 1))).rotatedLeft(by: 12)
            c = d &+ (c &+ (b ^ (d & (a ^ b))) &+ load32(k + 4 * (i + 2)) &+ load32(block + 4 * (i + 2))).rotatedLeft(by: 17)
            b = c &+ (b &+ (a ^ (c & (d ^ a))) &+ load32(k + 4 * (i + 3)) &+ load32(block + 4 * (i + 3))).rotatedLeft(by: 22)
            i += 4
        }
        while i < 32 {
            a = b &+ (a &+ (c ^ (d & (b ^ c))) &+ load32(k + 4 * i) &+ load32(block + 4 * ((5 * i + 1) & 15))).rotatedLeft(by: 5)
            d = a &+ (d &+ (b ^ (c & (a ^ b))) &+ load32(k + 4 * (i + 1)) &+ load32(block + 4 * ((5 * i + 6) & 15))).rotatedLeft(by: 9)
            c = d &+ (c &+ (a ^ (b & (d ^ a))) &+ load32(k + 4 * (i + 2)) &+ load32(block + 4 * ((5 * i + 11) & 15))).rotatedLeft(by: 14)
            b = c &+ (b &+ (d ^ (a & (c ^ d))) &+ load32(k + 4 * (i + 3)) &+ load32(block + 4 * ((5 * i + 16) & 15))).rotatedLeft(by: 20)
            i += 4
        }
        while i < 48 {
            a = b &+ (a &+ (b ^ c ^ d) &+ load32(k + 4 * i) &+ load32(block + 4 * ((3 * i + 5) & 15))).rotatedLeft(by: 4)
            d = a &+ (d &+ (a ^ b ^ c) &+ load32(k + 4 * (i + 1)) &+ load32(block + 4 * ((3 * i + 8) & 15))).rotatedLeft(by: 11)
            c = d &+ (c &+ (d ^ a ^ b) &+ load32(k + 4 * (i + 2)) &+ load32(block + 4 * ((3 * i + 11) & 15))).rotatedLeft(by: 16)
            b = c &+ (b &+ (c ^ d ^ a) &+ load32(k + 4 * (i + 3)) &+ load32(block + 4 * ((3 * i + 14) & 15))).rotatedLeft(by: 23)
            i += 4
        }
        while i < 64 {
            a = b &+ (a &+ (c ^ (b | ~d)) &+ load32(k + 4 * i) &+ load32(block + 4 * ((7 * i) & 15))).rotatedLeft(by: 6)
            d = a &+ (d &+ (b ^ (a | ~c)) &+ load32(k + 4 * (i + 1)) &+ load32(block + 4 * ((7 * i + 7) & 15))).rotatedLeft(by: 10)
            c = d &+ (c &+ (a ^ (d | ~b)) &+ load32(k + 4 * (i + 2)) &+ load32(block + 4 * ((7 * i + 14) & 15))).rotatedLeft(by: 15)
            b = c &+ (b &+ (d ^ (c | ~a)) &+ load32(k + 4 * (i + 3)) &+ load32(block + 4 * ((7 * i + 21) & 15))).rotatedLeft(by: 21)
            i += 4
        }
        store32(load32(state) &+ a, state)
        store32(load32(state + 4) &+ b, state + 4)
        store32(load32(state + 8) &+ c, state + 8)
        store32(load32(state + 12) &+ d, state + 12)
    }
}

/// The absolute values of the sines of 1 to 64 radians, as 32-bit fractions.
let md5Constants: Int = constantTable([
    0xD76AA478, 0xE8C7B756, 0x242070DB, 0xC1BDCEEE, 0xF57C0FAF, 0x4787C62A, 0xA8304613, 0xFD469501,
    0x698098D8, 0x8B44F7AF, 0xFFFF5BB1, 0x895CD7BE, 0x6B901122, 0xFD987193, 0xA679438E, 0x49B40821,
    0xF61E2562, 0xC040B340, 0x265E5A51, 0xE9B6C7AA, 0xD62F105D, 0x02441453, 0xD8A1E681, 0xE7D3FBC8,
    0x21E1CDE6, 0xC33707D6, 0xF4D50D87, 0x455A14ED, 0xA9E3E905, 0xFCEFA3F8, 0x676F02D9, 0x8D2A4C8A,
    0xFFFA3942, 0x8771F681, 0x6D9D6122, 0xFDE5380C, 0xA4BEEA44, 0x4BDECFA9, 0xF6BB4B60, 0xBEBFBC70,
    0x289B7EC6, 0xEAA127FA, 0xD4EF3085, 0x04881D05, 0xD9D4D039, 0xE6DB99E5, 0x1FA27CF8, 0xC4AC5665,
    0xF4292244, 0x432AFF97, 0xAB9423A7, 0xFC93A039, 0x655B59C3, 0x8F0CCC92, 0xFFEFF47D, 0x85845DD1,
    0x6FA87E4F, 0xFE2CE6E0, 0xA3014314, 0x4E0811A1, 0xF7537E82, 0xBD3AF235, 0x2AD7D2BB, 0xEB86D391,
] as U32[>..])
