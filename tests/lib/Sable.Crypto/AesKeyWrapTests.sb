module AesKeyWrapTests

// AesKeyWrap (Sable.Crypto): the RFCs' cases, every length, and misuse. Run with
//     tools/stdlib-coverage.sh Sable.Crypto

import CryptoSupport
import Sable.Crypto
import Sable.Testing
import Sable.Text

/// A key wrapped as a standard has it: what a test's case is called is
/// where that says it.
struct Wrapped: Debug {
    let section: String
    let wrapping: String
    let key: String
    let wrapped: String

    fn debugDescription() -> String => section
}

let wrapping24 = "000102030405060708090a0b0c0d0e0f1011121314151617"
let wrapping32 = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
let rfc3394: Wrapped[>..] = [
    Wrapped(section: "4.1", wrapping: "000102030405060708090a0b0c0d0e0f", key: "00112233445566778899aabbccddeeff", wrapped: "1fa68b0a8112b447aef34bd8fb5a7b829d3e862371d2cfe5"),
    Wrapped(section: "4.2", wrapping: wrapping24, key: "00112233445566778899aabbccddeeff", wrapped: "96778b25ae6ca435f92b5b97c050aed2468ab8a17ad84e5d"),
    Wrapped(section: "4.3", wrapping: wrapping32, key: "00112233445566778899aabbccddeeff", wrapped: "64e8c3f9ce0f5ba263e9777905818a2a93c8191e7d6e8ae7"),
    Wrapped(section: "4.4", wrapping: wrapping24, key: "00112233445566778899aabbccddeeff0001020304050607", wrapped: "031d33264e15d33268f24ec260743edce1c6c7ddee725a936ba814915c6762d2"),
    Wrapped(section: "4.5", wrapping: wrapping32, key: "00112233445566778899aabbccddeeff0001020304050607", wrapped: "a8f9bc1612c68b3ff6e6f4fbe30e71e4769c8b80a32cb8958cd5d17d6b254da1"),
    Wrapped(section: "4.6", wrapping: wrapping32, key: "00112233445566778899aabbccddeeff000102030405060708090a0b0c0d0e0f", wrapped: "28c9f404c4b810f4cbccb35cfb87f8263f5786e2d80ed326cbc7f0e71a99f43bfb988b9b7a02dd21"),
]

@test(arguments: rfc3394)
fn wrappingIsAsPublished(_ one: Wrapped) throws {
    let cipher = try AesKeyWrap(key: SymmetricKey(hex(one.wrapping)))
    let secret = SymmetricKey(hex(one.key))
    expect(Hex.encode(try cipher.wrap(secret)) == one.wrapped)
    expect(try cipher.unwrap(hex(one.wrapped)) == secret)
}

// RFC 5649, §6: 20 bytes, and 7.
let rfc5649: Wrapped[>..] = [
    Wrapped(section: "20 bytes", wrapping: "5840df6e29b02af1ab493b705bf16ea1ae8338f4dcc176a8", key: "c37b7e6492584340bed12207808941155068f738", wrapped: "138bdeaa9b8fa7fc61f97742e72248ee5ae6ae5360d1ae6a5f54f373fa543b6a"),
    Wrapped(section: "7 bytes", wrapping: "5840df6e29b02af1ab493b705bf16ea1ae8338f4dcc176a8", key: "466f7250617369", wrapped: "afbeb0f07dfbf5419200f2ccb50bb24f"),
]

@test(arguments: rfc5649)
fn paddedWrappingIsAsPublished(_ one: Wrapped) throws {
    let cipher = try AesKeyWrap(key: SymmetricKey(hex(one.wrapping)))
    let secret = SymmetricKey(hex(one.key))
    expect(Hex.encode(try cipher.wrapPadded(secret)) == one.wrapped)
    expect(try cipher.unwrapPadded(hex(one.wrapped)) == secret)
}

@test
fn everyLengthIsUnwrapped() {
    let cipher = try! AesKeyWrap(key: SymmetricKey(message(32)))
    for count in 1..<80 {
        let key = SymmetricKey(message(count))
        let padded = try! cipher.wrapPadded(key)
        assertEqual(padded.count, (count + 7) / 8 * 8 + 8)
        assertEqual((try! cipher.unwrapPadded(padded)), key)
        if count >= 16 && count % 8 == 0 {
            let wrapped = try! cipher.wrap(key)
            expect(wrapped.count == count + 8 && wrapped != padded, "\(count) bytes")
            assertEqual((try! cipher.unwrap(wrapped)), key)
            refused(cipher, wrapped, padded: true)
            refused(cipher, padded, padded: false)
        } else {
            expectThrows(saying: "a key to wrap without padding has a multiple of 8 bytes, and 16 at least, not \(count)") { _ = try cipher.wrap(key) }
        }
    }
    expectThrows(saying: "a key to wrap has 1 to 4294967295 bytes, not 0") { _ = try cipher.wrapPadded(SymmetricKey([])) }
}

fn refused(_ cipher: AesKeyWrap, _ wrapped: U8[:], padded: Bool) {
    expectThrows(CryptoError.AuthenticationFailed) { _ = padded ? try cipher.unwrapPadded(wrapped) : try cipher.unwrap(wrapped) }
}

@test
fn whatIsChangedIsRefused() {
    let cipher = try! AesKeyWrap(key: SymmetricKey(message(16)))
    let wrapped = try! cipher.wrap(SymmetricKey(message(32)))
    let padded = try! cipher.wrapPadded(SymmetricKey(message(29)))
    let short = try! cipher.wrapPadded(SymmetricKey(message(5)))
    for bit in 0..<8 * wrapped.count {
        var other = wrapped
        other[bit / 8] = other[bit / 8] ^ (1 << U8(bit % 8))
        refused(cipher, other, padded: false)
    }
    for bit in 0..<8 * padded.count {
        var other = padded
        other[bit / 8] = other[bit / 8] ^ (1 << U8(bit % 8))
        refused(cipher, other, padded: true)
    }
    for bit in 0..<8 * short.count {
        var other = short
        other[bit / 8] = other[bit / 8] ^ (1 << U8(bit % 8))
        refused(cipher, other, padded: true)
    }
    for count in 0..<wrapped.count {
        refused(cipher, wrapped[..<count], padded: false)
        refused(cipher, padded[..<(count < padded.count ? count : 0)], padded: true)
    }
    refused(try! AesKeyWrap(key: SymmetricKey(message(17)[1...])), wrapped, padded: false)
    refused(try! AesKeyWrap(key: SymmetricKey(message(17)[1...])), padded, padded: true)
}

// The right constant, and a length or padding that is not: made of the block
// cipher, as the shortest wrapped key is one block.
@test
fn wrongPaddingIsRefused() {
    let key = SymmetricKey(message(16))
    let cipher = try! AesKeyWrap(key: key)
    let block = try! Hazmat.AesEcb(key: key)
    for length in 0..<20 {
        var plain = hex("a65959a6")
        plain.append(contentsOf: [0, 0, 0, U8(length)])
        plain.append(contentsOf: [1, 2, 3, 4, 5, 6, 7, 0])
        let wrapped = try! block.encrypt(plain)
        if length == 7 || length == 8 {
            require((try! cipher.unwrapPadded(wrapped)) == SymmetricKey(plain[8..<8 + length]))
        } else {
            refused(cipher, wrapped, padded: true)
        }
    }
    refused(cipher, try! block.encrypt(hex("a65959a6ffffffff0102030405060708")), padded: true)
    refused(cipher, try! block.encrypt(hex("a65959a7000000080102030405060708")), padded: true)
    refused(cipher, try! block.encrypt(hex("a65959a6000000050102030405000100")), padded: true)
    refused(cipher, try! block.encrypt(hex("a65959a6000000050102030405800000")), padded: true)
}

@test
fn theWrappingKeyHasItsLength() {
    expectThrows(saying: "an AES key has 16, 24 or 32 bytes, not 20") { _ = try AesKeyWrap(key: SymmetricKey(message(20))) }
}
