module Sable.Concurrency

// A dictionary many threads use at once, as .NET's ConcurrentDictionary:
// its entries are spread over shards by their keys' hashes, each shard a
// Dictionary behind a lock of its own, so that threads working on keys of
// different shards never wait for each other. The shards are raw memory,
// each Dictionary in the room on its lock's cache line (Runtime.lockRoom),
// rather than an array of Mutex objects: reaching an object would retain and
// release it, and every thread counting the same objects up and down would
// pass their cache lines from core to core on every operation. Each operation on one key is
// atomic: it holds that key's shard for its whole length, the closure of
// getOrInsert and update included. What spans shards (count, iteration) sees
// each shard as it is when it gets to it, not all of them at one moment.

/// A dictionary for many threads at once, each operation on a key atomic:
/// .NET's `ConcurrentDictionary`. Its keys and values cross from thread to
/// thread, so they are Sendable.
///
/// ```sable
/// let hits = ConcurrentDictionary<String, Int>()
/// hits.update("home", default: 0) { $0 += 1 }
/// hits.update("home", default: 0) { $0 += 1 }
/// assert(hits["home"] == 2)
/// assert(hits.getOrInsert("about", with: { 10 }) == 10)
/// assert(hits.getOrInsert("about", with: { 20 }) == 10)
/// assert(hits.count == 2)
/// ```
@immutable
public final class ConcurrentDictionary<Key: Hashable & Sendable, Value: Sendable>: Sequence {
    public alias Element = (key: Key, value: Value)
    public alias Iter = ConcurrentDictionaryIterator<Key, Value>

    // The shards' locks, each with its Dictionary in the room before it.
    let locks: RawPtr<Int>
    let mask: Int

    /// An empty dictionary, with as many shards as threads that may use it
    /// at once without waiting for each other: 64 unless given, rounded up
    /// to a power of two.
    public init(shards count: Int = 64) {
        var size = 1
        while size < count {
            size = size * 2
        }
        mask = size - 1
        unsafe {
            locks = RawPtr<Int>.allocate(count: size)
            for i in 0..<size {
                let lock = Runtime.lockNew()
                locks.initialize(to: lock, at: i)
                shard(lock).initialize(to: [:])
            }
        }
    }

    deinit {
        unsafe {
            for i in 0...mask {
                let lock = locks.load(at: i)
                shard(lock).deinitialize()
                Runtime.lockFree(lock)
            }
            locks.deallocate()
        }
    }

    // The Dictionary a shard's lock guards.
    fn shard(_ lock: Int) -> RawPtr<[Key: Value]> {
        return RawPtr<[Key: Value]>(address: lock - Runtime.lockRoom)
    }

    // Who takes a shard's lock moves its Dictionary out and back in, so that
    // it is the only reference to its arrays, and changes them in place; and,
    // if it changed it, shares it first, as its arrays may be new ones (what
    // is stored in an array that is shared already is shared as it goes in).

    // The lock of the key's shard, taken. The shard is chosen by the hash's
    // high bits, as the shard's own Dictionary places its keys by the low
    // ones.
    fn acquire(_ key: Key) -> Int {
        unsafe {
            let lock = locks.load(at: (key.hashValue >> 40) & mask)
            Runtime.lockAcquire(lock)
            return lock
        }
    }

    /// The closure's result for shard i's Dictionary, its lock held.
    fn withShard<R>(_ i: Int, _ body: (inout [Key: Value]) -> R) -> R {
        unsafe {
            let lock = locks.load(at: i)
            Runtime.lockAcquire(lock)
            var entries = shard(lock).move()
            let result = body(&entries)
            Runtime.share(entries)
            shard(lock).initialize(to: move entries)
            Runtime.lockRelease(lock)
            return result
        }
    }

    /// The key's value, or none.
    public subscript(key: Key) -> Value? {
        get {
            let lock = acquire(key)
            unsafe {
                var entries = shard(lock).move()
                let value = entries[key]
                shard(lock).initialize(to: move entries)
                Runtime.lockRelease(lock)
                return value
            }
        }
    }

    /// Whether the key has a value.
    public fn contains(_ key: Key) -> Bool {
        let lock = acquire(key)
        unsafe {
            var entries = shard(lock).move()
            let found = entries.contains(key)
            shard(lock).initialize(to: move entries)
            Runtime.lockRelease(lock)
            return found
        }
    }

    /// Sets the key's value, and gives the value it replaced, if any.
    public fn updateValue(_ value: Value, forKey key: Key) -> Value? {
        Runtime.share(key)
        Runtime.share(value)
        let lock = acquire(key)
        unsafe {
            var entries = shard(lock).move()
            let result = entries.updateValue(value, forKey: key)
            Runtime.share(entries)
            shard(lock).initialize(to: move entries)
            Runtime.lockRelease(lock)
            return result
        }
    }

    /// Sets the key's value if it has none: whether it did (.NET's TryAdd).
    public fn insert(_ value: Value, forKey key: Key) -> Bool {
        Runtime.share(key)
        Runtime.share(value)
        let lock = acquire(key)
        unsafe {
            var entries = shard(lock).move()
            let result = entries.insert(value, forKey: key)
            Runtime.share(entries)
            shard(lock).initialize(to: move entries)
            Runtime.lockRelease(lock)
            return result
        }
    }

    /// Removes the key, and gives the value it had, if any.
    public fn remove(_ key: Key) -> Value? {
        let lock = acquire(key)
        unsafe {
            var entries = shard(lock).move()
            let result = entries.remove(key)
            Runtime.share(entries)
            shard(lock).initialize(to: move entries)
            Runtime.lockRelease(lock)
            return result
        }
    }

    /// The key's value, made by the closure and kept if it has none (.NET's
    /// GetOrAdd). The closure runs at most once, holding the key's shard:
    /// two threads that ask for the same key at once get the one value.
    public fn getOrInsert(_ key: Key, with make: () -> Value) -> Value {
        Runtime.share(key)
        let lock = acquire(key)
        unsafe {
            var entries = shard(lock).move()
            let result = entries.orInsertWith(key, make)
            Runtime.share(entries)
            shard(lock).initialize(to: move entries)
            Runtime.lockRelease(lock)
            return result
        }
    }

    /// Changes the key's value in place, holding its shard: whether it had
    /// one to change.
    public fn update(_ key: Key, _ change: (inout Value) -> Void) -> Bool {
        let lock = acquire(key)
        unsafe {
            var entries = shard(lock).move()
            let result = entries.modify(key, change)
            Runtime.share(entries)
            shard(lock).initialize(to: move entries)
            Runtime.lockRelease(lock)
            return result
        }
    }

    /// Changes the key's value in place, starting from the default when it
    /// has none, holding its shard (.NET's AddOrUpdate).
    public fn update(_ key: Key, default fallback: Value, _ change: (inout Value) -> Void) {
        Runtime.share(key)
        Runtime.share(fallback)
        let lock = acquire(key)
        unsafe {
            var entries = shard(lock).move()
            entries.modify(key, default: fallback, change)
            Runtime.share(entries)
            shard(lock).initialize(to: move entries)
            Runtime.lockRelease(lock)
        }
    }

    /// Removes every entry, one shard after another.
    public fn removeAll() {
        var i = 0
        while i <= mask {
            withShard(i) { $0.removeAll() }
            i = i + 1
        }
    }

    /// How many entries there are, counted a shard at a time.
    public var count: Int {
        get {
            var total = 0
            var i = 0
            while i <= mask {
                total = total + withShard(i) { $0.count }
                i = i + 1
            }
            return total
        }
    }

    /// Whether there are no entries, looked at a shard at a time.
    public var isEmpty: Bool {
        get {
            var i = 0
            while i <= mask {
                if !withShard(i, { $0.isEmpty }) {
                    return false
                }
                i = i + 1
            }
            return true
        }
    }

    /// The entries as an ordinary Dictionary, copied a shard at a time.
    public fn snapshot() -> [Key: Value] {
        var all: [Key: Value] = [:]
        var i = 0
        while i <= mask {
            withShard(i) { entries in
                for (key, value) in entries {
                    all[key] = value
                }
            }
            i = i + 1
        }
        return all
    }

    /// The entries, a shard at a time: each shard as it is when the
    /// iterator reaches it, so that writes on other threads go on meanwhile,
    /// and an entry that is there throughout is given exactly once.
    public fn makeIterator() -> ConcurrentDictionaryIterator<Key, Value> {
        return ConcurrentDictionaryIterator { dictionary: self, next: 0, entries: [], position: 0 }
    }
}

/// Gives a ConcurrentDictionary's entries, a shard's copy at a time.
public struct ConcurrentDictionaryIterator<Key: Hashable & Sendable, Value: Sendable>: Iterator {
    let dictionary: ConcurrentDictionary<Key, Value>
    var next: Int
    var entries: (key: Key, value: Value)[>..]
    var position: Int

    public mutating fn next() -> (key: Key, value: Value)? {
        while position >= entries.count {
            if next > dictionary.mask {
                return none
            }
            entries = dictionary.withShard(next) { shard in
                var copied: (key: Key, value: Value)[>..] = []
                for (key, value) in shard {
                    copied.append((key: key, value: value))
                }
                return copied
            }
            position = 0
            next = next + 1
        }
        let entry = entries[position]
        position = position + 1
        return entry
    }
}
