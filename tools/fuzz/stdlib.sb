module FuzzStdlib

// Fuzz targets over the standard library for 'sable fuzz', which the nightly
// workflow runs (.github/workflows/fuzz.yml): each takes the fuzzer's bytes
// and fails by trapping. By hand, with a clang that has libFuzzer:
//
//     sable fuzz tools/fuzz/stdlib.sb utf8 --time 10m
//     sable fuzz tools/fuzz/stdlib.sb --replay      # every saved input, once

import Sable.Testing
import Sable.Text

/// UTF-8 in and out: bytes that decode encode back as themselves, and a lossy
/// decoding of any bytes is text that encodes and decodes as itself.
@fuzz
fn utf8(_ data: U8[:]) {
    if let text = try? String.fromUtf8(data) {
        let again = text.utf8Bytes()
        assert(again.count == data.count, "decoded UTF-8 encodes to another length")
        for i in 0..<data.count {
            assert(again[i] == data[i], "decoded UTF-8 encodes to other bytes")
        }
    }
    let lossy = String.fromUtf8Lossy(data)
    let bytes = lossy.utf8Bytes()
    if let back = try? String.fromUtf8(bytes) {
        assert(back == lossy, "a lossy decoding does not read back as itself")
    } else {
        fatalError("a lossy decoding is not UTF-8")
    }
}

/// Integers as text: what parses prints as text that parses as the same
/// number; and any text is parsed in any base, or refused, without a trap.
@fuzz
fn integers(_ data: U8[:]) {
    let text = String.fromUtf8Lossy(data)
    if let n = try? Int.parse(text) {
        assert((try? Int.parse("\(n)")) == n, "a parsed integer does not print as itself")
    }
    for radix in [2, 8, 16, 36] {
        _ = try? Int.parse(text, radix: radix)
    }
}
