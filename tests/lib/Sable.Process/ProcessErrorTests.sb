module ProcessErrorTests

// ProcessError (Sable.Process), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Process

import Sable.IO
import Sable.Process
import Sable.Testing

fn isAnError<T>(_ value: T) -> Bool where T: Error {
    return true
}

@test
fn aProcessErrorIsAnError() {
    expect(isAnError(ProcessError.NotFound(program: "nothing-by-this-name")))
}

let errors: (ProcessError, String)[>..] = [
    (ProcessError.NotFound(program: "nothing-by-this-name"), "no program 'nothing-by-this-name' could be started"),
    (ProcessError.PermissionDenied(program: "x"), "'x' may not be run"),
    (ProcessError.NotExecutable(program: "x"), "'x' is not a program the system can run"),
    (ProcessError.NoDirectory(path: "x"), "no directory 'x' to start a program in"),
    (ProcessError.File(path: "x"), "'x' could not be opened for a program's stream"),
    (ProcessError.InvalidArgument(text: "x"), "'x' cannot be given to a program"),
    (ProcessError.Unsupported, "this system cannot do that"),
    (ProcessError.Cancelled, "the task was cancelled"),
    (ProcessError.Io(error: IoError.Disconnected), IoError.Disconnected.description()),
    (ProcessError.Os(program: "x", code: 11), "'x' could not be started: the system's error 11"),
]

@test(arguments: errors)
fn aProcessErrorSaysWhatCouldNotBeDone(_ error: ProcessError, _ text: String) {
    expect(error.description() == text)
}
