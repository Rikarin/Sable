module Sable.Concurrency

// Waits that suspend a task rather than block its thread: what a task on
// the shared pool takes instead of Mutex and Semaphore, whose waits block
// the worker. One count says how many permits are free, or, under 0, how many
// tasks wait for one, so that a task which need not wait changes it once and
// takes no lock. A permit released while tasks wait is granted to the one
// that came first (WaitList.grant), and no task that comes by takes it.

/// So many permits, each held by one task at a time: .NET's `SemaphoreSlim`
/// with `WaitAsync`. A task waiting for a permit is suspended, not blocked.
///
/// ```sable
/// let slots = AsyncSemaphore(permits: 1)
/// await slots.acquire()
/// assert(!slots.tryAcquire())
/// slots.release()
/// assert(slots.availablePermits == 1)
/// ```
@immutable
public final class AsyncSemaphore {
    // The permits free, less the tasks that wait for one.
    let permits: Atomic<Int>
    let released: WaitList

    /// A semaphore with so many permits free.
    public init(permits: Int) {
        precondition(permits >= 0, "a semaphore cannot have \(permits) permits")
        self.permits = Atomic<Int>(permits)
        released = WaitList()
    }

    /// How many permits are free now.
    public var availablePermits: Int {
        get {
            let free = permits.load()
            return free > 0 ? free : 0
        }
    }

    /// Takes a permit, suspending until one is released if none is free.
    public fn acquire() async {
        if permits.add(-1) <= 0 {
            await released.parkForGrant()
        }
    }

    /// Takes a permit if one is free now: whether it did.
    public fn tryAcquire() -> Bool {
        var free = permits.load()
        while free > 0 {
            let (exchanged, now) = permits.compareExchange(expected: free, desired: free - 1)
            if exchanged {
                return true
            }
            free = now
        }
        return false
    }

    /// Gives back so many permits: to the tasks waiting for them first.
    public fn release(count: Int = 1) {
        precondition(count > 0, "cannot release \(count) permits")
        giveBack(count, atMost: Int.max)
    }

    // So many given back, as long as no more than so many are then free.
    fn giveBack(_ count: Int, atMost most: Int) {
        var free = permits.load()
        while free <= most - count {
            let (exchanged, now) = permits.compareExchange(expected: free, desired: free + count)
            if exchanged {
                // As many of them as waited for a permit.
                var granted = 0
                while granted < count && free + granted < 0 {
                    released.grant()
                    granted += 1
                }
                return
            }
            free = now
        }
    }
}
