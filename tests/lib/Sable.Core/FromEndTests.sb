module FromEndTests

// FromEnd (Sable.Core): a position counted back from a collection's end,
// what '^n' makes, and reading by one.

import Sable.Testing

@test
fn aCaretMakesTheCountBackFromTheEnd() {
    let last = ^1
    assertEqual(last.n, 1)
    assertEqual(^(2 + 1), FromEnd(3))
    expect(^1 != ^2)
    assertEqual((^4).debugDescription(), "^4")
}

@test
fn equalPositionsHashAlike() {
    var seen: [FromEnd: Int] = [:]
    seen[^1] = 10
    seen[FromEnd(1)] = 20
    assertEqual(seen.count, 1)
    assertEqual(seen[^1], 20)
}

@test
fn theElementOffsetIsTheCountLessN() {
    assertEqual((^1).elementOffset(in: 3), 2)
    assertEqual((^3).elementOffset(in: 3), 0)
}

@test(traps: "index ^4 is out of range for count 3")
fn anOffsetPastTheStartTraps() {
    _ = FromEnd(blackBox(4)).elementOffset(in: 3)
}

@test(traps: "index ^0 is out of range for count 3")
fn theEndIsNoElement() {
    _ = FromEnd(blackBox(0)).elementOffset(in: 3)
}

@test(traps: "index ^-1 is out of range for count 3")
fn aNegativeCountTrapsRatherThanCountingFromTheStart() {
    _ = FromEnd(blackBox(-1)).elementOffset(in: 3)
}

@test
fn everyKindOfArrayIsReadFromTheEnd() {
    let fixed: Int[] = [1, 2, 3]
    let grown: Int[>..] = [4, 5, 6]
    let slice: Int[:] = grown[1...]
    assertEqual(fixed[^1], 3)
    assertEqual(fixed[^3], 1)
    assertEqual(grown[^2], 5)
    assertEqual(slice[^1], 6)
    assertEqual(slice[^2], 5)
    let n = 1
    assertEqual(grown[^(n + 1)], 5)
}

@test
fn aRangeOfIntegersIsReadFromTheEnd() {
    assertEqual((0..<10)[^1], 9)
    assertEqual((3..<6)[^3], 3)
}

@test
fn aStringIsReadFromTheEndByCharacter() {
    let text = "naïve"
    assertEqual(text[^1], 'e')
    assertEqual(text[^3], 'ï')
    assertEqual(text[^5], 'n')
}

@test(traps: "index ^6 is out of range for count 5")
fn aStringPastItsStartTraps() {
    _ = "naïve"[^blackBox(6)]
}

@test(traps: "index ^0 is out of range for count 5")
fn theEndOfAStringIsNoCharacter() {
    _ = "naïve"[^blackBox(0)]
}

@test(traps: "index ^3 is out of range for count 2")
fn anArrayPastItsStartTraps() {
    let xs = [1, 2]
    _ = xs[^blackBox(3)]
}

fn lastOf<C: BidirectionalCollection>(_ c: C) -> C.Element {
    return c[^1]
}

@test
fn genericCodeReadsFromTheEndOfAnyBidirectionalCollection() {
    assertEqual(lastOf([1, 2, 3]), 3)
    assertEqual(lastOf("abc"), 'c')
}
