module ConcurrentDictionaryBench

import Sable.Concurrency

// ConcurrentDictionary<Int, Int> against .NET 11's: four tasks on the pool,
// each counting a quarter of a million keys of 4096 with update(_:default:)
// (.NET's AddOrUpdate) and reading one back with getOrInsert (GetOrAdd).
// ../dotnet/Program.cs does the same with four threads, and prints the same
// line.

@main
fn main() async {
    let counts = ConcurrentDictionary<Int, Int>()
    await withTaskGroup(of: Int.self) { group in
        var task = 0
        while task < 4 {
            let seed = task
            group.spawn {
                var x = seed * 7919 + 1
                var i = 0
                while i < 250000 {
                    x = (x * 1103515245 + 12345) % 2147483648
                    let key = x % 4096
                    counts.update(key, default: 0) { $0 += 1 }
                    counts.getOrInsert(key + 4096, with: { 1 })
                    i = i + 1
                }
                return 0
            }
            task = task + 1
        }
        await group.waitForAll()
    }
    var total = 0
    for entry in counts {
        total = total + entry.value
    }
    print("\(counts.count) \(total)")
}
