module ArrayReorderTests

// Moving an array's elements in place (Sable.Core, Array+Reorder.sb),
// tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

@test
fn swapAtExchangesTwoElements() {
    var xs: String[>..] = ["a", "b", "c"]
    xs.swapAt(0, 2)
    expect(xs == ["c", "b", "a"])
    xs.swapAt(1, 1)
    expect(xs == ["c", "b", "a"])
}

@test
fn swapAtChangesTheArrayItIsCalledOnOnly() {
    var xs: Int[>..] = [1, 2]
    let kept = xs
    xs.swapAt(0, 1)
    expect(xs == [2, 1])
    expect(kept == [1, 2])
}

@test(traps: "array index out of range")
fn swapAtOutsideTheArrayTraps() {
    var xs: Int[>..] = [1, 2]
    xs.swapAt(0, 2)
}

@test
fn reversePutsTheElementsInTheOppositeOrder() {
    var even: Int[>..] = [1, 2, 3, 4]
    even.reverse()
    expect(even == [4, 3, 2, 1])
    var odd: Int[] = [1, 2, 3]
    odd.reverse()
    expect(odd == [3, 2, 1])
    var empty: Int[>..] = []
    empty.reverse()
    assertEqual(empty.count, 0)
}

@test
fn reversedLeavesTheArrayAsItWas() {
    let xs: String[>..] = ["x", "y", "z"]
    expect(xs.reversed().toArray() == ["z", "y", "x"])
    expect(xs == ["x", "y", "z"])
    expect(xs[1...].reversed().toArray() == ["z", "y"])
}

@test
fn rotateLeftBringsAnElementToTheFront() {
    var xs: Int[>..] = [1, 2, 3, 4, 5]
    xs.rotate(left: 2)
    expect(xs == [3, 4, 5, 1, 2])
    xs.rotate(left: 0)
    expect(xs == [3, 4, 5, 1, 2])
    xs.rotate(left: 5)
    expect(xs == [3, 4, 5, 1, 2])
    xs.rotate(left: 7)
    expect(xs == [5, 1, 2, 3, 4])
}

@test
fn rotateRightAndNegativeCountsGoTheOtherWay() {
    var xs: Int[>..] = [1, 2, 3, 4, 5]
    xs.rotate(right: 1)
    expect(xs == [5, 1, 2, 3, 4])
    xs.rotate(left: -1)
    expect(xs == [4, 5, 1, 2, 3])
    var empty: Int[>..] = []
    empty.rotate(left: 3)
    assertEqual(empty.count, 0)
}

@test
fn rotateARangeLeavesTheRestWhereItIs() {
    var xs: String[>..] = ["a", "b", "c", "d", "e"]
    xs.rotate(from: 1, to: 4, left: 1)
    expect(xs == ["a", "c", "d", "b", "e"])
    xs.rotate(from: 1, to: 4, left: -1)
    expect(xs == ["a", "b", "c", "d", "e"])
    xs.rotate(from: 3, to: 3, left: 2)
    xs.rotate(from: 0, to: 2, left: 2)
    expect(xs == ["a", "b", "c", "d", "e"])
}

@test(traps: "array slice out of range")
fn rotateARangePastTheEndTraps() {
    var xs: Int[>..] = [1, 2, 3]
    xs.rotate(from: 2, to: 4, left: 1)
}

@test(traps: "array slice out of range")
fn rotateARangeTheWrongWayRoundTraps() {
    var xs: Int[>..] = [1, 2, 3]
    xs.rotate(from: 2, to: 1, left: 1)
}

@test
fn fillSetsEveryElement() {
    var xs: String[>..] = ["a", "b", "c"]
    xs.fill("z")
    expect(xs == ["z", "z", "z"])
}

@test
fn copyFromSetsEachElementFromTheSource() {
    var xs: Int[>..] = [0, 0, 0]
    let source: Int[>..] = [9, 7, 8, 9, 6]
    xs.copy(from: source[1..<4])
    expect(xs == [7, 8, 9])
}

@test(traps: "array index out of range")
fn copyFromAShorterSourceTraps() {
    var xs: Int[>..] = [0, 0, 0]
    xs.copy(from: [1, 2])
}

@test(traps: "array index out of range")
fn copyFromALongerSourceTraps() {
    var xs: Int[>..] = [0, 0]
    xs.copy(from: [1, 2, 3])
}

@test
fn partitionPutsThoseThatPassAfterThoseThatFail() {
    var xs: Int[>..] = [1, 8, 3, 6, 5, 2, 9]
    let p = xs.partition(by: (x: Int) => x > 4)
    expect(p == 3)
    expect(xs.map { $0 > 4 } == [false, false, false, true, true, true, true])
    expect(xs.sorted() == [1, 2, 3, 5, 6, 8, 9])
}

@test
fn partitionOfAnyArrayPutsThoseThatPassAfterThoseThatFail() {
    forAll { (values: I8[>..], limit: I8) in
        var xs = values
        let p = xs.partition(by: (x: I8) => x > limit)
        expect(p == values.count(where: { $0 <= limit }))
        expect(xs[..<p].allSatisfy { $0 <= limit })
        expect(xs[p...].allSatisfy { $0 > limit })
        expect(xs.sorted() == values.sorted())
    }
}

@test
fn partitionOfAllOrNoneIsAtAnEnd() {
    var xs: Int[>..] = [1, 2, 3]
    assertEqual(xs.partition(by: (x: Int) => x > 9), 3)
    assertEqual(xs.partition(by: (x: Int) => x > 0), 0)
    var empty: Int[>..] = []
    assertEqual(empty.partition(by: (x: Int) => x > 0), 0)
}

@test(arguments: (0..<9).toArray())
fn selectNthPutsTheSortedElementInPlace(_ n: Int) {
    var xs: Int[>..] = [9, 1, 8, 2, 7, 3, 6, 4, 5]
    xs.selectNth(n)
    expect(xs[n] == n + 1)
    expect(xs[..<n].allSatisfy { $0 < n + 1 })
    expect(xs[(n + 1)...].allSatisfy { $0 > n + 1 })
}

@test
fn selectNthOfAnyArrayPutsTheSortedElementInPlace() {
    forAll(Gen.arbitrary(I8.self).array(count: 1...200), Gen.number(in: 0...199)) { (values: I8[>..], place: Int) in
        let n = place % values.count
        var xs = values
        xs.selectNth(n)
        let sorted = values.sorted()
        expect(xs[n] == sorted[n])
        expect(xs[..<n].allSatisfy { $0 <= sorted[n] })
        expect(xs[(n + 1)...].allSatisfy { $0 >= sorted[n] })
        expect(xs.sorted() == sorted)
    }
}

@test
fn selectNthHandlesRunsAndDuplicates() {
    var sorted: Int[>..] = []
    var reversed: Int[>..] = []
    var same: Int[>..] = []
    var i = 0
    while i < 100 {
        sorted.append(i)
        reversed.append(99 - i)
        same.append(4)
        i = i + 1
    }
    sorted.selectNth(30)
    reversed.selectNth(70)
    same.selectNth(50)
    assertEqual(sorted[30], 30)
    assertEqual(reversed[70], 70)
    assertEqual(same[50], 4)
}

@test
fn selectNthByUsesTheOrderGiven() {
    var words: String[>..] = ["ccc", "a", "dddd", "bb"]
    words.selectNth(0, by: (a: String, b: String) => b.count < a.count)
    assertEqual(words[0], "dddd")
    var one: Int[>..] = [5]
    one.selectNth(0)
    assertEqual(one[0], 5)
}

@test(traps: "array index out of range")
fn selectNthOutsideTheArrayTraps() {
    var xs: Int[>..] = [3, 1, 2]
    xs.selectNth(3)
}

@test
fn reorderingChangesAFieldOfAnObjectInPlace() {
    let holder = Holder()
    holder.values.reverse()
    holder.values.swapAt(0, 1)
    expect(holder.values == [2, 3, 1])
}

class Holder {
    var values: Int[>..] = [1, 2, 3]
}

@test
fn reorderingARangeChangesThoseElementsInTheArray() {
    var values: Int[>..] = [1, 2, 3, 4, 5]
    values[1...3].reverse()
    expect(values == [1, 4, 3, 2, 5])
    values[^2...].swapAt(0, 1)
    expect(values == [1, 4, 3, 5, 2])
    values[..<3].rotate(left: 1)
    expect(values == [4, 3, 1, 5, 2])
}

@test(traps: "array slice out of range")
fn reorderingARangePastTheEndTraps() {
    var values: Int[>..] = [1, 2, 3]
    values[1..<5].reverse()
}

// Every length, and slices that are not the whole of their array: what is
// on each side of one stays where it is.
fn reversesAsALoopDoes<T: SIMDScalar>(_ make: (Int) -> T) {
    for start in 0..<3 {
        for n in 0...130 {
            var all: T[>..] = []
            for i in 0..<(start + n + 2) {
                all.append(make(i))
            }
            let original = all
            all[start..<(start + n)].reverse()
            for i in 0..<all.count {
                let inside = i >= start && i < start + n
                if all[i] != original[inside ? start + start + n - 1 - i : i] {
                    fail("\(T.self): element \(i) of \(start)..<\(start + n) reversed is \(all[i])")
                }
            }
            var whole = original
            whole.reverse()
            for i in 0..<whole.count {
                if whole[i] != original[original.count - 1 - i] {
                    fail("\(T.self): element \(i) of \(whole.count) reversed is \(whole[i])")
                }
            }
        }
    }
}

@test
fn everyLengthOfEveryLaneReverses() {
    reversesAsALoopDoes { U8($0) }
    reversesAsALoopDoes { I16($0) }
    reversesAsALoopDoes { I32($0) }
    reversesAsALoopDoes { F32($0) }
    reversesAsALoopDoes { $0 }
    reversesAsALoopDoes { F64($0) }
    reversesAsALoopDoes { F16($0) }
}

@test
fn reversingLeavesACopyAsItWas() {
    var xs: U8[>..] = []
    for i in 0..<100 {
        xs.append(U8(i))
    }
    let held = xs
    xs.reverse()
    assertEqual(held[0], 0)
    assertEqual(xs[0], 99)
}

@test
fn copyingIntoArraysOfEveryLength() {
    for n in 0...130 {
        var words: String[>..] = []
        var numbers: Int[>..] = []
        for i in 0..<n {
            words.append("w\(i)")
            numbers.append(i)
        }
        var otherWords = String[>..](repeating: "none", count: n)
        var otherNumbers = Int[>..](repeating: -1, count: n)
        let heldWords = otherWords
        otherWords.copy(from: words)
        otherNumbers.copy(from: numbers)
        assertEqual(otherWords, words)
        assertEqual(otherNumbers, numbers)
        if n > 0 {
            assertEqual(heldWords[n - 1], "none")
        }
        // Onto itself, moved along by one.
        if n > 1 {
            numbers[1...].copy(from: numbers[..<(n - 1)])
            assertEqual(numbers[0], 0)
            assertEqual(numbers[n - 1], n - 2)
        }
    }
}
