module Negative.IntegerRanges

// An integer literal its type cannot hold is a type error, not something
// lowering finds out (#130).

const Byte: U8 = 300                    //! S3200 '300' does not fit in 'U8'
const Small: I8 = -129                  //! S3200 '-129' does not fit in 'I8'
const Smallest: I8 = -128
const Largest: Int = 9223372036854775807
const Least: Int = -9223372036854775808
const Unsigned: UInt = 18446744073709551615

// A constant's arithmetic is folded, and overflowing it is an error.
const Over: Int = 9223372036854775807 + 1   //! S3201 does not fit in 'Int'
const Under: Int = -9223372036854775807 - 2 //! S3201 does not fit in 'Int'
const Zero: Int = 10 / (5 - 5)              //! S3201 divides by zero
const Fine: Int = 9223372036854775806 + 1

fn locals() {
    let a: I8 = 200                     //! S3200 '200' does not fit in 'I8'
    let b: U8 = -1                      //! S3200 '-1' does not fit in 'U8'
    let c: U16 = 65536                  //! S3200 '65536' does not fit in 'U16'
    let d: U16? = 70000                 //! S3200 '70000' does not fit in 'U16'
    let e: I8 = -128
    let f: U64 = 18446744073709551615
    let g = 9223372036854775808         //! S3200 does not fit in 'Int'
}

// An argument takes its parameter's type, so it is held to that type's
// range, not to Int's: a U64 parameter takes what no Int holds.
fn takeU64(_ x: U64) -> U64 => x
fn takeI8(_ x: I8) -> I8 => x
fn takeInt(_ x: Int) -> Int => x
fn same<T>(_ x: T) -> T => x

fn arguments() {
    let h = takeU64(18446744073709551615)
    let i = takeI8(300)                     //! S3200 '300' does not fit in 'I8'
    let j = takeInt(9223372036854775808)    //! S3200 does not fit in 'Int'
    let k = same(9223372036854775808)       //! S3200 does not fit in 'Int'
    let l = F64.fromBits(0x8000_0000_0000_0000)
    let m = takeU64(-1)                     //! S3200 '-1' does not fit in 'U64'
    let n = takeI8(-128)
    let o = takeI8(-129)                    //! S3200 '-129' does not fit in 'I8'
}

// Past 64 bits, I128 and U128 are held to their ranges too: as arguments,
// negated, and where a type is given (#260).
fn takeI128(_ x: I128) -> I128 => x
fn takeU128(_ x: U128) -> U128 => x

fn wide() {
    let a = takeU128(340282366920938463463374607431768211455)
    let b = takeI128(-170141183460469231731687303715884105728)
    let c = takeI128(170141183460469231731687303715884105728)   //! S3200 does not fit in 'I128'
    let d: I128 = 170141183460469231731687303715884105728      //! S3200 does not fit in 'I128'
    let e: I128 = -170141183460469231731687303715884105728
    let f = takeU128(-1)                                        //! S3200 '-1' does not fit in 'U128'
    let g = takeInt(170141183460469231731687303715884105727)   //! S3200 does not fit in 'Int'
    let h = same(-170141183460469231731687303715884105728)     //! S3200 does not fit in 'Int'
    let i = e == -170141183460469231731687303715884105728
}
