module TempTests

// Temp, TempFile and TempDirectory (Sable.IO).

import IoSupport
import Sable.IO
import Sable.Testing

@test
fn aFileGoesAsItIsLetGo() throws {
    var path = FilePath("")
    do {
        let file = try Temp.file(startingWith: "start-", endingWith: ".end")
        path = file.path
        expect(path.isAbsolute && File.exists(path))
        expect(path.fileName!.hasPrefix("start-") && path.fileName!.hasSuffix(".end"))
        try file.file.write([0x61, 0x62])
        assertEqual(try File.read(path), "ab")
        #if os(windows)
        #else
        assertEqual((try File.metadata(path)).permissions.mode, 0o600)
        #endif
    }
    expect(!File.exists(path))
}

@test
fn aFileIsRemovedKeptOrRenamed(temp: TemporaryFiles) throws {
    let removed = try Temp.file(in: temp.path)
    try removed.remove()
    try removed.remove()
    expect(!File.exists(removed.path) && !removed.file.isOpen)

    var kept = FilePath("")
    do {
        kept = (try Temp.file(in: temp.path)).keep()
    }
    expect(File.exists(kept))

    let target = temp.path.appending("settings")
    try File.write(target, "old")
    do {
        let file = try Temp.file(in: temp.path)
        try file.file.write("new".utf8Bytes())
        try file.persist(to: target)
        expectIoError("InvalidInput", "it was renamed already") {
            try file.persist(to: target)
        }
    }
    assertEqual(try File.read(target), "new")
    assertEqual(try Directory.list(temp.path).count, 2)
}

@test
fn aDirectoryGoesWithAllInIt() throws {
    var path = FilePath("")
    do {
        let directory = try Temp.directory(startingWith: "start-")
        path = directory.path
        expect(Directory.exists(path) && path.fileName!.hasPrefix("start-"))
        #if os(windows)
        #else
        assertEqual((try File.metadata(path)).permissions.mode, 0o700)
        #endif
        try Directory.create(path.appending("a/b"), recursive: true)
        try File.write(path.appending("a/b/c"), "c")
    }
    expect(!Directory.exists(path))
}

@test
fn aDirectoryIsRemovedOrKept(temp: TemporaryFiles) throws {
    let removed = try Temp.directory(in: temp.path)
    try removed.remove()
    try removed.remove()
    expect(!Directory.exists(removed.path))
    var kept = FilePath("")
    do {
        kept = (try Temp.directory(in: temp.path)).keep()
    }
    expect(Directory.exists(kept))
}

@test
fn noTwoHaveOneName(temp: TemporaryFiles) throws {
    var files: TempFile[>..] = []
    var i = 0
    while i < 50 {
        files.append(try Temp.file(in: temp.path))
        i += 1
    }
    assertEqual(try Directory.list(temp.path).count, 50)
    files = []
    assertEqual(try Directory.list(temp.path).count, 0)
    expectIoError("NotFound", "there is nowhere to make it") {
        _ = try Temp.file(in: temp.path.appending("missing"))
    }
    expectIoError("NotFound", "there is nowhere to make it") {
        _ = try Temp.directory(in: temp.path.appending("missing"))
    }
}
