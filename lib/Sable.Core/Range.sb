module Sable.Core

// The ranges: what 'a..<b' and 'a...b' make, and the one-sided '..<b',
// '...b' and 'a...'. The binder knows the operators by sight and builds
// these types from them; everything a range does is declared here. A 'for'
// over a range of integers or characters counts, with no range built when
// the range is written in the loop; a range open at the start has no first
// value, so is not one a loop can go through.

/// The values from 'lowerBound' up to, not including, 'upperBound': what
/// 'a..<b' makes. Empty when the bounds are equal, and when they are the
/// wrong way round.
public struct Range<Bound: Comparable> {
    /// The first value in the range, when it has any.
    public let lowerBound: Bound

    /// The first value past the range.
    public let upperBound: Bound

    /// Whether the range has no values.
    public var isEmpty: Bool => !(lowerBound < upperBound)

    /// Whether the value is in the range.
    public fn contains(_ value: Bound) -> Bool {
        return !(value < lowerBound) && value < upperBound
    }
}

/// The values from 'lowerBound' to 'upperBound', both included: what
/// 'a...b' makes. Empty only when the bounds are the wrong way round.
public struct ClosedRange<Bound: Comparable> {
    /// The first value in the range, when it has any.
    public let lowerBound: Bound

    /// The last value in the range, when it has any.
    public let upperBound: Bound

    /// Whether the range has no values.
    public var isEmpty: Bool => upperBound < lowerBound

    /// Whether the value is in the range.
    public fn contains(_ value: Bound) -> Bool {
        return !(value < lowerBound) && !(upperBound < value)
    }
}

extension Range where Bound == Int {
    /// How many values the range has: none when the bounds are the wrong way round.
    public var count: Int => isEmpty ? 0 : upperBound - lowerBound
}

extension ClosedRange where Bound == Int {
    /// How many values the range has: none when the bounds are the wrong way round.
    public var count: Int => isEmpty ? 0 : upperBound - lowerBound + 1
}

/// The values below 'upperBound': what '..<b' makes.
public struct PartialRangeUpTo<Bound: Comparable> {
    /// The first value past the range.
    public let upperBound: Bound

    /// Whether the value is in the range.
    public fn contains(_ value: Bound) -> Bool {
        return value < upperBound
    }
}

/// The values up to 'upperBound', which is included: what '...b' makes.
public struct PartialRangeThrough<Bound: Comparable> {
    /// The last value in the range.
    public let upperBound: Bound

    /// Whether the value is in the range.
    public fn contains(_ value: Bound) -> Bool {
        return !(upperBound < value)
    }
}

/// The values from 'lowerBound' up, with no end: what 'a...' makes. A 'for'
/// over one goes on until the loop is left, or the next value would overflow.
public struct PartialRangeFrom<Bound: Comparable> {
    /// The first value in the range.
    public let lowerBound: Bound

    /// Whether the value is in the range.
    public fn contains(_ value: Bound) -> Bool {
        return !(value < lowerBound)
    }
}

/// The values from 'start' towards 'end', 'step' apart, 'end' itself left
/// out: 'stride(from: 0, to: 10, by: 3)' gives 0, 3, 6 and 9. A negative step
/// counts down; a step of zero never gets anywhere, so gives nothing.
public fn stride(from start: Int, to end: Int, by step: Int) -> StrideTo {
    return StrideTo { start: start, end: end, step: step }
}

/// The values from 'start' towards 'end', 'step' apart, 'end' itself
/// included when a step lands on it: 'stride(from: 0, through: 9, by: 3)'
/// gives 0, 3, 6 and 9. A step of zero gives nothing.
public fn stride(from start: Int, through end: Int, by step: Int) -> StrideThrough {
    return StrideThrough { start: start, end: end, step: step }
}

/// What 'stride(from:to:by:)' makes.
public struct StrideTo: Sequence {
    public alias Iter = StrideIterator

    public let start: Int
    public let end: Int
    public let step: Int

    public fn makeIterator() -> StrideIterator {
        return StrideIterator { upcoming: start, end: end, step: step, through: false, done: step == 0 }
    }
}

/// What 'stride(from:through:by:)' makes.
public struct StrideThrough: Sequence {
    public alias Iter = StrideIterator

    public let start: Int
    public let end: Int
    public let step: Int

    public fn makeIterator() -> StrideIterator {
        return StrideIterator { upcoming: start, end: end, step: step, through: true, done: step == 0 }
    }
}

/// Gives a stride's values. It stops before a step would pass the end, so
/// a stride up to 'Int.max' does not overflow.
public struct StrideIterator: Iterator {
    public alias Element = Int

    var upcoming: Int
    let end: Int
    let step: Int
    let through: Bool
    var done: Bool

    public mutating fn next() -> Int? {
        if done {
            return none
        }

        let value = upcoming
        let inside = step > 0
            ? (through ? !(end < value) : value < end)
            : (through ? !(value < end) : end < value)
        if !inside {
            done = true
            return none
        }

        // A next value past Int's bounds is past the end too: the check is
        // made without the addition that would overflow.
        let canStep = step > 0 ? value <= 9223372036854775807 - step : value >= -9223372036854775807 - 1 - step
        if canStep {
            upcoming = value + step
        } else {
            done = true
        }
        return value
    }
}
