module Sable.Net.Tls

// Reading and writing the presentation language of RFC 8446 §3: numbers
// big-endian, vectors after their lengths.

/// Bytes read from the front, each read a decode_error if they run out.
struct TlsReader {
    let bytes: U8[>..]
    var at: Int = 0
    let what: String

    init(_ bytes: U8[:], _ what: String) {
        self.bytes = bytes.toArray()
        self.what = what
    }

    var isAtEnd: Bool => at == bytes.count

    mutating fn number(_ count: Int) throws(TlsError) -> Int {
        if bytes.count - at < count {
            throw TlsError.Failed(.decodeError, reason: "\(what) is cut short")
        }
        var value = 0
        for i in 0..<count {
            value = value << 8 | Int(bytes[at + i])
        }
        at += count
        return value
    }

    mutating fn take(_ count: Int) throws(TlsError) -> U8[>..] {
        if count < 0 || bytes.count - at < count {
            throw TlsError.Failed(.decodeError, reason: "\(what) is cut short")
        }
        let taken = bytes[at..<at + count].toArray()
        at += count
        return taken
    }

    /// A vector whose length is so many bytes.
    mutating fn vector(_ lengthBytes: Int) throws(TlsError) -> U8[>..] {
        let count = try number(lengthBytes)
        return try take(count)
    }

    fn finish() throws(TlsError) {
        if !isAtEnd {
            throw TlsError.Failed(.decodeError, reason: "\(what) has bytes after its end")
        }
    }
}

/// The number as so many bytes, big-endian.
fn appendNumber(_ bytes: inout U8[>..], _ value: Int, _ count: Int) {
    var i = count - 1
    while i >= 0 {
        bytes.append(U8(value >> (8 * i) & 0xFF))
        i -= 1
    }
}

/// The bytes after their length in so many bytes.
fn appendVector(_ bytes: inout U8[>..], _ vector: U8[:], _ lengthBytes: Int) {
    appendNumber(&bytes, vector.count, lengthBytes)
    bytes.append(contentsOf: vector)
}

/// A handshake message of the type and body.
fn handshakeMessage(_ type: Int, _ body: U8[:]) -> U8[>..] {
    var message: U8[>..] = [U8(type)]
    appendVector(&message, body, 3)
    return message
}
