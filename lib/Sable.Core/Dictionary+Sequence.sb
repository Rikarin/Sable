module Sable.Core

// A dictionary is a sequence of its entries, each key with its value, in
// no order it promises: what a 'for (key, value) in d' goes through, which
// the compiler counts without an iterator, and what generic code sees.

extension Dictionary: Sequence, FromSequence<(Key, Value)> {
    /// An iterator over the entries.
    public fn makeIterator() -> DictionaryIterator<Key, Value> {
        return DictionaryIterator<Key, Value> { entries: self, position: 0 }
    }

    /// A dictionary of the pairs, each key with its value; a key that comes
    /// again keeps the last value given it.
    public static fn from<S: Sequence>(_ elements: S) -> [Key: Value] where S.Element == (Key, Value) {
        var dictionary: [Key: Value] = [:]
        for (key, value) in elements {
            dictionary[key] = value
        }
        return dictionary
    }

    // The entry at a position in the order the dictionary keeps them.
    @builtin("array_get")
    fn storedEntry(at position: Int) -> (Key, Value)
}

/// Gives a dictionary's entries, each key with its value.
public struct DictionaryIterator<Key, Value>: Iterator {
    let entries: [Key: Value]
    var position: Int

    /// The next entry, or none past the last.
    public mutating fn next() -> (Key, Value)? {
        if position >= entries.count {
            return none
        }
        let entry = entries.storedEntry(at: position)
        position += 1
        return entry
    }
}
