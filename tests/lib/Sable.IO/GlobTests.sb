module GlobTests

// Glob (Sable.IO): what each part of a pattern matches.

import Sable.IO
import Sable.Testing

fn check(_ pattern: String, _ matching: String[>..], _ not: String[>..]) throws {
    let glob = try Glob(pattern)
    expect(glob.pattern == pattern)
    for path in matching {
        expect(glob.matches(path), "'\(pattern)' matches '\(path)'")
    }
    for path in not {
        expect(!glob.matches(path), "'\(pattern)' does not match '\(path)'")
    }
}

let stars: (String, String[>..], String[>..])[>..] = [
    ("*.sb", ["a.sb", ".sb", "a.b.sb"], ["a.sc", "a.sb.", "d/a.sb"]),
    ("a*b*c", ["abc", "axxbyyc", "abbc", "abcbc"], ["ab", "abd", "xabc", "ac"]),
    ("*", ["a", ".hidden"], ["a/b"]),
    ("**.sb", ["a.sb"], ["d/a.sb"]),
    ("a*", ["a", "ab"], ["b"]),
    // No more than the name's length times the pattern's.
    ("*a*a*a*a*a*a*a*a*a*a*b", [], ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]),
]

@test(arguments: stars)
fn aStarIsAnyRunInAName(_ pattern: String, _ matching: String[>..], _ not: String[>..]) throws {
    try check(pattern, matching, not)
}

let questionMarks: (String, String[>..], String[>..])[>..] = [
    ("?.sb", ["a.sb", "é.sb"], [".sb", "ab.sb"]),
    ("a??", ["abc"], ["ab", "abcd"]),
]

@test(arguments: questionMarks)
fn aQuestionMarkIsOneCharacter(_ pattern: String, _ matching: String[>..], _ not: String[>..]) throws {
    try check(pattern, matching, not)
}

let classes: (String, String[>..], String[>..])[>..] = [
    ("[abc]", ["a", "c"], ["d", "ab", ""]),
    ("[a-cx-z]1", ["a1", "b1", "z1"], ["d1", "a2"]),
    ("[!a-c]", ["d", "-"], ["a"]),
    ("[^a]", ["b"], ["a"]),
    ("[]a]", ["]", "a"], ["b"]),
    ("[!]a]", ["b"], ["]", "a"]),
    ("[a-]", ["a", "-"], ["b"]),
    ("[a\\]b]", ["]", "a", "b"], ["\\"]),
    ("[\\--1]", ["-", "0", "1"], ["2"]),
    ("[{,}]", ["{", ","], ["a"]),
    ("[z-a]", [], ["a", "m", "z"]),
]

@test(arguments: classes)
fn aClassIsOneOfItsCharacters(_ pattern: String, _ matching: String[>..], _ not: String[>..]) throws {
    try check(pattern, matching, not)
}

let braces: (String, String[>..], String[>..])[>..] = [
    ("*.{md,txt}", ["a.md", "a.txt"], ["a.mdx", "a."]),
    ("{a,b{c,d}}e", ["ae", "bce", "bde"], ["be", "abe"]),
    ("{src,tests/lib}/*", ["src/a", "tests/lib/a"], ["tests/a"]),
    ("a{,b}", ["a", "ab"], ["b"]),
    ("a}", ["a}"], ["a"]),
    ("{a}", ["a"], ["b"]),
]

@test(arguments: braces)
fn bracesAreEither(_ pattern: String, _ matching: String[>..], _ not: String[>..]) throws {
    try check(pattern, matching, not)
}

let twoStars: (String, String[>..], String[>..])[>..] = [
    ("**/*.sb", ["a.sb", "d/a.sb", "d/e/a.sb"], ["a.txt", "a.sb/x"]),
    ("a/**/b", ["a/b", "a/x/b", "a/x/y/b"], ["a/xb", "b", "a/b/c"]),
    ("a/**", ["a/b", "a/b/c"], ["a", "b"]),
    ("**", ["a", "a/b"], [""]),
    ("**/a/**/b/**", ["a/b/c", "x/a/y/b/z/w"], ["a/b", "b/a/c"]),
    ("**/**/a", ["a", "x/y/a"], ["b"]),
]

@test(arguments: twoStars)
fn twoStarsAreAnyDirectories(_ pattern: String, _ matching: String[>..], _ not: String[>..]) throws {
    try check(pattern, matching, not)
}

let backslashes: (String, String[>..], String[>..])[>..] = [
    ("\\*", ["*"], ["a"]),
    ("a\\{b\\}", ["a{b}"], ["ab"]),
    ("\\[a]", ["[a]"], ["a"]),
]

@test(arguments: backslashes)
fn aBackslashMakesACharacterItself(_ pattern: String, _ matching: String[>..], _ not: String[>..]) throws {
    try check(pattern, matching, not)
}

#if !os(windows)
// Where a backslash separates, no name has one.
@test
fn aBackslashMakesABackslashItself() throws {
    try check("\\?\\\\", ["?\\"], ["a\\"])
}
#endif

let fromTheRoot: (String, String[>..], String[>..])[>..] = [
    ("/usr/*", ["/usr/lib"], ["usr/lib", "/usr", "/usr/lib/x"]),
    ("usr/*", ["usr/lib", "./usr/lib", "usr//lib"], ["/usr/lib"]),
    ("./a", ["a"], ["b"]),
    ("../a", ["../a"], ["a"]),
]

@test(arguments: fromTheRoot)
fn aPatternFromTheRootMatchesPathsFromIt(_ pattern: String, _ matching: String[>..], _ not: String[>..]) throws {
    try check(pattern, matching, not)
}

@test
fn caseCountsUnlessItIsSaidNotTo() throws {
    let glob = try Glob("**/*.TXT", caseSensitive: false)
    expect(glob.matches(FilePath("a/b.txt")) && glob.matches("A.Txt"))
    expect(!(try Glob("A")).matches("a"))
}

// The last would be two to the twelfth ways through it.
@test(arguments: ["[a", "a[", "[!]", "{a", "{a,{b}", "[]", "{a,[}", "{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}"])
fn whatIsNoPatternIsAnError(_ pattern: String) {
    expectThrows { _ = try Glob(pattern) }
}
