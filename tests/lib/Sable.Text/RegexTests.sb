}

let optionCases: (String, String, String, RegexOptions)[>..] = [
    ("abc", "aBc", "0-3", .IgnoreCase),
    ("^b$", "a\nb\nc", "2-3", .Multiline),
    ("a.c", "a\nc", "0-3", .DotAll),
    ("a b # c", "ab", "0-2", .Extended),
    ("(?-m)^b", "a\nb", "none", .Multiline),
]

@test(arguments: optionCases)
fn optionsAreAsFlagsOfTheWholePattern(_ pattern: String, _ text: String, _ expected: String, _ options: RegexOptions) throws(RegexError) {
    try checkSearch(pattern, text, expected, options: options)
}

@test(arguments: [
    (#"(?<year>\d+)-(?P<month>\d+)-(?'day'\d+)"#, "2024-03-15", "0-10 0-4 5-7 8-10"),
    ("(a)(?<b>b)(c)", "abc", "0-3 0-1 1-2 2-3"),
])
fn namedGroupsAreNumberedWithTheOthers(_ pattern: String, _ text: String, _ expected: String) throws(RegexError) {
    try checkSearch(pattern, text, expected)
}

@test
fn namedGroupsAreFoundByTheirNames() {
    let regex = try! Regex(#"(?<year>\d+)-(?P<month>\d+)"#)
    assertEqual(regex.groupCount, 2)
    assertEqual(regex.groupIndex(named: "month"), 2)
    assertEqual(regex.groupIndex(named: "day"), none)
    assertEqual(regex.groupIndex(named: ""), none)
    expect(regex.groupNames == ["", "year", "month"])
    let found = regex.captures(in: "on 1999-12")!
    assertEqual(found["year"]!.toString(), "1999")
    assertEqual(found["month"]!.toString(), "12")
    expect(found["day"] == none)
    expect(found[3] == none && found[-1] == none)
    assertEqual(found.range(named: "year")!.lowerBound.utf8Offset, 3)
    expect(found.range(named: "") == none && found.range(named: "nope") == none)
    assertEqual(found.text.toString(), "1999-12")
    assertEqual(found.range.upperBound.utf8Offset, 10)
}

@test(arguments: [
    (#"(a)\1"#, "aa", "0-2 0-1"),
    (#"(a)\1"#, "ab", "none"),
    (#"(?i)(a)\1"#, "aA", "0-2 0-1"),
