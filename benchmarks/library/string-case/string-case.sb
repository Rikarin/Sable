module StringCaseBench

// Strings in upper and lower case: ASCII, then text with Greek and Cyrillic.

@main
fn main() {
    var ascii: String[>..] = []
    var mixed: String[>..] = []
    for i in 0..<20000 {
        ascii.append("The Quick Brown Fox \(i) Jumps Over The Lazy Dog")
        mixed.append("Привет Мир \(i) Καλημερα Κοσμε and plain words too")
    }
    var total = 0
    for _ in 0..<5 {
        for text in ascii {
            if text.uppercased() != text { total += 1 }
            total += text.lowercased().count
        }
        for text in mixed {
            if text.uppercased() != text { total += 1 }
            total += text.lowercased().count
        }
    }
    print(total)
}
