module SleepCancelBench

import Sable.Concurrency
import Sable.Time

// Sleeps cut short: fifty thousand tasks, each to sleep an hour, all
// cancelled one by one and awaited.

@main
fn main() async {
    var tasks: Task<Int>[>..] = []
    for _ in 0..<50000 {
        tasks.append(
            Task.spawn {
                do {
                    try await Task.sleep(for: Duration.hours(1))
                    return 0
                } catch {
                    return 1
                }
            })
    }
    for task in tasks {
        task.cancel()
    }
    var total = 0
    for task in tasks {
        total += await task.value
    }
    print(total)
}
