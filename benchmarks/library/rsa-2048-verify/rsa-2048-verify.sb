module Rsa2048VerifyBench

// RSA of 2048 bits against .NET's RSA.VerifyData: a signature checked 3000
// times, every fourth of another message.

import Sable.Crypto
import Sable.Testing

// A key of this benchmark's alone.
let pem: String = """
-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC65MtLQOBeCx5W
