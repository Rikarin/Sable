module AsyncTimedSequenceTests

// debounce(for:) and throttle(for:latest:) (AsyncDebounceSequence.sb and
// AsyncThrottleSequence.sb in Sable.Concurrency), tested with '@test': run
// with
//     tools/stdlib-coverage.sh Sable.Concurrency
//
// The intervals are either long — nothing times out while the test runs —
// or short against long pauses, so that a loaded machine does not change
// what the test sees.

import ConcurrencySupport
import Sable.Concurrency
import Sable.Testing
import Sable.Time

@test
fn debounceGivesTheLastOfABurst() async {
    let input = Channel<Int>()
    for i in 1...5 {
        await input.send(i)
    }
    await input.close()
    expect(await input.debounce(for: Duration.seconds(60)).collect() == [5])
}

@test
fn debounceGivesAnElementOnceTheSequenceIsQuiet() async {
    let input = Channel<Int>()
    var iterator = input.debounce(for: Duration.milliseconds(200)).makeAsyncIterator()
    await input.send(1)
    await input.send(2)
    // Nothing more comes: the interval passes, and 2 is given.
    expect(await iterator.next() == 2)
    await input.send(3)
    await input.close()
    expect(await iterator.next() == 3)
    expect(await iterator.next() == none)
}

@test
fn debounceOfAnEmptySequenceIsEmpty() async {
    let input = Channel<Int>()
    await input.close()
    expect(await input.debounce(for: Duration.milliseconds(1)).collect() == [])
}

@test
fn debouncePassesTheErrorOn() async {
    let input = ThrowingChannel<Int, Broken>()
    await input.send(1)
    await input.close(error: .Down)
    var got: Int[>..] = []
    var iterator = input.debounce(for: Duration.seconds(60)).makeAsyncIterator()
    await expectThrows(Broken.Down) {
        while let value = try await iterator.next() {
            got.append(value)
        }
    }
    expect(got == [1])
}

@test
fn throttleGivesTheFirstAtOnceAndTheNewestAfter() async {
    let input = Channel<Int>()
    for i in 1...5 {
        await input.send(i)
    }
    await input.close()
    expect(await input.throttle(for: Duration.seconds(60)).collect() == [1, 5])
}

@test
fn throttleCanKeepTheFirstOfAnInterval() async {
    let input = Channel<Int>()
    for i in 1...5 {
        await input.send(i)
    }
    await input.close()
    expect(await input.throttle(for: Duration.seconds(60), latest: false).collect() == [1, 2])
}

@test(tags: ["slow"], timeout: .seconds(60))
fn throttleGivesTheWaitingElementAtTheIntervalsEnd() async {
    let input = Channel<Int>()
    var iterator = input.throttle(for: Duration.milliseconds(200)).makeAsyncIterator()
    await input.send(1)
    expect(await iterator.next() == 1)
    await input.send(2)
    await input.send(3)
    // The timer to the interval's end lets the newest through.
    expect(await iterator.next() == 3)
    try? await Task.sleep(for: Duration.milliseconds(300))
    // The interval has passed: the next goes through at once.
    await input.send(4)
    expect(await iterator.next() == 4)
    await input.close()
    expect(await iterator.next() == none)
}

@test
fn throttlePassesTheErrorOn() async {
    let input = ThrowingChannel<Int, Broken>()
    await input.close(error: .Down)
    var iterator = input.throttle(for: Duration.seconds(1)).makeAsyncIterator()
    await expectThrows(Broken.Down) { _ = try await iterator.next() }
}

@test
fn aCancelledConsumerStopsTheTimedSequence() async {
    let input = Channel<Int>()
    let consumer = Task.spawn {
        var seen = 0
        for await _ in input.debounce(for: Duration.seconds(60)) {
            seen += 1
        }
        return seen
    }
    await input.send(1)
    await settle()
    consumer.cancel()
    assertEqual(await consumer.value, 0)
}
