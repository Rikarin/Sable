module Utf8Tests

// Utf8 and Utf8Error (Sable.Text), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Text

import Sable.Testing
import Sable.Text

fn bytes(_ values: Int[>..]) -> U8[>..] {
    var result: U8[>..] = []
    for value in values {
        result.append(U8(value))
    }
    return result
}

fn errorOf(_ values: Int[>..]) -> String {
    if let error = Utf8.error(in: bytes(values)) {
        return error.debugDescription()
    }
    return "valid"
}

@test
fn wellFormedTextIsValid() {
    assert(Utf8.isValid(bytes([])), "nothing")
    assert(Utf8.isValid(bytes([0x61, 0x7F])), "ASCII")
    assert(Utf8.isValid(bytes([0xC2, 0x80, 0xDF, 0xBF])), "two-byte sequences at both ends of their range")
    assert(Utf8.isValid(bytes([0xE0, 0xA0, 0x80, 0xED, 0x9F, 0xBF, 0xEE, 0x80, 0x80, 0xEF, 0xBF, 0xBF])), "three-byte sequences")
    assert(Utf8.isValid(bytes([0xF0, 0x90, 0x80, 0x80, 0xF4, 0x8F, 0xBF, 0xBF])), "four-byte sequences, up to U+10FFFF")
    assert(Utf8.validate(bytes([0x68, 0x69])) == none, "no error")
}

@test
fn eachKindOfIllFormedSequenceIsFound() {
    assertEqual(errorOf([0x80]), "invalid UTF-8 at byte 0 (1 byte)")
    assertEqual(errorOf([0x61, 0xC0, 0xAF]), "invalid UTF-8 at byte 1 (1 byte)")
    assertEqual(errorOf([0xC1, 0xBF]), "invalid UTF-8 at byte 0 (1 byte)")
    assertEqual(errorOf([0xE0, 0x80, 0x80]), "invalid UTF-8 at byte 0 (1 byte)")
    assertEqual(errorOf([0xED, 0xA0, 0x80]), "invalid UTF-8 at byte 0 (1 byte)")
    assertEqual(errorOf([0xF0, 0x80, 0x80, 0x80]), "invalid UTF-8 at byte 0 (1 byte)")
    assertEqual(errorOf([0xF4, 0x90, 0x80, 0x80]), "invalid UTF-8 at byte 0 (1 byte)")
    assertEqual(errorOf([0xF5, 0x80]), "invalid UTF-8 at byte 0 (1 byte)")
    assertEqual(errorOf([0xFF]), "invalid UTF-8 at byte 0 (1 byte)")
    assertEqual(errorOf([0x61, 0xE2, 0x82, 0x28]), "invalid UTF-8 at byte 1 (2 bytes)")
    assertEqual(errorOf([0xF0, 0x9F, 0x98, 0x41]), "invalid UTF-8 at byte 0 (3 bytes)")
    assertEqual(errorOf([0xC3, 0x28]), "invalid UTF-8 at byte 0 (1 byte)")
}

@test
fn aSequenceCutShortIsIncomplete() {
    assertEqual(errorOf([0x61, 0xC3]), "incomplete UTF-8 at byte 1")
    assertEqual(errorOf([0xE2, 0x82]), "incomplete UTF-8 at byte 0")
    assertEqual(errorOf([0xF0, 0x9F, 0x98]), "incomplete UTF-8 at byte 0")
    let error = Utf8.error(in: bytes([0x61, 0xF0, 0x9F]))!
    assertEqual(error.validUpTo, 1)
    assert(error.errorLength == none, "no length for an incomplete sequence")
}

@test
fn validatingAfterLongAsciiRuns() {
    // Past the sixteen-byte blocks the runtime checks at once, and at each
    // place in one.
    var position = 0
    while position < 40 {
        var values: Int[>..] = []
        var i = 0
        while i < 40 {
            values.append(i == position ? 0xFF : 0x41)
            i = i + 1
        }
        assertEqual(Utf8.validate(bytes(values)) ?? -1, position)
        position = position + 1
    }
}

@test
fn sequenceLengthsByLeadByte() {
    assertEqual(Utf8.sequenceLength(lead: 0x41) ?? 0, 1)
    assertEqual(Utf8.sequenceLength(lead: 0xC3) ?? 0, 2)
    assertEqual(Utf8.sequenceLength(lead: 0xE2) ?? 0, 3)
    assertEqual(Utf8.sequenceLength(lead: 0xF0) ?? 0, 4)
    assert(Utf8.sequenceLength(lead: 0x80) == none, "a continuation byte leads nothing")
    assert(Utf8.sequenceLength(lead: 0xC0) == none, "0xC0 only leads overlong forms")
    assert(Utf8.sequenceLength(lead: 0xF5) == none, "0xF5 leads past U+10FFFF")
}

@test
fn errorsCompare() {
    assert(Utf8Error(validUpTo: 1, errorLength: 2) == Utf8Error(validUpTo: 1, errorLength: 2), "equal")
    assert(Utf8Error(validUpTo: 1, errorLength: 2) != Utf8Error(validUpTo: 1, errorLength: none), "lengths differ")
    assert(Utf8Error(validUpTo: 1, errorLength: 2) != Utf8Error(validUpTo: 2, errorLength: 2), "places differ")
}

/// A random walk of bytes, weighted to the ranges UTF-8's rules turn on.
struct ByteSource {
    var state: U64

    mutating fn next() -> Int {
        state = state ^ (state << 13)
        state = state ^ (state >> 7)
        state = state ^ (state << 17)
        let pick = Int(state % 16)
        let low = Int((state >> 8) % 64)
        return pick < 6 ? low + 0x20 : pick < 10 ? 0x80 + low : pick < 12 ? 0xC0 + low % 32 : pick < 14 ? 0xE0 + low % 16 : 0xF0 + low % 16
    }
}

@test
fn fuzzingAgreesWithDecodingScalarByScalar() {
    // Each random string of bytes: validation, strict and lossy decoding,
    // and the decoder fed in random chunks must tell the same story.
    var source = ByteSource { state: 0x9E3779B97F4A7C15 }
    var round = 0
    while round < 400 {
        let length = source.next() % 24
        var values: U8[>..] = []
        var i = 0
        while i < length {
            values.append(U8(source.next()))
            i = i + 1
        }
        let lossy = String.fromUtf8Lossy(values)
        if let at = Utf8.validate(values) {
            let error = Utf8.error(in: values)!
            assertEqual(error.validUpTo, at)
            assert(lossy.contains('\u{FFFD}'), "an error is replaced")
            let valid = try? String.fromUtf8(values[..<at])
            assert(valid != none, "the bytes before the error are valid")
        } else {
            assertEqual((try? String.fromUtf8(values)) ?? "?", lossy)
            assertEqual(lossy.utf8Count, values.count)
        }
        assert(Utf8.isValid(lossy.utf8Bytes()), "lossy decoding gives valid UTF-8")
        var decoder = Utf8Decoder()
        var streamed = ""
        var start = 0
        while start < values.count {
            let end = start + 1 + source.next() % 5
            let stop = end < values.count ? end : values.count
            streamed = streamed + decoder.decode(values[start..<stop])
            start = stop
        }
        streamed = streamed + decoder.finish()
        assertEqual(streamed, lossy)
        round = round + 1
    }
}
