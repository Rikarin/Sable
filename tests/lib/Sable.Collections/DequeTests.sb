module DequeTests

// Deque (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn aDequeIsGoneThroughFrontToBack() {
    let deque = Deque<Int>()
    var i = 0
    while i < 6 {
        deque.append(i)
        i = i + 1
    }
    let _ = deque.removeFirst()
    let _ = deque.removeFirst()
    deque.append(6)
    deque.append(7)
    deque.prepend(1)
    var seen: String[>..] = []
    for value in deque {
        seen.append("\(value)")
    }
    assertEqualText(seen.joined(separator: ","), "1,2,3,4,5,6,7")
    assertEqual(deque.reduce(0) { $0 + $1 }, 28)
    assertEqual(Deque<Int>().toArray().count, 0)
}

@test
fn aDequesIteratorKeepsWhatItWasMadeFrom() {
    let deque = Deque<Int>()
    deque.append(1)
    deque.append(2)
    var iterator = deque.makeIterator()
    deque.append(3)
    assertEqual(iterator.next() ?? -1, 1)
    assertEqual(iterator.next() ?? -1, 2)
    assert(iterator.next() == none, "the third came after")
}

@test
fn dequeGrowsAtBothEnds() {
    let deque = Deque<Int>()
    var i = 0
    while i < 20 {
        deque.append(i)
        deque.prepend(0 - i)
        i = i + 1
    }
    assertEqual(deque.count, 40)
    assertEqual(deque.first ?? 0, -19)
    assertEqual(deque.last ?? 0, 19)
    assertEqual(deque.removeFirst() ?? 0, -19)
    assertEqual(deque[0], -18)
}

@test
fn anEmptyDequeGivesNone() {
    let deque = Deque<String>()
    assert(deque.isEmpty)
    assertEqual(deque.count, 0)
    assert(deque.first == none)
    assert(deque.last == none)
    assert(deque.removeFirst() == none)
    assert(deque.removeLast() == none)
    assertEqual(deque.toArray().count, 0)
}

@test
fn aDequeOfValuesKeepsTheirOrder() {
    let deque = Deque<String>(["a", "b", "c"])
    assertEqual(deque.count, 3)
    assert(!deque.isEmpty)
    assert(deque.toArray() == ["a", "b", "c"])
    assertEqual(deque.removeLast() ?? "", "c")
    assertEqual(deque.removeFirst() ?? "", "a")
    assert(deque.toArray() == ["b"])
}

@test
fn removingFromBothEndsWrapsRoundTheSlots() {
    let deque = Deque<Int>()
    var i = 0
    while i < 6 {
        deque.append(i)
        i = i + 1
    }
    assertEqual(deque.removeFirst() ?? -1, 0)
    assertEqual(deque.removeFirst() ?? -1, 1)
    deque.append(6)
    deque.append(7)
    deque.append(8)
    deque.prepend(1)
    assert(deque.toArray() == [1, 2, 3, 4, 5, 6, 7, 8])
    assertEqual(deque.removeLast() ?? -1, 8)
    assertEqual(deque.last ?? -1, 7)
    assertEqual(deque[6], 7)
}

@test
fn theSubscriptReplacesAnElementByPosition() {
    let deque = Deque<Int>([1, 2, 3])
    deque.prepend(0)
    deque[2] = 20
    assert(deque.toArray() == [0, 1, 20, 3])
}

@test(traps: "array index out of range")
fn readingPastTheEndTraps() {
    let deque = Deque<Int>([1, 2])
    let _ = deque[2]
}

@test(traps: "array index out of range")
fn writingAtANegativeIndexTraps() {
    let deque = Deque<Int>([1, 2])
    deque[-1] = 0
}

@test
fn removeAllEmptiesTheDeque() {
    let deque = Deque<Int>([1, 2, 3])
    deque.removeAll()
    assert(deque.isEmpty)
    deque.prepend(4)
    assert(deque.toArray() == [4])
}

fn reversedElements<C: BidirectionalCollection>(_ items: C) -> C.Element[>..] {
    var result: C.Element[>..] = []
    var position = items.endIndex
    while items.startIndex < position {
        position = items.index(before: position)
        result.append(items[position])
    }
    return result
}

@test
fn aDequeIsARandomAccessCollection() {
    let deque = Deque<Int>([2, 3])
    deque.prepend(1)
    assert(reversedElements(deque) == [3, 2, 1])
    assertEqual(deque.distance(from: deque.startIndex, to: deque.endIndex), 3)
    assertEqual(deque[deque.index(deque.startIndex, offsetBy: 2)], 3)
    assertEqual(deque.firstIndex(of: 2) ?? -1, 1)
    assert(deque.reversed().toArray() == [3, 2, 1])
}

@test
fn aDequeIsChangedInPlaceAsAMutableCollection() {
    var deque = Deque<Int>([1, 2, 3])
    deque.swapAt(0, 2)
    assert(deque.toArray() == [3, 2, 1])
}

@test
fn aDequeIsReadFromTheEnd() {
    let deque = Deque<Int>([2, 3])
    deque.prepend(1)
    assertEqual(deque[^1], 3)
    assertEqual(deque[^3], 1)
}

@test
fn aDequeIsSlicedRoundTheEndOfItsSlots() {
    let deque = Deque<Int>([1, 2, 3])
    deque.prepend(0)
    assert(deque[1..<3] == [1, 2])
    assert(deque[^2...] == [2, 3])
    assert(deque[...^4] == [0])
    assert(deque[2..<2] == [])
}

@test
fn aDequeIsWrittenFromTheEndRoundTheEndOfItsSlots() {
    let deque = Deque<Int>([2, 3])
    deque.prepend(1)
    deque[^1] = 9
    deque[^3] += 10
    assert(deque.toArray() == [11, 2, 9])
}

@test(traps: "array slice out of range")
fn aDequeSlicedPastItsEndTraps() {
    let deque = Deque<Int>([1, 2, 3])
    let _ = deque[1..<blackBox(5)]
}

@test
fn aDequeIsMadeFromAnySequence() {
    let deque = Deque(1...3)
    assertEqual(deque.count, 3)
    assertEqual(deque[2], 3)
    let collected: Deque<String> = ["a", "b"].collect()
    assertEqual(collected[0], "a")
}

@test
fn aDequeInsertsRemovesAndRotates() {
    let deque = Deque<Int>([1, 3])
    deque.insert(2, at: 1)
    deque.insert(0, at: 0)
    deque.insert(4, at: 4)
    assert(deque.toArray() == [0, 1, 2, 3, 4])
    assertEqual(deque.remove(at: 1), 1)
    assertEqual(deque.remove(at: 3), 4)
    assert(deque.toArray() == [0, 2, 3])
    deque.rotate(by: 1)
    assert(deque.toArray() == [2, 3, 0])
    deque.rotate(by: -1)
    assert(deque.toArray() == [0, 2, 3])
    deque.rotate(by: 7)
    assert(deque.toArray() == [2, 3, 0])
}

@test
fn aDequeAgreesWithAnArrayUnderRandomChanges() {
    let deque = Deque<Int>()
    var model = List<Int>()
    var seed = 12345
    var step = 0
    while step < 2000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let choice = seed % 6
        let at = model.isEmpty ? 0 : seed / 7 % (model.count + 1)
        if choice == 0 {
            deque.append(step)
            model.append(step)
        } else if choice == 1 {
            deque.prepend(step)
            model.insert(step, at: 0)
        } else if choice == 2 {
            deque.insert(step, at: at)
            model.insert(step, at: at)
        } else if choice == 3 && !model.isEmpty {
            let position = at % model.count
            assertEqual(deque.remove(at: position), model.remove(at: position))
        } else if choice == 4 && !model.isEmpty {
            assertEqual(deque.removeFirst(), model.remove(at: 0))
        } else {
            deque.rotate(by: seed % 5 - 2)
            if !model.isEmpty {
                var left = (seed % 5 - 2) % model.count
                if left < 0 {
                    left += model.count
                }
                var i = 0
                while i < left {
                    model.append(model.removeFirst())
                    i += 1
                }
            }
        }
        step += 1
    }
    let expected = model.toArray()
    assert(deque.toArray() == expected)
    var (front, back) = deque.asSlices()
    front.append(contentsOf: back)
    assert(front == expected)
    deque.makeContiguous()
    let (whole, rest) = deque.asSlices()
    assert(whole == expected && rest.isEmpty)
    deque.reserveCapacity(5000)
    assert(deque.capacity >= 5000)
    assert(deque.toArray() == expected)
}
