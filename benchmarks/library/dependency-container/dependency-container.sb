module DependencyContainerBench

import Sable.DependencyInjection

// A graph of fifty services resolved in a scope of its own, as a request's
// is: twelve transient ones over thirteen scoped ones over twenty-five
// singletons, each made from the two below it: by a container whose code is
// written as it is compiled. What it is beside is the .NET container.

@injectable(.Transient)
final class N0 {
    let n1: N1
    let n2: N2
    init(n1: N1, n2: N2) {
        self.n1 = n1
        self.n2 = n2
    }
    fn total() -> Int { return 0 + n1.total() + n2.total() }
}

@injectable(.Transient)
final class N1 {
    let n3: N3
    let n4: N4
    init(n3: N3, n4: N4) {
        self.n3 = n3
        self.n4 = n4
    }
    fn total() -> Int { return 1 + n3.total() + n4.total() }
}

