module Sable.Time

// Durations, clocks and their instants, civil dates and times, offsets and
// time zones (docs/04 §4.3), written in Sable over the runtime's clocks and
// the system's time zone database. Calendar arithmetic is proleptic
// Gregorian.

/// A span of time, to the nanosecond; negative when it runs backwards. A
/// whole number of nanoseconds in an Int, so 292 years either way.
///
/// The operators trap where a result does not fit, as an integer's do;
/// `checkedAdd` and the like give none there, and `saturatingAdd` and the
/// like the nearest there is. Amounts by the calendar — years, months, and
/// days that a change of the clocks makes longer or shorter — are a
/// `Period`.
///
/// ```sable
/// let timeout = Duration.seconds(90) + .milliseconds(250)
/// assert(timeout.toString() == "1m 30.25s")
/// assert(timeout / 2 < Duration.minutes(1) && timeout * 1.5 > Duration.minutes(2))
/// assert(timeout / Duration.milliseconds(250) == 361.0)
/// ```
public struct Duration: Comparable, Hashable {
    /// The whole of it, in nanoseconds.
    public var totalNanoseconds: Int

    /// No time at all.
    public static var zero: Duration => Duration { totalNanoseconds: 0 }

    /// The longest there is: 292 years and some.
    public static var max: Duration => Duration { totalNanoseconds: Int.max }

    /// The longest backwards: a nanosecond longer than `max` is forwards.
    public static var min: Duration => Duration { totalNanoseconds: Int.min }

    // ---- So many of a unit ---------------------------------------------

    /// So many nanoseconds.
    public static fn nanoseconds(_ count: Int) -> Duration {
        return Duration { totalNanoseconds: count }
    }

    /// So many microseconds. Traps where they do not fit, as the others do.
    public static fn microseconds(_ count: Int) -> Duration {
        return Duration { totalNanoseconds: count * 1000 }
    }

    /// So many milliseconds.
    public static fn milliseconds(_ count: Int) -> Duration {
        return Duration { totalNanoseconds: count * 1000000 }
    }

    /// So many seconds.
    public static fn seconds(_ count: Int) -> Duration {
        return Duration { totalNanoseconds: count * 1000000000 }
    }

    /// So many minutes.
    public static fn minutes(_ count: Int) -> Duration {
        return Duration { totalNanoseconds: count * 60000000000 }
    }

    /// So many hours.
    public static fn hours(_ count: Int) -> Duration {
        return Duration { totalNanoseconds: count * 3600000000000 }
    }

    /// So many days of exactly 24 hours; a day of the calendar is
    /// `Period.days(1)`.
    public static fn days(_ count: Int) -> Duration {
        return Duration { totalNanoseconds: count * 86400000000000 }
    }

    // ---- Parts of a unit -----------------------------------------------

    /// So many microseconds and parts of one, to the nearest nanosecond —
    /// the even one of two as near. Traps where it does not fit, or for
    /// NaN, as the others do; `checked(_:of:)` gives none there.
    public static fn microseconds(_ count: F64) -> Duration {
        return Duration.microseconds(1) * count
    }

    /// So many milliseconds and parts of one, to the nearest nanosecond.
    public static fn milliseconds(_ count: F64) -> Duration {
        return Duration.milliseconds(1) * count
    }

    /// So many seconds and parts of one, to the nearest nanosecond.
    ///
    /// ```sable
    /// assert(Duration.seconds(0.25) == Duration.milliseconds(250))
    /// assert(Duration.seconds(0.0000000004) == Duration.zero)
    /// ```
    public static fn seconds(_ count: F64) -> Duration {
        return Duration.seconds(1) * count
    }

    /// So many minutes and parts of one, to the nearest nanosecond.
    public static fn minutes(_ count: F64) -> Duration {
        return Duration.minutes(1) * count
    }

    /// So many hours and parts of one, to the nearest nanosecond.
    public static fn hours(_ count: F64) -> Duration {
        return Duration.hours(1) * count
    }

    /// So many of the unit, to the nearest nanosecond; none where it does
    /// not fit, or for NaN.
    ///
    /// ```sable
    /// assert(Duration.checked(1.5, of: .seconds(1)) == Duration.milliseconds(1500))
    /// assert(Duration.checked(1.0e300, of: .seconds(1)) == none)
    /// ```
    public static fn checked(_ count: F64, of unit: Duration) -> Duration? {
        return unit.checkedMul(count)
    }

    // ---- In a unit -----------------------------------------------------

    /// Whole microseconds, rounded towards zero, as the others are.
    public var totalMicroseconds: Int => totalNanoseconds / 1000

    /// Whole milliseconds.
    public var totalMilliseconds: Int => totalNanoseconds / 1000000

    /// Whole seconds.
    public var totalSeconds: Int => totalNanoseconds / 1000000000

    /// Whole minutes.
    public var totalMinutes: Int => totalNanoseconds / 60000000000

    /// Whole hours.
    public var totalHours: Int => totalNanoseconds / 3600000000000

    /// Whole days of 24 hours.
    public var totalDays: Int => totalNanoseconds / 86400000000000

    /// Microseconds, with the fraction.
    public var inMicroseconds: F64 => F64(totalNanoseconds) / 1000.0

    /// Milliseconds, with the fraction.
    public var inMilliseconds: F64 => F64(totalNanoseconds) / 1000000.0

    /// Seconds, with the fraction.
    public var inSeconds: F64 => F64(totalNanoseconds) / 1000000000.0

    /// Minutes, with the fraction.
    public var inMinutes: F64 => F64(totalNanoseconds) / 60000000000.0

    /// Hours, with the fraction.
    public var inHours: F64 => F64(totalNanoseconds) / 3600000000000.0

    /// The hours, the minutes and seconds under sixty and the nanoseconds
    /// under a second that together make it, each of its sign.
    ///
    /// ```sable
    /// let parts = Duration.milliseconds(-3723500).components
    /// assert(parts.hours == -1 && parts.minutes == -2 && parts.seconds == -3)
    /// assert(parts.nanoseconds == -500000000)
    /// ```
    public var components: (hours: Int, minutes: Int, seconds: Int, nanoseconds: Int) {
        get {
            return (
                hours: totalNanoseconds / 3600000000000,
                minutes: totalNanoseconds / 60000000000 % 60,
                seconds: totalNanoseconds / 1000000000 % 60,
                nanoseconds: totalNanoseconds % 1000000000
            )
        }
    }

    /// Whether it is no time at all.
    public var isZero: Bool => totalNanoseconds == 0

    /// Whether it runs backwards.
    public var isNegative: Bool => totalNanoseconds < 0

    // ---- Comparison ----------------------------------------------------

    public operator == (a: Duration, b: Duration) -> Bool {
        return a.totalNanoseconds == b.totalNanoseconds
    }

    public operator < (a: Duration, b: Duration) -> Bool {
        return a.totalNanoseconds < b.totalNanoseconds
    }

    public fn hash(into hasher: inout Hasher) {
        hasher.combine(totalNanoseconds)
    }
}

extension Duration: Debug {
    /// The nanoseconds, exactly: `Duration.nanoseconds(1500000000)`.
    public fn debugDescription() -> String {
        return "Duration.nanoseconds(\(totalNanoseconds))"
    }
}
