module Sable.Core

// Random floating-point values in a range, spread evenly over it: multiples
// of one step, counted from the bound further from zero, each as likely as
// every other (Goualard, "Drawing random floating-point numbers from an
// interval", 2022). The step is the widest gap between neighbouring values
// in the range, so every multiple is a value of the type and nothing is
// rounded; scaling a fraction to the range instead would round, and so leave
// some values likelier than their neighbours, and an end out or in.

extension BinaryFloatingPoint {
    /// A random value from the range, its lower bound included and its upper
    /// one not, drawn from the generator. The values are evenly spaced, as
    /// close as the type's are just inside the bound further from zero, and
    /// each as likely: in 0.0..<1.0, an F64's are the multiples of 2^-53. A
    /// bound nearer zero that is not a multiple of the spacing is closer
    /// than that to the value next to it. A range that is empty, or has a
    /// bound that is not finite, traps.
    ///
    /// ```sable
    /// var generator = SeededRandomNumberGenerator(seed: 3)
    /// let x = F64.random(in: -1.0..<1.0, using: &generator)
    /// assert(x >= -1.0 && x < 1.0)
    /// ```
    public static fn random<G: RandomNumberGenerator>(in range: Range<Self>, using generator: inout G) -> Self {
        let lower = range.lowerBound
        let upper = range.upperBound
        precondition(lower < upper, "a random value of an empty range")
        precondition(lower.isFinite && upper.isFinite, "a random value of a range that is not finite")
        let step = Self.randomStep(lower, upper)
        let steps = Self.randomStepCount(lower.wideValue, upper.wideValue, step)
        let k = generator.next(upperBound: steps)
        if lower.abs() > upper.abs() {
            return Self.rounding(wideValue: Self.moved(lower.wideValue, k, by: step))
        }
        // Downwards from the upper bound, which is left out.
        if k + 1 == steps {
            return lower
        }
        return Self.rounding(wideValue: Self.moved(upper.wideValue, k + 1, by: -step))
    }

    /// A random value from the range, both ends included, drawn from the
    /// generator. The values are evenly spaced, and each as likely, as they
    /// are of a half-open range. A range whose upper bound is below its
    /// lower one, or that has a bound that is not finite, traps.
    ///
    /// ```sable
    /// var generator = SeededRandomNumberGenerator(seed: 3)
    /// let p = F32.random(in: 0.0...1.0, using: &generator)
    /// assert(p >= 0.0 && p <= 1.0)
    /// ```
    public static fn random<G: RandomNumberGenerator>(in range: ClosedRange<Self>, using generator: inout G) -> Self {
        let lower = range.lowerBound
        let upper = range.upperBound
        precondition(lower <= upper, "a random value of an empty range")
        precondition(lower.isFinite && upper.isFinite, "a random value of a range that is not finite")
        if lower == upper {
            return lower
        }
        let step = Self.randomStep(lower, upper)
        let steps = Self.randomStepCount(lower.wideValue, upper.wideValue, step)
        let k = generator.next(upperBound: steps + 1)
        if lower.abs() > upper.abs() {
            return k == steps ? upper : Self.rounding(wideValue: Self.moved(lower.wideValue, k, by: step))
        }
        return k == steps ? lower : Self.rounding(wideValue: Self.moved(upper.wideValue, k, by: -step))
    }

    /// A random value from the range, drawn from the system's generator.
    ///
    /// ```sable
    /// let x = F64.random(in: 0.0..<10.0)
    /// assert(x >= 0.0 && x < 10.0)
    /// ```
    public static fn random(in range: Range<Self>) -> Self {
        var system = SystemRandomNumberGenerator()
        return Self.random(in: range, using: &system)
    }

    /// A random value from the range, both ends included, drawn from the
    /// system's generator.
    public static fn random(in range: ClosedRange<Self>) -> Self {
        var system = SystemRandomNumberGenerator()
        return Self.random(in: range, using: &system)
    }

    /// The widest gap between neighbouring values of the range, which is at
    /// one of its ends, the one further from zero: a power of two, of which
    /// that end is a multiple. Every F16, BF16 and F32 is an F64, so the
    /// arithmetic is done as one.
    static fn randomStep(_ lower: Self, _ upper: Self) -> F64 {
        let first = lower.nextUp.wideValue - lower.wideValue
        let last = upper.wideValue - upper.nextDown.wideValue
        return first > last ? first : last
    }

    /// The distance between the bounds in steps, rounded up: at most 2^54.
    static fn randomStepCount(_ lower: F64, _ upper: F64, _ step: F64) -> U64 {
        let from = lower / step
        let to = upper / step
        let distance = to - from
        let whole = distance.ceiling()
        // What the subtraction rounded away may be what takes it past a
        // whole number.
        let lost = lower.abs() <= upper.abs() ? -from - (distance - to) : to - (distance + from)
        let count = U64.fromWideValue(whole)
        return whole == distance && lost > 0.0 ? count + 1 : count
    }

    /// The value a number of steps from another. They are taken in two
    /// halves, each of which an F64 holds exactly and neither of which
    /// overflows, as all of them may.
    static fn moved(_ from: F64, _ steps: U64, by step: F64) -> F64 {
        let half = steps >> 1
        return from + F64.converting(half) * step + F64.converting(steps - half) * step
    }
}
