module WeightedIndexDistributionTests

// WeightedIndexDistribution (Sable.Math).

import Sable.Math
import Sable.Testing
import DistributionAssertions

// How many of so many draws are each index.
fn drawn(_ distribution: WeightedIndexDistribution, of count: Int, seed: U64) -> Int[>..] {
    var generator = SeededRandomNumberGenerator(seed: seed)
    var counts: Int[>..] = []
    while counts.count < count {
        counts.append(0)
    }
    for index in distribution.samples(count: 60000, using: &generator) {
        counts[index] += 1
    }
    return counts
}

@test
fn wholeWeightsAreTheShares() {
    assertShares(drawn(WeightedIndexDistribution(weights: [1, 9, 90]), of: 3, seed: 1), [1.0, 9.0, 90.0])
}

@test
fn fractionalWeightsAreTheShares() {
    assertShares(drawn(WeightedIndexDistribution(weights: [0.125, 0.3, 2.0, 0.01]), of: 4, seed: 2), [0.125, 0.3, 2.0, 0.01])
}

@test
fn anIndexOfNoWeightIsNeverDrawn() {
    assertShares(drawn(WeightedIndexDistribution(weights: [0, 3, 0, 0, 2, 0]), of: 6, seed: 3), [0.0, 3.0, 0.0, 0.0, 2.0, 0.0])
    assertShares(drawn(WeightedIndexDistribution(weights: [0.0, 0.0, 0.5, 0.0, 0.7]), of: 5, seed: 4), [0.0, 0.0, 0.5, 0.0, 0.7])
}

@test
fn oneIndexIsAlwaysDrawn() {
    let counts = drawn(WeightedIndexDistribution(weights: [7]), of: 1, seed: 5)
    assertEqual(counts[0], 60000)
}

// Gives its values in turn.
struct Scripted: RandomNumberGenerator {
    var values: U64[>..]
    var drawn: Int

    mutating fn next() -> U64 {
        drawn += 1
        return values[drawn - 1]
    }
}

@test
fn everyShareOfTheDrawsIsExact() {
    // A quarter of the draws to each unit: the first has one, the third three.
    let odds = WeightedIndexDistribution(weights: [1, 0, 3])
    let quarter = U64(1) << 62
    var generator = Scripted { values: [0, quarter - 1, quarter, U64.max], drawn: 0 }
    assertEqual(odds.sample(using: &generator), 0)
    assertEqual(odds.sample(using: &generator), 0)
    assertEqual(odds.sample(using: &generator), 2)
    assertEqual(odds.sample(using: &generator), 2)
}

@test
fn weightsFarApartOrOutOfRangeOfTheirSumAreHeld() {
    // Their sum overflows an F64; the smallest is still drawn at times, if
    // it is one draw in 2^62.
    let huge = F64.greatestFiniteMagnitude
    assertShares(drawn(WeightedIndexDistribution(weights: [huge, huge, huge / 2.0]), of: 3, seed: 6), [2.0, 2.0, 1.0])
    let tiny = F64.leastNonzeroMagnitude
    assertShares(drawn(WeightedIndexDistribution(weights: [tiny, 3.0 * tiny]), of: 2, seed: 7), [1.0, 3.0])
    var last = Scripted { values: [U64.max], drawn: 0 }
    assertEqual(WeightedIndexDistribution(weights: [1.0, 1e-300]).sample(using: &last), 1)
}

@test(traps: "a weight must be positive")
fn noWeightsTrap() {
    let nothing: Int[>..] = []
    _ = WeightedIndexDistribution(weights: nothing)
}

@test(traps: "a weight must be positive")
fn weightsAllZeroTrap() {
    _ = WeightedIndexDistribution(weights: [0.0, 0.0])
}

@test(traps: "a weight")
fn aNegativeWholeWeightTraps() {
    _ = WeightedIndexDistribution(weights: [1, -1])
}

@test(traps: "a weight must be finite and not negative")
fn aNegativeWeightTraps() {
    _ = WeightedIndexDistribution(weights: [1.0, -1.0])
}

@test(traps: "a weight must be finite and not negative")
fn aWeightThatIsNoNumberTraps() {
    _ = WeightedIndexDistribution(weights: [1.0, F64.nan])
}

@test(traps: "a weight must be finite and not negative")
fn anInfiniteWeightTraps() {
    _ = WeightedIndexDistribution(weights: [1.0, F64.infinity])
}

@test(traps: "overflow")
fn aSumPastAU64Traps() {
    _ = WeightedIndexDistribution(weights: [Int.max, Int.max, 2])
}
