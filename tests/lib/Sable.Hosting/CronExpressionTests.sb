module CronExpressionTests

// Sable.Hosting, tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Hosting

import Sable.Hosting
import Sable.Testing
import Sable.Time

fn at(_ text: String) -> UtcDateTime {
    return try! UtcDateTime.parse(text)
}

// The first times after the moment, as the zone's clocks show them.
fn times(_ cron: String, _ from: String, _ zone: TimeZone, _ count: Int) -> String {
    let expression = try! CronExpression.parse(cron)
    var moment = at(from)
    var shown: String[>..] = []
    var i = 0
    while i < count {
        guard let next = expression.next(after: moment, in: zone) else {
            shown.append("none")
            break
        }
        moment = next
        shown.append(next.zoned(in: zone).format(pattern: "MM-dd HH:mm zzz"))
        i += 1
    }
    return shown.joined(separator: ", ")
}

fn utc(_ cron: String, _ from: String) -> String {
    return try! CronExpression.parse(cron).next(after: at(from), in: TimeZone.utc)!.toString()
}

fn refused(_ cron: String) -> String {
    do {
        let _ = try CronExpression.parse(cron)
        return "accepted"
    } catch {
        assertEqual(error.text, cron)
        return error.reason
    }
}

fn prague() -> TimeZone => try! TimeZone.posix("CET-1CEST,M3.5.0,M10.5.0/3")

@test
fn everyMinuteIsTheNextOne() {
    assertEqual(utc("* * * * *", "2026-05-01T10:20:30Z"), "2026-05-01T10:21:00Z")
    assertEqual(utc("* * * * *", "2026-05-01T10:21:00Z"), "2026-05-01T10:22:00Z")
    assertEqual(utc("* * * * *", "2026-12-31T23:59:59Z"), "2027-01-01T00:00:00Z")
}

@test
fn rangesStepsAndLists() {
    assertEqual(times("*/20 * * * *", "2026-05-01T10:20:30Z", TimeZone.utc, 4), "05-01 10:40 +00:00, 05-01 11:00 +00:00, 05-01 11:20 +00:00, 05-01 11:40 +00:00")
    assertEqual(times("5/25 9-17/4 * * *", "2026-05-01T10:00:00Z", TimeZone.utc, 4), "05-01 13:05 +00:00, 05-01 13:30 +00:00, 05-01 13:55 +00:00, 05-01 17:05 +00:00")
    assertEqual(times("0,15,45-46 8 * * *", "2026-05-01T08:00:00Z", TimeZone.utc, 4), "05-01 08:15 +00:00, 05-01 08:45 +00:00, 05-01 08:46 +00:00, 05-02 08:00 +00:00")
    assertEqual(utc("0 0 * * *", "1969-12-30T12:00:00Z"), "1969-12-31T00:00:00Z")
}

@test
fn monthsAndWeekdaysHaveNames() {
    assertEqual(utc("0 0 1 FEB *", "2026-05-01T00:00:00Z"), "2027-02-01T00:00:00Z")
    assertEqual(utc("0 12 * jan-mar Sat", "2026-05-01T00:00:00Z"), "2027-01-02T12:00:00Z")
    assert(try! CronExpression.parse("0 0 * * sun") == CronExpression.parse("0 0 * * 7"))
    assert(try! CronExpression.parse("0 0 * * 0") == CronExpression.parse("0 0 * * 7"))
    assert(try! CronExpression.parse("0 0 * * sat-sun") == CronExpression.parse("0 0 * * 6,0"))
    assert(try! CronExpression.parse("0 0 * * 5-7") == CronExpression.parse("0 0 * * fri,sat,sun"))
    assert(!(try! CronExpression.parse("0 0 * * 1") == CronExpression.parse("0 0 * * 2")))
}

@test
fn aDayThatBothFieldsRestrictIsEithers() {
    // The 13th, or a Friday.
    assertEqual(times("0 0 13 * 5", "2026-01-31T12:00:00Z", TimeZone.utc, 4), "02-06 00:00 +00:00, 02-13 00:00 +00:00, 02-20 00:00 +00:00, 02-27 00:00 +00:00")
    assertEqual(times("0 0 13 * 5", "2026-03-06T12:00:00Z", TimeZone.utc, 2), "03-13 00:00 +00:00, 03-20 00:00 +00:00")
    // A field that begins with '*' restricts with the other: odd days that are Mondays.
    assertEqual(times("0 0 */2 * 1", "2026-06-01T12:00:00Z", TimeZone.utc, 2), "06-15 00:00 +00:00, 06-29 00:00 +00:00")
}

@test
fn daysNotInEveryMonthOrYear() {
    assertEqual(times("0 0 31 * *", "2026-01-31T12:00:00Z", TimeZone.utc, 3), "03-31 00:00 +00:00, 05-31 00:00 +00:00, 07-31 00:00 +00:00")
    assertEqual(utc("0 0 29 2 *", "2026-01-01T00:00:00Z"), "2028-02-29T00:00:00Z")
    assertEqual(utc("0 0 29 2 *", "2096-03-01T00:00:00Z"), "2104-02-29T00:00:00Z")
}

@test
fn theShorthands() {
    assertEqual(utc("@hourly", "2026-05-05T10:20:00Z"), "2026-05-05T11:00:00Z")
    assertEqual(utc("@daily", "2026-05-05T10:20:00Z"), "2026-05-06T00:00:00Z")
    assertEqual(utc("@midnight", "2026-05-05T10:20:00Z"), "2026-05-06T00:00:00Z")
    assertEqual(utc("@weekly", "2026-05-05T10:20:00Z"), "2026-05-10T00:00:00Z")
    assertEqual(utc("@monthly", "2026-05-05T10:20:00Z"), "2026-06-01T00:00:00Z")
    assertEqual(utc("@Yearly", "2026-05-05T10:20:00Z"), "2027-01-01T00:00:00Z")
    assertEqual(utc("@annually", "2026-05-05T10:20:00Z"), "2027-01-01T00:00:00Z")
}

@test
fn blanksBetweenFieldsMayBeAny() {
    assert(try! CronExpression.parse("  0\t0  * * *  ") == CronExpression.parse("0 0 * * *"))
}

@test
fn whatIsNotCronIsRefusedSayingWhy() {
    assertEqual(refused(""), "it has 0 fields, not 5")
    assertEqual(refused("* * * *"), "it has 4 fields, not 5")
    assertEqual(refused("* * * * * *"), "it has 6 fields, not 5")
    assertEqual(refused("60 * * * *"), "60 is out of range for the minute: 0 to 59")
    assertEqual(refused("* 24 * * *"), "24 is out of range for the hour: 0 to 23")
    assertEqual(refused("* * 0 * *"), "0 is out of range for the day of the month: 1 to 31")
    assertEqual(refused("* * * 13 *"), "13 is out of range for the month: 1 to 12")
    assertEqual(refused("* * * * 8"), "8 is out of range for the day of the week: 0 to 7")
    assertEqual(refused("*/0 * * * *"), "a step of 0 in the minute")
    assertEqual(refused("*/x * * * *"), "'x' in the minute")
    assertEqual(refused("-5 * * * *"), "'' in the minute")
    assertEqual(refused("5- * * * *"), "'' in the minute")
    assertEqual(refused("1,,2 * * * *"), "'' in the minute")
    assertEqual(refused("99999999999999999999 * * * *"), "'99999999999999999999' in the minute")
    assertEqual(refused("30-10 * * * *"), "'30-10' goes backwards in the minute")
    assertEqual(refused("* * * foo *"), "'foo' in the month")
    assertEqual(refused("0 0 30 2 *"), "no month it names has such a day")
    assertEqual(refused("0 0 31 4,6 *"), "no month it names has such a day")
    assertEqual(refused("@never"), "it has 1 fields, not 5")
}

@test
fn aFixedTimeTheClocksSkipComesAsTheyHave() {
    // 2:00 to 3:00, the 29th of March.
    assertEqual(times("30 2 * * *", "2026-03-28T00:00:00Z", prague(), 3), "03-28 02:30 +01:00, 03-29 03:00 +02:00, 03-30 02:30 +02:00")
    // Two in the hour come once.
    assertEqual(times("0,30 2 * * *", "2026-03-28T12:00:00Z", prague(), 2), "03-29 03:00 +02:00, 03-30 02:00 +02:00")
    // From just before, and from the very moment.
    assertEqual(times("30 2 * * *", "2026-03-29T00:59:59Z", prague(), 1), "03-29 03:00 +02:00")
    assertEqual(times("30 2 * * *", "2026-03-29T01:00:00Z", prague(), 1), "03-30 02:30 +02:00")
    // One due then besides is the same.
    assertEqual(times("0 2,3 * * *", "2026-03-28T12:00:00Z", prague(), 2), "03-29 03:00 +02:00, 03-30 02:00 +02:00")
}

@test
fn aFixedTimeTheClocksShowTwiceComesOnce() {
    // 3:00 to 2:00, the 25th of October.
    assertEqual(times("30 2 * * *", "2026-10-24T12:00:00Z", prague(), 2), "10-25 02:30 +02:00, 10-26 02:30 +01:00")
    // From between the two.
    assertEqual(times("30 2 * * *", "2026-10-25T01:10:00Z", prague(), 1), "10-26 02:30 +01:00")
    assertEqual(times("0 2,3 * * *", "2026-10-25T00:30:00Z", prague(), 2), "10-25 03:00 +01:00, 10-26 02:00 +01:00")
}

@test
fn aWildcardFollowsTheClock() {
    assertEqual(times("*/30 * * * *", "2026-03-29T00:20:00Z", prague(), 3), "03-29 01:30 +01:00, 03-29 03:00 +02:00, 03-29 03:30 +02:00")
    assertEqual(times("*/30 2 * * *", "2026-03-28T12:00:00Z", prague(), 1), "03-30 02:00 +02:00")
    assertEqual(times("0 * * * *", "2026-10-24T23:30:00Z", prague(), 4), "10-25 02:00 +02:00, 10-25 02:00 +01:00, 10-25 03:00 +01:00, 10-25 04:00 +01:00")
    assertEqual(times("*/30 2 * * *", "2026-10-25T00:10:00Z", prague(), 3), "10-25 02:30 +02:00, 10-25 02:00 +01:00, 10-25 02:30 +01:00")
}

@test
fn aDayThatBeginsWithAGap() {
    // Beirut's clocks go from 0:00 to 1:00.
    let beirut = try! TimeZone.posix("EET-2EEST,M3.5.0/0,M10.5.0/0")
    assertEqual(times("0 0 * * *", "2026-03-28T12:00:00Z", beirut, 2), "03-29 01:00 +03:00, 03-30 00:00 +03:00")
    assertEqual(times("0 0 * * *", "2026-10-24T12:00:00Z", beirut, 2), "10-25 00:00 +02:00, 10-26 00:00 +02:00")
}

@test
fn halfAnHoursChange() {
    let lordHowe = try! TimeZone.posix("<+1030>-10:30<+11>-11,M10.1.0,M4.1.0")
    // 2:00 to 2:30 in October; 2:00 to 1:30 in April.
    assertEqual(times("15 2 * * *", "2026-10-03T00:00:00Z", lordHowe, 2), "10-04 02:30 +11:00, 10-05 02:15 +11:00")
    assertEqual(times("45 1 * * *", "2026-04-04T00:00:00Z", lordHowe, 2), "04-05 01:45 +11:00, 04-06 01:45 +10:30")
}

@test
fn whatTheDatabaseSaysIsFollowed() {
    let newYork = try! TimeZone.find("America/New_York")
    assertEqual(times("30 2 * * *", "2026-03-08T00:00:00Z", newYork, 2), "03-08 03:00 -04:00, 03-09 02:30 -04:00")
    assertEqual(times("30 1 * * *", "2026-11-01T00:00:00Z", newYork, 2), "11-01 01:30 -04:00, 11-02 01:30 -05:00")
}
