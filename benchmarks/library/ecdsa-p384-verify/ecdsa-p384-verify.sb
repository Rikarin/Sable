module EcdsaP384VerifyBench

// ECDSA on P384 against .NET's ECDsa.VerifyData: a signature checked 200
// times, every fourth of another message.

import Sable.Crypto
import Sable.Testing

fn run(_ publicKey: EcdsaPublicKey<P384>, _ message: U8[>..], _ other: U8[>..], _ signature: EcdsaSignature<P384>) -> String {
    var valid = 0
    var round = 0
    while round < 200 {
        if publicKey.isValid(signature, for: round % 4 == 3 ? other : message) {
            valid += 1
        }
        round += 1
    }
    return "\(valid)"
}

@bench
fn measure(_ b: Bencher) {
    let key = EcdsaPrivateKey<P384>.generate()
    let publicKey = key.publicKey
    let message = U8[>..](repeating: 7, count: 64)
    let other = U8[>..](repeating: 8, count: 64)
    let signature = key.sign(message)
    b.check(b.iterate { run(publicKey, message, other, signature) })
}
