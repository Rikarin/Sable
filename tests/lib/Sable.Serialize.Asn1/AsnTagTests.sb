module AsnTagTests

import Sable.Serialize.Asn1
import Sable.Testing
import Sable.Text

let tags: (AsnTag, String)[>..] = [
    (.bool, "01"),
    (AsnTag.sequence.asConstructed(), "30"),
    (.application(30), "5e"),
    (.application(31), "5f1f"),
    (.context(127), "9f7f"),
    (.context(128), "9f8100"),
    (AsnTag(.Private, 16383, isConstructed: true), "ffff7f"),
    (AsnTag(.Private, 16384), "df818000"),
    (AsnTag(.Private, 2147483647), "df87ffffff7f"),
]

@test(arguments: tags)
fn aTagIsItsBytes(_ tag: AsnTag, _ hex: String) {
    assertEqualText(Hex.encode(tag.encoded()), hex)
    assertEqual(tag.encodedSize, hex.count / 2)
    let (found, size) = try! AsnTag.decode(try! Hex.decode(hex + "ff"))
    assertEqual(found, tag)
    assertEqual(size, hex.count / 2)
    assertEqual(found.asPrimitive().asConstructed().isConstructed, true)
}

@test
fn aTagMatchesWhateverIsInIt() {
    let tag = AsnTag.context(3)
    expect(tag.matches(tag.asConstructed()) && tag != tag.asConstructed())
    expect(!tag.matches(.application(3)) && !tag.matches(.context(4)))
    assertEqual(tag.asConstructed().asPrimitive(), tag)
}

let names: (AsnTag, String)[>..] = [
    (.integer, "INTEGER"),
    (.duration, "DURATION"),
    (.universal(36), "RELATIVE-OID-IRI"),
    (.universal(37), "[UNIVERSAL 37]"),
    (.context(0), "[0]"),
    (.application(1), "[APPLICATION 1]"),
    (AsnTag(.Private, 2), "[PRIVATE 2]"),
]

@test(arguments: names)
fn aTagIsWrittenAsInAModule(_ tag: AsnTag, _ name: String) {
    assertEqualText("\(tag)", name)
}

let numbers: (AsnTag, Int)[>..] = [
    (.bool, 1), (.integer, 2), (.bitString, 3), (.octetString, 4), (.null, 5), (.objectIdentifier, 6), (.external, 8),
    (.real, 9), (.enumerated, 10), (.embeddedPdv, 11), (.relativeOid, 13), (.time, 14), (.sequence, 16), (.set, 17),
    (.utcTime, 23), (.generalizedTime, 24), (.characterString, 29), (.date, 31), (.timeOfDay, 32), (.dateTime, 33),
    (.duration, 34),
]

@test(arguments: numbers)
fn everyTypeHasItsNumber(_ tag: AsnTag, _ number: Int) {
    expect(Int(tag.number) == number)
}
