module Sable.Diagnostics

import Sable.Time

// Structured logging (docs/06 §6.4): a line per event on standard error,
// "LEVEL name: message key=value ...", with values quoted when they hold a
// space, a quote or an '='. Written in Sable over the runtime's calls.

/// Lines of a level and up, under a name, the category, each with the
/// logger's own fields and the call's.
///
/// `log` and `with` are open, for a logger that puts its lines elsewhere:
/// Sable.Testing's `FakeLogger` keeps them instead. `Logger.Of<Category>`
/// is one whose category is a type's name, which a container injects.
///
/// ```sable
/// let log = Logger("orders")
/// log.keepLines()
/// let request = log.with([field("id", "r-1")])
/// request.keepLines()
/// request.warning("slow", [field("path", "/a b")])
/// log.debug("below the threshold")
/// assert(request.lines() == ["WARN orders: slow id=r-1 path=\"/a b\""])
/// assert(log.lines().isEmpty)
/// ```
public open class Logger {
    /// The category: what the lines are of.
    public var name: String
    public var threshold: Level

    /// Stamp each line with the UTC time, to the second.
    public var timestamps: Bool

    /// The fields every line from this logger carries, before the call's.
    public var context: Field[>..] = []

    /// Every line written, when kept, as well as written: for tests.
    var kept: String[>..] = []
    var keeping: Bool = false

    public init(_ name: String) {
        self.name = name
        self.threshold = Level.Info
        self.timestamps = false
    }

    /// The level, from SABLE_LOG when it names one ("debug", "warn", ...).
    public fn configureFromEnvironment() {
        if let wanted = Runtime.environment("SABLE_LOG") {
            if let level = parseLevel(wanted) {
                threshold = level
            }
        }
    }

    /// A logger that adds these fields to every line, of another category
    /// where it is given one, sharing the rest.
    public open fn with(_ fields: Field[>..] = [], name: String? = none) -> Logger {
        let child = Logger(name ?? self.name)
        child.threshold = threshold
        child.timestamps = timestamps
        child.context = context
        child.context.append(contentsOf: fields)
        return child
    }

    /// Keep the lines as well as writing them, for `lines()` to give back.
    public fn keepLines() {
        keeping = true
    }

    public fn lines() -> String[>..] {
        return kept
    }

    public fn isEnabled(_ level: Level) -> Bool {
        return rank(level) >= rank(threshold)
    }

    /// The fields a line of the call carries: the logger's, the call's, and
    /// the trace and span it is logged in, to find it by in a trace.
    public fn fields(of call: Field[>..]) -> Field[>..] {
        var all = context
        all.append(contentsOf: call)
        if let span = Tracing.currentContext {
            all.append(field("trace_id", span.traceId.hex))
            all.append(field("span_id", span.spanId.hex))
        }
        return all
    }

    /// Writes the line, if the level is not below the threshold.
    public open fn log(_ level: Level, _ message: String, _ fields: Field[>..]) {
        if !isEnabled(level) {
            return
        }
        var line = ""
        if timestamps {
            line = UtcDateTime.now().iso8601() + " "
        }
        line = line + levelName(level) + " " + name + ": " + message
        for f in self.fields(of: fields) {
            line = line + " " + f.key + "=" + quoted(f.value)
        }
        if keeping {
            kept.append(line)
        }
        Runtime.writeError(line + "\n")
    }

    public fn trace(_ message: String) { log(Level.Trace, message, []) }
    public fn debug(_ message: String) { log(Level.Debug, message, []) }
    public fn info(_ message: String) { log(Level.Info, message, []) }
    public fn warning(_ message: String) { log(Level.Warning, message, []) }
    public fn error(_ message: String) { log(Level.Error, message, []) }

    public fn info(_ message: String, _ fields: Field[>..]) { log(Level.Info, message, fields) }
    public fn warning(_ message: String, _ fields: Field[>..]) { log(Level.Warning, message, fields) }
    public fn error(_ message: String, _ fields: Field[>..]) { log(Level.Error, message, fields) }

    /// A logger whose category is the type's name, .NET's `ILogger<T>`: what
    /// a type that logs is given, `log: Logger.Of<Checkout>`. It writes
    /// through a logger of the category made `with` a parent, so takes its
    /// threshold, fields and where its lines go; or else through a new one.
    /// Sable.DependencyInjection makes it `Injectable`, made with the
    /// container's `Logger`. A Logger is not Sendable, so neither is this.
    ///
    /// ```sable
    /// struct Checkout {}
    ///
    /// let root = Logger("app")
    /// root.threshold = .Warning
    /// let log = Logger.Of<Checkout>(root)
    /// assert(log.logger.name.hasSuffix("Checkout"))
    /// assert(!log.logger.isEnabled(.Info))
    /// ```
    public struct Of<Category> {
        /// What it writes through: a logger of the category.
        public let logger: Logger

        /// One writing through a logger of the category made with the
        /// parent, or through a new one.
        public init(_ parent: Logger? = none) {
            let name = "\(Category.self)"
            logger = parent?.with(name: name) ?? Logger(name)
        }

        public fn isEnabled(_ level: Level) -> Bool { return logger.isEnabled(level) }
        public fn log(_ level: Level, _ message: String, _ fields: Field[>..]) { logger.log(level, message, fields) }
        public fn with(_ fields: Field[>..] = [], name: String? = none) -> Logger { return logger.with(fields, name: name) }

        public fn trace(_ message: String) { logger.log(Level.Trace, message, []) }
        public fn debug(_ message: String) { logger.log(Level.Debug, message, []) }
        public fn info(_ message: String) { logger.log(Level.Info, message, []) }
        public fn warning(_ message: String) { logger.log(Level.Warning, message, []) }
        public fn error(_ message: String) { logger.log(Level.Error, message, []) }

        public fn info(_ message: String, _ fields: Field[>..]) { logger.log(Level.Info, message, fields) }
        public fn warning(_ message: String, _ fields: Field[>..]) { logger.log(Level.Warning, message, fields) }
        public fn error(_ message: String, _ fields: Field[>..]) { logger.log(Level.Error, message, fields) }
    }
}

/// The value as written, or in quotes with '"' and '\' escaped where it would be misread.
fn quoted(_ value: String) -> String {
    var plain = value.count > 0
    var i = 0
    while i < value.count {
        let c = value.at(i)
        if c == ' ' || c == '"' || c == '=' || c == '\\' || c == '\n' {
            plain = false
        }
        i += 1
    }
    if plain {
        return value
    }
    var text = "\""
    i = 0
    while i < value.count {
        let c = value.at(i)
        if c == '"' || c == '\\' {
            text = text + "\\"
        }
        if c == '\n' {
            text = text + "\\n"
        } else {
            text = text + String.fromChar(c)
        }
        i += 1
    }
    return text + "\""
}
