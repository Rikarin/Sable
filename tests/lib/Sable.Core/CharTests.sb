module CharTests

// Char's properties, case mappings, digits and encodings (Sable.Core), tested
// with '@test': run with
//     tools/stdlib-coverage.sh Sable.Core
// Every scalar's properties and mappings were checked once against the
// Unicode Character Database the tables are made from; these pin examples
// from each table and each branch.

import Sable.Testing

fn scalar(_ code: Int) -> Char {
    return Char.fromCodePoint(code)!
}

@test(arguments: ['a', 'Z', 'é', 'Ж', 'ω', '中', 'א', 'ǅ', 'ʰ'])
fn lettersAreLettersInEveryScript(_ c: Char) {
    expect(c.isLetter)
}

@test(arguments: ['1', '_', ' ', '-', '٣', '€', 'Ⅻ'])
fn otherCharactersAreNoLetters(_ c: Char) {
    expect(!c.isLetter)
}

@test
fn alphabeticTakesInLetterNumbersAndVowelSigns() {
    expect('Ⅻ'.isAlphabetic, "a Roman numeral is alphabetic")
    expect(scalar(0x093E).isAlphabetic, "a Devanagari vowel sign is alphabetic")
    expect('q'.isAlphabetic && 'Q'.isAlphabetic, "ASCII letters are alphabetic")
    expect(!'7'.isAlphabetic && !'!'.isAlphabetic, "digits and punctuation are not")
    expect('7'.isAlphanumeric && 'Ⅻ'.isAlphanumeric && '٣'.isAlphanumeric, "numbers are alphanumeric")
    expect(!'-'.isAlphanumeric, "a dash is not alphanumeric")
}

@test(arguments: ['0', '9', '٣', '੫', 'Ⅻ', '½', '²'])
fn numericCoversTheDigitsAndNumbersOfEveryScript(_ c: Char) {
    expect(c.isNumeric)
}

@test
fn lettersAndPointsAreNotNumericNorOtherScriptsDigitsDigits() {
    expect(!'a'.isNumeric && !'.'.isNumeric, "letters and points are not")
    expect('5'.isDigit && !'٣'.isDigit, "isDigit is ASCII's")
}

@test
fn caseIsUnicodesUppercaseAndLowercaseProperties() {
    expect('A'.isUppercase && !'a'.isUppercase, "ASCII")
    expect('Ж'.isUppercase && 'ж'.isLowercase, "Cyrillic")
    expect('Ⅻ'.isUppercase, "a Roman numeral is Other_Uppercase")
    expect('ª'.isLowercase, "the feminine ordinal is Other_Lowercase")
    expect(!'ǅ'.isUppercase && !'ǅ'.isLowercase && 'ǅ'.isCased, "a title-case digraph is cased, neither upper nor lower")
    expect(!'中'.isCased && !'1'.isCased, "uncased scalars")
}

@test
fn caseIgnorableScalarsAreThoseAWordsCaseLooksPast() {
    expect('\''.isCaseIgnorable && '.'.isCaseIgnorable && ':'.isCaseIgnorable, "ASCII apostrophe, period, colon")
    expect(scalar(0x0301).isCaseIgnorable, "a combining acute accent")
    expect(scalar(0x00AD).isCaseIgnorable, "a soft hyphen")
    expect(!'a'.isCaseIgnorable && !'-'.isCaseIgnorable && !'Ж'.isCaseIgnorable, "letters and dashes are not")
}

@test(arguments: [
    0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x20, 0x85, 0xA0, 0x1680, 0x2000, 0x2007, 0x200A, 0x2028, 0x2029, 0x202F, 0x205F, 0x3000
])
fn whitespaceIsUnicodesWhiteSpaceProperty(_ code: Int) {
    expect(scalar(code).isWhitespace)
}

@test(arguments: [0x08, 0x0E, 0x1F, 0x21, 0x200B, 0x180E, 0xFEFF, 0x2060])
fn whatLooksLikeNothingIsNotAllWhitespace(_ code: Int) {
    expect(!scalar(code).isWhitespace)
}

@test
fn punctuationSymbolsAndControls() {
    expect('!'.isPunctuation && '«'.isPunctuation && '_'.isPunctuation && '-'.isPunctuation, "punctuation")
    expect(!'+'.isPunctuation && !'a'.isPunctuation, "not punctuation")
    expect('+'.isSymbol && '$'.isSymbol && '€'.isSymbol && '©'.isSymbol && '^'.isSymbol, "symbols")
    expect(!'!'.isSymbol, "not a symbol")
    expect('\n'.isControl && scalar(0x7F).isControl && scalar(0x9F).isControl, "controls")
    expect(!' '.isControl && !scalar(0xA0).isControl && !scalar(0x200D).isControl, "not controls")
}

@test(arguments: [
    ('A', .UppercaseLetter), ('a', .LowercaseLetter), ('ǅ', .TitlecaseLetter), ('ʰ', .ModifierLetter),
    ('中', .OtherLetter), (scalar(0x0301), .NonspacingMark), (scalar(0x093E), .SpacingMark),
    (scalar(0x20DD), .EnclosingMark), ('٣', .DecimalNumber), ('Ⅻ', .LetterNumber), ('½', .OtherNumber),
    ('_', .ConnectorPunctuation), ('-', .DashPunctuation), ('(', .OpenPunctuation), (')', .ClosePunctuation),
    ('«', .InitialPunctuation), ('»', .FinalPunctuation), ('!', .OtherPunctuation), ('+', .MathSymbol),
    ('$', .CurrencySymbol), ('^', .ModifierSymbol), ('©', .OtherSymbol), (' ', .SpaceSeparator),
    (scalar(0x2028), .LineSeparator), (scalar(0x2029), .ParagraphSeparator), ('\t', .Control),
    (scalar(0x200D), .Format), (scalar(0xE000), .PrivateUse), (scalar(0x0378), .Unassigned)
])
fn generalCategoryCoversEachKind(_ c: Char, _ category: GeneralCategory) {
    expect(c.generalCategory == category)
}

@test(arguments: [(0, .Control), (0x10FFFF, .Unassigned), (0x10FFFD, .PrivateUse), (0x1F600, .OtherSymbol)])
fn generalCategoryAtTheEndsOfTheCodeSpace(_ code: Int, _ category: GeneralCategory) {
    expect(scalar(code).generalCategory == category)
}

@test
fn asciiClassesAskOnlyAboutAscii() {
    expect('a'.isAscii && scalar(0x7F).isAscii && !'é'.isAscii, "isAscii")
    expect('7'.isAsciiDigit && !'٣'.isAsciiDigit, "isAsciiDigit")
    expect('f'.isAsciiHexDigit && 'F'.isAsciiHexDigit && '0'.isAsciiHexDigit && !'g'.isAsciiHexDigit && !'G'.isAsciiHexDigit, "isAsciiHexDigit")
    expect('e'.isHexDigit && !'x'.isHexDigit, "isHexDigit")
    expect('q'.isAsciiLetter && 'Q'.isAsciiLetter && !'é'.isAsciiLetter && !'@'.isAsciiLetter && !'['.isAsciiLetter, "isAsciiLetter")
    expect('Q'.isAsciiUppercase && !'q'.isAsciiUppercase && 'q'.isAsciiLowercase && !'Q'.isAsciiLowercase, "ASCII case")
    expect('q'.isAsciiAlphanumeric && '3'.isAsciiAlphanumeric && !'-'.isAsciiAlphanumeric, "isAsciiAlphanumeric")
    expect('!'.isAsciiPunctuation && '~'.isAsciiPunctuation && '@'.isAsciiPunctuation && !'a'.isAsciiPunctuation && !' '.isAsciiPunctuation && !'«'.isAsciiPunctuation, "isAsciiPunctuation")
    expect('~'.isAsciiGraphic && !' '.isAsciiGraphic && !scalar(0x7F).isAsciiGraphic, "isAsciiGraphic")
    expect(' '.isAsciiWhitespace && '\t'.isAsciiWhitespace && '\n'.isAsciiWhitespace && '\r'.isAsciiWhitespace && scalar(0x0C).isAsciiWhitespace, "ASCII white space")
    expect(!scalar(0x0B).isAsciiWhitespace && !scalar(0xA0).isAsciiWhitespace, "not the vertical tab, nor the no-break space")
    expect(scalar(0).isAsciiControl && scalar(0x1F).isAsciiControl && scalar(0x7F).isAsciiControl && !scalar(0x85).isAsciiControl, "isAsciiControl")
}

@test(arguments: [
    ('a', "A"), ('A', "A"), ('ß', "SS"), ('ŉ', "ʼN"), ('ﬀ', "FF"), ('ǅ', "Ǆ"), ('ж', "Ж"), ('1', "1"), ('中', "中")
])
fn uppercasedUsesTheFullMappings(_ c: Char, _ text: String) {
    expect(c.uppercased() == text)
}

@test(arguments: [('A', "a"), ('İ', "i\u{307}"), ('Ж', "ж"), ('Σ', "σ"), ('ǅ', "ǆ"), ('a', "a")])
fn lowercasedUsesTheFullMappings(_ c: Char, _ text: String) {
    expect(c.lowercased() == text)
}

@test(arguments: [
    ('ß', 'ß'), ('ā', 'Ā'), ('ȁ', 'Ȁ'), ('ÿ', 'Ÿ'), ('ω', 'Ω'), (scalar(0x10428), scalar(0x10400)), ('z', 'Z')
])
fn simpleUppercaseIsOneScalar(_ c: Char, _ upper: Char) {
    expect(c.simpleUppercase == upper)
}

@test(arguments: [('Ā', 'ā'), ('Ÿ', 'ÿ'), ('Z', 'z'), ('1', '1'), ('中', '中')])
fn simpleLowercaseIsOneScalar(_ c: Char, _ lower: Char) {
    expect(c.simpleLowercase == lower)
}

@test(arguments: [('K', 'k'), (scalar(0x212A), 'k'), ('Σ', 'σ'), ('ς', 'σ'), ('ẞ', 'ß'), ('1', '1')])
fn caseFoldingMakesCaseVariantsTheSame(_ c: Char, _ folded: Char) {
    expect(c.caseFolded == folded)
}

@test(arguments: [('a', 'A'), ('é', 'é'), ('@', '@'), ('[', '['), ('Z', 'Z')])
fn asciiUppercaseChangesOnlyAsciiLetters(_ c: Char, _ upper: Char) {
    expect(c.asciiUppercased() == upper)
}

@test(arguments: [('Z', 'z'), ('[', '['), ('É', 'É'), ('a', 'a')])
fn asciiLowercaseChangesOnlyAsciiLetters(_ c: Char, _ lower: Char) {
    expect(c.asciiLowercased() == lower)
}

@test(arguments: [('0', 10, 0), ('9', 10, 9), ('a', 16, 10), ('F', 16, 15), ('z', 36, 35)])
fn digitValuesInARadix(_ c: Char, _ radix: Int, _ value: Int) {
    expect(c.digitValue(radix: radix) == value)
}

// 'a' is no decimal digit and '2' no binary one; only ASCII's digits have values.
@test(arguments: [('a', 10), ('2', 2), ('٣', 10), ('-', 36)])
fn otherCharactersAreNoDigitsOfTheRadix(_ c: Char, _ radix: Int) {
    expect(c.digitValue(radix: radix) == none)
}

@test
fn aDigitsRadixIsTenUnlessTold() {
    expect('9'.digitValue() == 9)
    expect('a'.digitValue() == none)
}

@test(traps: "unreachable")
fn aDigitValueInRadixOneTraps() {
    _ = '0'.digitValue(radix: 1)
}

@test(traps: "unreachable")
fn aDigitValueInRadixThirtySevenTraps() {
    _ = '0'.digitValue(radix: 37)
}

@test(arguments: [(7, 10, '7'), (11, 16, 'b'), (35, 36, 'z'), (10, 10, none), (-1, 10, none)])
fn digitsFromValues(_ value: Int, _ radix: Int, _ digit: Char?) {
    expect(Char.fromDigit(value, radix: radix) == digit)
}

@test
fn aValuesRadixIsTenUnlessTold() {
    expect(Char.fromDigit(7) == '7')
    expect(Char.fromDigit(10) == none)
}

@test(traps: "unreachable")
fn aDigitInRadixOneTraps() {
    _ = Char.fromDigit(0, radix: 1)
}

@test(traps: "unreachable")
fn aDigitInRadixThirtySevenTraps() {
    _ = Char.fromDigit(0, radix: 37)
}

@test(arguments: [('a', 1, 1), ('é', 2, 1), ('€', 3, 1), ('😀', 4, 2)])
fn encodedLengths(_ c: Char, _ bytes: Int, _ units: Int) {
    expect(c.utf8Length == bytes)
    expect(c.utf16Length == units)
}

@test
fn encodingToUtf8AddsTheBytes() {
    var bytes: U8[>..] = []
    'a'.encodeUtf8(into: &bytes)
    'é'.encodeUtf8(into: &bytes)
    '€'.encodeUtf8(into: &bytes)
    scalar(0x1F600).encodeUtf8(into: &bytes)
    expect(bytes == [0x61, 0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80], "the UTF-8 bytes")
}

@test
fn encodingToUtf16AddsTheCodeUnits() {
    var units: U16[>..] = []
    'a'.encodeUtf16(into: &units)
    '€'.encodeUtf16(into: &units)
    scalar(0x1F600).encodeUtf16(into: &units)
    expect(units == [0x61, 0x20AC, 0xD83D, 0xDE00], "the UTF-16 code units")
}

@test
fn codePointsAndScalars() {
    assertEqual('A'.codePoint, 65)
    assertEqual('A'.code, 65)
    expect(Char.fromCodePoint(0xD800) == none, "a surrogate is no scalar")
    expect(Char.fromCodePoint(0x110000) == none, "nor is a code past U+10FFFF")
    expect(Char.fromCodePoint(-1) == none, "nor a negative one")
}

@test
fn aClosedRangeOfCharactersCounts() {
    var letters = ""
    for c in 'a'...'e' {
        letters = letters + String.fromChar(c)
    }
    assertEqual(letters, "abcde")
}

@test
fn theUnicodeVersionIsNamed() {
    assertEqual(unicodeVersion, "16.0.0")
}
