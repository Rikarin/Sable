module Sable.Core

extension UInt: Parsable {
    /// The number the text writes in decimal, with a sign if it likes: what
    /// `format` writes with nothing said. `.Overflow` past the greatest UInt,
    /// `.Underflow` past the least.
    ///
    /// ```sable
    /// assert(try! UInt.parse("18446744073709551615") == 18446744073709551615)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S) throws(ParseError) -> UInt {
        return try UInt.parse(text, radix: 10, styles: .Sign)
    }

    /// The number the text writes in the radix — 2 to 36, with letters of
    /// either case past 9; another traps — with what else the styles allow:
    /// white space, a sign, the radix's prefix, separators.
    ///
    /// ```sable
    /// assert(try! UInt.parse("0x7f", radix: 16, styles: .Prefix) == 127)
    /// ```
    public static fn parse<S: StringProtocol>(_ text: S, radix: Int, styles: NumberStyles = .Sign) throws(ParseError) -> UInt {
        let text = text.asSubstring
        if let value = shortInteger(text, radix, styles), value >= 0 {
            return UInt(value)
        }
        let (negative, magnitude) = try parseInteger(text, radix, styles)
        let value = try unsignedValue(negative, magnitude, 18446744073709551615)
        return UInt(value)
    }
}
