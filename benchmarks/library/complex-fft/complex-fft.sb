module ComplexFftBench

import Sable.Math
import Sable.Testing

// Arrays of Complex<F64>: a radix-2 FFT of 65,536 points and its inverse,
// sixteen times over, and how near the signal comes back.

fn transform(_ values: inout Complex<F64>[>..], _ roots: Complex<F64>[>..]) {
    let n = values.count
    var j = 0
    for i in 1..<n {
        var bit = n >> 1
        while (j & bit) != 0 {
            j = j ^ bit
            bit = bit >> 1
        }
        j = j ^ bit
        if i < j {
            values.swapAt(i, j)
        }
    }
    var length = 2
    while length <= n {
        let half = length / 2
        let step = n / length
        var start = 0
        while start < n {
            for k in 0..<half {
                let even = values[start + k]
                let odd = values[start + k + half] * roots[k * step]
                values[start + k] = even + odd
                values[start + k + half] = even - odd
            }
            start += length
        }
        length *= 2
    }
}

fn run(_ signal: Complex<F64>[>..], _ forward: Complex<F64>[>..], _ inverse: Complex<F64>[>..]) -> String {
    let n = signal.count
    var values = signal
    var peak = 0.0
    for _ in 0..<16 {
        transform(&values, forward)
        peak = values[0].magnitude
        transform(&values, inverse)
        for i in 0..<n {
            values[i] = values[i].divided(by: F64(n))
        }
    }
    var error = 0.0
    for i in 0..<n {
        error += (values[i] - signal[i]).magnitude
    }
    return "\(peak:.3f) \(error < 0.000001)"
}

@bench
fn measure(_ b: Bencher) {
    let n = 65536
    var signal: Complex<F64>[>..] = []
    var forward: Complex<F64>[>..] = []
    var inverse: Complex<F64>[>..] = []
    for i in 0..<n {
        signal.append(Complex(F64(i * 7919 % 1009) / 1009.0, F64(i * 104729 % 757) / 757.0))
    }
    for i in 0..<n / 2 {
        let root = Complex(magnitude: 1.0, phase: -2.0 * F64.pi * F64(i) / F64(n))
        forward.append(root)
        inverse.append(root.conjugate)
    }
    b.check(b.iterate { run(signal, forward, inverse) })
}
