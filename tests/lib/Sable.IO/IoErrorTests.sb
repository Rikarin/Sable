module IoErrorTests

// IoError (Sable.IO), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.IO

import Sable.IO
import Sable.Testing

fn isAnError<T>(_ value: T) -> Bool where T: Error {
    return true
}

fn failToRead(_ path: String) throws {
    throw IoError.NotFound(path: path)
}

@test
fn anIoErrorIsAnError() {
    assert(isAnError(IoError.NotFound(path: "a.txt")))
}

@test
fn aBareThrowsCarriesAnIoError() {
    var path = ""
    do {
        try failToRead("missing.txt")
    } catch let error as IoError {
        path = match error {
            case .NotFound(let p) => p
            default               => "another case"
        }
    } catch {
        path = "another error"
    }
    assertEqual(path, "missing.txt")
}

@test
fn eachIoErrorSaysWhatWentWrong() {
    assertEqual(IoError.NotFound(path: "a").description(), "nothing is at 'a'")
    assertEqual(IoError.Failed(path: "a").description(), "'a' could not be read, written or changed")
    assertEqual(IoError.Unreachable(address: "h:1").description(), "'h:1' could not be reached")
    assertEqual(IoError.Disconnected.description(), "the connection failed or was closed")
    assertEqual(IoError.Cancelled.description(), "the task was cancelled while it waited")
    assertEqual(IoError.PermissionDenied(path: "a").description(), "'a' may not be used so")
    assertEqual(IoError.AlreadyExists(path: "a").description(), "something is at 'a' already")
    assertEqual(IoError.IsDirectory(path: "a").description(), "'a' is a directory")
    assertEqual(IoError.Interrupted.description(), "the call was interrupted")
    assertEqual(IoError.UnexpectedEof.description(), "the stream ended before what was needed")
    assertEqual(IoError.InvalidInput(path: "a").description(), "'a' was given something the system does not take")
    assertEqual(IoError.DirectoryNotEmpty(path: "a").description(), "'a' is not empty")
    assertEqual(IoError.NotADirectory(path: "a").description(), "'a' is not a directory")
    assertEqual(IoError.CrossesFileSystems(path: "a").description(), "'a' is on another file system")
    assertEqual(IoError.Unsupported(path: "a").description(), "what was asked of 'a' is not to be had here")
    assertEqual(IoError.Os(path: "a", code: 5).description(), "'a' failed with the system's error 5")
}
