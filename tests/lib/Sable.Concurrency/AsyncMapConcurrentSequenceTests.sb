module AsyncMapConcurrentSequenceTests

// mapConcurrent(maxParallel:ordered:_:) and flatMapConcurrent(maxParallel:_:)
// (Sable.Concurrency), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Concurrency
//
// Each transform waits on a gate the test opens, and Task.settle() waits
// for what can go on, so how many run at once is the test's to see.

import ConcurrencySupport
import Sable.Concurrency
import Sable.Testing

// Transforms that each wait for their own oneshot, and count how many run.
@immutable
final class Gates {
    let opened: Mutex<[Int: Bool]>
    let changed: WaitList
    let running: Atomic<Int>
    let most: Atomic<Int>
    let started: Atomic<Int>

    init() {
        opened = Mutex([:])
        changed = WaitList()
        running = Atomic(0)
        most = Atomic(0)
        started = Atomic(0)
    }

    fn open(_ n: Int) {
        opened.withLock { $0[n] = true }
        changed.wakeAll()
    }

    fn pass(_ n: Int) async -> Int {
        started.add(1)
        let now = running.add(1) + 1
        _ = most.update { $0 > now ? $0 : now }
        while true {
            let ticket = changed.ticket
            if opened.withLock({ $0[n] ?? false }) {
                break
            }
            await changed.park(since: ticket)
        }
        running.add(-1)
        return n * 10
    }
}

@test
fn itTransformsEveryElementInOrder() async {
    let doubled = try! await (1...20).async.mapConcurrent(maxParallel: 4) { n in
        await Task.yield()
        return n * 2
    }.collect()
    expect(doubled == (1...20).map { $0 * 2 })
}

@test
fn noMoreThanTheLimitRunAtOnce() async {
    let gates = Gates()
    let seen = Mutex<Int[>..]>([])
    let done = Atomic(false)
    let mapped = (1...6).async.mapConcurrent(maxParallel: 2) { await gates.pass($0) }
    _ = Task.spawn {
        do {
            for try await value in mapped {
                seen.withLock { $0.append(value) }
            }
        } catch { }
        done.store(true)
    }
    await Task.settle()
    assertEqual(gates.started.load(), 2)
    // The second is done before the first: in order, it waits for it.
    gates.open(2)
    await Task.settle()
    expect(seen.withLock { $0 } == [])
    assertEqual(gates.started.load(), 2)
    gates.open(1)
    await Task.settle()
    expect(seen.withLock { $0 } == [10, 20])
    assertEqual(gates.started.load(), 4)
    for n in 3...6 {
        gates.open(n)
    }
    await Task.settle()
    expect(seen.withLock { $0 } == [10, 20, 30, 40, 50, 60] && done.load())
    expect(gates.most.load() <= 2)
}

@test
fn unorderedGivesEachAsItIsDone() async {
    let gates = Gates()
    let seen = Mutex<Int[>..]>([])
    let mapped = (1...3).async.mapConcurrent(maxParallel: 3, ordered: false) { await gates.pass($0) }
    _ = Task.spawn {
        do {
            for try await value in mapped {
                seen.withLock { $0.append(value) }
            }
        } catch { }
    }
    await Task.settle()
    gates.open(3)
    await Task.settle()
    expect(seen.withLock { $0 } == [30])
    gates.open(1)
    await Task.settle()
    gates.open(2)
    await Task.settle()
    expect(seen.withLock { $0 } == [30, 10, 20])
}

@test
fn whatTheTransformThrowsEndsItInItsPlace() async {
    var iterator = (1...5).async.mapConcurrent(maxParallel: 3) { (n: Int) throws -> Int in
        if n == 3 {
            throw Bad(n)
        }
        return n
    }.makeAsyncIterator()
    expect(try! await iterator.next() == 1)
    expect(try! await iterator.next() == 2)
    await expectThrows(Bad(3)) { _ = try await iterator.next() }
    expect(try! await iterator.next() == none)
}

@test
fn whatTheSequenceThrowsEndsItAfterTheElementsBefore() async {
    let input = ThrowingChannel<Int, Broken>()
    await input.send(1)
    await input.close(error: .Down)
    var iterator = input.mapConcurrent(maxParallel: 2) { $0 + 1 }.makeAsyncIterator()
    expect(try! await iterator.next() == 2)
    await expectThrows(Broken.Down) { _ = try await iterator.next() }
}

@test
fn anEmptySequenceMapsToNothing() async {
    let empty: Int[>..] = []
    expect(try! await empty.async.mapConcurrent(maxParallel: 2) { $0 }.collect() == [])
}

// ---- flatMapConcurrent ------------------------------------------------------

@test
fn flatMapConcurrentGivesEveryInnerElement() async {
    var all = try! await (1...4).async.flatMapConcurrent(maxParallel: 2) { n in
        [n, n * 100].async
    }.collect()
    all.sort()
    expect(all == [1, 2, 3, 4, 100, 200, 300, 400])
}

@test
fn flatMapConcurrentGoesThroughAtMostSoManyAtOnce() async {
    let channels = (0..<3).map { _ in Channel<Int>() }
    let started = Atomic(0)
    let seen = Mutex<Int[>..]>([])
    let flattened = (0..<3).async.flatMapConcurrent(maxParallel: 2) { (n: Int) -> Channel<Int> in
        started.add(1)
        return channels[n]
    }
    let consumer = Task.spawn {
        do {
            for try await value in flattened {
                seen.withLock { $0.append(value) }
            }
        } catch { }
    }
    await Task.settle()
    assertEqual(started.load(), 2)
    await channels[0].send(5)
    await channels[0].close()
    await Task.settle()
    assertEqual(started.load(), 3)
    expect(seen.withLock { $0 } == [5])
    await channels[1].close()
    await channels[2].close()
    await consumer.value
}

@test
fn flatMapConcurrentPassesAnInnerErrorOn() async {
    let failing = ThrowingChannel<Int, Broken>()
    await failing.close(error: .Down)
    var iterator = [1].async.flatMapConcurrent(maxParallel: 1) { _ in failing }.makeAsyncIterator()
    await expectThrows(Broken.Down) { _ = try await iterator.next() }
}
