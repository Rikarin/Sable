module EquatableTests

// Equatable, Comparable and Hashable (Sable.Core) and the primitives'
// conformances, tested with '@test' through generic code — which calls the
// conformances rather than the built-in operators: run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

fn same<T: Equatable>(_ a: T, _ b: T) -> Bool { return a == b }

fn before<T: Comparable>(_ a: T, _ b: T) -> Bool { return a < b }

fn hashOf<T: Hashable>(_ value: T) -> Int {
    var hasher = Hasher(seed: 99)
    hasher.combine(value)
    return hasher.finalize()
}

/// Two different values of a type: equal to themselves, ordered, and
/// hashed equal to an equal value and (for these) apart from each other.
fn expectToConform<T: Comparable & Hashable & Debug>(_ low: T, _ high: T, line: Int = #line) {
    let values = "\(T.self) \(low:?) and \(high:?)"
    expect(same(low, low), values, line: line)
    expect(!same(low, high), values, line: line)
    expect(before(low, high), values, line: line)
    expect(!before(high, low), values, line: line)
    expect(hashOf(low) == hashOf(low), values, line: line)
    expect(hashOf(low) != hashOf(high), values, line: line)
}

@test
fn signedIntegersConform() {
    expectToConform(-1, 1)
    expectToConform(I8(-1), I8(1))
    expectToConform(I16(-300), I16(300))
    expectToConform(I32(-70000), I32(70000))
    expectToConform(I64(-1), I64(5))
    expectToConform(I128(-1), I128(1) << 100)
}

@test
fn unsignedIntegersConform() {
    expectToConform(U8(1), U8(255))
    expectToConform(U16(1), U16(65535))
    expectToConform(U32(1), U32(4000000000))
    expectToConform(U64(1), U64(2))
    expectToConform(UInt(1), UInt(2))
    expectToConform(U128(1), U128(1) << 64)
}

@test
fn floatsConform() {
    expectToConform(F16(0.5), F16(1.5))
    expectToConform(F32(0.25), F32(2.5))
    expectToConform(-1.5, 1.5)
    assertEqual(hashOf(0.0), hashOf(-0.0))
}

@test
fn stringsConformByScalar() {
    expectToConform("abc", "abd")
    expectToConform("ab", "abc")
    expect(before("z", "é"), "UTF-8's byte order is the scalars' order")
}

@test
fn charactersConform() {
    expectToConform('a', 'b')
}

@test
fn booleansAreEquatableAndHashable() {
    expect(same(true, true))
    expect(!same(true, false))
    expect(hashOf(true) != hashOf(false))
}

@test
fn hashValueIsTheSameForEqualValues() {
    assertEqual(42.hashValue, 42.hashValue)
    assertEqual("text".hashValue, "te\("xt")".hashValue)
}
