module Sable.Core

/// A string being written where it will be: its UTF-8 bytes in memory of
/// their own, set by offset and then made the string, with no array between
/// and nothing copied. What the library makes text with where an array of
/// bytes, and the copy of it, were most of the cost: .NET's 'string.Create'.
///
/// Each write is checked against the room there is, so writing is safe.
/// 'allocate' and 'finish' are not: the bytes up to the count must have been
/// written, and be well-formed UTF-8; and the buffer, and every copy of it,
/// is done with when it is finished or grown. One that is never finished is
/// never freed.
///
/// ```sable
/// unsafe {
///     var buffer = StringBuffer.allocate(capacity: 8)
///     buffer.store(byte: 0x68, at: 0)
///     buffer.store(byte: 0x69, at: 1)
///     assert(buffer.finish(count: 2) == "hi")
/// }
/// ```
public struct StringBuffer {
    // Where the bytes start.
    let address: Int

    /// How many bytes there is room for.
    public let capacity: Int

    /// Room for 'capacity' bytes, none of them written yet.
    public unsafe static fn allocate(capacity: Int) -> StringBuffer {
        precondition(capacity >= 0, "a string of a negative number of bytes")
        return StringBuffer { address: StringBuffer.make(capacity), capacity: capacity }
    }

    /// The byte at an offset set.
    @inline(always)
    public fn store(byte: U8, at offset: Int) {
        if !(offset >= 0 && offset < capacity) {
            stringIndexOutOfRange()
        }
        unsafe {
            RawMemory.initialize(address + offset, byte)
        }
    }

    /// The eight bytes from an offset set, the number's lowest first; there
    /// must be room for all of them, though fewer may be what is wanted.
    @inline(always)
    public fn store(word: U64, at offset: Int) {
        if !(offset >= 0 && offset <= capacity - 8) {
            stringIndexOutOfRange()
        }
        unsafe {
            RawMemory.initializeUnaligned(address + offset, word)
        }
    }

    /// The byte at an offset, which must have been written.
    public unsafe fn load(at offset: Int) -> U8 {
        if !(offset >= 0 && offset < capacity) {
            stringIndexOutOfRange()
        }
        return RawMemory.load(address + offset)
    }

    /// A text's bytes from one offset up to another copied in from an offset.
    public fn store(utf8 text: String, from start: Int, to end: Int, at offset: Int) {
        if !(start >= 0 && start <= end && end <= text.utf8Count && offset >= 0 && offset <= capacity - (end - start)) {
            stringIndexOutOfRange()
        }
        StringBuffer.copy(address + offset, text, start, end - start)
    }

    /// A buffer with room for at least 'capacity' bytes, its first 'used'
    /// the buffer's own, which is then done with.
    public unsafe fn growing(used: Int, capacity wanted: Int) -> StringBuffer {
        if !(used >= 0 && used <= capacity && wanted >= used) {
            stringIndexOutOfRange()
        }
        // Half as much again at least, so that growing a little at a time
        // copies each byte a bounded number of times.
        let half = capacity + capacity / 2
        let larger = wanted > half ? wanted : half
        return StringBuffer { address: StringBuffer.grow(address, used, larger), capacity: larger }
    }

    /// The first 'count' bytes as a string: the buffer is done with.
    public unsafe fn finish(count: Int) -> String {
        if !(count >= 0 && count <= capacity) {
            stringIndexOutOfRange()
        }
        return StringBuffer.take(address, count, -1)
    }

    /// The same of bytes that are all ASCII, which are then not counted.
    public unsafe fn finish(asciiCount count: Int) -> String {
        if !(count >= 0 && count <= capacity) {
            stringIndexOutOfRange()
        }
        return StringBuffer.take(address, count, count)
    }

    /// As many whole blocks of the bytes as the processor has instructions
    /// for put through the codec and written from an offset: how many bytes
    /// that was, which may be none (Codec).
    public fn encode(_ codec: Codec, _ bytes: U8[:], at offset: Int) -> Int {
        if !(offset >= 0 && offset <= capacity) {
            stringIndexOutOfRange()
        }
        return StringBuffer.run(codec as Int, bytes, address + offset, capacity - offset)
    }

    /// The first 'count' bytes as a string, if they are well-formed UTF-8, or
    /// none: the buffer is done with either way.
    public unsafe fn finishIfValid(count: Int) -> String? {
        if !(count >= 0 && count <= capacity) {
            stringIndexOutOfRange()
        }
        if !StringBuffer.isValid(address, count) {
            self.discard()
            return none
        }
        return StringBuffer.take(address, count, -1)
    }

    /// The room given back, nothing made of it: the buffer is done with.
    public unsafe fn discard() {
        let _ = StringBuffer.take(address, 0, 0)
    }

    @builtin("string_buffer_make")
    static fn make(_ capacity: Int) -> Int

    @builtin("string_buffer_grow")
    static fn grow(_ address: Int, _ used: Int, _ capacity: Int) -> Int

    @builtin("string_buffer_copy")
    static fn copy(_ address: Int, _ text: String, _ from: Int, _ count: Int)

    @builtin("string_buffer_valid")
    static fn isValid(_ address: Int, _ count: Int) -> Bool

    @builtin("codec_bytes_raw")
    static fn run(_ codec: Int, _ bytes: U8[:], _ address: Int, _ room: Int) -> Int

    @builtin("string_buffer_take")
    static fn take(_ address: Int, _ count: Int, _ scalars: Int) -> String
}

// Out of line, so that a check is a comparison and a branch never taken.
@inline(never)
fn stringIndexOutOfRange() -> Never {
    fatalError("string index out of range")
}
