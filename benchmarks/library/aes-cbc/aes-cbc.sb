module AesCbcBench

import Sable.Crypto
import Sable.Testing

// AES-256-CBC of 64 bytes and of 64 KiB, enciphered, with its padding,
// and deciphered again, each into a new array. What it comes to is the sum of
// the ciphertexts' first bytes.

fn run(_ cipher: Hazmat.AesCbc, _ size: Int, _ rounds: Int) -> String {
    var text = U8[>..](repeating: 1, count: size)
    var iv = U8[>..](repeating: 0, count: 16)
    var total = 0
    for i in 0..<rounds {
        iv.writeU64(U64(i), at: 0, endian: .Little)
        let ciphertext = try! cipher.encrypt(text, iv: iv)
        total += Int(ciphertext[0])
        text = try! cipher.decrypt(ciphertext, iv: iv)
    }
    return "\(total + Int(text[size - 1]))"
}

@bench(arguments: [(64, 100_000), (65536, 200)])
fn measure(_ b: Bencher, _ size: Int, _ rounds: Int) {
    let cipher = try! Hazmat.AesCbc(key: SymmetricKey(U8[>..](repeating: 7, count: 32)))
    b.bytesPerIteration = size * rounds
    b.check(b.iterate { run(cipher, size, rounds) })
}
