module Sable.Serialize

/// Serializable values to CBOR (RFC 8949) and back, as ciborium does: a
/// struct or a map a map, a case that carries nothing its name and one that
/// does a map of one entry, as JSON has them. For values of no declared
/// type, CborValue; item by item, CborEncoder and CborReader.
///
/// ```sable
/// let numbers: Int[>..] = [1, 2, 300]
/// let bytes = try! Cbor.encode(numbers)
/// assert(bytes == [0x83, 0x01, 0x02, 0x19, 0x01, 0x2C])
/// assert(try! Cbor.decode(Int[>..].self, from: bytes) == numbers)
/// ```
public struct Cbor {
    /// The value as CBOR: by `.Deterministic`, in the one encoding RFC 8949
    /// §4.2.1 has of it.
    public static fn encode<T: Serializable>(_ value: T, conformance: CborConformance = .Lax) throws(SerializeError) -> U8[>..] {
        let encoder = CborEncoder(conformance: conformance)
        try value.encode(to: encoder)
        return try encoder.bytes()
    }

    /// The value of the type the CBOR holds, which nests arrays, maps and
    /// tags no deeper than that, and is what `conformance` takes.
    public static fn decode<T: Serializable>(
        _ type: T.Type,
        from bytes: U8[>..],
        maximumDepth: Int = 128,
        conformance: CborConformance = .Lax
    ) throws(SerializeError) -> T {
        return try T.decode(from: try CborDecoder.parse(bytes, maximumDepth: maximumDepth, conformance: conformance))
    }
}
