module Sable.Core

// The array family's members (docs/03, SYNTAX.md §11). An array extension
// declares its parameters after the keyword, since an array has no name to
// write them after, and is for every array of its kind whatever the element:
// 'Element[>..]' every grow-only array, 'Element[..]' every inline capacity.
// What 'Element[:]' declares, every kind has, as every array can be viewed
// as a slice; a 'mutating' member of it changes the array it is called on,
// in place. What only the runtime can do is a '@builtin', applied where it
// is called; the rest is Sable over those, monomorphised per element.
//
// This file has what every array is and holds; the rest is by feature:
// Array+Search.sb (finding elements), Array+Reorder.sb (moving them in
// place), Array+Sort.sb and Array+Split.sb. A grow-only array grows at its
// end and nowhere else (docs/03 §3.9): inserting and removing in the middle
// are List's (Sable.Collections).

extension<Element> Element[:] {
    /// How many elements the array holds.
    @builtin("array_count")
    public var count: Int { get }

    /// Whether the array holds no elements.
    public var isEmpty: Bool => self.count == 0

    /// The elements from 'from' up to, not including, 'to': a view of them,
    /// sharing the array's buffer, with no copy.
    @builtin("array_slice")
    public fn slice(from: Int, to: Int) -> Element[:]

    /// The elements in a grow-only array of their own. A value like any
    /// other copy: it shares the buffer while neither changes, so taking
    /// the whole of an array copies nothing; a slice of part of one is
    /// copied out.
    ///
    /// ```sable
    /// let xs: Int[>..] = [1, 2, 3, 4]
    /// var tail = xs[2...].toArray()
    /// tail.append(5)
    /// assert(tail == [3, 4, 5])
    /// ```
    @builtin("array_of_slice")
    public fn toArray() -> Element[>..]
}

extension<Element: Equatable> Element[:] {
    /// Whether an element equal to this one is in the array.
    public fn contains(element: Element) -> Bool {
        for candidate in self {
            if candidate == element {
                return true
            }
        }
        return false
    }
}

extension<Element> Element[>..] {
    /// The element, added at the end.
    @builtin("array_append")
    public mutating fn append(element: Element)

    /// How many elements the array has room for before an append must
    /// grow its buffer: never less than the count.
    @builtin("array_capacity")
    public var capacity: Int { get }

    /// Room for at least 'minimumCapacity' elements in all, so that
    /// appending up to that many grows nothing; asking for less than the
    /// array has room for changes nothing.
    ///
    /// ```sable
    /// var xs: Int[>..] = []
    /// xs.reserveCapacity(100)
    /// assert(xs.capacity >= 100)
    /// ```
    @builtin("array_reserve")
    public mutating fn reserveCapacity(_ minimumCapacity: Int)

    /// Every element of 'other', added at the end in order.
    ///
    /// ```sable
    /// var xs: Int[>..] = [1]
    /// xs.append(contentsOf: [2, 3])
    /// assert(xs == [1, 2, 3])
    /// ```
    public mutating fn append(contentsOf other: Element[:]) {
        for element in other {
            self.append(element)
        }
    }

    /// The last element, taken out; an empty array traps.
    @builtin("array_remove_last")
    public mutating fn removeLast() -> Element

    /// Every element, taken out.
    @builtin("array_clear")
    public mutating fn clear()

    /// Every element taken out, as 'clear()' does; with 'keepingCapacity',
    /// the buffer is kept, so the array fills again without growing.
    ///
    /// ```sable
    /// var xs: U8[>..] = []
    /// xs.reserveCapacity(64)
    /// xs.append(1)
    /// xs.removeAll(keepingCapacity: true)
    /// assert(xs.isEmpty && xs.capacity >= 64)
    /// ```
    public mutating fn removeAll(keepingCapacity: Bool = false) {
        if keepingCapacity {
            self.truncate(0)
        } else {
            self.clear()
        }
    }

    /// The last 'count' elements taken out, the buffer kept; more than the
    /// array has traps.
    ///
    /// ```sable
    /// var xs: Int[>..] = [1, 2, 3, 4]
    /// xs.removeLast(2)
    /// assert(xs == [1, 2])
    /// ```
    public mutating fn removeLast(_ count: Int) {
        precondition(count >= 0 && count <= self.count, "cannot remove \(count) of \(self.count) elements")
        self.truncate(self.count - count)
    }

    // The first 'count' elements kept, the rest destroyed, the buffer kept.
    @builtin("array_truncate")
    mutating fn truncate(_ count: Int)
}

extension<Element> Element[>..<] {
    /// The element, added at the end.
    @builtin("array_append")
    public mutating fn append(element: Element)

    /// How many elements the array has room for before an append must
    /// grow its buffer: never less than the count.
    @builtin("array_capacity")
    public var capacity: Int { get }

    /// Room for at least 'minimumCapacity' elements in all, so that
    /// appending up to that many grows nothing.
    @builtin("array_reserve")
    public mutating fn reserveCapacity(_ minimumCapacity: Int)

    /// Every element of 'other', added at the end in order.
    public mutating fn append(contentsOf other: Element[:]) {
        for element in other {
            self.append(element)
        }
    }

    /// The last element, taken out; an empty array traps.
    @builtin("array_remove_last")
    public mutating fn removeLast() -> Element

    /// Every element, taken out.
    @builtin("array_clear")
    public mutating fn clear()

    /// Every element taken out, as 'clear()' does; with 'keepingCapacity',
    /// the buffer is kept, so the array fills again without growing.
    ///
    /// ```sable
    /// var xs: U8[>..] = []
    /// xs.reserveCapacity(64)
    /// xs.append(1)
    /// xs.removeAll(keepingCapacity: true)
    /// assert(xs.isEmpty && xs.capacity >= 64)
    /// ```
    public mutating fn removeAll(keepingCapacity: Bool = false) {
        if keepingCapacity {
            self.truncate(0)
        } else {
            self.clear()
        }
    }

    /// The last 'count' elements taken out, the buffer kept; more than the
    /// array has traps.
    ///
    /// ```sable
    /// var xs: Int[>..] = [1, 2, 3, 4]
    /// xs.removeLast(2)
    /// assert(xs == [1, 2])
    /// ```
    public mutating fn removeLast(_ count: Int) {
        precondition(count >= 0 && count <= self.count, "cannot remove \(count) of \(self.count) elements")
        self.truncate(self.count - count)
    }

    // The first 'count' elements kept, the rest destroyed, the buffer kept.
    @builtin("array_truncate")
    mutating fn truncate(_ count: Int)
}

// An inline array grows within its capacity. Its members are lowered where
// its inline layout is.
extension<Element> Element[..] {
    /// The element, added at the end; past the capacity traps.
    @builtin("array_append")
    public mutating fn append(element: Element)

    /// The last element, taken out; an empty array traps.
    @builtin("array_remove_last")
    public mutating fn removeLast() -> Element

    /// Every element, taken out.
    @builtin("array_clear")
    public mutating fn clear()
}

extension U8[:] {
    /// The bytes read as UTF-8 text. A byte that cannot begin a scalar, or a
    /// sequence cut short, reads as U+FFFD.
    public fn toString() -> String {
        var scalars: String[>..] = []
        var i = 0
        while i < self.count {
            let lead = Int(self[i])
            var length = 1
            var value = 0xFFFD
            if lead < 0x80 {
                value = lead
            } else if lead >= 0xC2 && lead < 0xE0 {
                length = 2
                value = lead & 0x1F
            } else if lead >= 0xE0 && lead < 0xF0 {
                length = 3
                value = lead & 0x0F
            } else if lead >= 0xF0 && lead < 0xF5 {
                length = 4
                value = lead & 0x07
            }

            var next = 1
            while next < length {
                if i + next >= self.count || (Int(self[i + next]) & 0xC0) != 0x80 {
                    length = next
                    value = 0xFFFD
                    break
                }
                value = (value << 6) | (Int(self[i + next]) & 0x3F)
                next = next + 1
            }

            let scalar = Char.fromCodePoint(value) ?? Char.fromCodePoint(0xFFFD)!
            scalars.append(String.fromChar(scalar))
            i = i + length
        }
        return Runtime.joinStrings(scalars, "")
    }
}
