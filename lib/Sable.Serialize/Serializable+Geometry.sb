extension BoundingFrustum: Serializable {
    /// A struct of `near`, `far`, `left`, `right`, `top`, `bottom`.
    public fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
        try encoder.beginStruct("BoundingFrustum", count: 6)
        try encoder.encodeField("near")
        try near.encode(to: encoder)
        try encoder.encodeField("far")
        try far.encode(to: encoder)
        try encoder.encodeField("left")
        try left.encode(to: encoder)
        try encoder.encodeField("right")
        try right.encode(to: encoder)
        try encoder.encodeField("top")
        try top.encode(to: encoder)
        try encoder.encodeField("bottom")
        try bottom.encode(to: encoder)
        try encoder.endStruct()
    }
    public static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> BoundingFrustum {
        try decoder.beginStruct("BoundingFrustum")
        var value = BoundingFrustum(Matrix4x4.identity)
        value.near = try Plane.decode(from: decoder.field("near"))
        value.far = try Plane.decode(from: decoder.field("far"))
        value.left = try Plane.decode(from: decoder.field("left"))
        value.right = try Plane.decode(from: decoder.field("right"))
        value.top = try Plane.decode(from: decoder.field("top"))
        value.bottom = try Plane.decode(from: decoder.field("bottom"))
        return value
    }
}
