module Sable.Core

/// A random number generator whose sequence its seed fixes: the same seed
/// gives the same numbers in every run, on every machine — for tests,
/// simulations and procedural content that must repeat. It is
/// xoshiro256** (Blackman and Vigna), its 256 bits of state filled from
/// the seed by SplitMix64: fast, and statistically strong, but not for
/// secrets — one who sees its output can predict the rest. For those, and
/// for anything that should differ from run to run, use
/// SystemRandomNumberGenerator.
///
/// ```sable
/// var a = SeededRandomNumberGenerator(seed: 2024)
/// var b = SeededRandomNumberGenerator(seed: 2024)
/// assert(a.next() == b.next())
/// let die = Int.random(in: 1...6, using: &a)
/// assert(die == Int.random(in: 1...6, using: &b))
/// ```
public struct SeededRandomNumberGenerator: RandomNumberGenerator {
    var s0: U64
    var s1: U64
    var s2: U64
    var s3: U64

    /// A generator whose sequence is the seed's.
    public init(seed: U64) {
        var mixer = SplitMix64(seed: seed)
        s0 = mixer.next()
        s1 = mixer.next()
        s2 = mixer.next()
        s3 = mixer.next()
    }

    /// A generator in the state whose four words are given, as the reference
    /// implementation holds it. All four zero is the one state
    /// xoshiro256** never leaves, and traps.
    ///
    /// ```sable
    /// var generator = SeededRandomNumberGenerator(state: [1, 2, 3, 4])
    /// assert(generator.next() == 11520)
    /// ```
    public init(state: U64[4]) {
        precondition((state[0] | state[1] | state[2] | state[3]) != 0, "the state must not be all zeros")
        s0 = state[0]
        s1 = state[1]
        s2 = state[2]
        s3 = state[3]
    }

    /// The next 64 bits of the sequence.
    public mutating fn next() -> U64 {
        let result = s1.wrappingMul(5).rotatedLeft(by: 7).wrappingMul(9)
        let shifted = s1 << 17
        s2 = s2 ^ s0
        s3 = s3 ^ s1
        s1 = s1 ^ s2
        s0 = s0 ^ s3
        s2 = s2 ^ shifted
        s3 = s3.rotatedLeft(by: 45)
        return result
    }

    /// Moves on 2^128 draws: a copy made before, and the generator after,
    /// are two sequences that do not meet, and so are those of as many as
    /// 2^128 tasks, each jumped once more than the one before.
    ///
    /// ```sable
    /// var generator = SeededRandomNumberGenerator(seed: 7)
    /// var first = generator
    /// generator.jump()
    /// assert(first.next() != generator.next())
    /// ```
    public mutating fn jump() {
        self.jump(by: [0x180EC6D33CFD0ABA, 0xD5A61266F0C9392C, 0xA9582618E03FC9AA, 0x39ABDC4529B1661C])
    }

    /// Moves on 2^192 draws, 2^64 jumps: for a machine's own start, each of
    /// whose tasks then jumps from there.
    public mutating fn longJump() {
        self.jump(by: [0x76E15D3EFEFDCBBF, 0xC5004E441C522FB3, 0x77710069854EE241, 0x39109BB02ACBE635])
    }

    // Moves on by the draws whose power of the step's matrix, as a
    // polynomial in it over GF(2), has these coefficients.
    mutating fn jump(by polynomial: U64[4]) {
        var t0: U64 = 0
        var t1: U64 = 0
        var t2: U64 = 0
        var t3: U64 = 0
        for word in polynomial {
            var bit: U64 = 0
            while bit < 64 {
                if ((word >> bit) & 1) == 1 {
                    t0 = t0 ^ s0
                    t1 = t1 ^ s1
                    t2 = t2 ^ s2
                    t3 = t3 ^ s3
                }
                _ = next()
                bit += 1
            }
        }
        s0 = t0
        s1 = t1
        s2 = t2
        s3 = t3
    }
}
