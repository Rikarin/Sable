module HashMapTests

// HashMap (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn aHashMapIsGoneThroughInTheOrderItsKeysWereSet() {
    let map = HashMap<String, Int>()
    map.set("b", 2)
    map.set("a", 1)
    map.set("c", 3)
    let _ = map.remove("a")
    map.set("b", 20)
    var seen: String[>..] = []
    for (key, value) in map {
        seen.append("\(key)=\(value)")
    }
    assertEqualText(seen.joined(separator: ","), "b=20,c=3")
    assertEqual(HashMap<String, Int>().toArray().count, 0)
}

@test
fn hashMapSetsGetsAndRemoves() {
    let map = HashMap<String, Int>()
    var i = 0
    while i < 100 {
        map.set("key\(i)", i * i)
        i = i + 1
    }
    assertEqual(map.get("key7") ?? -1, 49)
    assertEqual(map.get("key99") ?? -1, 9801)
    assert(map.contains("key0"))
    assert(map.remove("key0"))
    assert(!map.contains("key0"), "a removed key is gone")
    assert(!map.remove("key0"), "a key is removed once")
    assertEqual(map.allKeys().count, 99)
}

@bench
fn hashMapInserts(_ b: Bencher) {
    b.iterate(() => {
        let map = HashMap<Int, Int>()
        var i = 0
        while i < 64 {
            map.set(i, i)
            i = i + 1
        }
    })
}
