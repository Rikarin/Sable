module CancellationTests

// Cancellation, timeouts and waiting on several things (Sable.Concurrency):
// cancellation carried to children and grandchildren, timeouts that stop
// their body, tokens and their handlers, promises, continuations — a
// leaked one caught in a debug build — races, and whenAll/Any/Each.

import Sable.Concurrency
import Sable.Time
import Sable.Testing

/// Sleeps far longer than any test runs, and says whether it was cancelled.
fn sleepsUntilCancelled() async -> Bool {
    do {
        try await Task.sleep(for: Duration.seconds(60))
        return false
    } catch {
        return true
    }
}

// ---- Propagation ---------------------------------------------------------------

@test
fn cancellingAGroupReachesItsGrandchildren() async {
    let reached = Atomic<Int>(0)
    await withTaskGroup(of: Void.self) { group in
        var i = 0
        while i < 3 {
            group.spawn {
                // A child with a group of its own: its children are cancelled too.
                await withTaskGroup(of: Void.self) { inner in
                    inner.spawn {
                        if await sleepsUntilCancelled() {
                            _ = reached.update { $0 + 1 }
                        }
                    }
                }
            }
            i += 1
        }
        await Task.yield()
        group.cancelAll()
    }
    assertEqual(reached.load(), 3)
}

@test
fn aTimeoutCancelsTheBodysChildren() async {
    let stopped = Atomic<Bool>(false)
    _ = try? await withTimeout(Duration.milliseconds(20)) {
        await withTaskGroup(of: Void.self) { group in
            group.spawn {
                if await sleepsUntilCancelled() {
                    stopped.store(true)
                }
            }
        }
    }
    expect(stopped.load())
}

// ---- Timeouts ------------------------------------------------------------------

@test
fn aBodyInTimeGivesItsValue() async throws {
    let value = try await withTimeout(Duration.seconds(30)) { 6 * 7 }
    assertEqual(value, 42)
    let later = try await withTimeout(Duration.seconds(30)) {
        try await Task.sleep(for: Duration.milliseconds(1))
        return "slept"
    }
    assertEqual(later, "slept")
}

@test
fn aBodyTooSlowTimesOutPromptly() async {
    let started = Instant.now()
    let error = await expectThrows(TimeoutError.self) {
        _ = try await withTimeout(Duration.milliseconds(20)) {
            try await Task.sleep(for: Duration.seconds(60))
            return 1
        }
    }
    expect(error?.duration == Duration.milliseconds(20))
    expect(error?.description() == "timed out after \(Duration.milliseconds(20).toString())")
    // Promptly: the body's sleep ends at its cancellation, not its minute.
    expect(started.elapsed.totalMilliseconds < 10_000)
}

struct Broken: Error {
    fn description() -> String {
        return "broken"
    }
}

@test
fn aBodysOwnErrorPassesThrough() async {
    await expectThrows(saying: "broken") {
        _ = try await withTimeout(Duration.seconds(30)) { () throws -> Int in
            throw Broken()
        }
    }
}

@test
fn timeoutsNest() async {
    let error = await expectThrows(TimeoutError.self) {
        _ = try await withTimeout(Duration.seconds(30)) {
            try await withTimeout(Duration.milliseconds(10)) {
                try await Task.sleep(for: Duration.seconds(60))
                return 0
            }
        }
    }
    expect(error?.duration == Duration.milliseconds(10))
}

@test
fn aCancelledTasksTimeoutThrowsCancellation() async {
    let task = Task.spawn { () -> String in
        do {
            _ = try await withTimeout(Duration.seconds(30)) {
                try await Task.sleep(for: Duration.seconds(60))
                return 0
            }
            return "finished"
        } catch let error as TimeoutError {
            return "timed out"
        } catch {
            return "cancelled"
        }
    }
    await Task.yield()
    task.cancel()
    assertEqual(await task.value, "cancelled")
}

// ---- Tokens --------------------------------------------------------------------

@test
fn handlersRunOnceInOrderAndLateOnesAtOnce() {
    let source = CancellationTokenSource()
    let token = source.token
    let log = Mutex<String>("")
    _ = token.register { log.withLock { $0 += "a" } }
    let undone = token.register { log.withLock { $0 += "x" } }
    _ = token.register { log.withLock { $0 += "b" } }
    expect(undone.unregister())
    expect(!undone.unregister())
    expect(!token.isCancellationRequested && !source.isCancellationRequested)
    source.cancel()
    source.cancel()
    expect(token.isCancellationRequested)
    assertEqual(log.withLock { $0 }, "ab")
    _ = token.register { log.withLock { $0 += "c" } }
    assertEqual(log.withLock { $0 }, "abc")
    expectThrows { try token.throwIfCancellationRequested() }
}

@test
fn theNeverTokenNeverIs() {
    let never = CancellationToken.never
    expect(!never.canBeCancelled && !never.isCancellationRequested)
    expect(CancellationTokenSource().token.canBeCancelled)
    let registration = never.register { fail("ran") }
    expect(!registration.unregister())
    expectNoThrow { try never.throwIfCancellationRequested() }
}

@test
fn linkedSourcesFollowAnyOfTheirs() {
    let a = CancellationTokenSource()
    let b = CancellationTokenSource()
    let linked = CancellationTokenSource.linked([a.token, b.token])
    expect(!linked.isCancellationRequested)
    b.cancel()
    expect(linked.isCancellationRequested && !a.isCancellationRequested)
    let own = CancellationTokenSource.linked([CancellationTokenSource().token])
    own.cancel()
    expect(own.isCancellationRequested)
}

@test
fn aSourceCancelsAfterADelay() async {
    let source = CancellationTokenSource()
    source.cancel(after: Duration.milliseconds(10))
    expect(await source.token.cancellationRequested())
    let now = CancellationTokenSource()
    now.cancel(after: Duration.milliseconds(0))
    expect(now.isCancellationRequested)
}

@test
fn aTokenStopsStructuredWork() async {
    let source = CancellationTokenSource()
    source.cancel(after: Duration.milliseconds(10))
    await expectThrows(CancellationError.self) {
        _ = try await withCancellation(source.token) {
            try await Task.sleep(for: Duration.seconds(60))
            return 1
        }
    }
}

@test
fn aBodyThatFinishesBeforeItsTokenGivesItsValue() async throws {
    assertEqual(try await withCancellation(CancellationTokenSource().token) { 7 }, 7)
}

@test
fn waitingForATokenEndsWithTheTask() async {
    let task = Task.spawn { await CancellationToken.never.cancellationRequested() }
    await Task.yield()
    task.cancel()
    expect(!(await task.value))
}

// ---- Promises and continuations ------------------------------------------------

@test
fn aPromiseCompletesOnceForEveryWaiter() async {
    let promise = Promise<String, Never>()
    expect(!promise.isCompleted)
    let first = Task.spawn { await promise.value() }
    let second = Task.spawn { await promise.value() }
    await Task.yield()
    expect(promise.succeed("done"))
    expect(promise.isCompleted)
    expect(!promise.succeed("again"))
    assertEqual(await first.value, "done")
    assertEqual(await second.value, "done")
    // A waiter after the completion has it at once.
    assertEqual(await promise.value(), "done")
}

@test
fn aPromiseCarriesAnError() async {
    let promise = Promise<Int, Broken>()
    expect(promise.fail(Broken()))
    expect(!promise.complete(with: .Ok(1)))
    await expectThrows(saying: "broken") { _ = try await promise.value() }
}

@test
fn aContinuationIsResumedFromElsewhere() async {
    let value = await withContinuation(returning: Int.self) { continuation in
        _ = Task.detached {
            try? await Task.sleep(for: Duration.milliseconds(5))
            continuation.resume(returning: 42)
        }
    }
    assertEqual(value, 42)
    await expectThrows(saying: "broken") {
        _ = try await withContinuation(returning: Int.self, throwing: Broken.self) { continuation in
            continuation.resume(throwing: Broken())
        }
    }
    let given = await withContinuation(returning: String.self) { continuation in
        continuation.resume(with: .Ok("outcome"))
    }
    assertEqual(given, "outcome")
}

@test(traps: "a continuation resumed twice")
fn resumingTwiceTraps() async {
    _ = await withContinuation(returning: Int.self) { continuation in
        continuation.resume(returning: 1)
        continuation.resume(returning: 2)
    }
}

@test(traps: "a continuation was let go without being resumed: its task would wait for ever")
fn aLeakedContinuationTrapsInADebugBuild() async {
    _ = await withContinuation(returning: Int.self) { continuation in
    }
}

// ---- Races and waiting on tasks ------------------------------------------------

@test
fn theFirstToFinishWinsAndTheRestAreCancelled() async throws {
    let loserStopped = Atomic<Bool>(false)
    let winner = try await race({ "fast" }, {
        if await sleepsUntilCancelled() {
            loserStopped.store(true)
        }
        return "slow"
    })
    assertEqual(winner, "fast")
    expect(loserStopped.load())
    let three = try await race({
        try await Task.sleep(for: Duration.seconds(60))
        return 1
    }, { 2 }, {
        try await Task.sleep(for: Duration.seconds(60))
        return 3
    })
    assertEqual(three, 2)
}

@test
fn anErrorFirstIsTheRaces() async {
    await expectThrows(Broken.self) {
        _ = try await race({ () throws -> Int in
            throw Broken()
        }, {
            try await Task.sleep(for: Duration.seconds(60))
            return 0
        })
    }
}

@test
fn tasksAreWaitedForAllAnyOrEach() async {
    let slow = Task.spawn { () -> Int in
        try? await Task.sleep(for: Duration.milliseconds(30))
        return 1
    }
    let fast = Task.spawn { 2 }
    let middle = Task.spawn { () -> Int in
        try? await Task.sleep(for: Duration.milliseconds(10))
        return 3
    }
    let firstDone = await whenAny([slow, fast, middle])
    assertEqual(firstDone.index, 1)
    assertEqual(firstDone.value, 2)
    var order: Int[>..] = []
    var indices: Int[>..] = []
    for await done in whenEach([slow, fast, middle]) {
        order.append(done.value)
        indices.append(done.index)
    }
    assertEqual(order, [2, 3, 1])
    assertEqual(indices, [1, 2, 0])
    assertEqual(await whenAll([slow, fast, middle]), [1, 2, 3])
    let noTasks: Task<Int>[>..] = []
    var count = 0
    for await _ in whenEach(noTasks) {
        count += 1
    }
    assertEqual(count, 0)
}
