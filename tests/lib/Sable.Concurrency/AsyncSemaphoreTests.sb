module AsyncSemaphoreTests

// AsyncSemaphore (Sable.Concurrency): a wait that suspends a task rather than block its thread.

import Sable.Concurrency
import Sable.Testing

@test
fn anAsyncSemaphoreLetsSoManyTasksIn() async {
    let slots = AsyncSemaphore(permits: 3)
    let inside = Atomic<Int>(0)
    let most = Atomic<Int>(0)
    await withTaskGroup(of: Int.self) { group in
        var task = 0
        while task < 40 {
            group.spawn {
                await slots.acquire()
                most.max(inside.add(1) + 1)
                await Task.yield()
                inside.subtract(1)
                await slots.release()
                return 0
            }
            task += 1
        }
        await group.waitForAll()
    }
    expect(most.load() <= 3 && most.load() >= 1)
    assertEqual(await slots.availablePermits, 3)
    expect(await slots.tryAcquire())
}

@test
fn permitsComeAndGoAmongManyTasks() async {
    let semaphore = AsyncSemaphore(permits: 3)
    let inside = Atomic<Int>(0)
    let over = Atomic<Int>(0)
    await withTaskGroup(of: Void.self) { group in
        for t in 0..<12 {
            group.spawn {
                for i in 0..<400 {
                    if t % 3 == 0 && semaphore.tryAcquire() { } else {
                        await semaphore.acquire()
                    }
                    if inside.add(1) >= 3 {
                        over.add(1)
                    }
                    if i % 7 == t % 7 {
                        await Task.yield()
                    }
                    inside.add(-1)
                    semaphore.release()
                }
            }
        }
    }
    assertEqual(over.load(), 0)
    assertEqual(semaphore.availablePermits, 3)
}

@test
fn severalPermitsReleasedGoToThoseWaitingFirst() async {
    let semaphore = AsyncSemaphore(permits: 0)
    let woken = Atomic<Int>(0)
    var tasks: Task<Void>[>..] = []
    for _ in 0..<3 {
        tasks.append(
            Task.spawn {
                await semaphore.acquire()
                woken.add(1)
            })
    }
    await Task.settle()
    assertEqual(semaphore.availablePermits, 0)
    semaphore.release(count: 2)
    expect(!semaphore.tryAcquire())
    await Task.settle()
    assertEqual(woken.load(), 2)
    semaphore.release(count: 3)
    for task in tasks {
        await task.value
    }
    assertEqual(semaphore.availablePermits, 2)
}
