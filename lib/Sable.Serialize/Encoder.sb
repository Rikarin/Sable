module Sable.Serialize

/// Where a Serializable value writes itself, in a data model every format
/// shares — serde's: null (an optional's none), a Bool, an integer, a
/// float, a string, bytes; a sequence of values; a map of String keys to
/// values; a struct of named fields; and a union's case, by name, with or
/// without a payload. An encoder writes them in its own format as they
/// come: JsonEncoder writes JSON. A conformance, derived or written by
/// hand, calls these and nothing of the format's, so it serves any format.
///
/// A sequence, map or struct is begun, its contents encoded, and ended: a
/// map's entries each a key then a value, a struct's fields each a field's
/// key then its value. A case with a payload is begun with its name, its
/// payload encoded, and ended.
///
/// ```sable
/// struct Tags: Serializable {
///     var names: String[>..]
///     fn encode<E: Encoder>(to encoder: E) throws(SerializeError) {
///         try encoder.beginSequence(count: names.count)
///         for name in names {
///             try encoder.encodeString(name)
///         }
///         try encoder.endSequence()
///     }
///     static fn decode<D: Decoder>(from decoder: D) throws(SerializeError) -> Tags {
///         var names: String[>..] = []
///         for element in try decoder.decodeSequence() {
///             names.append(try element.decodeString())
///         }
///         return Tags { names: names }
///     }
/// }
/// assert(try! Json.encode(Tags { names: ["a", "b"] }) == "[\"a\",\"b\"]")
/// ```
public protocol Encoder {
    /// Null: an optional's none, or an untagged union's case that carries nothing.
    fn encodeNull() throws(SerializeError)
    fn encodeBool(_ value: Bool) throws(SerializeError)
    fn encodeInt(_ value: Int) throws(SerializeError)
    fn encodeUInt(_ value: U64) throws(SerializeError)
    fn encodeFloat(_ value: F64) throws(SerializeError)
    fn encodeString(_ value: String) throws(SerializeError)
    fn encodeBytes(_ value: U8[>..]) throws(SerializeError)

    /// A sequence of that many values — none, when that is not known before
    /// they are written — encoded next, then `endSequence()`.
    fn beginSequence(count: Int?) throws(SerializeError)
    fn endSequence() throws(SerializeError)

    /// A map of that many entries, each `encodeKey` and a value, then `endMap()`.
    fn beginMap(count: Int?) throws(SerializeError)
    fn encodeKey(_ key: String) throws(SerializeError)
    fn endMap() throws(SerializeError)

    /// A struct of the type named, of that many fields, each `encodeField`
    /// and its value, then `endStruct()`.
    fn beginStruct(_ name: String, count: Int?) throws(SerializeError)
    fn encodeField(_ key: String) throws(SerializeError)
    fn endStruct() throws(SerializeError)

    /// Where a field or an entry would be: the struct or map encoded next
    /// is written into the one open, its members among that one's own, and
    /// has no beginning or end of its own. Anything else next is an error.
    fn flattenNext() throws(SerializeError)

    /// A union's case that carries nothing, by its name: JSON's `"Idle"`.
    fn encodeUnitCase(_ name: String, of type: String) throws(SerializeError)

    /// A union's case by its name, its payload encoded next, then
    /// `endCase()`: JSON's `{"Circle": payload}`.
    fn beginCase(_ name: String, of type: String) throws(SerializeError)
    fn endCase() throws(SerializeError)
}
