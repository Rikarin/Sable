module UnixSocketTests

// UnixListener, UnixStream and UnixDatagramSocket (Sable.Net): run with
//     tools/stdlib-coverage.sh Sable.Net

import NetSupport
import Sable.Concurrency
import Sable.IO
import Sable.Net
import Sable.Process
import Sable.Testing
import Sable.Time

/// A path no other test has, short enough for a socket's; what is there is
/// removed afterwards.
final class SocketPath: Fixture {
    let path: String

    init() {
        path = Self.unique()
    }

    static fn unique() -> String {
        let name = "sable-\(Process.id())-\(Int.random(in: 0..<1 << 32))"
        #if os(windows)
        return "\(Environment.temporaryDirectory.appending(name))"
        #else
        return "/tmp/\(name)"
        #endif
    }

    async fn tearDown() throws {
        _ = try? File.remove(path)
    }
}

@test
fn aConnectionIsMadeAtAPath(socket: SocketPath) async throws {
    let at = socket.path
    let listener = try UnixListener.bind(at)
    assertEqual(listener.path, at)
    expect((try File.metadata(at)).kind == FileKind.Socket)
    expect((try File.metadata(at, followLinks: false)).kind == FileKind.Socket)
    let client = try await UnixStream.connect(at, timeout: Duration.seconds(10))
    let server = try await listener.accept()
    try await client.write([1, 2, 3])
    client.finishWriting()
    assertEqual(try await server.readAll(), [1, 2, 3])
    try await server.write([4])
    server.close()
    assertEqual(try await client.read(upTo: 9), [4])
    assertEqual((try await client.read(upTo: 9)).count, 0)
}

@test
fn aPathInUseIsSaidToBeAndMayBeReplaced(socket: SocketPath) async throws {
    let at = socket.path
    let first = try UnixListener.bind(at)
    expectThrows(saying: "'\(at)' is in use") {
        _ = try UnixListener.bind(at)
    }
    first.close()
    // Its file stays, and no one listens by it.
    expectThrows(saying: "'\(at)' is in use") {
        _ = try UnixListener.bind(at)
    }
    await expectThrows(saying: "'\(at)' refused the connection") {
        _ = try await UnixStream.connect(at)
    }
    let second = try UnixListener.bind(at, replacing: true)
    _ = try await UnixStream.connect(at)
    _ = try await second.accept()
}

@test
fn aFileThatIsNoSocketIsNotReplaced(socket: SocketPath) async throws {
    let at = socket.path
    try File.write(at, "kept")
    expectThrows(saying: "'\(at)' is in use") {
        _ = try UnixListener.bind(at, replacing: true)
    }
    assertEqual(try File.read(at), "kept")
}

@test
fn aPathTheSystemHasNoRoomForIsRefused() async {
    let long = "/tmp/" + "0123456789".repeated(30)
    expectThrows { _ = try UnixListener.bind(long) }
    await expectThrows { _ = try await UnixStream.connect(long) }
}

@test(arguments: ["", "/tmp/a\0b"])
fn aPathThatIsNoneIsRefused(_ path: String) {
    expectThrows { _ = try UnixListener.bind(path) }
}

@test
fn connectingWhereNothingIsSaysSo() async {
    let missing = SocketPath.unique()
    await expectThrows(saying: "nothing is at '\(missing)'") { _ = try await UnixStream.connect(missing) }
}

@test
fn closingAndCancellingWakeAnAccept(socket: SocketPath) async throws {
    let at = socket.path
    let listener = try UnixListener.bind(at)
    let cancelled = Task.spawn { await thrown {
        _ = try await listener.accept()
    } }
    await Task.yield()
    cancelled.cancel()
    assertEqual(await cancelled.value, "the task was cancelled while it waited")
    let closed = Task.spawn { await thrown {
        _ = try await listener.accept()
    } }
    await Task.yield()
    listener.close()
    assertEqual(await closed.value, "the connection failed or was closed")
}

/// More than the system holds: the writer waits for the reader.
@test
fn aLargeWriteWaitsForItsReader(socket: SocketPath) async throws {
    let at = socket.path
    let listener = try UnixListener.bind(at)
    let client = try await UnixStream.connect(at)
    let server = try await listener.accept()
    let writing = Task.spawn { await thrown {
        var block: U8[>..] = []
        for i in 0..<1_000_000 {
            block.append(U8(i % 251))
        }
        try await client.write(block)
        client.finishWriting()
    } }
    try? await Task.sleep(nanoseconds: 20_000_000)
    let got = try await server.readAll()
    assertEqual(await writing.value, "")
    assertEqual(got.count, 1_000_000)
    let wrong = (0..<got.count).first(where: { Int(got[$0]) != $0 % 251 })
    expect(wrong == none)
}

/// A read or an accept given up is begun again, and nothing is lost by it.
@test
fn aReadAndAnAcceptTimeOut(socket: SocketPath) async throws {
    let at = socket.path
    let listener = try UnixListener.bind(at)
    expect((try? await withTimeout(Duration.milliseconds(20)) { try await listener.accept() }) == none)
    let client = try await UnixStream.connect(at)
    let server = try await listener.accept()
    expect((try? await withTimeout(Duration.milliseconds(20)) { try await server.read(upTo: 9) }) == none)
    try await client.write([1, 2])
    assertEqual(try await server.read(upTo: 9), [1, 2])
}

@test
fn closingAStreamWakesItsRead(socket: SocketPath) async throws {
    let at = socket.path
    let listener = try UnixListener.bind(at)
    let client = try await UnixStream.connect(at)
    let server = try await listener.accept()
    let reading = Task.spawn { await thrown {
        _ = try await client.read(upTo: 1)
    } }
    await Task.yield()
    client.close()
    assertEqual(await reading.value, "the connection failed or was closed")
    server.close()
}

#if os(windows)
// Windows' Unix sockets are streams alone.
@test
fn thereAreNoDatagrams(socket: SocketPath) async {
    expectThrows(saying: "'' is not supported here") {
        _ = try UnixDatagramSocket.unbound()
    }
    let at = socket.path
    expectThrows(saying: "'\(at)' is not supported here") {
        _ = try UnixDatagramSocket.bind(at)
    }
    expect(!File.exists(at))
}
#else
@test
fn datagramsAreSentToAPath(socket: SocketPath) async throws {
    let at = socket.path
    let receiver = try UnixDatagramSocket.bind(at)
    let sender = try UnixDatagramSocket.unbound()
    try await sender.send([1, 2], to: at)
    try await sender.send([3], to: at)
    assertEqual(try await receiver.receive(), [1, 2])
    assertEqual(try await receiver.receive(), [3])
    expectThrows {
        _ = try UnixDatagramSocket.bind("")
    }
    expectThrows {
        _ = try UnixDatagramSocket.bind(at)
    }
    let missing = SocketPath.unique()
    await expectThrows(saying: "nothing is at '\(missing)'") { try await sender.send([1], to: missing) }
    receiver.close()
    await expectThrows(saying: "the connection failed or was closed") {
        _ = try await receiver.receive()
    }
    let again = try UnixDatagramSocket.bind(at, replacing: true)
    try await sender.send([4], to: at)
    assertEqual(try await again.receive(), [4])
}

/// A receiver with no room has the sender wait for it.
@test
fn aSenderWaitsForAReceiverThatIsFull(socket: SocketPath) async throws {
    let at = socket.path
    let receiver = try UnixDatagramSocket.bind(at)
    let sending = Task.spawn { await thrown {
        let sender = try UnixDatagramSocket.unbound()
        let block = U8[>..](repeating: 1, count: 1000)
        for _ in 0..<200 {
            try await sender.send(block, to: at)
        }
    } }
    try? await Task.sleep(nanoseconds: 10_000_000)
    for _ in 0..<200 {
        assertEqual((try await receiver.receive()).count, 1000)
    }
    assertEqual(await sending.value, "")
}

@test
fn eachEndOfAConnectionKnowsWhoIsAtTheOther(socket: SocketPath) async throws {
    try skip(if: PeerCredentials.currentUserId == none, "Windows says no user of a socket's peer")
    let listener = try UnixListener.bind(socket.path)
    let client = try await UnixStream.connect(socket.path, timeout: Duration.seconds(10))
    let server = try await listener.accept()
    let peer = try server.peerCredentials()
    assertEqual(peer.processId, Process.id())
    assertEqual(peer.userId, PeerCredentials.currentUserId)
    assertEqual(try client.peerCredentials().userId, PeerCredentials.currentUserId)
    assertEqual(PeerCredentials(processId: 1, userId: none).processId, 1)
}

#endif
