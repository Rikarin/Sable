module HashSetTests

// HashSet (Sable.Collections), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Collections

import Sable.Collections
import Sable.Testing

@test
fn hashSetKeepsOneOfEach() {
    let seen = HashSet<Int>()
    assert(seen.insert(5))
    assert(!seen.insert(5), "a second insert of the same value adds nothing")
    assert(seen.insert(6))
    assertEqual(seen.elements().count, 2)
}

@test
fn anEmptySetContainsNothing() {
    let members = HashSet<String>()
    assert(members.isEmpty)
    assertEqual(members.count, 0)
    assert(!members.contains("a"))
    assert(!members.remove("a"))
}

@test
fn removeTakesOutAMember() {
    let members = HashSet<String>()
    let _ = members.insert("a")
    let _ = members.insert("b")
    assert(members.contains("a"))
    assert(members.remove("a"))
    assert(!members.contains("a"))
    assertEqual(members.count, 1)
    assert(!members.isEmpty)
    assert(members.elements() == ["b"])
}
