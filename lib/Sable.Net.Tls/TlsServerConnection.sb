module Sable.Net.Tls

import Sable.Crypto
import Sable.Crypto.X509
import Sable.Time

/// The server's end of a TLS 1.3 connection (RFC 8446), with no I/O of its
/// own: bytes that came from the client go in through `receive`, and what
/// is to be sent back comes out of `takeOutgoing`. `TlsStream.accept` drives
/// one over a stream; a test, or another transport, may drive it by hand.
///
/// The handshake has an ephemeral key exchange of X25519 or P-256, the
/// first of the options' groups the client takes; a client whose share is
/// of another is asked for one of it with a HelloRetryRequest. The server's
/// certificate chain is sent and the handshake signed by its key. After the
/// handshake a ticket of the session goes to the client, sealed with the
/// options' ticket key; a client that offers one back resumes the session
/// (RFC 8446 §4.2.11, with a fresh key exchange), and no certificate is
/// sent. If the options say so the client is asked for a certificate, which
/// is verified, and its signature of the handshake checked. Every fault
/// found sends the client its alert and throws.
///
/// ```sable
/// let key = EcdsaPrivateKey<P256>.generate().anyKey
/// let certificate = try! CertificateBuilder(subject: DistinguishedName([]), host: "localhost").selfSigned(with: key)
/// var server = TlsServerConnection(options: TlsServerOptions(certificateChain: [certificate], privateKey: key))
/// var client = TlsClientConnection(host: "localhost", options: TlsClientOptions(trust: .Pinned([certificate])))
/// try! server.receive(client.takeOutgoing())
/// try! client.receive(server.takeOutgoing())
/// try! server.receive(client.takeOutgoing())
/// assert(client.isHandshakeComplete && server.isHandshakeComplete)
/// assert(server.serverName == "localhost")
/// try! client.write("hello".utf8Bytes())
/// try! server.receive(client.takeOutgoing())
/// assert(server.takeReceived() == "hello".utf8Bytes())
/// ```
public struct TlsServerConnection: Sendable {
    let options: TlsServerOptions
    let random: U8[>..]
    let keyShares: TlsKeyShare[>..]
    var state: ServerState = .WaitClientHello
    var transcript: U8[>..] = []
    var records = TlsRecords()
    var clientApplicationSecret: SymmetricKey? = none

    /// The key schedule at its master secret, once the server's flight is
    /// sent.
    var schedule: TlsKeySchedule? = none

    /// The suite and the group of the HelloRetryRequest sent, if one was:
    /// the group none.
    var retriedSuite: TlsCipherSuite? = none
    var retriedGroup = 0

    /// Whether the client resumed a session of a ticket.
    public private(set) var isResumed = false

    /// The client's certificates as it sent them, its own first; none if
    /// none was asked for, or it sent none.
    public private(set) var peerCertificates: Certificate[>..] = []

    /// The suite chosen; none before the client's ClientHello.
    public private(set) var cipherSuite: TlsCipherSuite? = none

    /// The application protocol chosen; none if there was none to choose.
    public private(set) var applicationProtocol: String? = none

    /// The name the client asked for (server_name); none if it named none.
    public private(set) var serverName: String? = none

    /// A server that answers as the options say, its random and ephemeral
    /// key made afresh.
    public init(options: TlsServerOptions) {
        self.init(options: options, random: SecureRandom.bytes(32), keyShares: [])
    }

    /// A server that answers with the random and with the ephemeral key of
    /// the group it chooses given, as a recorded handshake is replayed; a
    /// key of a group not given is made afresh.
    public init(options: TlsServerOptions, random: U8[:], keyShares: TlsKeyShare[:]) {
        self.options = options
        self.random = random.toArray()
        self.keyShares = keyShares.toArray()
    }

    /// Whether the handshake is over and application data may flow.
    public var isHandshakeComplete: Bool => records.isConnected

    /// Whether the client has finished writing.
    public var isPeerClosed: Bool => records.isPeerClosed

    /// Whether this end has finished writing.
    public var isClosedForWriting: Bool => records.isClosedForWriting

    /// The bytes to send the client, taken: none are left.
    public mutating fn takeOutgoing() -> U8[>..] {
        return records.takeOutgoing()
    }

    /// The application data that has come, taken: none is left.
    public mutating fn takeReceived() -> U8[>..] {
        return records.takeReceived()
    }

    /// Bytes from the client: as many records as they complete are read, and
    /// what to answer is queued. A fault sends its alert and throws, and the
    /// connection is of no more use.
    public mutating fn receive(_ bytes: U8[:]) throws(TlsError) {
        if records.isFailed {
            throw TlsError.Closed
        }
        records.incoming.append(contentsOf: bytes)
        do {
            while true {
                guard let message = try records.nextMessage() else {
                    break
                }
                let keysBefore = state
                try readMessage(Int(message[0]), message)
                if !records.handshakeBytes.isEmpty && keysChange(from: keysBefore) {
                    throw TlsError.Failed(.unexpectedMessage, reason: "a handshake message across a change of keys")
                }
            }
        } catch {
            records.fail(error)
            throw error
        }
    }

    /// Application data sealed into records to send.
    public mutating fn write(_ bytes: U8[:]) throws(TlsError) {
        try records.write(bytes)
    }

    /// close_notify queued to send: this end writes no more, though it may
    /// read on until the client closes too.
    public mutating fn close() {
        records.close()
    }

    fn keysChange(from before: ServerState) -> Bool {
        return match before {
            case .WaitClientHello => true
            case .WaitFinished    => true
            default               => false
        }
    }

    mutating fn readMessage(_ type: Int, _ message: U8[>..]) throws(TlsError) {
        var body = TlsReader(message[4..<message.count], "a handshake message")
        match state {
            case .WaitClientHello => {
                if type != 1 {
                    throw TlsError.Failed(.unexpectedMessage, reason: "a handshake message of type \(type) where a ClientHello should be")
                }
                let earlier = transcript
                transcript.append(contentsOf: message)
                if try answer(try ClientHello.read(&body), message, earlier) {
                    state = !isResumed && options.clientAuthentication.verifier != none ? .WaitCertificate : .WaitFinished
                }
            }
            case .WaitCertificate => {
                if type != 11 {
                    throw TlsError.Failed(.unexpectedMessage, reason: "a handshake message of type \(type) where a Certificate should be")
                }
                let certificates = try readCertificateMessage(&body)
                transcript.append(contentsOf: message)
                if certificates.isEmpty {
                    if case .Required(_) = options.clientAuthentication {
                        throw TlsError.Failed(.certificateRequired, reason: "a client with no certificate")
                    }
                    state = .WaitFinished
                } else {
                    do {
                        _ = try options.clientAuthentication.verifier!.verify(certificates[0], intermediates: certificates[1..<certificates.count], purpose: KeyPurpose.clientAuth, at: time)
                    } catch {
                        throw TlsError.UntrustedCertificate(error)
                    }
                    peerCertificates = certificates
                    state = .WaitCertificateVerify
                }
            }
            case .WaitCertificateVerify => {
                if type != 15 {
                    throw TlsError.Failed(.unexpectedMessage, reason: "a handshake message of type \(type) where a CertificateVerify should be")
                }
                try readCertificateVerify(&body, of: peerCertificates[0], server: false, transcriptHash: transcriptHash())
                transcript.append(contentsOf: message)
                state = .WaitFinished
            }
            case .WaitFinished => {
                if type != 20 {
                    throw TlsError.Failed(.unexpectedMessage, reason: "a handshake message of type \(type) where a Finished should be")
                }
                let data = try body.take(body.bytes.count)
                let wanted = TlsKeySchedule.finishedData(cipherSuite!, trafficSecret: records.peerSecret!, transcriptHash: transcriptHash())
                if !constantTimeEquals(data, wanted) {
                    throw TlsError.Failed(.decryptError, reason: "the client's Finished is not the handshake's")
                }
                transcript.append(contentsOf: message)
                records.usePeerKey(clientApplicationSecret!)
                clientApplicationSecret = none
                records.isConnected = true
                state = .Connected
                try sendTicket()
            }
            case .Connected => try records.readPostHandshake(type, &body)
        }
    }

    /// The time tickets are issued and checked at.
    var time: UtcDateTime => options.time ?? UtcDateTime.now()

    /// A NewSessionTicket of the handshake, if the options have a key to
    /// seal one with (RFC 8446 §4.6.1).
    mutating fn sendTicket() throws(TlsError) {
        guard let key = options.ticketKey else {
            return
        }
        let suite = cipherSuite!
        let resumption = schedule!.deriveSecret("res master", transcriptHash: transcriptHash())
        let nonce: U8[>..] = [0]
        let preSharedKey = TlsKeySchedule.expandLabel(suite, resumption, "resumption", context: nonce, byteCount: suite.hashAlgorithm.digestByteCount)
        let lifetime = options.ticketLifetime.totalSeconds > 604800 ? 604800 : options.ticketLifetime.totalSeconds
        let random = SecureRandom.bytes(4)
        let ageAdd = Int(random[0]) << 24 | Int(random[1]) << 16 | Int(random[2]) << 8 | Int(random[3])
        guard let ticket = SessionTicket(suite: suite, issued: time.secondsSinceEpoch, lifetime: lifetime, preSharedKey: preSharedKey).sealed(with: key) else {
            return
        }
        var body: U8[>..] = []
        appendNumber(&body, lifetime, 4)
        appendNumber(&body, ageAdd, 4)
        appendVector(&body, nonce, 1)
        appendVector(&body, ticket, 2)
        appendVector(&body, [], 2)
        try records.send(handshakeMessage(4, body))
    }

    /// The pre-shared key of the first ticket offered that the server
    /// sealed, of the suite's hash and not yet expired, and its place among
    /// those offered: its binder checked (RFC 8446 §4.2.11.2), over the
    /// transcript before the hello and the hello up to the binders. None if
    /// no ticket is taken.
    fn resumption(_ hello: ClientHello, _ message: U8[:], _ earlier: U8[:], suite: TlsCipherSuite) throws(TlsError) -> (SymmetricKey, Int)? {
        guard let key = options.ticketKey else {
            return none
        }
        if !hello.pskModes.contains(1) {
            return none
        }
        let now = time.secondsSinceEpoch
        for i in 0..<hello.identities.count {
            guard let ticket = SessionTicket.open(hello.identities[i], with: key) else {
                continue
            }
            if ticket.suite.hashAlgorithm != suite.hashAlgorithm || now < ticket.issued || now - ticket.issued > ticket.lifetime {
                continue
            }
            var partial = earlier.toArray()
            partial.append(contentsOf: message[0..<message.count - hello.bindersByteCount])
            let wanted = TlsClientConnection.binder(suite, ticket.preSharedKey, partial)
            if !constantTimeEquals(hello.binders[i], wanted) {
                throw TlsError.Failed(.decryptError, reason: "a ticket's binder that is not the hello's")
            }
            return (ticket.preSharedKey, i)
        }
        return none
    }

    fn transcriptHash() -> U8[>..] {
        return cipherSuite!.hashAlgorithm.digest(of: transcript).bytes
    }

    /// A HelloRetryRequest for a share of the group (RFC 8446 §4.1.4), and
    /// the transcript begun again with the hash of the first ClientHello.
    mutating fn askAgain(_ hello: ClientHello, _ message: U8[:], suite: TlsCipherSuite, group: Int) throws(TlsError) {
        var body: U8[>..] = [3, 3]
        body.append(contentsOf: TlsClientConnection.retryRandom)
        appendVector(&body, hello.sessionId, 1)
        appendNumber(&body, suite.code, 2)
        body.append(0)
        var extensions: U8[>..] = []
        appendExtension(&extensions, 43, [3, 4])
        var share: U8[>..] = []
        appendNumber(&share, group, 2)
        appendExtension(&extensions, 51, share)
        appendVector(&body, extensions, 2)
        let request = handshakeMessage(2, body)
        try records.send(request)
        if !hello.sessionId.isEmpty {
            records.outgoing.append(contentsOf: [20, 3, 3, 0, 1, 1])
        }
        let hash = suite.hashAlgorithm.digest(of: message).bytes
        transcript = [254, 0, 0, U8(hash.count)]
        transcript.append(contentsOf: hash)
        transcript.append(contentsOf: request)
        retriedSuite = suite
        retriedGroup = group
    }

    /// The server's flight, ServerHello to Finished, for the hello: the
    /// message, after the transcript before it. False if a
    /// HelloRetryRequest was sent instead.
    mutating fn answer(_ hello: ClientHello, _ message: U8[:], _ earlier: U8[:]) throws(TlsError) -> Bool {
        if !hello.versions.contains(0x0304) {
            throw TlsError.Failed(.protocolVersion, reason: "a client that does not speak TLS 1.3")
        }
        var chosenSuite: TlsCipherSuite? = none
        for suite in options.cipherSuites {
            if chosenSuite == none && hello.cipherSuites.contains(suite.code) {
                chosenSuite = suite
            }
        }
        guard let suite = chosenSuite else {
            throw TlsError.Failed(.handshakeFailure, reason: "no cipher suite the client offers is taken")
        }
        guard let scheme = TlsServerConnection.signatureScheme(for: options.privateKey, offered: hello.signatureSchemes) else {
            throw TlsError.Failed(.handshakeFailure, reason: "the client takes no signature the server's key makes")
        }
        if options.certificateChain.isEmpty {
            throw TlsError.Failed(.internalError, reason: "a server with no certificate")
        }
        if retriedGroup != 0 && suite != retriedSuite {
            throw TlsError.Failed(.illegalParameter, reason: "a second ClientHello whose suite is not its HelloRetryRequest's")
        }
        var takes: Int[>..] = hello.groups
        if takes.isEmpty {
            for (offered, _) in hello.keyShares {
                takes.append(offered)
            }
        }
        var chosenGroup: Int? = none
        for each in options.groups {
            if chosenGroup == none && takes.contains(each.code) {
                chosenGroup = each.code
            }
        }
        guard let group = chosenGroup else {
            throw TlsError.Failed(.handshakeFailure, reason: "the client takes no group the server does")
        }
        var clientShare: U8[>..]? = none
        for (offered, key) in hello.keyShares {
            if clientShare == none && offered == group {
                clientShare = key
            }
        }
        guard let clientKey = clientShare else {
            if retriedGroup != 0 {
                throw TlsError.Failed(.illegalParameter, reason: "a second ClientHello without a share of the group asked for")
            }
            try askAgain(hello, message, suite: suite, group: group)
            return false
        }
        if !options.applicationProtocols.isEmpty && !hello.applicationProtocols.isEmpty {
            for name in options.applicationProtocols {
                if applicationProtocol == none && hello.applicationProtocols.contains(name) {
                    applicationProtocol = name
                }
            }
            if applicationProtocol == none {
                throw TlsError.Failed(.noApplicationProtocol, reason: "no application protocol the client offers is taken")
            }
        }
        serverName = hello.serverName
        var share: TlsKeyShare? = none
        for each in keyShares {
            if share == none && each.group == group {
                share = each
            }
        }
        let own = share ?? (group == 0x001D ? TlsKeyShare.X25519(X25519PrivateKey.generate()) : TlsKeyShare.P256(EcdhPrivateKey<Sable.Crypto.P256>.generate()))
        let shared = try own.sharedSecret(with: clientKey)
        let resumed = try resumption(hello, message, earlier, suite: suite)
        isResumed = resumed != none
        cipherSuite = suite
        records.suite = suite

        var body: U8[>..] = [3, 3]
        body.append(contentsOf: random)
        appendVector(&body, hello.sessionId, 1)
        appendNumber(&body, suite.code, 2)
        body.append(0)
        var extensions: U8[>..] = []
        var keyShare: U8[>..] = []
        appendNumber(&keyShare, group, 2)
        appendVector(&keyShare, own.publicBytes, 2)
        appendExtension(&extensions, 51, keyShare)
        appendExtension(&extensions, 43, [3, 4])
        if let (_, index) = resumed {
            var selected: U8[>..] = []
            appendNumber(&selected, index, 2)
            appendExtension(&extensions, 41, selected)
        }
        appendVector(&body, extensions, 2)
        let serverHello = handshakeMessage(2, body)
        try records.send(serverHello)
        if !hello.sessionId.isEmpty && retriedGroup == 0 {
            records.outgoing.append(contentsOf: [20, 3, 3, 0, 1, 1])
        }
        transcript.append(contentsOf: serverHello)

        var preSharedKey: SymmetricKey? = none
        if let (key, _) = resumed {
            preSharedKey = key
        }
        var schedule = TlsKeySchedule(suite, preSharedKey: preSharedKey)
        schedule.advance(sharedSecret: shared)
        let helloHash = transcriptHash()
        records.useKeys(own: schedule.deriveSecret("s hs traffic", transcriptHash: helloHash), peer: schedule.deriveSecret("c hs traffic", transcriptHash: helloHash))

        var flight: U8[>..] = []
        var encrypted: U8[>..] = []
        if hello.serverName != none {
            appendExtension(&encrypted, 0, [])
        }
        if let name = applicationProtocol {
            var names: U8[>..] = []
            appendVector(&names, name.utf8Bytes(), 1)
            var list: U8[>..] = []
            appendVector(&list, names, 2)
            appendExtension(&encrypted, 16, list)
        }
        var encryptedBody: U8[>..] = []
        appendVector(&encryptedBody, encrypted, 2)
        add(&flight, handshakeMessage(8, encryptedBody))

        if !isResumed, let verifier = options.clientAuthentication.verifier {
            var extensions: U8[>..] = []
            appendExtension(&extensions, 13, signatureAlgorithms())
            var names: U8[>..] = []
            for root in verifier.roots.certificates {
                appendVector(&names, root.subject.der, 2)
            }
            if !names.isEmpty {
                var authorities: U8[>..] = []
                appendVector(&authorities, names, 2)
                appendExtension(&extensions, 47, authorities)
            }
            var request: U8[>..] = [0]
            appendVector(&request, extensions, 2)
            add(&flight, handshakeMessage(13, request))
        }

        if !isResumed {
            var entries: U8[>..] = []
            for certificate in options.certificateChain {
                appendVector(&entries, certificate.der, 3)
                entries.append(contentsOf: [0, 0])
            }
            var certificateBody: U8[>..] = [0]
            appendVector(&certificateBody, entries, 3)
            add(&flight, handshakeMessage(11, certificateBody))

            let content = certificateVerifyContent(server: true, transcriptHash: transcriptHash())
            var verifyBody: U8[>..] = []
            appendNumber(&verifyBody, scheme, 2)
            appendVector(&verifyBody, TlsServerConnection.sign(content, scheme: scheme, key: options.privateKey), 2)
            add(&flight, handshakeMessage(15, verifyBody))
        }

        add(&flight, handshakeMessage(20, TlsKeySchedule.finishedData(suite, trafficSecret: records.ownSecret!, transcriptHash: transcriptHash())))
        try records.send(flight)

        let finishedHash = transcriptHash()
        schedule.advance()
        clientApplicationSecret = schedule.deriveSecret("c ap traffic", transcriptHash: finishedHash)
        records.useOwnKey(schedule.deriveSecret("s ap traffic", transcriptHash: finishedHash))
        self.schedule = schedule
        return true
    }

    /// The message added to the transcript and to the flight to send.
    mutating fn add(_ flight: inout U8[>..], _ message: U8[>..]) {
        transcript.append(contentsOf: message)
        flight.append(contentsOf: message)
    }

    /// The scheme the key signs with that the client takes (RFC 8446
    /// §4.2.3); none if there is none.
    static fn signatureScheme(for key: PrivateKey, offered: Int[>..]) -> Int? {
        let schemes: Int[>..] = match key {
            case .P256(_)    => [0x0403]
            case .P384(_)    => [0x0503]
            case .Ed25519(_) => [0x0807]
            case .Rsa(_)     => [0x0804, 0x0805, 0x0806]
            default          => []
        }
        for scheme in schemes {
            if offered.contains(scheme) {
                return scheme
            }
        }
        return none
    }

    /// The key's signature of the content by the scheme.
    static fn sign(_ content: U8[:], scheme: Int, key: PrivateKey) -> U8[>..] {
        return match key {
            case .P256(let own)    => own.sign(content, hash: .Sha256).der
            case .P384(let own)    => own.sign(content, hash: .Sha384).der
            case .Ed25519(let own) => own.sign(content)
            case .Rsa(let own)     => own.sign(content, padding: .Pss(scheme == 0x0806 ? .Sha512 : scheme == 0x0805 ? .Sha384 : .Sha256))
            default                => []
        }
    }
}

/// What a server reads of a ClientHello (RFC 8446 §4.1.2).
struct ClientHello {
    var sessionId: U8[>..] = []
    var cipherSuites: Int[>..] = []
    var versions: Int[>..] = []
    var signatureSchemes: Int[>..] = []
    var keyShares: (Int, U8[>..])[>..] = []
    var applicationProtocols: String[>..] = []
    var serverName: String? = none
    var groups: Int[>..] = []
    var pskModes: Int[>..] = []
    var identities: U8[>..][>..] = []
    var binders: U8[>..][>..] = []

    /// How many bytes the binders take at the end of the hello, their
    /// length's two among them.
    var bindersByteCount = 0

    init() { }

    static fn read(_ body: inout TlsReader) throws(TlsError) -> ClientHello {
        var hello = ClientHello()
        _ = try body.number(2)
        _ = try body.take(32)
        hello.sessionId = try body.vector(1)
        if hello.sessionId.count > 32 {
            throw TlsError.Failed(.illegalParameter, reason: "a session id of \(hello.sessionId.count) bytes")
        }
        var suites = TlsReader(try body.vector(2), "the cipher suites")
        while !suites.isAtEnd {
            hello.cipherSuites.append(try suites.number(2))
        }
        if try body.vector(1) != [0] {
            throw TlsError.Failed(.illegalParameter, reason: "a ClientHello with compression")
        }
        var extensions = TlsReader(try body.vector(2), "ClientHello's extensions")
        try body.finish()
        var seen: Int[>..] = []
        var sawVersions = false
        var sawSchemes = false
        var sawShares = false
        while !extensions.isAtEnd {
            let type = try extensions.number(2)
            if seen.contains(type) {
                throw TlsError.Failed(.illegalParameter, reason: "a ClientHello with two extensions \(type)")
            }
            seen.append(type)
            var data = TlsReader(try extensions.vector(2), "a ClientHello extension")
            match type {
                case 0 => {
                    var names = TlsReader(try data.vector(2), "server_name")
                    while !names.isAtEnd {
                        let kind = try names.number(1)
                        let name = try names.vector(2)
                        if kind == 0 {
                            guard let text = Runtime.decodeUtf8(bytes: name) else {
                                throw TlsError.Failed(.illegalParameter, reason: "a server name that is not UTF-8")
                            }
                            hello.serverName = text
                        }
                    }
                }
                case 13 => {
                    sawSchemes = true
                    var schemes = TlsReader(try data.vector(2), "signature_algorithms")
                    while !schemes.isAtEnd {
                        hello.signatureSchemes.append(try schemes.number(2))
                    }
                }
                case 16 => {
                    var names = TlsReader(try data.vector(2), "application_layer_protocol_negotiation")
                    while !names.isAtEnd {
                        let name = try names.vector(1)
                        if let text = Runtime.decodeUtf8(bytes: name) {
                            hello.applicationProtocols.append(text)
                        }
                    }
                }
                case 43 => {
                    sawVersions = true
                    var versions = TlsReader(try data.vector(1), "supported_versions")
                    while !versions.isAtEnd {
                        hello.versions.append(try versions.number(2))
                    }
                }
                case 10 => {
                    var groups = TlsReader(try data.vector(2), "supported_groups")
                    while !groups.isAtEnd {
                        hello.groups.append(try groups.number(2))
                    }
                }
                case 45 => {
                    var modes = TlsReader(try data.vector(1), "psk_key_exchange_modes")
                    while !modes.isAtEnd {
                        hello.pskModes.append(try modes.number(1))
                    }
                }
                case 41 => {
                    var identities = TlsReader(try data.vector(2), "pre_shared_key's identities")
                    while !identities.isAtEnd {
                        hello.identities.append(try identities.vector(2))
                        _ = try identities.number(4)
                    }
                    let start = data.at
                    var binders = TlsReader(try data.vector(2), "pre_shared_key's binders")
                    while !binders.isAtEnd {
                        hello.binders.append(try binders.vector(1))
                    }
                    hello.bindersByteCount = data.at - start
                    if !extensions.isAtEnd {
                        throw TlsError.Failed(.illegalParameter, reason: "a pre_shared_key that is not the last extension")
                    }
                    if hello.identities.isEmpty || hello.identities.count != hello.binders.count {
                        throw TlsError.Failed(.illegalParameter, reason: "a pre_shared_key of \(hello.identities.count) identities and \(hello.binders.count) binders")
                    }
                }
                case 51 => {
                    sawShares = true
                    var shares = TlsReader(try data.vector(2), "key_share")
                    while !shares.isAtEnd {
                        let group = try shares.number(2)
                        hello.keyShares.append((group, try shares.vector(2)))
                    }
                }
                default => _ = try data.take(data.bytes.count - data.at)
            }
            try data.finish()
        }
        if !sawVersions {
            throw TlsError.Failed(.protocolVersion, reason: "a client that does not speak TLS 1.3")
        }
        if !sawSchemes || !sawShares {
            throw TlsError.Failed(.missingExtension, reason: "a ClientHello without \(sawSchemes ? "key_share" : "signature_algorithms")")
        }
        return hello
    }
}

/// What a ticket of the server seals: the session's suite, when it was
/// issued and for how long, in seconds, and its pre-shared key.
struct SessionTicket {
    let suite: TlsCipherSuite
    let issued: Int
    let lifetime: Int
    let preSharedKey: SymmetricKey

    init(suite: TlsCipherSuite, issued: Int, lifetime: Int, preSharedKey: SymmetricKey) {
        self.suite = suite
        self.issued = issued
        self.lifetime = lifetime
        self.preSharedKey = preSharedKey
    }

    /// The ticket sealed with AES-GCM under the key; none for a key AES
    /// takes not.
    fn sealed(with key: SymmetricKey) -> U8[>..]? {
        var plain: U8[>..] = []
        appendNumber(&plain, suite.code, 2)
        appendNumber(&plain, issued, 8)
        appendNumber(&plain, lifetime, 4)
        appendVector(&plain, preSharedKey.bytes(), 1)
        defer {
            secureZero(&plain)
        }
        guard let cipher = try? AesGcm(key: key), let box = try? cipher.seal(plain) else {
            return none
        }
        return box.combined
    }

    /// The ticket the bytes seal under the key; none for any that are not
    /// one the key sealed.
    static fn open(_ bytes: U8[:], with key: SymmetricKey) -> SessionTicket? {
        guard let cipher = try? AesGcm(key: key), let box = try? SealedBox(combined: bytes), var plain = try? cipher.open(box) else {
            return none
        }
        defer {
            secureZero(&plain)
        }
        var reader = TlsReader(plain, "a ticket")
        guard let code = try? reader.number(2), let suite = TlsCipherSuite.of(code: code), let issued = try? reader.number(8), let lifetime = try? reader.number(4), let secret = try? reader.vector(1) else {
            return none
        }
        return SessionTicket(suite: suite, issued: issued, lifetime: lifetime, preSharedKey: SymmetricKey(secret))
    }
}

/// Where a server's handshake is.
enum ServerState: Sendable {
    WaitClientHello
    WaitCertificate
    WaitCertificateVerify
    WaitFinished
    Connected
}
