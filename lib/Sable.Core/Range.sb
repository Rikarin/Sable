module Sable.Core

// The ranges: what 'a..<b' and 'a...b' make, and the one-sided '..<b',
// '...b' and 'a...'. The binder knows the operators by sight and builds
// these types from them; everything a range does is declared here. A 'for'
// over a range of integers or characters counts, with no range built when
// the range is written in the loop; a range open at the start has no first
// value, so is not one a loop can go through.

/// The values from 'lowerBound' up to, not including, 'upperBound': what
/// 'a..<b' makes. Empty when the bounds are equal, and when they are the
/// wrong way round.
public struct Range<Bound: Comparable> {
    /// The first value in the range, when it has any.
    public let lowerBound: Bound

    /// The first value past the range.
    public let upperBound: Bound

    /// Whether the range has no values.
    public var isEmpty: Bool => !(lowerBound < upperBound)

    /// Whether the value is in the range.
    public fn contains(_ value: Bound) -> Bool {
        return !(value < lowerBound) && value < upperBound
    }
}

extension Range {
    /// Whether the two ranges have a value in common: never when either is
    /// empty.
    ///
    /// ```sable
    /// assert((0..<5).overlaps(4..<9))
    /// assert(!(0..<5).overlaps(5..<9))
    /// ```
    public fn overlaps(_ other: Range<Bound>) -> Bool {
        return !isEmpty && !other.isEmpty && lowerBound < other.upperBound && other.lowerBound < upperBound
    }

    /// Whether the range and the closed range have a value in common.
    ///
    /// ```sable
    /// assert((0..<5).overlaps(4...9))
    /// assert(!(0..<5).overlaps(5...9))
    /// ```
    public fn overlaps(_ other: ClosedRange<Bound>) -> Bool {
        return !isEmpty && !other.isEmpty && !(other.upperBound < lowerBound) && other.lowerBound < upperBound
    }

    /// The range cut down to fit within 'limits': each bound moved inside
    /// them where it is outside. A range that misses 'limits' altogether
    /// becomes an empty one at the nearer of their bounds.
    ///
    /// ```sable
    /// assert((0..<10).clamped(to: 3..<7) == 3..<7)
    /// assert((0..<5).clamped(to: 3..<7) == 3..<5)
    /// assert((8..<9).clamped(to: 3..<7) == 7..<7)
    /// ```
    public fn clamped(to limits: Range<Bound>) -> Range<Bound> {
        let lower = lowerBound < limits.lowerBound ? limits.lowerBound : limits.upperBound < lowerBound ? limits.upperBound : lowerBound
        let upper = limits.upperBound < upperBound ? limits.upperBound : upperBound < limits.lowerBound ? limits.lowerBound : upperBound
        return Range<Bound>(lowerBound: lower, upperBound: upper)
    }

    /// Whether every value of the range is in 'other': true of an empty
    /// range, which has none to be outside.
    ///
    /// ```sable
    /// assert((2..<4).isSubrange(of: 0..<10))
    /// assert(!(2..<12).isSubrange(of: 0..<10))
    /// ```
    public fn isSubrange(of other: Range<Bound>) -> Bool {
        return isEmpty || !(lowerBound < other.lowerBound) && !(other.upperBound < upperBound)
    }
}

extension Range: Equatable {
    public operator == (lhs: Range<Bound>, rhs: Range<Bound>) -> Bool {
        return lhs.lowerBound == rhs.lowerBound && lhs.upperBound == rhs.upperBound
    }
}

extension Range: Debug where Bound: Debug {
    /// The range as source writes it: "2..<5".
    public fn debugDescription() -> String {
        return "\(lowerBound.debugDescription())..<\(upperBound.debugDescription())"
    }
}
