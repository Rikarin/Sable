module Sable.Collections

// Collections beyond the array family (docs/04 §4.3), written in Sable.

/// Last in, first out.
public class Stack<Element> {
    var items: Element[>..] = []

    public init() { }

    public var count: Int { get { return items.count } }
    public var isEmpty: Bool { get { return items.count == 0 } }

    public fn push(_ item: Element) {
        items.append(item)
    }

    public fn pop() -> Element? {
        if items.count == 0 {
            return none
        }
        return items.removeLast()
    }

    public fn peek() -> Element? {
        if items.count == 0 {
            return none
        }
        return items[items.count - 1]
    }
}

/// First in, first out: two stacks, the second refilled from the first
/// when it runs dry, so each element moves once.
public class Queue<Element> {
    var incoming: Element[>..] = []
    var outgoing: Element[>..] = []

    public init() { }

    public var count: Int { get { return incoming.count + outgoing.count } }
    public var isEmpty: Bool { get { return incoming.count + outgoing.count == 0 } }

    public fn enqueue(_ item: Element) {
        incoming.append(item)
    }

    public fn dequeue() -> Element? {
        if outgoing.count == 0 {
            while incoming.count > 0 {
                outgoing.append(incoming.removeLast())
            }
        }
        if outgoing.count == 0 {
            return none
        }
        return outgoing.removeLast()
    }
}

/// Keys to values, by hash. The entries — keys, values, and whether each
/// is still there — are kept in parallel arrays in the order they were
/// added, so iteration is in insertion order; the table is open addressing
/// with linear probing over a power of two of slots, at most half of them
/// used, each holding an entry's index with 31 bits of its key's hash
/// above it. A probe compares those bits before it looks at the key, so a
/// miss rarely touches the entries at all, and growing the table never
/// rehashes a key it does not have to.
///
/// A slot is -1 when empty and -2 when its entry was removed; a removed
/// entry stays in the arrays, its value with it, until the map next grows
/// and drops what was removed.
public class HashMap<Key: Hashable, Value> {
    var keys: Key[>..] = []
    var values: Value[>..] = []
    var live: Bool[>..] = []
    var table: Int[>..] = []
    var mask: Int = -1
    var used: Int = 0
    var filled: Int = 0

    public init() { }

    /// How many keys it holds.
    public var count: Int { get { return used } }

    public var isEmpty: Bool { get { return used == 0 } }

    /// 31 bits of the key's hash, the high ones folded into them, so that
    /// keys differing only above bit 31 still differ here.
    fn tagOf(_ key: Key) -> Int {
        let h = key.hash()
        return (h ^ (h >> 31) ^ (h >> 62)) & 2147483647
    }

    /// Where the key is in the table, or, if it is not there, the slot it
    /// would go in: the first removed one passed, else the empty one that
    /// ended the search.
    fn probe(_ key: Key, _ tag: Int) -> Int {
        var at = (tag ^ (tag >> 15)) & mask
        var reuse = -1
        while true {
            let slot = table[at]
            if slot == -1 {
                return reuse >= 0 ? reuse : at
            }
            if slot >= 0 {
                if slot >> 32 == tag && keys[slot & 4294967295] == key {
                    return at
                }
            } else if reuse < 0 {
                reuse = at
            }
            at = (at + 1) & mask
        }
        return at
    }

    /// The slots rebuilt, twice as many if the entries would fill more than
    /// half of them; what was removed is dropped from the entries first.
    fn grow() {
        if used < keys.count {
            var keptKeys: Key[>..] = []
            var keptValues: Value[>..] = []
            var keptLive: Bool[>..] = []
            var index = 0
            while index < keys.count {
                if live[index] {
                    keptKeys.append(keys[index])
                    keptValues.append(values[index])
                    keptLive.append(true)
                }
                index = index + 1
            }
            keys = keptKeys
            values = keptValues
            live = keptLive
        }

        var size = 8
        while (used + 1) * 2 > size {
            size = size * 2
        }
        if size < table.count {
            size = table.count
        }
        table = []
        var i = 0
        while i < size {
            table.append(-1)
            i = i + 1
        }
        mask = size - 1
        filled = used

        var index = 0
        while index < keys.count {
            let tag = tagOf(keys[index])
            var at = (tag ^ (tag >> 15)) & mask
            while table[at] != -1 {
                at = (at + 1) & mask
            }
            table[at] = (tag << 32) | index
            index = index + 1
        }
    }

    /// The value for the key, or none.
    public fn get(_ key: Key) -> Value? {
        if used == 0 {
            return none
        }
        let slot = table[probe(key, tagOf(key))]
        if slot < 0 {
            return none
        }
        return values[slot & 4294967295]
    }

    /// Whether the map holds the key.
    public fn contains(_ key: Key) -> Bool {
        return used > 0 && table[probe(key, tagOf(key))] >= 0
    }

    /// Sets the key's value, adding the key if it is new.
    public fn set(_ key: Key, _ value: Value) {
        if (filled + 1) * 2 > table.count {
            grow()
        }
        let tag = tagOf(key)
        let at = probe(key, tag)
        let slot = table[at]
        if slot >= 0 {
            values[slot & 4294967295] = value
            return
        }
        if slot == -1 {
            filled = filled + 1
        }
        table[at] = (tag << 32) | keys.count
        keys.append(key)
        values.append(value)
        live.append(true)
        used = used + 1
    }

    /// Removes the key; true if it was there.
    public fn remove(_ key: Key) -> Bool {
        if used == 0 {
            return false
        }
        let at = probe(key, tagOf(key))
        let slot = table[at]
        if slot < 0 {
            return false
        }
        live[slot & 4294967295] = false
        table[at] = -2
        used = used - 1
        return true
    }

    /// Removes every key, keeping nothing.
    public fn removeAll() {
        keys = []
        values = []
        live = []
        table = []
        mask = -1
        used = 0
        filled = 0
    }

    /// The keys, in the order they were first set.
    public fn allKeys() -> Key[>..] {
        var result: Key[>..] = []
        var index = 0
        while index < keys.count {
            if live[index] {
                result.append(keys[index])
            }
            index = index + 1
        }
        return result
    }

    /// The values, in the order their keys were first set.
    public fn allValues() -> Value[>..] {
        var result: Value[>..] = []
        var index = 0
        while index < values.count {
            if live[index] {
                result.append(values[index])
            }
            index = index + 1
        }
        return result
    }
}

/// Distinct values, by hash; iteration is in insertion order.
public class HashSet<Element: Hashable> {
    var map: HashMap<Element, Bool> = HashMap<Element, Bool>()

    public init() { }

    public var count: Int { get { return map.count } }

    public var isEmpty: Bool { get { return map.count == 0 } }

    /// Adds the value; true if it was not there before.
    public fn insert(_ value: Element) -> Bool {
        let before = map.count
        map.set(value, true)
        return map.count > before
    }

    public fn contains(_ value: Element) -> Bool {
        return map.contains(value)
    }

    public fn remove(_ value: Element) -> Bool {
        return map.remove(value)
    }

    public fn elements() -> Element[>..] {
        return map.allKeys()
    }
}

/// Sorts the values in place, ascending: a stable merge sort.
public fn sort<T: Comparable>(_ values: inout T[>..]) {
    sort(&values, by: (a: T, b: T) => a < b)
}

/// Sorts the values in place by 'before', which says whether its first
/// argument goes ahead of its second: a stable merge sort. Runs of 16 are
/// put in order by insertion first; then runs are merged pairwise, back and
/// forth between the values and one scratch array, until one run is left —
/// a run already in order with the next is copied, not merged.
public fn sort<T>(_ values: inout T[>..], by before: (T, T) -> Bool) {
    let n = values.count
    if n < 2 {
        return
    }

    let run = 16
    var start = 0
    while start < n {
        let end = start + run < n ? start + run : n
        var i = start + 1
        while i < end {
            let held = values[i]
            var j = i
            while j > start && before(held, values[j - 1]) {
                values[j] = values[j - 1]
                j = j - 1
            }
            if j != i {
                values[j] = held
            }
            i = i + 1
        }
        start = end
    }
    if n <= run {
        return
    }

    // The values moved out, so that the two arrays are the only owners of
    // their buffers and each pass writes in place.
    var source = values
    values = []
    var target = source
    var width = run
    while width < n {
        var low = 0
        while low < n {
            let middle = low + width < n ? low + width : n
            let high = middle + width < n ? middle + width : n
            var k = low
            if middle >= high || !before(source[middle], source[middle - 1]) {
                while k < high {
                    target[k] = source[k]
                    k = k + 1
                }
            } else {
                var x = low
                var y = middle
                while x < middle && y < high {
                    if before(source[y], source[x]) {
                        target[k] = source[y]
                        y = y + 1
                    } else {
                        target[k] = source[x]
                        x = x + 1
                    }
                    k = k + 1
                }
                while x < middle {
                    target[k] = source[x]
                    x = x + 1
                    k = k + 1
                }
                while y < high {
                    target[k] = source[y]
                    y = y + 1
                    k = k + 1
                }
            }
            low = high
        }
        let merged = target
        target = source
        source = merged
        width = width * 2
    }
    values = source
}

/// The values in ascending order: a stable merge sort.
public fn sorted<T: Comparable>(_ values: T[>..]) -> T[>..] {
    var result = values
    sort(&result)
    return result
}

/// The values ordered by 'before': a stable merge sort.
public fn sorted<T>(_ values: T[>..], by before: (T, T) -> Bool) -> T[>..] {
    var result = values
    sort(&result, by: before)
    return result
}
