module SignalTests

// Signal (Sable.Process), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Process

import Sable.Process
import Sable.Testing

let signals: (Signal, String)[>..] = [
    (.Hangup, "HUP"), (.Interrupt, "INT"), (.Quit, "QUIT"), (.Abort, "ABRT"), (.Kill, "KILL"),
    (.SegmentationFault, "SEGV"), (.Pipe, "PIPE"), (.Alarm, "ALRM"), (.Terminate, "TERM"), (.User1, "USR1"),
    (.User2, "USR2"), (.Child, "CHLD"), (.Continue, "CONT"), (.Stop, "STOP"), (.WindowChange, "WINCH"),
]

@test(arguments: signals)
fn everySignalIsTheOneOfItsNumber(_ signal: Signal, _ name: String) {
    expect(Signal.of(number: signal.number) == signal)
    expect(Signal.of(number: signal.number).name == name)
}

@test
fn aNumberNoNameIsForIsItsOwn() {
    let signal = Signal.of(number: 61)
    assertEqual(signal.number, 61)
    assertEqual(signal.name, "61")
    expect(signal == Signal.Other(number: 61))
    expect(signal != Signal.Interrupt)
}
