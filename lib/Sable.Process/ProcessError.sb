module Sable.Process

/// Why a program could not be run: an Error, so a bare 'throws' can throw it.
public union ProcessError: Error {
    /// Nothing by that name could be started: not a path, and not on PATH.
    NotFound(program: String),

    /// What could not be run.
    public fn description() -> String {
        return match self {
            case .NotFound(let program) => "no program '\(program)' could be started"
        }
    }
}
