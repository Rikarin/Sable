module Sable.Net.Tls

/// An alert (RFC 8446 §6): why one end of a TLS connection closes it. Every
/// one but `closeNotify` and `userCanceled` is an error, and every alert in
/// TLS 1.3 ends the connection.
///
/// ```sable
/// assert(TlsAlert.decodeError.code == 50 && !TlsAlert.decodeError.isClosure)
/// assert(TlsAlert(code: 0) == .closeNotify && TlsAlert.closeNotify.isClosure)
/// assert("\(TlsAlert.badCertificate)" == "bad_certificate")
/// ```
@derive(Equatable, Hashable, Debug)
public struct TlsAlert: Formattable, Sendable {
    /// Its number on the wire.
    public let code: Int

    public init(code: Int) {
        self.code = code
    }

    /// The end has finished writing.
    public static var closeNotify: TlsAlert => TlsAlert(code: 0)
    /// A message came that was not expected.
    public static var unexpectedMessage: TlsAlert => TlsAlert(code: 10)
    /// A record did not open: its bytes are not what was sealed.
    public static var badRecordMac: TlsAlert => TlsAlert(code: 20)
    /// A record longer than may be.
    public static var recordOverflow: TlsAlert => TlsAlert(code: 22)
    /// No parameters both ends take.
    public static var handshakeFailure: TlsAlert => TlsAlert(code: 40)
    /// A certificate that is wrong, or not believed.
    public static var badCertificate: TlsAlert => TlsAlert(code: 42)
    /// A certificate of a kind not taken.
    public static var unsupportedCertificate: TlsAlert => TlsAlert(code: 43)
    /// A certificate its issuer revoked.
    public static var certificateRevoked: TlsAlert => TlsAlert(code: 44)
    /// A certificate out of its time.
    public static var certificateExpired: TlsAlert => TlsAlert(code: 45)
    /// A certificate refused for another reason.
    public static var certificateUnknown: TlsAlert => TlsAlert(code: 46)
    /// A field out of its range, or at odds with another.
    public static var illegalParameter: TlsAlert => TlsAlert(code: 47)
    /// A certificate whose issuer is not trusted.
    public static var unknownCa: TlsAlert => TlsAlert(code: 48)
    /// A message that could not be read.
    public static var decodeError: TlsAlert => TlsAlert(code: 50)
    /// A signature or a Finished that is not right.
    public static var decryptError: TlsAlert => TlsAlert(code: 51)
    /// A version of the protocol not taken.
    public static var protocolVersion: TlsAlert => TlsAlert(code: 70)
    /// An error of the end's own.
    public static var internalError: TlsAlert => TlsAlert(code: 80)
    /// The end gives up the connection, though nothing is wrong.
    public static var userCanceled: TlsAlert => TlsAlert(code: 90)
    /// An extension that must be there is not.
    public static var missingExtension: TlsAlert => TlsAlert(code: 109)
    /// An extension that was not asked for.
    public static var unsupportedExtension: TlsAlert => TlsAlert(code: 110)
    /// A client that sends no certificate where one is demanded.
    public static var certificateRequired: TlsAlert => TlsAlert(code: 116)
    /// No application protocol both ends take.
    public static var noApplicationProtocol: TlsAlert => TlsAlert(code: 120)

    /// Whether it closes the connection without an error.
    public var isClosure: Bool => code == 0 || code == 90

    /// Its name in RFC 8446.
    public var name: String => match code {
        case 0   => "close_notify"
        case 10  => "unexpected_message"
        case 20  => "bad_record_mac"
        case 22  => "record_overflow"
        case 40  => "handshake_failure"
        case 42  => "bad_certificate"
        case 43  => "unsupported_certificate"
        case 44  => "certificate_revoked"
        case 45  => "certificate_expired"
        case 46  => "certificate_unknown"
        case 47  => "illegal_parameter"
        case 48  => "unknown_ca"
        case 50  => "decode_error"
        case 51  => "decrypt_error"
        case 70  => "protocol_version"
        case 80  => "internal_error"
        case 90  => "user_canceled"
        case 109 => "missing_extension"
        case 110 => "unsupported_extension"
        case 116 => "certificate_required"
        case 120 => "no_application_protocol"
        default  => "alert \(code)"
    }

    public fn format(_ spec: FormatSpec) -> String {
        return name
    }
}
