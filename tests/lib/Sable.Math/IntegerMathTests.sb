module IntegerMathTests

// IntegerMath (Sable.Math), tested with '@test': run with
//     tools/stdlib-coverage.sh Sable.Math

import Sable.Math
import Sable.Testing

@test(arguments: [
    (0, 0),
    (1, 1),
    (2, 1),
    (15, 3),
    (16, 4),
    (17, 4),
    (999_999_999_999, 999_999),
    (1_000_000_000_000, 1_000_000),
])
fn isqrtIsTheFloorOfTheSquareRoot(_ n: Int, _ root: Int) {
    assertEqual(isqrt(n), root)
}

@test(arguments: [
    // 2^53 + 1's root as an F64 rounds: the steps put it right.
    (9_007_199_254_740_993, 94_906_265),
    (4_611_686_014_132_420_609, 2_147_483_647),
    (4_611_686_014_132_420_608, 2_147_483_646),
    (9_223_372_036_854_775_807, 3_037_000_499),
])
fn isqrtIsExactWhereF64sSquareRootIsNot(_ n: Int, _ root: Int) {
    assertEqual(isqrt(n), root)
}

@test(traps: "isqrt's argument must not be negative, but is -4")
fn isqrtOfANegativeNumberTraps() {
    _ = isqrt(-4)
}

@test(arguments: [(0, 1), (1, 1), (5, 120), (20, 2_432_902_008_176_640_000)])
fn factorialMultipliesOneThroughN(_ n: Int, _ product: Int) {
    assertEqual(factorial(n), product)
}

@test(traps: "integer overflow")
fn factorialPastTwentyTraps() {
    _ = factorial(21)
}

@test(traps: "factorial's argument must not be negative, but is -1")
fn factorialOfANegativeNumberTraps() {
    _ = factorial(-1)
}

@test(arguments: [(5, 2, 10), (5, 3, 10), (10, 0, 1), (10, 10, 1), (0, 0, 1), (52, 5, 2_598_960)])
fn binomialCountsSubsets(_ n: Int, _ k: Int, _ count: Int) {
    assertEqual(binomial(n, k), count)
}

@test(arguments: [(5, -1), (5, 6), (-3, 2)])
fn binomialOutsideZeroThroughNIsZero(_ n: Int, _ k: Int) {
    assertEqual(binomial(n, k), 0)
}

@test(arguments: [(62, 31, 465_428_353_255_261_088), (66, 33, 7_219_428_434_016_265_740), (1_000_000, 2, 499_999_500_000)])
fn binomialDoesNotOverflowOnTheWayToAResultThatFits(_ n: Int, _ k: Int, _ count: Int) {
    assertEqual(binomial(n, k), count)
}

@test(traps: "integer overflow")
fn binomialTrapsWhenTheResultDoesNotFit() {
    _ = binomial(68, 34)
}

@test(arguments: [
    (4, 13, 497, 445),
    (2, 0, 7, 1),
    (2, 0, 1, 0),
    (-2, 3, 5, 2),
    (3, 200, 1_000_000_007, 136_318_165),
    (9_223_372_036_854_775_806, 2, 9_223_372_036_854_775_807, 1),
])
fn powModReducesEveryProduct(_ base: Int, _ exponent: Int, _ modulus: Int, _ power: Int) {
    assertEqual(powMod(base, exponent, modulus), power)
}

@test(traps: "the modulus must be positive, not 0")
fn powModByZeroTraps() {
    _ = powMod(2, 3, 0)
}

@test(traps: "the exponent must not be negative, but is -1")
fn powModToANegativePowerTraps() {
    _ = powMod(2, -1, 7)
}

@test(arguments: [
    (3, 11, 4),
    (10, 17, 12),
    (-3, 11, 7),
    (14, 1, 0),
    (9_223_372_036_854_775_806, 9_223_372_036_854_775_807, 9_223_372_036_854_775_806),
])
fn modInverseUndoesMultiplication(_ n: Int, _ modulus: Int, _ inverse: Int) {
    assertEqual(modInverse(n, modulus), inverse)
}

@test(arguments: [(2, 4, "2 has no inverse modulo 4"), (0, 7, "0 has no inverse"), (21, 14, "7 divides both")])
fn modInverseIsNoneWithACommonFactor(_ n: Int, _ modulus: Int, _ why: String) {
    expect(modInverse(n, modulus) == none, why)
}

@test(traps: "the modulus must be positive, not 0")
fn modInverseModuloZeroTraps() {
    _ = modInverse(3, 0)
}

@test(traps: "the modulus must be positive, not -7")
fn powModByANegativeModulusTraps() {
    _ = powMod(2, 3, -7)
}

@test(traps: "the modulus must be positive, not -11")
fn modInverseModuloANegativeNumberTraps() {
    _ = modInverse(3, -11)
}

@test
fn isqrtTakesEveryWidth() {
    assertEqual(isqrt(255 as U8), 15 as U8)
    assertEqual(isqrt(127 as I8), 11 as I8)
    assertEqual(isqrt(U64.max), 4_294_967_295 as U64)
    assertEqual(isqrt(U128.max), U128(U64.max))
}

@test
fn ilogCountsTheWholePowersOfTheBase() {
    assertEqual(ilog(1, base: 10), 0)
    assertEqual(ilog(9, base: 10), 0)
    assertEqual(ilog(10, base: 10), 1)
    assertEqual(ilog(1_000_000, base: 10), 6)
    assertEqual(ilog(999_999, base: 10), 5)
    assertEqual(ilog(1024, base: 2), 10)
    assertEqual(ilog(255 as U8, base: 2), 7)
    assertEqual(ilog(U64.max, base: 16), 15)
    assertEqual(ilog(Int.max, base: 3), 39)
}

@test(traps: "ilog's argument must be positive, not 0")
fn ilogOfZeroTraps() {
    _ = ilog(0, base: 10)
}

@test(traps: "ilog's base must be at least 2, not 1")
fn ilogInBaseOneTraps() {
    _ = ilog(8, base: 1)
}

@test
fn factorialTakesEveryWidth() {
    assertEqual(factorial(5 as I8), 120 as I8)
    let expected: U128 = 295_232_799_039_604_140_847_618_609_643_520_000_000
    assertEqual(factorial(34 as U128), expected)
}

@test(traps: "integer overflow")
fn factorialPastWhatTheTypeHoldsTraps() {
    _ = factorial(6 as I8)
}

@test
fn binomialTakesEveryWidth() {
    assertEqual(binomial(10 as U8, 5), 252 as U8)
    let expected: U128 = 95_067_625_827_960_698_145_584_333_020_095_113_100
    assertEqual(binomial(130 as U128, 65), expected)
}

@test
fn powModOfA128BitTypeDoesNotOverflow() {
    let m: U128 = 170_141_183_460_469_231_731_687_303_715_884_105_727
    let exponent: U128 = 1_000_000_000_000_000_000_000_000_000_000
    let power: U128 = 77_365_983_643_526_108_570_615_817_422_012_409_412
    assertEqual(powMod(7 as U128, exponent, m), power)
    assertEqual(powMod(m - 1, 2, m), 1 as U128)
    let small: U64 = 13_784_367_590_845_050_696
    assertEqual(powMod(3 as U64, 200, U64.max), small)
    assertEqual(powMod(-2 as I8, 3, 5), 2 as I8)
}

@test
fn modInverseOfA128BitTypeDoesNotOverflow() {
    let m: U128 = 170_141_183_460_469_231_731_687_303_715_884_105_727
    let a: U128 = 123_456_789_123_456_789_123
    let inverse: U128 = 82_984_245_440_425_468_002_353_066_831_922_575_035
    assertEqual(modInverse(a, m), inverse)
    assertEqual(modInverse(3 as U8, 250), 167 as U8)
    expect(modInverse(4 as U8, 250) == none, "2 divides both")
}
