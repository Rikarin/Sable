module Sable.Collections

/// Keys to values, in the order the keys were added — an order that
/// removing a key closes up rather than leaving a gap in, and that can be
/// read by position. It is a dictionary none of whose entries leaves a gap
/// (Dictionary+Order.sb). Looking up, adding and
/// changing are constant time; removing is linear, as every later position
/// moves down one. (A `[Key: Value]` keeps its insertion order too, and
/// removes in constant time; this is for reading and changing by position.)
public class OrderedDictionary<Key: Hashable, Value> {
    var map: [Key: Value] = [:]

    /// An empty dictionary.
    public init() { }

    /// The sequence's pairs, each key with its value, in the order each key
    /// first comes; a key that comes again keeps its place and takes the
    /// last value given it. What going through them throws, it throws.
    public init<S: Sequence>(_ pairs: S) throws(S.Failure) where S.Element == (Key, Value) {
        for try (key, value) in pairs {
            self.set(key, value)
        }
    }

    /// How many keys it holds.
    public var count: Int => map.count

    /// Whether it holds no keys.
    public var isEmpty: Bool => map.count == 0

    /// The value for the key, or none.
    public fn get(_ key: Key) -> Value? => map[key]

    /// Whether the dictionary holds the key.
    public fn contains(_ key: Key) -> Bool {
        return map.contains(key)
    }

    /// Where the key is in the order, or none.
    public fn index(of key: Key) -> Int? {
        let at = map.order(of: key)
        return at < 0 ? none : at
    }

    /// Sets the key's value: a new key goes at the end, a key already there
    /// keeps its place.
    public fn set(_ key: Key, _ value: Value) {
        map.updateValue(value, forKey: key)
    }

    /// Removes the key, closing up the order behind it; its value, or none
    /// if it was not there.
    public fn remove(_ key: Key) -> Value? {
        let at = map.order(of: key)
        return at < 0 ? none : map.closeUp(at: at).1
    }

    /// The key at 'position' in the order; traps outside 0..<count.
    public fn key(at position: Int) -> Key {
        return map.orderedKey(at: position)
    }

    /// The value at 'position' in the order; traps outside 0..<count.
    public fn value(at position: Int) -> Value {
        return map.orderedValue(at: position)
    }

    /// Removes every key.
    public fn removeAll() {
        map.removeAll()
    }

    /// The key and its value put at the position, those from there on
    /// moved one along: whether it was, as a key already there is left
    /// where it is, its value too.
    ///
    /// ```sable
    /// let ordered = OrderedDictionary<String, Int>([("a", 1), ("c", 3)])
    /// assert(ordered.insert(2, forKey: "b", at: 1))
    /// assert(ordered.keys == ["a", "b", "c"])
    /// ```
    public fn insert(_ value: Value, forKey key: Key, at position: Int) -> Bool {
        if map.contains(key) {
            return false
        }
        if position < 0 || position > map.count {
            let nothing: Int[>..] = []
            _ = nothing[position]
        }
        map.updateValue(value, forKey: key)
        map.moveLast(to: position)
        return true
    }

    /// The entry at the position, taken out, those after it moved up.
    ///
    /// ```sable
    /// let ordered = OrderedDictionary<String, Int>([("a", 1), ("b", 2)])
    /// let (key, value) = ordered.remove(at: 0)
    /// assert(key == "a" && value == 1 && ordered.keys == ["b"])
    /// ```
    public fn remove(at position: Int) -> (Key, Value) {
        return map.closeUp(at: position)
    }

    /// The entries at the two positions exchanged.
    public fn swapAt(_ i: Int, _ j: Int) {
        if i == j {
            return
        }
        map.exchange(i, j)
    }

    /// The entries put in the order the closure says ('a' before 'b' when it
    /// is true): stable.
    ///
    /// ```sable
    /// let ordered = OrderedDictionary<String, Int>([("b", 1), ("a", 2)])
    /// ordered.sort(by: { $0.0 < $1.0 })
    /// assert(ordered.keys == ["a", "b"])
    /// ```
    public fn sort(by before: ((Key, Value), (Key, Value)) -> Bool) {
        var order = (0..<map.count).toArray()
        let held = map
        order.sort(by: (a: Int, b: Int) => before((held.orderedKey(at: a), held.orderedValue(at: a)), (held.orderedKey(at: b), held.orderedValue(at: b))))
        map.reorder(order)
    }

    /// The keys, in order.
    public var keys: Key[>..] {
        get {
            var keys: Key[>..] = []
            keys.reserveCapacity(map.count)
            for (key, _) in map {
                keys.append(key)
            }
            return keys
        }
    }

    /// The values, in their keys' order.
    public var values: Value[>..] {
        get {
            var values: Value[>..] = []
            values.reserveCapacity(map.count)
            for (_, value) in map {
                values.append(value)
            }
            return values
        }
    }
}

extension OrderedDictionary where Key: Comparable {
    /// The entries put in their keys' order.
    public fn sortByKeys() {
        sort(by: { $0.0 < $1.0 })
    }
}

// An ordered dictionary is a random-access collection of its entries,
// each key with its value, by their position in the order.
extension OrderedDictionary: RandomAccessCollection, FromSequence<(Key, Value)> {
    /// An iterator over the entries, each key with its value, in order.
    public fn makeIterator() -> DictionaryIterator<Key, Value> {
        return map.makeIterator()
    }

    /// The entry at 'position' in the order; traps outside 0..<count.
    ///
    /// ```sable
    /// let ages = OrderedDictionary<String, Int>()
    /// ages.set("ann", 31)
    /// ages.set("bo", 42)
    /// assert(ages[1].0 == "bo" && ages[1].1 == 42)
    /// ```
    public subscript(position: Int) -> (Key, Value) {
        get => (map.orderedKey(at: position), map.orderedValue(at: position))
    }

    /// The first entry's position: 0.
    public var startIndex: Int => 0

    /// The position past the last entry: the count.
    public var endIndex: Int => map.count

    /// The next position.
    public fn index(after position: Int) -> Int => position + 1

    /// The position before.
    public fn index(before position: Int) -> Int => position - 1

    /// The position 'distance' on.
    public fn index(_ position: Int, offsetBy distance: Int) -> Int => position + distance

    /// How far on 'end' is from 'start'.
    public fn distance(from start: Int, to end: Int) -> Int => end - start
}
