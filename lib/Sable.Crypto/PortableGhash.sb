module Sable.Crypto

/// GHASH (SP 800-38D) by ordinary multiplications of 64 bits, after
/// BearSSL's "ctmul64": a carryless product is sixteen products of words
/// with three zeros between their bits, which leave the carries room. The
/// multiplier of every processor this runs on takes as long whatever it is
/// given.
struct PortableGhash {
    // H, its halves added, and the three with their bits reversed.
    let h0: U64
    let h1: U64
    let h2: U64
    let r0: U64
    let r1: U64
    let r2: U64

    /// The sum so far, its first eight bytes as a big-endian number, and its last.
    var high: U64
    var low: U64

    /// Nothing summed yet, under the hash key at an address.
    init(key: Int) {
        unsafe {
            let words = (load64(key), load64(key &+ 8))
            h1 = words.0.byteSwapped
            h0 = words.1.byteSwapped
            h2 = h0 ^ h1
            r0 = h0.bitReversed
            r1 = h1.bitReversed
            r2 = r0 ^ r1
            high = 0
            low = 0
        }
    }

    /// The bytes, and zeros to a whole block after them.
    mutating fn add(_ bytes: U8[:]) {
        let count = bytes.count
        var at = 0
        while at + 16 <= count {
            add(high: bytes.readU64(at: at, endian: .Big), low: bytes.readU64(at: at + 8, endian: .Big))
            at += 16
        }
        if at < count {
            var first: U64 = 0
            var second: U64 = 0
            var i = 0
            while i < 16 {
                let byte = at + i < count ? U64(bytes[at + i]) : 0
                if i < 8 {
                    first = first << 8 | byte
                } else {
                    second = second << 8 | byte
                }
                i += 1
            }
            add(high: first, low: second)
        }
    }

    /// A block.
    mutating fn add(high first: U64, low second: U64) {
        let y1 = high ^ first
        let y0 = low ^ second
        let y2 = y0 ^ y1
        let s0 = y0.bitReversed
        let s1 = y1.bitReversed
        let s2 = s0 ^ s1

        // Karatsuba's three products, the high halves by the reversed words.
        let z0 = PortableGhash.multiply(y0, h0)
        let z1 = PortableGhash.multiply(y1, h1)
        let z2 = PortableGhash.multiply(y2, h2) ^ z0 ^ z1
        var t0 = PortableGhash.multiply(s0, r0)
        var t1 = PortableGhash.multiply(s1, r1)
        var t2 = PortableGhash.multiply(s2, r2) ^ t0 ^ t1
        t0 = t0.bitReversed >> 1
        t1 = t1.bitReversed >> 1
        t2 = t2.bitReversed >> 1
        var v0 = z0
        var v1 = t0 ^ z2
        var v2 = z1 ^ t2
        var v3 = t1

        // The field's bits are the other way round, so the product is one
        // place short; then reduced by x^128 + x^7 + x^2 + x + 1.
        v3 = v3 << 1 | v2 >> 63
        v2 = v2 << 1 | v1 >> 63
        v1 = v1 << 1 | v0 >> 63
        v0 = v0 << 1
        v2 = v2 ^ v0 ^ v0 >> 1 ^ v0 >> 2 ^ v0 >> 7
        v1 = v1 ^ v0 << 63 ^ v0 << 62 ^ v0 << 57
        v3 = v3 ^ v1 ^ v1 >> 1 ^ v1 >> 2 ^ v1 >> 7
        v2 = v2 ^ v1 << 63 ^ v1 << 62 ^ v1 << 57
        low = v2
        high = v3
    }

    /// The low half of the carryless product.
    @inline(always)
    static fn multiply(_ x: U64, _ y: U64) -> U64 {
        let x0 = x & 0x1111111111111111
        let x1 = x & 0x2222222222222222
        let x2 = x & 0x4444444444444444
        let x3 = x & 0x8888888888888888
        let y0 = y & 0x1111111111111111
        let y1 = y & 0x2222222222222222
        let y2 = y & 0x4444444444444444
        let y3 = y & 0x8888888888888888
        let z0 = (x0 &* y0) ^ (x1 &* y3) ^ (x2 &* y2) ^ (x3 &* y1)
        let z1 = (x0 &* y1) ^ (x1 &* y0) ^ (x2 &* y3) ^ (x3 &* y2)
        let z2 = (x0 &* y2) ^ (x1 &* y1) ^ (x2 &* y0) ^ (x3 &* y3)
        let z3 = (x0 &* y3) ^ (x1 &* y2) ^ (x2 &* y1) ^ (x3 &* y0)
        let first = (z0 & 0x1111111111111111) | (z1 & 0x2222222222222222)
        return first | (z2 & 0x4444444444444444) | (z3 & 0x8888888888888888)
    }
}
