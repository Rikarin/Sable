module FilePathTests

// FilePath and Path (Sable.IO): a table of POSIX and Windows paths, after
// Rust's std::path tests, read by both styles' rules wherever the tests run;
// then joining, normalizing, relating, comparing and the file system.

import IoSupport
import Sable.Collections
import Sable.IO
import Sable.Testing

fn posix(_ text: String) -> FilePath {
    return FilePath(text, style: .Posix)
}

fn windows(_ text: String) -> FilePath {
    return FilePath(text, style: .Windows)
}

fn parts(_ path: FilePath) -> String {
    var shown: String[>..] = []
    for part in path.components {
        shown.append("\(part)")
    }
    return shown.joined(separator: ",")
}

fn shown(_ path: FilePath?) -> String {
    if let path = path {
        return "\(path)"
    }
    return "none"
}

/// The path's parts, parent, name, stem and extension, and whether it is
/// rooted and absolute: what the two tables say of each.
fn described(_ path: FilePath) -> String {
    return "\(parts(path)) | \(shown(path.parent)) | \(path.fileName ?? "none") | \(path.stem ?? "none") | \(path.pathExtension ?? "none") | \(path.hasRoot) | \(path.isAbsolute)"
}

let posixPaths: (String, String)[>..] = [
    ("", " | none | none | none | none | false | false"),
    ("foo", "foo |  | foo | foo | none | false | false"),
    ("/", "/ | none | none | none | none | true | true"),
    ("/foo", "/,foo | / | foo | foo | none | true | true"),
    ("foo/", "foo |  | foo | foo | none | false | false"),
    ("/foo/", "/,foo | / | foo | foo | none | true | true"),
    ("foo/bar", "foo,bar | foo | bar | bar | none | false | false"),
    ("/foo/bar", "/,foo,bar | /foo | bar | bar | none | true | true"),
    ("///foo///", "/,foo | / | foo | foo | none | true | true"),
    ("///foo///bar", "/,foo,bar | ///foo | bar | bar | none | true | true"),
    ("./.", ". |  | none | none | none | false | false"),
    ("/..", "/,.. | / | none | none | none | true | true"),
    ("../", ".. |  | none | none | none | false | false"),
    ("foo/.", "foo |  | foo | foo | none | false | false"),
    ("foo/..", "foo,.. | foo | none | none | none | false | false"),
    ("foo/./bar", "foo,bar | foo | bar | bar | none | false | false"),
    ("foo/../bar", "foo,..,bar | foo/.. | bar | bar | none | false | false"),
    ("./a", ".,a | . | a | a | none | false | false"),
    ("a//b", "a,b | a | b | b | none | false | false"),
    (".foo", ".foo |  | .foo | .foo | none | false | false"),
    ("foo.", "foo. |  | foo. | foo |  | false | false"),
    (".foo.rs", ".foo.rs |  | .foo.rs | .foo | rs | false | false"),
    ("a/notes.tar.gz", "a,notes.tar.gz | a | notes.tar.gz | notes.tar | gz | false | false"),
    ("...", "... |  | ... | .. |  | false | false"),
    // A backslash is a name's on POSIX.
    ("a\\b", "a\\b |  | a\\b | a\\b | none | false | false"),
    ("C:/x", "C:,x | C: | x | x | none | false | false"),
]

@test(arguments: posixPaths)
fn posixPathsAsRustReadsThem(_ text: String, _ read: String) {
    expect(described(posix(text)) == read)
}

let windowsPaths: (String, String)[>..] = [
    ("c:", "c: | none | none | none | none | false | false"),
    ("c:\\", "c:,\\ | none | none | none | none | true | true"),
    ("c:/", "c:,/ | none | none | none | none | true | true"),
    ("c:foo", "c:,foo | c: | foo | foo | none | false | false"),
    ("c:\\foo", "c:,\\,foo | c:\\ | foo | foo | none | true | true"),
    ("c:\\foo\\bar.txt", "c:,\\,foo,bar.txt | c:\\foo | bar.txt | bar | txt | true | true"),
    ("c:/foo/bar", "c:,/,foo,bar | c:/foo | bar | bar | none | true | true"),
    ("\\foo", "\\,foo | \\ | foo | foo | none | true | false"),
    ("foo\\bar/baz", "foo,bar,baz | foo\\bar | baz | baz | none | false | false"),
    ("\\\\server\\share", "\\\\server\\share, | none | none | none | none | true | true"),
    ("\\\\server\\share\\a", "\\\\server\\share,\\,a | \\\\server\\share\\ | a | a | none | true | true"),
    ("//server/share/a/b", "//server/share,/,a,b | //server/share/a | b | b | none | true | true"),
    ("\\\\server", "\\\\server, | none | none | none | none | true | true"),
    ("\\\\?\\a\\b", "\\\\?\\a,\\,b | \\\\?\\a\\ | b | b | none | true | true"),
    // A verbatim path is the system's as it is: '/' is a name's, '.' a part.
    ("\\\\?\\a/b", "\\\\?\\a/b | none | none | none | none | true | true"),
    ("\\\\?\\a\\.\\b", "\\\\?\\a,\\,.,b | \\\\?\\a\\. | b | b | none | true | true"),
    ("\\\\?\\C:\\foo", "\\\\?\\C:,\\,foo | \\\\?\\C:\\ | foo | foo | none | true | true"),
    ("\\\\?\\C:", "\\\\?\\C: | none | none | none | none | true | true"),
    ("\\\\?\\UNC\\server\\share\\x", "\\\\?\\UNC\\server\\share,\\,x | \\\\?\\UNC\\server\\share\\ | x | x | none | true | true"),
    ("\\\\.\\COM1", "\\\\.\\COM1, | none | none | none | none | true | true"),
    ("\\\\.\\pipe\\x", "\\\\.\\pipe,\\,x | \\\\.\\pipe\\ | x | x | none | true | true"),
]

@test(arguments: windowsPaths)
fn windowsPathsAsRustReadsThem(_ text: String, _ read: String) {
    expect(described(windows(text)) == read)
}

@test
fn aWindowsPathHasAPrefix() {
    expect(windows("c:\\x").prefixKind == .Disk)
    expect(windows("\\\\?\\x").prefixKind == .Verbatim)
    expect(windows("\\\\?\\C:\\").prefixKind == .VerbatimDisk)
    expect(windows("\\\\?\\UNC\\s\\h").prefixKind == .VerbatimUnc)
    expect(windows("\\\\.\\x").prefixKind == .DeviceNamespace)
    expect(windows("\\\\s\\h").prefixKind == .Unc)
    expect(windows("x").prefixKind == none)
    expect(posix("//s/h").prefixKind == none)
}

@test
fn aPathHasARootAndASeparator() {
    assertEqual(shown(windows("c:\\a").root), "c:\\")
    assertEqual(shown(windows("c:a").root), "c:")
    assertEqual(shown(posix("/a").root), "/")
    assertEqual(shown(posix("a").root), "none")
    assertEqual("\(windows("x").separator)", "\\")
    assertEqual("\(posix("x").separator)", "/")
}

@test(arguments: [
    ("a", "b", "a/b"),
    ("a/", "b", "a/b"),
    ("", "b", "b"),
    ("/a", "/b", "/b"),
    ("a", "", "a/"),
])
fn appendingJoinsAsRustsPushDoes(_ path: String, _ added: String, _ joined: String) {
    expect(shown(posix(path).appending(added)) == joined)
}

@test(arguments: [
    ("a", "b", "a\\b"),
    ("c:", "b", "c:b"),
    ("c:\\a", "\\b", "c:\\b"),
    ("c:\\a", "d:b", "d:b"),
    ("c:\\a", "\\\\s\\h", "\\\\s\\h"),
    ("\\\\?\\a", "b", "\\\\?\\a\\b"),
    ("a/", "b", "a/b"),
])
fn appendingJoinsAsRustsPushDoesOnWindows(_ path: String, _ added: String, _ joined: String) {
    expect(shown(windows(path).appending(added)) == joined)
}

@test
fn aPathIsAppendedToAnother() {
    assertEqual(shown(windows("a").appending(windows("b"))), "a\\b")
}

@test(arguments: [
    ("a/b.txt", "md", "a/b.md"),
    ("a/b.tar.gz", "", "a/b.tar"),
    ("a/b", "c", "a/b.c"),
    ("a/.profile", "bak", "a/.profile.bak"),
    ("a/..", "c", "a/.."),
    ("a/b.txt/", "md", "a/b.md"),
])
fn anExtensionIsReplaced(_ path: String, _ added: String, _ replaced: String) {
    expect(shown(posix(path).withExtension(added)) == replaced)
}

@test
fn namesAndLastPartsAreReplaced() {
    assertEqual(shown(posix("a/b.txt").withFileName("c")), "a/c")
    assertEqual(shown(posix("b.txt").withFileName("c")), "c")
    assertEqual(shown(posix("/").withFileName("c")), "/c")
    assertEqual(shown(posix("a/..").withFileName("c")), "a/../c")
    assertEqual(shown(posix("/a").removingLastComponent()), "/")
    assertEqual(shown(posix("/").removingLastComponent()), "/")
    assertEqual("\(posix("a/b").lastComponent!)", "b")
    expect(posix("").lastComponent == none)
    expect(posix("a/..").lastComponent!.kind == .ParentDirectory)
}

@test(arguments: [
    ("a/b/../c/./d", "a/c/d"),
    ("/../a/..", "/"),
    ("../../a", "../../a"),
    ("a/../..", ".."),
    ("a/..", "."),
    ("./", "."),
    ("//a//b//", "/a/b"),
])
fn normalizingIsByTheBytesAlone(_ path: String, _ normalized: String) {
    expect(shown(posix(path).lexicallyNormalized()) == normalized)
}

@test(arguments: [
    ("c:/a/./b/../c", "c:\\a\\c"),
    ("c:a\\..\\..", "c:.."),
    ("\\\\s\\h\\..\\x", "\\\\s\\h\\x"),
    ("\\\\?\\a\\..\\b", "\\\\?\\a\\..\\b"),
])
fn normalizingIsByTheBytesAloneOnWindows(_ path: String, _ normalized: String) {
    expect(shown(windows(path).lexicallyNormalized()) == normalized)
}

@test
fn prefixesSuffixesAndRelativePaths() {
    expect(posix("/etc/passwd").starts(with: posix("/etc")))
    expect(posix("/etc/passwd").starts(with: posix("/etc/")))
    expect(!posix("/etc/passwd").starts(with: posix("/et")))
    expect(!posix("/etc").starts(with: posix("/etc/passwd")))
    expect(!posix("etc/passwd").starts(with: posix("/etc")))
    expect(posix("/etc/passwd").ends(with: posix("passwd")))
    expect(posix("/etc/passwd").ends(with: posix("etc/passwd")))
    expect(!posix("/etc/passwd").ends(with: posix("/passwd")))
    expect(!posix("a").ends(with: posix("b/a")))
    expect(windows("c:\\a\\b").starts(with: windows("c:/a")))
}

@test
fn aPrefixIsStrippedOrThereIsNone() {
    assertEqual(shown(posix("/test/haha/foo.txt").strippingPrefix(posix("/test/"))), "haha/foo.txt")
    assertEqual(shown(posix("/test/haha/foo.txt").strippingPrefix(posix("/test/haha/foo.txt"))), "")
    assertEqual(shown(posix("/test/haha").strippingPrefix(posix("/te"))), "none")
    assertEqual(shown(windows("c:\\a").strippingPrefix(windows("c:"))), "\\a")
}

@test(arguments: [
    ("/a/b/c", "/a/x", "../b/c"),
    ("/a/b", "/a/b/", "."),
    ("/a/b", "/a/b/c/d", "../.."),
    ("a/b", "./a", "b"),
    ("a", "../x", "none"),
    ("../a", "..", "a"),
    ("/a", "a", "none"),
    ("a", "/a", "none"),
])
fn aPathIsWrittenRelativeToAnother(_ path: String, _ base: String, _ relative: String) {
    expect(shown(posix(path).relative(to: posix(base))) == relative)
}

@test(arguments: [
    ("c:\\a\\b", "c:\\c", "..\\a\\b"),
    ("c:\\a", "d:\\a", "none"),
])
fn aPathIsWrittenRelativeToAnotherOnWindows(_ path: String, _ base: String, _ relative: String) {
    expect(shown(windows(path).relative(to: windows(base))) == relative)
}

@test
fn pathsCompareByTheirComponents() {
    expect(posix("a//b/") == posix("a/b"))
    expect(posix("a/./b") == posix("a/b"))
    expect(posix("./a") != posix("a"))
    expect(posix("/a") != posix("a"))
    expect(posix("a") != windows("a"))
    expect(windows("c:/a") == windows("c:\\a"))
    assertEqual(posix("a//b/").hashValue, posix("a/b").hashValue)
    assertEqual(windows("c:/a").hashValue, windows("c:\\a").hashValue)

    expect(posix("a") < posix("b"))
    expect(posix("a") < posix("a/b"))
    expect(!(posix("a/b") < posix("a")))
    expect(posix("/z") < posix("a"))
    expect(posix("a/b") < posix("a/c"))
    expect(posix("ab") > posix("a"))
    expect(posix("..") < posix("a"))
    expect(posix("x") < windows("x"))
    expect(!(posix("x") < posix("x")))

    var seen = Set<FilePath>()
    _ = seen.insert(posix("a/b"))
    _ = seen.insert(posix("a//b"))
    _ = seen.insert(posix("a/c"))
    assertEqual(seen.count, 2)
    assertEqual(posix("/a b").debugDescription(), "FilePath(\"/a b\")")
    assertEqual("[\(posix("ab"):>4)]", "[  ab]")
}

@test
fn bytesThatAreNotUtf8ArePathsToo() {
    // Latin-1 "café" as a POSIX file name may have it.
    let path = FilePath(bytes: [0x2F, 0x74, 0x2F, 0x63, 0x61, 0x66, 0xE9, 0x2E, 0x74, 0x78, 0x74], style: .Posix)
    expect(path.string == none)
    assertEqual("\(path)", "/t/caf\u{FFFD}.txt")
    assertEqual(path.pathExtension ?? "-", "txt")
    assertEqual(path.components.count, 3)
    expect(path.components[2].string == none)
    assertEqual(path.components[2].bytes.count, 8)
    expect(path.parent! == posix("/t"))
    assertEqual(path.withExtension("md").bytes[6], 0xE9)
    expect(posix("ok").string! == "ok")
    expect(posix("ok").components[0].string! == "ok")
}

@test
fn theFileSystemResolvesWhatTheBytesCannot() throws {
    let here = try FilePath(".").canonical()
    expect(here.isAbsolute)
    expect(FilePath(".").absolute().isAbsolute)
    expect(here.absolute() == here)
    let name = "sable-test-path-canonical.txt"
    try File.write(name, "x")
    let file = try FilePath("./" + name).canonical()
    assertEqual(file.fileName ?? "-", name)
    expect(file.parent! == here)
    let opened = try File.open(FilePath(name))
    assertEqual(try opened.read(upTo: 5).count, 1)
    opened.close()
    try File.remove(name)
    expectIoError("NotFound", "a missing path resolved") {
        _ = try FilePath("sable-test-no-such-path").canonical()
    }
}

@test
fn pathsAsTextGoThroughFilePath() {
    // The host's style: Windows joins with '\\' and roots only with a drive.
    let onWindows = FilePath("").style == .Windows
    let s = "\(FilePath("").separator)"
    assertEqual(Path.join("a", "b"), "a\(s)b")
    assertEqual(Path.join("", "b"), "b")
    assertEqual(Path.join("/a", "/b"), "/b")
    assertEqual(Path.fileName("a/b.txt"), "b.txt")
    assertEqual(Path.fileName("a/.."), "")
    assertEqual(Path.directory("x/y/report.md"), "x/y")
    assertEqual(Path.directory("report.md"), ".")
    assertEqual(Path.directory("/"), "/")
    assertEqual(Path.directory(""), ".")
    assertEqual(Path.extension("a/b.tar.gz") ?? "-", "gz")
    expect(Path.extension(".hidden") == none)
    assertEqual(Path.withoutExtension("x/y/report.md"), "x/y/report")
    assertEqual(Path.normalized("a/./b/../c"), "a\(s)c")
    assertEqual(Path.relative("/a/b", to: "/a") ?? "-", "b")
    expect(Path.relative("a", to: "/a") == none)
    expect(Path.isAbsolute(onWindows ? "C:\\a" : "/a") && !Path.isAbsolute("a"))
}
