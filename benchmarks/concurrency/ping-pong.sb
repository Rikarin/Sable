module Bench

import Sable.Time

// Ping-pong: two tasks hand a ball back and forth through an actor a
// hundred thousand times — each parked in a wait list until it is its turn,
// and, as stage 2's channels did, by yielding until it is.

actor Table {
    var ball = 0
    let turned = WaitList()

    fn hit(_ player: Int, _ rounds: Int) async {
        while ball < rounds {
            while ball % 2 != player && ball < rounds {
                await turned.park()
            }
            if ball < rounds {
                ball += 1
                turned.wakeAll()
            }
        }
    }

    fn turn() -> Int {
        return ball
    }

    fn take() {
        ball += 1
    }

    fn reset() {
        ball = 0
    }
}

fn yielding(_ table: Table, _ player: Int, _ rounds: Int) async -> Int {
    var hits = 0
    while true {
        let ball = await table.turn()
        if ball >= rounds {
            return hits
        }
        if ball % 2 == player {
            await table.take()
            hits += 1
        } else {
            await Task.yield()
        }
    }
}

@main
fn main() async {
    let rounds = 100_000
    let table = Table()

    var start = Instant.now()
    let a = Task.spawn { await table.hit(0, rounds) }
    let b = Task.spawn { await table.hit(1, rounds) }
    await a.value
    await b.value
    print("ping-pong, parked: \(start.elapsed.totalNanoseconds / rounds) ns per hit")

    await table.reset()
    start = Instant.now()
    let c = Task.spawn { await yielding(table, 0, rounds) }
    let d = Task.spawn { await yielding(table, 1, rounds) }
    let hits = await c.value + await d.value
    print("ping-pong, yielding: \(start.elapsed.totalNanoseconds / rounds) ns per hit")
    if hits != rounds {
        print("hits lost")
    }
}
