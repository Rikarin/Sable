module Sable.Math.Tensors

import Sable.Math

// Reductions: of every element, or along an axis, which the result is
// without (or keeps, of length 1, with 'keepingDimension'), as NumPy's do.

/// The runs along an axis of a view: the rest's places, row-major, each the
/// start of one, and the run's length and step.
struct AxisRuns {
    /// The shape without the axis, and the strides of its places.
    let rest: Int[>..]
    let restStrides: Int[>..]
    let length: Int
    let step: Int

    init(_ shape: Int[:], _ strides: Int[:], axis at: Int) {
        rest = removing(shape, at: at)
        restStrides = removing(strides, at: at)
        length = shape[at]
        step = strides[at]
    }

    /// The shape a reduction along the axis gives.
    fn shape(keeping: Bool, at axis: Int) -> Int[>..] => keeping ? inserting(1, into: rest, at: axis) : rest
}

extension TensorView {
    /// The reduction of each run along the axis, by a closure given the
    /// storage, the run's first offset, its stride and its count: a call a
    /// run, in row-major order of the rest.
    fn reduced<R>(axis: Int, keepingDimension: Bool, _ reduce: (T[:], Int, Int, Int) -> R) -> Tensor<R> {
        let at = normalisedAxis(axis, rank: rank)
        let along = AxisRuns(shape, strides, axis: at)
        var made: R[>..] = []
        made.reserveCapacity(elementCount(along.rest))
        var runs = Runs(along.rest, along.restStrides, offset)
        while runs.next() {
            var start = runs.a
            var i = 0
            while i < runs.length {
                made.append(reduce(storage, start, along.step, along.length))
                start += runs.aStep
                i += 1
            }
        }
        return Tensor<R>(storage: made, shape: along.shape(keeping: keepingDimension, at: at), layout: .RowMajor)
    }
}

/// The sums along an axis, of any number type: each run's, from zero, where
/// the axis is the contiguous one; else each place of the rest added to a
/// slice at a time, which goes along the rest's own runs.
fn sums<T: Numeric>(_ view: TensorView<T>, axis: Int, keepingDimension: Bool) -> Tensor<T> {
    let at = normalisedAxis(axis, rank: view.rank)
    let along = AxisRuns(view.shape, view.strides, axis: at)
    let shape = along.shape(keeping: keepingDimension, at: at)
    if along.step == 1 || along.length <= 1 {
        return view.reduced(axis: at, keepingDimension: keepingDimension) { runSum($0, $1, $2, $3) }
    }
    var made = T[>..](repeating: T.zero, count: elementCount(along.rest))
    let x = view.storage
    var k = 0
    while k < along.length {
        var runs = Runs(along.rest, along.restStrides, view.offset + k * along.step)
        var o = 0
        while runs.next() {
            var p = runs.a
            var i = 0
            while i < runs.length {
                made[o] = made[o] + x[p]
                p += runs.aStep
                o += 1
                i += 1
            }
        }
        k += 1
    }
    return Tensor<T>(storage: made, shape: shape, layout: .RowMajor)
}

/// The sums along an axis of F32s or F64s, by Sable.Math's kernels: each
/// run's a vector at a time where the axis is the contiguous one; else a
/// slice at a time added to the sums, a vector at a time along the rest.
@inline(always)
fn vectorSums<T: SIMDScalar & BinaryFloatingPoint, N: Int>(_ view: TensorView<T>, axis: Int, keepingDimension: Bool, _ zero: SIMD<T, N>) -> Tensor<T> {
    let at = normalisedAxis(axis, rank: view.rank)
    let along = AxisRuns(view.shape, view.strides, axis: at)
    let shape = along.shape(keeping: keepingDimension, at: at)
    let count = elementCount(along.rest)
    let x = view.storage
    if along.step == 1 || along.length <= 1 {
        var made: T[>..] = []
        made.append(holes: count)
        var runs = Runs(along.rest, along.restStrides, view.offset)
        var o = 0
        while runs.next() {
            var start = runs.a
            var i = 0
            while i < runs.length {
                made[o] = sumRun(x, start, along.step, along.length, zero)
                start += runs.aStep
                o += 1
                i += 1
            }
        }
        return Tensor<T>(storage: made, shape: shape, layout: .RowMajor)
    }
    var made = T[>..](repeating: T.zero, count: count)
    let contiguous = contiguousStrides(along.rest, .RowMajor)
    var k = 0
    while k < along.length {
        var runs = Runs(along.rest, contiguous, 0, along.restStrides, view.offset + k * along.step, layout: .RowMajor)
        while runs.next() {
            arithmeticRunInPlace(.Add, &made, runs.a, x, runs.b, runs.bStep, runs.length, zero)
        }
        k += 1
    }
    return Tensor<T>(storage: made, shape: shape, layout: .RowMajor)
}

/// The sum of every element of F32s or F64s, a run at a time.
@inline(always)
fn vectorTotal<T: SIMDScalar & BinaryFloatingPoint, N: Int>(_ view: TensorView<T>, _ zero: SIMD<T, N>) -> T {
    var total = T.zero
    var runs = Runs(view.shape, view.strides, view.offset)
    while runs.next() {
        total = total + sumRun(view.storage, runs.a, runs.aStep, runs.length, zero)
    }
    return total
}

/// The sum of a run, from zero.
fn runSum<T: Numeric>(_ storage: T[:], _ start: Int, _ step: Int, _ count: Int) -> T {
    var total = T.zero
    var at = start
    var i = 0
    while i < count {
        total = total + storage[at]
        at += step
        i += 1
    }
    return total
}

/// The place in a run of its first least or greatest element.
fn runExtreme<T: Comparable>(_ storage: T[:], _ start: Int, _ step: Int, _ count: Int, greatest: Bool) -> Int {
    if count == 0 {
        preconditionFailure("the least or greatest of no elements")
    }
    var best = storage[start]
    var place = 0
    var at = start + step
    var i = 1
    while i < count {
        let x = storage[at]
        if greatest ? best < x : x < best {
            best = x
            place = i
        }
        at += step
        i += 1
    }
    return place
}

extension TensorView where T: Numeric {
    /// The sum of every element: zero for none.
    ///
    /// ```sable
    /// assert(Tensor<Int>(shape: [2, 2], elements: [1, 2, 3, 4]).view.sum() == 10)
    /// ```
    public fn sum() -> T {
        var total = T.zero
        var runs = Runs(shape, strides, offset)
        while runs.next() {
            total = total + runSum(storage, runs.a, runs.aStep, runs.length)
        }
        return total
    }

    /// The sums along the axis.
    public fn sum(axis: Int, keepingDimension: Bool = false) -> Tensor<T> => sums(self, axis: axis, keepingDimension: keepingDimension)

    /// The product of every element: one for none.
    public fn product() -> T {
        var total = T.one
        var runs = Runs(shape, strides, offset)
        while runs.next() {
            var at = runs.a
            var i = 0
            while i < runs.length {
                total = total * storage[at]
                at += runs.aStep
                i += 1
            }
        }
        return total
    }
}

extension TensorView where T: FloatingPoint {
    /// The mean of every element: NaN for none.
    public fn mean() -> T => self.sum() / T.converting(count)

    /// The means along the axis.
    public fn mean(axis: Int, keepingDimension: Bool = false) -> Tensor<T> {
        let length = T.converting(shape[normalisedAxis(axis, rank: rank)])
        let total = sums(self, axis: axis, keepingDimension: keepingDimension)
        return total.withElements(quotientsWithScalar(total.storage, length, valueFirst: false))
    }
}

extension TensorView where T: Comparable {
    /// The least element, by '<': traps for none.
    public fn min() -> T => storage[self.extremeOffset(greatest: false)]

    /// The greatest element, by '<': traps for none.
    public fn max() -> T => storage[self.extremeOffset(greatest: true)]

    /// The place, row-major, of the first greatest element: NumPy's flat
    /// `argmax`. Traps for none.
    public fn argmax() -> Int => self.extremePlace(greatest: true)

    /// The place, row-major, of the first least element. Traps for none.
    public fn argmin() -> Int => self.extremePlace(greatest: false)

    /// The least elements along the axis.
    public fn min(axis: Int, keepingDimension: Bool = false) -> Tensor<T> {
        return self.reduced(axis: axis, keepingDimension: keepingDimension) { $0[$1 + $2 * runExtreme($0, $1, $2, $3, greatest: false)] }
    }

    /// The greatest elements along the axis.
    public fn max(axis: Int, keepingDimension: Bool = false) -> Tensor<T> {
        return self.reduced(axis: axis, keepingDimension: keepingDimension) { $0[$1 + $2 * runExtreme($0, $1, $2, $3, greatest: true)] }
    }

    /// The place along the axis of the first greatest element of each run.
    ///
    /// ```sable
    /// let t = Tensor<Int>(shape: [2, 3], elements: [1, 9, 2, 7, 0, 7])
    /// assert(t.view.argmax(axis: 1).toArray() == [1, 0])
    /// assert(t.view.argmax(axis: 0).toArray() == [1, 0, 1])
    /// ```
    public fn argmax(axis: Int, keepingDimension: Bool = false) -> Tensor<Int> {
        return self.reduced(axis: axis, keepingDimension: keepingDimension) { runExtreme($0, $1, $2, $3, greatest: true) }
    }

    /// The place along the axis of the first least element of each run.
    public fn argmin(axis: Int, keepingDimension: Bool = false) -> Tensor<Int> {
        return self.reduced(axis: axis, keepingDimension: keepingDimension) { runExtreme($0, $1, $2, $3, greatest: false) }
    }

    fn extremePlace(greatest: Bool) -> Int {
        let offsets = self.offsets()
        if offsets.count == 0 {
            preconditionFailure("the least or greatest of no elements")
        }
        var place = 0
        var i = 1
        while i < offsets.count {
            let x = storage[offsets[i]]
            let best = storage[offsets[place]]
            if greatest ? best < x : x < best {
                place = i
            }
            i += 1
        }
        return place
    }

    fn extremeOffset(greatest: Bool) -> Int => self.offsets()[self.extremePlace(greatest: greatest)]
}

extension TensorView where T: ElementaryFunctions {
    /// The softmax along the axis: each element's exponential over the sum of
    /// its run's, the run's greatest taken from each first so that none
    /// overflows. Each run is positive and sums to 1.
    ///
    /// ```sable
    /// let t = Tensor<F64>(shape: [2], elements: [0, 0])
    /// assert(t.view.softmax(axis: 0).toArray() == [0.5, 0.5])
    /// ```
    public fn softmax(axis: Int) -> Tensor<T> {
        let at = normalisedAxis(axis, rank: rank)
        var made = self.toArray()
        let along = AxisRuns(shape, contiguousStrides(shape, .RowMajor), axis: at)
        let step = along.step
        let count = along.length
        var runs = Runs(along.rest, along.restStrides, 0)
        while count > 0 && runs.next() {
            var start = runs.a
            var r = 0
            while r < runs.length {
                let greatest = made[start + step * runExtreme(made, start, step, count, greatest: true)]
                var total = T.zero
                var k = 0
                while k < count {
                    let e = T.exp(made[start + k * step] - greatest)
                    made[start + k * step] = e
                    total = total + e
                    k += 1
                }
                k = 0
                while k < count {
                    made[start + k * step] = made[start + k * step] / total
                    k += 1
                }
                start += runs.aStep
                r += 1
            }
        }
        return Tensor<T>(storage: made, shape: shape, layout: .RowMajor)
    }
}

extension Tensor where T: Numeric {
    /// The sum of every element: zero for none.
    public fn sum() -> T => self.view.sum()

    /// The sums along the axis.
    public fn sum(axis: Int, keepingDimension: Bool = false) -> Tensor<T> => self.view.sum(axis: axis, keepingDimension: keepingDimension)

    /// The product of every element: one for none.
    public fn product() -> T => self.view.product()
}

extension Tensor where T: FloatingPoint {
    /// The mean of every element: NaN for none.
    public fn mean() -> T => self.view.mean()

    /// The means along the axis.
    public fn mean(axis: Int, keepingDimension: Bool = false) -> Tensor<T> => self.view.mean(axis: axis, keepingDimension: keepingDimension)
}

extension Tensor where T: Comparable {
    /// The least element: traps for none.
    public fn min() -> T => self.view.min()

    /// The greatest element: traps for none.
    public fn max() -> T => self.view.max()

    /// The row-major place of the first greatest element.
    public fn argmax() -> Int => self.view.argmax()

    /// The row-major place of the first least element.
    public fn argmin() -> Int => self.view.argmin()

    /// The least elements along the axis.
    public fn min(axis: Int, keepingDimension: Bool = false) -> Tensor<T> => self.view.min(axis: axis, keepingDimension: keepingDimension)

    /// The greatest elements along the axis.
    public fn max(axis: Int, keepingDimension: Bool = false) -> Tensor<T> => self.view.max(axis: axis, keepingDimension: keepingDimension)

    /// The place along the axis of the first greatest element of each run.
    public fn argmax(axis: Int, keepingDimension: Bool = false) -> Tensor<Int> => self.view.argmax(axis: axis, keepingDimension: keepingDimension)

    /// The place along the axis of the first least element of each run.
    public fn argmin(axis: Int, keepingDimension: Bool = false) -> Tensor<Int> => self.view.argmin(axis: axis, keepingDimension: keepingDimension)
}

extension Tensor where T: ElementaryFunctions {
    /// The softmax along the axis.
    ///
    /// ```sable
    /// let t = Tensor<F64>(shape: [2, 2], elements: [1, 1, 0, 0])
    /// assert(t.softmax(axis: 1).toArray() == [0.5, 0.5, 0.5, 0.5])
    /// ```
    public fn softmax(axis: Int) -> Tensor<T> => self.view.softmax(axis: axis)
}

extension TensorView where T == F32 {
    /// The sum of every element, by vectors: added in lanes, as
    /// `TensorPrimitives.sum` adds, so not always the left-to-right sum.
    public fn sum() -> F32 => vectorTotal(self, SIMD<F32, f32Step>())

    /// The sums along the axis, by vectors.
    public fn sum(axis: Int, keepingDimension: Bool = false) -> Tensor<F32> => vectorSums(self, axis: axis, keepingDimension: keepingDimension, SIMD<F32, f32Step>())

    /// The means along the axis, by vectors.
    public fn mean(axis: Int, keepingDimension: Bool = false) -> Tensor<F32> {
        let length = F32(shape[normalisedAxis(axis, rank: rank)])
        return vectorSums(self, axis: axis, keepingDimension: keepingDimension, SIMD<F32, f32Step>()) / length
    }
}

extension TensorView where T == F64 {
    /// The sum of every element, by vectors.
    public fn sum() -> F64 => vectorTotal(self, SIMD<F64, f64Step>())

    /// The sums along the axis, by vectors.
    public fn sum(axis: Int, keepingDimension: Bool = false) -> Tensor<F64> => vectorSums(self, axis: axis, keepingDimension: keepingDimension, SIMD<F64, f64Step>())

    /// The means along the axis, by vectors.
    public fn mean(axis: Int, keepingDimension: Bool = false) -> Tensor<F64> {
        let length = F64(shape[normalisedAxis(axis, rank: rank)])
        return vectorSums(self, axis: axis, keepingDimension: keepingDimension, SIMD<F64, f64Step>()) / length
    }
}

extension Tensor where T == F32 {
    /// The sum of every element, by vectors.
    ///
    /// ```sable
    /// let t = Tensor<F32>(shape: [2, 3], elements: [1, 2, 3, 4, 5, 6])
    /// assert(t.sum() == 21 && t.sum(axis: 1).toArray() == [6, 15] && t.sum(axis: 0).toArray() == [5, 7, 9])
    /// ```
    public fn sum() -> F32 => vectorTotal(self.view, SIMD<F32, f32Step>())

    /// The sums along the axis, by vectors.
    public fn sum(axis: Int, keepingDimension: Bool = false) -> Tensor<F32> => vectorSums(self.view, axis: axis, keepingDimension: keepingDimension, SIMD<F32, f32Step>())

    /// The means along the axis, by vectors.
    public fn mean(axis: Int, keepingDimension: Bool = false) -> Tensor<F32> => self.view.mean(axis: axis, keepingDimension: keepingDimension)
}

extension Tensor where T == F64 {
    /// The sum of every element, by vectors.
    public fn sum() -> F64 => vectorTotal(self.view, SIMD<F64, f64Step>())

    /// The sums along the axis, by vectors.
    public fn sum(axis: Int, keepingDimension: Bool = false) -> Tensor<F64> => vectorSums(self.view, axis: axis, keepingDimension: keepingDimension, SIMD<F64, f64Step>())

    /// The means along the axis, by vectors.
    public fn mean(axis: Int, keepingDimension: Bool = false) -> Tensor<F64> => self.view.mean(axis: axis, keepingDimension: keepingDimension)
}
