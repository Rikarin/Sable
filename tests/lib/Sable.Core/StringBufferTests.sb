        buffer.store(utf8: "abcdefghijkl", from: 0, to: 12, at: 0)
    }
}

@test
fn aBufferGrowsByHalfAtLeast() {
    unsafe {
        let buffer = StringBuffer.allocate(capacity: 8)
        buffer.store(utf8: "abcdefgh", from: 0, to: 8, at: 0)
        let little = buffer.growing(used: 8, capacity: 9)
        assertEqual(little.capacity, 12)
        let lots = little.growing(used: 8, capacity: 100)
        assertEqual(lots.capacity, 100)
        let encoded = lots.encode(.HexEncode, U8[>..](repeating: 1, count: 40), at: 8)
        assert(encoded >= 0 && encoded <= 40)
        assertEqual(lots.finish(asciiCount: 8), "abcdefgh")
    }
}
