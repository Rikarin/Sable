module Sable.IO.Compression

/// Brotli decoded, from an input buffer to a window, either of which may be at
/// its end anywhere. What is read is read a part at a time, each from where it
/// starts again if it is not all there: what is past the input's end is zeros.
final class BrotliCore {
    @derive(Equatable)
    enum Stage {
        WindowSize
        MetaBlock
        Metadata
        Uncompressed
        /// The block types of literals, commands and distances.
        BlockTypes
        Parameters
        LiteralMap
        DistanceMap
        /// The prefix codes of literals, commands and distances.
        Codes
        Commands
        Finished
    }

    /// Where the commands are, as they are run.
    @derive(Equatable)
    enum Phase {
        Command
        Literals
        Distance
        Copy
    }

    /// The blocks of one category: literals, commands or distances.
    struct Blocks {
        /// How many types there are, the current one and the one before it,
        /// and how many symbols are left in the block.
        var count: Int = 1
        var type: Int = 0
        var before: Int = 1
        var left: Int = 1 << 24
    }

    static var stepRoom: Int => 65536

    var input: InputBuffer
    var window: OutputWindow
    var stage: Stage
    var phase: Phase
    var problem: String
    /// The bits read from the input and not used, and how many; and whether
    /// more were asked for than there are.
    var bits: U64
    var bitCount: Int
    var overran: Bool
    var produced: Int
    var windowSize: Int
    /// How much of the meta-block is left, and whether it is the last.
    var left: Int
    var isLast: Bool
    /// Which of the three categories, or of the codes, is being read.
    var category: Int
    var tree: Int
    var literals: Blocks
    var commands: Blocks
    var distances: Blocks
    var tailBits: Int
    var direct: Int
    var literalTrees: Int
    var distanceTrees: Int
    /// The last four distances, the last first.
    var distance1: Int
    var distance2: Int
    var distance3: Int
    var distance4: Int
    /// The command being run: how many literals, how long a copy, and how far.
    var insertLeft: Int
    var copyLength: Int
    var copyLeft: Int
    var copyDistance: Int
    var usesLast: Bool
    /// The last two bytes.
    var byte1: Int
    var byte2: Int
    /// The block types' codes and counts' codes, of the three categories; the
    /// context modes of literals, 256; whether each literal type has one code
    /// for all contexts, 256; the two context maps, of 16384 and 1024; and
    /// room to work in.
    let memory: Block
    /// The codes' tables, as many as there are.
    var tables: Block

    init() {
        input = InputBuffer(capacity: 131072)
        window = OutputWindow(history: 0, room: 2 * 65536)
        stage = .WindowSize
        phase = .Command
        problem = ""
        bits = 0
        bitCount = 0
        overran = false
        produced = 0
        windowSize = 0
        left = 0
        isLast = false
        category = 0
        tree = 0
        literals = Blocks()
        commands = Blocks()
        distances = Blocks()
        tailBits = 0
        direct = 0
        literalTrees = 1
        distanceTrees = 1
        distance1 = 4
        distance2 = 11
        distance3 = 15
        distance4 = 16
        insertLeft = 0
        copyLength = 0
        copyLeft = 0
        copyDistance = 0
        usesLast = false
        byte1 = 0
        byte2 = 0
        memory = Block(count: 6 * 4 * brotliLiteralEntries + 512 + 16384 + 1024 + 8192, zeroed: true)
        tables = Block(count: 0)
    }

    fn typeTable(_ category: Int) -> Int {
        return memory.address + 8 * brotliLiteralEntries * category
    }

    fn countTable(_ category: Int) -> Int {
        return memory.address + 8 * brotliLiteralEntries * category + 4 * brotliLiteralEntries
    }

    var modes: Int => memory.address + 24 * brotliLiteralEntries

    var isPlain: Int => memory.address + 24 * brotliLiteralEntries + 256

    var literalMap: Int => memory.address + 24 * brotliLiteralEntries + 512

    var distanceMap: Int => memory.address + 24 * brotliLiteralEntries + 512 + 16384

    var work: Int => memory.address + 24 * brotliLiteralEntries + 512 + 16384 + 1024

    var commandTables: Int => tables.address + 4 * brotliLiteralEntries * literalTrees

    var distanceTables: Int => commandTables + 4 * brotliCommandEntries * commands.count

    fn fail(_ what: String) -> InflateResult {
        problem = what
        return .Failed
    }

    // ---- Bits ----------------------------------------------------------------

    /// So many bits, at most thirty-two.
    @inline(always)
    unsafe fn take(_ count: Int) -> Int {
        if bitCount < count {
            self.refill()
        }
        let value = (bits & (((1 as U64) << ((count & 63) unchecked as U64)) &- 1)) unchecked as Int
        bits = bits >> ((count & 63) unchecked as U64)
        bitCount = bitCount &- count
        return value
    }

    @inline(always)
    unsafe fn refill() {
        if input.position > input.end &+ 8 {
            overran = true
            bitCount = bitCount | 56
            return
        }
        bits = bits | load64(input.position) << ((bitCount & 63) unchecked as U64)
        input.position = input.position &+ ((63 &- bitCount) >> 3)
        bitCount = bitCount | 56
    }

    /// Whether more bits were taken than there are.
    var isPastEnd: Bool => overran || (input.position &- input.end) &* 8 > bitCount

    /// Whole bytes of the bits put back, so that fewer than eight are left.
    fn putBack() {
        input.position = input.position &- (bitCount >> 3)
        bitCount = bitCount & 7
        bits = bits & (((1 as U64) << (bitCount unchecked as U64)) &- 1)
    }

    /// The symbol that comes next in a code.
    @inline(always)
    unsafe fn symbol(_ table: Int) -> Int {
        if bitCount < 15 {
            self.refill()
        }
        var entry = load32(table &+ 4 &* ((bits & 255) unchecked as Int))
        if (entry & 0x8000) != 0 {
            bits = bits >> 8
            bitCount = bitCount &- 8
            let index = bits & (((1 as U64) << ((entry >> 8 & 15) unchecked as U64)) &- 1)
            entry = load32(table &+ 4 &* ((entry >> 16) unchecked as Int &+ (index unchecked as Int)))
        }
        bits = bits >> ((entry & 15) unchecked as U64)
        bitCount = bitCount &- ((entry & 15) unchecked as Int)
        return (entry >> 16) unchecked as Int
    }

    // ---- The stream ----------------------------------------------------------

    /// As much decoded as there is input and room for.
    fn run() -> InflateResult {
        while true {
            if stage == .Finished {
                return .Finished
            }
            if stage == .Commands {
                unsafe {
                    if let stop = self.runCommands() {
                        self.putBack()
                        return stop
                    }
                }
                continue
            }
            if stage == .Uncompressed || stage == .Metadata {
                if let stop = self.copyRaw() {
                    return stop
                }
                continue
            }
            // A part of a header, from where it starts if it is not all there.
            self.putBack()
            let position = input.position
            let savedBits = bits
            let savedCount = bitCount
            overran = false
            unsafe {
                let wrong = self.readHeader()
                if self.isPastEnd {
                    input.position = position
                    bits = savedBits
                    bitCount = savedCount
                    overran = false
                    return .NeedsInput
                }
                if let what = wrong {
                    return self.fail(what)
                }
            }
        }
    }

    /// A part of the stream read, up to what can be read alone: what is wrong,
    /// if anything is, or the input's end was passed.
    unsafe fn readHeader() -> String? {
        let before = stage
        var wrong: String? = none
        match stage {
            case .WindowSize  => { wrong = self.readWindowSize() }
            case .MetaBlock   => { wrong = self.readMetaBlock() }
            case .BlockTypes  => { wrong = self.readBlockTypes() }
            case .Parameters  => { wrong = self.readParameters() }
            case .LiteralMap  => { wrong = self.readMap(literalMap, 64 * literals.count, isLiteral: true) }
            case .DistanceMap => { wrong = self.readMap(distanceMap, 4 * distances.count, isLiteral: false) }
            case .Codes       => { wrong = self.readCode() }
            case _            => { }
        }
        if self.isPastEnd {
            stage = before
        }
        return wrong
    }

    unsafe fn readWindowSize() -> String? {
        var log = 16
        if self.take(1) == 1 {
            log = self.take(3)
            if log != 0 {
                log = 17 + log
            } else {
                log = self.take(3)
                if log == 1 {
                    return "a window of no known size"
                }
                log = log == 0 ? 17 : 8 + log
            }
        }
        if self.isPastEnd {
            return none
        }
        windowSize = (1 << log) - 16
        window.setHistory(windowSize, total: Int.max)
        stage = .MetaBlock
        return none
    }

    unsafe fn readMetaBlock() -> String? {
        let last = self.take(1) == 1
        if last && self.take(1) == 1 {
            return self.endStream()
        }
        let nibbles = self.take(2)
        if nibbles == 3 {
            if self.take(1) != 0 {
                return "a meta-block of no known kind"
            }
            let bytes = self.take(2)
            var size = 0
            var i = 0
            while i < bytes {
                let byte = self.take(8)
                if byte == 0 && i == bytes - 1 && bytes > 1 {
                    return "a length with too many zeros"
                }
                size |= byte << (8 * i)
                i += 1
            }
            if bytes > 0 {
                size += 1
            }
            if self.take(bitCount & 7) != 0 {
                return "bits that should be zero"
            }
            if !self.isPastEnd {
                self.putBack()
                isLast = last
                left = size
                stage = .Metadata
            }
            return none
        }
        var size = 0
        var i = 0
        while i < nibbles + 4 {
            let nibble = self.take(4)
            if nibble == 0 && i == nibbles + 3 && nibbles > 0 {
                return "a length with too many zeros"
            }
            size |= nibble << (4 * i)
            i += 1
        }
        size += 1
        if !last && self.take(1) == 1 {
            if self.take(bitCount & 7) != 0 {
                return "bits that should be zero"
            }
            if !self.isPastEnd {
                self.putBack()
                isLast = false
                left = size
                stage = .Uncompressed
            }
            return none
        }
        if !self.isPastEnd {
            isLast = last
            left = size
            category = 0
            stage = .BlockTypes
        }
        return none
    }

    /// The end of the stream: the last byte's bits are zero.
    unsafe fn endStream() -> String? {
        if self.take(bitCount & 7) != 0 {
            return "bits that should be zero"
        }
        if !self.isPastEnd {
            self.putBack()
            stage = .Finished
        }
        return none
    }

    /// 1 to 256, in one bit to eleven.
    unsafe fn takeCount() -> Int {
        if self.take(1) == 0 {
            return 1
        }
        let width = self.take(3)
        return (1 << width) + 1 + self.take(width)
    }

    unsafe fn readBlockTypes() -> String? {
        let count = self.takeCount()
        var blocks = Blocks()
        blocks.count = count
        if count >= 2 {
            if let wrong = self.readPrefixCode(typeTable(category), count + 2, brotliLiteralEntries) {
                return wrong
            }
            if let wrong = self.readPrefixCode(countTable(category), 26, brotliLiteralEntries) {
                return wrong
            }
            blocks.left = self.takeBlockCount(category)
        }
        if self.isPastEnd {
            return none
        }
        match category {
            case 0 => { literals = blocks }
            case 1 => { commands = blocks }
            case _ => { distances = blocks }
        }
        category += 1
        if category == 3 {
            stage = .Parameters
        }
        return none
    }

    unsafe fn takeBlockCount(_ category: Int) -> Int {
        let code = self.symbol(countTable(category))
        if code > 25 {
            return 1
        }
        return (brotliBlockBases[code] unchecked as Int) + self.take(brotliBlockBits[code] unchecked as Int)
    }

    unsafe fn readParameters() -> String? {
        tailBits = self.take(2)
        direct = self.take(4) << tailBits
        var i = 0
        while i < literals.count {
            store8(self.take(2), modes + i)
            i += 1
        }
        literalTrees = self.takeCount()
        if !self.isPastEnd {
            stage = .LiteralMap
        }
        return none
    }

    /// A context map, if there is more than one code; for the literals' one,
    /// how many codes the distances have follows.
    unsafe fn readMap(_ map: Int, _ size: Int, isLiteral: Bool) -> String? {
        let trees = isLiteral ? literalTrees : distanceTrees
        if trees == 1 {
            fillBytes(map, with: 0, size)
        } else {
            let longest = self.take(1) == 0 ? 0 : 1 + self.take(4)
            let table = work + 4096
            if let wrong = self.readPrefixCode(table, trees + longest, brotliLiteralEntries + 256) {
                return wrong
            }
            var i = 0
            while i < size {
                if bitCount < 32 {
                    self.refill()
                }
                let symbol = self.symbol(table)
                if overran {
                    return none
                }
                if symbol == 0 || symbol > longest {
                    store8(symbol == 0 ? 0 : symbol - longest, map + i)
                    i += 1
                    continue
                }
                let run = (1 << symbol) + self.take(symbol)
                if i + run > size {
                    return "a context map longer than it is"
                }
                fillBytes(map + i, with: 0, run)
                i += run
            }
            if self.take(1) == 1 {
                self.moveToFront(map, size)
            }
        }
        if isLiteral {
            distanceTrees = self.takeCount()
        }
        if self.isPastEnd {
            return none
        }
        if isLiteral {
            var type = 0
            while type < literals.count {
                let first = load8(map + 64 * type)
                var same = true
                var i = 1
                while i < 64 {
                    same = same && load8(map + 64 * type + i) == first
                    i += 1
                }
                store8(same ? 1 : 0, isPlain + type)
                type += 1
            }
            stage = .DistanceMap
        } else {
            tree = 0
            let size = 4 * (brotliLiteralEntries * literalTrees + brotliCommandEntries * commands.count + brotliDistanceEntries * distanceTrees)
            if tables.count < size {
                tables = Block(count: size)
            }
            stage = .Codes
        }
        return none
    }

    unsafe fn moveToFront(_ map: Int, _ size: Int) {
        let order = work
        var i = 0
        while i < 256 {
            store8(i, order + i)
            i += 1
        }
        i = 0
        while i < size {
            var index = load8(map + i)
            let value = load8(order + index)
            store8(value, map + i)
            while index > 0 {
                store8(load8(order + index - 1), order + index)
                index -= 1
            }
            store8(value, order)
            i += 1
        }
    }

    /// The next of the literals', the commands' and the distances' codes.
    unsafe fn readCode() -> String? {
        var wrong: String? = none
        if tree < literalTrees {
            wrong = self.readPrefixCode(tables.address + 4 * brotliLiteralEntries * tree, 256, brotliLiteralEntries)
        } else if tree < literalTrees + commands.count {
            wrong = self.readPrefixCode(commandTables + 4 * brotliCommandEntries * (tree - literalTrees), 704, brotliCommandEntries)
        } else {
            let alphabet = 16 + direct + (48 << tailBits)
            wrong = self.readPrefixCode(distanceTables + 4 * brotliDistanceEntries * (tree - literalTrees - commands.count), alphabet, brotliDistanceEntries)
        }
        if wrong != none || self.isPastEnd {
            return wrong
        }
        tree += 1
        if tree == literalTrees + commands.count + distanceTrees {
            phase = .Command
            stage = .Commands
        }
        return none
    }

    /// A prefix code, as its table.
    unsafe fn readPrefixCode(_ table: Int, _ alphabet: Int, _ room: Int) -> String? {
        let lengths = work + 256
        let scratch = work + 1024
        fillBytes(lengths, with: 0, 704)
        let skipped = self.take(2)
        if skipped == 1 {
            // At most four symbols, written out.
            let width = 64 - (alphabet - 1).leadingZeroCount
            let count = self.take(2) + 1
            var symbols = (0, 0, 0, 0)
            var i = 0
            while i < count {
                let symbol = self.take(width)
                if symbol >= alphabet || load8(lengths + symbol) != 0 {
                    return self.isPastEnd ? none : "a prefix code's symbol that is none"
                }
                store8(1, lengths + symbol)
                match i {
                    case 0 => { symbols.0 = symbol }
                    case 1 => { symbols.1 = symbol }
                    case 2 => { symbols.2 = symbol }
                    case _ => { symbols.3 = symbol }
                }
                i += 1
            }
            if count == 3 {
                store8(2, lengths + symbols.1)
                store8(2, lengths + symbols.2)
            } else if count == 4 {
                let deep = self.take(1) == 1
                store8(deep ? 1 : 2, lengths + symbols.0)
                store8(2, lengths + symbols.1)
                store8(deep ? 3 : 2, lengths + symbols.2)
                store8(deep ? 3 : 2, lengths + symbols.3)
            }
            return buildBrotliTable(table, lengths: lengths, count: alphabet, room: room, work: scratch) ? none : "a prefix code larger than any is"
        }

        // The lengths of the code lengths' own codes, by a code of their own.
        let own = work
        fillBytes(own, with: 0, 18)
        var space = 32
        var used = 0
        var i = skipped
        while i < 18 && space > 0 {
            let next = self.take(2)
            var length = 0
            if next == 0 {
                length = 0
            } else if next == 1 {
                length = 4
            } else if next == 2 {
                length = 3
            } else if self.take(1) == 0 {
                length = 2
            } else {
                length = self.take(1) == 0 ? 1 : 5
            }
            store8(length, own + (brotliLengthOrder[i] unchecked as Int))
            if length != 0 {
                space -= 32 >> length
                used += 1
            }
            i += 1
        }
        if space < 0 || space > 0 && used != 1 {
            return "the lengths of a code's lengths are no code's"
        }
        let ownTable = work + 2752
        if !buildBrotliTable(ownTable, lengths: own, count: 18, room: 256, work: scratch) {
            return "the lengths of a code's lengths are no code's"
        }
        var symbol = 0
        var before = 8
        var repeated = 0
        var repeatedLength = -1
        space = 32768
        while symbol < alphabet && space > 0 {
            let length = self.symbol(ownTable)
            if overran {
                return none
            }
            if length < 16 {
                repeated = 0
                repeatedLength = -1
                store8(length, lengths + symbol)
                symbol += 1
                if length != 0 {
                    before = length
                    space -= 32768 >> length
                }
                continue
            }
            let width = length - 14
            let value = length == 16 ? before : 0
            if repeatedLength != value {
                repeated = 0
                repeatedLength = value
            }
            let old = repeated
            if repeated > 0 {
                repeated = (repeated - 2) << width
            }
            repeated += self.take(width) + 3
            let more = repeated - old
            if symbol + more > alphabet {
                return "the code lengths go on past the last"
            }
            fillBytes(lengths + symbol, with: value unchecked as U8, more)
            symbol += more
            if value != 0 {
                space -= more << (15 - value)
            }
        }
        if space != 0 {
            return "the lengths of a code are no code's"
        }
        return buildBrotliTable(table, lengths: lengths, count: alphabet, room: room, work: scratch) ? none : "a prefix code larger than any is"
    }

    /// Bytes as they are, copied, or passed over.
    fn copyRaw() -> InflateResult? {
        while left > 0 {
            if input.count == 0 {
                return .NeedsInput
            }
            var count = left < input.count ? left : input.count
            if stage == .Uncompressed {
                let room = window.limit - window.end
                if room <= 0 {
                    return .NeedsRoom
                }
                count = count < room ? count : room
                unsafe {
                    copyBytes(from: input.position, to: window.end, count)
                    window.end = window.end + count
                    produced += count
                    byte2 = count > 1 ? load8(window.end - 2) : byte1
                    byte1 = load8(window.end - 1)
                }
            }
            input.position += count
            left -= count
        }
        stage = isLast ? .Finished : .MetaBlock
        return none
    }

    // ---- Commands ------------------------------------------------------------

    /// The next block of a category: its type, and how many symbols it has.
    unsafe fn switchBlock(_ blocks: inout Blocks, _ category: Int) {
        let code = self.symbol(typeTable(category))
        var type = code == 0 ? blocks.before : (code == 1 ? blocks.type + 1 : code - 2)
        if type >= blocks.count {
            type -= blocks.count
        }
        blocks.left = self.takeBlockCount(category)
        blocks.before = blocks.type
        blocks.type = type
    }

    /// The commands of a meta-block run, until its end, which gives none, or
    /// there is no more input, or room. The bits are kept in variables of its
    /// own, but for what is seldom done.
    unsafe fn runCommands() -> InflateResult? {
        let limit = window.limit
        let end = input.end
        let contexts = brotliTables.get() &+ brotliContextStart
        let commandCodes = brotliCommands
        let literalTables = tables.address
        let firstCommandTable = commandTables
        let firstDistanceTable = distanceTables
        let windowSize = self.windowSize
        overran = false
        var position = input.position
        var buffer = bits
        var count = bitCount
        var place = window.end
        // How many bytes there were before the window's end as it was.
        let before = produced &- place
        var stop = InflateResult.NeedsInput
        var ended = false
        while true {
            var savedPosition = position
            var savedBuffer = buffer
            var savedCount = count
            if phase == .Command {
                let saved = commands
                if commands.left == 0 {
                    input.position = position
                    bits = buffer
                    bitCount = count
                    self.switchBlock(&commands, 1)
                    position = input.position
                    buffer = bits
                    count = bitCount
                }
                commands.left = commands.left &- 1
                if count < 48 {
                    buffer = buffer | load64(position) << ((count & 63) unchecked as U64)
                    position = position &+ ((63 &- count) >> 3)
                    count = count | 56
                }
                let table = firstCommandTable &+ 4 &* brotliCommandEntries &* commands.type
                var entry = load32(table &+ 4 &* ((buffer & 255) unchecked as Int))
                if (entry & 0x8000) != 0 {
                    buffer = buffer >> 8
                    count = count &- 8
                    let index = buffer & (((1 as U64) << ((entry >> 8 & 15) unchecked as U64)) &- 1)
                    entry = load32(table &+ 4 &* ((entry >> 16) unchecked as Int &+ (index unchecked as Int)))
                }
                buffer = buffer >> ((entry & 15) unchecked as U64)
                count = count &- ((entry & 15) unchecked as Int)
                let code = commandCodes &+ 8 &* ((entry >> 16) unchecked as Int)
                let low = load32(code)
                let insertBits = (low >> 16 & 31) unchecked as Int
                let copyBits = (low >> 24 & 31) unchecked as Int
                let insert = (low & 0xFFFF) unchecked as Int &+ ((buffer & (((1 as U64) << (insertBits unchecked as U64)) &- 1)) unchecked as Int)
                buffer = buffer >> (insertBits unchecked as U64)
                count = count &- insertBits
                if count < copyBits {
                    buffer = buffer | load64(position) << ((count & 63) unchecked as U64)
                    position = position &+ ((63 &- count) >> 3)
                    count = count | 56
                }
                let copy = load32(code &+ 4) unchecked as Int &+ ((buffer & (((1 as U64) << (copyBits unchecked as U64)) &- 1)) unchecked as Int)
                buffer = buffer >> (copyBits unchecked as U64)
                count = count &- copyBits
                if overran || (position &- end) &* 8 > count {
                    commands = saved
                    position = savedPosition
                    buffer = savedBuffer
                    count = savedCount
                    break
                }
                if insert > left {
                    stop = self.fail("more literals than the meta-block has")
                    break
                }
                insertLeft = insert
                copyLength = copy
                usesLast = low >= 0x8000_0000
                left = left &- insert
                phase = .Literals
            }
            if phase == .Literals {
                // As many at once as are of one block, and there is room for.
                var isShort = false
                while insertLeft > 0 {
                    if literals.left == 0 {
                        let saved = literals
                        savedPosition = position
                        savedBuffer = buffer
                        savedCount = count
                        input.position = position
                        bits = buffer
                        bitCount = count
                        self.switchBlock(&literals, 0)
                        position = input.position
                        buffer = bits
                        count = bitCount
                        if self.isPastEnd {
                            literals = saved
                            position = savedPosition
                            buffer = savedBuffer
                            count = savedCount
                            isShort = true
                            break
                        }
                    }
                    let room = limit &- place
                    if room <= 0 {
                        stop = .NeedsRoom
                        isShort = true
                        break
                    }
                    var most = insertLeft < literals.left ? insertLeft : literals.left
                    most = most < room ? most : room
                    let type = literals.type
                    let map = literalMap &+ 64 &* type
                    let mode = load8(modes &+ type)
                    let start = place
                    let last = place &+ most
                    if load8(isPlain &+ type) != 0 {
                        let table = literalTables &+ 4 &* brotliLiteralEntries &* load8(map)
                        while place < last {
                            if count < 15 {
                                buffer = buffer | load64(position) << ((count & 63) unchecked as U64)
                                position = position &+ ((63 &- count) >> 3)
                                count = count | 56
                            }
                            var entry = load32(table &+ 4 &* ((buffer & 255) unchecked as Int))
                            var used = 0
                            if (entry & 0x8000) != 0 {
                                let index = (buffer >> 8) & (((1 as U64) << ((entry >> 8 & 15) unchecked as U64)) &- 1)
                                entry = load32(table &+ 4 &* ((entry >> 16) unchecked as Int &+ (index unchecked as Int)))
                                used = 8
                            }
                            used = used &+ ((entry & 15) unchecked as Int)
                            if (position &- end) &* 8 > count &- used {
                                isShort = true
                                break
                            }
                            buffer = buffer >> ((used & 63) unchecked as U64)
                            count = count &- used
                            store8((entry >> 16) unchecked as Int, place)
                            place = place &+ 1
                        }
                        let done = place &- start
                        if done > 0 {
                            byte2 = done > 1 ? load8(place &- 2) : byte1
                            byte1 = load8(place &- 1)
                        }
                    } else {
                        var one = byte1
                        var two = byte2
                        // Where the table of each context's is told by the last
                        // byte, and by the one before it.
                        let firstTable = mode == 2 ? contexts : contexts &+ 512
                        let secondTable = mode == 2 ? contexts &+ 256 : contexts &+ 512
                        while place < last {
                            if count < 15 {
                                buffer = buffer | load64(position) << ((count & 63) unchecked as U64)
                                position = position &+ ((63 &- count) >> 3)
                                count = count | 56
                            }
                            var context = 0
                            if mode == 2 {
                                context = load8(firstTable &+ one) | load8(secondTable &+ two)
                            } else if mode == 3 {
                                context = load8(firstTable &+ one) << 3 | load8(secondTable &+ two)
                            } else {
                                context = mode == 0 ? one & 63 : one >> 2
                            }
                            let table = literalTables &+ 4 &* brotliLiteralEntries &* load8(map &+ context)
                            var entry = load32(table &+ 4 &* ((buffer & 255) unchecked as Int))
                            var used = 0
                            if (entry & 0x8000) != 0 {
                                let index = (buffer >> 8) & (((1 as U64) << ((entry >> 8 & 15) unchecked as U64)) &- 1)
                                entry = load32(table &+ 4 &* ((entry >> 16) unchecked as Int &+ (index unchecked as Int)))
                                used = 8
                            }
                            used = used &+ ((entry & 15) unchecked as Int)
                            if (position &- end) &* 8 > count &- used {
                                isShort = true
                                break
                            }
                            buffer = buffer >> ((used & 63) unchecked as U64)
                            count = count &- used
                            two = one
                            one = (entry >> 16) unchecked as Int
                            store8(one, place)
                            place = place &+ 1
                        }
                        byte1 = one
                        byte2 = two
                    }
                    insertLeft = insertLeft &- (place &- start)
                    literals.left = literals.left &- (place &- start)
                    if isShort {
                        break
                    }
                }
                if isShort {
                    break
                }
                if left == 0 {
                    ended = true
                    break
                }
                phase = .Distance
                savedPosition = position
                savedBuffer = buffer
                savedCount = count
            }
            if phase == .Distance {
                if place > limit {
                    stop = .NeedsRoom
                    break
                }
                var distance = distance1
                let produced = before &+ place
                let reach = produced < windowSize ? produced : windowSize
                if !usesLast {
                    let saved = distances
                    if distances.left == 0 {
                        input.position = position
                        bits = buffer
                        bitCount = count
                        self.switchBlock(&distances, 2)
                        position = input.position
                        buffer = bits
                        count = bitCount
                    }
                    distances.left = distances.left &- 1
                    if count < 40 {
                        buffer = buffer | load64(position) << ((count & 63) unchecked as U64)
                        position = position &+ ((63 &- count) >> 3)
                        count = count | 56
                    }
                    let context = copyLength > 4 ? 3 : copyLength &- 2
                    let table = firstDistanceTable &+ 4 &* brotliDistanceEntries &* load8(distanceMap &+ 4 &* distances.type &+ context)
                    var entry = load32(table &+ 4 &* ((buffer & 255) unchecked as Int))
                    if (entry & 0x8000) != 0 {
                        buffer = buffer >> 8
                        count = count &- 8
                        let index = buffer & (((1 as U64) << ((entry >> 8 & 15) unchecked as U64)) &- 1)
                        entry = load32(table &+ 4 &* ((entry >> 16) unchecked as Int &+ (index unchecked as Int)))
                    }
                    buffer = buffer >> ((entry & 15) unchecked as U64)
                    count = count &- ((entry & 15) unchecked as Int)
                    let code = (entry >> 16) unchecked as Int
                    if code >= 16 &+ direct {
                        let rest = code &- direct &- 16
                        let width = 1 &+ (rest >> (tailBits &+ 1))
                        let high = rest >> tailBits
                        let offset = ((2 &+ (high & 1)) << width) &- 4
                        let extra = (buffer & (((1 as U64) << ((width & 63) unchecked as U64)) &- 1)) unchecked as Int
                        buffer = buffer >> ((width & 63) unchecked as U64)
                        count = count &- width
                        distance = ((offset &+ extra) << tailBits) &+ (rest & ((1 << tailBits) &- 1)) &+ direct &+ 1
                    } else if code >= 16 {
                        distance = code &- 15
                    } else {
                        distance = code < 4 ? (code == 0 ? distance1 : (code == 1 ? distance2 : (code == 2 ? distance3 : distance4))) : (code < 10 ? distance1 : distance2)
                        if code >= 4 {
                            let step = ((code &- 4) % 6) >> 1
                            distance = (code & 1) == 0 ? distance &- step &- 1 : distance &+ step &+ 1
                        }
                        usesLast = code == 0
                    }
                    if overran || (position &- end) &* 8 > count {
                        distances = saved
                        usesLast = false
                        position = savedPosition
                        buffer = savedBuffer
                        count = savedCount
                        break
                    }
                    if distance <= 0 {
                        stop = self.fail("a distance of none")
                        break
                    }
                }
                if distance > reach {
                    let size = self.writeWord(distance &- reach &- 1, place)
                    if size < 0 {
                        stop = .Failed
                        break
                    }
                    left = left &- size
                    place = place &+ size
                    if size > 0 {
                        byte2 = size > 1 ? load8(place &- 2) : byte1
                        byte1 = load8(place &- 1)
                    }
                    phase = .Command
                    if left == 0 {
                        ended = true
                        break
                    }
                    continue
                }
                if copyLength > left {
                    stop = self.fail("a copy longer than the meta-block has room for")
                    break
                }
                if !usesLast {
                    distance4 = distance3
                    distance3 = distance2
                    distance2 = distance1
                    distance1 = distance
                }
                left = left &- copyLength
                copyLeft = copyLength
                copyDistance = distance
                phase = .Copy
            }
            let room = limit &- place
            if copyLeft > room {
                if room > 0 {
                    copyMatch(to: place, distance: copyDistance, length: room)
                    place = place &+ room
                    copyLeft = copyLeft &- room
                }
                stop = .NeedsRoom
                break
            }
            copyMatch(to: place, distance: copyDistance, length: copyLeft)
            place = place &+ copyLeft
            byte2 = load8(place &- 2)
            byte1 = load8(place &- 1)
            phase = .Command
            if left == 0 {
                ended = true
                break
            }
        }
        input.position = position
        bits = buffer
        bitCount = count
        produced = before &+ place
        window.end = place
        overran = false
        return ended ? self.endMetaBlock() : stop
    }

    fn endMetaBlock() -> InflateResult? {
        if !isLast {
            stage = .MetaBlock
            return none
        }
        unsafe {
            if let wrong = self.endStream() {
                return self.fail(wrong)
            }
        }
        return none
    }

    /// A word of the static dictionary put at an address, transformed: how many
    /// bytes it is, or -1 where there is no such word.
    unsafe fn writeWord(_ id: Int, _ place: Int) -> Int {
        if copyLength < 4 || copyLength > 24 {
            problem = "a word of no known length"
            return -1
        }
        let width = load32(brotliWords &+ 8 &* copyLength) unchecked as Int
        let transform = id >> width
        if transform > 120 {
            problem = "a word transformed in no known way"
            return -1
        }
        let count = writeBrotliWord(place, length: copyLength, index: id & ((1 << width) &- 1), transform: transform)
        if count > left {
            problem = "a word longer than the meta-block has room for"
            return -1
        }
        return count
    }
}
