module Sable.Collections

/// First in, first out: what goes in at the back comes out at the front. A
/// Deque used at one end each, with the names a queue's use has.
///
/// ```sable
/// let queue = Queue<String>()
/// queue.enqueue("a")
/// queue.enqueue("b")
/// assert(queue.dequeue() == "a" && queue.peek() == "b")
/// ```
public class Queue<Element> {
    let items: Deque<Element>

    /// An empty queue.
    public init() {
        items = Deque<Element>()
    }

    /// The sequence's elements, the first of them first out. What going
    /// through them throws, it throws.
    public init<S: Sequence>(_ elements: S) throws(S.Failure) where S.Element == Element {
        items = try Deque<Element>(elements)
    }

    /// How many elements it holds.
    public var count: Int => items.count

    /// Whether it holds none.
    public var isEmpty: Bool => items.isEmpty

    /// Adds the element at the back.
    public fn enqueue(_ item: Element) {
        items.append(item)
    }

    /// The element at the front, taken out; none when it is empty.
    public fn dequeue() -> Element? {
        return items.removeFirst()
    }

    /// The element at the front, left where it is; none when it is empty.
    public fn peek() -> Element? {
        return items.first
    }

    /// Every element taken out.
    public fn removeAll() {
        items.removeAll()
    }

    /// Room for at least so many elements.
    public fn reserveCapacity(_ minimumCapacity: Int) {
        items.reserveCapacity(minimumCapacity)
    }
}

extension Queue: Sequence, FromSequence<Element> {
    /// The elements, the next out first.
    public fn makeIterator() -> DequeIterator<Element> {
        return items.makeIterator()
    }
}
