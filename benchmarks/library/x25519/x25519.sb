module X25519Bench

// X25519 against .NET's X25519DiffieHellman: 2000 agreements.

import Sable.Crypto
import Sable.Testing

fn run(_ mine: X25519PrivateKey, _ theirs: X25519PublicKey) -> String {
    var count = 0
    var round = 0
    while round < 2000 {
        count += try! mine.sharedSecret(with: theirs).byteCount
        round += 1
    }
    return "\(count)"
}

@bench
fn measure(_ b: Bencher) {
    let mine = X25519PrivateKey.generate()
    let yours = X25519PrivateKey.generate()
    let theirs = yours.publicKey
    b.check(b.iterate { run(mine, theirs) })
}
