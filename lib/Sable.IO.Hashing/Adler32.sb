module Sable.IO.Hashing

/// Adler-32, zlib's checksum (RFC 1950): two sums of the bytes modulo 65521,
/// the second of the first's running values. Thirty-two bytes a step, in
/// vectors.
///
/// ```sable
/// assert(Adler32.hash("Wikipedia".utf8Bytes()) == 0x11E60398)
/// var adler = Adler32()
/// adler.update(utf8: "Wiki")
/// adler.update(utf8: "pedia")
/// assert(adler.value == 0x11E60398)
/// assert(adler.hashBytes() == [0x11, 0xE6, 0x03, 0x98])
/// ```
public struct Adler32: NonCryptographicHash {
    var low: U32
    var high: U32

    /// Nothing given yet.
    public init() {
        low = 1
        high = 0
    }

    /// Four bytes.
    public static var hashByteCount: Int => 4

    /// The checksum of every byte given so far.
    public var value: U32 => high << 16 | low

    /// The checksum of the bytes, at once.
    public static fn hash(_ bytes: U8[:]) -> U32 {
        var adler = Adler32()
        adler.update(bytes)
        return adler.value
    }

    public mutating fn update(_ bytes: U8[:]) {
        let before = self
        self = bytes.withPointer { (start: RawPtr<U8>) -> Adler32 in
            var after = before
            unsafe {
                after.update(at: start.address, count: bytes.count)
            }
            return after
        }
    }

    /// The bytes at an address, after those already given: for the library's
    /// codecs, which work in memory of their own.
    package unsafe mutating fn update(at address: Int, count: Int) {
        var a = low
        var b = high
        var at = address
        var left = count
        while left > 0 {
            // As many as cannot overflow: 5552 is the most, a multiple of 16.
            let run = left < 5536 ? left : 5536
            left = left &- run
            let whole = run & ~31
            if whole > 0 {
                let (sum, weighted) = adlerChunks(at, whole)
                b = b &+ (whole unchecked as U32) &* a &+ weighted
                a = a &+ sum
                at = at &+ whole
            }
            var rest = run &- whole
            while rest > 0 {
                a = a &+ (load8(at) unchecked as U32)
                b = b &+ a
                at = at &+ 1
                rest = rest &- 1
            }
            a = a % 65521
            b = b % 65521
        }
        low = a
        high = b
    }

    public mutating fn reset() {
        low = 1
        high = 0
    }

    /// The checksum as four bytes, the most significant first, as zlib
    /// stores it.
    public fn hashBytes() -> U8[>..] => value.bigEndianBytes()
}

/// Of the bytes at an address, a multiple of 32 and at most 5536 of them: the
/// sum of the bytes, and the sum of each times how many bytes from it to the
/// end, itself counted. Each lane of a vector keeps its own sums: of its bytes,
/// of those sums before each step (each a step further from the end), and of
/// its bytes times their place from a step's end.
@inline(always)
unsafe fn adlerChunks(_ address: Int, _ count: Int) -> (U32, U32) {
    let places = SIMD<U16, 32>(repeating: 32) &- SIMD<U16, 32>.sequence(start: 0, step: 1)
    var sums = SIMD<U32, 32>()
    var before = SIMD<U32, 32>()
    var weighted = SIMD<U32, 32>()
    var at = address
    let end = address &+ count
    while at < end {
        let bytes = SIMD<U16, 32>.converting(RawPtr<U8>(address: at).load(as: SIMD<U8, 32>.self))
        before = before &+ sums
        sums = sums &+ SIMD<U32, 32>.converting(bytes)
        weighted = weighted &+ SIMD<U32, 32>.converting(bytes &* places)
        at = at &+ 32
    }
    return (sums.reduceAdd(), before.reduceAdd() &* 32 &+ weighted.reduceAdd())
}
