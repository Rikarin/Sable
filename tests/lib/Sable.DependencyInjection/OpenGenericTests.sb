module OpenGenericTests

import Sable.DependencyInjection
import Sable.Testing

import InjectionSupport

@injectable
final class Orders {
    let repository: any Repository<Order>
    init(repository: any Repository<Order>) { self.repository = repository }
}

fn opened() -> ServiceCollection {
    var services = ServiceCollection()
    services.addScoped(open: Repository.self, MemoryRepository.self)
    services.addTransient(open: Log.self, Log.self)
    services.addScoped(Connection.self)
    return services
}

@test
fn anOpenGenericIsClosedAsItIsAskedFor() {
    var services = opened()
    services.addScoped(Orders.self)
    (try! services.build()).withScope { scope in
        let orders = try! scope.resolve(Orders.self)
        assertEqual(orders.repository.describe(), "InjectionSupport.Order by InjectionSupport.MemoryRepository<InjectionSupport.Order>")
        expect(orders.repository.first() == none)
        let again = try! scope.resolve((any Repository<Order>).self) as! MemoryRepository<Order>
        expect(again === (orders.repository as! MemoryRepository<Order>))
        expect(again.isOn(try! scope.resolve(Connection.self)))
    }
}

@test
fn aClosedRegistrationIsGivenBeforeAnOpenOne() {
    var services = opened()
    services.addScoped((any Repository<Int>).self) { scope in
        MemoryRepository<Int>(connection: Connection(), log: try scope.resolve(Log<MemoryRepository<Int>>.self))
    }
    (try! services.build()).withScope { scope in
        let given = try! scope.resolve((any Repository<Int>).self) as! MemoryRepository<Int>
        expect(!given.isOn(try! scope.resolve(Connection.self)))
        assertEqual((try! scope.resolveAll((any Repository<String>).self)).count, 1)
    }
}

@test
fn anOpenGenericOfATypeNoCodeNames() {
    var services = opened()
    services.addTransient(open: MemoryRepository.self, MemoryRepository.self)
    let wanted = MemoryRepository.self.instantiate([Bool.self])!
    (try! services.build()).withScope { scope in
        let given = try! scope.resolve(wanted)
        assertEqual("\(type(of: given))", "InjectionSupport.MemoryRepository<Bool>")
    }
}

@test
fn anOpenGenericsOwnDependenciesAreChecked() {
    var services = ServiceCollection()
    services.addScoped(open: Repository.self, MemoryRepository.self)
    services.addScoped(Orders.self)
    let said = problems(services)
    expect(said.contains("nothing provides InjectionSupport.Connection: OpenGenericTests.Orders -> any InjectionSupport.Repository<InjectionSupport.Order> -> InjectionSupport.Connection"), said)
}

@test
fn anOpenSingletonMayNotHoldAScopedService() {
    var services = ServiceCollection()
    services.addSingleton(open: Repository.self, MemoryRepository.self)
    services.addTransient(open: Log.self, Log.self)
    services.addScoped(Connection.self)
    services.addTransient(Orders.self)
    expect(problems(services).contains("a singleton would hold a scoped service: any InjectionSupport.Repository"))
}

protocol Holder<Item> { }

protocol Sized {
    fn size() -> Int
}

@injectable
final class SizedHolder<Item: Sized>: Holder<Item> {
    init() { }
}

final class Plain<Item>: Holder<Item> { }

@injectable
final class WantsHolder {
    init(_holder: any Holder<Int>) { }
}

@test
fn aConstraintThatIsNotMetIsSaid() {
    var services = ServiceCollection()
    services.addTransient(open: Holder.self, SizedHolder.self)
    services.addTransient(WantsHolder.self)
    assertEqual(problems(services), "the services cannot be provided: any OpenGenericTests.Holder<Int> cannot be made from OpenGenericTests.SizedHolder: a type argument does not meet its constraints")
}

@test
fn anImplementationMustBeInjectable() {
    var services = ServiceCollection()
    services.addTransient(open: Holder.self, Plain.self)
    services.addTransient(WantsHolder.self)
    assertEqual(problems(services), "the services cannot be provided: OpenGenericTests.Plain<Int>, registered for any OpenGenericTests.Holder<Int>, is not one")
}

@test
fn anOpenSingletonIsOneForEachType() {
    var services = ServiceCollection()
    services.addSingleton(open: Log.self, Log.self)
    let provider = try! services.build()
    expect((try! provider.resolve(Log<Int>.self)) === (try! provider.resolve(Log<Int>.self)))
    assertEqual((try! provider.resolve(Log<String>.self)).category(), "String")
}

@test
fn anOpenGenericMayBeKeyed() {
    var services = ServiceCollection()
    services.addTransient(open: Log.self, Log.self, key: "k")
    let provider = try! services.build()
    expect((try! provider.find(Log<Int>.self)) == none)
    assertEqual((try! provider.resolve(Log<Int>.self, key: "k")).category(), "Int")
}
