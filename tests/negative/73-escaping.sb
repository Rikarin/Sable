module Negative.Escaping

// A closure parameter without '@escaping' may only be called, or passed on
// to another that does not escape; and no closure captures the caller's
// storage (#125).

struct Keeper { var run: () -> Int }

fn call(_ f: () -> Int) -> Int { return f() }
fn keep(_ f: @escaping () -> Int) -> Keeper { return Keeper(run: f) }
fn keepToo(@escaping _ f: () -> Int) -> () -> Int { return f }

fn returned(_ f: () -> Int) -> () -> Int {
    return f                            //! S3205 'f' is a closure that is not @escaping
}

fn stored(_ f: () -> Int) -> Keeper {
    return Keeper(run: f)               //! S3205 so it can only be called
}

fn passedToEscaping(_ f: () -> Int) -> Keeper {
    return keep(f)                      //! S3205 so it can only be called
}

fn capturedByAnEscapingClosure(_ f: () -> Int) -> () -> Int {
    return () => f() + 1                //! S3205 a closure that may outlive the call cannot capture it
}

fn calledAndPassedOn(_ f: () -> Int) -> Int {
    let g = f
    return f() + call(f) + call(() => f() + 1) + g()
}

fn aLetNamingOneDoesNotEscapeEither(_ f: () -> Int) -> () -> Int {
    let g = f
    return g                            //! S3205 'g' is a closure that is not @escaping
}

fn aReferenceIsNotCaptured(_ x: Int&) -> Int {
    return call(() => x + 1)            //! S3205 'x' is a reference, the caller's storage
}

fn outIsNotCaptured(out x: Int) {
    x = 1
    let read = () => x                  //! S3205 'x' is out, the caller's storage
}

// A mutating member's self may be changed by a closure that does not
// escape, which runs during the call; one that may escape could change it
// after the call is over, so it may not.
fn increment(_ x: inout Int) { x += 1 }

struct Tally {
    var n: Int

    mutating fn bump() { n += 1 }

    mutating fn later() -> () -> Int {
        return () => {
            n += 1                      //! S3205 a closure that may outlive the call cannot change 'self'
            return n
        }
    }

    mutating fn laterByCall() -> () -> Int {
        return () => {
            bump()                      //! S3205 a closure that may outlive the call cannot change 'self'
            return n
        }
    }

    mutating fn keptForLater() -> Keeper {
        return keep(() => {
            self.n = 0                  //! S3205 a closure that may outlive the call cannot change 'self'
            return 1
        })
    }

    mutating fn inALocalFunction() {
        fn reset() {
            n = 0                       //! S3010 the left side of an assignment must be a mutable binding
        }
        reset()
    }

    mutating fn laterByInout() -> () -> Void {
        return () => {
            increment(&n)               //! S3205 a closure that may outlive the call cannot change 'self'
        }
    }

    mutating fn readingIsFine() -> () -> Int {
        return () => n + 1
    }

    fn notMutating() -> Int {
        return call(() => {
            n += 1                      //! S3010 the left side of an assignment must be a mutable binding
            return n
        })
    }
}

// '@escaping' is part of a function type: '(@escaping () -> Int) -> ()' may
// keep the closure it is given, and fits only where that is wanted; a closure
// of '(() -> Int) -> ()' may not keep its own.
final class Holder {
    var kept: (() -> Int)? = none

    fn hold(_ f: @escaping () -> Int) { kept = f }
    fn look(_ f: () -> Int) -> Int { return f() }
}

fn functionTypes(_ holder: Holder) {
    let keeps: (@escaping () -> Int) -> () = holder.hold
    let looks: (@escaping () -> Int) -> Int = holder.look
    let lends: (() -> Int) -> () = holder.hold   //! S3004 this function does not have the type wanted here
    let stores: (() -> Int) -> () = { f in holder.kept = f }   //! S3205 'f' is a closure that is not @escaping
    let storesToo: (() -> Int) -> () = { holder.kept = $0 }   //! S3205 '$0' is a closure that is not @escaping
    let mayStore: (@escaping () -> Int) -> () = { f in holder.kept = f }
    let says: (@escaping () -> Int) -> () = { (f: @escaping () -> Int) in holder.kept = f }
    let saysNot: (() -> Int) -> () = { (f: @escaping () -> Int) in holder.kept = f }   //! S3004 expected '(() -> Int) -> Void' but found '(@escaping () -> Int) -> Void'
}

fn passedOnThroughAClosure(_ f: () -> Int, _ run: (() -> Int) -> Int) -> Int {
    return run(f) + run(() => f() + 1)
}

fn notAClosure(_ run: (@escaping Int) -> Int) { }   //! S3093 '@escaping' applies to a closure parameter

// An override or a conformance may not add '@escaping' (S3210): a call
// through the original lends its closure only for the call.
protocol Runner {
    fn run(_ f: () -> Int) -> Int
    fn later(_ f: @escaping () -> Int)
}

final class KeepingRunner: Runner {
    var kept: (() -> Int)? = none
    fn run(_ f: @escaping () -> Int) -> Int { return f() }   //! S3210 'KeepingRunner.run' meets 'Runner.run', whose 'f' is not '@escaping'
    fn later(_ f: () -> Int) { }
}

class Base {
    fn run(_ f: () -> Int) -> Int { return f() }
    fn later(_ f: @escaping () -> Int) { }
}

class Derived: Base {
    override fn run(_ f: @escaping () -> Int) -> Int { return f() }   //! S3210 'Derived.run' overrides 'Base.run', whose 'f' is not '@escaping'
    override fn later(_ f: () -> Int) { }
}
