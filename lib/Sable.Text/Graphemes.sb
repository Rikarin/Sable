module Sable.Text

// Extended grapheme clusters (UAX #29): what a reader takes for one
// character, however many scalars it is written with. 'é' written as 'e' and
// U+0301 is one, a flag (two regional indicators) is one, a family emoji
// (people joined by U+200D) is one, a Hangul syllable written as its jamo is
// one, and "\r\n" is one. The rules are Unicode 16's, the properties from
// UnicodeTextTables.sb.

extension String {
    /// The extended grapheme clusters, each as a Substring of the string:
    /// the user-perceived characters.
    ///
    /// ```sable
    /// var clusters: String[>..] = []
    /// for cluster in "e\u{301}🇨🇿!".graphemes {
    ///     clusters.append(cluster.toString())
    /// }
    /// assert(clusters == ["e\u{301}", "🇨🇿", "!"])
    /// ```
    public var graphemes: GraphemeView => GraphemeView { text: self }

    /// How many extended grapheme clusters there are: the length a reader
    /// sees.
    ///
    /// ```sable
    /// assert("🇨🇿".count == 2)
    /// assert("🇨🇿".graphemeCount == 1)
    /// ```
    public var graphemeCount: Int {
        get {
            var clusters = 0
            var offset = 0
            while offset < self.utf8Count {
                offset = clusterEnd(self, offset)
                clusters = clusters + 1
            }
            return clusters
        }
    }

    /// Where the grapheme cluster that starts at the index ends: the index
    /// of the next one, or the end.
    public fn graphemeEnd(from index: String.Index) -> String.Index {
        return String.Index(utf8Offset: clusterEnd(self, index.utf8Offset))
    }
}

/// A string's extended grapheme clusters: `String.graphemes`.
public struct GraphemeView: Sequence {
    public alias Element = Substring
    public alias Iter = GraphemeIterator

    let text: String

    public fn makeIterator() -> GraphemeIterator {
        return GraphemeIterator { text: text, offset: 0 }
    }
}

/// Gives a string's grapheme clusters from the first.
public struct GraphemeIterator: Iterator {
    let text: String
    var offset: Int

    public mutating fn next() -> Substring? {
        if offset >= text.utf8Count {
            return none
        }
        let end = clusterEnd(text, offset)
        let cluster = text[String.Index(utf8Offset: offset)..<String.Index(utf8Offset: end)]
        offset = end
        return cluster
    }
}

/// What is known of a cluster as its scalars are read, for the rules that
/// look back past the scalar before: GB9c, GB11, GB12 and GB13.
struct GraphemeState {
    // GB11: 1 after an Extended_Pictographic and any Extend after it, 2
    // when a ZWJ follows those.
    var emoji: Int = 0
    // GB9c: 1 after an InCB=Consonant and any InCB=Extend or Linker after
    // it, 2 once a Linker is among those.
    var conjunct: Int = 0
    // GB12, GB13: how many regional indicators in a row end here.
    var indicators: Int = 0

    mutating fn read(_ value: Int) {
        let kind = value % 16
        let conjunctKind = value / 32
        if (value / 16) % 2 == 1 {
            emoji = 1
        } else if emoji == 1 && kind == graphemeBreakExtend {
            emoji = 1
        } else if emoji == 1 && kind == graphemeBreakZWJ {
            emoji = 2
        } else {
            emoji = 0
        }
        if conjunctKind == indicConjunctConsonant {
            conjunct = 1
        } else if conjunct > 0 && conjunctKind == indicConjunctLinker {
            conjunct = 2
        } else if conjunct == 0 || conjunctKind != indicConjunctExtend {
            conjunct = 0
        }
        indicators = kind == graphemeBreakRegionalIndicator ? indicators + 1 : 0
    }
}

/// Where the cluster that starts at the byte offset ends.
fn clusterEnd(_ text: String, _ start: Int) -> Int {
    let end = text.utf8Count
    var index = String.Index(utf8Offset: start)
    var previous = graphemeBreakOf(text[index].codePoint)
    var state = GraphemeState()
    state.read(previous)
    index = text.index(after: index)
    while index.utf8Offset < end {
        let value = graphemeBreakOf(text[index].codePoint)
        if graphemeBreaks(previous, value, state) {
            return index.utf8Offset
        }
        state.read(value)
        previous = value
        index = text.index(after: index)
    }
    return end
}

/// Whether the rules break between a scalar of the property 'before' and
/// one of 'after', the cluster so far being as the state says.
fn graphemeBreaks(_ before: Int, _ after: Int, _ state: GraphemeState) -> Bool {
    let left = before % 16
    let right = after % 16
    if left == graphemeBreakCR && right == graphemeBreakLF {
        return false // GB3
    }
    if left == graphemeBreakControl || left == graphemeBreakCR || left == graphemeBreakLF {
        return true // GB4
    }
    if right == graphemeBreakControl || right == graphemeBreakCR || right == graphemeBreakLF {
        return true // GB5
    }
    if left == graphemeBreakL && (right == graphemeBreakL || right == graphemeBreakV || right == graphemeBreakLV || right == graphemeBreakLVT) {
        return false // GB6
    }
    if (left == graphemeBreakLV || left == graphemeBreakV) && (right == graphemeBreakV || right == graphemeBreakT) {
        return false // GB7
    }
    if (left == graphemeBreakLVT || left == graphemeBreakT) && right == graphemeBreakT {
        return false // GB8
    }
    if right == graphemeBreakExtend || right == graphemeBreakZWJ || right == graphemeBreakSpacingMark {
        return false // GB9, GB9a
    }
    if left == graphemeBreakPrepend {
        return false // GB9b
    }
    if after / 32 == indicConjunctConsonant && state.conjunct == 2 {
        return false // GB9c
    }
    if (after / 16) % 2 == 1 && state.emoji == 2 {
        return false // GB11
    }
    if left == graphemeBreakRegionalIndicator && right == graphemeBreakRegionalIndicator && state.indicators % 2 == 1 {
        return false // GB12, GB13
    }
    return true // GB999
}
