module ParallelStress

import Sable.Concurrency

// Parallel loops and collections, from the main thread, from tasks and from
// threads of the program's own, nested and failing, for ThreadSanitizer
// (tools/tsan/run.sh).

struct Stop: Error { }

@main
fn main() async {
    let total = Atomic(0)
    for round in 0..<10 {
        let numbers = (0..<20_000).map { ($0 &* 7919 &+ round) % 10_007 }
        let texts = numbers.parallel.map { "n\($0)" }
        total.add(texts.parallel.sum { $0.count })
        total.add(texts.parallel.filter { $0.count > 3 }.count)
        total.add(texts.parallel.sorted()[100].count)
        var changed = texts
        changed.parallelModify { $0 += "!" }
        changed.parallelModifyChunks(of: 100) { chunk in
            chunk.swapAt(0, chunk.count - 1)
        }
        total.add(changed.count)
        total.add(numbers.parallel.first { $0 == 5000 } ?? 0)
        do {
            _ = try texts.parallel.map { (text: String) throws -> String in
                if text == "n77" {
                    throw Stop()
                }
                return text + "?"
            }
        } catch {
            total.add(1)
        }
        parallelFor(0..<20) { i in
            parallelFor(0..<20) { j in
                total.add((0..<50).parallel.sum { $0 } + i + j)
            }
        }
        let tasks = (0..<10).map { n in
            Task.spawn { numbers.parallel.sum { $0 + n } }
        }
        let threads = (0..<4).map { n in
            Thread.spawn { texts.parallel.count { $0.count == n } }
        }
        for task in tasks {
            total.add(await task.value)
        }
        for thread in threads {
            total.add(await thread.value())
        }
    }
    print(total.load() > 0)
}
