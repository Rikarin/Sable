        PatternCase { moment: 5, pattern: "ss.F", expected: "10.1" },
        PatternCase { moment: 5, pattern: "ss.FF", expected: "10.1" },
        PatternCase { moment: 5, pattern: "'Week of' MMMM d", expected: "Week of October 10" },
        PatternCase { moment: 5, pattern: "\"quoted\" yyyy", expected: "quoted 2010" },
        PatternCase { moment: 5, pattern: "\\d\\a\\y d", expected: "day 10" },
        PatternCase { moment: 5, pattern: "yyyy'\\''MM", expected: "2010'10" },
        PatternCase { moment: 5, pattern: "HH\\hmm", expected: "10h10" },
        PatternCase { moment: 5, pattern: "%d%M", expected: "1010" },
        PatternCase { moment: 5, pattern: "dMyy", expected: "101010" },
        PatternCase { moment: 5, pattern: "yyyyMMddHHmmss", expected: "20101010101010" },
        PatternCase { moment: 5, pattern: "g yyyy", expected: "A.D. 2010" },
        PatternCase { moment: 5, pattern: "dd MMM yyyy HH:mm:ss zzz", expected: "10 Oct 2010 10:10:10 +12:45" },
        PatternCase { moment: 5, pattern: "hh:mm tt zz", expected: "10:10 AM +12" },
        PatternCase { moment: 5, pattern: "K yyyy", expected: "+12:45 2010" },
        PatternCase { moment: 5, pattern: "yy-M-d H:m:s", expected: "10-10-10 10:10:10" },
        PatternCase { moment: 5, pattern: "[yyyy]", expected: "[2010]" },
        PatternCase { moment: 5, pattern: "MMMM yyyy", expected: "October 2010" },
        PatternCase { moment: 5, pattern: "dddd", expected: "Sunday" },
        PatternCase { moment: 5, pattern: "hh 'o''clock' tt", expected: "10 oclock AM" },
        PatternCase { moment: 5, pattern: "yyyy-MM-ddTHH:mm:ss.fffffffzzz", expected: "2010-10-10T10:10:10.1000000+12:45" },
        PatternCase { moment: 5, pattern: "yyyy/MM/dd", expected: "2010/10/10" },
    ]
}

@test
fn everyPatternWritesWhatDotNetWrites() {
    let all = cases()
    assertEqual(all.count, 624)
    for c in all {
        let written = moment(c.moment).format(pattern: c.pattern)
        assert(written == c.expected, "pattern \(c.pattern) of moment \(c.moment): \(written), not \(c.expected)")
    }
}
