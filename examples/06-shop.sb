module Examples.Shop

import Sable.Concurrency
import Sable.DependencyInjection

// ---------------------------------------------------------------------------
// A shop put together by a container: each type says what it is made from by
// its initialiser, and how long it lives. '@container' writes the code that
// makes them, and what is missing, or would be held for too long, or leads
// back to itself, does not compile. A ServiceCollection makes the same shop
// as the program runs, here with another clock.
// ---------------------------------------------------------------------------

/// What happens, as it does.
@immutable
@injectable(.Singleton)
final class Journal {
    let lines: Mutex<String[>..]>

    init() {
        lines = Mutex([])
    }

    fn note(_ line: String) {
        lines.withLock { $0.append(line) }
    }

    fn report() {
        for line in lines.withLock({ $0 }) {
            print("  \(line)")
        }
    }
}

protocol Clock: Sendable {
    fn now() -> Int
}

struct StoppedClock: Clock {
    let time: Int
    fn now() -> Int { return time }
}

/// A logger for each type that logs: an open generic.
@immutable
@injectable(.Singleton)
final class Logger<Category> {
    let journal: Journal
    let clock: any Clock

    init(journal: Journal, clock: any Clock) {
        self.journal = journal
        self.clock = clock
    }

    fn info(_ text: String) {
        journal.note("\(clock.now()) \(Category.self): \(text)")
    }
}

/// Where things are kept.
protocol Repository<Item> {
    fn add(_ item: Item)
    fn count() -> Int
}

/// A transaction: begun with the request, committed as its scope ends.
@injectable(.Scoped)
final class Transaction: Disposable {
    let log: Logger<Transaction>
    var changes: Int = 0

    init(log: Logger<Transaction>) {
        self.log = log
        log.info("begun")
    }

    fn dispose() {
        log.info("committed, \(changes) changed")
    }
}

@injectable(.Scoped, as: Repository.self)
final class MemoryRepository<Item>: Repository<Item> {
    let transaction: Transaction
    let log: Logger<MemoryRepository<Item>>
    var items: Item[>..] = []

    init(transaction: Transaction, log: Logger<MemoryRepository<Item>>) {
        self.transaction = transaction
        self.log = log
    }

    fn add(_ item: Item) {
        items.append(item)
        transaction.changes += 1
        log.info("\(items.count) kept")
    }

    fn count() -> Int { return items.count }
}

struct Order {
    let item: String
}

struct Receipt {
    let total: Int
}

/// What is taken off a price.
protocol Discount {
    fn off(_ price: Int) -> Int
}

@injectable(.Transient, as: Discount.self)
struct Regular: Discount {
    fn off(_ price: Int) -> Int { return price / 10 }
}

@injectable(.Transient, as: Discount.self)
struct Seasonal: Discount {
    @keyed("season")
    let amount: Int
    fn off(_ price: Int) -> Int { return amount }
}

/// Where prices are in, read before anything is sold.
struct Prices: Sendable {
    let currency: String
}

struct Sms { }

@injectable(.Scoped)
final class Checkout {
    let orders: any Repository<Order>
    let receipts: any Repository<Receipt>
    let discounts: (any Discount)[]
    let log: Logger<Checkout>
    let prices: Lazy<Prices>
    let sms: Sms?
    let greeting: String

    init(orders: any Repository<Order>, receipts: any Repository<Receipt>, discounts: (any Discount)[], log: Logger<Checkout>, prices: Lazy<Prices>, sms: Sms?, greeting: String = "thank you") {
        self.orders = orders
        self.receipts = receipts
        self.discounts = discounts
        self.log = log
        self.prices = prices
        self.sms = sms
        self.greeting = greeting
    }

    fn buy(_ item: String, price: Int) {
        var total = price
        for discount in discounts {
            total -= discount.off(price)
        }
        orders.add(Order { item: item })
        receipts.add(Receipt { total: total })
        log.info("\(item) for \(total) \(prices.value.currency), \(greeting)")
    }
}

@container
struct Shop {
    @singleton
    fn clock() -> any Clock { return StoppedClock { time: 9 } }
    @keyed("season")
    @singleton
    fn season() -> Int { return 5 }

    // Waited for as the shop is built, so that 'resolve' never waits.
    @singleton
    async fn prices() -> Prices {
        await Task.yield()
        return Prices { currency: "kr" }
    }
}

@main
async fn main() {
    let shop = await Shop.build()
    for items in [["tea", "cups"], ["a kettle"]] {
        shop.withScope { scope in
            let checkout = scope.resolve(Checkout.self)
            for item in items {
                checkout.buy(item, price: 100)
            }
            // The same repository the checkout was given, in this scope.
            print("\(scope.resolve((any Repository<Order>).self).count()) ordered")
        }
    }
    shop.resolve(Journal.self).report()

    // The same shop, put together as the program runs, at another time.
    var services = ServiceCollection()
    services.add(Shop.self)
    services.replaceSingleton((any Clock).self) { _services in StoppedClock { time: 23 } }
    let late = try! await services.buildAsync()
    late.withScope { scope in
        (try! scope.resolve(Checkout.self)).buy("a teapot", price: 200)
    }
    (try! late.resolve(Journal.self)).report()

    // What a collection lacks is said before anything is made.
    services.remove((any Clock).self)
    do {
        _ = try await services.buildAsync()
    } catch {
        if case .Invalid(let problems) = error {
            print(problems[0].description())
        }
    }
}
