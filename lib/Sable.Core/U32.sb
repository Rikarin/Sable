module Sable.Core

/// A 32-bit unsigned integer. Its arithmetic traps on overflow; FixedWidthInteger gives it
/// the forms that do not, and its bit operations.
extension U32: FixedWidthInteger, UnsignedInteger {
    /// The type of its distance from zero.
    public alias Magnitude = U32

    /// 0.
    public static var zero: U32 => 0

    /// 1.
    public static var one: U32 => 1

    /// The least U32, 0.
    public static var min: U32 => 0

    /// The greatest U32, 2³² - 1.
    public static var max: U32 => 4294967295

    /// The number in decimal.
    @builtin("string_from_U32")
    public fn toString() -> String
}
