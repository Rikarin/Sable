module RegexBench

// Regex against .NET 11's System.Text.RegularExpressions (RegexOptions.Compiled),
// rebar-style: a pattern's matches counted in a megabyte of text, ten times
// over. 'words' matches every few bytes, Unicode word characters among them;
// 'literal' and 'alternation' match seldom; 'email' seldom too, after much
// that begins as one does.

import Sable.Testing
import Sable.Text

/// The text the regex benchmarks search, as RegexSample.cs in ../../support/dotnet
/// makes it: about a megabyte of words chosen by xorshift, with names and e-mail
/// addresses among them, in lines of a dozen words or so, a few of the
/// words not ASCII.
fn regexText() -> String {
    let words: String[>..] = [
        "the", "of", "and", "to", "in", "was", "he", "it", "that", "his", "with", "had", "as", "for",
        "you", "at", "which", "on", "but", "be", "not", "by", "from", "my", "have", "there", "one",
        "been", "all", "naïve", "café", "so", "door", "room", "said", "upon", "little", "man", "matter", "case",
    ]
    let names: String[>..] = ["Sherlock Holmes", "Holmes", "Watson", "Irene Adler", "Lestrade", "Mrs. Hudson"]
    let emails: String[>..] = ["sherlock.holmes@baker-street.co.uk", "j.watson+notes@example.com", "irene@adler.org"]
    var state: U64 = 0x9E3779B97F4A7C15
    var parts: String[>..] = []
    var i = 0
    while i < 150000 {
        state = state ^ (state << 13)
        state = state ^ (state >> 7)
        state = state ^ (state << 17)
        let choice = Int(state % 100)
        state = state ^ (state << 13)
        state = state ^ (state >> 7)
        state = state ^ (state << 17)
        if choice < 3 {
            parts.append(names[Int(state % U64(names.count))])
        } else if choice < 4 {
            parts.append(emails[Int(state % U64(emails.count))])
        } else {
            parts.append(words[Int(state % U64(words.count))])
        }
        state = state ^ (state << 13)
        state = state ^ (state >> 7)
        state = state ^ (state << 17)
        parts.append(state % 12 == 0 ? ".\n" : " ")
        i = i + 1
    }
    return parts.joined()
}

let patterns: [String: String] = [
    "words": #"\w+"#,
    "literal": #"Sherlock Holmes"#,
    "alternation": #"Sherlock|Holmes|Watson|Irene|Adler"#,
    "email": #"[\w.+-]+@[\w-]+\.[\w.-]+"#,
]

fn run(_ regex: Regex, _ text: String) -> String {
    var count = 0
    for _ in 0..<10 {
        // Each round reads the input anew: nothing is kept from the last.
        _ = blackBox(count)
        count += regex.count(in: text)
    }
    return "\(count) \(text.utf8Count)"
}

@bench(arguments: ["words", "literal", "alternation", "email"])
fn measure(_ b: Bencher, _ pattern: String) {
    let text = regexText()
    let regex = try! Regex(patterns[pattern]!)
    b.bytesPerIteration = text.utf8Count * 10
    b.check(b.iterate { run(regex, text) })
}
