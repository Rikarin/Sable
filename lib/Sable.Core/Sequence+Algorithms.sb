module Sable.Core

// What every sequence can be asked, going through it once: transformed,
// searched, counted, ordered, grouped. Each answer is computed at once and
// given as an array (or a value); '.lazy' gives the transforming ones as
// views that do their work as they are gone through. Every closure here
// may throw, and then so does the call; so may going through the sequence,
// when its Failure is not Never, and then so does the call too:
// 'rethrows(Failure)', or 'throws(Failure)' where there is no closure. Over
// an array, a range or any collection, and with closures that do not
// throw, nothing does. Nothing is boxed, as each is monomorphised for the
// sequence and the closure it is given.

extension Sequence {
    /// The elements, each transformed, in order.
    ///
    /// ```sable
    /// let squares = [1, 2, 3].map { $0 * $0 }
    /// assert(squares[2] == 9)
    /// ```
    public fn map<T>(_ transform: (Element) throws -> T) rethrows(Failure) -> T[>..] {
        var result: T[>..] = []
        for try element in self {
            result.append(try transform(element))
        }
        return result
    }

    /// The elements for which the closure is true, in order.
    public fn filter(_ isIncluded: (Element) throws -> Bool) rethrows(Failure) -> Element[>..] {
        var result: Element[>..] = []
        for try element in self {
            if try isIncluded(element) {
                result.append(element)
            }
        }
        return result
    }

    /// The transformed elements that are not none, in order.
    public fn compactMap<T>(_ transform: (Element) throws -> T?) rethrows(Failure) -> T[>..] {
        var result: T[>..] = []
        for try element in self {
            if let value = try transform(element) {
                result.append(value)
            }
        }
        return result
    }

    /// The elements of the sequences the closure makes of each element, one
    /// sequence after another.
    public fn flatMap<S: Sequence>(_ transform: (Element) throws -> S) rethrows(Failure | S.Failure) -> S.Element[>..] {
        var result: S.Element[>..] = []
        for try element in self {
            for try inner in try transform(element) {
                result.append(inner)
            }
        }
        return result
    }

    /// The closure applied to a running result and each element in turn,
    /// starting from 'initial'.
    ///
    /// ```sable
    /// assert([1, 2, 3, 4].reduce(0) { $0 + $1 } == 10)
    /// ```
    public fn reduce<R>(_ initial: R, _ next: (R, Element) throws -> R) rethrows(Failure) -> R {
        var result = initial
        for try element in self {
            result = try next(result, element)
        }
        return result
    }

    /// The closure applied to a result it changes in place, and each
    /// element in turn, starting from 'initial': a result that is an array
    /// or a dictionary grows where it is rather than being copied each time.
    ///
    /// ```sable
    /// let counts = ["a", "b", "a"].reduce(into: [String: Int]()) { $0[$1, default: 0] += 1 }
    /// assert(counts["a"] == 2)
    /// ```
    public fn reduce<R>(into initial: R, _ update: (inout R, Element) throws -> Void) rethrows(Failure) -> R {
        var result = initial
        for try element in self {
            try update(&result, element)
        }
        return result
    }

    /// Calls the closure with each element, in order.
    public fn forEach(_ body: (Element) throws -> Void) rethrows(Failure) {
        for try element in self {
            try body(element)
        }
    }

    /// The first element for which the closure is true, or none.
    public fn first(where predicate: (Element) throws -> Bool) rethrows(Failure) -> Element? {
        for try element in self {
            if try predicate(element) {
                return element
            }
        }
        return none
    }

    /// Whether the closure is true for some element.
    public fn contains(where predicate: (Element) throws -> Bool) rethrows(Failure) -> Bool {
        for try element in self {
            if try predicate(element) {
                return true
            }
        }
        return false
    }

    /// Whether the closure is true for every element: true when there are none.
    public fn allSatisfy(_ predicate: (Element) throws -> Bool) rethrows(Failure) -> Bool {
        for try element in self {
            if !(try predicate(element)) {
                return false
            }
        }
        return true
    }

    /// How many elements the closure is true for.
    public fn count(where predicate: (Element) throws -> Bool) rethrows(Failure) -> Int {
        var count = 0
        for try element in self {
            if try predicate(element) {
                count += 1
            }
        }
        return count
    }

    /// The least element in the comparator's order, or none when there are
    /// none; the first of equals.
    public fn min(using comparator: Comparator<Element>) throws(Failure) -> Element? {
        return try self.min(by: { comparator.areInIncreasingOrder($0, $1) })
    }

    /// The greatest element in the comparator's order, or none when there
    /// are none; the last of equals.
    public fn max(using comparator: Comparator<Element>) throws(Failure) -> Element? {
        return try self.max(by: { comparator.areInIncreasingOrder($0, $1) })
    }

    /// The elements in the comparator's order; stable.
    ///
    /// ```sable
    /// let words = ["kiwi", "fig", "apple", "pear"]
    /// let order = Comparator<String>.by { $0.count }.reversed().then(by: { $0 })
    /// assert(words.sorted(using: order) == ["apple", "kiwi", "pear", "fig"])
    /// ```
    public fn sorted(using comparator: Comparator<Element>) throws(Failure) -> Element[>..] {
        return try self.sorted(by: { comparator.areInIncreasingOrder($0, $1) })
    }

    /// The least element, as the closure orders them ('a' before 'b' when it
    /// is true), or none when there are none; the first of equals.
    public fn min(by areInIncreasingOrder: (Element, Element) throws -> Bool) rethrows(Failure) -> Element? {
        var least: Element? = none
        for try element in self {
            if let current = least {
                if try areInIncreasingOrder(element, current) {
                    least = element
                }
            } else {
                least = element
            }
        }
        return least
    }

    /// The greatest element, as the closure orders them, or none when there
    /// are none; the last of equals.
    public fn max(by areInIncreasingOrder: (Element, Element) throws -> Bool) rethrows(Failure) -> Element? {
        var greatest: Element? = none
        for try element in self {
            if let current = greatest {
                if !(try areInIncreasingOrder(element, current)) {
                    greatest = element
                }
            } else {
                greatest = element
            }
        }
        return greatest
    }

    /// The element whose key is least, or none; the first of equals. Each
    /// key is computed once.
    public fn min<K: Comparable>(byKey key: (Element) throws -> K) rethrows(Failure) -> Element? {
        var least: (element: Element, key: K)? = none
        for try element in self {
            let candidate = try key(element)
            if let current = least {
                if candidate < current.key {
                    least = (element: element, key: candidate)
                }
            } else {
                least = (element: element, key: candidate)
            }
        }
        if let found = least {
            return found.element
        }
        return none
    }

    /// The element whose key is greatest, or none; the last of equals. Each
    /// key is computed once.
    public fn max<K: Comparable>(byKey key: (Element) throws -> K) rethrows(Failure) -> Element? {
        var greatest: (element: Element, key: K)? = none
        for try element in self {
            let candidate = try key(element)
            if let current = greatest {
                if !(candidate < current.key) {
                    greatest = (element: element, key: candidate)
                }
            } else {
                greatest = (element: element, key: candidate)
            }
        }
        if let found = greatest {
            return found.element
        }
        return none
    }

    /// The elements, in the order the closure says ('a' before 'b' when it is
    /// true). The sort is stable: equal elements keep their order. It takes
    /// O(n log n) comparisons.
    public fn sorted(by areInIncreasingOrder: (Element, Element) throws -> Bool) rethrows(Failure) -> Element[>..] {
        var elements = try self.toArray()
        try elements.sort(by: areInIncreasingOrder)
        return elements
    }

    /// The elements, ordered by their keys, each computed once; stable.
    public fn sorted<K: Comparable>(byKey key: (Element) throws -> K) rethrows(Failure) -> Element[>..] {
        var keyed: (key: K, element: Element)[>..] = []
        for try element in self {
            keyed.append((key: try key(element), element: element))
        }
        keyed.sort(by: { $0.key < $1.key })
        var result: Element[>..] = []
        for entry in keyed {
            result.append(entry.element)
        }
        return result
    }

    /// The elements, each under its key, in the order they came: one pass,
    /// each key found in the dictionary's hash table.
    ///
    /// ```sable
    /// let byParity = [1, 2, 3, 4, 5].grouped(by: { $0 % 2 })
    /// assert(byParity[1]?.count == 3)
    /// ```
    public fn grouped<K: Hashable>(by key: (Element) throws -> K) rethrows(Failure) -> [K: Element[>..]] {
        var groups: [K: Element[>..]] = [:]
        for try element in self {
            let k = try key(element)
            if var group = groups[k] {
                group.append(element)
                groups[k] = group
            } else {
                groups[k] = [element]
            }
        }
        return groups
    }

    /// How many elements have each key.
    public fn counted<K: Hashable>(by key: (Element) throws -> K) rethrows(Failure) -> [K: Int] {
        var counts: [K: Int] = [:]
        for try element in self {
            let k = try key(element)
            counts[k] = (counts[k] ?? 0) + 1
        }
        return counts
    }

    /// The elements, the first with each key kept and the rest left out.
    public fn distinct<K: Hashable>(byKey key: (Element) throws -> K) rethrows(Failure) -> Element[>..] {
        var seen: [K: Bool] = [:]
        var result: Element[>..] = []
        for try element in self {
            let k = try key(element)
            if seen[k] == none {
                seen[k] = true
                result.append(element)
            }
        }
        return result
    }

    /// The elements in arrays of 'size', in order; the last may be shorter.
    /// A size of less than one traps, as an array's 'chunks(of:)' does: an
    /// array's gives slices of itself instead of copies.
    public fn chunks(of size: Int) throws(Failure) -> Element[>..][>..] {
        precondition(size >= 1, "a chunk's size must be at least 1, not \(size)")
        var chunks: Element[>..][>..] = []
        var chunk: Element[>..] = []
        for try element in self {
            chunk.append(element)
            if chunk.count == size {
                chunks.append(chunk)
                chunk = []
            }
        }
        if !chunk.isEmpty {
            chunks.append(chunk)
        }
        return chunks
    }

    /// Every run of 'size' elements in a row, each starting one on from the
    /// last: none when there are fewer. A size of less than one traps, as an
    /// array's 'windows(of:)' does, which gives slices of itself.
    public fn windows(of size: Int) throws(Failure) -> Element[>..][>..] {
        precondition(size >= 1, "a window's size must be at least 1, not \(size)")
        var windows: Element[>..][>..] = []
        var elements: Element[>..] = []
        for try element in self {
            elements.append(element)
        }
        var start = 0
        while start + size <= elements.count {
            var window: Element[>..] = []
            var i = start
            while i < start + size {
                window.append(elements[i])
                i += 1
            }
            windows.append(window)
            start += 1
        }
        return windows
    }

    /// The elements the closure is true for, and those it is not, each in order.
    public fn partitioned(by belongsInFirst: (Element) throws -> Bool) rethrows(Failure) -> (matching: Element[>..], rest: Element[>..]) {
        var matching: Element[>..] = []
        var rest: Element[>..] = []
        for try element in self {
            if try belongsInFirst(element) {
                matching.append(element)
            } else {
                rest.append(element)
            }
        }
        return (matching: matching, rest: rest)
    }

    /// The first 'n' elements, or all of them when there are fewer.
    public fn prefix(_ n: Int) throws(Failure) -> Element[>..] {
        var result: Element[>..] = []
        if n <= 0 {
            return result
        }
        for try element in self {
            result.append(element)
            if result.count == n {
                break
            }
        }
        return result
    }

    /// The elements from the first, up to the first for which the closure is false.
    public fn prefix(while predicate: (Element) throws -> Bool) rethrows(Failure) -> Element[>..] {
        var result: Element[>..] = []
        for try element in self {
            if !(try predicate(element)) {
                break
            }
            result.append(element)
        }
        return result
    }

    /// The elements after the first 'n'.
    public fn dropFirst(_ n: Int) throws(Failure) -> Element[>..] {
        var result: Element[>..] = []
        var skipped = 0
        for try element in self {
            if skipped < n {
                skipped += 1
            } else {
                result.append(element)
            }
        }
        return result
    }

    /// The elements from the first for which the closure is false.
    public fn drop(while predicate: (Element) throws -> Bool) rethrows(Failure) -> Element[>..] {
        var result: Element[>..] = []
        var dropping = true
        for try element in self {
            if dropping && (try predicate(element)) {
                continue
            }
            dropping = false
            result.append(element)
        }
        return result
    }

    /// The last 'n' elements, or all of them when there are fewer.
    public fn suffix(_ n: Int) throws(Failure) -> Element[>..] {
        var elements: Element[>..] = []
        for try element in self {
            elements.append(element)
        }
        var result: Element[>..] = []
        var i = n < elements.count ? elements.count - n : 0
        if n <= 0 {
            i = elements.count
        }
        while i < elements.count {
            result.append(elements[i])
            i += 1
        }
        return result
    }

    /// The elements but the last 'n'.
    public fn dropLast(_ n: Int) throws(Failure) -> Element[>..] {
        var result: Element[>..] = []
        for try element in self {
            result.append(element)
        }
        var dropped = 0
        while dropped < n && !result.isEmpty {
            let _ = result.removeLast()
            dropped += 1
        }
        return result
    }

    /// The runs of elements between those the closure says separate them,
    /// the separators left out; empty runs are kept, so there is always one
    /// more run than separators.
    public fn split(where isSeparator: (Element) throws -> Bool) rethrows(Failure) -> Element[>..][>..] {
        var runs: Element[>..][>..] = []
        var run: Element[>..] = []
        for try element in self {
            if try isSeparator(element) {
                runs.append(run)
                run = []
            } else {
                run.append(element)
            }
        }
        runs.append(run)
        return runs
    }

    /// The elements with the separator between each two.
    public fn interspersed(with separator: Element) throws(Failure) -> Element[>..] {
        var result: Element[>..] = []
        for try element in self {
            if !result.isEmpty {
                result.append(separator)
            }
            result.append(element)
        }
        return result
    }

    /// The elements, in an array of their own.
    public fn toArray() throws(Failure) -> Element[>..] {
        var result: Element[>..] = []
        for try element in self {
            result.append(element)
        }
        return result
    }

    /// Whether the two give equal elements, as the closure says, in the same
    /// order, and as many.
    public fn elementsEqual<S: Sequence>(_ other: S, by areEquivalent: (Element, S.Element) throws -> Bool) rethrows(Failure | S.Failure) -> Bool {
        var mine = self.makeIterator()
        var theirs = other.makeIterator()
        while true {
            let a = try mine.next()
            let b = try theirs.next()
            if let x = a, let y = b {
                if !(try areEquivalent(x, y)) {
                    return false
                }
            } else {
                return a == none && b == none
            }
        }
    }

    /// Whether the sequence begins with the other's elements, as the closure
    /// compares them.
    public fn starts<S: Sequence>(with beginning: S, by areEquivalent: (Element, S.Element) throws -> Bool) rethrows(Failure | S.Failure) -> Bool {
        var mine = self.makeIterator()
        for try wanted in beginning {
            guard let element = try mine.next() else {
                return false
            }
            if !(try areEquivalent(element, wanted)) {
                return false
            }
        }
        return true
    }

    /// Whether the sequence comes before the other in dictionary order, as
    /// the closure orders elements: at the first that differ, or by being a
    /// prefix of it.
    public fn lexicographicallyPrecedes<S: Sequence>(_ other: S, by areInIncreasingOrder: (Element, Element) throws -> Bool) rethrows(Failure | S.Failure) -> Bool
        where S.Element == Element {
        var mine = self.makeIterator()
        var theirs = other.makeIterator()
        while true {
            guard let b = try theirs.next() else {
                return false
            }
            guard let a = try mine.next() else {
                return true
            }
            if try areInIncreasingOrder(a, b) {
                return true
            }
            if try areInIncreasingOrder(b, a) {
                return false
            }
        }
    }

    /// Each element with its offset from the first, as '(offset, element)'.
    ///
    /// ```sable
    /// for (offset, letter) in "ab".enumerated() {
    ///     assert(offset == 0 || letter == 'b')
    /// }
    /// ```
    public fn enumerated() -> EnumeratedSequence<Self> {
        return EnumeratedSequence<Self> { base: self }
    }

    /// The elements, followed by the other's.
    public fn chained<S: Sequence>(with other: S) -> ChainSequence<Self, S> where S.Element == Element {
        return ChainSequence<Self, S> { first: self, second: other }
    }

    /// A view of the sequence whose transforming methods ('map', 'filter',
    /// …) do their work as the result is gone through, not at once.
    public var `lazy`: LazySequence<Self> => LazySequence<Self> { base: self }
}

extension Sequence where Element: Equatable {
    /// Whether an element equal to this one is in the sequence.
    public fn contains(_ element: Element) throws(Failure) -> Bool {
        for try candidate in self {
            if candidate == element {
                return true
            }
        }
        return false
    }

    /// Whether the two give equal elements in the same order, and as many.
    public fn elementsEqual<S: Sequence>(_ other: S) throws(Failure | S.Failure) -> Bool where S.Element == Element {
        return try self.elementsEqual(other, by: { $0 == $1 })
    }

    /// Whether the sequence begins with the other's elements.
    public fn starts<S: Sequence>(with beginning: S) throws(Failure | S.Failure) -> Bool where S.Element == Element {
        return try self.starts(with: beginning, by: { $0 == $1 })
    }
}

extension Sequence where Element: Comparable {
    /// The least element, or none when there are none.
    public fn min() throws(Failure) -> Element? {
        return try self.min(by: { $0 < $1 })
    }

    /// The greatest element, or none when there are none.
    public fn max() throws(Failure) -> Element? {
        return try self.max(by: { $0 < $1 })
    }

    /// The elements in increasing order; stable.
    public fn sorted() throws(Failure) -> Element[>..] {
        var elements = try self.toArray()
        elements.sort()
        return elements
    }

    /// Whether the sequence comes before the other in dictionary order.
    public fn lexicographicallyPrecedes<S: Sequence>(_ other: S) throws(Failure | S.Failure) -> Bool where S.Element == Element {
        return try self.lexicographicallyPrecedes(other, by: { $0 < $1 })
    }
}

extension Sequence where Element: AdditiveArithmetic {
    /// The elements added up: zero for none. An integer sum traps where it
    /// does not fit the element type.
    ///
    /// ```sable
    /// assert([1, 2, 3].sum() == 6)
    /// assert([0.5, 0.25].sum() == 0.75)
    /// let empty: Int[>..] = []
    /// assert(empty.sum() == 0)
    /// ```
    public fn sum() throws(Failure) -> Element {
        var total = Element.zero
        for try element in self {
            total = total + element
        }
        return total
    }
}

extension Sequence where Element: Numeric {
    /// The elements multiplied together: one for none. An integer product
    /// traps where it does not fit the element type.
    ///
    /// ```sable
    /// assert([2, 3, 4].product() == 24)
    /// let empty: U8[>..] = []
    /// assert(empty.product() == 1)
    /// ```
    public fn product() throws(Failure) -> Element {
        var total = Element.one
        for try element in self {
            total = total * element
        }
        return total
    }
}

extension Sequence where Element: Hashable {
    /// The elements, each kept the first time it comes and left out after.
    public fn distinct() throws(Failure) -> Element[>..] {
        return try self.distinct(byKey: { $0 })
    }
}

extension Sequence where Element: Sequence {
    /// The elements of each inner sequence, one sequence after another.
    public fn joined() throws(Failure | Element.Failure) -> Element.Element[>..] {
        var result: Element.Element[>..] = []
        for try inner in self {
            for try element in inner {
                result.append(element)
            }
        }
        return result
    }
}

extension Sequence where Element == String {
    /// The strings, one after another, with the separator between each two.
    public fn joined(separator: String) throws(Failure) -> String {
        var parts: String[>..] = []
        for try part in self {
            parts.append(part)
        }
        return Runtime.joinStrings(parts, separator)
    }
}
