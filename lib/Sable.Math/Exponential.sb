module Sable.Math

// Exponentials, logarithms and powers, of any float with the elementary
// functions (ElementaryFunctions.sb): libm's, and exp10, which libm has
// under no portable name, as a power of ten.

/// e to the power x; +inf past where it overflows, 0 below where it underflows.
///
/// ```sable
/// assert(exp(0.0) == 1.0)
/// ```
public fn exp<T: ElementaryFunctions>(_ x: T) -> T => T.exp(x)

/// 2 to the power x: exact at an integer x in range.
public fn exp2<T: ElementaryFunctions>(_ x: T) -> T => T.exp2(x)

/// 10 to the power x, computed as an F64 and rounded to the type: exact at
/// an integer x whose power an F64 holds exactly (up to 1e22).
public fn exp10<T: ElementaryFunctions>(_ x: T) -> T => T.rounding(wideValue: F64.pow(10.0, x.wideValue))

/// e to the power x, less 1, without the loss of exp(x) - 1.0 where x is
/// small: expm1(1e-10) is 1.00000000005e-10.
public fn expm1<T: ElementaryFunctions>(_ x: T) -> T => T.expm1(x)

/// The natural logarithm: -inf at ±0, NaN below 0.
public fn log<T: ElementaryFunctions>(_ x: T) -> T => T.log(x)

/// The base-2 logarithm: exact at a power of two.
public fn log2<T: ElementaryFunctions>(_ x: T) -> T => T.log2(x)

/// The base-10 logarithm.
public fn log10<T: ElementaryFunctions>(_ x: T) -> T => T.log10(x)

/// The natural logarithm of 1 + x, without the loss of log(1.0 + x) where x is small.
public fn log1p<T: ElementaryFunctions>(_ x: T) -> T => T.log1p(x)

/// The logarithm of x in a base: log(x) / log(base), as .NET's Math.Log,
/// computed as an F64 and rounded to the type.
public fn log<T: ElementaryFunctions>(_ x: T, base: T) -> T {
    return T.rounding(wideValue: F64.log(x.wideValue) / F64.log(base.wideValue))
}

/// x to the power y, with C's special cases: pow(x, 0.0) is 1 for every x,
/// NaN included, pow(1.0, y) is 1 for every y, and a negative x to a power
/// that is not an integer is NaN.
public fn pow<T: ElementaryFunctions>(_ x: T, _ y: T) -> T => T.pow(x, y)
