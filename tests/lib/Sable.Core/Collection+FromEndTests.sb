module CollectionFromEndTests

// Collection+FromEnd (Sable.Core): every collection's stepping
// 'index(_:offsetBy:)', and reading by a position counted from the end.

import Sable.Testing

@test
fn aCollectionThatCannotGoBackStepsForwards() {
    let counts = ["a": 1, "b": 2, "c": 3]
    let second = counts.index(counts.startIndex, offsetBy: 1)
    assert(counts.index(counts.startIndex, offsetBy: 0) == counts.startIndex)
    assert(counts.index(second, offsetBy: 2) == counts.endIndex)
    assert(counts.index(counts.startIndex, offsetBy: 3) == counts.endIndex)
}

@test(traps: "distance must not be negative, but is -1")
fn aCollectionThatCannotGoBackTrapsGoingBack() {
    let counts = ["a": 1]
    let _ = counts.index(counts.endIndex, offsetBy: blackBox(-1))
}

fn stepBack<C: BidirectionalCollection>(_ c: C, _ n: Int) -> C.Element {
    return c[FromEnd(n)]
}

@test
fn aBidirectionalCollectionStepsBackFromItsEnd() {
    assertEqual(stepBack([1, 2, 3], 1), 3)
    assertEqual(stepBack([1, 2, 3], 3), 1)
    assertEqual(stepBack("añb", 2), 'ñ')
}

@test(traps: "index ^4 is out of range for count 3")
fn steppingBackPastTheStartTraps() {
    let _ = stepBack([1, 2, 3], blackBox(4))
}

@test(traps: "index ^0 is out of range for count 3")
fn steppingBackNoneTraps() {
    let _ = stepBack([1, 2, 3], blackBox(0))
}

struct Point {
    var x: Int
}

fn setFromEnd<C: MutableCollection>(_ c: inout C, _ n: Int, _ value: C.Element) {
    c[FromEnd(n)] = value
}

fn readFromEnd<C: MutableCollection>(_ c: inout C, _ n: Int) -> C.Element {
    return c[FromEnd(n)]
}

@test
fn anArrayIsWrittenFromTheEnd() {
    var xs: Int[>..] = [1, 2, 3]
    xs[^1] = 9
    xs[^3] += 10
    assert(xs == [11, 2, 9])
    var fixed: Int[3] = [1, 2, 3]
    fixed[^2] = 7
    assertEqual(fixed[1], 7)
}

@test
fn aPartOfAnElementIsWrittenFromTheEnd() {
    var points: Point[>..] = [Point { x: 1 }, Point { x: 2 }]
    points[^1].x = 5
    points[^2].x += 1
    assertEqual(points[0].x, 2)
    assertEqual(points[1].x, 5)
}

@test
fn aMutableCollectionIsWrittenAndReadFromTheEnd() {
    var xs: Int[>..] = [1, 2, 3]
    setFromEnd(&xs, 1, 4)
    setFromEnd(&xs, 3, 0)
    assert(xs == [0, 2, 4])
    assertEqual(readFromEnd(&xs, 2), 2)
}

@test(traps: "index ^4 is out of range for count 3")
fn writingPastTheStartTraps() {
    var xs: Int[>..] = [1, 2, 3]
    xs[^blackBox(4)] = 0
}

@test(traps: "index ^0 is out of range for count 3")
fn writingAtTheEndTraps() {
    var xs: Int[>..] = [1, 2, 3]
    setFromEnd(&xs, blackBox(0), 0)
}
