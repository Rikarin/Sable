module I32Tests

// I32 (Sable.Core): its limits, and the numeric protocols' operations at
// its width, at the limits. Run with
//     tools/stdlib-coverage.sh Sable.Core

import Sable.Testing

@test
fn theLimitsAreTheWidthsBounds() {
    assertEqual(I32.min, -2147483648)
    assertEqual(I32.max, 2147483647)
    assertEqual(I32.zero, 0)
    assertEqual(I32.one, 1)
    assertEqual(I32.bitWidth, 32)
    expect(I32.isSigned, "I32 is signed")
}

@test
fn theLimitsPrintInDecimal() {
    assertEqual(I32.min.toString(), "-2147483648")
    assertEqual(I32.max.toString(), "2147483647")
}

@test
fn addingPastTheGreatestValueWrapsSaturatesOrReportsIt() {
    assertEqual(I32.max.wrappingAdd(1), I32.min)
    assertEqual(I32.max.saturatingAdd(1), I32.max)
    expect(I32.max.checkedAdd(1) == none, "the sum does not fit")
    let (sum, overflowed) = I32.max.overflowingAdd(1)
    assertEqual(sum, I32.min)
    expect(overflowed, "the sum overflowed")
}

@test
fn subtractingPastTheLeastValueWrapsSaturatesOrReportsIt() {
    assertEqual(I32.min.wrappingSub(1), I32.max)
    assertEqual(I32.min.saturatingSub(1), I32.min)
    expect(I32.min.checkedSub(1) == none, "the difference does not fit")
    let (difference, overflowed) = I32.min.overflowingSub(1)
    assertEqual(difference, I32.max)
    expect(overflowed, "the difference overflowed")
}

@test
fn multiplyingPastTheLimitsWrapsSaturatesOrReportsIt() {
    assertEqual(I32.max.wrappingMul(2), -2)
    assertEqual(I32.max.saturatingMul(2), I32.max)
    expect(I32.max.checkedMul(2) == none, "the product does not fit")
    let (product, overflowed) = I32.max.overflowingMul(2)
    assertEqual(product, -2)
    expect(overflowed, "the product overflowed")
    let (high, low) = I32.max.multipliedFullWidth(by: I32.max)
    assertEqual(high, 1073741823)
    assertEqual(low, 1)
}

@test
fn theBitCountsSeeEveryBit() {
    assertEqual(I32.zero.leadingZeroCount, 32)
    assertEqual(I32.zero.trailingZeroCount, 32)
    assertEqual(I32.one.leadingZeroCount, 31)
    assertEqual(I32.max.popCount, 31)
    assertEqual(I32(-2147483648).trailingZeroCount, 31)
    assertEqual(I32.max.leadingOneCount, 0)
    assertEqual(I32.max.trailingOneCount, 31)
}

@test
fn rotationsAndSwapsWorkAtTheWidth() {
    assertEqual(I32.one.rotatedLeft(by: 32), 1)
    assertEqual(I32.one.rotatedRight(by: 1), -2147483648)
    assertEqual(I32.one.rotatedLeft(by: -1), -2147483648)
    assertEqual(I32.one.bitReversed, -2147483648)
    assertEqual(I32(16909060).byteSwapped, 67305985)
    assertEqual(I32(16909060).bigEndianBytes().count, 4)
    assertEqual(I32.fromBigEndianBytes(I32.max.bigEndianBytes()) ?? 0, I32.max)
    assertEqual(I32.fromLittleEndianBytes(I32.min.littleEndianBytes()) ?? 1, I32.min)
}

@test
fn conversionsStopAtTheLimits() {
    expect(I32.exactly(U128.max) == none, "only a U128 holds U128's greatest value")
    expect(I32.exactly(I128.min) == none, "only an I128 holds I128's least value")
    assertEqual(I32.clamping(U128.max), I32.max)
    assertEqual(I32.clamping(I128.min), I32.min)
    assertEqual(I32.truncating(U128.max), -1)
    assertEqual(I32.exactly(I32.max) ?? 0, I32.max)
}

@test
fn theRemainderOfTheLeastValueByMinusOneIsZero() {
    assertEqual(I32.min.wrappingDiv(-1), I32.min)
    assertEqual(I32.min.wrappingRem(-1), 0)
    expect(I32.min.checkedDiv(-1) == none, "the quotient does not fit")
}

@test(traps: "integer overflow")
fn addingPastTheGreatestValueTraps() {
    var x = I32.max
    x = x + 1
    assertEqual(x, 0)
}

@test(traps: "integer overflow")
fn subtractingPastTheLeastValueTraps() {
    var x = I32.min
    x = x - 1
    assertEqual(x, 0)
}

@test(traps: "integer overflow")
fn theLeastValueHasNoAbsoluteValue() {
    assertEqual(I32.min.abs(), 0)
}

@test
fn theLeastValuesAbsoluteValueWrapsOrSaturates() {
    assertEqual(I32.min.wrappingAbs(), I32.min)
    assertEqual(I32.min.saturatingAbs(), I32.max)
    assertEqual(I32.min.saturatingNeg(), I32.max)
    expect(I32.min.checkedAbs() == none, "the least value has no absolute value")
    let (magnitude, overflowed) = I32.min.overflowingAbs()
    assertEqual(magnitude, I32.min)
    expect(overflowed, "the absolute value overflowed")
}
