module IpNetworkTests

// IpNetwork (Sable.Net): run with
//     tools/stdlib-coverage.sh Sable.Net

import NetSupport
import Sable.Net
import Sable.Testing

fn network(_ text: String) -> IpNetwork {
    return try! IpNetwork.parse(text)
}

@test(arguments: ["0.0.0.0/0", "10.0.0.0/8", "192.0.2.128/25", "192.0.2.1/32", "::/0", "2001:db8::/32", "fe80::/10", "::1/128", "1:2:3:4:8000::/65"])
fn aNetworkIsItsFirstAddressAndPrefix(_ text: String) {
    expect(network(text).toString() == text)
    expect(network("\(network(text))") == network(text))
}

@test(arguments: ["", "/", "10.0.0.0", "10.0.0.0/", "10.0.0.0/33", "10.0.0.0/08", "10.0.0.0/-1", "10.0.0.0/8 ", "10.0.0.1/8", "010.0.0.0/8", "10/8", "::/129", "::1/64",
    "fe80::%1/10x", "10.0.0.0/255.0.0.0", "10.0.0.0/99999999999999999999"])
fn textThatIsNoNetworkIsRefused(_ text: String) {
    expectThrows { _ = try IpNetwork.parse(text) }
}

@test(arguments: [
    ("0.0.0.0/0", "255.255.255.255"),
    ("::/0", "::ffff:1.2.3.4"),
    ("172.16.0.0/12", "172.31.255.255"),
    ("192.0.2.1/32", "192.0.2.1"),
    ("2001:db8::/32", "2001:db8:ffff::1"),
    ("1:2:3:4:8000::/65", "1:2:3:4:ffff::"),
    ("fe80::/10", "fe80::1%4"),
    ("10.0.0.0/8", "::ffff:10.9.8.7"),
    ("::ffff:10.0.0.0/104", "::ffff:10.9.8.7"),
])
fn aNetworkContainsWhatBeginsWithItsBits(_ text: String, _ address: String) {
    expect(network(text).contains(ip(address)))
}

@test(arguments: [
    ("0.0.0.0/0", "::1"),
    ("172.16.0.0/12", "172.32.0.0"),
    ("192.0.2.1/32", "192.0.2.2"),
    ("2001:db8::/32", "2001:db9::"),
    ("1:2:3:4:8000::/65", "1:2:3:4:7fff::"),
    ("::ffff:10.0.0.0/104", "10.9.8.7"),
])
fn aNetworkDoesNotContainOtherAddresses(_ text: String, _ address: String) {
    expect(!network(text).contains(ip(address)))
}

@test
fn networksContainAndOverlapOthers() {
    expect(network("10.0.0.0/8").contains(network("10.1.0.0/16")))
    expect(!network("10.1.0.0/16").contains(network("10.0.0.0/8")))
    expect(network("10.1.0.0/16").overlaps(network("10.0.0.0/8")))
    expect(!network("10.1.0.0/16").overlaps(network("10.2.0.0/16")))
    expect(!network("::/0").overlaps(network("0.0.0.0/0")))
}

@test(arguments: [
    ("192.0.2.0/25", "192.0.2.127"),
    ("0.0.0.0/0", "255.255.255.255"),
    ("2001:db8::/32", "2001:db8:ffff:ffff:ffff:ffff:ffff:ffff"),
    ("::/127", "::1"),
    ("::1/128", "::1"),
])
fn aNetworkHasALastAddress(_ text: String, _ last: String) {
    expect(network(text).lastAddress == ip(last))
}

@test
fn anAddressIsInItsNetwork() {
    assertEqual(IpNetwork(containing: ip("192.0.2.77"), prefixLength: 24), network("192.0.2.0/24"))
    assertEqual(IpNetwork(containing: ip("2001:db8:1:2::9"), prefixLength: 48).toString(), "2001:db8:1::/48")
    assertEqual(IpNetwork(containing: ip("fe80::9%3"), prefixLength: 64).toString(), "fe80::/64")
    var seen: [IpNetwork: Int] = [:]
    seen[network("10.0.0.0/8")] = 1
    seen[network("10.0.0.0/9")] = 2
    assertEqual(seen.count, 2)
    assertEqual(network("10.0.0.0/8").debugDescription(), "10.0.0.0/8")
}
